#==============================================================================================
#
#   page_client - WebContent's PageClient, in process
#
#   DESCRIPTION:
#       Port of the parts of Services/WebContent/PageClient.cpp (lines 67-800) that a page
#       without script, devtools or WebDriver reaches, and of PageHost.cpp (lines 18-23, the
#       client and its fresh top-level traversable). Ladybird's PageClient forwards what the
#       page reports to the UI process (`client().async_did_*`), where WebContentClient hands it
#       to the ViewImplementation; here each report is a direct call on the view (view.lucb).
#       The palette is WebContent's (setup_palette: a zeroed theme with magenta and cyan window
#       colors). The input event queue is ConnectionFromClient's (one client per view here).
#       The frame timer is WebContent's: request_frame queues "update the rendering" at most
#       maximum_frames_per_second times a second.
#
#       Copyright (c) 2020-2023, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2021-2022, Linus Groh <linusg@serenityos.org>
#       Copyright (c) 2023, Andrew Kaster <akaster@serenityos.org>
#       Copyright (c) 2024, Sam Atkins <sam@ladybird.org>
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: The client ==============================================================================

## WebContent::PageClient: a cell, as the C++ one is (its class id is PageClient's).
pub struct WebViewPageClient: gc.IsCell:
    var page_client: web.PageClient
    var m_page: web.Page*?
    var m_id: u64
    var m_view: WebView*?
    var m_palette_impl: gfx.PaletteImpl*?
    var m_screen_rect: gfx.DevicePixelRect
    var m_viewport_size: gfx.IntSize
    var m_device_pixel_ratio: f64
    var m_zoom_level: f64
    var m_maximum_frames_per_second: f64
    var m_preferred_color_scheme: web.CssPreferredColorScheme
    var m_frame_timer: web.CoreTimer*?
    var m_last_frame_dispatch_time: f64?
    ## ConnectionFromClient's m_input_event_queue.
    var m_input_event_queue: ak.Queue[web.QueuedInputEvent]
    ## The ids of the page's network requests in flight (page_did_start_network_request, which
    ## WebContent forwards to the UI's devtools), which closing the page ends.
    var m_network_requests: ak.Vector[u64]

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The client of a PageClient this file made.
func webview_page_client_of(base: web.PageClient*) -> WebViewPageClient*:
    return (WebViewPageClient*)base

## The view of a client, none once the view is destroyed (WebContentClient's view_for_page_id: a
## report for a view that is gone is dropped).
func webview_client_view(base: web.PageClient*) -> WebView*?:
    return webview_page_client_of(base).m_view

## Ported from Services/WebContent/PageClient.cpp:86 WebContent::PageClient::visit_edges.
func webview_page_client_visit_edges(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (WebViewPageClient*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_page)

func webview_page_client_id(this: web.PageClient*) -> u64:
    return webview_page_client_of(this).m_id

func webview_page_client_page(this: web.PageClient*) -> web.Page*:
    return webview_page_client_of(this).m_page else trap("webview: the PageClient has no page")

## In process the connection to the UI is the view, open while the client exists.
func webview_page_client_is_connection_open(this: web.PageClient*) -> bool:
    return true

## WebView::is_url_suitable_for_same_process_navigation: there is one process.
func webview_page_client_is_url_suitable_for_same_process_navigation(this: web.PageClient*, current_url: web_url.Url, target_url: web_url.Url) -> bool:
    return true

## Ported from Services/WebContent/PageClient.cpp:127 WebContent::PageClient::palette.
func webview_page_client_palette(this: web.PageClient*) -> gfx.Palette:
    var palette: gfx.Palette = ---
    gfx.palette_construct(&palette, webview_page_client_of(this).m_palette_impl else trap("webview: no palette"))
    return palette

func webview_page_client_screen_rect(this: web.PageClient*) -> gfx.DevicePixelRect:
    return webview_page_client_of(this).m_screen_rect

func webview_page_client_zoom_level(this: web.PageClient*) -> f64:
    return webview_page_client_of(this).m_zoom_level

func webview_page_client_device_pixel_ratio(this: web.PageClient*) -> f64:
    return webview_page_client_of(this).m_device_pixel_ratio

## Ported from Services/WebContent/PageClient.h:62 WebContent::PageClient::device_pixels_per_css_pixel.
func webview_page_client_device_pixels_per_css_pixel(this: web.PageClient*) -> f64:
    let client = webview_page_client_of(this)
    return client.m_device_pixel_ratio * client.m_zoom_level

func webview_page_client_preferred_color_scheme(this: web.PageClient*) -> web.CssPreferredColorScheme:
    return webview_page_client_of(this).m_preferred_color_scheme

func webview_page_client_preferred_contrast(this: web.PageClient*) -> web.CssPreferredContrast:
    return web.CssPreferredContrast.auto

func webview_page_client_preferred_motion(this: web.PageClient*) -> web.CssPreferredMotion:
    return web.CssPreferredMotion.auto

func webview_page_client_screen_count(this: web.PageClient*) -> usize:
    return 1

## Ported from Services/WebContent/PageClient.cpp:196 WebContent::PageClient::input_event_queue.
func webview_page_client_input_event_queue(this: web.PageClient*) -> ak.Queue[web.QueuedInputEvent]*:
    return &webview_page_client_of(this).m_input_event_queue

## Ported from Services/WebContent/PageClient.cpp:201 WebContent::PageClient::report_finished_handling_input_event.
func webview_page_client_report_finished_handling_input_event(this: web.PageClient*, page_id: u64, event_was_handled: web.EventResult):
    let view = webview_client_view(this) else return
    webview_did_finish_handling_input_event(view, event_was_handled)

## The lambda of PageClient::PageClient's frame timer: the rendering is updated on the next turn.
func webview_page_client_frame_timer_fired(context: void*?):
    let client = (WebViewPageClient*)(context else trap("webview: a frame timer without its client"))
    client.m_last_frame_dispatch_time = web.high_resolution_time_unsafe_shared_current_time()
    web.html_event_loop_queue_task_to_update_the_rendering(web.html_main_thread_event_loop())

## Ported from Services/WebContent/PageClient.cpp:225 WebContent::PageClient::request_frame.
## A hidden page asks for none: in Ladybird its WebContent process would queue the update of the
## rendering for its own navigables only, none of which has a rendering opportunity while hidden,
## so the frame would do nothing; here the event loop is every page's, and the frame would update
## the rendering of the visible ones. Showing the page asks for a frame (webview_page_client_set_system_visibility_state).
func webview_page_client_request_frame(this: web.PageClient*):
    let client = webview_page_client_of(this)
    let frame_timer = client.m_frame_timer else trap("webview: no frame timer")
    if web.core_timer_is_active(frame_timer):
        return
    let page = client.m_page else return
    if web.html_traversable_navigable_system_visibility_state(web.page_top_level_traversable(page)) == web.HtmlVisibilityState.hidden:
        return

    var delay = 0.0
    if let last_frame_dispatch_time = client.m_last_frame_dispatch_time:
        let now = web.high_resolution_time_unsafe_shared_current_time()
        let minimum_frame_interval = 1000.0 / client.m_maximum_frames_per_second
        delay = math.max(0.0, last_frame_dispatch_time + minimum_frame_interval - now)

    web.core_timer_restart_i32(frame_timer, (i32)math.ceil(delay))

