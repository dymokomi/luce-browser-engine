#==============================================================================================
#
#   error_page - the page a view shows when a location cannot be loaded
#
#   DESCRIPTION:
#       Port of Libraries/LibWebView/ErrorHTML.h (the header, footer and icon of LibWebView's
#       error pages) and ViewImplementation::load_navigation_error_page
#       (Libraries/LibWebView/ViewImplementation.cpp:196), which the UI shows when the address
#       field's text is neither a URL nor a search (no search engine). A network failure of a
#       navigation is the engine's own error page (Loader/GeneratedPagesLoader's
#       templates/error.html, resources.lucb).
#
#       Copyright (c) 2026-present, the Ladybird developers.
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## ERROR_HTML_HEADER up to its first placeholder (the icon).
let webview_error_html_header_start: str = """
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Error!</title>
        <style>
            :root {
                color-scheme: light dark;
                font-family: system-ui, sans-serif;
            }
            body {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                box-sizing: border-box;
                margin: 0;
                padding: 1rem;
                text-align: center;
            }
            header {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 2rem;
                margin-bottom: 1rem;
            }
            svg {
                height: 64px;
                width: auto;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.5;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
            h1 {
                margin: 0;
                font-size: 1.5rem;
            }
            p {
                font-size: 1rem;
                color: #555;
            }
        </style>
    </head>
    <body>
        <header>
            """

## ERROR_HTML_HEADER between its placeholders (the icon, then the heading).
let webview_error_html_header_middle: str = """
            <h1>"""

## ERROR_HTML_HEADER after its last placeholder.
let webview_error_html_header_end: str = """</h1>
        </header>
"""

## Ported from Libraries/LibWebView/ErrorHTML.h ERROR_HTML_FOOTER.
let webview_error_html_footer: str = """
    </body>
    </html>
"""

## Ported from Libraries/LibWebView/ErrorHTML.h ERROR_SVG.
let webview_error_svg: str = """
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 17.5 21.5">
        <path d="M11.75.75h-9c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-13l-5-5z" />
        <path d="M10.75.75v4c0 1.1.9 2 2 2h4M5.75 9.75v2M11.75 9.75v2M5.75 16.75c1-2.67 5-2.67 6 0" />
    </svg>
"""

## `builder.appendff(ERROR_HTML_HEADER, icon, heading)` (the heading as it is: the donor does
## not escape it).
func webview_append_error_html_header(builder: ak.StringBuilder*, icon: str, heading: ak.StringView):
    ak.string_builder_append(builder, webview_error_html_header_start)
    ak.string_builder_append(builder, icon)
    ak.string_builder_append(builder, webview_error_html_header_middle)
    ak.string_builder_append_string_view(builder, heading)
    ak.string_builder_append(builder, webview_error_html_header_end)

## The HTML of ViewImplementation::load_navigation_error_page for the typed `text`.
pub func webview_navigation_error_page_html(text: ak.StringView) -> ak.String:
    var message = ak.string_builder_new()
    ak.string_builder_append(&message, "Failed to load \"")
    ak.string_builder_append_string_view(&message, text)
    ak.string_builder_append(&message, "\"")

    var builder = ak.string_builder_new()
    webview_append_error_html_header(&builder, webview_error_svg, ak.string_builder_string_view(&message))
    ak.string_builder_append(&builder, "<p>If you were trying to enter a search query, please enable search in <a href=\"about:settings#search\">settings</a>.</p>")
    ak.string_builder_append(&builder, webview_error_html_footer)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")
