#==============================================================================================
#
#   host_defined - Bindings::HostDefined: a realm's [[HostDefined]], carrying the web intrinsics
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Bindings/HostDefined.cpp (lines 1-18) and HostDefined.h
#       (lines 1-26), with JS::Realm::HostDefined (Libraries/LibJS/Runtime/Realm.h:31), its
#       base. A HostDefined is owned by its realm (an OwnPtr in C++: managed memory the realm's
#       bytes point to) and visited by the realm's visit_edges.
#
#       Copyright (c) 2024, Shannon Booth <shannon@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Bindings/HostDefined.h:16 Web::Bindings::HostDefined::HostDefined.
pub func bind_host_defined_construct(this: BindHostDefined*, intrinsics: BindIntrinsics*):
    this.vtable = &bind_host_defined_vtable
    this.class_id = bind_host_defined_class.first_id
    this.intrinsics = intrinsics

## `make<Bindings::HostDefined>(intrinsics)`: a new HostDefined for a realm.
pub func bind_host_defined_create(intrinsics: BindIntrinsics*) -> BindHostDefined*:
    let this = (new BindHostDefined(vtable = &bind_host_defined_vtable, class_id = 0, intrinsics = intrinsics)) else trap("out of memory")
    bind_host_defined_construct(this, intrinsics)
    return this

## Ported from Libraries/LibWeb/Bindings/HostDefined.cpp:12 Web::Bindings::HostDefined::visit_edges (virtual).
pub func bind_host_defined_visit_edges_impl(this: BindHostDefined*, visitor: gc.CellVisitor*):
    # JS::Realm::HostDefined::visit_edges(visitor): nothing.
    gc.cell_visitor_visit_t_2(visitor, this.intrinsics)
