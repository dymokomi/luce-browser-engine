## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:497 Web::Bindings::PlatformObject::supported_property_names (virtual).
pub func bind_platform_object_supported_property_names_impl(this: BindPlatformObject*) -> ak.Vector[ak.FlyString]:
    return ak.Vector[ak.FlyString]()

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:502 Web::Bindings::PlatformObject::is_supported_property_name (virtual).
pub func bind_platform_object_is_supported_property_name_impl(this: BindPlatformObject*, name: ak.FlyString) -> bool:
    let names = bind_platform_object_supported_property_names(this)
    return ak.vector_contains_slow[ak.FlyString, ak.FlyStringTraits](&names, name)

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:507 Web::Bindings::PlatformObject::is_supported_property_index.
pub func bind_platform_object_is_supported_property_index(this: BindPlatformObject*, index: u32) -> bool:
    return bind_platform_object_item_value(this, (usize)index) != none
