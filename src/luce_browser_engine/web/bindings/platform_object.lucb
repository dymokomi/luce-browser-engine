## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:154 Web::Bindings::PlatformObject::invoke_indexed_property_setter.
## https://webidl.spec.whatwg.org/#invoke-indexed-setter
pub func bind_platform_object_invoke_indexed_property_setter(this: BindPlatformObject*, property_name: JsPropertyKey, value: JsValue) -> !:
    # 1. Let index be the result of calling ? ToUint32(P): property_name.as_number(), a JS
    #    property key (phase 3). Steps 2-7 are invoke_named_property_setter's, by index.
    trap("unported (P3): Web::Bindings::PlatformObject::invoke_indexed_property_setter (JS property keys)")

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:182 Web::Bindings::PlatformObject::invoke_named_property_setter.
## https://webidl.spec.whatwg.org/#invoke-named-setter
pub func bind_platform_object_invoke_named_property_setter(this: BindPlatformObject*, property_name: ak.FlyString, value: JsValue) -> !:
    # 1. Let creating be true if P is not a supported property name, and false otherwise.
    let creating = not bind_platform_object_is_supported_property_name(this, property_name)

    # FIXME: We do not have this information at this point, so converting the value is left as an exercise to the inheritor of PlatformObject.
    # 2. Let operation be the operation used to declare the indexed property setter.
    # 3. Let T be the type of the second argument of operation.
    # 4. Let value be the result of converting V to an IDL value of type T.

    let flags = this.m_legacy_platform_object_flags else trap("PlatformObject: no legacy platform object flags")

    # 5. If operation was defined without an identifier, then:
    if flags.named_property_setter_has_identifier == 0:
        # 1. If creating is true, then perform the steps listed in the interface description to set the value of a new named property with P as the name and value as the value.
        if creating:
            return try bind_platform_object_set_value_of_new_named_property(this, ak.fly_string_to_string_const(&property_name), value)

        # 2. Otherwise, creating is false. Perform the steps listed in the interface description to set the value of an existing named property with P as the name and value as the value.
        return try bind_platform_object_set_value_of_existing_named_property(this, ak.fly_string_to_string_const(&property_name), value)

    # 6. Otherwise, operation was defined with an identifier. Perform the method steps of operation with O as this and « P, value » as the argument values.
    return try bind_platform_object_set_value_of_named_property(this, ak.fly_string_to_string_const(&property_name), value)

