#==============================================================================================
#
#   platform_object - Bindings::PlatformObject: the base of every object exposed through WebIDL
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Bindings/PlatformObject.cpp (lines 1-512) and
#       PlatformObject.h (lines 1-131). A platform object is a cell, not a JS object (DESIGN.md
#       §3.6): it keeps its realm (JS::Object reaches it through its shape) and the slot of its
#       one JS wrapper, which phase 3 creates lazily. The legacy platform object algorithms
#       ([[GetOwnProperty]], [[Set]], [[DefineOwnProperty]], [[Delete]], [[PreventExtensions]],
#       [[OwnPropertyKeys]] and named-property visibility) are internal methods of the wrapper
#       and operate on JS property keys and descriptors: they come with luce-js in phase 3. The
#       defaults of the indexed and named property hooks, which interfaces override, are here.
#       WEB_SET_PROTOTYPE_FOR_INTERFACE (Intrinsics.h) is web_set_prototype_for_interface.
#
#       Copyright (c) 2022, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction and the realm ==============================================================

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:16 Web::Bindings::PlatformObject::PlatformObject:
## JS::Object(realm, nullptr, may_interfere_with_indexed_property_access). The object has no
## prototype and no wrapper yet; the indexed-access flag is a property of the JS object (phase 3).
pub func bind_platform_object_construct_realm(this: BindPlatformObject*, realm: Realm*, may_interfere_with_indexed_property_access: JsObjectMayInterfereWithIndexedPropertyAccess = JsObjectMayInterfereWithIndexedPropertyAccess.no):
    this.m_realm = realm
    this.m_wrapper = js_undefined()

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:21 Web::Bindings::PlatformObject::PlatformObject:
## JS::Object(ConstructWithPrototypeTag::Tag, prototype, ...), whose realm is the prototype's: a
## JS object (phase 3).
pub func bind_platform_object_construct_js_object(this: BindPlatformObject*, prototype: JsObject*, may_interfere_with_indexed_property_access: JsObjectMayInterfereWithIndexedPropertyAccess = JsObjectMayInterfereWithIndexedPropertyAccess.no):
    trap("unported (P3): Web::Bindings::PlatformObject::PlatformObject(JS::Object& prototype)")

## Ported from Libraries/LibWeb/Bindings/PlatformObject.cpp:28 Web::Bindings::PlatformObject::realm.
pub func bind_platform_object_realm(this: BindPlatformObject*) -> Realm*:
    # return shape().realm();
    return this.m_realm

## JS::Object::visit_edges, which PlatformObject inherits: the shape (here the realm) and, from
## phase 3, the wrapper (DESIGN.md §3.6). Every platform object's visit_edges reaches it as its
## Base::visit_edges.
pub func bind_platform_object_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (BindPlatformObject*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_realm)

## `JS::Value(platform_object)`: a platform object as a JS value, which is its JS wrapper
## (DESIGN.md §3.6), created lazily with its interface's prototype by the bindings (phase 3).
pub func bind_platform_object_wrapper(this: BindPlatformObject*) -> JsValue:
    trap("unported (P3): JS::Value of a platform object (its wrapper)")

## WEB_SET_PROTOTYPE_FOR_INTERFACE(interface_name) (Libraries/LibWeb/Bindings/Intrinsics.h:19),
## the first step of every platform object's initialize: `if (!shape().prototype())
## set_prototype(&ensure_web_prototype<interface_name##Prototype>(realm, name))`. The prototype
## belongs to the JS wrapper, which phase 3 creates with its interface's prototype from the
## realm's intrinsics (DESIGN.md §3.6), so before then there is nothing to set.
pub func web_set_prototype_for_interface(this: JsCell*, realm: Realm*, interface_name: BindInterfaceName):
    return

