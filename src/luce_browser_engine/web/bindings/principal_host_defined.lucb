## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.h:18 Web::Bindings::PrincipalHostDefined::PrincipalHostDefined.
pub func bind_principal_host_defined_construct(this: BindPrincipalHostDefined*, eso: HtmlEnvironmentSettingsObject*, intrinsics: BindIntrinsics*, page: Page*):
    bind_host_defined_construct(this.bind_host_defined(), intrinsics)
    this.host_defined.vtable = (const BindHostDefinedVTable*)&bind_principal_host_defined_vtable
    this.host_defined.class_id = bind_principal_host_defined_class.first_id
    this.environment_settings_object = eso
    this.page = page

## `make<Bindings::PrincipalHostDefined>(eso, intrinsics, page)`: a new PrincipalHostDefined for
## a realm.
pub func bind_principal_host_defined_create(eso: HtmlEnvironmentSettingsObject*, intrinsics: BindIntrinsics*, page: Page*) -> BindPrincipalHostDefined*:
    let this = (new BindPrincipalHostDefined(host_defined = BindHostDefined(vtable = &bind_host_defined_vtable, class_id = 0, intrinsics = intrinsics), environment_settings_object = eso, page = page)) else trap("out of memory")
    bind_principal_host_defined_construct(this, eso, intrinsics, page)
    return this

## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.cpp:16 Web::Bindings::PrincipalHostDefined::visit_edges (override).
pub func bind_principal_host_defined_visit_edges_impl(base: BindHostDefined*, visitor: gc.CellVisitor*):
    let this = (BindPrincipalHostDefined*)base
    bind_host_defined_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.environment_settings_object)
    gc.cell_visitor_visit_t_2(visitor, this.page)

## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.h:26 Web::Bindings::PrincipalHostDefined::is_principal_host_defined (virtual).
pub func bind_principal_host_defined_is_principal_host_defined_impl(this: BindPrincipalHostDefined*) -> bool:
    return true

## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.h:32 Web::Bindings::principal_host_defined_environment_settings_object.
pub func bind_principal_host_defined_environment_settings_object(realm: Realm*) -> HtmlEnvironmentSettingsObject*:
    let host_defined = realm_host_defined(realm) else trap("as<PrincipalHostDefined> of a realm without [[HostDefined]]")
    return as_bind_principal_host_defined(host_defined).environment_settings_object

## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.h:37 Web::Bindings::principal_host_defined_environment_settings_object (const).
pub func bind_principal_host_defined_environment_settings_object_2(realm: Realm*) -> HtmlEnvironmentSettingsObject*:
    return bind_principal_host_defined_environment_settings_object(realm)

## Ported from Libraries/LibWeb/Bindings/PrincipalHostDefined.h:42 Web::Bindings::principal_host_defined_page.
pub func bind_principal_host_defined_page(realm: Realm*) -> Page*:
    let host_defined = realm_host_defined(realm) else trap("as<PrincipalHostDefined> of a realm without [[HostDefined]]")
    return as_bind_principal_host_defined(host_defined).page
