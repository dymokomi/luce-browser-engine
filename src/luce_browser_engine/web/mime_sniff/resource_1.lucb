func matches_mp3_no_id3_signature(sequence: const u8[]) -> bool:
    # 1. Let sequence be the byte sequence to be matched, where sequence[s] is byte s in sequence and sequence[0] is the first byte in sequence.

    # FIXME: 2. Let length be the number of bytes in sequence.

    # FIXME: 3. Initialize s to 0.

    # 4. If the result of the operation match mp3 header is false, return false.
    let result = match_mp3_header(sequence, 0)
    if not result:
        return false

    # FIXME: 5. Parse an mp3 frame on sequence at offset s

    # FIXME: 6. Let skipped-bytes the return value of the execution of mp3 framesize computation

    # FIXME: 7. If skipped-bytes is less than 4, or skipped-bytes is greater than s - length, return false.

    # FIXME: 8. Increment s by skipped-bytes.

    # FIXME: 9. If the result of the operation match mp3 header operation is false, return false, else, return true.
    return true

## match_an_audio_or_video_type_pattern's `pattern_table`.
let match_an_audio_or_video_type_pattern_table: Anonymous2[6] = [
    # The string "FORM" followed by four bytes followed by the string "AIFF", the AIFF signature.
    Anonymous2(byte_pattern = b"\x46\x4F\x52\x4D\x00\x00\x00\x00\x41\x49\x46\x46",
        pattern_mask = b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "audio/aiff"),

    #  The string "ID3", the ID3v2-tagged MP3 signature.
    Anonymous2(byte_pattern = b"\x49\x44\x33", pattern_mask = b"\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "audio/mpeg"),

    # The string "OggS" followed by NUL, the Ogg container signature.
    Anonymous2(byte_pattern = b"\x4F\x67\x67\x53\x00", pattern_mask = b"\xFF\xFF\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "application/ogg"),

    # The string "MThd" followed by four bytes representing the number 6 in 32 bits (big-endian), the MIDI signature.
    Anonymous2(byte_pattern = b"\x4D\x54\x68\x64\x00\x00\x00\x06", pattern_mask = b"\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "audio/midi"),

    # The string "RIFF" followed by four bytes followed by the string "AVI ", the AVI signature.
    Anonymous2(byte_pattern = b"\x52\x49\x46\x46\x00\x00\x00\x00\x41\x56\x49\x20",
        pattern_mask = b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "video/avi"),

    # The string "RIFF" followed by four bytes followed by the string "WAVE", the WAVE signature.
    Anonymous2(byte_pattern = b"\x52\x49\x46\x46\x00\x00\x00\x00\x57\x41\x56\x45",
        pattern_mask = b"\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF", ignored_leading_bytes = no_ignored_bytes, mime_type = "audio/wave"),
]

## Ported from Libraries/LibWeb/MimeSniff/Resource.cpp:393 (anonymous)::match_an_audio_or_video_type_pattern.
# https://mimesniff.spec.whatwg.org/#matching-an-audio-or-video-type-pattern
func match_an_audio_or_video_type_pattern(input: const u8[]) -> MimeType?:
    # 1. Execute the following steps for each row row in the following table:
    if let matched = mime_match_pattern_table(input, match_an_audio_or_video_type_pattern_table):
        return matched

    # 2. If input matches the signature for MP4, return "video/mp4".
    if matches_mp4_signature(input):
        return mime_type_create(ak.string_from_str("video"), ak.string_from_str("mp4"))

    # 3. If input matches the signature for WebM, return "video/webm".
    if matches_webm_signature(input):
        return mime_type_create(ak.string_from_str("video"), ak.string_from_str("webm"))

    # 4. If input matches the signature for MP3 without ID3, return "audio/mpeg".
    if matches_mp3_no_id3_signature(input):
        return mime_type_create(ak.string_from_str("audio"), ak.string_from_str("mpeg"))

    # 5. Return undefined.
    return none

