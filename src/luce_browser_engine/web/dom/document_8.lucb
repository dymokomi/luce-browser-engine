## Ported from Document.cpp:5316 Web::DOM::Document::queue_intersection_observer_task.
# https://www.w3.org/TR/intersection-observer/#queue-an-intersection-observer-task
## (Private in C++; public until the phase-3/4 code that calls it is ported.)
pub func dom_document_queue_intersection_observer_task(this: DomDocument*):
    if dom_document_window(this) == none:
        return

    # 1. If document’s IntersectionObserverTaskQueued flag is set to true, return.
    if this.m_intersection_observer_task_queued:
        return

    # 2. Set document’s IntersectionObserverTaskQueued flag to true.
    this.m_intersection_observer_task_queued = true

    # 3. Queue a task on the IntersectionObserver task source associated with the document's event loop to notify intersection observers.
    #    (The task takes each observer's records, wraps them in a JS array and invokes the observer's callback.)
    trap("unported (P3): Web::DOM::Document::queue_intersection_observer_task (notify intersection observers)")

## Ported from Document.cpp:5368 Web::DOM::Document::queue_an_intersection_observer_entry.
# https://www.w3.org/TR/intersection-observer/#queue-an-intersectionobserverentry
## (Private in C++; public until the phase-3/4 code that calls it is ported.)
pub func dom_document_queue_an_intersection_observer_entry(this: DomDocument*, observer: IntersectionObserverIntersectionObserver*, time: f64, root_bounds: GeometryDomRectReadOnly*, bounding_client_rect: GeometryDomRectReadOnly*, intersection_rect: GeometryDomRectReadOnly*, is_intersecting: bool, intersection_ratio: f64, target: DomElement*):
    # 1. Construct an IntersectionObserverEntry, passing in time, rootBounds, boundingClientRect, intersectionRect, isIntersecting, and target.
    # 2. Append it to observer’s internal [[QueuedEntries]] slot.
    # 3. Queue an intersection observer task for document.
    trap("unported (P3): Web::DOM::Document::queue_an_intersection_observer_entry (IntersectionObserverEntry)")

## Ported from Document.cpp:5383 Web::DOM::compute_intersection.
# https://www.w3.org/TR/intersection-observer/#compute-the-intersection
## (Private in C++; public until the phase-3/4 code that calls it is ported.)
pub func dom_compute_intersection(target: DomElement*, observer: IntersectionObserverIntersectionObserver*, root_paintable: PaintPaintableBox*?, root_bounds: gfx.CssPixelRect) -> gfx.CssPixelRect:
    # 1. Let intersectionRect be the result of getting the bounding box for target, 2.-3. clip it by each
    #    containing block with a content clip (expanded by the observer's scroll margin for scroll containers),
    #    5. intersect it with the root intersection rectangle, 7. return it. The observer's scroll margin is
    #    IntersectionObserver state, outside the phase-1 closure.
    trap("unported (P3): Web::DOM::compute_intersection (IntersectionObserver)")

## Ported from Document.cpp:5443 Web::DOM::Document::run_the_update_intersection_observations_steps.
# https://www.w3.org/TR/intersection-observer/#run-the-update-intersection-observations-steps
pub func dom_document_run_the_update_intersection_observations_steps(this: DomDocument*, time: f64):
    # 1. Let observer list be a list of all IntersectionObservers whose root is in the DOM tree of document.
    #    For the top-level browsing context, this includes implicit root observers.
    # 2. For each observer in observer list:

    # NOTE: We make a copy of the intersection observers list to avoid modifying it while iterating.
    let intersection_observers = ak.ordered_hash_table_values(&this.m_intersection_observers)

    # Each observer's targets are compared with its root intersection rectangle and thresholds, which are
    # IntersectionObserver state outside the phase-1 closure: a document has no observer until it is ported.
    if not ak.vector_is_empty(&intersection_observers):
        trap("unported (P3): Web::DOM::Document::run_the_update_intersection_observations_steps (IntersectionObserver)")

## Ported from Document.cpp:5568 Web::DOM::Document::start_intersection_observing_a_lazy_loading_element.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#start-intersection-observing-a-lazy-loading-element
pub func dom_document_start_intersection_observing_a_lazy_loading_element(this: DomDocument*, element: DomElement*):
    assert(dom_node_is_lazy_loading(element.dom_node()))

    # 1. Let doc be element's node document.
    assert(dom_node_document(element.dom_node()) == this)

    # 2. If doc's lazy load intersection observer is null, set it to a new IntersectionObserver instance (whose
    #    callback runs the lazy load resumption steps of the intersecting entries), and
    # 3. call doc's lazy load intersection observer's observe method with element as the argument.
    trap("unported (P3): Web::DOM::Document::start_intersection_observing_a_lazy_loading_element (IntersectionObserver)")

## Ported from Document.cpp:5634 Web::DOM::Document::stop_intersection_observing_a_lazy_loading_element.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#stop-intersection-observing-a-lazy-loading-element
pub func dom_document_stop_intersection_observing_a_lazy_loading_element(this: DomDocument*, element: DomElement*):
    # 1. Let doc be element's node document.
    # NOTE: It's `this`.

    # 2. Assert: doc's lazy load intersection observer is not null.
    let observer = this.m_lazy_load_intersection_observer else trap("VERIFY: no lazy load intersection observer")

    # 3. Call doc's lazy load intersection observer unobserve method with element as the argument.
    intersection_observer_intersection_observer_unobserve(observer, element)

# mark: Declarative refresh =====================================================================

## `is_ascii_digit` as a GenericLexer predicate.
struct DomDocumentIsAsciiDigit: ak.CharPredicate:
    var unused: u8

    func matches(ch: u8) -> bool:
        return ak.is_ascii_digit((u32)ch)

## The lambda `is_ascii_digit(c) || c == '.'` of the shared declarative refresh steps.
struct DomDocumentIsAsciiDigitOrFullStop: ak.CharPredicate:
    var unused: u8

    func matches(ch: u8) -> bool:
        return ak.is_ascii_digit((u32)ch) or ch == '.'

## The lambda `!quote.has_value() || c != quote.value()` of the shared declarative refresh steps.
struct DomDocumentIsNotQuote: ak.CharPredicate:
    var quote: u8?

    func matches(ch: u8) -> bool:
        let quote_value = self.quote else return true
        return ch != quote_value

## The captures of the refresh timer: `[this, has_meta_element, url_record]`.
struct DomDocumentRefreshTimer:
    var this: DomDocument*
    var has_meta_element: bool
    var url_record: web_url.Url

## The refresh timer's handler: navigate document's node navigable to urlRecord.
func dom_document_refresh_timer_fired(context: void*?):
    let captures = (DomDocumentRefreshTimer*)(context else trap("no captures"))
    let this = captures.this
    if captures.has_meta_element and html_has_flag(dom_document_active_sandboxing_flag_set(this), HtmlSandboxingFlagSet.sandboxed_automatic_features):
        return

    let navigable = dom_document_navigable(this) else return
    if html_navigable_has_been_destroyed(navigable):
        return

    # MUST(navigable->navigate({ .url = url_record, .source_document = *this, .history_handling = Replace })):
    # Navigable::NavigateParams is opaque in phase 1 (navigation is phase 2).
    trap("unported (P2): Web::DOM::Document::shared_declarative_refresh_steps (navigate)")

## Ported from Document.cpp:5647 Web::DOM::Document::shared_declarative_refresh_steps.
# https://html.spec.whatwg.org/multipage/semantics.html#shared-declarative-refresh-steps
pub func dom_document_shared_declarative_refresh_steps(this: DomDocument*, input: ak.StringView, meta_element: HtmlMetaElement*? = none):
    # 1. If document's will declaratively refresh is true, then return.
    if this.m_will_declaratively_refresh:
        return

    # 2. Let position point at the first code point of input.
    var lexer = ak.generic_lexer_new(input)
    let is_ascii_whitespace = DomElementIsAsciiWhitespace(unused = 0)

    # 3. Skip ASCII whitespace within input given position.
    ak.generic_lexer_ignore_while(&lexer, &is_ascii_whitespace)

    # 4. Let time be 0.
    var time: u32 = 0

    # 5. Collect a sequence of code points that are ASCII digits from input given position, and let timeString be the result.
    let is_ascii_digit = DomDocumentIsAsciiDigit(unused = 0)
    let time_string = ak.generic_lexer_consume_while(&lexer, &is_ascii_digit)

    # 6. If timeString is the empty string, then:
    if ak.string_view_is_empty(&time_string):
        # 1. If the code point in input pointed to by position is not U+002E (.), then return.
        if ak.generic_lexer_peek(&lexer) != '.':
            return

    # 7. Otherwise, set time to the result of parsing timeString using the rules for parsing non-negative integers.
    let maybe_time = html_parse_non_negative_integer(time_string)

    # FIXME: Since we only collected ASCII digits, this can only fail because of overflow. What do we do when that happens? For now, default to 0.
    if let parsed_time = maybe_time:
        if parsed_time < (u32)ak.i32_max and (i32(parsed_time) *? 1000) != none:
            time = parsed_time

    # 8. Collect a sequence of code points that are ASCII digits and U+002E FULL STOP characters (.) from input given
    #    position. Ignore any collected characters.
    let is_ascii_digit_or_full_stop = DomDocumentIsAsciiDigitOrFullStop(unused = 0)
    ak.generic_lexer_ignore_while(&lexer, &is_ascii_digit_or_full_stop)

    # 9. Let urlRecord be document's URL.
    var url_record = dom_document_url(this)

    # 10. If position is not past the end of input, then:
    if not ak.generic_lexer_is_eof(&lexer):
        # 1. If the code point in input pointed to by position is not U+003B (;), U+002C (,), or ASCII whitespace, then return.
        let next = ak.generic_lexer_peek(&lexer)
        if next != ';' and next != ',' and not web_infra.is_ascii_whitespace((u32)next):
            return

        # 2. Skip ASCII whitespace within input given position.
        ak.generic_lexer_ignore_while(&lexer, &is_ascii_whitespace)

        # 3. If the code point in input pointed to by position is U+003B (;) or U+002C (,), then advance position to the next code point.
        if ak.generic_lexer_peek(&lexer) == ';' or ak.generic_lexer_peek(&lexer) == ',':
            ak.generic_lexer_ignore(&lexer, 1)

        # 4. Skip ASCII whitespace within input given position.
        ak.generic_lexer_ignore_while(&lexer, &is_ascii_whitespace)

    # 11. If position is not past the end of input, then:
    if not ak.generic_lexer_is_eof(&lexer):
        # 1. Let urlString be the substring of input from the code point at position to the end of the string.
        var url_string = ak.generic_lexer_remaining(&lexer)

        # C++ jumps forward with `goto skip_quotes` and `goto parse`; the jump targets are kept as flags.
        var jump_to_skip_quotes = false
        var jump_to_parse = false

        # 2. If the code point in input pointed to by position is U+0055 (U) or U+0075 (u), then advance position to the next code point. Otherwise, jump to the step labeled skip quotes.
        if ak.generic_lexer_peek(&lexer) == 'U' or ak.generic_lexer_peek(&lexer) == 'u':
            ak.generic_lexer_ignore(&lexer, 1)
        else:
            jump_to_skip_quotes = true

        # 3. If the code point in input pointed to by position is U+0052 (R) or U+0072 (r), then advance position to the next code point. Otherwise, jump to the step labeled parse.
        if not jump_to_skip_quotes:
            if ak.generic_lexer_peek(&lexer) == 'R' or ak.generic_lexer_peek(&lexer) == 'r':
                ak.generic_lexer_ignore(&lexer, 1)
            else:
                jump_to_parse = true

        # 4. If the code point in input pointed to by position is U+004C (L) or U+006C (l), then advance position to the next code point. Otherwise, jump to the step labeled parse.
        if not jump_to_skip_quotes and not jump_to_parse:
            if ak.generic_lexer_peek(&lexer) == 'L' or ak.generic_lexer_peek(&lexer) == 'l':
                ak.generic_lexer_ignore(&lexer, 1)
            else:
                jump_to_parse = true

        if not jump_to_skip_quotes and not jump_to_parse:
            # 5. Skip ASCII whitespace within input given position.
            ak.generic_lexer_ignore_while(&lexer, &is_ascii_whitespace)

            # 6. If the code point in input pointed to by position is U+003D (=), then advance position to the next code point. Otherwise, jump to the step labeled parse.
            if ak.generic_lexer_peek(&lexer) == '=':
                ak.generic_lexer_ignore(&lexer, 1)
            else:
                jump_to_parse = true

        if not jump_to_skip_quotes and not jump_to_parse:
            # 7. Skip ASCII whitespace within input given position.
            ak.generic_lexer_ignore_while(&lexer, &is_ascii_whitespace)

        # skip_quotes:
        if not jump_to_parse:
            # 8. Skip quotes: If the code point in input pointed to by position is U+0027 (') or U+0022 ("), then let
            #    quote be that code point, and advance position to the next code point. Otherwise, let quote be the empty
            #    string.
            var is_not_quote = DomDocumentIsNotQuote(quote = none)
            if ak.generic_lexer_peek(&lexer) == '\'' or ak.generic_lexer_peek(&lexer) == '"':
                is_not_quote.quote = ak.generic_lexer_consume(&lexer)

            # 9. Set urlString to the substring of input from the code point at position to the end of the string.
            # 10. If quote is not the empty string, and there is a code point in urlString equal to quote, then truncate
            #     urlString at that code point, so that it and all subsequent code points are removed.
            url_string = ak.generic_lexer_consume_while(&lexer, &is_not_quote)

        # parse:
        # 11. Parse: Set urlRecord to the result of encoding-parsing a URL given urlString, relative to document.
        # 12. If urlRecord is failure, then return.
        let maybe_url_record = dom_document_encoding_parse_url(this, url_string) else return

        url_record = maybe_url_record

        # 13. If urlRecord's scheme is "javascript", then return.
        let scheme = web_url.url_scheme(&url_record)
        if ak.string_eq_string_view(&scheme, ak.sv("javascript")):
            return

    # 12. Set document's will declaratively refresh to true.
    this.m_will_declaratively_refresh = true

    # 13. Perform one or more of the following steps:
    # - After the refresh has come due (as defined below), if the user has not canceled the redirect and, if meta is
    #   given, document's active sandboxing flag set does not have the sandboxed automatic features browsing context
    #   flag set, then navigate document's node navigable to urlRecord using document, with historyHandling set to
    #   "replace".
    let captures = new DomDocumentRefreshTimer(this = this, has_meta_element = meta_element != none, url_record = url_record) else trap("out of memory")
    let refresh_timer = core_timer_create_single_shot((i32)(time * 1000), ak.Function0[unit](call = dom_document_refresh_timer_fired, context = captures))
    this.m_active_refresh_timer = refresh_timer

    # For the purposes of the previous paragraph, a refresh is said to have come due as soon as the later of the
    # following two conditions occurs:

    # - At least time seconds have elapsed since document's completely loaded time, adjusted to take into
    #   account user or user agent preferences.
    # m_active_refresh_timer is started in completely_finished_loading after setting the completely loaded time.

    # - If meta is given, at least time seconds have elapsed since meta was inserted into the document document,
    # adjusted to take into account user or user agent preferences.
    # NOTE: This is only done if completely loaded time has a value because shared_declarative_refresh_steps is called
    # by HTMLMetaElement::inserted and if the document hasn't finished loading when the meta element was inserted,
    # then the document completely finishing loading will _always_ come after inserting the meta element.
    if meta_element != none and this.m_completely_loaded_time != none:
        core_timer_start(refresh_timer)

