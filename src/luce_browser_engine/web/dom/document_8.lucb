    return this.m_list_of_available_images else trap("the document has no list of available images")

# mark: Viewports ===============================================================================

## Ported from Document.cpp:5261 Web::DOM::Document::viewport_rect.
pub func dom_document_viewport_rect(this: DomDocument*) -> gfx.CssPixelRect:
    if let navigable = dom_document_navigable(this):
        return html_navigable_viewport_rect(navigable)
    return gfx.CssPixelRect()

## Ported from Document.cpp:5268 Web::DOM::Document::visual_viewport.
pub func dom_document_visual_viewport(this: DomDocument*) -> CssVisualViewport*:
    if this.m_visual_viewport == none:
        this.m_visual_viewport = css_visual_viewport_create(this)
    return this.m_visual_viewport else trap("unreachable: set above")

## Ported from Document.cpp:5275 Web::DOM::Document::register_viewport_client.
pub func dom_document_register_viewport_client(this: DomDocument*, client: DomViewportClient*):
    let result = ak.hash_table_set(&this.m_viewport_clients, client)
    assert(result == ak.HashSetResult.inserted_new_entry)

## Ported from Document.cpp:5281 Web::DOM::Document::unregister_viewport_client.
pub func dom_document_unregister_viewport_client(this: DomDocument*, client: DomViewportClient*):
    let was_removed = ak.hash_table_remove_t(&this.m_viewport_clients, client)
    assert(was_removed)

## Ported from Document.cpp:5287 Web::DOM::Document::inform_all_viewport_clients_about_the_current_viewport_rect.
pub func dom_document_inform_all_viewport_clients_about_the_current_viewport_rect(this: DomDocument*):
    for client in ak.hash_table_begin(&this.m_viewport_clients):
        let viewport_client = *client else trap("a null viewport client")
        dom_viewport_client_did_set_viewport_rect(viewport_client, dom_document_viewport_rect(this))

