pub func dom_document_register_intersection_observer(this: DomDocument*, observer: IntersectionObserverIntersectionObserver*):
    let result = ak.ordered_hash_table_set(&this.m_intersection_observers, observer)
    assert(result == ak.HashSetResult.inserted_new_entry)

## Ported from Document.cpp:5299 Web::DOM::Document::unregister_intersection_observer.
pub func dom_document_unregister_intersection_observer(this: DomDocument*, observer: IntersectionObserverIntersectionObserver*):
    let was_removed = ak.ordered_hash_table_remove_t(&this.m_intersection_observers, observer)
    assert(was_removed)

