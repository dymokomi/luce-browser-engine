#==============================================================================================
#
#   position - DOM::Position: a (node, offset) cell used by the editing code
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Position.cpp (lines 1-34) and the inline functions of Position.h.
#
#==============================================================================================

## Ported from Position.cpp:17 Web::DOM::Position::Position.
pub func dom_position_construct(this: DomPosition*, node: DomNode*, offset: u32):
    this.m_node = node
    this.m_offset = offset

## Ported from Position.cpp:23 Web::DOM::Position::visit_edges (override).
pub func dom_position_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomPosition*)base
    # Base::visit_edges(visitor): JS::Cell's visits nothing.
    gc.cell_visitor_visit_t_2(visitor, this.m_node)

## Ported from Position.cpp:29 Web::DOM::Position::to_string.
pub func dom_position_to_string(this: DomPosition*) -> ak.String!:
    let node_name = dom_node_node_name(dom_position_node(this))
    var builder = ak.string_builder_new()
    let arguments: ak.TypeErasedParameter[3] = [ak.arg_string_view(ak.fly_string_bytes_as_string_view(&node_name)), ak.arg_pointer(dom_position_node(this)), ak.arg_u64((u64)dom_position_offset(this))]
    try ak.vformat_arguments(&builder, ak.sv("DOM::Position({} ({})), {})"), arguments)
    return try ak.string_builder_to_string(&builder)

# mark: Position.h ==============================================================================

## Ported from Position.h:23 Web::DOM::Position::create.
pub func dom_position_create(realm: Realm*, node: DomNode*, offset: u32) -> DomPosition*:
    return realm_create_dom_position(realm, node, offset)

## Ported from Position.h:28 Web::DOM::Position::node.
pub func dom_position_node(this: DomPosition*) -> DomNode*:
    return this.m_node

## Ported from Position.h:29 Web::DOM::Position::node.
pub func dom_position_node_const(this: DomPosition*) -> DomNode*:
    return this.m_node

## Ported from Position.h:31 Web::DOM::Position::offset.
pub func dom_position_offset(this: DomPosition*) -> u32:
    return this.m_offset

## Ported from Position.h:33 Web::DOM::Position::equals.
pub func dom_position_equals(this: DomPosition*, other: DomPosition*) -> bool:
    return this.m_node == other.m_node and this.m_offset == other.m_offset
