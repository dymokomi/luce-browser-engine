#==============================================================================================
#
#   cdata_section - DOM::CDATASection: CDATA sections (Text nodes of their own type)
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/CDATASection.cpp (lines 1-28) and the inline functions of
#       CDATASection.h.
#
#==============================================================================================

## Ported from CDATASection.cpp:15 Web::DOM::CDATASection::CDATASection.
pub func dom_cdata_section_construct(this: DomCdataSection*, document: DomDocument*, data: ak.Utf16String):
    dom_text_construct_dom_node_type(this.dom_text(), document, DomNodeType.cdata_section_node, data)
    # The SlottableMixin base subobject's vtable moves on to CDATASection's (DESIGN.md §2.5).
    this.text.slottable_mixin.vtable = &dom_cdata_section_slottable_mixin_vtable

## Ported from CDATASection.cpp:22 Web::DOM::CDATASection::initialize (override).
pub func dom_cdata_section_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.cdata_section)
    dom_text_initialize_impl(base, realm)

## Ported from CDATASection.h:22 Web::DOM::CDATASection::node_name (override).
pub func dom_cdata_section_node_name_impl(base: DomNode*) -> ak.FlyString:
    return ak.fly_string_from_str("#cdata-section")
