## Ported from NodeFilter.cpp:16 Web::DOM::NodeFilter::create.
pub func dom_node_filter_create(realm: Realm*, callback: IdlCallbackType*) -> DomNodeFilter*:
    return realm_create_dom_node_filter(realm, realm, callback)

## Ported from NodeFilter.cpp:21 Web::DOM::NodeFilter::NodeFilter.
pub func dom_node_filter_construct(this: DomNodeFilter*, realm: Realm*, callback: IdlCallbackType*):
    # : PlatformObject(realm.intrinsics().object_prototype()), m_callback(callback)
    # The base is a JS object whose prototype is the realm's %Object.prototype%, which exists
    # with luce-js (phase 3); a NodeFilter is only made from a JS callback.
    trap("unported (P3): Web::DOM::NodeFilter::NodeFilter (PlatformObject over %Object.prototype%)")

## Ported from NodeFilter.cpp:27 Web::DOM::NodeFilter::visit_edges (override).
pub func dom_node_filter_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomNodeFilter*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_callback)

# mark: NodeFilter.h ============================================================================

## Ported from NodeFilter.h:23 Web::DOM::NodeFilter::callback.
pub func dom_node_filter_callback(this: DomNodeFilter*) -> IdlCallbackType*:
    return this.m_callback

## Ported from NodeFilter.h:53 Web::DOM::operator&= (AK_ENUM_BITWISE_OPERATORS).
pub func dom_and_assign(lhs: DomNodeFilterWhatToShow*, rhs: DomNodeFilterWhatToShow) -> DomNodeFilterWhatToShow*:
    *lhs = *lhs & rhs
    return lhs

