## Ported from NodeFilter.h:53 Web::DOM::operator^ (AK_ENUM_BITWISE_OPERATORS).
pub func dom_bit_xor(lhs: DomNodeFilterWhatToShow, rhs: DomNodeFilterWhatToShow) -> DomNodeFilterWhatToShow:
