## Ported from NodeFilter.h:53 Web::DOM::has_any_flag (AK_ENUM_BITWISE_OPERATORS).
pub func dom_has_any_flag(value: DomNodeFilterWhatToShow, mask: DomNodeFilterWhatToShow) -> bool:
    return (i64)(value & mask) != 0

## Ported from NodeFilter.h:53 Web::DOM::has_flag (AK_ENUM_BITWISE_OPERATORS).
pub func dom_has_flag(value: DomNodeFilterWhatToShow, mask: DomNodeFilterWhatToShow) -> bool:
    return (value & mask) == mask

## Ported from NodeFilter.h:53 Web::DOM::operator|= (AK_ENUM_BITWISE_OPERATORS).
