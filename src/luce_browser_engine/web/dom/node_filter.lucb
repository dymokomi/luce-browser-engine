    *lhs = *lhs ^ rhs
    return lhs

# mark: Filtering ===============================================================================

## Ported from LibJS/Runtime/Value.cpp:996 JS::Value::to_i32 (and to_i32_slow_case):
## 7.1.6 ToInt32 ( argument ), https://tc39.es/ecma262/#sec-toint32. The C++ uses AArch64's
## FJCVTZS where it can, which computes the same function.
func dom_js_value_to_i32(vm: Vm*, value: JsValue) -> i32!:
    # 1. Let number be ? ToNumber(argument).
    let number = js_value_as_double(try js_value_to_number(vm, value))

    # 2. If number is not finite or number is either +0𝔽 or -0𝔽, return +0𝔽.
    if not math.is_finite(number) or number == 0.0:
        return 0

    # 3. Let int be the mathematical value whose sign is the sign of number and whose magnitude is floor(abs(ℝ(number))).
    var int_value = math.floor(math.abs(number))
    if number < 0.0:
        int_value = -int_value

    # 4. Let int32bit be int modulo 2^32.
    var int32bit = js_modulo(int_value, 4294967296.0)

    # 5. If int32bit ≥ 2^31, return 𝔽(int32bit - 2^32); otherwise return 𝔽(int32bit).
    if int32bit >= 2147483648.0:
        int32bit -= 4294967296.0
    return (i32)int32bit
