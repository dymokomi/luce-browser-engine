## Ported from NonDocumentTypeChildNode.h:54 Web::DOM::NonDocumentTypeChildNode::previous_element_sibling const.
pub func dom_non_document_type_child_node_previous_element_sibling_const(this: DomNode*) -> DomElement*?:
