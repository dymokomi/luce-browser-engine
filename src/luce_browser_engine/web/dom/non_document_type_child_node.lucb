#==============================================================================================
#
#   non_document_type_child_node - DOM::NonDocumentTypeChildNode: element siblings
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/NonDocumentTypeChildNode.h (lines 1-63), the mixin of Element and
#       CharacterData: previousElementSibling, nextElementSibling and the elements before and
#       after a node in tree order. A stateless CRTP helper whose body only uses Node, so it
#       becomes functions on Node (DESIGN.md §2.5).
#
#==============================================================================================

## Ported from NonDocumentTypeChildNode.h:18 Web::DOM::NonDocumentTypeChildNode::previous_element_sibling.
pub func dom_non_document_type_child_node_previous_element_sibling(this: DomNode*) -> DomElement*?:
    var sibling = tree_node_previous_sibling(this)
    while let current = sibling:
        if is_dom_element(current):
            return as_dom_element(current)
        sibling = tree_node_previous_sibling(current)
    return none

## Ported from NonDocumentTypeChildNode.h:27 Web::DOM::NonDocumentTypeChildNode::previous_element_in_pre_order.
pub func dom_non_document_type_child_node_previous_element_in_pre_order(this: DomNode*) -> DomElement*?:
    var node = tree_node_previous_in_pre_order(this)
    while let current = node:
        if is_dom_element(current):
            return as_dom_element(current)
        node = tree_node_previous_in_pre_order(current)
    return none

