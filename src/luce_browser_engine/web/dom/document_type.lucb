## Ported from DocumentType.cpp:15 Web::DOM::DocumentType::create.
pub func dom_document_type_create(document: DomDocument*) -> DomDocumentType*:
    return realm_create_dom_document_type(bind_platform_object_realm(document.bind_platform_object()), document)

## Ported from DocumentType.cpp:20 Web::DOM::DocumentType::DocumentType.
pub func dom_document_type_construct(this: DomDocumentType*, document: DomDocument*):
    dom_node_construct_dom_document(this.dom_node(), document, DomNodeType.document_type_node)

## Ported from DocumentType.cpp:25 Web::DOM::DocumentType::initialize (override).
pub func dom_document_type_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.document_type)
    # Base::initialize(realm): Node inherits EventTarget's.
    dom_event_target_initialize_impl(base, realm)

## Ported from DocumentType.cpp:32 Web::DOM::is_valid_doctype_name.
# https://dom.spec.whatwg.org/#valid-doctype-name
pub func dom_is_valid_doctype_name(name: ak.String) -> bool:
    # A string is a valid doctype name if it does not contain ASCII whitespace, U+0000 NULL, or U+003E (>).
    let invalid_doctype_characters: u32[7] = [(u32)'\t', (u32)'\n', 0x0c, (u32)'\r', (u32)' ', 0, (u32)'>']
    let code_points = ak.string_code_points(&name)
    return not ak.utf8_view_contains_any_of(&code_points, invalid_doctype_characters)

# mark: DocumentType.h ==========================================================================

## Ported from DocumentType.h:26 Web::DOM::DocumentType::node_name (override).
pub func dom_document_type_node_name_impl(base: DomNode*) -> ak.FlyString:
    let this = (DomDocumentType*)base
    return ak.fly_string_from_string(dom_document_type_name(this))

## Ported from DocumentType.h:28 Web::DOM::DocumentType::name.
pub func dom_document_type_name(this: DomDocumentType*) -> ak.String:
    return this.m_name

## Ported from DocumentType.h:29 Web::DOM::DocumentType::set_name.
pub func dom_document_type_set_name(this: DomDocumentType*, name: ak.String):
    this.m_name = name

