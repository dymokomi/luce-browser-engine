## Ported from Node.h:129 Web::DOM::Node::type.
pub func dom_node_type(this: DomNode*) -> DomNodeType:
    return this.m_type

## Ported from Node.h:130 Web::DOM::Node::is_element.
pub func dom_node_is_element(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.element_node

## Ported from Node.h:131 Web::DOM::Node::is_text.
pub func dom_node_is_text(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.text_node or dom_node_type(this) == DomNodeType.cdata_section_node

## Ported from Node.h:132 Web::DOM::Node::is_exclusive_text.
pub func dom_node_is_exclusive_text(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.text_node

## Ported from Node.h:133 Web::DOM::Node::is_document.
pub func dom_node_is_document(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.document_node

## Ported from Node.h:134 Web::DOM::Node::is_document_type.
pub func dom_node_is_document_type(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.document_type_node

## Ported from Node.h:135 Web::DOM::Node::is_comment.
pub func dom_node_is_comment(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.comment_node

## Ported from Node.h:136 Web::DOM::Node::is_character_data.
pub func dom_node_is_character_data(this: DomNode*) -> bool:
    let type_ = dom_node_type(this)
    return type_ == DomNodeType.text_node or type_ == DomNodeType.comment_node or type_ == DomNodeType.cdata_section_node or type_ == DomNodeType.processing_instruction_node

## Ported from Node.h:137 Web::DOM::Node::is_document_fragment.
pub func dom_node_is_document_fragment(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.document_fragment_node

## Ported from Node.h:138 Web::DOM::Node::is_parent_node.
pub func dom_node_is_parent_node(this: DomNode*) -> bool:
    return dom_node_is_element(this) or dom_node_is_document(this) or dom_node_is_document_fragment(this)

## Ported from Node.h:139 Web::DOM::Node::is_slottable.
pub func dom_node_is_slottable(this: DomNode*) -> bool:
    return dom_node_is_element(this) or dom_node_is_text(this) or dom_node_is_cdata_section(this)

## Ported from Node.h:140 Web::DOM::Node::is_attribute.
pub func dom_node_is_attribute(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.attribute_node

## Ported from Node.h:141 Web::DOM::Node::is_cdata_section.
pub func dom_node_is_cdata_section(this: DomNode*) -> bool:
    return dom_node_type(this) == DomNodeType.cdata_section_node

