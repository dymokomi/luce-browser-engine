#==============================================================================================
#
#   node_8 - DOM::Node: accessible name entry points, observers, ancestry queries, Node.h
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Node.cpp (lines 3312-3404): accessibleName/accessibleDescription,
#       the first valid IDREF, registered observers, the display:none and event-listener
#       ancestry queries and the containing shadow root; then the inline functions of
#       LibWeb/DOM/Node.h (lines 110-538) in their header order: the node-type predicates, the
#       default bodies of Node's virtual functions, the dirty-flag accessors and the generic
#       helpers (which take a ClassInfo or a callback, DESIGN.md §2.4, §2.7).
#
#==============================================================================================

# mark: Accessible name and description =========================================================

## Ported from Node.cpp:3313 Web::DOM::Node::accessible_name.
# https://www.w3.org/TR/accname-1.2/#mapping_additional_nd_name
pub func dom_node_accessible_name(this: DomNode*, document: DomDocument*, should_compute_role: DomShouldComputeRole = DomShouldComputeRole.yes) -> ak.String!:
    var visited_nodes: ak.HashTable[i64, ak.I64Traits]
    # User agents MUST compute an accessible name using the rules outlined below in the section titled Accessible Name and Description Computation.
    return try dom_node_name_or_description(this, DomNameOrDescription.name, document, &visited_nodes, DomIsDescendant.no, should_compute_role)

## Ported from Node.cpp:3321 Web::DOM::Node::accessible_description.
# https://www.w3.org/TR/accname-1.2/#mapping_additional_nd_description
pub func dom_node_accessible_description(this: DomNode*, document: DomDocument*) -> ak.String!:
    # If aria-describedby is present, user agents MUST compute the accessible description by concatenating the text alternatives for elements referenced by an aria-describedby attribute on the current element.
    # The text alternatives for the referenced elements are computed using a number of methods, outlined below in the section titled Accessible Name and Description Computation.
    if not dom_node_is_element(this):
        return ak.string_new()

    let element = (DomElement*)this
    let described_by = aria_mixin_aria_described_by(&element.aria_mixin) else return ak.string_new()

    var visited_nodes: ak.HashTable[i64, ak.I64Traits]
    var builder = ak.string_builder_new()
    var id_list = dom_node_split_on_ascii_whitespace(&described_by)
    for id in ak.vector_span(&id_list):
        if let description_element = dom_parent_node_get_element_by_id(document.dom_parent_node(), ak.fly_string_from_utf8(id) else trap("MUST: FlyString::from_utf8")):
            let description = try dom_node_name_or_description(description_element.dom_node(), DomNameOrDescription.description, document, &visited_nodes)
            if not ak.string_is_empty(&description):
                if ak.string_builder_is_empty(&builder):
                    dom_node_append_string(&builder, description)
                else:
                    ak.string_builder_append(&builder, " ")
                    dom_node_append_string(&builder, description)
    return try ak.string_builder_to_string(&builder)

## Ported from Node.cpp:3354 Web::DOM::Node::first_valid_id.
pub func dom_node_first_valid_id(value: ak.StringView, document: DomDocument*) -> ak.StringView?:
    let predicate = ak.CharPredicateFunction(function = web_infra.is_ascii_whitespace)
    var id_list = ak.string_view_split_view_if(&value, &predicate)
    for id in ak.vector_span(&id_list):
        if dom_parent_node_get_element_by_id(document.dom_parent_node(), ak.fly_string_from_utf8(id) else trap("MUST: FlyString::from_utf8")) != none:
            return id
    return none

# mark: Registered observers and ancestry queries ===============================================

## Ported from Node.cpp:3364 Web::DOM::Node::add_registered_observer.
pub func dom_node_add_registered_observer(this: DomNode*, registered_observer: DomRegisteredObserver*):
    if this.m_registered_observer_list == none:
        this.m_registered_observer_list = new ak.Vector[DomRegisteredObserver*] else trap("out of memory")
    let list = this.m_registered_observer_list else trap("unreachable")
    ak.vector_append_t(list, registered_observer)

## Ported from Node.cpp:3371 Web::DOM::Node::has_inclusive_ancestor_with_display_none_ignoring_animations.
pub func dom_node_has_inclusive_ancestor_with_display_none_ignoring_animations(this: DomNode*) -> bool:
    var ancestor: DomNode*? = this
    while let ancestor_node = ancestor:
        ancestor = none
        if let parent_or_host = dom_node_parent_or_shadow_host(ancestor_node):
            ancestor = parent_or_host.dom_node()
        if not dom_node_is_element(ancestor_node):
            continue
        let ancestor_element = (DomElement*)ancestor_node
        if let computed_properties = dom_element_computed_properties(ancestor_element):
            let display = css_display_style_value_display(css_style_value_as_display(css_computed_properties_property(computed_properties, css_data.PropertyId.display, CssComputedPropertiesWithAnimationsApplied.no)))
            if css_display_is_none(&display):
                return true
    return false

## Ported from Node.cpp:3384 Web::DOM::Node::has_inclusive_ancestor_with_event_listener.
pub func dom_node_has_inclusive_ancestor_with_event_listener(this: DomNode*, type_: ak.FlyString) -> bool:
    var ancestor: DomNode*? = this
    while let ancestor_node = ancestor:
        if dom_event_target_has_event_listener(ancestor_node.dom_event_target(), type_):
            return true
        ancestor = none
        if let parent_or_host = dom_node_parent_or_shadow_host(ancestor_node):
            ancestor = parent_or_host.dom_node()
    if let window = dom_document_window(dom_node_document(this)):
        return dom_event_target_has_event_listener(window.dom_event_target(), type_)
    return false

## Ported from Node.cpp:3395 Web::DOM::Node::containing_shadow_root.
pub func dom_node_containing_shadow_root(this: DomNode*) -> DomShadowRoot*?:
    if let shadow_root = as_if_dom_shadow_root(this):
        let host = dom_document_fragment_host(shadow_root.dom_document_fragment()) else trap("shadow root without a host")
        return dom_node_containing_shadow_root(host.dom_node())

    if let shadow_root = as_if_dom_shadow_root(tree_node_root(this)):
        return shadow_root
    return none

