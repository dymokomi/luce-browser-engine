## Ported from Node.h:439 Web::DOM::Node::for_each_child_of_type_fallible: the children of class
## `class_info`, each given to `callback` (with `context`) until it fails or answers Break.
pub func dom_node_for_each_child_of_type_fallible(this: DomNode*, class_info: const ak.ClassInfo*, callback: func(void*?, DomNode*) -> ak.IterationDecision!, context: void*?) -> !:
    var node = tree_node_first_child(this)
    while let child = node:
        let id = child.cell().class_id
        if id >= class_info.first_id and id <= class_info.last_id:
            if (try callback(context, child)) == ak.IterationDecision.break_:
                return
        node = tree_node_next_sibling(child)

## Ported from Node.h:450 Web::DOM::Node::first_flat_tree_ancestor_of_type const: the nearest
## flat-tree ancestor of class `class_info` (the caller downcasts).
pub func dom_node_first_flat_tree_ancestor_of_type_const(this: DomNode*, class_info: const ak.ClassInfo*) -> DomNode*?:
    return dom_node_first_flat_tree_ancestor_of_type(this, class_info)

## Ported from Node.h:460 Web::DOM::Node::find_in_shadow_including_ancestry: the first of this
## node and its shadow-including ancestors that `predicate` accepts.
pub func dom_node_find_in_shadow_including_ancestry(this: DomNode*, predicate: ak.Function1[DomNode*, bool]) -> DomNode*?:
    var it: DomNode*? = this
    while let node = it:
        if ak.function1_call(&predicate, node):
            return node
        it = dom_node_parent_or_shadow_host_node(node)
    return none

## Ported from Node.h:484 Web::DOM::Node::containing_shadow_root const.
pub func dom_node_containing_shadow_root_const(this: DomNode*) -> DomShadowRoot*?:
    return dom_node_containing_shadow_root(this)
