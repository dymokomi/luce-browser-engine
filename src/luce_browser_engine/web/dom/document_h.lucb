# mark: notify_each_document_observer ===========================================================

# Ported from Document.h:1146 Web::DOM::Document::notify_each_document_observer, a template over the
# observer's notifier getter: the observers are copied into m_document_observers_being_notified
# (so they stay alive while notified), each one's notifier is called, and the list is cleared on
# exit (ScopeGuard). The notifiers are read from the observer's fields, as its getters do.

## The first half of notify_each_document_observer: copy the observers to notify.
func dom_document_begin_notifying_document_observers(this: DomDocument*):
    ak.vector_ensure_capacity(&this.m_document_observers_being_notified, ak.hash_table_size(&this.m_document_observers))

    for observer in ak.hash_table_begin(&this.m_document_observers):
        ak.vector_unchecked_append_u(&this.m_document_observers_being_notified, *observer)

## The ScopeGuard of notify_each_document_observer.
func dom_document_end_notifying_document_observers(this: DomDocument*):
    ak.vector_clear_with_capacity(&this.m_document_observers_being_notified)

## notify_each_document_observer with document_readiness_observer() and the readiness.
func dom_document_notify_document_observers_of_readiness(this: DomDocument*, readiness: HtmlDocumentReadyState):
    defer dom_document_end_notifying_document_observers(this)
    dom_document_begin_notifying_document_observers(this)
    for document_observer in ak.vector_span(&this.m_document_observers_being_notified):
        if let notifier = document_observer.m_document_readiness_observer:
            ak.function1_call(&notifier.function, readiness)

## notify_each_document_observer with document_completely_loaded().
func dom_document_notify_document_observers_completely_loaded(this: DomDocument*):
    defer dom_document_end_notifying_document_observers(this)
    dom_document_begin_notifying_document_observers(this)
    for document_observer in ak.vector_span(&this.m_document_observers_being_notified):
        if let notifier = document_observer.m_document_completely_loaded:
            ak.function0_call(&notifier.function)

## notify_each_document_observer with document_became_active().
func dom_document_notify_document_observers_became_active(this: DomDocument*):
    defer dom_document_end_notifying_document_observers(this)
    dom_document_begin_notifying_document_observers(this)
    for document_observer in ak.vector_span(&this.m_document_observers_being_notified):
        if let notifier = document_observer.m_document_became_active:
            ak.function0_call(&notifier.function)

