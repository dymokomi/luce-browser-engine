## is<Web::DOM::Element>: the class-id range test.
pub func is_dom_element[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= dom_element_class.first_id and id <= dom_element_class.last_id

## as_if<Web::DOM::Element>.
pub func as_if_dom_element[P: gc.IsCell](p: P*) -> DomElement*?:
    if is_dom_element(p): return (DomElement*)p
    return none

## as<Web::DOM::Element> (verify_cast).
pub func as_dom_element[P: gc.IsCell](p: P*) -> DomElement*:
    return as_if_dom_element(p) else trap("as<Web::DOM::Element> failed")

