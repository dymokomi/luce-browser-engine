## Ported from Element.cpp:4399 Web::DOM::Element::document_or_shadow_root_style_sheets.
pub func dom_element_document_or_shadow_root_style_sheets(this: DomElement*) -> CssStyleSheetList*:
    let root_node = tree_node_root(this.dom_node())
    if let shadow_root = as_if_dom_shadow_root(root_node):
        return dom_shadow_root_style_sheets(shadow_root)

    return dom_document_style_sheets(dom_element_document(this))

## Ported from Element.cpp:4408 Web::DOM::Element::document_or_shadow_root_element_by_id_map.
pub func dom_element_document_or_shadow_root_element_by_id_map(this: DomElement*) -> DomElementByIdMap*:
    let root_node = tree_node_root(this.dom_node())
    if let shadow_root = as_if_dom_shadow_root(root_node):
        return dom_shadow_root_element_by_id(shadow_root)
    return dom_document_element_by_id(dom_element_document(this))

# mark: getHTML and setHTMLUnsafe ===============================================================

## Ported from Element.cpp:4417 Web::DOM::Element::get_html.
# https://html.spec.whatwg.org/multipage/dynamic-markup-insertion.html#dom-element-gethtml
pub func dom_element_get_html(this: DomElement*, options: DomGetHtmlOptions) -> ak.String!:
    # Element's getHTML(options) method steps are to return the result
    # of HTML fragment serialization algorithm with this,
    # options["serializableShadowRoots"], and options["shadowRoots"].
    let serializable_shadow_roots = HtmlParserSerializableShadowRoots.yes if options.serializable_shadow_roots else HtmlParserSerializableShadowRoots.no
    return html_parser_serialize_html_fragment(this.dom_node(), serializable_shadow_roots, options.shadow_roots)

## Ported from Element.cpp:4429 Web::DOM::Element::set_html_unsafe.
# https://html.spec.whatwg.org/multipage/dynamic-markup-insertion.html#dom-element-sethtmlunsafe
pub func dom_element_set_html_unsafe(this: DomElement*, html: TrustedTypesTrustedHtmlOrString) -> !:
    # 1. Let compliantHTML be the result of invoking the Get Trusted Type compliant string algorithm with
    #    TrustedHTML, this's relevant global object, html, "Element setHTMLUnsafe", and "script".
    # (TrustedTypes::Script.to_string() is "'script'".)
    let compliant_html = try trusted_types_get_trusted_type_compliant_string(TrustedTypesTrustedTypeName.trusted_html, html_relevant_global_object((JsObject*)this), dom_element_trusted_html_or_string_as_trusted_type(html), TrustedTypesInjectionSink.element_set_html_unsafe, ak.string_from_str("'script'"))

    # 2. Let target be this's template contents if this is a template element; otherwise this.
    var target = this.dom_node()
    if let template = as_if_html_template_element(this):
        target = html_template_element_content(template).dom_node()

    # 3. Unsafe set HTML given target, this, and compliantHTML.
    let compliant_utf8 = ak.utf16_string_base_to_utf8_but_should_be_ported_to_utf16(&compliant_html.utf16_string_base)
    try dom_node_unsafely_set_html(target, this, ak.string_bytes_as_string_view(&compliant_utf8))

