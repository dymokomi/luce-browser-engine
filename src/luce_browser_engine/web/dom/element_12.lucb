#==============================================================================================
#
#   element_12 - DOM::Element: attribute change steps, lang, attributes(), animations, focus
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Element.cpp (lines 4247-4532 and 4565-4828): the attribute change
#       steps Element runs for slot, id, name, class, style, dir, lang, part and exportparts
#       and the ARIA element-reference attributes; the custom element reaction queue and
#       state set; the style sheets and ID map of the element's root; getHTML and
#       setHTMLUnsafe; counters; lang; rendering, view transitions and pointer capture;
#       attributes() and the HTML-uppercased qualified name; playing or cancelling CSS
#       animations; focus indication and focusability; computedStyleMap; random base values;
#       pointer lock; the element style is inherited from; and render blocking.
#
#==============================================================================================

# mark: Attribute change steps ==================================================================

## `value.bytes_as_string_view().split_view_if(Infra::is_ascii_whitespace)` as FlyStrings, into
## `tokens` (cleared first, as the class and part steps do).
func dom_element_set_tokens_from_value(tokens: ak.Vector[ak.FlyString]*, value: const ak.String*):
    let view = ak.string_bytes_as_string_view(value)
    let predicate = DomElementIsAsciiWhitespace(unused = 0)
    var new_tokens = ak.string_view_split_view_if(&view, &predicate)
    ak.vector_clear(tokens)
    ak.vector_ensure_capacity(tokens, ak.vector_size(&new_tokens))
    for new_token in ak.vector_span(&new_tokens):
        ak.vector_append_t(tokens, ak.fly_string_from_utf8(new_token) else trap("FIXME: should propagate errors"))

## Ported from Element.cpp:4248 Web::DOM::Element::attribute_changed (virtual).
# https://dom.spec.whatwg.org/#concept-element-attributes-change-ext
pub func dom_element_attribute_changed_impl(this: DomElement*, local_name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    # AD-HOC: Everything below requires that there is no namespace, so return early if there is one.
    if namespace_ != none:
        return

    # https://dom.spec.whatwg.org/#ref-for-concept-element-attributes-change-ext①
    # 1. If localName is slot and namespace is null, then:
    if ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_slot):
        # 1. If value is oldValue, then return.
        if dom_node_optional_strings_equal(value, old_value):
            return

        # 2. If value is null and oldValue is the empty string, then return.
        if value == none and dom_node_optional_string_equals(old_value, ak.string_new()):
            return

        # 3. If value is the empty string and oldValue is null, then return.
        if dom_node_optional_string_equals(value, ak.string_new()) and old_value == none:
            return

        # 4. If value is null or the empty string, then set element’s name to the empty string.
        let new_name = value else ak.string_new()
        if ak.string_is_empty(&new_name):
            dom_slottable_mixin_set_slottable_name(&this.slottable_mixin, ak.fly_string_new())
        # 5. Otherwise, set element’s name to value.
        else:
            dom_slottable_mixin_set_slottable_name(&this.slottable_mixin, ak.fly_string_from_string(new_name))

        # 6. If element is assigned, then run assign slottables for element’s assigned slot.
        if let assigned_slot = dom_slottable_mixin_assigned_slot_internal(&this.slottable_mixin):
            dom_assign_slottables(assigned_slot)

        # 7. Run assign a slot for element.
        dom_assign_a_slot(DomSlottable.dom_element(this))
        return

    let value_or_empty = value else ak.string_new()

    if ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_id):
        if ak.string_is_empty(&value_or_empty):
            this.m_id = none
        else:
            this.m_id = ak.fly_string_from_string(value_or_empty)

        if dom_node_is_connected(this.dom_node()):
            var old_value_fly_string: ak.FlyString? = none
            if let old = old_value:
                old_value_fly_string = ak.fly_string_from_string(old)
            dom_document_element_id_changed(dom_element_document(this), this, old_value_fly_string)
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_name):
        if ak.string_is_empty(&value_or_empty):
            this.m_name = none
        else:
            this.m_name = ak.fly_string_from_string(value_or_empty)

        if dom_node_is_connected(this.dom_node()):
            dom_document_element_name_changed(dom_element_document(this), this)
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_class):
        if ak.string_is_empty(&value_or_empty):
            ak.vector_clear(&this.m_classes)
        else:
            dom_element_set_tokens_from_value(&this.m_classes, &value_or_empty)
        if let class_list = this.m_class_list:
            dom_token_list_associated_attribute_changed(class_list, ak.string_bytes_as_string_view(&value_or_empty))
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_style):
        # https://drafts.csswg.org/cssom/#ref-for-cssstyledeclaration-updating-flag
        if let inline_style = this.m_inline_style:
            if css_style_declaration_is_updating(inline_style.css_style_declaration()):
                return
        if this.m_inline_style == none:
            var properties: ak.Vector[CssStyleProperty]
            var custom_properties: ak.OrderedHashMap[ak.FlyString, CssStyleProperty, ak.FlyStringTraits]
            this.m_inline_style = css_style_properties_create_element_inline_style(dom_element_abstract_element(this), properties, custom_properties)
        let inline_style = this.m_inline_style else trap("unreachable")
        let text = value else ak.string_new()
        css_style_properties_set_declarations_from_text(inline_style, ak.string_bytes_as_string_view(&text))
        dom_prefetch_inline_style_image_resources(inline_style, dom_element_document(this))
        dom_node_set_needs_style_update(this.dom_node(), true)
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_dir) or ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_lang):
        let is_dir = ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_dir)
        if is_dir:
            # https://html.spec.whatwg.org/multipage/dom.html#attr-dir
            if dom_element_string_equals_ignoring_ascii_case(&value_or_empty, "ltr"):
                this.m_dir = DomElementDir.ltr
            elif dom_element_string_equals_ignoring_ascii_case(&value_or_empty, "rtl"):
                this.m_dir = DomElementDir.rtl
            elif dom_element_string_equals_ignoring_ascii_case(&value_or_empty, "auto"):
                this.m_dir = DomElementDir.auto
            else:
                this.m_dir = none
        if is_dir:
            css_invalidation_invalidate_style_after_directionality_change(this)
        else:
            css_invalidation_invalidate_style_after_language_change(this)
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_part):
        ak.vector_clear(&this.m_parts)
        if not ak.string_is_empty(&value_or_empty):
            dom_element_set_tokens_from_value(&this.m_parts, &value_or_empty)
        if let part_list = this.m_part_list:
            dom_token_list_associated_attribute_changed(part_list, ak.string_bytes_as_string_view(&value_or_empty))
        css_invalidation_invalidate_style_after_part_attribute_change(this)
    elif ak.fly_string_eq_fly_string(&local_name, &html_attribute_names_exportparts):
        css_invalidation_invalidate_style_after_exportparts_attribute_change(this)

    # https://html.spec.whatwg.org/multipage/common-dom-interfaces.html#reflecting-content-attributes-in-idl-attributes:concept-element-attributes-change-ext
    # 1. If localName is not attr or namespace is not null, then return.
    # 2. Set element's explicitly set attr-element to null.
    # (ENUMERATE_ARIA_ELEMENT_REFERENCING_ATTRIBUTES)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_active_descendant):
        aria_mixin_set_aria_active_descendant_element(&this.aria_mixin, none)

    # https://html.spec.whatwg.org/multipage/common-dom-interfaces.html#reflecting-content-attributes-in-idl-attributes:concept-element-attributes-change-ext-2
    # 1. If localName is not attr or namespace is not null, then return.
    # 2. Set element's explicitly set attr-elements to null.
    # (ENUMERATE_ARIA_ELEMENT_LIST_REFERENCING_ATTRIBUTES)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_controls):
        aria_mixin_set_aria_controls_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_described_by):
        aria_mixin_set_aria_described_by_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_details):
        aria_mixin_set_aria_details_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_error_message):
        aria_mixin_set_aria_error_message_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_flow_to):
        aria_mixin_set_aria_flow_to_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_labelled_by):
        aria_mixin_set_aria_labelled_by_elements(&this.aria_mixin, none)
    elif ak.fly_string_eq_fly_string(&local_name, &aria_attribute_names_aria_owns):
        aria_mixin_set_aria_owns_elements(&this.aria_mixin, none)

