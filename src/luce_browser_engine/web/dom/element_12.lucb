# mark: CSS animations ==========================================================================

## Element::play_or_cancel_animations_after_display_property_change's `play_or_cancel_depending_on_display`
## lambda.
func dom_element_play_or_cancel_depending_on_display(this: DomElement*, has_inclusive_ancestor_with_display_none_ignoring_animations: bool, animations: ak.HashMap[ak.FlyString, CssAnimation*, ak.FlyStringTraits]*):
    for entry in ak.hash_map_begin(animations):
        let animation = (AnimationsAnimation*)entry.value
        if has_inclusive_ancestor_with_display_none_ignoring_animations:
            animations_animation_cancel(animation)
        else:
            # NOTE: It is safe to assume this has a value as it is set when creating a CSS defined animation
            let play_state = animations_animation_last_css_animation_play_state(animation) else trap("a CSS defined animation has a play state")

            if play_state == css_data.AnimationPlayState.running:
                var context: HtmlTemporaryExecutionContext = ---
                html_temporary_execution_context_construct_realm(&context, dom_element_realm(this))
                defer html_temporary_execution_context_destruct(&context)
                animations_animation_play(animation) else trap("FIXME: should propagate errors")
            elif play_state == css_data.AnimationPlayState.paused:
                var context: HtmlTemporaryExecutionContext = ---
                html_temporary_execution_context_construct_realm(&context, dom_element_realm(this))
                defer html_temporary_execution_context_destruct(&context)
                animations_animation_pause(animation) else trap("FIXME: should propagate errors")

## Ported from Element.cpp:4639 Web::DOM::Element::play_or_cancel_animations_after_display_property_change.
func dom_element_play_or_cancel_animations_after_display_property_change(this: DomElement*):
    # OPTIMIZATION: We don't care about elements with no CSS defined animations
    if not animations_animatable_has_css_defined_animations(&this.animatable):
        return

    # OPTIMIZATION: We don't care about animations in disconnected subtrees.
    if not dom_node_is_connected(this.dom_node()):
        return

    # https://drafts.csswg.org/css-animations-2/#owning-element-section
    # If the display property of an element is set to none and its display value would compute to none when ignoring
    # the Transitions and Animations cascade origins, then terminate running animations with this owning element. If
    # an element has a display of none and its display value had computed to none when ignoring the Transitions and
    # Animations cascade origins, updating display to a value other than none will start all animations applied to
    # the element by the animation-name property.

    # FIXME: What does it mean that "is set to none" is separate from "would compute to none...", do we need to check
    #        the cascaded value as well?

    # AD-HOC: Other browsers also check for ancestors which meet the above criteria, so we do that as well.
    # FIXME: Do we need to open a spec issue for this?

    let has_inclusive_ancestor_with_display_none_ignoring_animations = dom_node_has_inclusive_ancestor_with_display_none_ignoring_animations(this.dom_node())

    dom_element_play_or_cancel_depending_on_display(this, has_inclusive_ancestor_with_display_none_ignoring_animations, animations_animatable_css_defined_animations(&this.animatable, none) else trap("css_defined_animations({}) is non-null"))

    for i in 0..<(u8)css_data.PseudoElement.known_pseudo_element_count:
        let pseudo_element = (css_data.PseudoElement)i
        dom_element_play_or_cancel_depending_on_display(this, has_inclusive_ancestor_with_display_none_ignoring_animations, animations_animatable_css_defined_animations(&this.animatable, pseudo_element) else trap("css_defined_animations(known pseudo-element) is non-null"))

# mark: Focus ===================================================================================

## Ported from Element.cpp:4692 Web::DOM::Element::should_indicate_focus.
# https://drafts.csswg.org/selectors/#indicate-focus
pub func dom_element_should_indicate_focus(this: DomElement*) -> bool:
    # User agents can choose their own heuristics for when to indicate focus; however, the following (non-normative)
    # suggestions can be used as a starting point for when to indicate focus on the currently focused element:

    # FIXME: * If the user has expressed a preference (such as via a system preference or a browser setting) to always see a
    #   visible focus indicator, indicate focus regardless of any other factors. (Another option may be for the user
    #   agent to show its own focus indicator regardless of author styles.)

    # * If the element which supports keyboard input (such as an input element, or any other element that would
    #   triggers a virtual keyboard to be shown on focus if a physical keyboard were not present), indicate focus.
    if as_if_form_associated_text_control_element(this) != none or dom_node_is_editable_or_editing_host(this.dom_node()):
        return true

    # * If the user interacts with the page via keyboard or some other non-pointing device, indicate focus. (This means
    #   keyboard usage may change whether this pseudo-class matches even if it doesn’t affect :focus).
    if dom_document_last_focus_trigger(dom_element_document(this)) == HtmlFocusTrigger.key:
        return true

    # FIXME: * If the user interacts with the page via a pointing device (mouse, touchscreen, etc.) and the focused element
    #   does not support keyboard input, don’t indicate focus.

    # * If the previously-focused element indicated focus, and a script causes focus to move elsewhere, indicate focus
    #   on the newly focused element.
    #   Conversely, if the previously-focused element did not indicate focus, and a script causes focus to move
    #   elsewhere, don’t indicate focus on the newly focused element.
    # AD-HOC: Other browsers seem to always indicate focus on programmatically focused elements.
    if dom_document_last_focus_trigger(dom_element_document(this)) == HtmlFocusTrigger.script:
        return true

    # FIXME: * If a newly-displayed element automatically gains focus (such as an action button in a freshly opened dialog),
    #   that element should indicate focus.

    return false

## Ported from Element.cpp:4729 Web::DOM::Element::is_focusable (override).
# https://html.spec.whatwg.org/multipage/interaction.html#tabindex-value
pub func dom_element_is_focusable_impl(base: DomEventTarget*) -> bool:
    let this = (DomElement*)base
    let tabindex = dom_element_get_attribute_value(this, html_attribute_names_tabindex)
    return html_parse_integer(ak.string_bytes_as_string_view(&tabindex)) != none

## Ported from Element.cpp:4734 Web::DOM::Element::set_had_duplicate_attribute_during_tokenization.
pub func dom_element_set_had_duplicate_attribute_during_tokenization(this: DomElement*):
    this.m_had_duplicate_attribute_during_tokenization = true

# mark: computedStyleMap, random values and pointer lock ========================================

## Ported from Element.cpp:4740 Web::DOM::Element::computed_style_map.
# https://drafts.css-houdini.org/css-typed-om-1/#dom-element-computedstylemap
pub func dom_element_computed_style_map(this: DomElement*) -> CssStylePropertyMapReadOnly*:
    # The computedStyleMap() method must, when called on an Element this, perform the following steps:

    # 1. If this’s [[computedStyleMapCache]] internal slot is set to null, set its value to a new
    #    StylePropertyMapReadOnly object, whose [[declarations]] internal slot are the name and computed value of
    #    every longhand CSS property supported by the User Agent, every registered custom property, and every
    #    non-registered custom property which is not set to its initial value on this, in the standard order.
    #
    #    The computed values in the [[declarations]] of this object must remain up-to-date, changing as style
    #    resolution changes the properties on this and how they’re computed.
    #
    # NOTE: In practice, since the values are "hidden" behind a .get() method call, UAs can delay computing anything
    #    until a given property is actually requested.
    if this.m_computed_style_map_cache == none:
        this.m_computed_style_map_cache = css_style_property_map_read_only_create_computed_style(dom_element_realm(this), dom_element_abstract_element(this))

    # 2. Return this’s [[computedStyleMapCache]] internal slot.
    return this.m_computed_style_map_cache else trap("unreachable")

## The function-scope `static XorShift128PlusRNG random_number_generator` of
## Element::ensure_css_random_base_value (constructed on first use).
var dom_element_ensure_css_random_base_value_random_number_generator: ak.XorShift128PlusRng
var dom_element_ensure_css_random_base_value_random_number_generator_initialized: bool

## Element::ensure_css_random_base_value's lambda: the next value of the shared generator.
func dom_element_ensure_css_random_base_value_next(context: void*?) -> f64:
    if not dom_element_ensure_css_random_base_value_random_number_generator_initialized:
        ak.xor_shift128_plus_rng_construct(&dom_element_ensure_css_random_base_value_random_number_generator)
        dom_element_ensure_css_random_base_value_random_number_generator_initialized = true
    return ak.xor_shift128_plus_rng_get(&dom_element_ensure_css_random_base_value_random_number_generator)

## Ported from Element.cpp:4762 Web::DOM::Element::ensure_css_random_base_value.
pub func dom_element_ensure_css_random_base_value(this: DomElement*, random_caching_key: CssRandomCachingKey) -> f64:
    # NB: We cache element-shared random base values on the Document and non-element-shared ones on the Element itself
    #     so that when an element is removed it takes its non-shared cache with it.
    if random_caching_key.element_id == none:
        return dom_document_ensure_element_shared_css_random_base_value(dom_element_document(this), random_caching_key)

    return *ak.hash_map_ensure_t_callback(&this.m_element_specific_css_random_base_value_cache, random_caching_key, ak.Function0[f64](call = dom_element_ensure_css_random_base_value_next, context = none))

## Ported from Element.cpp:4775 Web::DOM::Element::request_pointer_lock.
pub func dom_element_request_pointer_lock(this: DomElement*, arg0: DomPointerLockOptions?) -> JsPromiseCapability*:
    ak.dbgln("FIXME: request_pointer_lock()")
    let promise = idl_create_promise(dom_element_realm(this))
    let error_ = idl_not_supported_error_create(dom_element_realm(this), ak.utf16_string_from_str("request_pointer_lock() is not implemented"))
    idl_reject_promise(dom_element_realm(this), promise, js_value_from_object((JsObject*)error_))
    return promise

# mark: Style inheritance and render blocking ===================================================

## Ported from Element.cpp:4788 Web::DOM::Element::element_to_inherit_style_from.
# The element to inherit style from.
# If a pseudo-element is specified, this will return the element itself.
# Otherwise, if this element is slotted somewhere, it will return the slot.
# Otherwise, it will return the parent or shadow host element of this element.
pub func dom_element_element_to_inherit_style_from(this: DomElement*, pseudo_element: css_data.PseudoElement?) -> DomElement*?:
    if pseudo_element != none:
        return this
    if let slot = dom_slottable_mixin_assigned_slot_internal(&this.slottable_mixin):
        return slot.dom_element()
    return dom_node_parent_or_shadow_host_element(this.dom_node())

## Ported from Element.cpp:4798 Web::DOM::Element::block_rendering.
# https://html.spec.whatwg.org/multipage/dom.html#block-rendering
pub func dom_element_block_rendering(this: DomElement*):
    # 1. Let document be el's node document.
    let document = dom_element_document(this)

    # 2. If document allows adding render-blocking elements, then append el to document's render-blocking element set.
    if dom_document_allows_adding_render_blocking_elements(document):
        dom_document_add_render_blocking_element(document, this)

## Ported from Element.cpp:4810 Web::DOM::Element::unblock_rendering.
# https://html.spec.whatwg.org/multipage/dom.html#unblock-rendering
pub func dom_element_unblock_rendering(this: DomElement*):
    # 1. Let document be el's node document.
    let document = dom_element_document(this)

    # 2. Remove el from document's render-blocking element set.
    dom_document_remove_render_blocking_element(document, this)

## Ported from Element.cpp:4820 Web::DOM::Element::is_potentially_render_blocking.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#potentially-render-blocking
pub func dom_element_is_potentially_render_blocking(this: DomElement*) -> bool:
    # An element is potentially render-blocking if
    # FIXME: its blocking tokens set contains "render",
    # or if it is implicitly potentially render-blocking, which will be defined at the individual elements.
    return dom_element_is_implicitly_potentially_render_blocking(this)
