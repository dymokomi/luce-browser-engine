pub func dom_element_ensure_custom_element_reaction_queue(this: DomElement*) -> ak.Vector[DomCustomElementUpgradeReactionOrDomCustomElementCallbackReaction]*:
    if this.m_custom_element_reaction_queue == none:
        this.m_custom_element_reaction_queue = new ak.Vector[DomCustomElementUpgradeReactionOrDomCustomElementCallbackReaction] else trap("out of memory")
    return this.m_custom_element_reaction_queue else trap("unreachable")

