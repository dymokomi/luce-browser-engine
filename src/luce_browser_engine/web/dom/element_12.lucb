# mark: lang ====================================================================================

## Element::lang's `determine_lang_attribute` lambda.
func dom_element_determine_lang_attribute(this: DomElement*) -> ak.String:
    # 1. If the node is an element that has a lang attribute in the XML namespace set
    #      Use the value of that attribute.
    let maybe_xml_lang = dom_element_get_attribute_ns(this, namespace_xml, html_attribute_names_lang)
    if let xml_lang = maybe_xml_lang:
        return xml_lang

    # 2. If the node is an HTML element or an element in the SVG namespace, and it has a lang in no namespace attribute set
    #      Use the value of that attribute.
    if dom_node_is_html_element(this.dom_node()) or dom_node_optional_fly_string_is(dom_element_namespace_uri(this), namespace_svg):
        let maybe_lang = dom_element_get_attribute(this, html_attribute_names_lang)
        if let lang = maybe_lang:
            return lang

    # 3. If the node's parent is a shadow root
    #      Use the language of that shadow root's host.
    if let parent = tree_node_parent(this.dom_node()):
        if dom_node_is_shadow_root(parent):
            let host = dom_document_fragment_host(as_dom_shadow_root(parent).dom_document_fragment()) else trap("a shadow root has a host")
            return dom_element_lang(host) else ak.string_new()

    # 4. If the node's parent element is not null
    #      Use the language of that parent element.
    if let parent = dom_node_parent_element(this.dom_node()):
        return dom_element_lang(parent) else ak.string_new()

    # 5. Otherwise
    #      - If there is a pragma-set default language set, then that is the language of the node.
    if let pragma_set_default_language = dom_document_pragma_set_default_language(dom_element_document(this)):
        return pragma_set_default_language

    #      - If there is no pragma-set default language set, then language information from a higher-level protocol (such as HTTP),
    if let http_content_language = dom_document_http_content_language(dom_element_document(this)):
        return http_content_language

    #        if any, must be used as the final fallback language instead.
    #      - In the absence of any such language information, and in cases where the higher-level protocol reports multiple languages,
    #        the language of the node is unknown, and the corresponding language tag is the empty string.
    # Default locale sounds like a reasonable fallback here.
    return ak.string_new()

## Ported from Element.cpp:4471 Web::DOM::Element::lang.
# https://html.spec.whatwg.org/multipage/dom.html#the-lang-and-xml:lang-attributes
pub func dom_element_lang(this: DomElement*) -> ak.String?:
    if this.m_lang_value == none:
        this.m_lang_value = dom_element_determine_lang_attribute(this)

    # If the resulting value is the empty string, then it must be interpreted as meaning that the language of the node is explicitly unknown.
    let lang_value = this.m_lang_value else trap("unreachable")
    if ak.string_is_empty(&lang_value):
        return none

    return lang_value

## Ported from Element.cpp:4526 Web::DOM::Element::invalidate_lang_value.
pub func dom_element_invalidate_lang_value(this: DomElement*):
    if this.m_lang_value != none:
        this.m_lang_value = none
        dom_node_set_needs_style_update(this.dom_node(), true)

# mark: Rendering, view transitions and pointer capture =========================================

## Ported from Element.cpp:4566 Web::DOM::Element::not_rendered.
# https://drafts.csswg.org/css-images-4/#element-not-rendered
pub func dom_element_not_rendered(this: DomElement*) -> bool:
    # An element is not rendered if it does not have an associated box.
    if dom_element_layout_node(this) == none or dom_node_paintable_box(this.dom_node()) == none:
        return true

    return false

## Ported from Element.cpp:4576 Web::DOM::Element::document_scoped_view_transition_name.
# https://drafts.csswg.org/css-view-transitions-1/#document-scoped-view-transition-name
pub func dom_element_document_scoped_view_transition_name(this: DomElement*) -> ak.FlyString?:
    # To get the document-scoped view transition name for an Element element:

    # 1. Let scopedViewTransitionName be the computed value of view-transition-name for element.
    let computed_properties = dom_element_computed_properties(this) else trap("document_scoped_view_transition_name: no computed properties")
    let scoped_view_transition_name = css_computed_properties_view_transition_name(computed_properties)

    # 2. If scopedViewTransitionName is associated with element’s node document, then return
    #    scopedViewTransitionName.
    # FIXME: Properly handle tree-scoping of the name here.
    #        (see https://drafts.csswg.org/css-view-transitions-1/#propdef-view-transition-name , "Each view transition name is a tree-scoped name.")
    return scoped_view_transition_name

    # 3. Otherwise, return none.

## Ported from Element.cpp:4597 Web::DOM::Element::capture_the_image.
# https://drafts.csswg.org/css-view-transitions-1/#capture-the-image
# To capture the image given an element element, perform the following steps. They return an image.
pub func dom_element_capture_the_image(this: DomElement*) -> gfx.ImmutableBitmap*?:
    # FIXME: Actually implement this.
    var size: gfx.IntSize = ---
    gfx.int_size_construct(&size, 1, 1)
    let bitmap = gfx.bitmap_create_alpha_type(gfx.BitmapFormat.bgra8888, gfx.AlphaType.premultiplied, size) else trap("MUST: Gfx::Bitmap::create")
    var color_space: gfx.ColorSpace = ---
    gfx.color_space_construct(&color_space)
    return gfx.immutable_bitmap_create_color_space(bitmap, color_space)

