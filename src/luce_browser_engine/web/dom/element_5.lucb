## Ported from Element.cpp:2238 Web::DOM::Element::scroll_width.
# https://drafts.csswg.org/cssom-view/#dom-element-scrollwidth
pub func dom_element_scroll_width(this: DomElement*) -> i32:
    # 1. Let document be the element’s node document.
    let document = dom_element_document(this)

    # 2. If document is not the active document, return zero and terminate these steps.
    if not dom_document_is_active(document):
        return 0

    # NOTE: Ensure that layout is up-to-date before looking at metrics.
    dom_document_update_layout(document, DomUpdateLayoutReason.element_scroll_width)
    let viewport_paintable = dom_document_paintable(document) else trap("VERIFY: document.paintable()")
    assert(dom_node_paintable_box(document.dom_node()) != none)
    let viewport_scrolling_area = paint_paintable_box_scrollable_overflow_rect(viewport_paintable.paint_paintable_box()) else trap("VERIFY: scrollable_overflow_rect()")

    # 3. Let viewport width be the width of the viewport excluding the width of the scroll bar, if any,
    #    or zero if there is no viewport.
    let viewport_rect = dom_document_viewport_rect(document)
    let viewport_rect_width = gfx.css_pixel_rect_width(&viewport_rect)
    let viewport_width = gfx.css_pixels_to_int_const(&viewport_rect_width)
    let viewport_scrolling_area_rect_width = gfx.css_pixel_rect_width(&viewport_scrolling_area)
    let viewport_scrolling_area_width = gfx.css_pixels_to_int_const(&viewport_scrolling_area_rect_width)

    # 4. If the element is the root element and document is not in quirks mode
    #    return max(viewport scrolling area width, viewport width).
    if dom_document_document_element(document) == this and not dom_document_in_quirks_mode(document):
        return ak.max(viewport_scrolling_area_width, viewport_width)

    # 5. If the element is the body element, document is in quirks mode and the element is not potentially scrollable,
    #    return max(viewport scrolling area width, viewport width).
    if dom_element_is_the_body(this, document) and dom_document_in_quirks_mode(document) and not dom_element_is_potentially_scrollable(this):
        return ak.max(viewport_scrolling_area_width, viewport_width)

    # 6. If the element does not have any associated box return zero and terminate these steps.
    let paintable_box = dom_node_paintable_box(this.dom_node()) else return 0

    # 7. Return the width of the element’s scrolling area.
    if let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(paintable_box):
        let width = gfx.css_pixel_rect_width(&scrollable_overflow_rect)
        return gfx.css_pixels_to_int_const(&width)

    return 0

## Ported from Element.cpp:2278 Web::DOM::Element::scroll_height.
# https://drafts.csswg.org/cssom-view/#dom-element-scrollheight
pub func dom_element_scroll_height(this: DomElement*) -> i32:
    # 1. Let document be the element’s node document.
    let document = dom_element_document(this)

    # 2. If document is not the active document, return zero and terminate these steps.
    if not dom_document_is_active(document):
        return 0

    # NOTE: Ensure that layout is up-to-date before looking at metrics.
    dom_document_update_layout(document, DomUpdateLayoutReason.element_scroll_height)
    let viewport_paintable = dom_document_paintable(document) else trap("VERIFY: document.paintable()")
    assert(dom_node_paintable_box(document.dom_node()) != none)
    let viewport_scrolling_area = paint_paintable_box_scrollable_overflow_rect(viewport_paintable.paint_paintable_box()) else trap("VERIFY: scrollable_overflow_rect()")

    # 3. Let viewport height be the height of the viewport excluding the height of the scroll bar, if any,
    #    or zero if there is no viewport.
    let viewport_rect = dom_document_viewport_rect(document)
    let viewport_rect_height = gfx.css_pixel_rect_height(&viewport_rect)
    let viewport_height = gfx.css_pixels_to_int_const(&viewport_rect_height)
    let viewport_scrolling_area_rect_height = gfx.css_pixel_rect_height(&viewport_scrolling_area)
    let viewport_scrolling_area_height = gfx.css_pixels_to_int_const(&viewport_scrolling_area_rect_height)

    # 4. If the element is the root element and document is not in quirks mode
    #    return max(viewport scrolling area height, viewport height).
    if dom_document_document_element(document) == this and not dom_document_in_quirks_mode(document):
        return ak.max(viewport_scrolling_area_height, viewport_height)

    # 5. If the element is the body element, document is in quirks mode and the element is not potentially scrollable,
    #    return max(viewport scrolling area height, viewport height).
    if dom_element_is_the_body(this, document) and dom_document_in_quirks_mode(document) and not dom_element_is_potentially_scrollable(this):
        return ak.max(viewport_scrolling_area_height, viewport_height)

    # 6. If the element does not have any associated box return zero and terminate these steps.
    let paintable_box = dom_node_paintable_box(this.dom_node()) else return 0

    # 7. Return the height of the element’s scrolling area.
    if let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(paintable_box):
