# mark: Disabled ================================================================================

## Ported from Element.cpp:2318 Web::DOM::Element::is_actually_disabled.
# https://html.spec.whatwg.org/multipage/semantics-other.html#concept-element-disabled
pub func dom_element_is_actually_disabled(this: DomElement*) -> bool:
    # An element is said to be actually disabled if it is one of the following:
    # - a button element that is disabled
    # - an input element that is disabled
    # - a select element that is disabled
    # - a textarea element that is disabled
    if is_html_button_element(this) or is_html_input_element(this) or is_html_select_element(this) or is_html_text_area_element(this):
        let form_associated_element = as_if_form_associated_element(this) else trap("as<HTML::FormAssociatedElement> failed")
        return not html_form_associated_element_enabled(form_associated_element)

    # - an optgroup element that has a disabled attribute
    if is_html_opt_group_element(this):
        return dom_element_has_attribute(this, html_attribute_names_disabled)

    # - an option element that is disabled
    if let option_element = as_if_html_option_element(this):
        return html_option_element_disabled(option_element)

    # - a fieldset element that is a disabled fieldset
    if let field_set_element = as_if_html_field_set_element(this):
        return html_field_set_element_is_disabled(field_set_element)

    # - a form-associated custom element that is disabled
    if let html_element = as_if_html_element(this):
        if html_element_is_form_associated_custom_element(html_element):
            let form_associated_element = as_if_form_associated_element(this) else trap("HTMLElement is a FormAssociatedElement")
            return not html_form_associated_element_enabled(form_associated_element)

    return false
