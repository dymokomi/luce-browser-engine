    # NOTE: Ensure that layout is up-to-date before looking at metrics or scrolling the page.
    dom_document_update_layout(document, DomUpdateLayoutReason.element_set_scroll_left)

    # 9. If the element is the body element, document is in quirks mode, and the element is not potentially scrollable, invoke scroll() on window with x as first argument and scrollY on window as second argument, and terminate these steps.
    if dom_element_is_the_body(this, document) and dom_document_in_quirks_mode(document) and not dom_element_is_potentially_scrollable(this):
        discard(html_window_scroll_f64(window, normalized_x, html_window_scroll_y(window)))
        return

    # 10. If the element does not have any associated box, the element has no associated scrolling box, or the element has no overflow, terminate these steps.
    let paintable_box = dom_node_paintable_box(this.dom_node()) else return

    if not layout_node_with_style_is_scroll_container(paint_paintable_box_layout_node_with_style_and_box_metrics(paintable_box).layout_node_with_style()):
