# https://drafts.csswg.org/cssom-view/#dom-element-scrollleft
pub func dom_element_set_scroll_left(this: DomElement*, x: f64):
    # 1. Let x be the given value.

    # 2. Normalize non-finite values for x.
    let normalized_x = html_normalize_non_finite_values_f64(x)

    # 3. Let document be the element’s node document.
    let document = dom_element_document(this)

    # 4. If document is not the active document, terminate these steps.
    if not dom_document_is_active(document):
        return

