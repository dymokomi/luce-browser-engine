## Ported from ProcessingInstruction.cpp:17 Web::DOM::ProcessingInstruction::ProcessingInstruction.
pub func dom_processing_instruction_construct(this: DomProcessingInstruction*, document: DomDocument*, data: ak.Utf16String, target: ak.String):
    dom_character_data_construct(this.dom_character_data(), document, DomNodeType.processing_instruction_node, data)
    this.m_target = target

## Ported from ProcessingInstruction.cpp:23 Web::DOM::ProcessingInstruction::initialize (override).
pub func dom_processing_instruction_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.processing_instruction)
    dom_character_data_initialize_impl(base, realm)

## Ported from ProcessingInstruction.h:20 Web::DOM::ProcessingInstruction::node_name (override).
pub func dom_processing_instruction_node_name_impl(base: DomNode*) -> ak.FlyString:
    let this = (DomProcessingInstruction*)base
    return ak.fly_string_from_string(this.m_target)

## Ported from ProcessingInstruction.h:22 Web::DOM::ProcessingInstruction::target.
pub func dom_processing_instruction_target(this: DomProcessingInstruction*) -> ak.String:
    return this.m_target
