#==============================================================================================
#
#   shadow_root_1 - DOM::ShadowRoot: construction, event parent, innerHTML, style sheets, ids
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/ShadowRoot.cpp (lines 1-283): the constructor and finalizer,
#       fullscreenElement, onslotchange, the event parent, innerHTML / getHTML /
#       setHTMLUnsafe, activeElement, the style sheet lists (document and adopted), getAnimations,
#       the id map and the slot registry. shadow_root_2 holds the part element map and the
#       inline functions of ShadowRoot.h.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from ShadowRoot.cpp:31 Web::DOM::ShadowRoot::ShadowRoot.
pub func dom_shadow_root_construct(this: DomShadowRoot*, document: DomDocument*, host: DomElement*, mode: BindShadowRootMode):
    dom_document_fragment_construct(this.dom_document_fragment(), document)
    dom_shadow_root_init_fields(this)
    this.m_mode = mode
    css_style_scope_construct(&this.m_style_scope, this.dom_node())
    dom_document_register_shadow_root(document, this)
    dom_document_fragment_set_host(this.dom_document_fragment(), host)

## Ported from ShadowRoot.cpp:40 Web::DOM::ShadowRoot::finalize (override).
pub func dom_shadow_root_finalize_impl(base: gc.Cell*):
    let this = (DomShadowRoot*)base
    # Base::finalize(): DocumentFragment inherits Node's.
    dom_node_finalize_impl(base)
    dom_document_unregister_shadow_root(dom_node_document(this.dom_node()), this)

## Ported from ShadowRoot.cpp:47 Web::DOM::ShadowRoot::fullscreen_element_for_bindings.
# https://fullscreen.spec.whatwg.org/#dom-document-fullscreenelement
pub func dom_shadow_root_fullscreen_element_for_bindings(this: DomShadowRoot*) -> DomElement*?:
    # 1. If this is a shadow root and its host is not connected, then return null.
    let host = dom_document_fragment_host(this.dom_document_fragment()) else return none
    if not dom_node_is_connected(host.dom_node()):
        return none

    # 2. Let candidate be the result of retargeting fullscreen element against this.
    # NB: ShadowRoot does not have it's own top layer. But the algorithm says to get the fullscreen element from the
    #     top layer, so it's grabbed from this' document.
    var fullscreen_element: DomEventTarget*? = none
    if let element = dom_document_fullscreen_element(dom_node_document(this.dom_node())):
        fullscreen_element = element.dom_event_target()
    let candidate = dom_retarget(fullscreen_element, this.dom_event_target()) else return none

    # 3. If candidate and this are in the same tree, then return candidate.
    let retargeted_element = as_dom_element(candidate)
    if tree_node_root(retargeted_element.dom_node()) == tree_node_root(this.dom_node()):
        return retargeted_element

    # 4. Return null.
    return none

## Ported from ShadowRoot.cpp:68 Web::DOM::ShadowRoot::initialize (override).
pub func dom_shadow_root_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.shadow_root)
    dom_document_fragment_initialize_impl(base, realm)

