        return realm_create_svg_text_path_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_title):
        return realm_create_svg_title_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_tspan):
        return realm_create_svg_svgt_span_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_use):
        return realm_create_svg_use_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_script):
        return realm_create_svg_script_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_view):
        return realm_create_svg_view_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_a):
        return realm_create_svg_svga_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_image):
        return realm_create_svg_image_element(realm, document, qualified_name).svg_element()

    # https://svgwg.org/svg2-draft/types.html#ElementsInTheSVGDOM
    # Elements in the SVG namespace whose local name does not match an element defined in any
    # specification supported by the software must nonetheless implement the SVGElement interface.
    return realm_create_svg_element(realm, document, qualified_name)

# mark: MathML ==================================================================================

## Ported from ElementFactory.cpp:590 Web::DOM::create_mathml_element.
func dom_create_mathml_element(document: DomDocument*, qualified_name: DomQualifiedName) -> MathMlMathMlElement*:
    let realm = bind_platform_object_realm(document.bind_platform_object())

    let local_name = dom_qualified_name_local_name(&qualified_name)
    if ak.fly_string_eq_fly_string(&local_name, &math_ml_tag_names_mi):
        return realm_create_math_ml_math_ml_mi_element(realm, document, qualified_name).math_ml_math_ml_element()
    if ak.fly_string_eq_fly_string(&local_name, &math_ml_tag_names_mspace):
        return realm_create_math_ml_math_ml_mspace_element(realm, document, qualified_name).math_ml_math_ml_element()

    # https://w3c.github.io/mathml-core/#dom-and-javascript
    # All the nodes representing MathML elements in the DOM must implement, and expose to scripts,
    # the following MathMLElement interface.

    # https://w3c.github.io/mathml-core/#mathml-elements-and-attributes
    # The term MathML element refers to any element in the MathML namespace.

    return realm_create_math_ml_math_ml_element(realm, document, qualified_name)
