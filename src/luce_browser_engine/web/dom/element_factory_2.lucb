## Ported from ElementFactory.cpp:479 Web::DOM::create_svg_element.
func dom_create_svg_element(document: DomDocument*, qualified_name: DomQualifiedName) -> SvgElement*:
    let realm = bind_platform_object_realm(document.bind_platform_object())
    let local_name = dom_qualified_name_local_name(&qualified_name)

    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_svg):
        return realm_create_svg_svgsvg_element(realm, document, qualified_name).svg_element()
    # FIXME: Support SVG's mixedCase tag names properly.
    if ak.fly_string_equals_ignoring_ascii_case_fly_string(&local_name, &svg_tag_names_clip_path):
        return realm_create_svg_clip_path_element(realm, document, qualified_name).svg_element()
    if ak.fly_string_eq_fly_string(&local_name, &svg_tag_names_circle):
