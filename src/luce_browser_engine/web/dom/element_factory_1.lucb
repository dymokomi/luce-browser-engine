#==============================================================================================
#
#   element_factory_1 - DOM::ElementFactory: element interfaces and their local names
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/ElementFactory.cpp (lines 149-319): the valid local names of each
#       HTML element interface, and whether a tag name makes an HTMLUnknownElement (the
#       ENUMERATE_HTML_TAGS check expanded in the macro's order).
#
#==============================================================================================

# mark: Helpers =================================================================================

## `FixedArray<FlyString>::create({ ... })`: a managed array holding the given names.
func dom_fixed_array_of_fly_strings(names: const ak.FlyString[]) -> ak.FlyString[]!:
    let array = try new ak.FlyString[names.length]
    for i in 0..<names.length:
        array[i] = names[i]
    return array

## `name.is_one_of(...)` over FlyStrings.
func dom_fly_string_is_one_of_fly_strings(name: ak.FlyString, names: const ak.FlyString[]) -> bool:
    for candidate in names:
        if ak.fly_string_eq_fly_string(&name, &candidate):
            return true
    return false

# mark: Valid local names =======================================================================

