#==============================================================================================
#
#   shadow_root_2 - DOM::ShadowRoot: the part element map, ShadowRoot.h and shadow-including walks
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/ShadowRoot.cpp (lines 284-378: the part element map with the
#       exportparts parser, and the custom element registry) and the inline functions of
#       ShadowRoot.h, including Node's shadow-including descendant traversals, which are
#       defined there.
#
#==============================================================================================

# mark: The part element map ====================================================================

## Ported from ShadowRoot.cpp:286 Web::DOM::ShadowRoot::part_element_map.
# C++ answers `PartElementMap const&`.
pub func dom_shadow_root_part_element_map(this: DomShadowRoot*) -> const ak.HashMap[ak.FlyString, ak.OrderedHashTable[DomAbstractElement, DomAbstractElementTraits], ak.FlyStringTraits]*:
    # FIXME: dom_tree_version() is crude and invalidates more than necessary.
    #        Come up with a smarter way of invalidating this if it turns out to be slow.
    let document = dom_node_document(this.dom_node())
    if this.m_dom_tree_version_when_calculated_part_element_map < dom_document_dom_tree_version(document):
        dom_shadow_root_calculate_part_element_map(this)
        this.m_dom_tree_version_when_calculated_part_element_map = dom_document_dom_tree_version(document)
    return &this.m_part_element_map

## `[](u32 c) { return c == ','; }`: the splitter of parse_exportparts_attribute.
struct DomParseExportpartsAttributeIsComma: ak.CodePointPredicate:
    var unused: u8

    func matches(code_point: u32) -> bool:
        return code_point == (u32)','

## parse_exportparts_attribute's per-mapping lambda, with its captures (the result vector).
struct DomParseExportpartsAttributeMapping: ak.Utf8ViewCallback:
    var result: ak.Vector[DomExportedPart]*

    mutating func call(mapping: ak.Utf8View):
        let mapping_string = ak.utf8_view_as_string(&mapping)
        let trimmed = ak.string_view_trim_whitespace(&mapping_string)
        if ak.string_view_is_empty(&trimmed):
            return

        let parts = ak.string_view_split_view_u8(&trimmed, ':', ak.SplitBehavior.keep_empty)
        if ak.vector_size(&parts) == 1:
            let name = ak.fly_string_from_utf8(ak.string_view_trim_whitespace(ak.vector_at_const(&parts, 0))) else trap("MUST: FlyString::from_utf8")
            ak.vector_append_t(self.result, DomExportedPart(inner_name = name, outer_name = name))
        elif ak.vector_size(&parts) == 2:
            let inner_name = ak.fly_string_from_utf8(ak.string_view_trim_whitespace(ak.vector_at_const(&parts, 0))) else trap("MUST: FlyString::from_utf8")
            let outer_name = ak.fly_string_from_utf8(ak.string_view_trim_whitespace(ak.vector_at_const(&parts, 1))) else trap("MUST: FlyString::from_utf8")
            ak.vector_append_t(self.result, DomExportedPart(inner_name = inner_name, outer_name = outer_name))

## Ported from ShadowRoot.cpp:304 Web::DOM::parse_exportparts_attribute.
# https://drafts.csswg.org/css-shadow-1/#exportparts
# Parse the exportparts attribute into a list of (inner_name, outer_name) pairs.
func dom_parse_exportparts_attribute(element: DomElement*) -> ak.Vector[DomExportedPart]:
    var result: ak.Vector[DomExportedPart]
    let exportparts = dom_element_get_attribute(element, html_attribute_names_exportparts) else return result

    let code_points = ak.string_code_points(&exportparts)
    let splitter = DomParseExportpartsAttributeIsComma(unused = 0)
    var mapping = DomParseExportpartsAttributeMapping(result = &result)
    ak.utf8_view_for_each_split_view(&code_points, &splitter, ak.SplitBehavior.nothing, &mapping)

    return result

## Ported from ShadowRoot.cpp:330 Web::DOM::ShadowRoot::calculate_part_element_map.
# https://drafts.csswg.org/css-shadow-1/#calculate-the-part-element-map
func dom_shadow_root_calculate_part_element_map(this: DomShadowRoot*):
    # To calculate the part element map of a shadow root, outerRoot:

    ak.hash_map_clear(&this.m_part_element_map)

    # 1. For each descendant el within outerRoot:
    for node in dom_node_subtree(this.dom_node()):
        let element = as_if_dom_element(node) else continue

        # 1. For each name in el’s part name list, append el to outerRoot’s part element map[name].
        for name in dom_element_part_names(element):
            let elements = ak.hash_map_ensure(&this.m_part_element_map, name)
            discard(ak.ordered_hash_table_set(elements, dom_abstract_element_make(element)))

        # 2. If el is a shadow host itself then let innerRoot be its shadow root.
        if dom_element_is_shadow_host(element):
            let inner_root = dom_element_shadow_root(element) else trap("VERIFY: shadow host's shadow root")

            # 3. Calculate innerRoot’s part element map.
            let inner_map = dom_shadow_root_part_element_map(inner_root)

            # 4. For each innerName/outerName in el’s forwarded part name list:
            let forwarded_parts = dom_parse_exportparts_attribute(element)
            for part in ak.vector_span_const(&forwarded_parts):
                # 1. If innerName is an ident:
                if let inner_parts = ak.hash_map_get_k_const(inner_map, part.inner_name):
                    # 1. Let innerParts be innerRoot’s part element map[innerName]
                    # 2. Append the elements in innerParts to outerRoot’s part element map[outerName]
                    for abstract_el in ak.ordered_hash_table_begin((ak.OrderedHashTable[DomAbstractElement, DomAbstractElementTraits]*)inner_parts):
                        let outer_elements = ak.hash_map_ensure(&this.m_part_element_map, part.outer_name)
                        discard(ak.ordered_hash_table_set(outer_elements, *abstract_el))
                # FIXME: 2. If innerName is a pseudo-element name, append innerRoot’s
                #        pseudo-element(s) with that name to outerRoot’s part element map[outerName].

## Ported from ShadowRoot.cpp:368 Web::DOM::ShadowRoot::custom_element_registry.
# https://dom.spec.whatwg.org/#dom-documentorshadowroot-customelementregistry
pub func dom_shadow_root_custom_element_registry(this: DomShadowRoot*) -> HtmlCustomElementRegistry*?:
    # 1. If this is a document, then return this’s custom element registry.
    # NB: Impossible.

    # 2. Assert: this is a ShadowRoot node.
    # 3. Return this’s custom element registry.
    return this.m_custom_element_registry

