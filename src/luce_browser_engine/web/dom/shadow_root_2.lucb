# mark: Shadow-including traversal ==============================================================

# https://dom.spec.whatwg.org/#concept-shadow-including-tree-order
# In shadow-including tree order is shadow-including preorder, depth-first traversal of a node tree.
# Shadow-including preorder, depth-first traversal of a node tree tree is preorder, depth-first traversal
# of tree, with for each shadow host encountered in tree, shadow-including preorder, depth-first traversal
# of that element’s shadow root’s node tree just after it is encountered.

# https://dom.spec.whatwg.org/#concept-shadow-including-descendant
# An object A is a shadow-including descendant of an object B, if A is a descendant of B, or A’s root is a
# shadow root and A’s root’s host is a shadow-including inclusive descendant of B.

# https://dom.spec.whatwg.org/#concept-shadow-including-inclusive-descendant
# A shadow-including inclusive descendant is an object or one of its shadow-including descendants.

## Ported from ShadowRoot.h:187 Web::DOM::Node::for_each_shadow_including_inclusive_descendant.
pub func dom_node_for_each_shadow_including_inclusive_descendant(this: DomNode*, callback: ak.Function1[DomNode*, TraversalDecision]) -> TraversalDecision:
    let call = callback.call else trap("VERIFY: callback")
    let decision = call(callback.context, this)
    if decision == TraversalDecision.break_:
        return TraversalDecision.break_
    if decision == TraversalDecision.skip_children_and_continue:
        return TraversalDecision.continue_

    if dom_node_for_each_shadow_including_descendant(this, callback) == TraversalDecision.break_:
        return TraversalDecision.break_

    return TraversalDecision.continue_

## Ported from ShadowRoot.h:202 Web::DOM::Node::for_each_shadow_including_descendant.
pub func dom_node_for_each_shadow_including_descendant(this: DomNode*, callback: ak.Function1[DomNode*, TraversalDecision]) -> TraversalDecision:
    if dom_node_is_element(this):
        if let shadow_root = dom_element_shadow_root((DomElement*)this):
            if dom_node_for_each_shadow_including_inclusive_descendant(shadow_root.dom_node(), callback) == TraversalDecision.break_:
                return TraversalDecision.break_

    var child_node = tree_node_first_child(this)
    while let child = child_node:
        if dom_node_for_each_shadow_including_inclusive_descendant(child, callback) == TraversalDecision.break_:
            return TraversalDecision.break_
        child_node = tree_node_next_sibling(child)

    return TraversalDecision.continue_
