# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/DOM/EventTarget.cpp:51 Web::DOM::EventTarget::EventTarget.
pub func dom_event_target_construct(this: DomEventTarget*, realm: Realm*, may_interfere_with_indexed_property_access: JsObjectMayInterfereWithIndexedPropertyAccess = JsObjectMayInterfereWithIndexedPropertyAccess.no):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm, may_interfere_with_indexed_property_access)

## Ported from Libraries/LibWeb/DOM/EventTarget.cpp:59 Web::DOM::EventTarget::construct_impl.
## https://dom.spec.whatwg.org/#dom-eventtarget-eventtarget
pub func dom_event_target_construct_impl(realm: Realm*) -> DomEventTarget*!:
    # The new EventTarget() constructor steps are to do nothing.
    return realm_create_dom_event_target(realm, realm, JsObjectMayInterfereWithIndexedPropertyAccess.no)

## Ported from Libraries/LibWeb/DOM/EventTarget.cpp:65 Web::DOM::EventTarget::initialize (override).
pub func dom_event_target_initialize_impl(base: JsCell*, realm: Realm*):
    # FIXME: We can't do this for UniversalGlobalScopeMixin classes, as this will run when creating the initial global object.
    #        During this time, the ESO is not setup, so it will cause a nullptr dereference in host_defined_intrinsics.
    if not dom_event_target_is_universal_global_scope_mixin((DomEventTarget*)base):
        web_set_prototype_for_interface(base, realm, BindInterfaceName.event_target)

    # Base::initialize(realm): PlatformObject inherits JS::Object's, which is JS::Cell's.
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/DOM/EventTarget.cpp:75 Web::DOM::EventTarget::visit_edges (override).
pub func dom_event_target_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomEventTarget*)base
    bind_platform_object_visit_edges_impl(base, visitor)

    if let data = this.m_data:
        gc.cell_visitor_visit_vector(visitor, &data.event_listener_list)
        gc.cell_visitor_visit_hash_map(visitor, &data.event_handler_map)

## Ported from Libraries/LibWeb/DOM/EventTarget.cpp:85 Web::DOM::EventTarget::event_listener_list:
## a copy of the list (Vector<GC::Root<DOMEventListener>>).
pub func dom_event_target_event_listener_list(this: DomEventTarget*) -> ak.Vector[DomEventListener*?]:
    var list: ak.Vector[DomEventListener*?]
    let data = this.m_data else return list
    for listener in ak.vector_span(&data.event_listener_list):
        ak.vector_append_t(&list, listener)
    return list

