## The non-zero default member initializers of Web::DOM::Document; the constructor runs them first.
pub func dom_document_init_fields(this: DomDocument*):
    this.m_last_focus_trigger = HtmlFocusTrigger.other
    this.m_readiness = HtmlDocumentReadyState.complete
    # m_content_type: C++ default "application/xml"_string (not translated by the generator)
    this.m_should_invalidate_styles_on_attribute_changes = true
    this.m_salvageable = true

