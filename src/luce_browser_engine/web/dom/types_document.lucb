## is<Web::DOM::Document>: the class-id range test.
pub func is_dom_document[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= dom_document_class.first_id and id <= dom_document_class.last_id

## as_if<Web::DOM::Document>.
pub func as_if_dom_document[P: gc.IsCell](p: P*) -> DomDocument*?:
