## heap.allocate<DOM::DOMEventListener>(): a cell of DOMEventListener's own allocator,
## constructed under DeferGC (LibGC's Heap::allocate, DESIGN.md §2.3).
pub func heap_allocate_dom_event_listener(heap: gc.Heap*) -> DomEventListener*:
    let this = (DomEventListener*)web_heap_allocate_cell(heap, &dom_event_listener_class)
    gc.heap_defer_gc(heap)
    dom_event_listener_construct(this)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/DOM/DOMEventListener.cpp:15 Web::DOM::DOMEventListener::DOMEventListener.
## The members' defaults (capture, once and removed false, passive null) are the zeroed cell's.
pub func dom_event_listener_construct(this: DomEventListener*):
    return

## Ported from Libraries/LibWeb/DOM/DOMEventListener.cpp:18 Web::DOM::DOMEventListener::visit_edges (override).
pub func dom_event_listener_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomEventListener*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.callback)
    gc.cell_visitor_visit_t(visitor, this.signal)
