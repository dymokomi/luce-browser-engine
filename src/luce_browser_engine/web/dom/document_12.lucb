# mark: View transitions ========================================================================

## Ported from Document.cpp:7748 Web::DOM::Document::start_view_transition.
# https://drafts.csswg.org/css-view-transitions-1/#dom-document-startviewtransition
pub func dom_document_start_view_transition(this: DomDocument*, update_callback: IdlCallbackType*?) -> ViewTransitionViewTransition*?:
    # The method steps for startViewTransition(updateCallback) are as follows:

    # 1. Let transition be a new ViewTransition object in this’s relevant Realm.
    let realm = dom_document_realm(this)
    let transition = view_transition_view_transition_create(realm)

    # 2. If updateCallback is provided, set transition’s update callback to updateCallback.
    if update_callback != none:
        view_transition_view_transition_set_update_callback(transition, update_callback)

    # 3. Let document be this’s relevant global object’s associated document.
    let document = html_window_associated_document(as_html_window((gc.Cell*)html_relevant_global_object((JsObject*)this)))

    # 4. If document’s visibility state is "hidden", then skip transition with an "InvalidStateError" DOMException,
    #    and return transition.
    if this.m_visibility_state == HtmlVisibilityState.hidden:
        view_transition_view_transition_skip_the_view_transition(transition, js_value_from_object((JsObject*)idl_invalid_state_error_create(realm, ak.utf16_string_from_str("The document's visibility state is \"hidden\""))))
        return transition

    # 5. If document’s active view transition is not null, then skip that view transition with an "AbortError"
    #    DOMException in this’s relevant Realm.
    if let active_view_transition = document.m_active_view_transition:
        view_transition_view_transition_skip_the_view_transition(active_view_transition, js_value_from_object((JsObject*)idl_abort_error_create(realm, ak.utf16_string_from_str("Document.startViewTransition() was called"))))

    # 6. Set document’s active view transition to transition.
    this.m_active_view_transition = transition

    # 7. Return transition.
    return transition

## Ported from Document.cpp:7783 Web::DOM::Document::perform_pending_transition_operations.
# https://drafts.csswg.org/css-view-transitions-1/#perform-pending-transition-operations
pub func dom_document_perform_pending_transition_operations(this: DomDocument*):
    # To perform pending transition operations given a Document document, perform the following steps:

    # 1. If document’s active view transition is not null, then:
    if let active_view_transition = this.m_active_view_transition:
        # 1. If document’s active view transition’s phase is "pending-capture", then setup view transition for
        #    document’s active view transition.
        if view_transition_view_transition_phase(active_view_transition) == ViewTransitionViewTransitionPhase.pending_capture:
            view_transition_view_transition_setup_view_transition(active_view_transition)
        # 2. Otherwise, if document’s active view transition’s phase is "animating", then handle transition frame for
        #    document’s active view transition.
        elif view_transition_view_transition_phase(active_view_transition) == ViewTransitionViewTransitionPhase.animating:
            view_transition_view_transition_handle_transition_frame(active_view_transition)

## Ported from Document.cpp:7801 Web::DOM::Document::flush_the_update_callback_queue.
# https://drafts.csswg.org/css-view-transitions-1/#flush-the-update-callback-queue
pub func dom_document_flush_the_update_callback_queue(this: DomDocument*):
    # To flush the update callback queue given a Document document:

    # 1. For each transition in document’s update callback queue, call the update callback given transition.
    for transition in ak.vector_span(&this.m_update_callback_queue):
        view_transition_view_transition_call_the_update_callback(transition else trap("a null view transition"))

    # 2. Set document’s update callback queue to an empty list.
    ak.vector_clear(&this.m_update_callback_queue)

## Ported from Document.cpp:7814 Web::DOM::Document::set_rendering_suppression_for_view_transitions.
pub func dom_document_set_rendering_suppression_for_view_transitions(this: DomDocument*, value: bool):
    if this.m_rendering_suppression_for_view_transitions == value:
        return

    this.m_rendering_suppression_for_view_transitions = value

    if not value:
        page_client_request_frame(page_client(dom_document_page(this)))

## The captures of the page-visibility task: `[&]` (the document).
struct DomDocumentViewTransitionVisibilityTask:
    var this: DomDocument*

## The view transition page-visibility change task.
func dom_document_view_transition_visibility_task(context: void*?):
    let this = ((DomDocumentViewTransitionVisibilityTask*)(context else trap("no captures"))).this
    var temporary_execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&temporary_execution_context, dom_document_realm(this))
    defer html_temporary_execution_context_destruct(&temporary_execution_context)
    # 1. If document’s visibility state is "hidden", then:
    if this.m_visibility_state == HtmlVisibilityState.hidden:
        # 1. If document’s active view transition is not null, then skip document’s active view transition with an
        #    "InvalidStateError" DOMException.
        if let active_view_transition = this.m_active_view_transition:
            view_transition_view_transition_skip_the_view_transition(active_view_transition, js_value_from_object((JsObject*)idl_invalid_state_error_create(dom_document_realm(this), ak.utf16_string_from_str("The document's visibility state is \"hidden\"."))))
    # 2. Otherwise, assert: active view transition is null.
    else:
        assert(this.m_active_view_transition == none)

## Ported from Document.cpp:7826 Web::DOM::Document::view_transition_page_visibility_change_steps.
# https://drafts.csswg.org/css-view-transitions-1/#view-transition-page-visibility-change-steps
pub func dom_document_view_transition_page_visibility_change_steps(this: DomDocument*):
    # The view transition page-visibility change steps given Document document are:

    # 1. Queue a global task on the DOM manipulation task source, given document’s relevant global object, to
    #    perform the following steps:
    let captures = new DomDocumentViewTransitionVisibilityTask(this = this) else trap("out of memory")
    discard(html_queue_global_task(HtmlTaskSource.dom_manipulation, html_relevant_global_object((JsObject*)this), gc.create_function0[unit](realm_heap(dom_document_realm(this)), ak.Function0[unit](call = dom_document_view_transition_visibility_task, context = captures))))

# mark: Custom element registries ===============================================================

## Ported from Document.cpp:7850 Web::DOM::Document::custom_element_registry.
# https://dom.spec.whatwg.org/#dom-documentorshadowroot-customelementregistry
pub func dom_document_custom_element_registry(this: DomDocument*) -> HtmlCustomElementRegistry*?:
    # 1. If this is a document, then return this’s custom element registry.
    # NB: Always true.
    return this.m_custom_element_registry

    # 2. Assert: this is a ShadowRoot node.
    # 3. Return this’s custom element registry.

## Ported from Document.cpp:7861 Web::DOM::Document::effective_global_custom_element_registry.
# https://dom.spec.whatwg.org/#effective-global-custom-element-registry
pub func dom_document_effective_global_custom_element_registry(this: DomDocument*) -> HtmlCustomElementRegistry*?:
    # A document document’s effective global custom element registry is:

    # 1. If document’s custom element registry is a global custom element registry, then return document’s custom
    #    element registry.
    if html_is_a_global_custom_element_registry(dom_document_custom_element_registry(this)):
        return dom_document_custom_element_registry(this)

    # 2. Return null.
    return none

## The captures of upgrade_particular_elements' walk: `[&]`.
struct DomDocumentUpgradeParticularElements:
    var registry: HtmlCustomElementRegistry*
    var definition: HtmlCustomElementDefinition*
    var local_name: ak.String
    var name: ak.String

## upgrade_particular_elements' walk over the shadow-including descendants.
func dom_document_upgrade_particular_element(context: void*?, inclusive_descendant: DomNode*) -> TraversalDecision:
    let captures = (DomDocumentUpgradeParticularElements*)(context else trap("no captures"))
    let element = as_if_dom_element(inclusive_descendant) else return TraversalDecision.continue_
    if dom_element_custom_element_registry(element) != captures.registry:
        return TraversalDecision.continue_
    if not dom_node_optional_fly_string_is(dom_element_namespace_uri(element), namespace_html):
        return TraversalDecision.continue_
    let element_local_name = dom_element_local_name(element)
    if not ak.fly_string_eq_string(&element_local_name, &captures.local_name):
        return TraversalDecision.continue_

    if not ak.string_equals(&captures.name, &captures.local_name):
        let is_value = dom_element_is_value(element) else return TraversalDecision.continue_
        if not ak.string_equals(&is_value, &captures.name):
            return TraversalDecision.continue_

    # 2. For each element element of upgradeCandidates:
    #    enqueue a custom element upgrade reaction given element and definition.
    dom_element_enqueue_a_custom_element_upgrade_reaction(element, captures.definition)
    return TraversalDecision.continue_

## Ported from Document.cpp:7875 Web::DOM::Document::upgrade_particular_elements.
# https://html.spec.whatwg.org/multipage/custom-elements.html#upgrade-particular-elements-within-a-document
pub func dom_document_upgrade_particular_elements(this: DomDocument*, registry: HtmlCustomElementRegistry*, definition: HtmlCustomElementDefinition*, local_name: ak.String, maybe_name: ak.String? = none):
    # To upgrade particular elements within a document given a CustomElementRegistry object registry, a Document
    # object document, a custom element definition definition, a string localName, and optionally a string name
    # (default localName):
    let name = maybe_name else local_name

    # 1. Let upgradeCandidates be all elements that are shadow-including descendants of document, whose custom element
    #    registry is registry, whose namespace is the HTML namespace, and whose local name is localName, in
    #    shadow-including tree order.
    #    Additionally, if name is not localName, only include elements whose is value is equal to name.
    var captures = DomDocumentUpgradeParticularElements(registry = registry, definition = definition, local_name = local_name, name = name)
    discard(dom_node_for_each_shadow_including_descendant(this.dom_node(), ak.Function1[DomNode*, TraversalDecision](call = dom_document_upgrade_particular_element, context = &captures)))

## Ported from Document.cpp:7906 Web::DOM::Document::element_by_id.
pub func dom_document_element_by_id(this: DomDocument*) -> DomElementByIdMap*:
    if this.m_element_by_id == none:
        this.m_element_by_id = new DomElementByIdMap() else trap("out of memory")
    return this.m_element_by_id else trap("unreachable: set above")
