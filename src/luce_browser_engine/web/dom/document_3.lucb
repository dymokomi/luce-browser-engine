    return this.m_supported_color_schemes

## `element.name().has_value() && element.name()->equals_ignoring_ascii_case(name)`.
func dom_element_name_equals_ignoring_ascii_case(element: DomElement*, name: str) -> bool:
    let element_name = dom_element_name(element) else return false
    return ak.fly_string_equals_ignoring_ascii_case_string_view(&element_name, ak.sv(name))

## Ported from Document.cpp:1999 Web::DOM::Document::obtain_supported_color_schemes.
# https://html.spec.whatwg.org/multipage/semantics.html#meta-color-scheme
pub func dom_document_obtain_supported_color_schemes(this: DomDocument*):
    this.m_supported_color_schemes = none

    # 1. Let candidate elements be the list of all meta elements that meet the following criteria, in tree order:
    for node in dom_node_subtree(this.dom_node()):
        let element = as_if_html_meta_element(node) else continue
        #     * the element is in a document tree;
        #     * the element has a name attribute, whose value is an ASCII case-insensitive match for color-scheme; and
        #     * the element has a content attribute.

        # 2. For each element in candidate elements:
        let content = dom_element_attribute(element.dom_element(), html_attribute_names_content)
        if dom_element_name_equals_ignoring_ascii_case(element.dom_element(), "color-scheme"):
            if let content_value = content:
                # 1. Let parsed be the result of parsing a list of component values given the value of element's content attribute.
                var context: CssParsingParams = ---
                css_parsing_params_construct_dom_document(&context, dom_node_document(this.dom_node()))
                let parsed = parse_css_value(context, ak.string_bytes_as_string_view(&content_value), css_data.PropertyId.color_scheme)

                # 2. If parsed is a valid CSS 'color-scheme' property value, then return parsed.
                if let parsed_value = parsed:
                    if css_style_value_is_color_scheme(parsed_value):
                        this.m_supported_color_schemes = css_color_scheme_style_value_schemes(css_style_value_as_color_scheme(parsed_value))
                        break

    # 3. Return null.

## Ported from Document.cpp:2030 Web::DOM::Document::obtain_theme_color.
# https://html.spec.whatwg.org/multipage/semantics.html#meta-theme-color
pub func dom_document_obtain_theme_color(this: DomDocument*):
    var theme_color = gfx.color_new_named_color(gfx.ColorNamedColor.transparent)

    # 1. Let candidate elements be the list of all meta elements that meet the following criteria, in tree order:
    for node in dom_node_subtree(this.dom_node()):
        let element = as_if_html_meta_element(node) else continue
        #     * the element is in a document tree;
        #     * the element has a name attribute, whose value is an ASCII case-insensitive match for theme-color; and
        #     * the element has a content attribute.

        # 2. For each element in candidate elements:
        let content = dom_element_attribute(element.dom_element(), html_attribute_names_content)
        if not dom_element_name_equals_ignoring_ascii_case(element.dom_element(), "theme-color"):
            continue
        let content_value = content else continue

        # 1. If element has a media attribute and the value of element's media attribute does not match the environment, then continue.
        var context: CssParsingParams = ---
        css_parsing_params_construct_dom_document(&context, dom_node_document(this.dom_node()))
        let media = dom_element_attribute(element.dom_element(), html_attribute_names_media)
        if let media_value = media:
            let query = parse_media_query(context, ak.string_bytes_as_string_view(&media_value)) else continue
            if not css_media_query_evaluate(query, this):
                continue

        # 2. Let value be the result of stripping leading and trailing ASCII whitespace from the value of element's content attribute.
        let content_view = ak.string_bytes_as_string_view(&content_value)
        let value = ak.string_view_trim(&content_view, web_infra.ascii_whitespace_view())

        # 3. Let color be the result of parsing value.
        let css_value = parse_css_value(context, value, css_data.PropertyId.color)

        # 4. If color is not failure, then return color.
        if let parsed_color = css_value:
            if css_style_value_has_color(parsed_color):
                var color_resolution_context = CssColorResolutionContext()
                # NB: Called during theme color computation, layout may be stale.
                if let html_element = dom_document_html_element(this):
                    if let html_layout_node = dom_element_unsafe_layout_node(html_element.dom_element()):
                        color_resolution_context = css_color_resolution_context_for_layout_node_with_style(html_layout_node)

                theme_color = css_style_value_to_color(parsed_color, color_resolution_context) else trap("Optional::value() of an empty color")
                break

    # 3. Return nothing(the page has no theme color).
    page_client_page_did_change_theme_color(page_client(dom_document_page(dom_node_document(this.dom_node()))), theme_color)

