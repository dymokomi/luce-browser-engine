    return layout_node_first_paintable(layout_node)

## Ported from Document.cpp:2103 Web::DOM::Document::set_highlighted_node.
pub func dom_document_set_highlighted_node(this: DomDocument*, node: DomNode*?, pseudo_element: css_data.PseudoElement?):
    if this.m_highlighted_node == node and this.m_highlighted_pseudo_element == pseudo_element:
        return

    if let first_paintable = dom_document_highlighted_first_paintable(this):
        paint_paintable_set_needs_repaint(first_paintable, InvalidateDisplayList.yes)

    this.m_highlighted_node = node
    this.m_highlighted_pseudo_element = pseudo_element

    if let first_paintable = dom_document_highlighted_first_paintable(this):
        paint_paintable_set_needs_repaint(first_paintable, InvalidateDisplayList.yes)

## Ported from Document.cpp:2118 Web::DOM::Document::highlighted_layout_node.
pub func dom_document_highlighted_layout_node(this: DomDocument*) -> LayoutNode*?:
    let highlighted_node = this.m_highlighted_node else return none

    # NB: Called during painting inside update_layout().
    let pseudo_element = this.m_highlighted_pseudo_element
    if pseudo_element == none or not dom_node_is_element(highlighted_node):
        return dom_node_unsafe_layout_node(highlighted_node)

    let element = (DomElement*)highlighted_node
    let pseudo = pseudo_element else trap("unreachable: checked above")
    return (LayoutNode*?)dom_element_get_pseudo_element_node(element, pseudo)
