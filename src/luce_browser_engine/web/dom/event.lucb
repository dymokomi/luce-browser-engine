#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/DOM/Event.cpp:24 Web::DOM::Event::create.
## https://dom.spec.whatwg.org/#concept-event-create
pub func dom_event_create(realm: Realm*, event_name: ak.FlyString, event_init: DomEventInit = DomEventInit()) -> DomEvent*:
    let event = realm_create_dom_event_dom_event_init(realm, realm, event_name, event_init)
    # 4. Initialize event’s isTrusted attribute to true.
    event.m_is_trusted = true
    return event

## Ported from Libraries/LibWeb/DOM/Event.cpp:32 Web::DOM::Event::construct_impl.
pub func dom_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: DomEventInit) -> DomEvent*!:
    return realm_create_dom_event_dom_event_init(realm, realm, event_name, event_init)

## Ported from Libraries/LibWeb/DOM/Event.cpp:38 Web::DOM::Event::Event(JS::Realm&, FlyString const&).
## https://dom.spec.whatwg.org/#inner-event-creation-steps
pub func dom_event_construct(this: DomEvent*, realm: Realm*, type_: ak.FlyString):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_type = type_
    this.m_initialized = true
    this.m_time_stamp = high_resolution_time_current_high_resolution_time(html_relevant_global_object((JsObject*)this))

## Ported from Libraries/LibWeb/DOM/Event.cpp:47 Web::DOM::Event::Event(JS::Realm&, FlyString const&, EventInit const&).
## https://dom.spec.whatwg.org/#inner-event-creation-steps
pub func dom_event_construct_dom_event_init(this: DomEvent*, realm: Realm*, type_: ak.FlyString, event_init: DomEventInit):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_type = type_
    this.m_bubbles = event_init.bubbles
    this.m_cancelable = event_init.cancelable
    this.m_composed = event_init.composed
    this.m_initialized = true
    this.m_time_stamp = high_resolution_time_current_high_resolution_time(html_relevant_global_object((JsObject*)this))

## Ported from Libraries/LibWeb/DOM/Event.cpp:58 Web::DOM::Event::initialize (override).
pub func dom_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.event)
    # Base::initialize(realm): PlatformObject inherits JS::Object's, which is JS::Cell's.
    js_cell_initialize_impl(base, realm)
    # Bindings::EventPrototype::define_unforgeable_attributes(realm, *this): the unforgeable
    # `isTrusted` attribute is a property of the JS wrapper (phase 3).

## Ported from Libraries/LibWeb/DOM/Event.cpp:65 Web::DOM::Event::visit_edges (override).
pub func dom_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomEvent*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_target)
    gc.cell_visitor_visit_t(visitor, this.m_related_target)
    gc.cell_visitor_visit_t(visitor, this.m_current_target)
    for it in ak.vector_span(&this.m_path):
        gc.cell_visitor_visit_t(visitor, it.invocation_target)
        gc.cell_visitor_visit_t(visitor, it.shadow_adjusted_target)
        gc.cell_visitor_visit_t(visitor, it.related_target)
        gc.cell_visitor_visit_vector_nullable(visitor, &it.touch_target_list)
    gc.cell_visitor_visit_vector_nullable(visitor, &this.m_touch_target_list)

