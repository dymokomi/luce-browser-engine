# mark: Flags and initialization ================================================================

## Ported from Libraries/LibWeb/DOM/Event.cpp:107 Web::DOM::Event::set_cancelled_flag.
pub func dom_event_set_cancelled_flag(this: DomEvent*):
    if this.m_cancelable and not this.m_in_passive_listener:
        this.m_cancelled = true

## Ported from Libraries/LibWeb/DOM/Event.cpp:114 Web::DOM::Event::initialize_event.
## https://dom.spec.whatwg.org/#concept-event-initialize
pub func dom_event_initialize_event(this: DomEvent*, type_: ak.String, bubbles: bool, cancelable: bool):
    # 1. Set event’s initialized flag.
    this.m_initialized = true

    # 2. Unset event’s stop propagation flag, stop immediate propagation flag, and canceled flag.
    this.m_stop_propagation = false
    this.m_stop_immediate_propagation = false
    this.m_cancelled = false

    # 3. Set event’s isTrusted attribute to false.
    this.m_is_trusted = false

    # 4. Set event’s target to null.
    this.m_target = none

    # 5. Set event’s type attribute to type.
    this.m_type = ak.fly_string_from_string(type_)

    # 6. Set event’s bubbles attribute to bubbles.
    this.m_bubbles = bubbles

    # 8. Set event’s cancelable attribute to cancelable.
    this.m_cancelable = cancelable

## Ported from Libraries/LibWeb/DOM/Event.cpp:141 Web::DOM::Event::init_event.
## https://dom.spec.whatwg.org/#dom-event-initevent
pub func dom_event_init_event(this: DomEvent*, type_: ak.String, bubbles: bool, cancelable: bool):
    # 1. If this’s dispatch flag is set, then return.
    if this.m_dispatch:
        return

    # 2. Initialize this with type, bubbles, and cancelable.
    dom_event_initialize_event(this, type_, bubbles, cancelable)

# mark: composedPath() ==========================================================================

## Ported from Libraries/LibWeb/DOM/Event.cpp:152 Web::DOM::Event::composed_path.
## https://dom.spec.whatwg.org/#dom-event-composedpath
## The hidden-subtree levels are size_t in C++ and wrap below zero; so do these.
pub func dom_event_composed_path(this: DomEvent*) -> ak.Vector[DomEventTarget*?]:
    # 1. Let composedPath be an empty list.
    var composed_path: ak.Vector[DomEventTarget*?]

    # 2. Let path be this’s path. (NOTE: Not necessary)

    # 3. If path is empty, then return composedPath.
    if ak.vector_is_empty(&this.m_path):
        return composed_path

    # 4. Let currentTarget be this’s currentTarget attribute value. (NOTE: Not necessary)

    # 5. Assert: currentTarget is an EventTarget object.
    let current_target = this.m_current_target else trap("VERIFY: composedPath without a current target")

    # 6. Append currentTarget to composedPath.
    # NOTE: If path is not empty, then the event is being dispatched and will have a currentTarget.
    ak.vector_append_t(&composed_path, current_target)

    # 7. Let currentTargetIndex be 0.
    var current_target_index: usize = 0

    # 8. Let currentTargetHiddenSubtreeLevel be 0.
    var current_target_hidden_subtree_level: usize = 0

    # 9. Let index be path’s size − 1.
    # 10. While index is greater than or equal to 0:
    var index = (isize)ak.vector_size(&this.m_path) - 1
    while index >= 0:
        let path_entry = ak.vector_at(&this.m_path, (usize)index)

        # 1. If path[index]'s root-of-closed-tree is true, then increase currentTargetHiddenSubtreeLevel by 1.
        if path_entry.root_of_closed_tree:
            current_target_hidden_subtree_level = current_target_hidden_subtree_level +% 1

        # 2. If path[index]'s invocation target is currentTarget, then set currentTargetIndex to index and break.
        if path_entry.invocation_target == this.m_current_target:
            current_target_index = (usize)index
            break

        # 3. If path[index]'s slot-in-closed-tree is true, then decrease currentTargetHiddenSubtreeLevel by 1.
        if path_entry.slot_in_closed_tree:
            current_target_hidden_subtree_level = current_target_hidden_subtree_level -% 1

        # 4. Decrease index by 1.
        index -= 1

    # 11. Let currentHiddenLevel and maxHiddenLevel be currentTargetHiddenSubtreeLevel.
    var current_hidden_level = current_target_hidden_subtree_level
    var max_hidden_level = current_target_hidden_subtree_level

    # 12. Set index to currentTargetIndex − 1.
    # 13. While index is greater than or equal to 0:
    index = (isize)current_target_index - 1
    while index >= 0:
        let path_entry = ak.vector_at(&this.m_path, (usize)index)

        # 1. If path[index]'s root-of-closed-tree is true, then increase currentHiddenLevel by 1.
        if path_entry.root_of_closed_tree:
            current_hidden_level = current_hidden_level +% 1

        # 2. If currentHiddenLevel is less than or equal to maxHiddenLevel, then prepend path[index]'s invocation target to composedPath.
        if current_hidden_level <= max_hidden_level:
            let invocation_target = path_entry.invocation_target else trap("VERIFY: a path entry without an invocation target")
            ak.vector_prepend_u(&composed_path, invocation_target)

        # 3. If path[index]'s slot-in-closed-tree is true, then:
        if path_entry.slot_in_closed_tree:
            # 1. Decrease currentHiddenLevel by 1.
            current_hidden_level = current_hidden_level -% 1

            # 2. If currentHiddenLevel is less than maxHiddenLevel, then set maxHiddenLevel to currentHiddenLevel.
            if current_hidden_level < max_hidden_level:
                max_hidden_level = current_hidden_level

        # 4. Decrease index by 1.
        index -= 1

    # 14. Set currentHiddenLevel and maxHiddenLevel to currentTargetHiddenSubtreeLevel.
    current_hidden_level = current_target_hidden_subtree_level
    max_hidden_level = current_target_hidden_subtree_level

    # 15. Set index to currentTargetIndex + 1.
    # 16. While index is less than path’s size:
    for forward_index in current_target_index + 1..<ak.vector_size(&this.m_path):
        let path_entry = ak.vector_at(&this.m_path, forward_index)

        # 1. If path[index]'s slot-in-closed-tree is true, then increase currentHiddenLevel by 1.
        if path_entry.slot_in_closed_tree:
            current_hidden_level = current_hidden_level +% 1

        # 2. If currentHiddenLevel is less than or equal to maxHiddenLevel, then append path[index]'s invocation target to composedPath.
        if current_hidden_level <= max_hidden_level:
            let invocation_target = path_entry.invocation_target else trap("VERIFY: a path entry without an invocation target")
            ak.vector_append_t(&composed_path, invocation_target)

        # 3. If path[index]'s root-of-closed-tree is true, then:
        if path_entry.root_of_closed_tree:
            # 1. Decrease currentHiddenLevel by 1.
            current_hidden_level = current_hidden_level -% 1

            # 2. If currentHiddenLevel is less than maxHiddenLevel, then set maxHiddenLevel to currentHiddenLevel.
            if current_hidden_level < max_hidden_level:
                max_hidden_level = current_hidden_level

        # 4. Increase index by 1.

    # 17. Return composedPath.
    return composed_path

## Ported from Libraries/LibWeb/DOM/Event.cpp:270 Web::DOM::Event::current_target_for_bindings.
## AD-HOC: Needed to return a WindowProxy when the current target is a Window,
## ensuring that JavaScript sees the correct global object instead of the internal Window.
pub func dom_event_current_target_for_bindings(this: DomEvent*) -> DomEventTarget*?:
    if let current_target = this.m_current_target:
        if let window = as_if_html_window(current_target):
            return html_window_window(window).dom_event_target()
    return this.m_current_target
