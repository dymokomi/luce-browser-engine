# mark: The event path ==========================================================================

## Ported from Libraries/LibWeb/DOM/Event.cpp:81 Web::DOM::Event::append_to_path.
## https://dom.spec.whatwg.org/#concept-event-path-append
pub func dom_event_append_to_path(this: DomEvent*, invocation_target: DomEventTarget*, shadow_adjusted_target: DomEventTarget*?, related_target: DomEventTarget*?, touch_targets: ak.Vector[DomEventTarget*?]*, slot_in_closed_tree: bool):
    # 1. Let invocationTargetInShadowTree be false.
    var invocation_target_in_shadow_tree = false

    # 3. Let root-of-closed-tree be false.
    var root_of_closed_tree = false

    # 2. If invocationTarget is a node and its root is a shadow root, then set invocationTargetInShadowTree to true.
    if let invocation_target_node = as_if_dom_node(invocation_target):
        if is_dom_shadow_root(tree_node_root(invocation_target_node)):
            invocation_target_in_shadow_tree = true
        if let invocation_target_shadow_root = as_if_dom_shadow_root(invocation_target_node):
            # 4. If invocationTarget is a shadow root whose mode is "closed", then set root-of-closed-tree to true.
            root_of_closed_tree = dom_shadow_root_mode(invocation_target_shadow_root) == BindShadowRootMode.closed

    # 5. Append a new struct to event’s path whose invocation target is invocationTarget, invocation-target-in-shadow-tree is invocationTargetInShadowTree,
    # shadow-adjusted target is shadowAdjustedTarget, relatedTarget is relatedTarget, touch target list is touchTargets, root-of-closed-tree is root-of-closed-tree,
    # and slot-in-closed-tree is slot-in-closed-tree.
    # (The touch target list is copied, as C++ copies the Vector into the struct.)
    ak.vector_append_t(&this.m_path, DomEventPathEntry(invocation_target = invocation_target, invocation_target_in_shadow_tree = invocation_target_in_shadow_tree, shadow_adjusted_target = shadow_adjusted_target, related_target = related_target, touch_target_list = ak.vector_clone(touch_targets), root_of_closed_tree = root_of_closed_tree, slot_in_closed_tree = slot_in_closed_tree, index = ak.vector_size(&this.m_path)))

## Ported from Libraries/LibWeb/DOM/Event.h:114 Web::DOM::Event::path.
pub func dom_event_path(this: DomEvent*) -> ak.Vector[DomEventPathEntry]*:
    return &this.m_path

## Ported from Libraries/LibWeb/DOM/Event.h:115 Web::DOM::Event::path (const): the path itself,
## not a copy (C++ answers a const reference).
pub func dom_event_path_const(this: DomEvent*) -> const ak.Vector[DomEventPathEntry]*:
    return &this.m_path

## Ported from Libraries/LibWeb/DOM/Event.h:116 Web::DOM::Event::clear_path.
pub func dom_event_clear_path(this: DomEvent*):
    ak.vector_clear(&this.m_path)

