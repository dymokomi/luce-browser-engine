## is<Web::DOM::Node>: the class-id range test.
pub func is_dom_node[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= dom_node_class.first_id and id <= dom_node_class.last_id

## as_if<Web::DOM::Node>.
pub func as_if_dom_node[P: gc.IsCell](p: P*) -> DomNode*?:
    if is_dom_node(p): return (DomNode*)p
    return none

## as<Web::DOM::Node> (verify_cast).
pub func as_dom_node[P: gc.IsCell](p: P*) -> DomNode*:
    return as_if_dom_node(p) else trap("as<Web::DOM::Node> failed")

