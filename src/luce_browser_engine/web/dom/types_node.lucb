## `for n in dom_node_subtree(node)`: for_each_in_subtree / for_each_in_inclusive_subtree as a loop, in
## pre-order; `skip_children()` on the iterator is TraversalDecision::SkipChildrenAndContinue.
pub struct DomNodeSubtree: luce.Iterable[DomNode*, DomNodeSubtreeIterator]:
    pub var root: DomNode*
    pub var inclusive: bool

    func iterator() -> DomNodeSubtreeIterator:
        return DomNodeSubtreeIterator(root = self.root, current = none, inclusive = self.inclusive, started = false,
                                      skip = false)

## The iterator of DomNodeSubtree (TreeNode<T>::next_in_pre_order with stay_within = the root).
pub struct DomNodeSubtreeIterator: luce.Iterator[DomNode*]:
    pub var root: DomNode*
    pub var current: DomNode*?
    pub var inclusive: bool
    pub var started: bool
    pub var skip: bool

    mutating func next() -> DomNode*?:
        if not self.started:
            self.started = true
            self.current = self.root
            if self.inclusive:
                return self.root
        let node = self.current else return none
        var next: DomNode*? = none
        if not self.skip:
            next = node.tree_node.m_first_child
        self.skip = false
        if next == none:
            var walk: DomNode*? = node
            while let at = walk:
                if at == self.root:
                    break
                if let sibling = at.tree_node.m_next_sibling:
                    next = sibling
                    break
                walk = at.tree_node.m_parent
        self.current = next
        return next

    ## Do not descend into the children of the node `next()` returned last.
    mutating func skip_children():
        self.skip = true

## The descendants of `node` in pre-order (not `node` itself).
pub func dom_node_subtree(node: DomNode*) -> DomNodeSubtree:
    return DomNodeSubtree(root = node, inclusive = false)

## `node` and its descendants in pre-order.
pub func dom_node_inclusive_subtree(node: DomNode*) -> DomNodeSubtree:
    return DomNodeSubtree(root = node, inclusive = true)

