## Ported from Document.cpp:3738 Web::DOM::Document::dump_dom_tree_as_json.
pub func dom_document_dump_dom_tree_as_json(this: DomDocument*) -> ak.String:
    dom_document_update_layout(this, DomUpdateLayoutReason.inspect_dom_tree)

    var builder = ak.string_builder_new()
    var json = ak.json_object_serializer_try_create(&builder) else trap("MUST: JsonObjectSerializer::try_create")
    dom_node_serialize_tree_as_json(this.dom_node(), &json)

    ak.json_object_serializer_finish(&json) else trap("MUST: JsonObjectSerializer::finish")
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

# mark: Script-blocking style sheets and the referrer ===========================================

## Ported from Document.cpp:3751 Web::DOM::Document::has_no_style_sheet_that_is_blocking_scripts.
# https://html.spec.whatwg.org/multipage/semantics.html#has-no-style-sheet-that-is-blocking-scripts
pub func dom_document_has_no_style_sheet_that_is_blocking_scripts(this: DomDocument*) -> bool:
    # A Document has no style sheet that is blocking scripts if it does not have a style sheet that is blocking scripts.
    return not dom_document_has_a_style_sheet_that_is_blocking_scripts(this)

## Ported from Document.cpp:3758 Web::DOM::Document::has_a_style_sheet_that_is_blocking_scripts.
# https://html.spec.whatwg.org/multipage/semantics.html#has-a-style-sheet-that-is-blocking-scripts
pub func dom_document_has_a_style_sheet_that_is_blocking_scripts(this: DomDocument*) -> bool:
    # 1. If document's script-blocking style sheet set is not empty, then return true.
    if not ak.hash_table_is_empty(&this.m_script_blocking_style_sheet_set):
        return true

    # 2. If document's node navigable is null, then return false.
    let navigable = dom_document_navigable(this) else return false

    # 3. Let containerDocument be document's node navigable's container document.
    let container_document = html_navigable_container_document(navigable)

    # 4. If containerDocument is non-null and containerDocument's script-blocking style sheet set is not empty, then return true.
    if let container = container_document:
        if not ak.hash_table_is_empty(&container.m_script_blocking_style_sheet_set):
            return true

    # 5. Return false
    return false

## Ported from Document.cpp:3780 Web::DOM::Document::referrer.
pub func dom_document_referrer(this: DomDocument*) -> ak.String:
    return this.m_referrer

## Ported from Document.cpp:3785 Web::DOM::Document::set_referrer.
pub func dom_document_set_referrer(this: DomDocument*, referrer: ak.String):
    this.m_referrer = referrer

# mark: Activity ================================================================================

## Ported from Document.cpp:3791 Web::DOM::Document::is_fully_active.
# https://html.spec.whatwg.org/multipage/document-sequences.html#fully-active
pub func dom_document_is_fully_active(this: DomDocument*) -> bool:
    # A Document d is said to be fully active when d is the active document of a navigable navigable, and either
    # navigable is a top-level traversable or navigable's container document is fully active.
    let navigable = dom_document_navigable(this) else return false

    let traversable = html_navigable_traversable_navigable(navigable)
    if let traversable_navigable = traversable:
        if navigable == traversable_navigable.html_navigable() and html_navigable_is_top_level_traversable(traversable_navigable.html_navigable()):
            return true

    let container_document = html_navigable_container_document(navigable)
    if let container = container_document:
        if container != this and dom_document_is_fully_active(container):
            return true

    return false

## Ported from Document.cpp:3810 Web::DOM::Document::is_active.
pub func dom_document_is_active(this: DomDocument*) -> bool:
    let navigable = dom_document_navigable(this) else return false
    return html_navigable_active_document(navigable) == this

## Ported from Document.cpp:3817 Web::DOM::Document::location.
# https://html.spec.whatwg.org/multipage/history.html#dom-document-location
pub func dom_document_location(this: DomDocument*) -> HtmlHtmlLocation*?:
    # The Document object's location attribute's getter must return this Document object's relevant global object's Location object,
    # if this Document object is fully active, and null otherwise.

    if not dom_document_is_fully_active(this):
        return none

    let window = dom_document_window(this) else trap("a fully active document without a window")
    return html_window_location(window)

# mark: Visibility ==============================================================================

## Ported from Document.cpp:3829 Web::DOM::Document::hidden.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-document-hidden
pub func dom_document_hidden(this: DomDocument*) -> bool:
    return this.m_visibility_state == HtmlVisibilityState.hidden

## Ported from Document.cpp:3835 Web::DOM::Document::visibility_state.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-document-visibilitystate
pub func dom_document_visibility_state(this: DomDocument*) -> ak.StringView:
    match this.m_visibility_state:
        .hidden: return ak.sv("hidden")
        .visible: return ak.sv("visible")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Document.cpp:3847 Web::DOM::Document::update_the_visibility_state.
# https://html.spec.whatwg.org/multipage/interaction.html#update-the-visibility-state
pub func dom_document_update_the_visibility_state(this: DomDocument*, visibility_state: HtmlVisibilityState):
    # 1. If document's visibility state equals visibilityState, then return.
    if this.m_visibility_state == visibility_state:
        return

    # 2. Set document's visibility state to visibilityState.
    this.m_visibility_state = visibility_state

    # FIXME: 3. Queue a new VisibilityStateEntry whose visibility state is visibilityState and whose timestamp is the current
    #    high resolution time given document's relevant global object.

    # FIXME: 4. Run the screen orientation change steps with document.

    # 5. Run the view transition page visibility change steps with document.
    dom_document_view_transition_page_visibility_change_steps(this)

    # 6. Run any page visibility change steps which may be defined in other specifications, with visibility state and
    #    document.
    dom_document_notify_document_observers_of_visibility_state(this, this.m_visibility_state)

    # 7. Fire an event named visibilitychange at document, with its bubbles attribute initialized to true.
    let event = dom_event_create(dom_document_realm(this), html_event_names_visibilitychange)
    dom_event_set_bubbles(event, true)
    discard(dom_event_target_dispatch_event(this.dom_event_target(), event))

## Ported from Document.cpp:3878 Web::DOM::Document::run_the_resize_steps.
# https://drafts.csswg.org/cssom-view/#document-run-the-resize-steps
pub func dom_document_run_the_resize_steps(this: DomDocument*):
    # 1. If doc’s viewport has had its width or height changed
    #    (e.g. as a result of the user resizing the browser window, or changing the page zoom scale factor,
    #    or an iframe element’s dimensions are changed) since the last time these steps were run,
    #    fire an event named resize at the Window object associated with doc.
    # 2. If the VisualViewport associated with doc has had its scale, width, or height properties changed
    #    since the last time these steps were run, fire an event named resize at the VisualViewport.

    let viewport_rect = dom_document_viewport_rect(this)
    let viewport_css_size = gfx.css_pixel_rect_size(&viewport_rect)
    let viewport_size = gfx.css_pixel_size_to_type_i32(&viewport_css_size)
    let visual_viewport = dom_document_visual_viewport(this)
    var visual_viewport_state = DomDocumentVisualViewportState(scale = css_visual_viewport_scale(visual_viewport), size = gfx.CssPixelSize(m_width = gfx.css_pixels_from_f64(css_visual_viewport_width(visual_viewport)), m_height = gfx.css_pixels_from_f64(css_visual_viewport_height(visual_viewport))))
    let is_initial_size = this.m_last_viewport_size == none

    let viewport_size_changed = this.m_last_viewport_size != viewport_size
    let visual_viewport_state_changed = this.m_last_visual_viewport_state != visual_viewport_state

    if not viewport_size_changed and not visual_viewport_state_changed:
        return

    this.m_last_viewport_size = viewport_size
    this.m_last_visual_viewport_state = visual_viewport_state

    if not is_initial_size:
        if viewport_size_changed:
            let window_resize_event = dom_event_create(dom_document_realm(this), ui_events_event_names_resize)
            dom_event_set_is_trusted(window_resize_event, true)
            let window = dom_document_window(this) else trap("the document has no window")
            discard(dom_event_target_dispatch_event(window.dom_event_target(), window_resize_event))

        if visual_viewport_state_changed:
            let visual_viewport_resize_event = dom_event_create(dom_document_realm(this), ui_events_event_names_resize)
            dom_event_set_is_trusted(visual_viewport_resize_event, true)
            discard(dom_event_target_dispatch_event(visual_viewport.dom_event_target(), visual_viewport_resize_event))

## Ported from Document.cpp:3917 Web::DOM::Document::run_the_scroll_steps.
# https://drafts.csswg.org/cssom-view-1/#document-run-the-scroll-steps
pub func dom_document_run_the_scroll_steps(this: DomDocument*):
    # AD-HOC: Process auto-scroll ticks before dispatching scroll events. This is tied to the rendering update to
    #         ensure exactly one auto-scroll tick per frame.
    if let navigable = dom_document_navigable(this):
        event_handler_process_auto_scroll(html_navigable_event_handler(navigable))

    # FIXME: 1. For each scrolling box box that was scrolled:
    #        ...

    # 2. For each item (target, type) in doc’s pending scroll events, in the order they were added to the list, run
    #    these substeps:
    var pending_scroll_events = this.m_pending_scroll_events
    this.m_pending_scroll_events = ak.Vector[DomDocumentPendingScrollEvent]()
    for pending_scroll_event in ak.vector_span(&pending_scroll_events):
        let target = pending_scroll_event.event_target
        let type_ = pending_scroll_event.event_type
        # 1. If target is a Document, and type is "scroll" or "scrollend", fire an event named type that bubbles at target.
        if is_dom_document(target) and (ak.fly_string_eq_fly_string(&type_, &html_event_names_scroll) or ak.fly_string_eq_fly_string(&type_, &html_event_names_scrollend)):
            let event = dom_event_create(dom_document_realm(this), type_)
            dom_event_set_bubbles(event, true)
            discard(dom_event_target_dispatch_event(target, event))
        # FIXME: 2. Otherwise, if type is "scrollsnapchange", then:
        # FIXME: 3. Otherwise, if type is "scrollsnapchanging", then:
        # 4. Otherwise, fire an event named type at target.
        else:
            let event = dom_event_create(dom_document_realm(this), type_)
            discard(dom_event_target_dispatch_event(target, event))

    # 3. Empty doc’s pending scroll events.
    # AD-HOC: We already emptied the scroll events by moving in step 2. This prevents us from removing new scroll
    #         events that were added while dispatching the old scroll events.

# mark: Media queries ===========================================================================

## Ported from Document.cpp:3951 Web::DOM::Document::add_media_query_list.
pub func dom_document_add_media_query_list(this: DomDocument*, media_query_list: CssMediaQueryList*):
    this.m_needs_media_query_evaluation = true
    var weak: gc.Weak[CssMediaQueryList] = gc.Weak[CssMediaQueryList]()
    gc.weak_construct(&weak, media_query_list)
    ak.vector_append_t(&this.m_media_query_lists, weak)

## evaluate_media_queries_and_report_changes' pruning predicate: a null weak pointer.
func dom_document_media_query_list_is_gone(context: void*?, list: const gc.Weak[CssMediaQueryList]*) -> bool:
    return gc.weak_ptr(list) == none

## Ported from Document.cpp:3958 Web::DOM::Document::evaluate_media_queries_and_report_changes.
# https://drafts.csswg.org/cssom-view/#evaluate-media-queries-and-report-changes
pub func dom_document_evaluate_media_queries_and_report_changes(this: DomDocument*):
    if not this.m_needs_media_query_evaluation:
        return
    this.m_needs_media_query_evaluation = false

    # NOTE: Not in the spec, but we take this opportunity to prune null WeakPtrs.
    discard(ak.vector_remove_all_matching(&this.m_media_query_lists, ak.Function1[const gc.Weak[CssMediaQueryList]*, bool](call = dom_document_media_query_list_is_gone, context = none)))

    # 1. For each MediaQueryList object target that has doc as its document,
    #    in the order they were created, oldest first, run these substeps:
    for media_query_list_ptr in ak.vector_span(&this.m_media_query_lists):
        # 1. If target’s matches state has changed since the last time these steps
        #    were run, fire an event at target using the MediaQueryListEvent constructor,
        #    with its type attribute initialized to change, its isTrusted attribute
        #    initialized to true, its media attribute initialized to target’s media,
        #    and its matches attribute initialized to target’s matches state.
        let media_query_list = gc.weak_ptr(&media_query_list_ptr) else continue
        let did_match = css_media_query_list_matches(media_query_list)
        let now_matches = css_media_query_list_evaluate(media_query_list)

        let did_change_internally = css_media_query_list_has_changed_state(media_query_list)
        css_media_query_list_set_has_changed_state(media_query_list, false)

        if did_change_internally == true or did_match != now_matches:
            var init = CssMediaQueryListEventInit()
            init.media = css_media_query_list_media(media_query_list)
            init.matches = now_matches
            let event = css_media_query_list_event_create(dom_document_realm(this), html_event_names_change, init)
            dom_event_set_is_trusted(event, true)
            discard(dom_event_target_dispatch_event(media_query_list.dom_event_target(), event))

    # Also not in the spec, but this is as good a place as any to evaluate @media rules!
    dom_document_evaluate_media_rules(this)

## Ported from Document.cpp:4000 Web::DOM::Document::evaluate_media_rules.
func dom_document_evaluate_media_rules(this: DomDocument*):
    css_invalidation_evaluate_media_rules_and_invalidate_style(this)

## Ported from Document.cpp:4005 Web::DOM::Document::implementation.
pub func dom_document_implementation(this: DomDocument*) -> DomImplementation*?:
    if this.m_implementation == none:
        this.m_implementation = dom_implementation_create(this)
    return this.m_implementation

# mark: Focus steps =============================================================================

## Ported from Document.cpp:4013 Web::DOM::Document::has_focus_for_bindings.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-document-hasfocus
pub func dom_document_has_focus_for_bindings(this: DomDocument*) -> bool:
    # The Document hasFocus() method steps are to return the result of running the has focus steps given this.
    return dom_document_has_focus(this)

## Ported from Document.cpp:4020 Web::DOM::Document::has_focus.
# https://html.spec.whatwg.org/multipage/interaction.html#has-focus-steps
pub func dom_document_has_focus(this: DomDocument*) -> bool:
    # 1. If target's node navigable's top-level traversable does not have system focus, then return false.
    let navigable = dom_document_navigable(this) else return false

    let traversable = html_navigable_traversable_navigable(navigable) else return false
    if not html_navigable_is_focused(traversable.html_navigable()):
        return false

    # 2. Let candidate be target's node navigable's top-level traversable's active document.
    var candidate = html_navigable_active_document(traversable.html_navigable())

    # 3. While true:
    while let current = candidate:
        # 3.1. If candidate is target, then return true.
        if current == this:
            return true

        # 3.2. If the focused area of candidate is a navigable container with a non-null content navigable,
        #      then set candidate to the active document of that navigable container's content navigable.
        if let focused_area = dom_document_focused_area(current):
            if let navigable_container = as_if_html_navigable_container(focused_area):
                if let content_navigable = html_navigable_container_content_navigable(navigable_container):
                    candidate = html_navigable_active_document(content_navigable)
                    continue

        # 3.3. Otherwise, return false.
        return false

    return false

## Ported from Document.cpp:4058 Web::DOM::Document::allow_focus.
# https://html.spec.whatwg.org/multipage/interaction.html#allow-focus-steps
pub func dom_document_allow_focus(this: DomDocument*) -> bool:
    # The allow focus steps, given a Document object target, are as follows:

    # 1. If target is allowed to use the "focus-without-user-activation" feature, then return true.
    if dom_document_is_allowed_to_use_feature(this, DomPolicyControlledFeature.focus_without_user_activation):
        return true

    # 2. If target's relevant global object has transient activation, then return true.
    if html_window_has_transient_activation(as_html_window((gc.Cell*)html_relevant_global_object((JsObject*)this))):
        return true

    # 3. Return false.
    return false

