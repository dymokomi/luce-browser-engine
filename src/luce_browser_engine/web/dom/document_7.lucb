#==============================================================================================
#
#   document_7 - DOM::Document: cookies, legacy colors, activity, visibility, the load event
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Document.cpp (lines 3610-4254): document.cookie and cookie-
#       averseness, the legacy body color attributes, the DOM JSON dump, script-blocking style
#       sheets, the referrer, full activity, location, visibility, the resize and scroll
#       steps, media query lists and @media rules, the DOMImplementation, the has-focus and
#       allow-focus steps, the parser link, XML names, node iterators, tree walkers and
#       document observers, the things delaying the load event, the HTML parser end check and
#       post-load readiness.
#
#==============================================================================================

# mark: Cookies =================================================================================

## Ported from Document.cpp:3611 Web::DOM::Document::cookie.
# https://html.spec.whatwg.org/multipage/dom.html#dom-document-cookie
pub func dom_document_cookie(this: DomDocument*) -> ak.String!:
    # On getting, if the document is a cookie-averse Document object, then the user agent must return the empty string.
    if dom_document_is_cookie_averse(this):
        return ak.String()

    # Otherwise, if the Document's origin is an opaque origin, the user agent must throw a "SecurityError" DOMException.
    let origin = dom_document_origin(this)
    if web_url.origin_is_opaque(&origin):
        return try dom_document_throw(idl_security_error_create(dom_document_realm(this), ak.utf16_string_from_str("Document origin is opaque")))

    # Otherwise, the user agent must return the cookie-string for the document's URL for a "non-HTTP" API, decoded using
    # UTF-8 decode without BOM.
    let client = page_client(dom_document_page(this))
    if let cookie_version_index = this.m_cookie_version_index:
        if let current_version = page_client_page_did_request_document_cookie_version(client, cookie_version_index):
            if this.m_cookie_version == current_version:
                return this.m_cookie

    let versioned_cookie = page_client_page_did_request_cookie(client, this.m_url, HttpSource.non_http)

    if let cookie_version = versioned_cookie.cookie_version:
        this.m_cookie_version = cookie_version
        this.m_cookie = versioned_cookie.cookie

    return versioned_cookie.cookie

## Ported from Document.cpp:3639 Web::DOM::Document::set_cookie.
# https://html.spec.whatwg.org/multipage/dom.html#dom-document-cookie
pub func dom_document_set_cookie(this: DomDocument*, cookie_string: ak.StringView) -> !:
    # On setting, if the document is a cookie-averse Document object, then the user agent must do nothing.
    if dom_document_is_cookie_averse(this):
        return

    # Otherwise, if the Document's origin is an opaque origin, the user agent must throw a "SecurityError" DOMException.
    let origin = dom_document_origin(this)
    if web_url.origin_is_opaque(&origin):
        return try dom_document_throw(idl_security_error_create(dom_document_realm(this), ak.utf16_string_from_str("Document origin is opaque")))

    # Otherwise, the user agent must act as it would when receiving a set-cookie-string for the document's URL via a
    # "non-HTTP" API, consisting of the new value encoded as UTF-8.
    if let cookie = http_parse_cookie(dom_document_url(this), cookie_string):
        page_client_page_did_set_cookie(page_client(dom_document_page(this)), this.m_url, cookie, HttpSource.non_http)

## Ported from Document.cpp:3658 Web::DOM::Document::is_cookie_averse.
# https://html.spec.whatwg.org/multipage/dom.html#cookie-averse-document-object
pub func dom_document_is_cookie_averse(this: DomDocument*) -> bool:
    # A Document object that falls into one of the following conditions is a cookie-averse Document object:

    # * A Document object whose browsing context is null.
    if dom_document_browsing_context(this) == none:
        return true

    # * A Document whose URL's scheme is not an HTTP(S) scheme.
    let url = dom_document_url(this)
    let scheme = web_url.url_scheme(&url)
    if not (ak.string_eq_string_view(&scheme, ak.sv("http")) or ak.string_eq_string_view(&scheme, ak.sv("https"))):
        return true

    return false

# mark: Legacy colors ===========================================================================

## The body element when it is not a frameset (the legacy color attributes live on it).
func dom_document_body_for_legacy_colors(this: DomDocument*) -> DomElement*?:
    let body_element = dom_document_body(this) else return none
    if is_html_frame_set_element(body_element):
        return none
    return body_element.dom_element()

## Ported from Document.cpp:3673 Web::DOM::Document::fg_color.
pub func dom_document_fg_color(this: DomDocument*) -> ak.String:
    if let body_element = dom_document_body_for_legacy_colors(this):
        return dom_element_get_attribute_value(body_element, html_attribute_names_text)
    return ak.string_from_str("")

## Ported from Document.cpp:3680 Web::DOM::Document::set_fg_color.
pub func dom_document_set_fg_color(this: DomDocument*, value: ak.String):
    if let body_element = dom_document_body_for_legacy_colors(this):
        dom_element_set_attribute_value(body_element, html_attribute_names_text, value)

