        discard(html_queue_a_task(HtmlTaskSource.navigation_and_traversal, none, none, gc.create_function0[unit](heap, ak.Function0[unit](call = dom_document_unload_child_task, context = task_captures))))

    # 5. Wait until numberUnloaded equals childNavigables's size.
    # NB: This is handled by unload_state.
