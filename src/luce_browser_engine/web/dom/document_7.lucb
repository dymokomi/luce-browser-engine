## Ported from Document.cpp:4149 Web::DOM::Document::register_node_iterator.
pub func dom_document_register_node_iterator(this: DomDocument*, node_iterator: DomNodeIterator*):
    let result = ak.hash_table_set(&this.m_node_iterators, node_iterator)
    assert(result == ak.HashSetResult.inserted_new_entry)

## Ported from Document.cpp:4155 Web::DOM::Document::unregister_node_iterator.
pub func dom_document_unregister_node_iterator(this: DomDocument*, node_iterator: DomNodeIterator*):
    let was_removed = ak.hash_table_remove_t(&this.m_node_iterators, node_iterator)
    assert(was_removed)

