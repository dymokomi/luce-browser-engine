## Ported from Document.cpp:4167 Web::DOM::Document::unregister_document_observer.
pub func dom_document_unregister_document_observer(this: DomDocument*, document_observer: DomDocumentObserver*):
    let was_removed = ak.hash_table_remove_t(&this.m_document_observers, document_observer)
    assert(was_removed)

# mark: The load event ==========================================================================

## Ported from Document.cpp:4173 Web::DOM::Document::increment_number_of_things_delaying_the_load_event.
pub func dom_document_increment_number_of_things_delaying_the_load_event(this: DomDocument*):
    this.m_number_of_things_delaying_the_load_event += 1

    page_client_page_did_update_resource_count(page_client(dom_document_page(this)), (i32)this.m_number_of_things_delaying_the_load_event)

## Ported from Document.cpp:4180 Web::DOM::Document::decrement_number_of_things_delaying_the_load_event.
pub func dom_document_decrement_number_of_things_delaying_the_load_event(this: DomDocument*):
    assert(this.m_number_of_things_delaying_the_load_event != 0)
    this.m_number_of_things_delaying_the_load_event -= 1

    page_client_page_did_update_resource_count(page_client(dom_document_page(this)), (i32)this.m_number_of_things_delaying_the_load_event)

    dom_document_schedule_html_parser_end_check(this)

## Ported from Document.cpp:4190 Web::DOM::Document::set_html_parser_end_state.
pub func dom_document_set_html_parser_end_state(this: DomDocument*, state: HtmlParserEndState*?):
    this.m_html_parser_end_state = state

## Ported from Document.cpp:4195 Web::DOM::Document::schedule_html_parser_end_check.
pub func dom_document_schedule_html_parser_end_check(this: DomDocument*):
    if let end_state = this.m_html_parser_end_state:
        html_parser_end_state_schedule_progress_check(end_state)
    if let parser = this.m_parser:
        html_parser_schedule_resume_check(parser)

## Ported from Document.cpp:4203 Web::DOM::Document::set_ready_for_post_load_tasks.
pub func dom_document_set_ready_for_post_load_tasks(this: DomDocument*, ready: bool):
    this.m_ready_for_post_load_tasks = ready
    if ready:
        if let navigable = dom_document_navigable(this):
            # AD-HOC: Clear the navigation load event guard now that the document is ready.
            #         This guard was set in finalize_a_cross_document_navigation to prevent the parent's
            #         load event from firing while the about:blank was still the active document.
            html_navigable_clear_navigation_load_event_guard(navigable)

            if let container = html_navigable_container(navigable):
                dom_document_schedule_html_parser_end_check(dom_node_document(container.dom_node()))

## Ported from Document.cpp:4220 Web::DOM::Document::anything_is_delaying_the_load_event.
pub func dom_document_anything_is_delaying_the_load_event(this: DomDocument*) -> bool:
    if this.m_number_of_things_delaying_the_load_event > 0:
        return true

    var navigables = dom_document_descendant_navigables_const(this)
    for navigable in ak.vector_span(&navigables):
        let descendant = navigable else continue
        let container = html_navigable_container(descendant) else trap("a descendant navigable has a container")
        if html_navigable_container_currently_delays_the_load_event(container):
            return true

    # FIXME: Track down anything else that is supposed to delay the load event.

    return false

## Ported from Document.cpp:4235 Web::DOM::Document::set_page_showing.
pub func dom_document_set_page_showing(this: DomDocument*, page_showing: bool):
    if this.m_page_showing == page_showing:
        return

    this.m_page_showing = page_showing

    dom_document_notify_document_observers_of_page_showing(this, this.m_page_showing)

## Ported from Document.cpp:4248 Web::DOM::Document::invalidate_stacking_context_tree.
pub func dom_document_invalidate_stacking_context_tree(this: DomDocument*):
    # NB: Called during stacking context invalidation.
    if let paintable_box = dom_node_unsafe_paintable_box(this.dom_node()):
        paint_paintable_box_invalidate_stacking_context(paintable_box)
