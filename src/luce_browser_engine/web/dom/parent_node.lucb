#==============================================================================================
#
#   parent_node - DOM::ParentNode: element children, selectors, collections, prepend/append
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/ParentNode.cpp (lines 1-282) and the inline functions of
#       LibWeb/DOM/ParentNode.h (lines 1-97): scope-matching a selectors string for
#       querySelector()/querySelectorAll(), the element-child queries, the children,
#       getElementsByTagName(NS)() and getElementsByClassName() collections, prepend(),
#       append(), replaceChildren(), moveBefore() and getElementById().
#
#==============================================================================================

# mark: ParentNode.h ============================================================================

