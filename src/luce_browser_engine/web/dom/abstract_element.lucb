## Ported from AbstractElement.h:47 Web::DOM::AbstractElement::set_inheritance_override.
pub func dom_abstract_element_set_inheritance_override(this: DomAbstractElement*, element: DomElement*):
    this.m_inheritance_override = element

## Ported from AbstractElement.h:86 AK::Traits<Web::DOM::AbstractElement>::hash.
pub func dom_abstract_element_traits_hash(key: const DomAbstractElement*) -> u32:
    var pseudo_element_hash: u32 = 0xffffffff  # -1 converted to unsigned
    if let pseudo_element = key.m_pseudo_element:
        pseudo_element_hash = (u32)pseudo_element
    return ak.pair_int_hash(ak.ptr_hash_void(key.m_element), pseudo_element_hash)

## AK::Traits<Web::DOM::AbstractElement>::equals (DefaultTraits: `operator==`, defaulted over all members).
pub func dom_abstract_element_traits_equals(a: const DomAbstractElement*, b: const DomAbstractElement*) -> bool:
    return a.m_element == b.m_element and a.m_pseudo_element == b.m_pseudo_element and a.m_inheritance_override == b.m_inheritance_override
