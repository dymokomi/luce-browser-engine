# mark: Counters ================================================================================

## Ported from AbstractElement.cpp:178 Web::DOM::AbstractElement::has_non_empty_counters_set.
pub func dom_abstract_element_has_non_empty_counters_set(this: const DomAbstractElement*) -> bool:
    if let pseudo_element = this.m_pseudo_element:
        let pseudo = dom_element_get_pseudo_element(this.m_element, pseudo_element) else trap("VERIFY: pseudo-element")
        return dom_pseudo_element_has_non_empty_counters_set(pseudo)
    return dom_element_has_non_empty_counters_set(this.m_element)

## Ported from AbstractElement.cpp:185 Web::DOM::AbstractElement::counters_set.
pub func dom_abstract_element_counters_set(this: const DomAbstractElement*) -> const CssCountersSet*?:
    if let pseudo_element = this.m_pseudo_element:
        let pseudo = dom_element_get_pseudo_element(this.m_element, pseudo_element) else trap("VERIFY: pseudo-element")
        return dom_pseudo_element_counters_set(pseudo)
    return dom_element_counters_set(this.m_element)

## Ported from AbstractElement.cpp:192 Web::DOM::AbstractElement::ensure_counters_set.
pub func dom_abstract_element_ensure_counters_set(this: DomAbstractElement*) -> CssCountersSet*:
    if let pseudo_element = this.m_pseudo_element:
        let pseudo = dom_element_get_pseudo_element(this.m_element, pseudo_element) else trap("VERIFY: pseudo-element")
        return dom_pseudo_element_ensure_counters_set(pseudo)
    return dom_element_ensure_counters_set(this.m_element)

## Ported from AbstractElement.cpp:199 Web::DOM::AbstractElement::set_counters_set.
pub func dom_abstract_element_set_counters_set(this: DomAbstractElement*, counters_set: CssCountersSet*?):
    if let pseudo_element = this.m_pseudo_element:
        let pseudo = dom_element_get_pseudo_element(this.m_element, pseudo_element) else trap("VERIFY: pseudo-element")
        dom_pseudo_element_set_counters_set(pseudo, counters_set)
    else:
        dom_element_set_counters_set(this.m_element, counters_set)

# mark: Debugging, scope and animations =========================================================

## Ported from AbstractElement.cpp:208 Web::DOM::AbstractElement::debug_description.
pub func dom_abstract_element_debug_description(this: const DomAbstractElement*) -> ak.String:
    if let pseudo_element = this.m_pseudo_element:
        var builder = ak.string_builder_new()
        let element_description = dom_node_debug_description(this.m_element.dom_node())
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&element_description))
        ak.string_builder_append(&builder, "::")
        ak.string_builder_append_string_view(&builder, css_data.pseudo_element_name(pseudo_element))
        return ak.string_builder_to_string_without_validation(&builder)
    return dom_node_debug_description(this.m_element.dom_node())

## Ported from AbstractElement.cpp:220 Web::DOM::AbstractElement::style_scope.
# C++ returns `StyleScope const&`; the generated signature (which callers use) answers a copy of the
# struct, which shares the scope's storage.
pub func dom_abstract_element_style_scope(this: const DomAbstractElement*) -> CssStyleScope:
    return *dom_node_style_scope(this.m_element.dom_node())

## Ported from AbstractElement.cpp:225 Web::DOM::AbstractElement::css_defined_animations.
pub func dom_abstract_element_css_defined_animations(this: const DomAbstractElement*) -> ak.HashMap[ak.FlyString, CssAnimation*, ak.FlyStringTraits]*?:
    return animations_animatable_css_defined_animations(&this.m_element.animatable, this.m_pseudo_element)

## Ported from AbstractElement.cpp:230 Web::DOM::AbstractElement::set_has_css_defined_animations.
pub func dom_abstract_element_set_has_css_defined_animations(this: DomAbstractElement*):
    animations_animatable_set_has_css_defined_animations(&this.m_element.animatable)

