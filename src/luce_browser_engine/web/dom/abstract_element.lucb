#==============================================================================================
#
#   abstract_element - DOM::AbstractElement: an element or one of its pseudo-elements
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/AbstractElement.cpp (lines 1-235) and the inline functions of
#       AbstractElement.h, with its AK::Traits (hash and equality). Style computation and
#       layout use an AbstractElement wherever the subject may be a pseudo-element; each
#       accessor forwards to the element with the pseudo-element, or to its PseudoElement.
#
#==============================================================================================

# mark: Construction and edges ==================================================================

## Ported from AbstractElement.cpp:15 Web::DOM::AbstractElement::AbstractElement.
pub func dom_abstract_element_construct(this: DomAbstractElement*, element: DomElement*, pseudo_element: css_data.PseudoElement? = none):
    this.m_element = element
    this.m_pseudo_element = pseudo_element
    this.m_inheritance_override = none

## Ported from AbstractElement.cpp:21 Web::DOM::AbstractElement::AbstractElement.
pub func dom_abstract_element_construct_2(this: DomAbstractElement*, element: DomElement*, pseudo_element: css_data.PseudoElement? = none):
    this.m_element = element
    this.m_pseudo_element = pseudo_element
    this.m_inheritance_override = none

## `AbstractElement { element, pseudo_element }` as a value.
func dom_abstract_element_make(element: DomElement*, pseudo_element: css_data.PseudoElement? = none) -> DomAbstractElement:
    var result: DomAbstractElement = ---
    dom_abstract_element_construct(&result, element, pseudo_element)
    return result

## Ported from AbstractElement.cpp:27 Web::DOM::AbstractElement::visit.
pub func dom_abstract_element_visit(this: const DomAbstractElement*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_t_2(visitor, this.m_element)
    gc.cell_visitor_visit_t(visitor, this.m_inheritance_override)

## Ported from AbstractElement.cpp:33 Web::DOM::AbstractElement::document.
pub func dom_abstract_element_document(this: const DomAbstractElement*) -> DomDocument*:
    return dom_node_document(this.m_element.dom_node())

# mark: Tree counting ===========================================================================

## Ported from AbstractElement.cpp:38 Web::DOM::AbstractElement::tree_counting_function_resolution_context.
pub func dom_abstract_element_tree_counting_function_resolution_context(this: const DomAbstractElement*) -> DomAbstractElementTreeCountingFunctionResolutionContext:
    # FIXME: When used on an element-backed pseudo-element which is also a real element, the tree counting functions
    #        resolve for that real element. For other pseudo elements, they resolve as if they were resolved against
    #        the originating element. It follows that for nested pseudo elements the resolution will recursively walk
    #        the originating elements until a real element is found.

    # FIXME: A tree counting function is a tree-scoped reference where it references an implicit tree-scoped name for
    #        the element it resolves against. This is done to not leak tree information to an outer tree. A tree
    #        counting function that is scoped to an outer tree relative to the element it resolves against, will alway
    #        resolve to 0.
    let element_to_resolve_tree_counting_function_against = this.m_element

    # The sibling-count() functional notation represents, as an <integer>, the total number of child elements in the
    # parent of the element on which the notation is used.
    let parent = dom_node_parent_element(element_to_resolve_tree_counting_function_against.dom_node())

    # If there is no parent we are the root node
    let parent_element = parent else return DomAbstractElementTreeCountingFunctionResolutionContext(sibling_count = 1, sibling_index = 1)

    var count: usize = 0
    var index: usize = 0

    var child_node = tree_node_first_child_of_type(parent_element.dom_node(), &dom_element_class)
    while let child = child_node:
        count += 1
        if child == element_to_resolve_tree_counting_function_against.dom_node():
            index = count
        child_node = (DomNode*?)dom_non_document_type_child_node_next_element_sibling(child)

    return DomAbstractElementTreeCountingFunctionResolutionContext(sibling_count = count, sibling_index = index)

# mark: Layout nodes and the tree ===============================================================

## Ported from AbstractElement.cpp:74 Web::DOM::AbstractElement::layout_node.
pub func dom_abstract_element_layout_node(this: DomAbstractElement*) -> LayoutNodeWithStyle*?:
    if let pseudo_element = this.m_pseudo_element:
        return dom_element_get_pseudo_element_node(this.m_element, pseudo_element)
    return dom_element_layout_node(this.m_element)

## Ported from AbstractElement.cpp:81 Web::DOM::AbstractElement::unsafe_layout_node.
pub func dom_abstract_element_unsafe_layout_node(this: DomAbstractElement*) -> LayoutNodeWithStyle*?:
    if let pseudo_element = this.m_pseudo_element:
        return dom_element_get_pseudo_element_node(this.m_element, pseudo_element)
    return dom_element_unsafe_layout_node(this.m_element)

## Ported from AbstractElement.cpp:88 Web::DOM::AbstractElement::parent_element.
pub func dom_abstract_element_parent_element(this: const DomAbstractElement*) -> DomElement*?:
    if this.m_pseudo_element != none:
        return this.m_element
    return dom_node_parent_element(this.m_element.dom_node())

## Ported from AbstractElement.cpp:95 Web::DOM::AbstractElement::element_to_inherit_style_from.
pub func dom_abstract_element_element_to_inherit_style_from(this: const DomAbstractElement*) -> DomAbstractElement?:
    if let inheritance_override = this.m_inheritance_override:
        return dom_abstract_element_make(inheritance_override)

    let element = dom_element_element_to_inherit_style_from(this.m_element, this.m_pseudo_element)

    let found = element else return none

    return dom_abstract_element_make(found)

## Ported from AbstractElement.cpp:108 Web::DOM::AbstractElement::walk_layout_tree.
pub func dom_abstract_element_walk_layout_tree(this: DomAbstractElement*, walk_method: DomAbstractElementWalkMethod) -> DomAbstractElement?:
    # NB: Called during style recalculation.
    let start = dom_abstract_element_unsafe_layout_node(this) else return none
    var node: LayoutNode*? = start.layout_node()

    while true:
        let current = node else return none
        match walk_method:
            .previous:
                node = tree_node_previous_in_pre_order(current)
            .previous_sibling:
                node = tree_node_previous_sibling(current)
            _:
                trap("VERIFY_NOT_REACHED")
        let walked = node else return none

        if let dom_node = layout_node_dom_node(walked):
            if let previous_element = as_if_dom_element(dom_node):
                return dom_abstract_element_make(previous_element)

        if layout_node_is_generated_for_pseudo_element(walked):
            let generator = layout_node_pseudo_element_generator(walked) else trap("VERIFY: pseudo-element generator")
            return dom_abstract_element_make(generator, layout_node_generated_for_pseudo_element(walked))

## Ported from AbstractElement.cpp:135 Web::DOM::AbstractElement::is_before.
pub func dom_abstract_element_is_before(this: const DomAbstractElement*, other: DomAbstractElement) -> bool:
    # NB: Called during style recalculation.
    let this_node = dom_abstract_element_unsafe_layout_node_const(this)
    let other_node = dom_abstract_element_unsafe_layout_node_const(&other)
    let this_layout_node = this_node else return false
    let other_layout_node = other_node else return false
    return tree_node_is_before(this_layout_node.layout_node(), other_layout_node.layout_node())

