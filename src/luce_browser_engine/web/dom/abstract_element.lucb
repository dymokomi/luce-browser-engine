## Ported from AbstractElement.cpp:153 Web::DOM::AbstractElement::set_custom_property_data.
pub func dom_abstract_element_set_custom_property_data(this: DomAbstractElement*, data: const CssCustomPropertyData*?):
    dom_element_set_custom_property_data(this.m_element, this.m_pseudo_element, data)

## Ported from AbstractElement.cpp:158 Web::DOM::AbstractElement::get_custom_property.
pub func dom_abstract_element_get_custom_property(this: const DomAbstractElement*, name: ak.FlyString) -> CssStyleValue*?:
    let data = dom_abstract_element_custom_property_data(this) else return none
    if let property = css_custom_property_data_get(data, name):
        return property.value
    return none

