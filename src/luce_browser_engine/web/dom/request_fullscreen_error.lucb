## Ported from RequestFullscreenError.h:22 Web::DOM::request_fullscreen_error_to_string.
pub func dom_request_fullscreen_error_to_string(error_: DomRequestFullscreenError) -> ak.StringView:
    match error_:
        .false_: trap("VERIFY_NOT_REACHED")
        .element_ready_check_failed: return ak.sv("Element ready check failed")
        .unsupported_element: return ak.sv("Not supported element")
        .no_transient_user_activation: return ak.sv("No transient user activation available to consume")
        .element_node_doc_is_not_pending_doc: return ak.sv("Element's node document is not pending doc")
        _: trap("VERIFY_NOT_REACHED")
