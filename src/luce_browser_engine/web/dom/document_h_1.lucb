## Ported from Document.h:650 Web::DOM::Document::for_each_node_iterator.
pub func dom_document_for_each_node_iterator(this: DomDocument*, callback: ak.Function1[DomNodeIterator*, unit]):
    for node_iterator in ak.hash_table_begin(&this.m_node_iterators):
        ak.function1_call(&callback, *node_iterator else trap("a null node iterator"))
