#==============================================================================================
#
#   document_h_1 - DOM::Document: the inline functions of Document.h (accessors, part 1)
#
#   DESCRIPTION:
#       Port of the functions defined in LibWeb/DOM/Document.h (lines 226-650), in the
#       header's order: the accessors and setters of the document's state, the encoding
#       queries, the quirks-mode and document-type tests, the visibility state, the parser
#       link and for_each_node_iterator.
#
#       Document.h also declares invalidate_style_of_elements_affected_by_has() and
#       build_counter_style_cache(), which the donor never defines (and nothing calls); they
#       are not ported.
#
#==============================================================================================

# mark: Accessors ===============================================================================

## Ported from Document.h:226 Web::DOM::Document::dom_tree_version.
pub func dom_document_dom_tree_version(this: DomDocument*) -> u64:
    return this.m_dom_tree_version

## Ported from Document.h:227 Web::DOM::Document::bump_dom_tree_version.
pub func dom_document_bump_dom_tree_version(this: DomDocument*):
    this.m_dom_tree_version += 1

## Ported from Document.h:231 Web::DOM::Document::character_data_version.
pub func dom_document_character_data_version(this: DomDocument*) -> u64:
    return this.m_character_data_version

## Ported from Document.h:232 Web::DOM::Document::bump_character_data_version.
pub func dom_document_bump_character_data_version(this: DomDocument*):
    this.m_character_data_version += 1

## Ported from Document.h:242 Web::DOM::Document::set_cookie_version_index.
pub func dom_document_set_cookie_version_index(this: DomDocument*, cookie_version_index: u32):
    this.m_cookie_version_index = cookie_version_index

## Ported from Document.h:243 Web::DOM::Document::reset_cookie_version.
pub func dom_document_reset_cookie_version(this: DomDocument*):
    # Core::INVALID_SHARED_VERSION
    this.m_cookie_version = 0

