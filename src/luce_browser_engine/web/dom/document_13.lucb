## `item.command.visit([](auto const& cmd) { return cmd.nesting_level_change if it has one, else 0; })`.
func dom_document_command_nesting_level_change(command: const display_list.DisplayListCommand*) -> i32:
    match *command:
        .save(_): return display_list.save_nesting_level_change
        .save_layer(_): return display_list.save_layer_nesting_level_change
        .restore(_): return display_list.restore_nesting_level_change
        .apply_effects(_): return display_list.apply_effects_nesting_level_change
        _: return 0

## The state the recursive lambdas of dump_display_list capture by reference.
struct DomDocumentDumpDisplayList:
    var builder: ak.StringBuilder*
    var visual_context_tree: const display_list.AccumulatedVisualContextTree*
    var context_id_to_paintable: ak.HashMap[u64, PaintPaintableBox*, ak.U64Traits]*
    var children: ak.HashMap[u64, ak.Vector[u64], ak.U64Traits]*

## dump_display_list's `dump_context` lambda (recursive).
func dom_document_dump_context(state: DomDocumentDumpDisplayList*, node_index: u64, indent: usize):
    let builder = state.builder
    ak.string_builder_append_repeated_u8(builder, ' ', indent * 2)
    ak.string_builder_append(builder, "[")
    ak.format_u64(builder, node_index)
    ak.string_builder_append(builder, "] ")
    display_list.accumulated_visual_context_tree_dump(state.visual_context_tree, node_index, builder)
    if let paintable_box = ak.hash_map_get_k(state.context_id_to_paintable, node_index):
        ak.string_builder_append(builder, " (")
        let description = paint_paintable_debug_description((*paintable_box).paint_paintable())
        ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&description))
        ak.string_builder_append(builder, ")")
    ak.string_builder_append_u8(builder, '\n')
    if let child_indices = ak.hash_map_get_k(state.children, node_index):
        for child_node_index in ak.vector_span(child_indices):
            dom_document_dump_context(state, child_node_index, indent + 1)

## dump_display_list's `dump_commands` lambda (recursive).
func dom_document_dump_commands(builder: ak.StringBuilder*, list: const display_list.DisplayList*, base_indent: i32):
    var indent = base_indent
    for item in ak.vector_span_const(display_list.display_list_commands(list)):
        let nesting_change = dom_document_command_nesting_level_change(&item.command)

        if nesting_change < 0:
            indent = indent + nesting_change
            if indent < base_indent:
                indent = base_indent

        ak.string_builder_append_repeated_u8(builder, ' ', (usize)indent * 2)
        dom_document_dump_display_list_command(builder, &item)
        ak.string_builder_append_u8(builder, '\n')

        match item.command:
            .paint_nested_display_list(nested):
                if let nested_display_list = nested.display_list:
                    dom_document_dump_commands(builder, nested_display_list, indent + 1)
            _: discard(nesting_change)

        if nesting_change > 0:
            indent += nesting_change

## Ported from Document.cpp:7913 Web::DOM::Document::dump_display_list.
pub func dom_document_dump_display_list(this: DomDocument*) -> ak.String:
    dom_document_update_layout(this, DomUpdateLayoutReason.dump_display_list)

    let viewport_paintable = dom_document_paintable(this) else return ak.string_from_str("No paintable")

    let recorded_display_list = dom_document_record_display_list(this, HtmlPaintConfig()) else return ak.string_from_str("No display list")

    var context_id_to_paintable: ak.HashMap[u64, PaintPaintableBox*, ak.U64Traits]
    for paintable in paint_paintable_inclusive_subtree(viewport_paintable.paint_paintable()):
        let paintable_box = as_if_paint_paintable_box(paintable) else continue
        let visual_context_index = paint_paintable_box_accumulated_visual_context_index(paintable_box)
        if visual_context_index != 0:
            discard(ak.hash_map_try_set(&context_id_to_paintable, visual_context_index, paintable_box) else ak.HashSetResult.inserted_new_entry)

    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "AccumulatedVisualContext Tree:\n")

    let visual_context_tree = display_list.display_list_visual_context_tree(recorded_display_list)
    var visited: ak.HashTable[u64, ak.U64Traits]
    var children: ak.HashMap[u64, ak.Vector[u64], ak.U64Traits]
    var root_contexts: ak.Vector[u64]

    for item in ak.vector_span_const(display_list.display_list_commands(recorded_display_list)):
        if item.context_index == 0:
            continue
        var node_index = item.context_index
        while node_index != 0 and not ak.hash_table_contains_t(&visited, node_index):
            discard(ak.hash_table_set(&visited, node_index))
            let parent = display_list.accumulated_visual_context_tree_node_at(visual_context_tree, node_index).parent_index
            if parent != 0:
                ak.vector_append_t(ak.hash_map_ensure(&children, parent), node_index)
            elif not ak.vector_contains_slow[u64, ak.U64Traits](&root_contexts, node_index):
                ak.vector_append_t(&root_contexts, node_index)
            node_index = display_list.accumulated_visual_context_tree_node_at(visual_context_tree, node_index).parent_index

    var state = DomDocumentDumpDisplayList(builder = &builder, visual_context_tree = visual_context_tree, context_id_to_paintable = &context_id_to_paintable, children = &children)
    for root in ak.vector_span(&root_contexts):
        dom_document_dump_context(&state, root, 1)

    ak.string_builder_append(&builder, "\nDisplayList:\n")

    dom_document_dump_commands(&builder, recorded_display_list, 0)

    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Document.cpp:8005 Web::DOM::Document::dump_stacking_context_tree.
pub func dom_document_dump_stacking_context_tree(this: DomDocument*) -> ak.String:
    dom_document_update_layout(this, DomUpdateLayoutReason.dump_display_list)

    let viewport_paintable = dom_document_paintable(this) else return ak.string_from_str("No paintable")

    paint_viewport_paintable_build_stacking_context_tree_if_needed(viewport_paintable)

    let stacking_context = paint_paintable_box_stacking_context(viewport_paintable.paint_paintable_box()) else return ak.string_from_str("No stacking context")

    var builder = ak.string_builder_new()
    paint_stacking_context_dump(stacking_context, &builder)
    return ak.string_builder_to_string_without_validation(&builder)

# mark: Environment variables ===================================================================

## environment_variable_value's `invalid` lambda: a guaranteed-invalid value.
func dom_document_invalid_environment_variable() -> ak.Vector[css_syntax.ComponentValue]:
    var value: css_syntax.ComponentValue = ---
    css_syntax.component_value_construct_guaranteed_invalid_value(&value, css_syntax.GuaranteedInvalidValue())
    var values: ak.Vector[css_syntax.ComponentValue]
    ak.vector_append_t(&values, value)
    return values

## Ported from Document.cpp:8024 Web::DOM::Document::environment_variable_value.
pub func dom_document_environment_variable_value(this: DomDocument*, environment_variable: css_data.EnvironmentVariable, indices: i32[]) -> ak.Vector[css_syntax.ComponentValue]?:
    match environment_variable:
        .preferred_text_scale:
            # FIXME: Report the user's preferred text scale, once we have that as a setting.
            if indices.length != 0:
                return dom_document_invalid_environment_variable()
            var value: css_syntax.ComponentValue = ---
            css_syntax.component_value_construct_token(&value, css_syntax.token_create_number(css_syntax.Number(m_value = 1.0, m_type = css_syntax.NumberType.number), ak.String()))
            var values: ak.Vector[css_syntax.ComponentValue]
            ak.vector_append_t(&values, value)
            return values
        .safe_area_inset_bottom, .safe_area_inset_left, .safe_area_inset_right, .safe_area_inset_top, .safe_area_max_inset_bottom, .safe_area_max_inset_left, .safe_area_max_inset_right, .safe_area_max_inset_top:
            # FIXME: Report the safe area, once we can detect our display's shape (and it's not rectangular).
            if indices.length != 0:
                return dom_document_invalid_environment_variable()
            var value: css_syntax.ComponentValue = ---
            css_syntax.component_value_construct_token(&value, css_syntax.token_create_dimension_f64(0.0, ak.fly_string_from_str("px"), ak.String()))
            var values: ak.Vector[css_syntax.ComponentValue]
            ak.vector_append_t(&values, value)
            return values
        .viewport_segment_bottom, .viewport_segment_height, .viewport_segment_left, .viewport_segment_right, .viewport_segment_top, .viewport_segment_width:
            # "These variables are only defined when there are at least two such segments."
            # https://drafts.csswg.org/css-env/#viewport-segments
            # FIXME: Report the viewport segment areas, once we can detect that and there are multiple of them.
            return dom_document_invalid_environment_variable()
        _: trap("VERIFY_NOT_REACHED")

