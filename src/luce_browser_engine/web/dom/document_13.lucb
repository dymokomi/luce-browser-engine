# mark: Pending CSS imports, pointer lock and the selector cache ================================

## Ported from Document.cpp:8209 Web::DOM::Document::add_pending_css_import_rule.
pub func dom_document_add_pending_css_import_rule(this: DomDocument*, rule: CssImportRule*):
    discard(ak.hash_table_set(&this.m_pending_css_import_rules, rule))

## Ported from Document.cpp:8214 Web::DOM::Document::remove_pending_css_import_rule.
pub func dom_document_remove_pending_css_import_rule(this: DomDocument*, rule: CssImportRule*):
    discard(ak.hash_table_remove_t(&this.m_pending_css_import_rules, rule))
    if ak.hash_table_is_empty(&this.m_pending_css_import_rules):
        page_client_request_frame(page_client(dom_document_page(this)))

## Ported from Document.cpp:8221 Web::DOM::Document::exit_pointer_lock.
pub func dom_document_exit_pointer_lock(this: DomDocument*):
    ak.dbgln("FIXME: exit_pointer_lock()")

## Ported from Document.cpp:8226 Web::DOM::contains_named_namespace.
func dom_contains_named_namespace(selectors: ak.Vector[CssSelector*]) -> bool:
    var list = selectors
    for selector in ak.vector_span(&list):
        # for (auto const& compound_selector : selector->compound_selectors()): each compound selector's simple
        # selectors are checked for a named namespace (recursing into pseudo-class argument lists). The compound
        # and simple selectors are opaque until region r38 fills CSS::Selector.
        if not ak.vector_is_empty(&selector.m_compound_selectors):
            trap("unported: Web::DOM::contains_named_namespace needs CSS::Selector::CompoundSelector (region r38)")
    return false

## The `static constexpr size_t MAX_SELECTOR_QUERY_CACHE_SIZE` of parse_or_cache_selector_list.
let dom_document_max_selector_query_cache_size: usize = 512

## Ported from Document.cpp:8246 Web::DOM::Document::parse_or_cache_selector_list.
pub func dom_document_parse_or_cache_selector_list(this: DomDocument*, selector_text: ak.StringView) -> ak.Vector[CssSelector*]?:
    let selector_text_string = ak.string_from_utf8(selector_text) else trap("MUST: String::from_utf8")

    if let cached = ak.hash_map_get_k(&this.m_selector_query_cache, selector_text_string):
        return *cached

    var context: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&context, this)
    var maybe_selectors = parse_selector(context, selector_text)

    # "Note: Support for namespaces within selectors is not planned and will not be added."
    if let selectors = maybe_selectors:
        if dom_contains_named_namespace(selectors):
            maybe_selectors = none

    if ak.hash_map_size(&this.m_selector_query_cache) >= dom_document_max_selector_query_cache_size:
        ak.hash_map_remove_opaque(&this.m_selector_query_cache, ak.hash_map_begin(&this.m_selector_query_cache))

    discard(ak.hash_map_set(&this.m_selector_query_cache, selector_text_string, maybe_selectors))
    let cached = ak.hash_map_get_k(&this.m_selector_query_cache, selector_text_string) else trap("VERIFY: the selector list was just cached")
    return *cached
