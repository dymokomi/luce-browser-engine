## Ported from Document.cpp:8084 Web::DOM::Document::create_ns_resolver.
pub func dom_document_create_ns_resolver(this: DomDocument*, node_resolver: DomNode*) -> DomNode*:
    return node_resolver

## Ported from Document.cpp:8090 Web::DOM::Document::get_registered_custom_property.
# https://drafts.css-houdini.org/css-properties-values-api/#determining-registration
pub func dom_document_get_registered_custom_property(this: DomDocument*, name: ak.FlyString) -> const CssCustomPropertyRegistration*?:
    # If the Document’s [[registeredPropertySet]] slot contains a record with the custom property’s name, the
    # registration is that record.
    if let registered_property = ak.hash_map_get_k(&this.m_registered_property_set, name):
        return registered_property

    # Otherwise, if the Document’s active stylesheets contain at least one valid @property rule representing a
    # registration with the custom property’s name, the last such one in document order is the registration.
    if let registered_property = ak.hash_map_get_k(&this.m_cached_registered_properties_from_css_property_rules, name):
        return registered_property

    # Otherwise there is no registration, and the custom property is not a registered custom property.
    return none

## Ported from Document.cpp:8106 Web::DOM::Document::custom_property_initial_value.
pub func dom_document_custom_property_initial_value(this: DomDocument*, name: ak.FlyString) -> CssStyleValue*:
    if let maybe_custom_property = dom_document_get_registered_custom_property(this, name):
        if let initial_value = maybe_custom_property.initial_value:
            return initial_value
        return css_guaranteed_invalid_style_value_create().css_style_value()

    # For non-registered properties, the initial value is the guaranteed-invalid value.
    # See: https://drafts.csswg.org/css-variables/#propdef-
    return css_guaranteed_invalid_style_value_create().css_style_value()

## Ported from Document.cpp:8120 Web::DOM::Document::did_change_custom_property_registrations.
pub func dom_document_did_change_custom_property_registrations(this: DomDocument*):
    this.m_custom_property_registration_generation += 1

    # Custom property registration changes can alter inheritance and initial values even when no selector matching
    # changes. Registrations only move when a stylesheet containing an @property rule is added/removed or when
    # CSS.registerProperty() is called, so a full document restyle is cheap enough in practice.
    dom_node_invalidate_style(this.dom_node(), DomStyleInvalidationReason.other)

## CSS/CustomPropertyRegistration.h:35 operator==(CustomPropertyRegistration const&, CustomPropertyRegistration const&).
func dom_custom_property_registrations_equal(a: const CssCustomPropertyRegistration*, b: const CssCustomPropertyRegistration*) -> bool:
    if not ak.fly_string_eq_fly_string(&a.property_name, &b.property_name):
        return false
    if not ak.string_equals(&a.syntax, &b.syntax):
        return false
    if a.inherit != b.inherit:
        return false
    if a.initial_value == b.initial_value:
        return true
    let a_value = a.initial_value else return false
    let b_value = b.initial_value else return false
    return css_style_value_equals(a_value, b_value)

## AK's HashMap operator== over registrations (sizes equal, and every entry found with an equal value).
func dom_registration_maps_equal(a: ak.HashMap[ak.FlyString, CssCustomPropertyRegistration, ak.FlyStringTraits]*, b: ak.HashMap[ak.FlyString, CssCustomPropertyRegistration, ak.FlyStringTraits]*) -> bool:
    if ak.hash_map_size(a) != ak.hash_map_size(b):
        return false
    for entry in ak.hash_map_begin(a):
        let other = ak.hash_map_get_k(b, entry.key) else return false
        if not dom_custom_property_registrations_equal(&entry.value, other):
            return false
    return true

## build_registered_properties_cache's inner lambda: collect each @property rule's registration.
func dom_document_collect_property_rule(context: void*?, rule: CssRule*):
    let cache = (ak.HashMap[ak.FlyString, CssCustomPropertyRegistration, ak.FlyStringTraits]*)(context else trap("no captures"))
    if let property_rule = as_if_css_property_rule(rule):
        discard(ak.hash_map_set(cache, css_property_rule_name(property_rule), css_property_rule_to_registration(property_rule)))

## build_registered_properties_cache's outer lambda: walk each active style sheet's effective rules.
func dom_document_collect_property_rules_of_sheet(context: void*?, style_sheet: CssCssStyleSheet*):
    css_css_style_sheet_for_each_effective_rule(style_sheet, TraversalOrder.preorder, ak.Function1[CssRule*, unit](call = dom_document_collect_property_rule, context = context))

## Ported from Document.cpp:8130 Web::DOM::Document::build_registered_properties_cache.
pub func dom_document_build_registered_properties_cache(this: DomDocument*):
    var cached_registered_properties_from_css_property_rules: ak.HashMap[ak.FlyString, CssCustomPropertyRegistration, ak.FlyStringTraits]
    dom_document_for_each_active_css_style_sheet(this, ak.Function1[CssCssStyleSheet*, unit](call = dom_document_collect_property_rules_of_sheet, context = &cached_registered_properties_from_css_property_rules))

    if not dom_registration_maps_equal(&cached_registered_properties_from_css_property_rules, &this.m_cached_registered_properties_from_css_property_rules):
        dom_document_did_change_custom_property_registrations(this)

    this.m_cached_registered_properties_from_css_property_rules = cached_registered_properties_from_css_property_rules

# mark: Cookie version index ====================================================================

## `HTTP::Cookie::canonicalize_domain(new_domain) == HTTP::Cookie::canonicalize_domain(old_url)` (Optional<String> ==).
func dom_document_optional_string_equals(a: ak.String, b: ak.String?) -> bool:
    let b_value = b else return false
    return ak.string_equals(&a, &b_value)

## Ported from Document.cpp:8146 Web::DOM::Document::ensure_cookie_version_index.
pub func dom_document_ensure_cookie_version_index(this: DomDocument*, new_url: web_url.Url, old_url: web_url.Url):
    let maybe_new_domain = http_cookie_canonicalize_domain(new_url)
    if maybe_new_domain == none:
        this.m_cookie_version_index = none
        return
    let new_domain = maybe_new_domain else trap("unreachable: checked above")

    if this.m_cookie_version_index != none and dom_document_optional_string_equals(new_domain, http_cookie_canonicalize_domain(old_url)):
        return

    page_client_page_did_request_document_cookie_version_index(page_client(dom_document_page(this)), dom_node_unique_id(this.dom_node()), new_domain)
    this.m_cookie_version_index = none

# mark: to_string ===============================================================================

## Ported from Document.cpp:8161 Web::DOM::to_string(SetNeedsLayoutReason).
pub func dom_to_string_dom_set_needs_layout_reason(reason: DomSetNeedsLayoutReason) -> ak.StringView:
    match reason:
        .character_data_replace_data: return ak.sv("CharacterDataReplaceData")
        .finalize_a_cross_document_navigation: return ak.sv("FinalizeACrossDocumentNavigation")
        .generated_content_image_finished_loading: return ak.sv("GeneratedContentImageFinishedLoading")
        .html_canvas_element_width_or_height_change: return ak.sv("HTMLCanvasElementWidthOrHeightChange")
        .html_image_element_react_to_changes_in_the_environment: return ak.sv("HTMLImageElementReactToChangesInTheEnvironment")
        .html_image_element_update_the_image_data: return ak.sv("HTMLImageElementUpdateTheImageData")
        .html_video_element_natural_dimensions_changed: return ak.sv("HTMLVideoElementNaturalDimensionsChanged")
        .html_video_element_set_video_track: return ak.sv("HTMLVideoElementSetVideoTrack")
        .keyframe_effect: return ak.sv("KeyframeEffect")
        .layout_tree_update: return ak.sv("LayoutTreeUpdate")
        .navigable_set_viewport_size: return ak.sv("NavigableSetViewportSize")
        .svg_graphics_element_transform_change: return ak.sv("SVGGraphicsElementTransformChange")
        .svg_image_element_fetch_the_document: return ak.sv("SVGImageElementFetchTheDocument")
        .svg_image_filter_fetch: return ak.sv("SVGImageFilterFetch")
        .svg_view_box_change: return ak.sv("SVGViewBoxChange")
        .style_change: return ak.sv("StyleChange")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Document.cpp:8173 Web::DOM::to_string(SetNeedsLayoutTreeUpdateReason).
pub func dom_to_string_dom_set_needs_layout_tree_upda(reason: DomSetNeedsLayoutTreeUpdateReason) -> ak.StringView:
    match reason:
        .element_set_inner_html: return ak.sv("ElementSetInnerHTML")
        .element_set_shadow_root: return ak.sv("ElementSetShadowRoot")
        .details_element_opened_or_closed: return ak.sv("DetailsElementOpenedOrClosed")
