#==============================================================================================
#
#   document_13 - DOM::Document: dumps, environment variables, custom properties, selectors
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Document.cpp (lines 7913-8270): the display list and
#       stacking-context dumps, the CSS environment variables, the registered custom
#       properties and their cache, XPath entry points, the cookie version index, the
#       to_string of the layout and invalidation reasons, the pending CSS imports, pointer
#       lock, and the selector query cache.
#
#==============================================================================================

# mark: Dumps ===================================================================================

## `builder.appendff("{}@{}", command.command_name, item.context_index.value())`.
func dom_document_append_command_name(builder: ak.StringBuilder*, command_name: str, context_index: u64):
    ak.string_builder_append(builder, command_name)
    ak.string_builder_append(builder, "@")
    ak.format_u64(builder, context_index)

## `item.command.visit([&](auto const& command) { builder.appendff("{}@{}", command.command_name, item.context_index.value()); command.dump(builder); })`.
func dom_document_dump_display_list_command(builder: ak.StringBuilder*, item: const display_list.DisplayListCommandListItem*):
    match item.command:
        .draw_glyph_run(command):
            dom_document_append_command_name(builder, display_list.draw_glyph_run_command_name, item.context_index)
            display_list.draw_glyph_run_dump(&command, builder)
        .fill_rect(command):
            dom_document_append_command_name(builder, display_list.fill_rect_command_name, item.context_index)
            display_list.fill_rect_dump(&command, builder)
        .draw_scaled_immutable_bitmap(command):
            dom_document_append_command_name(builder, display_list.draw_scaled_immutable_bitmap_command_name, item.context_index)
            display_list.draw_scaled_immutable_bitmap_dump(&command, builder)
        .draw_repeated_immutable_bitmap(command):
            dom_document_append_command_name(builder, display_list.draw_repeated_immutable_bitmap_command_name, item.context_index)
            display_list.draw_repeated_immutable_bitmap_dump(&command, builder)
        .draw_external_content(command):
            dom_document_append_command_name(builder, display_list.draw_external_content_command_name, item.context_index)
            display_list.draw_external_content_dump(&command, builder)
        .save(command):
            dom_document_append_command_name(builder, display_list.save_command_name, item.context_index)
            display_list.save_dump(&command, builder)
        .save_layer(command):
            dom_document_append_command_name(builder, display_list.save_layer_command_name, item.context_index)
            display_list.save_layer_dump(&command, builder)
        .restore(command):
            dom_document_append_command_name(builder, display_list.restore_command_name, item.context_index)
            display_list.restore_dump(&command, builder)
        .translate(command):
            dom_document_append_command_name(builder, display_list.translate_command_name, item.context_index)
            display_list.translate_dump(&command, builder)
        .add_clip_rect(command):
            dom_document_append_command_name(builder, display_list.add_clip_rect_command_name, item.context_index)
            display_list.add_clip_rect_dump(&command, builder)
        .paint_linear_gradient(command):
            dom_document_append_command_name(builder, display_list.paint_linear_gradient_command_name, item.context_index)
            display_list.paint_linear_gradient_dump(&command, builder)
        .paint_radial_gradient(command):
            dom_document_append_command_name(builder, display_list.paint_radial_gradient_command_name, item.context_index)
            display_list.paint_radial_gradient_dump(&command, builder)
        .paint_conic_gradient(command):
            dom_document_append_command_name(builder, display_list.paint_conic_gradient_command_name, item.context_index)
            display_list.paint_conic_gradient_dump(&command, builder)
        .paint_outer_box_shadow(command):
            dom_document_append_command_name(builder, display_list.paint_outer_box_shadow_command_name, item.context_index)
            display_list.paint_outer_box_shadow_dump(&command, builder)
        .paint_inner_box_shadow(command):
            dom_document_append_command_name(builder, display_list.paint_inner_box_shadow_command_name, item.context_index)
            display_list.paint_inner_box_shadow_dump(&command, builder)
        .paint_text_shadow(command):
            dom_document_append_command_name(builder, display_list.paint_text_shadow_command_name, item.context_index)
            display_list.paint_text_shadow_dump(&command, builder)
        .fill_rect_with_rounded_corners(command):
            dom_document_append_command_name(builder, display_list.fill_rect_with_rounded_corners_command_name, item.context_index)
            display_list.fill_rect_with_rounded_corners_dump(&command, builder)
        .fill_path(command):
            dom_document_append_command_name(builder, display_list.fill_path_command_name, item.context_index)
            display_list.fill_path_dump(&command, builder)
        .stroke_path(command):
            dom_document_append_command_name(builder, display_list.stroke_path_command_name, item.context_index)
            display_list.stroke_path_dump(&command, builder)
        .draw_ellipse(command):
            dom_document_append_command_name(builder, display_list.draw_ellipse_command_name, item.context_index)
            display_list.draw_ellipse_dump(&command, builder)
