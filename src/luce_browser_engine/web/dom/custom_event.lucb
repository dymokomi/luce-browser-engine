#==============================================================================================
#
#   custom_event - DOM::CustomEvent: an event carrying a detail value
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/DOM/CustomEvent.cpp (lines 1-61) and CustomEvent.h (lines
#       1-46). CustomEventInit's `detail { JS::js_null() }` default is not a constant: a
#       default-initialized CustomEventInit is made by dom_custom_event_init_default.
#
#       Copyright (c) 2021, Luke Wilde <lukew@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## `CustomEventInit {}`: the dictionary with its defaults (detail null).
pub func dom_custom_event_init_default() -> DomCustomEventInit:
    var event_init = DomCustomEventInit(event_init = DomEventInit())
    dom_custom_event_init_init_fields(&event_init)
    return event_init

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:17 Web::DOM::CustomEvent::create.
pub func dom_custom_event_create(realm: Realm*, event_name: ak.FlyString, event_init: DomCustomEventInit) -> DomCustomEvent*:
    return realm_create_dom_custom_event(realm, realm, event_name, event_init)

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:22 Web::DOM::CustomEvent::construct_impl.
pub func dom_custom_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: DomCustomEventInit) -> DomCustomEvent*!:
    return dom_custom_event_create(realm, event_name, event_init)

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:27 Web::DOM::CustomEvent::CustomEvent.
pub func dom_custom_event_construct(this: DomCustomEvent*, realm: Realm*, event_name: ak.FlyString, event_init: DomCustomEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    dom_custom_event_init_fields(this)
    this.m_detail = event_init.detail

## Ported from Libraries/LibWeb/DOM/CustomEvent.h:32 Web::DOM::CustomEvent::detail.
## https://dom.spec.whatwg.org/#dom-customevent-detail
pub func dom_custom_event_detail(this: DomCustomEvent*) -> JsValue:
    return this.m_detail

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:35 Web::DOM::CustomEvent::initialize (override).
pub func dom_custom_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.custom_event)
    dom_event_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:41 Web::DOM::CustomEvent::visit_edges (override).
pub func dom_custom_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomCustomEvent*)base
    dom_event_visit_edges_impl(base, visitor)
    js_visit_value(visitor, this.m_detail)

## Ported from Libraries/LibWeb/DOM/CustomEvent.cpp:48 Web::DOM::CustomEvent::init_custom_event.
## https://dom.spec.whatwg.org/#dom-customevent-initcustomevent
pub func dom_custom_event_init_custom_event(this: DomCustomEvent*, type_: ak.String, bubbles: bool, cancelable: bool, detail: JsValue):
    # 1. If this’s dispatch flag is set, then return.
    if dom_event_dispatched(this.dom_event()):
        return

    # 2. Initialize this with type, bubbles, and cancelable.
    dom_event_initialize_event(this.dom_event(), type_, bubbles, cancelable)

    # 3. Set this’s detail attribute to detail.
    this.m_detail = detail
