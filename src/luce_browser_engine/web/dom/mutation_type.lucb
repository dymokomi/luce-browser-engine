#==============================================================================================
#
#   mutation_type - DOM::MutationType: the FlyStrings naming the three mutation record types
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/MutationType.cpp (lines 1-16). The names are longer than a short
#       FlyString, so they are interned by dom_mutation_type_initialize_strings, which
#       web_initialize_strings runs at startup (DESIGN.md §2.6).
#
#==============================================================================================

## Whether dom_mutation_type_initialize_strings has run.
var dom_mutation_type_strings_initialized: bool

## Ported from MutationType.cpp:11 the definitions of Web::DOM::MutationType's FlyStrings
## (`FlyString name = #name##_fly_string;` for each ENUMERATE_MUTATION_TYPES entry).
pub func dom_mutation_type_initialize_strings():
    if dom_mutation_type_strings_initialized:
        return
    dom_mutation_type_attributes = ak.fly_string_from_str("attributes")
    dom_mutation_type_character_data = ak.fly_string_from_str("characterData")
    dom_mutation_type_child_list = ak.fly_string_from_str("childList")
    dom_mutation_type_strings_initialized = true
