#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Web::Fetch::Infrastructure::LOCAL_SCHEMES (Fetch/Infrastructure/URL.h:23).
pub let fetch_local_schemes: str[3] = ["about", "blob", "data"]

## Web::Fetch::Infrastructure::HTTP_SCHEMES (Fetch/Infrastructure/URL.h:29).
pub let fetch_http_schemes: str[2] = ["http", "https"]

## Web::Fetch::Infrastructure::FETCH_SCHEMES (Fetch/Infrastructure/URL.h:35).
pub let fetch_fetch_schemes: str[7] = [
    "about",
    "blob",
    "data",
    "file",
    "http",
    "https",
    # AD-HOC: Internal fetch schemes:
    "resource",
]

## Ported from Libraries/LibWeb/Fetch/Infrastructure/URL.cpp:18 Web::Fetch::Infrastructure::is_local_url.
# https://fetch.spec.whatwg.org/#is-local
pub func fetch_is_local_url(url: web_url.Url) -> bool:
    # A URL is local if its scheme is a local scheme.
    let scheme = web_url.url_scheme(&url)
    for local_scheme in fetch_local_schemes:
        if ak.string_eq_string_view(&scheme, ak.sv(local_scheme)):
            return true
    return false

## Ported from Libraries/LibWeb/Fetch/Infrastructure/URL.cpp:26 Web::Fetch::Infrastructure::is_fetch_scheme.
# https://fetch.spec.whatwg.org/#fetch-scheme
pub func fetch_is_fetch_scheme(scheme: ak.StringView) -> bool:
    # A fetch scheme is "about", "blob", "data", "file", or an HTTP(S) scheme.
    for fetch_scheme in fetch_fetch_schemes:
        if ak.string_view_equals(&scheme, fetch_scheme):
            return true
    return false

## Ported from Libraries/LibWeb/Fetch/Infrastructure/URL.cpp:33 Web::Fetch::Infrastructure::is_http_or_https_scheme.
# https://fetch.spec.whatwg.org/#http-scheme
pub func fetch_is_http_or_https_scheme(scheme: ak.StringView) -> bool:
    # An HTTP(S) scheme is "http" or "https".
    for http_scheme in fetch_http_schemes:
        if ak.string_view_equals(&scheme, http_scheme):
            return true
    return false
