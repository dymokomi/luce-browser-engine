## Ported from Build/Libraries/LibWeb/CSS/Parser/GeneratedValueTypesParsing.cpp Web::CSS::Parser::Parser::parse_font_weight_absolute_value.
# https://drafts.csswg.org/css-fonts-4/#font-weight-absolute-values
pub func css_parser_parse_font_weight_absolute_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <font-weight-absolute> = normal | bold | <number [1,1000]>
    let font_weight_absolute = css_parser_parse_font_weight_absolute_alternatives(this, tokens)
    if let font_weight_absolute_value = font_weight_absolute:
        return font_weight_absolute_value.css_style_value()
    return none

## The lambda `parse_font_weight_absolute_alternatives` of Parser::parse_font_weight_absolute_value.
func css_parser_parse_font_weight_absolute_alternatives(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    let font_weight_absolute_alternative_0 = css_parser_parse_specific_keyword_value(this, tokens, css_data.Keyword.normal)
    if let font_weight_absolute_alternative_0_value = font_weight_absolute_alternative_0:
        return font_weight_absolute_alternative_0_value.css_style_value()

    let font_weight_absolute_alternative_1 = css_parser_parse_specific_keyword_value(this, tokens, css_data.Keyword.bold)
    if let font_weight_absolute_alternative_1_value = font_weight_absolute_alternative_1:
        return font_weight_absolute_alternative_1_value.css_style_value()

    let font_weight_absolute_alternative_2 = css_parser_parse_number_value(this, tokens, CssNumericRange(min = 1.0, max = 1000.0))
    if let font_weight_absolute_alternative_2_value = font_weight_absolute_alternative_2:
        return font_weight_absolute_alternative_2_value.css_style_value()

    return none

## Ported from Build/Libraries/LibWeb/CSS/Parser/GeneratedValueTypesParsing.cpp Web::CSS::Parser::Parser::parse_symbol_value.
# https://drafts.csswg.org/css-counter-styles-3/#typedef-symbol
pub func css_parser_parse_symbol_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <symbol> = <string> | <custom-ident>
    let symbol = css_parser_parse_symbol_alternatives(this, tokens)
    if let symbol_value = symbol:
        return symbol_value.css_style_value()
    return none

## The lambda `parse_symbol_alternatives` of Parser::parse_symbol_value.
func css_parser_parse_symbol_alternatives(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    let symbol_alternative_0 = css_parser_parse_string_value(this, tokens)
    if let symbol_alternative_0_value = symbol_alternative_0:
        return symbol_alternative_0_value.css_style_value()

    var symbol_alternative_1_blacklist: ak.StringView[]
    let symbol_alternative_1 = css_parser_parse_custom_ident_value(this, tokens, symbol_alternative_1_blacklist)
    if let symbol_alternative_1_value = symbol_alternative_1:
        return symbol_alternative_1_value.css_style_value()

    return none
