## AK::Traits<CssValueType>: AK's hash and equality for the key type (filled by hand, r32: Traits<Enum>
## hashes the underlying u8 with u32_hash, AK's int_hash).
pub struct CssValueTypeTraits: ak.Traits[CssValueType]:
    var empty_: u8

    func hash_of(key: const CssValueType*) -> u32: return ak.u32_hash((u32)*key)

    func equals(a: const CssValueType*, b: const CssValueType*) -> bool: return *a == *b

