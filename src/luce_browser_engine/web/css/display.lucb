# mark: Keywords and short displays =============================================================

## Ported from Libraries/LibWeb/CSS/Display.cpp:30 Web::CSS::Display::from_keyword.
pub func css_display_from_keyword(keyword: css_data.Keyword) -> CssDisplay:
    match keyword:
        .none_: return css_display_from_short(CssDisplayShort.none_)
        .contents: return css_display_from_short(CssDisplayShort.contents)
        .block: return css_display_from_short(CssDisplayShort.block)
        .inline: return css_display_from_short(CssDisplayShort.inline)
        .flow: return css_display_from_short(CssDisplayShort.flow)
        .flow_root: return css_display_from_short(CssDisplayShort.flow_root)
        .inline_block: return css_display_from_short(CssDisplayShort.inline_block)
        .run_in: return css_display_from_short(CssDisplayShort.run_in)
        .list_item: return css_display_from_short(CssDisplayShort.list_item)
        .flex: return css_display_from_short(CssDisplayShort.flex)
        .inline_flex: return css_display_from_short(CssDisplayShort.inline_flex)
        .grid: return css_display_from_short(CssDisplayShort.grid)
        .inline_grid: return css_display_from_short(CssDisplayShort.inline_grid)
        .ruby: return css_display_from_short(CssDisplayShort.ruby)
        .table: return css_display_from_short(CssDisplayShort.table)
        .inline_table: return css_display_from_short(CssDisplayShort.inline_table)
        .math: return css_display_from_short(CssDisplayShort.math)
        _: discard(keyword)

    if let internal_value = css_data.keyword_to_display_internal(keyword):
        return css_display_new_display_internal(internal_value)
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Display.cpp:77 Web::CSS::Display::from_short.
pub func css_display_from_short(short_: CssDisplayShort) -> CssDisplay:
    match short_:
        .none_: return css_display_new_display_box(css_data.DisplayBox.none_)
        .contents: return css_display_new_display_box(css_data.DisplayBox.contents)
        .block: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.flow)
        .inline: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.flow)
        .flow: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.flow)
        .flow_root: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.flow_root)
        .inline_block: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.flow_root)
        .run_in: return css_display_new(css_data.DisplayOutside.run_in, css_data.DisplayInside.flow)
        .list_item: return css_display_new_list_item(css_data.DisplayOutside.block, css_data.DisplayInside.flow, CssDisplayListItem.yes)
        .inline_list_item: return css_display_new_list_item(css_data.DisplayOutside.inline, css_data.DisplayInside.flow, CssDisplayListItem.yes)
        .flex: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.flex)
        .inline_flex: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.flex)
        .grid: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.grid)
        .inline_grid: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.grid)
        .ruby: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.ruby)
        .table: return css_display_new(css_data.DisplayOutside.block, css_data.DisplayInside.table)
        .inline_table: return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.table)
        .math:
            # NOTE: The spec ( https://w3c.github.io/mathml-core/#new-display-math-value ) does not
            #       mention what the outside value for `display: math` should be but other browsers
            #       use `inline` so let's go with that.
            return css_display_new(css_data.DisplayOutside.inline, css_data.DisplayInside.math)
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Display.cpp:123 Web::CSS::Display::to_keyword.
pub func css_display_to_keyword(this: const CssDisplay*) -> css_data.Keyword?:
    match this.m_type:
        .box:
            return css_data.keyword_from_string(css_data.to_string_display_box(this.m_value.box))
        .internal:
            return css_data.keyword_from_string(css_data.to_string_display_internal(this.m_value.internal))
        .outside_and_inside:
            # NOTE: Following the precedence rules of "most backwards-compatible, then shortest",
            #       serialization of equivalent display values uses the "Short display" column.
            if css_display_eq(this, css_display_from_short(CssDisplayShort.none_)):
                return css_data.Keyword.none_
            if css_display_eq(this, css_display_from_short(CssDisplayShort.contents)):
                return css_data.Keyword.contents
            if css_display_eq(this, css_display_from_short(CssDisplayShort.block)):
                return css_data.Keyword.block
            if css_display_eq(this, css_display_from_short(CssDisplayShort.flow_root)):
                return css_data.Keyword.flow_root
            if css_display_eq(this, css_display_from_short(CssDisplayShort.inline)):
                return css_data.Keyword.inline
            if css_display_eq(this, css_display_from_short(CssDisplayShort.inline_block)):
                return css_data.Keyword.inline_block
            if css_display_eq(this, css_display_from_short(CssDisplayShort.run_in)):
                return css_data.Keyword.run_in
            if css_display_eq(this, css_display_from_short(CssDisplayShort.list_item)):
                return css_data.Keyword.list_item
            if css_display_eq(this, css_display_from_short(CssDisplayShort.flex)):
                return css_data.Keyword.flex
            if css_display_eq(this, css_display_from_short(CssDisplayShort.inline_flex)):
                return css_data.Keyword.inline_flex
            if css_display_eq(this, css_display_from_short(CssDisplayShort.grid)):
                return css_data.Keyword.grid
            if css_display_eq(this, css_display_from_short(CssDisplayShort.inline_grid)):
                return css_data.Keyword.inline_grid
            if css_display_eq(this, css_display_from_short(CssDisplayShort.ruby)):
                return css_data.Keyword.ruby
            if css_display_eq(this, css_display_from_short(CssDisplayShort.table)):
                return css_data.Keyword.table
            if css_display_eq(this, css_display_from_short(CssDisplayShort.inline_table)):
                return css_data.Keyword.inline_table
            if css_display_eq(this, css_display_from_short(CssDisplayShort.math)):
                return css_data.Keyword.math
            return none
        _: trap("VERIFY_NOT_REACHED")

# mark: Constructors ============================================================================

## Ported from Libraries/LibWeb/CSS/Display.h:145 Web::CSS::Display::Display.
pub func css_display_construct_display_outside_display_inside(this: CssDisplay*, outside: css_data.DisplayOutside, inside: css_data.DisplayInside):
    this.m_type = CssDisplayType.outside_and_inside
    this.m_value.outside_inside = CssDisplayUnionStruct(outside = outside, inside = inside, list_item = CssDisplayListItem.no)

## Ported from Libraries/LibWeb/CSS/Display.h:155 Web::CSS::Display::Display.
pub func css_display_construct_display_outside_display_inside_css_display_list_item(this: CssDisplay*, outside: css_data.DisplayOutside, inside: css_data.DisplayInside, list_item: CssDisplayListItem):
    this.m_type = CssDisplayType.outside_and_inside
    this.m_value.outside_inside = CssDisplayUnionStruct(outside = outside, inside = inside, list_item = list_item)

## Ported from Libraries/LibWeb/CSS/Display.h:165 Web::CSS::Display::Display.
pub func css_display_construct_display_internal(this: CssDisplay*, internal: css_data.DisplayInternal):
    this.m_type = CssDisplayType.internal
    this.m_value.internal = internal

## Ported from Libraries/LibWeb/CSS/Display.h:171 Web::CSS::Display::Display.
pub func css_display_construct_display_box(this: CssDisplay*, box: css_data.DisplayBox):
    this.m_type = CssDisplayType.box
    this.m_value.box = box

## `Display { outside, inside }` as a value.
pub func css_display_new(outside: css_data.DisplayOutside, inside: css_data.DisplayInside) -> CssDisplay:
    var display: CssDisplay
    css_display_construct_display_outside_display_inside(&display, outside, inside)
    return display

## `Display { outside, inside, list_item }` as a value.
pub func css_display_new_list_item(outside: css_data.DisplayOutside, inside: css_data.DisplayInside, list_item: CssDisplayListItem) -> CssDisplay:
    var display: CssDisplay
    css_display_construct_display_outside_display_inside_css_display_list_item(&display, outside, inside, list_item)
    return display

## `Display { internal }` as a value.
pub func css_display_new_display_internal(internal: css_data.DisplayInternal) -> CssDisplay:
    var display: CssDisplay
    css_display_construct_display_internal(&display, internal)
    return display

## `Display { box }` as a value.
pub func css_display_new_display_box(box: css_data.DisplayBox) -> CssDisplay:
    var display: CssDisplay
    css_display_construct_display_box(&display, box)
    return display
