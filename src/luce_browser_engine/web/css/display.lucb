#==============================================================================================
#
#   display - Display: the value of the display property
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Display.cpp (lines 1-171) and the inline members of Display.h, in
#       the header's order with to_string, from_keyword, from_short and to_keyword where the
#       header declares them. C++'s operator== is css_display_eq. Display() = default is the
#       zero value (an outside-and-inside display of zeroed parts).
#
#       Copyright (c) 2021, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2022, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2023, Sam Atkins <atkinssj@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Serialization and comparison ============================================================

## Ported from Libraries/LibWeb/CSS/Display.cpp:13 Web::CSS::Display::to_string.
pub func css_display_to_string(this: const CssDisplay*) -> ak.String:
    if let keyword = css_display_to_keyword(this):
        let keyword_string = css_data.string_from_keyword(keyword)
        return ak.string_from_utf8_without_validation(ak.string_view_bytes(&keyword_string))
    assert(this.m_type == CssDisplayType.outside_and_inside)
    var parts: ak.StringView[3] = ---
    var count: usize = 0
    let outside_inside = this.m_value.outside_inside
    if not (outside_inside.outside == css_data.DisplayOutside.block and outside_inside.inside == css_data.DisplayInside.flow_root):
        parts[count] = css_data.to_string_display_outside(outside_inside.outside)
        count += 1
    if outside_inside.inside != css_data.DisplayInside.flow:
        parts[count] = css_data.to_string_display_inside(outside_inside.inside)
        count += 1
    if outside_inside.list_item == CssDisplayListItem.yes:
        parts[count] = ak.sv("list-item")
        count += 1
    let joined: const ak.StringView[] = parts[..<count]
    return ak.string_join_string_view(ak.sv(" "), joined) else trap("MUST: String::join")

## Ported from Libraries/LibWeb/CSS/Display.h:24 Web::CSS::Display::operator==.
pub func css_display_eq(this: const CssDisplay*, other: CssDisplay) -> bool:
    if this.m_type != other.m_type:
        return false
    match this.m_type:
        .box:
            return this.m_value.box == other.m_value.box
        .internal:
            return this.m_value.internal == other.m_value.internal
        .outside_and_inside:
            return this.m_value.outside_inside.outside == other.m_value.outside_inside.outside and this.m_value.outside_inside.inside == other.m_value.outside_inside.inside and this.m_value.outside_inside.list_item == other.m_value.outside_inside.list_item
        _: trap("VERIFY_NOT_REACHED")

# mark: Internal displays =======================================================================

## Ported from Libraries/LibWeb/CSS/Display.h:52 Web::CSS::Display::is_internal.
pub func css_display_is_internal(this: const CssDisplay*) -> bool:
    return this.m_type == CssDisplayType.internal

## Ported from Libraries/LibWeb/CSS/Display.h:53 Web::CSS::Display::internal.
pub func css_display_internal(this: const CssDisplay*) -> css_data.DisplayInternal:
    assert(css_display_is_internal(this))
    return this.m_value.internal

## Ported from Libraries/LibWeb/CSS/Display.h:59 Web::CSS::Display::is_table_column.
pub func css_display_is_table_column(this: const CssDisplay*) -> bool:
    return css_display_is_internal(this) and css_display_internal(this) == css_data.DisplayInternal.table_column

## Ported from Libraries/LibWeb/CSS/Display.h:60 Web::CSS::Display::is_table_row_group.
pub func css_display_is_table_row_group(this: const CssDisplay*) -> bool:
    return css_display_is_internal(this) and css_display_internal(this) == css_data.DisplayInternal.table_row_group

