## Ported from Libraries/LibWeb/CSS/Display.h:66 Web::CSS::Display::is_table_caption.
pub func css_display_is_table_caption(this: const CssDisplay*) -> bool:
    return css_display_is_internal(this) and css_display_internal(this) == css_data.DisplayInternal.table_caption

## Ported from Libraries/LibWeb/CSS/Display.h:69 Web::CSS::Display::is_internal_table.
# https://drafts.csswg.org/css-display-3/#internal-table-element
pub func css_display_is_internal_table(this: const CssDisplay*) -> bool:
    if not css_display_is_internal(this):
        return false
    let internal = css_display_internal(this)
    return internal == css_data.DisplayInternal.table_row_group or internal == css_data.DisplayInternal.table_header_group or internal == css_data.DisplayInternal.table_footer_group or internal == css_data.DisplayInternal.table_row or internal == css_data.DisplayInternal.table_cell or internal == css_data.DisplayInternal.table_column_group or internal == css_data.DisplayInternal.table_column

# mark: Boxes, outside and inside ===============================================================

## Ported from Libraries/LibWeb/CSS/Display.h:81 Web::CSS::Display::is_none.
pub func css_display_is_none(this: const CssDisplay*) -> bool:
    return this.m_type == CssDisplayType.box and this.m_value.box == css_data.DisplayBox.none_

## Ported from Libraries/LibWeb/CSS/Display.h:82 Web::CSS::Display::is_contents.
pub func css_display_is_contents(this: const CssDisplay*) -> bool:
    return this.m_type == CssDisplayType.box and this.m_value.box == css_data.DisplayBox.contents

## Ported from Libraries/LibWeb/CSS/Display.h:84 Web::CSS::Display::type.
pub func css_display_type(this: const CssDisplay*) -> CssDisplayType:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/Display.h:86 Web::CSS::Display::is_outside_and_inside.
pub func css_display_is_outside_and_inside(this: const CssDisplay*) -> bool:
