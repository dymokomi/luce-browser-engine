## Ported from Libraries/LibWeb/CSS/Display.h:88 Web::CSS::Display::outside.
pub func css_display_outside(this: const CssDisplay*) -> css_data.DisplayOutside:
    assert(css_display_is_outside_and_inside(this))
    return this.m_value.outside_inside.outside

