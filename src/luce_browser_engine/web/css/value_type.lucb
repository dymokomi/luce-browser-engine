## Ported from Libraries/LibWeb/CSS/ValueType.cpp:12 Web::CSS::value_type_from_string.
pub func css_value_type_from_string(string: ak.StringView) -> CssValueType?:
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("anchor-size")):
        return CssValueType.anchor_size
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("angle")):
        return CssValueType.angle
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("angle-percentage")):
        return CssValueType.angle_percentage
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("background-position")):
        return CssValueType.background_position
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("basic-shape")):
        return CssValueType.basic_shape
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("color")):
        return CssValueType.color
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("counter")):
        return CssValueType.counter
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("counter-style")):
        return CssValueType.counter_style
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("custom-ident")):
        return CssValueType.custom_ident
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("dashed-ident")):
        return CssValueType.dashed_ident
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("easing-function")):
        return CssValueType.easing_function
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("filter-value-list")):
        return CssValueType.filter_value_list
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("fit-content")):
        return CssValueType.fit_content
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("flex")):
        return CssValueType.flex
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("font-variant-alternates")):
        return CssValueType.font_variant_alternates
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("font-variant-east-asian")):
        return CssValueType.font_variant_east_asian
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("font-variant-ligatures")):
        return CssValueType.font_variant_ligatures
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("font-variant-numeric")):
        return CssValueType.font_variant_numeric
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("frequency")):
        return CssValueType.frequency
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("frequency-percentage")):
        return CssValueType.frequency_percentage
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("image")):
        return CssValueType.image
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("integer")):
        return CssValueType.integer
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("length")):
        return CssValueType.length
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("length-percentage")):
        return CssValueType.length_percentage
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("number")):
        return CssValueType.number
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("opacity-value")):
        return CssValueType.opacity_value
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("opentype-tag")):
        return CssValueType.opentype_tag
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("paint")):
        return CssValueType.paint
