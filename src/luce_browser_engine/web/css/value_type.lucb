        return CssValueType.position
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("ratio")):
        return CssValueType.ratio
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("rect")):
        return CssValueType.rect
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("resolution")):
        return CssValueType.resolution
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("scroll-function")):
        return CssValueType.scroll_function
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("string")):
        return CssValueType.string
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("time")):
        return CssValueType.time
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("time-percentage")):
        return CssValueType.time_percentage
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("transform-function")):
