        return CssValueType.view_timeline_inset
    return none

## Ported from Libraries/LibWeb/CSS/ValueType.cpp:101 Web::CSS::value_type_to_string.
pub func css_value_type_to_string(value_type: CssValueType) -> ak.StringView:
    match value_type:
        .anchor: return ak.sv("Anchor")
        .anchor_size: return ak.sv("AnchorSize")
        .angle: return ak.sv("Angle")
        .angle_percentage: return ak.sv("AnglePercentage")
        .background_position: return ak.sv("BackgroundPosition")
        .basic_shape: return ak.sv("BasicShape")
        .color: return ak.sv("Color")
        .corner_shape: return ak.sv("CornerShape")
        .counter: return ak.sv("Counter")
        .counter_style: return ak.sv("CounterStyle")
        .custom_ident: return ak.sv("CustomIdent")
        .dashed_ident: return ak.sv("DashedIdent")
        .easing_function: return ak.sv("EasingFunction")
        .filter_value_list: return ak.sv("FilterValueList")
        .fit_content: return ak.sv("FitContent")
        .flex: return ak.sv("Flex")
        .font_style: return ak.sv("FontStyle")
        .font_variant_alternates: return ak.sv("FontVariantAlternates")
        .font_variant_east_asian: return ak.sv("FontVariantEastAsian")
        .font_variant_ligatures: return ak.sv("FontVariantLigatures")
        .font_variant_numeric: return ak.sv("FontVariantNumeric")
        .frequency: return ak.sv("Frequency")
        .frequency_percentage: return ak.sv("FrequencyPercentage")
        .image: return ak.sv("Image")
        .integer: return ak.sv("Integer")
        .length: return ak.sv("Length")
        .length_percentage: return ak.sv("LengthPercentage")
        .number: return ak.sv("Number")
        .opacity_value: return ak.sv("OpacityValue")
        .opentype_tag: return ak.sv("OpenTypeTag")
        .paint: return ak.sv("Paint")
        .percentage: return ak.sv("Percentage")
        .position: return ak.sv("Position")
        .ratio: return ak.sv("Ratio")
        .rect: return ak.sv("Rect")
        .resolution: return ak.sv("Resolution")
        .scroll_function: return ak.sv("ScrollFunction")
        .string: return ak.sv("String")
        .time: return ak.sv("Time")
        .time_percentage: return ak.sv("TimePercentage")
        .transform_function: return ak.sv("TransformFunction")
        .transform_list: return ak.sv("TransformList")
        .url: return ak.sv("Url")
        .view_function: return ak.sv("ViewFunction")
        .view_timeline_inset: return ak.sv("ViewTimelineInset")
        _: trap("VERIFY_NOT_REACHED")
