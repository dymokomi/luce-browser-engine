#==============================================================================================
#
#   color_function_descriptor - the table that describes each color function's channels and
#   serialization
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/ColorFunctionDescriptor.cpp (lines 1-165). The table
#       `s_color_function_descriptors`, a static initialized by calling
#       build_color_function_descriptors(), is built on first use (its module variable is
#       css_s_color_function_descriptors in types_color_function_descriptor). It holds only
#       scalars and views of string literals.
#
#       Copyright (c) 2026, Tim Ledbetter <tim.ledbetter@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## `ChannelDescriptor { kind, percent_reference, serialize_clamp_min, serialize_clamp_max }`.
func css_channel_descriptor(kind: CssChannelKind, percent_reference: f32, serialize_clamp_min: f64?, serialize_clamp_max: f64?) -> CssChannelDescriptor:
    return CssChannelDescriptor(kind = kind, percent_reference = percent_reference, serialize_clamp_min = serialize_clamp_min, serialize_clamp_max = serialize_clamp_max)

## Ported from Libraries/LibWeb/CSS/ColorFunctionDescriptor.cpp:17 Web::CSS::(anonymous)::build_color_function_descriptors.
# LUCE-BUG: local_array_of_views_returned_by_value: the C++ returns the table by value; a local array of
# descriptors (which hold StringViews) cannot be returned, so the table is filled through a span.
func css_build_color_function_descriptors(table: CssColorFunctionDescriptor[]):
    assert(table.length == css_color_type_count)
    table[(usize)CssColorStyleValueColorType.rgb] = CssColorFunctionDescriptor(
        function_name = ak.sv("rgb"),
        serialization_behavior = CssSerializationBehavior.srgb_legacy,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 255.0, 0.0, 255.0),
            css_channel_descriptor(CssChannelKind.number, 255.0, 0.0, 255.0),
            css_channel_descriptor(CssChannelKind.number, 255.0, 0.0, 255.0),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.a98_rgb] = CssColorFunctionDescriptor(
        function_name = ak.sv("a98-rgb"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.display_p3] = CssColorFunctionDescriptor(
        function_name = ak.sv("display-p3"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.display_p3_linear] = CssColorFunctionDescriptor(
        function_name = ak.sv("display-p3-linear"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.hsl] = CssColorFunctionDescriptor(
        function_name = ak.sv("hsl"),
        serialization_behavior = CssSerializationBehavior.srgb_legacy,
        channels = [
            css_channel_descriptor(CssChannelKind.hue, 0.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, none),
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.yes,
    )
    table[(usize)CssColorStyleValueColorType.hwb] = CssColorFunctionDescriptor(
        function_name = ak.sv("hwb"),
        serialization_behavior = CssSerializationBehavior.srgb_modern,
        channels = [
            css_channel_descriptor(CssChannelKind.hue, 0.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, none),
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.yes,
    )
    table[(usize)CssColorStyleValueColorType.lab] = CssColorFunctionDescriptor(
        function_name = ak.sv("lab"),
        serialization_behavior = CssSerializationBehavior.modern_named,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, 100.0),
            css_channel_descriptor(CssChannelKind.number, 125.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 125.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.lch] = CssColorFunctionDescriptor(
        function_name = ak.sv("lch"),
        serialization_behavior = CssSerializationBehavior.modern_named,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 100.0, 0.0, 100.0),
            css_channel_descriptor(CssChannelKind.number, 150.0, 0.0, none),
            css_channel_descriptor(CssChannelKind.hue, 0.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.ok_lab] = CssColorFunctionDescriptor(
        function_name = ak.sv("oklab"),
        serialization_behavior = CssSerializationBehavior.modern_named,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, 0.0, 1.0),
            css_channel_descriptor(CssChannelKind.number, 0.4, none, none),
            css_channel_descriptor(CssChannelKind.number, 0.4, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.oklch] = CssColorFunctionDescriptor(
        function_name = ak.sv("oklch"),
        serialization_behavior = CssSerializationBehavior.modern_named,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, 0.0, 1.0),
            css_channel_descriptor(CssChannelKind.number, 0.4, 0.0, none),
            css_channel_descriptor(CssChannelKind.hue, 0.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.s_rgb] = CssColorFunctionDescriptor(
        function_name = ak.sv("srgb"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.s_rgb_linear] = CssColorFunctionDescriptor(
        function_name = ak.sv("srgb-linear"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.pro_photo_rgb] = CssColorFunctionDescriptor(
        function_name = ak.sv("prophoto-rgb"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.rec2020] = CssColorFunctionDescriptor(
        function_name = ak.sv("rec2020"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.xyzd50] = CssColorFunctionDescriptor(
        function_name = ak.sv("xyz-d50"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )
    table[(usize)CssColorStyleValueColorType.xyzd65] = CssColorFunctionDescriptor(
        function_name = ak.sv("xyz-d65"),
        serialization_behavior = CssSerializationBehavior.color_function,
        channels = [
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
            css_channel_descriptor(CssChannelKind.number, 1.0, none, none),
        ],
        absolutizes_to_rgb = CssAbsolutizesToRgb.no,
    )

## Whether css_s_color_function_descriptors has been built (the static's initialization).
var css_s_color_function_descriptors_initialized: bool

## `s_color_function_descriptors`, built on first use.
func css_color_function_descriptors() -> const CssColorFunctionDescriptor[]:
    if not css_s_color_function_descriptors_initialized:
        css_build_color_function_descriptors(css_s_color_function_descriptors)
        css_s_color_function_descriptors_initialized = true
    return css_s_color_function_descriptors

## Ported from Libraries/LibWeb/CSS/ColorFunctionDescriptor.cpp:146 Web::CSS::color_function_descriptor_for.
pub func css_color_function_descriptor_for(color_type: CssColorStyleValueColorType) -> CssColorFunctionDescriptor:
    return css_color_function_descriptors()[(usize)color_type]

## Ported from Libraries/LibWeb/CSS/ColorFunctionDescriptor.cpp:151 Web::CSS::color_type_from_color_function_name.
pub func css_color_type_from_color_function_name(name: ak.StringView) -> CssColorStyleValueColorType?:
    # "xyz" is an alias for "xyz-d65".
    if ak.string_view_eq_string_view(&name, ak.sv("xyz")):
        return CssColorStyleValueColorType.xyzd65

    let descriptors = css_color_function_descriptors()
    for i in 0..<descriptors.length:
        let descriptor = descriptors[i]
        if descriptor.serialization_behavior == CssSerializationBehavior.color_function and ak.string_view_eq_string_view(&descriptor.function_name, name):
            return (CssColorStyleValueColorType)(i32)i
    return none
