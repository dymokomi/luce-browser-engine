# https://drafts.csswg.org/css-anchor-position-1/#funcdef-anchor-size

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.cpp:12 Web::CSS::AnchorSizeStyleValue::create.
pub func css_anchor_size_style_value_create(anchor_name: ak.FlyString?, anchor_size: css_data.AnchorSize?, fallback_value: CssStyleValue*?) -> CssAnchorSizeStyleValue*:
    let this = &(alloc CssAnchorSizeStyleValue[1] else trap("out of memory"))[0]
    css_anchor_size_style_value_construct(this, anchor_name, anchor_size, fallback_value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.cpp:19 Web::CSS::AnchorSizeStyleValue::AnchorSizeStyleValue.
pub func css_anchor_size_style_value_construct(this: CssAnchorSizeStyleValue*, anchor_name: ak.FlyString?, anchor_size: css_data.AnchorSize?, fallback_value: CssStyleValue*?):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.anchor_size)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_anchor_size_style_value_vtable, &css_anchor_size_style_value_class)
    this.m_properties = CssAnchorSizeStyleValueProperties(anchor_name = anchor_name, anchor_size = anchor_size, fallback_value = fallback_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.cpp:28 Web::CSS::AnchorSizeStyleValue::serialize (override).
pub func css_anchor_size_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode):
    let this = (CssAnchorSizeStyleValue*)base
    # FIXME: Handle SerializationMode.
    ak.string_builder_append(builder, "anchor-size(")

    if let anchor_name = css_anchor_size_style_value_anchor_name(this):
        ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&anchor_name))

    if let anchor_size = css_anchor_size_style_value_anchor_size(this):
        if css_anchor_size_style_value_anchor_name(this) != none:
            ak.string_builder_append_u8(builder, ' ')
        ak.string_builder_append_string_view(builder, css_data.to_string_anchor_size(anchor_size))

    if let fallback_value = css_anchor_size_style_value_fallback_value(this):
        if css_anchor_size_style_value_anchor_name(this) != none or css_anchor_size_style_value_anchor_size(this) != none:
            ak.string_builder_append(builder, ", ")
        css_style_value_serialize(fallback_value, builder, serialization_mode)

    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.h:25 Web::CSS::AnchorSizeStyleValue::properties_equal.
pub func css_anchor_size_style_value_properties_equal(this: CssAnchorSizeStyleValue*, other: CssAnchorSizeStyleValue*) -> bool:
    return css_optional_fly_strings_equal(this.m_properties.anchor_name, other.m_properties.anchor_name) and this.m_properties.anchor_size == other.m_properties.anchor_size and css_optional_style_values_equal(this.m_properties.fallback_value, other.m_properties.fallback_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::AnchorSizeStyleValue (CRTP helper) (override).
pub func css_anchor_size_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_anchor_size_style_value_properties_equal((CssAnchorSizeStyleValue*)base, (CssAnchorSizeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.h:27 Web::CSS::AnchorSizeStyleValue::is_computationally_independent (override).
pub func css_anchor_size_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.h:29 Web::CSS::AnchorSizeStyleValue::anchor_name.
pub func css_anchor_size_style_value_anchor_name(this: CssAnchorSizeStyleValue*) -> ak.FlyString?:
    return this.m_properties.anchor_name

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.h:30 Web::CSS::AnchorSizeStyleValue::anchor_size.
pub func css_anchor_size_style_value_anchor_size(this: CssAnchorSizeStyleValue*) -> css_data.AnchorSize?:
    return this.m_properties.anchor_size

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorSizeStyleValue.h:31 Web::CSS::AnchorSizeStyleValue::fallback_value.
pub func css_anchor_size_style_value_fallback_value(this: CssAnchorSizeStyleValue*) -> CssStyleValue*?:
    return this.m_properties.fallback_value
