# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:20 Web::CSS::ConicGradientStyleValue::create.
pub func css_conic_gradient_style_value_create(from_angle: CssStyleValue*?, position: CssPositionStyleValue*, color_stop_list: ak.Vector[CssColorStopListElement], repeating: CssGradientRepeating, color_interpolation_method: CssStyleValue*?) -> CssConicGradientStyleValue*:
    assert(not ak.vector_is_empty(&color_stop_list))
    let any_non_legacy = css_color_stop_list_has_non_legacy_color(&color_stop_list)
    let this = &(alloc CssConicGradientStyleValue[1] else trap("out of memory"))[0]
    css_conic_gradient_style_value_construct(this, from_angle, position, color_stop_list, repeating, color_interpolation_method, CssColorSyntax.modern if any_non_legacy else CssColorSyntax.legacy)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:59 Web::CSS::ConicGradientStyleValue::ConicGradientStyleValue.
pub func css_conic_gradient_style_value_construct(this: CssConicGradientStyleValue*, from_angle: CssStyleValue*?, position: CssPositionStyleValue*, color_stop_list: ak.Vector[CssColorStopListElement], repeating: CssGradientRepeating, color_interpolation_method: CssStyleValue*?, color_syntax: CssColorSyntax):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.conic_gradient)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_conic_gradient_style_value_vtable, &css_conic_gradient_style_value_class)
    this.m_properties = CssConicGradientStyleValueProperties(from_angle = from_angle, position = position, color_stop_list = color_stop_list, repeating = repeating, color_interpolation_method = color_interpolation_method, color_syntax = color_syntax)
    this.m_resolved_data_cache_key = none
    this.m_resolved = none

# mark: Serialization and equality ==============================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:18 Web::CSS::ConicGradientStyleValue::serialize (override).
pub func css_conic_gradient_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssConicGradientStyleValue*)base
    if css_conic_gradient_style_value_is_repeating(this):
        ak.string_builder_append(builder, "repeating-")
    ak.string_builder_append(builder, "conic-gradient(")
    let has_from_angle = this.m_properties.from_angle != none
    let has_at_position = not css_position_style_value_is_center(this.m_properties.position, mode)
    var has_color_space = false
    if let method = this.m_properties.color_interpolation_method:
        has_color_space = css_color_interpolation_method_style_value_color_interpolation_method(css_style_value_as_color_interpolation_method(method)) != css_color_interpolation_method_style_value_default_color_interpolation_method(this.m_properties.color_syntax)

    if let from_angle = this.m_properties.from_angle:
        ak.string_builder_append(builder, "from ")
        css_style_value_serialize(from_angle, builder, mode)
    if has_at_position:
        if has_from_angle:
            ak.string_builder_append_u8(builder, ' ')
        ak.string_builder_append(builder, "at ")
        css_style_value_serialize(this.m_properties.position.css_style_value(), builder, mode)
    if has_color_space:
        if has_from_angle or has_at_position:
            ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(this.m_properties.color_interpolation_method else trap("VERIFY_NOT_REACHED"), builder, mode)
    if has_from_angle or has_at_position or has_color_space:
        ak.string_builder_append(builder, ", ")
    css_serialize_color_stop_list(builder, this.m_properties.color_stop_list, mode)
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:69 Web::CSS::ConicGradientStyleValue::absolutized (override).
pub func css_conic_gradient_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssConicGradientStyleValue*)base
    let absolutized_color_stops = css_color_stop_list_absolutized(&this.m_properties.color_stop_list, context)
    var absolutized_from_angle: CssStyleValue*? = none
    if let from_angle = this.m_properties.from_angle:
        absolutized_from_angle = css_style_value_absolutized(from_angle, context)
    let absolutized_position = css_style_value_as_position(css_style_value_absolutized(this.m_properties.position.css_style_value(), context))

    var absolutized_color_interpolation_method: CssStyleValue*? = none
    if let method = this.m_properties.color_interpolation_method:
        absolutized_color_interpolation_method = css_style_value_absolutized(method, context)

    return css_conic_gradient_style_value_create(absolutized_from_angle, absolutized_position, absolutized_color_stops, this.m_properties.repeating, absolutized_color_interpolation_method).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:86 Web::CSS::ConicGradientStyleValue::equals (override).
pub func css_conic_gradient_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssConicGradientStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_gradient = css_style_value_as_conic_gradient(other)
    # NB: Properties::operator== is defaulted.
    let a = &this.m_properties
    let b = &other_gradient.m_properties
    return css_optional_style_values_equal(a.from_angle, b.from_angle) and css_style_values_equal(a.position.css_style_value(), b.position.css_style_value()) and css_color_stop_lists_equal(&a.color_stop_list, &b.color_stop_list) and a.repeating == b.repeating and css_optional_style_values_equal(a.color_interpolation_method, b.color_interpolation_method) and a.color_syntax == b.color_syntax

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:94 Web::CSS::ConicGradientStyleValue::is_computationally_independent (override).
pub func css_conic_gradient_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssConicGradientStyleValue*)base
    if not css_is_null_or_computationally_independent(this.m_properties.from_angle):
        return false
    if not css_style_value_is_computationally_independent(this.m_properties.position.css_style_value()):
        return false
    for color_stop in ak.vector_span_const(&this.m_properties.color_stop_list):
        if not css_color_stop_list_element_is_computationally_independent(&color_stop):
            return false
    return css_is_null_or_computationally_independent(this.m_properties.color_interpolation_method)

# mark: Accessors ===============================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:35 Web::CSS::ConicGradientStyleValue::color_stop_list.
pub func css_conic_gradient_style_value_color_stop_list(this: CssConicGradientStyleValue*) -> ak.Vector[CssColorStopListElement]:
    return this.m_properties.color_stop_list

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:40 Web::CSS::ConicGradientStyleValue::interpolation_method.
pub func css_conic_gradient_style_value_interpolation_method(this: CssConicGradientStyleValue*) -> display_list.ColorInterpolationMethod:
    if let method = this.m_properties.color_interpolation_method:
        return css_color_interpolation_method_style_value_color_interpolation_method(css_style_value_as_color_interpolation_method(method))
    return css_color_interpolation_method_style_value_default_color_interpolation_method(this.m_properties.color_syntax)

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:102 Web::CSS::ConicGradientStyleValue::angle_degrees.
pub func css_conic_gradient_style_value_angle_degrees(this: CssConicGradientStyleValue*) -> f32:
    let from_angle = this.m_properties.from_angle else return 0.0
    let angle = css_angle_from_style_value(from_angle, none)
    return (f32)css_angle_to_degrees(&angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:56 Web::CSS::ConicGradientStyleValue::is_repeating.
pub func css_conic_gradient_style_value_is_repeating(this: CssConicGradientStyleValue*) -> bool:
    return this.m_properties.repeating == CssGradientRepeating.yes

# mark: Painting ================================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.h:50 Web::CSS::ConicGradientStyleValue::is_paintable (override).
pub func css_conic_gradient_style_value_is_paintable_impl(base: CssAbstractImageStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:48 Web::CSS::ConicGradientStyleValue::resolve_for_size (override).
pub func css_conic_gradient_style_value_resolve_for_size_impl(base: CssAbstractImageStyleValue*, node: LayoutNodeWithStyle*, size: gfx.CssPixelSize):
    let this = (CssConicGradientStyleValue*)base
    let cache_key = CssConicGradientStyleValueResolvedDataCacheKey(length_resolution_context = css_length_resolution_context_for_layout_node((LayoutNode*)node), size = size)
    if this.m_resolved_data_cache_key != cache_key:
        this.m_resolved_data_cache_key = cache_key
        this.m_resolved = CssConicGradientStyleValueResolvedData(data = paint_resolve_conic_gradient_data(node, this), position = gfx.CssPixelPoint())
    var resolved = this.m_resolved else trap("VERIFY: resolved gradient data")
    var gradient_rect: gfx.CssPixelRect = ---
    gfx.css_pixel_rect_construct_css_pixel_point(&gradient_rect, gfx.CssPixelPoint(), size)
    resolved.position = css_position_style_value_resolved(this.m_properties.position, (LayoutNode*)node, gradient_rect)
    this.m_resolved = resolved

## Ported from Libraries/LibWeb/CSS/StyleValues/ConicGradientStyleValue.cpp:61 Web::CSS::ConicGradientStyleValue::paint (override).
pub func css_conic_gradient_style_value_paint_impl(base: CssAbstractImageStyleValue*, context: DisplayListRecordingContext*, dest_rect: gfx.DevicePixelRect, arg2: css_data.ImageRendering):
    discard(arg2)
    let this = (CssConicGradientStyleValue*)base
    let resolved = this.m_resolved else trap("VERIFY: resolved gradient data")
    let destination_rect = dest_rect
    let position = display_list_recording_context_rounded_device_point(context, resolved.position)
    display_list.display_list_recorder_fill_rect_with_conic_gradient(display_list_recording_context_display_list_recorder(context), destination_rect, resolved.data, position)
