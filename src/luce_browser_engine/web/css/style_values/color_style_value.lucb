# mark: ColorStyleValue =========================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.h:56 Web::CSS::ColorStyleValue::ColorStyleValue.
pub func css_color_style_value_construct(this: CssColorStyleValue*, color_type: CssColorStyleValueColorType?, color_syntax: CssColorSyntax):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.color)
    this.m_color_type = color_type
    this.m_color_syntax = color_syntax

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:22 Web::CSS::ColorStyleValue::create_from_color.
pub func css_color_style_value_create_from_color(color: gfx.Color, color_syntax: CssColorSyntax, name: ak.FlyString? = none) -> CssColorStyleValue*:
    return css_color_function_style_value_create(
        CssColorStyleValueColorType.rgb,
        css_number_style_value_create((f64)gfx.color_red(&color)).css_style_value(),
        css_number_style_value_create((f64)gfx.color_green(&color)).css_style_value(),
        css_number_style_value_create((f64)gfx.color_blue(&color)).css_style_value(),
        css_number_style_value_create((f64)gfx.color_alpha(&color) / 255.0).css_style_value(),
        color_syntax,
        name,
    ).css_color_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.h:28 Web::CSS::ColorStyleValue::has_color (override).
pub func css_color_style_value_has_color_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.h:48 Web::CSS::ColorStyleValue::color_type.
pub func css_color_style_value_color_type(this: CssColorStyleValue*) -> CssColorStyleValueColorType?:
    return this.m_color_type

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.h:49 Web::CSS::ColorStyleValue::color_syntax.
pub func css_color_style_value_color_syntax(this: CssColorStyleValue*) -> CssColorSyntax:
    return this.m_color_syntax

# mark: Resolving channels ======================================================================

## The `normalized` lambda of ColorStyleValue::resolve_hue.
func css_color_style_value_normalized_hue(value: f64) -> f64:
    var number = value
    # +inf should be clamped to 360
    if not math.is_finite(number) and number > 0.0:
        number = 360.0

    # -inf and NaN should be clamped to 0
    if not math.is_finite(number) or math.is_nan(number):
        number = 0.0

    return js_modulo(number, 360.0)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:34 Web::CSS::ColorStyleValue::resolve_hue.
pub func css_color_style_value_resolve_hue(style_value: CssStyleValue*, resolution_context: CssCalculationResolutionContext) -> f64?:
    # <number> | <angle> | none
    if css_style_value_is_number(style_value):
        return css_color_style_value_normalized_hue(css_number_style_value_number(css_style_value_as_number(style_value)))

    if css_style_value_is_angle(style_value):
        let angle = css_angle_style_value_angle(css_style_value_as_angle(style_value))
        return css_color_style_value_normalized_hue(css_angle_to_degrees(&angle))

    if css_style_value_is_calculated(style_value):
        let calculated = css_style_value_as_calculated(style_value)
        if css_calculated_style_value_resolves_to_number(calculated):
            let maybe_number = css_calculated_style_value_resolve_number(calculated, resolution_context) else return none

            return css_color_style_value_normalized_hue(maybe_number)

        if css_calculated_style_value_resolves_to_angle(calculated):
            let maybe_angle = css_calculated_style_value_resolve_angle(calculated, resolution_context) else return none

            return css_color_style_value_normalized_hue(css_angle_to_degrees(&maybe_angle))

    return 0.0

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:78 Web::CSS::ColorStyleValue::resolve_with_reference_value.
pub func css_color_style_value_resolve_with_reference_value(style_value: CssStyleValue*, one_hundred_percent_value: f32, resolution_context: CssCalculationResolutionContext) -> f64?:
    # <percentage> | <number> | none
    # NB: The `normalize_percentage` lambda is `percentage.as_fraction() * one_hundred_percent_value`.
    if css_style_value_is_percentage(style_value):
        let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(style_value))
        return css_percentage_as_fraction(&percentage) * (f64)one_hundred_percent_value

    if css_style_value_is_number(style_value):
        return css_number_style_value_number(css_style_value_as_number(style_value))

    if css_style_value_is_calculated(style_value):
        let calculated = css_style_value_as_calculated(style_value)
        if css_calculated_style_value_resolves_to_number(calculated):
            let maybe_number = css_calculated_style_value_resolve_number(calculated, resolution_context) else return none

            return maybe_number

        if css_calculated_style_value_resolves_to_percentage(calculated):
            let percentage = css_calculated_style_value_resolve_percentage(calculated, resolution_context) else return none

            return css_percentage_as_fraction(&percentage) * (f64)one_hundred_percent_value

    return 0.0

## The `normalized` lambda of ColorStyleValue::resolve_alpha.
func css_color_style_value_normalized_alpha(value: f64) -> f64:
    var number = value
    if math.is_nan(number):
        number = 0.0
    return ak.clamp_f64(number, 0.0, 1.0)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:115 Web::CSS::ColorStyleValue::resolve_alpha.
pub func css_color_style_value_resolve_alpha(style_value: CssStyleValue*, resolution_context: CssCalculationResolutionContext) -> f64?:
    # <number> | <percentage> | none
    if css_style_value_is_number(style_value):
        return css_color_style_value_normalized_alpha(css_number_style_value_number(css_style_value_as_number(style_value)))

    if css_style_value_is_percentage(style_value):
        let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(style_value))
        return css_color_style_value_normalized_alpha(css_percentage_as_fraction(&percentage))

    if css_style_value_is_calculated(style_value):
        let calculated = css_style_value_as_calculated(style_value)
        if css_calculated_style_value_resolves_to_number(calculated):
            let maybe_number = css_calculated_style_value_resolve_number(calculated, resolution_context) else return none

            return css_color_style_value_normalized_alpha(maybe_number)

        if css_calculated_style_value_resolves_to_percentage(calculated):
            let percentage = css_calculated_style_value_resolve_percentage(calculated, resolution_context) else return none

            return css_color_style_value_normalized_alpha(css_percentage_as_fraction(&percentage))

    if css_style_value_is_keyword(style_value) and css_style_value_to_keyword(style_value) == css_data.Keyword.none_:
        return 0.0

    return 1.0

# mark: Serializing components ==================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:157 Web::CSS::ColorStyleValue::serialize_color_component.
pub func css_color_style_value_serialize_color_component(this: CssColorStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode, component: CssStyleValue*, one_hundred_percent_value: f32, clamp_min: f64? = none, clamp_max: f64? = none):
    discard(this)
    if css_style_value_to_keyword(component) == css_data.Keyword.none_:
        ak.string_builder_append(builder, "none")
        return
    if css_style_value_is_calculated(component) and mode == css_syntax.SerializationMode.normal:
        css_style_value_serialize(component, builder, mode)
        return

    let maybe_resolved_value = css_color_style_value_resolve_with_reference_value(component, one_hundred_percent_value, CssCalculationResolutionContext())

    if maybe_resolved_value == none:
        css_style_value_serialize(component, builder, mode)
        return

    var resolved_value = maybe_resolved_value else trap("VERIFY_NOT_REACHED")

    if let minimum = clamp_min:
        if resolved_value < minimum:
            resolved_value = minimum
    if let maximum = clamp_max:
        if resolved_value > maximum:
            resolved_value = maximum

    css_syntax.serialize_a_number_string_builder(builder, resolved_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:185 Web::CSS::ColorStyleValue::serialize_alpha_component.
pub func css_color_style_value_serialize_alpha_component(this: CssColorStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode, component: CssStyleValue*):
    discard(this)
    if css_style_value_to_keyword(component) == css_data.Keyword.none_:
        ak.string_builder_append(builder, "none")
        return
    if css_style_value_is_calculated(component) and mode == css_syntax.SerializationMode.normal:
        css_style_value_serialize(component, builder, mode)
        return

    let maybe_resolved_value = css_color_style_value_resolve_alpha(component, CssCalculationResolutionContext())

    if let resolved_value = maybe_resolved_value:
        css_syntax.serialize_a_number_string_builder(builder, resolved_value)
        return

    css_style_value_serialize(component, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorStyleValue.cpp:206 Web::CSS::ColorStyleValue::serialize_hue_component.
pub func css_color_style_value_serialize_hue_component(this: CssColorStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode, component: CssStyleValue*):
    discard(this)
    if css_style_value_to_keyword(component) == css_data.Keyword.none_:
        ak.string_builder_append(builder, "none")
        return
    if css_style_value_is_calculated(component) and mode == css_syntax.SerializationMode.normal:
        css_style_value_serialize(component, builder, mode)
        return

    let maybe_resolved_value = css_color_style_value_resolve_hue(component, CssCalculationResolutionContext())

    if let resolved_value = maybe_resolved_value:
        css_appendff(builder, "{:.4}", [ak.arg_f64(resolved_value)])
        return

    css_style_value_serialize(component, builder, mode)
