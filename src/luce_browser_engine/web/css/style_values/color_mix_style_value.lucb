# mark: Creation and equality ===================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:17 Web::CSS::ColorMixStyleValue::create.
pub func css_color_mix_style_value_create(color_interpolation_method: CssStyleValue*?, first_component: CssColorMixStyleValueColorMixComponent, second_component: CssColorMixStyleValueColorMixComponent) -> CssColorMixStyleValue*:
    let this = &(alloc CssColorMixStyleValue[1] else trap("out of memory"))[0]
    css_color_mix_style_value_construct(this, color_interpolation_method, first_component, second_component)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:22 Web::CSS::ColorMixStyleValue::ColorMixStyleValue.
pub func css_color_mix_style_value_construct(this: CssColorMixStyleValue*, color_interpolation_method: CssStyleValue*?, first_component: CssColorMixStyleValueColorMixComponent, second_component: CssColorMixStyleValueColorMixComponent):
    css_color_style_value_construct(this.css_color_style_value(), none, CssColorSyntax.modern)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_color_mix_style_value_vtable, &css_color_mix_style_value_class)
    this.m_properties = CssColorMixStyleValueProperties(color_interpolation_method = color_interpolation_method, first_component = first_component, second_component = second_component)

## `ColorMixComponent::operator==(...) const = default` (ColorMixStyleValue.h:26).
pub func css_color_mix_style_value_color_mix_component_eq(this: const CssColorMixStyleValueColorMixComponent*, other: const CssColorMixStyleValueColorMixComponent*) -> bool:
    return css_style_values_equal(this.color, other.color) and css_optional_style_values_equal(this.percentage, other.percentage)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:32 Web::CSS::ColorMixStyleValue::equals (override).
pub func css_color_mix_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssColorMixStyleValue*)base
    let other_color_mix = as_if_css_color_mix_style_value(other) else return false
    # NB: Properties::operator== is defaulted.
    return (css_optional_style_values_equal(this.m_properties.color_interpolation_method, other_color_mix.m_properties.color_interpolation_method) and css_color_mix_style_value_color_mix_component_eq(&this.m_properties.first_component, &other_color_mix.m_properties.first_component) and css_color_mix_style_value_color_mix_component_eq(&this.m_properties.second_component, &other_color_mix.m_properties.second_component))

# mark: Serialization ===========================================================================

## `p->is_percentage() && p->as_percentage().percentage().value() == number`, for the lambdas of serialize.
func css_color_mix_is_percentage_of(value: CssStyleValue*, number: f64) -> bool:
    if not css_style_value_is_percentage(value):
        return false
    let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(value))
    return css_percentage_value(&percentage) == number

## The `serialize_first_percentage` lambda of ColorMixStyleValue::serialize.
func css_color_mix_serialize_first_percentage(builder: ak.StringBuilder*, mode: css_syntax.SerializationMode, p1: CssStyleValue*?, p2: CssStyleValue*?):
    # if BOTH the first percentage p1 and second percentage p2 are specified:
    if p1 != none and p2 != none:
        let first = p1 else trap("VERIFY_NOT_REACHED")
        let second = p2 else trap("VERIFY_NOT_REACHED")
        # If both p1 equals 50% and p2 equals 50%, nothing is serialized.
        if css_color_mix_is_percentage_of(first, 50.0) and css_color_mix_is_percentage_of(second, 50.0):
            return

        # else, p1 is serialized as is.
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(first, builder, mode)
    # else if ONLY the first percentage p1 is specified:
    elif let first = p1:
        # If p1 is equal to 50%, nothing is serialized.
        if css_color_mix_is_percentage_of(first, 50.0):
            return

        # else, p1 is serialized as is.
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(first, builder, mode)
    # else if ONLY the second percentage p2 is specified:
    elif let second = p2:
        # if p2 equals 50%, nothing is serialized.
        if css_color_mix_is_percentage_of(second, 50.0):
            return

        # if p2 is not calc(), the value of 100% - p2 is serialized.
        if not css_style_value_is_calculated(second):
            let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(second))
            css_appendff(builder, " {}%", [ak.arg_f64(100.0 - css_percentage_value(&percentage))])

        # else, nothing is serialized.
    # else if NEITHER is specified:
    else:
        # nothing is serialized.
        return

## The `serialize_second_percentage` lambda of ColorMixStyleValue::serialize.
func css_color_mix_serialize_second_percentage(builder: ak.StringBuilder*, mode: css_syntax.SerializationMode, p1: CssStyleValue*?, p2: CssStyleValue*?):
    # If BOTH the first percentage p1 and second percentages p2 are specified:
    if p1 != none and p2 != none:
        let first = p1 else trap("VERIFY_NOT_REACHED")
        let second = p2 else trap("VERIFY_NOT_REACHED")
        # if neither p1 nor p2 is calc(), and p1 + p2 equals 100%, nothing is serialized.
        if css_style_value_is_percentage(first) and css_style_value_is_percentage(second):
            let first_percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(first))
            let second_percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(second))
            if css_percentage_value(&first_percentage) + css_percentage_value(&second_percentage) == 100.0:
                return

        # else, p2 is serialized as is.
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(second, builder, mode)
    # else if ONLY the first percentage p1 is specified:
    elif p1 != none:
        # nothing is serialized.
        return
    # else if ONLY the second percentage p2 is specified:
    elif let second = p2:
        # if p2 equals 50%, nothing is serialized.
        if css_color_mix_is_percentage_of(second, 50.0):
            return

        # if p2 is not calc(), nothing is serialized.
        if not css_style_value_is_calculated(second):
            return

        # else, p2 is serialized as is.
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(second, builder, mode)
    # else if NEITHER is specified:
    else:
        # nothing is serialized.
        return

# https://drafts.csswg.org/css-color-5/#serial-color-mix
## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:41 Web::CSS::ColorMixStyleValue::serialize (override).
pub func css_color_mix_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssColorMixStyleValue*)base
    ak.string_builder_append(builder, "color-mix(")

    if let method = this.m_properties.color_interpolation_method:
        let oklab: display_list.ColorInterpolationMethod = .rectangular_color_space(css_data.RectangularColorSpace.oklab)
        if css_color_interpolation_method_style_value_color_interpolation_method(css_style_value_as_color_interpolation_method(method)) != oklab:
            css_style_value_serialize(method, builder, mode)
            ak.string_builder_append(builder, ", ")

    css_style_value_serialize(this.m_properties.first_component.color, builder, mode)
    css_color_mix_serialize_first_percentage(builder, mode, this.m_properties.first_component.percentage, this.m_properties.second_component.percentage)
    ak.string_builder_append(builder, ", ")
    css_style_value_serialize(this.m_properties.second_component.color, builder, mode)
    css_color_mix_serialize_second_percentage(builder, mode, this.m_properties.first_component.percentage, this.m_properties.second_component.percentage)
    ak.string_builder_append_u8(builder, ')')

# mark: Mixing ==================================================================================

# https://drafts.csswg.org/css-color-5/#color-mix-percent-norm
## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:133 Web::CSS::ColorMixStyleValue::normalize_percentage_pair.
pub func css_color_mix_style_value_normalize_percentage_pair(p1_in: CssPercentage?, p2_in: CssPercentage?) -> CssColorMixStyleValueNormalizedPercentages:
    var p1 = p1_in
    var p2 = p2_in
    var alpha_multiplier = 1.0

    # 1. Let p1 be the first percentage and p2 the second one.
    # NB: Provided by the caller.

    # 2. If both percentages are omitted, they each default to 50% (an equal mix of the two colors).
    if p1 == none and p2 == none:
        p1 = css_percentage_new(50.0)
        p2 = css_percentage_new(50.0)
    # 3. Otherwise, if p2 is omitted, it becomes 100% - p1
    elif p2 == none:
        let first = p1 else trap("VERIFY_NOT_REACHED")
        p2 = css_percentage_new(100.0 - css_percentage_value(&first))
    # 4. Otherwise, if p1 is omitted, it becomes 100% - p2
    elif p1 == none:
        let second = p2 else trap("VERIFY_NOT_REACHED")
        p1 = css_percentage_new(100.0 - css_percentage_value(&second))
    else:
        let first = p1 else trap("VERIFY_NOT_REACHED")
        let second = p2 else trap("VERIFY_NOT_REACHED")
        let first_value = css_percentage_value(&first)
        let second_value = css_percentage_value(&second)
        # 5. Otherwise, if both are provided and add up to greater than 100%, they are scaled accordingly so that they add up to 100%.
        if first_value + second_value > 100.0:
            let sum = first_value + second_value
            p1 = css_percentage_new((first_value / sum) * 100.0)
            p2 = css_percentage_new((second_value / sum) * 100.0)
        # 6. Otherwise, if both are provided and add up to less than 100%, the sum is saved as an alpha multiplier. If the sum is greater than zero, they are then scaled accordingly so that they add up to 100%.
        elif first_value + second_value < 100.0:
            let sum = first_value + second_value
            alpha_multiplier = sum / 100.0
            if sum > 0.0:
                p1 = css_percentage_new((first_value / sum) * 100.0)
                p2 = css_percentage_new((second_value / sum) * 100.0)

    let first_percentage = p1 else trap("VERIFY: p1.has_value()")
    let second_percentage = p2 else trap("VERIFY: p2.has_value()")

    return CssColorMixStyleValueNormalizedPercentages(first_percentage = first_percentage, second_percentage = second_percentage, alpha_multiplier = alpha_multiplier)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:175 Web::CSS::ColorMixStyleValue::normalize_percentages.
pub func css_color_mix_style_value_normalize_percentages(this: CssColorMixStyleValue*, computation_context: CssComputationContext) -> CssColorMixStyleValuePercentageNormalizationResult:
    var p1: CssPercentage? = none
    if let percentage = this.m_properties.first_component.percentage:
        p1 = css_percentage_from_style_value(css_style_value_absolutized(percentage, computation_context))
    var p2: CssPercentage? = none
    if let percentage = this.m_properties.second_component.percentage:
        p2 = css_percentage_from_style_value(css_style_value_absolutized(percentage, computation_context))

    let result = css_color_mix_style_value_normalize_percentage_pair(p1, p2)
    return CssColorMixStyleValuePercentageNormalizationResult(
        p1 = css_percentage_style_value_create(result.first_percentage).css_style_value(),
        p2 = css_percentage_style_value_create(result.second_percentage).css_style_value(),
        alpha_multiplier = result.alpha_multiplier,
    )

# https://drafts.csswg.org/css-color-5/#color-mix-result
## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:193 Web::CSS::ColorMixStyleValue::to_color (override).
pub func css_color_mix_style_value_to_color_impl(base: CssStyleValue*, color_resolution_context: CssColorResolutionContext) -> gfx.Color?:
    let this = (CssColorMixStyleValue*)base
    var p1: CssPercentage? = none
    if let percentage = this.m_properties.first_component.percentage:
        p1 = css_percentage_from_style_value(percentage)
    var p2: CssPercentage? = none
    if let percentage = this.m_properties.second_component.percentage:
        p2 = css_percentage_from_style_value(percentage)
    let normalized = css_color_mix_style_value_normalize_percentage_pair(p1, p2)

    var color_interpolation_method: display_list.ColorInterpolationMethod = .rectangular_color_space(css_data.RectangularColorSpace.oklab)
    if let method = this.m_properties.color_interpolation_method:
        color_interpolation_method = css_color_interpolation_method_style_value_color_interpolation_method(css_style_value_as_color_interpolation_method(method))

    var interpolated = css_perform_color_interpolation(this.m_properties.first_component.color, this.m_properties.second_component.color, (f32)css_percentage_as_fraction(&normalized.second_percentage), color_interpolation_method, color_resolution_context) else return none

    if normalized.alpha_multiplier < 1.0:
        gfx.color_components_set_alpha(&interpolated.components, (f32)((f64)gfx.color_components_alpha(&interpolated.components) * normalized.alpha_multiplier))

    let style_value = css_style_value_for_interpolated_color(interpolated) else return none

    return css_style_value_to_color(style_value, color_resolution_context)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.cpp:221 Web::CSS::ColorMixStyleValue::absolutized (override).
pub func css_color_mix_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssColorMixStyleValue*)base
    # FIXME: Follow the spec algorithm. https://drafts.csswg.org/css-color-5/#calculate-a-color-mix

    let normalized_percentages = css_color_mix_style_value_normalize_percentages(this, context)
    var document: DomDocument*? = none
    if let abstract_element = context.abstract_element:
        document = dom_abstract_element_document(&abstract_element)
    let color_resolution_context = CssColorResolutionContext(
        color_scheme = context.color_scheme,
        current_color = none,
        accent_color = none,
        document = document,
        calculation_resolution_context = css_calculation_resolution_context_from_computation_context(context),
    )
    var absolutized_color_interpolation_method: CssStyleValue*? = none
    if let method = this.m_properties.color_interpolation_method:
        absolutized_color_interpolation_method = css_style_value_absolutized(method, context)

    let p2_percentage = css_percentage_from_style_value(normalized_percentages.p2)
    let delta = css_percentage_as_fraction(&p2_percentage)

    var color_interpolation_method: display_list.ColorInterpolationMethod = .rectangular_color_space(css_data.RectangularColorSpace.oklab)
    if let method = absolutized_color_interpolation_method:
        color_interpolation_method = css_color_interpolation_method_style_value_color_interpolation_method(css_style_value_as_color_interpolation_method(method))

    if let maybe_interpolated = css_perform_color_interpolation(this.m_properties.first_component.color, this.m_properties.second_component.color, (f32)delta, color_interpolation_method, color_resolution_context):
        var interpolated = maybe_interpolated
        if normalized_percentages.alpha_multiplier < 1.0:
            gfx.color_components_set_alpha(&interpolated.components, (f32)((f64)gfx.color_components_alpha(&interpolated.components) * normalized_percentages.alpha_multiplier))
        if let style_value = css_style_value_for_interpolated_color(interpolated):
            return style_value

    # Fall back to returning a color-mix() with absolutized values if we can't compute completely.
    # Currently, this is only the case if one of our colors relies on `currentcolor`, as that does not compute to a color value.
    let absolutized_first_color = css_style_value_absolutized(this.m_properties.first_component.color, context)
    let absolutized_second_color = css_style_value_absolutized(this.m_properties.second_component.color, context)
    if css_style_values_equal(absolutized_first_color, this.m_properties.first_component.color) and css_optional_style_values_equal(normalized_percentages.p1, this.m_properties.first_component.percentage) and css_style_values_equal(absolutized_second_color, this.m_properties.second_component.color) and css_optional_style_values_equal(normalized_percentages.p2, this.m_properties.second_component.percentage):
        return base

    return css_color_mix_style_value_create(
        absolutized_color_interpolation_method,
        CssColorMixStyleValueColorMixComponent(color = absolutized_first_color, percentage = normalized_percentages.p1),
        CssColorMixStyleValueColorMixComponent(color = absolutized_second_color, percentage = normalized_percentages.p2),
    ).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorMixStyleValue.h:31 Web::CSS::ColorMixStyleValue::is_computationally_independent (override).
pub func css_color_mix_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssColorMixStyleValue*)base
    return css_is_null_or_computationally_independent(this.m_properties.color_interpolation_method) and css_style_value_is_computationally_independent(this.m_properties.first_component.color) and css_style_value_is_computationally_independent(this.m_properties.second_component.color) and css_is_null_or_computationally_independent(this.m_properties.first_component.percentage) and css_is_null_or_computationally_independent(this.m_properties.second_component.percentage)
