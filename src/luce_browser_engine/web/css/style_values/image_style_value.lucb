# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:27 Web::CSS::ImageStyleValue::create.
pub func css_image_style_value_create_css_url(url: CssUrl) -> CssImageStyleValue*:
    let this = &(alloc CssImageStyleValue[1] else trap("out of memory"))[0]
    css_image_style_value_construct(this, url)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:32 Web::CSS::ImageStyleValue::create.
pub func css_image_style_value_create_url(url: web_url.Url) -> CssImageStyleValue*:
    var css_url: CssUrl = ---
    css_url_construct(&css_url, web_url.url_to_string(&url), CssUrlType.url, ak.Vector[CssRequestUrlModifier]())
    let this = &(alloc CssImageStyleValue[1] else trap("out of memory"))[0]
    css_image_style_value_construct(this, css_url)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:37 Web::CSS::ImageStyleValue::ImageStyleValue.
pub func css_image_style_value_construct(this: CssImageStyleValue*, url: CssUrl):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.image)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_image_style_value_vtable, &css_image_style_value_class)
    this.on_animate = ak.Function0[unit](call = none, context = none)
    this.m_resource_request = none
    this.m_style_sheet = none
    this.m_url = url
    this.m_document = gc.Weak[DomDocument]()
    this.m_current_frame_index = 0
    this.m_loops_completed = 0
    this.m_timer = none
    this.m_clients = ak.HashTable[CssImageStyleValueClient*?, ak.PtrTraits[CssImageStyleValueClient]]()

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:45 Web::CSS::ImageStyleValue::visit_edges (override).
pub func css_image_style_value_visit_edges_impl(base: CssStyleValue*, visitor: gc.CellVisitor*):
    let this = (CssImageStyleValue*)base
    css_style_value_visit_edges_impl(base, visitor)
    # FIXME: visit_edges in non-GC allocated classes is confusing pattern.
    #        Consider making StyleValue to be GC allocated instead.
    gc.cell_visitor_visit_t(visitor, this.m_resource_request)
    gc.cell_visitor_visit_t(visitor, this.m_style_sheet)
    gc.cell_visitor_visit_t(visitor, this.m_timer)

# mark: Loading and animation ===================================================================

## The captures of the `weak_callback(*this, ...)` ImageStyleValue::load_any_resources gives the resource
## request: a Weak to the value's blob (r37's css_weak_image_style_value, DESIGN.md §3.3).
struct CssImageStyleValueLoadCallback:
    var weak_this: gc.Weak[CssImageStyleValue]

## The lambda of ImageStyleValue::load_any_resources run when the image has loaded.
func css_image_style_value_load_callback_run(context: void*?):
    let captures = (CssImageStyleValueLoadCallback*)(context else trap("VERIFY: captures"))
    let this = css_weak_image_style_value_ptr(&captures.weak_this) else return
    let document = gc.weak_ptr(&this.m_document) else return

    for client in ak.hash_table_begin(&this.m_clients):
        css_image_style_value_client_image_style_value_did_update(*client else continue, this)

    let request = this.m_resource_request else trap("VERIFY: a resource request")
    let image_data = html_shared_resource_request_image_data(request) else trap("VERIFY: image data")
    if html_decoded_image_data_is_animated(image_data) and html_decoded_image_data_frame_count(image_data) > 1:
        let heap = gc.cell_heap(document.cell())
        let timer = platform_timer_create(heap)
        this.m_timer = timer
        platform_timer_set_interval(timer, html_decoded_image_data_frame_duration(image_data, 0))
        timer.on_timeout = gc.create_function0(heap, ak.Function0[unit](call = css_image_style_value_animate_callback, context = this))
        platform_timer_start(timer)

## `[ptr = &self] { ptr->animate(); }`, the timer's timeout.
func css_image_style_value_animate_callback(context: void*?):
    css_image_style_value_animate((CssImageStyleValue*)(context else trap("VERIFY: captures")))

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:55 Web::CSS::ImageStyleValue::load_any_resources (override).
pub func css_image_style_value_load_any_resources_dom_document_impl(base: CssAbstractImageStyleValue*, document: DomDocument*):
    let this = (CssImageStyleValue*)base
    if this.m_resource_request != none:
        return
    gc.weak_assign(&this.m_document, document)

    let rule_or_declaration = CssRuleOrDeclaration(
        environment_settings_object = dom_document_relevant_settings_object(document),
        value = .css_rule_or_declaration_rule(CssRuleOrDeclarationRule(parent_style_sheet = this.m_style_sheet)),
    )

    var fetch_document = document
    if let style_sheet = this.m_style_sheet:
        fetch_document = css_css_style_sheet_owning_document(style_sheet) else trap("VERIFY: the style sheet's owning document")
    this.m_resource_request = css_fetch_an_external_image_for_a_stylesheet(.css_url(this.m_url), rule_or_declaration, fetch_document)

    if let request = this.m_resource_request:
        let captures = new CssImageStyleValueLoadCallback(weak_this = css_weak_image_style_value(this)) else trap("out of memory")
        html_shared_resource_request_add_callbacks(request, ak.Function0[unit](call = css_image_style_value_load_callback_run, context = captures), ak.Function0[unit](call = none, context = none))

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:91 Web::CSS::ImageStyleValue::animate.
pub func css_image_style_value_animate(this: CssImageStyleValue*):
    let request = this.m_resource_request else return
    let image_data = html_shared_resource_request_image_data(request) else return

    this.m_current_frame_index = (this.m_current_frame_index + 1) % html_decoded_image_data_frame_count(image_data)
    this.m_current_frame_index = html_decoded_image_data_notify_frame_advanced(image_data, this.m_current_frame_index)
    let current_frame_duration = html_decoded_image_data_frame_duration(image_data, this.m_current_frame_index)

    let timer = this.m_timer else trap("VERIFY: an animation timer")
    if current_frame_duration != platform_timer_interval(timer):
        platform_timer_restart_i32(timer, current_frame_duration)

    if this.m_current_frame_index == html_decoded_image_data_frame_count(image_data) - 1:
        this.m_loops_completed += 1
        if this.m_loops_completed > 0 and this.m_loops_completed == html_decoded_image_data_loop_count(image_data):
            platform_timer_stop(timer)

    if ak.function0_is_set(&this.on_animate):
        ak.function0_call(&this.on_animate)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:116 Web::CSS::ImageStyleValue::is_paintable (override).
pub func css_image_style_value_is_paintable_impl(base: CssAbstractImageStyleValue*) -> bool:
    return css_image_style_value_image_data((CssImageStyleValue*)base) != none

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:121 Web::CSS::ImageStyleValue::bitmap.
pub func css_image_style_value_bitmap(this: CssImageStyleValue*, frame_index: usize, size: gfx.IntSize = gfx.IntSize()) -> const gfx.ImmutableBitmap*?:
    if let image_data = css_image_style_value_image_data(this):
        return html_decoded_image_data_bitmap(image_data, frame_index, size)
    return none

# mark: Serialization and equality ==============================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:128 Web::CSS::ImageStyleValue::serialize (override).
pub func css_image_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssImageStyleValue*)base
    let string = css_url_to_string(&this.m_url)
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&string))

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:133 Web::CSS::ImageStyleValue::equals (override).
pub func css_image_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssImageStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_url_eq(&this.m_url, css_style_value_as_image(other).m_url)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.h:48 Web::CSS::ImageStyleValue::is_computationally_independent (override).
pub func css_image_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

