pub func css_image_style_value_natural_height_impl(base: CssAbstractImageStyleValue*) -> gfx.CssPixels?:
    if let image_data = css_image_style_value_image_data((CssImageStyleValue*)base):
        return html_decoded_image_data_intrinsic_height(image_data)
