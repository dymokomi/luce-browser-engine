## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:154 Web::CSS::ImageStyleValue::natural_aspect_ratio (override).
pub func css_image_style_value_natural_aspect_ratio_impl(base: CssAbstractImageStyleValue*) -> gfx.CssPixelFraction?:
    if let image_data = css_image_style_value_image_data((CssImageStyleValue*)base):
