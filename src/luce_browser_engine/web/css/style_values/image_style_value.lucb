    return none

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:161 Web::CSS::ImageStyleValue::paint (override).
pub func css_image_style_value_paint_impl(base: CssAbstractImageStyleValue*, context: DisplayListRecordingContext*, dest_rect: gfx.DevicePixelRect, image_rendering: css_data.ImageRendering):
    let this = (CssImageStyleValue*)base
    let image_data = css_image_style_value_image_data(this) else return

    let dest_int_rect = dest_rect
    let rect = html_decoded_image_data_frame_rect(image_data, this.m_current_frame_index) else dest_int_rect
    let scaling_mode = css_to_gfx_scaling_mode(image_rendering, rect.m_size, dest_int_rect.m_size)
    html_decoded_image_data_paint(image_data, context, this.m_current_frame_index, dest_int_rect, dest_int_rect, scaling_mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:173 Web::CSS::ImageStyleValue::current_frame_bitmap.
pub func css_image_style_value_current_frame_bitmap(this: CssImageStyleValue*, dest_rect: gfx.DevicePixelRect) -> const gfx.ImmutableBitmap*?:
    return css_image_style_value_bitmap(this, this.m_current_frame_index, dest_rect.m_size)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:178 Web::CSS::ImageStyleValue::image_data.
pub func css_image_style_value_image_data(this: CssImageStyleValue*) -> HtmlDecodedImageData*?:
    let request = this.m_resource_request else return none
    return html_shared_resource_request_image_data(request)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:185 Web::CSS::ImageStyleValue::color_if_single_pixel_bitmap (override).
pub func css_image_style_value_color_if_single_pixel_bitmap_impl(base: CssAbstractImageStyleValue*) -> gfx.Color?:
    let this = (CssImageStyleValue*)base
    if let b = css_image_style_value_bitmap(this, this.m_current_frame_index):
        if gfx.immutable_bitmap_width(b) == 1 and gfx.immutable_bitmap_height(b) == 1:
            return gfx.immutable_bitmap_get_pixel(b, 0, 0)
    return none

# mark: Style sheets and absolutization =========================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:194 Web::CSS::ImageStyleValue::set_style_sheet (override).
pub func css_image_style_value_set_style_sheet_impl(base: CssStyleValue*, style_sheet: CssCssStyleSheet*?):
    let this = (CssImageStyleValue*)base
    css_style_value_set_style_sheet_impl(base, style_sheet)
    this.m_style_sheet = style_sheet

    if let sheet = this.m_style_sheet:
        css_css_style_sheet_register_pending_image_value(sheet, this)

## The `base_url` lambda of ImageStyleValue::absolutized.
func css_image_style_value_base_url(this: CssImageStyleValue*) -> web_url.Url?:
    if let style_sheet = this.m_style_sheet:
        if let base_url = css_css_style_sheet_base_url(style_sheet):
            return base_url
        if let location = css_style_sheet_location(style_sheet.css_style_sheet()):
            return location
        return html_environment_settings_object_api_base_url(html_relevant_settings_object_js_object((JsObject*)style_sheet))

    if let document = gc.weak_ptr(&this.m_document):
        return dom_document_base_url(document)

    return none

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:203 Web::CSS::ImageStyleValue::absolutized (override).
pub func css_image_style_value_absolutized_impl(base: CssStyleValue*, arg0: CssComputationContext) -> CssStyleValue*:
    discard(arg0)
    let this = (CssImageStyleValue*)base
    let url_string = css_url_url(&this.m_url)
    if ak.string_is_empty(&url_string):
        return base

    # FIXME: The spec has been updated to handle this better. The computation of the base URL here is roughly based on:
    #        https://drafts.csswg.org/css-values-4/#style-resource-base-url
    #        https://github.com/w3c/csswg-drafts/pull/12261
    let base_url = css_image_style_value_base_url(this)

    if let url_base = base_url:
        if let resolved_url = domurl_parse(ak.string_bytes_as_string_view(&url_string), url_base):
            return css_image_style_value_create_url(resolved_url).css_style_value()

    return base

# mark: Clients =================================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:232 Web::CSS::ImageStyleValue::register_client.
pub func css_image_style_value_register_client(this: CssImageStyleValue*, client: CssImageStyleValueClient*):
    let result = ak.hash_table_set(&this.m_clients, client)
    assert(result == ak.HashSetResult.inserted_new_entry)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:238 Web::CSS::ImageStyleValue::unregister_client.
pub func css_image_style_value_unregister_client(this: CssImageStyleValue*, client: CssImageStyleValueClient*):
    let did_remove = ak.hash_table_remove_t(&this.m_clients, client)
    assert(did_remove)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:244 Web::CSS::ImageStyleValue::Client::Client.
pub func css_image_style_value_client_construct(this: CssImageStyleValueClient*, image_style_value: CssImageStyleValue*):
    this.m_image_style_value = image_style_value
    css_image_style_value_register_client(this.m_image_style_value, this)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.h:31 Web::CSS::ImageStyleValue::Client::image_style_value_did_update (virtual).
pub func css_image_style_value_client_image_style_value_did_update_impl(this: CssImageStyleValueClient*, arg0: CssImageStyleValue*):
    discard(this)
    discard(arg0)
    trap("pure virtual: Web::CSS::ImageStyleValue::Client::image_style_value_did_update")

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:254 Web::CSS::ImageStyleValue::Client::image_style_value_finalize.
pub func css_image_style_value_client_image_style_value_finalize(this: CssImageStyleValueClient*):
    css_image_style_value_unregister_client(this.m_image_style_value, this)
