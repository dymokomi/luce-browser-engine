## Ported from Libraries/LibWeb/CSS/StyleValues/ImageStyleValue.cpp:140 Web::CSS::ImageStyleValue::natural_width (override).
pub func css_image_style_value_natural_width_impl(base: CssAbstractImageStyleValue*) -> gfx.CssPixels?:
    if let image_data = css_image_style_value_image_data((CssImageStyleValue*)base):
        return html_decoded_image_data_intrinsic_width(image_data)
