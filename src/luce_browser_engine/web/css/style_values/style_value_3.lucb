#==============================================================================================
#
#   style_value_3 - StyleValue's per-type casts (ENUMERATE_CSS_STYLE_VALUE_TYPES)
#
#   DESCRIPTION:
#       Port of the members StyleValue.h (lines 145-151) and StyleValue.cpp (lines 144-151)
#       declare and define for each type of ENUMERATE_CSS_STYLE_VALUE_TYPES: `is_<type>()`
#       compares the type, `as_<type>() const` verifies it and casts, and the non-const
#       `as_<type>()` forwards to the const one. The struct of every type embeds StyleValue
#       first (DESIGN.md §2.3), so the cast is a pointer cast. C++'s const and non-const
#       overloads are `css_style_value_as_<type>_const` and `css_style_value_as_<type>`.
#
#       Copyright (c) 2018-2025, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2021-2025, Sam Atkins <sam@ladybird.org>
#       Copyright (c) 2021, Tobias Christiansen <tobyase@serenityos.org>
#       Copyright (c) 2022-2023, MacDue <macdue@dueutil.tech>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: as_<type> ===============================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:150 Web::CSS::StyleValue::as_anchor.
pub func css_style_value_as_anchor_const(this: CssStyleValue*) -> CssAnchorStyleValue*:
    assert(css_style_value_is_anchor(this))
    return (CssAnchorStyleValue*)this

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:149 Web::CSS::StyleValue::as_anchor.
pub func css_style_value_as_anchor(this: CssStyleValue*) -> CssAnchorStyleValue*:
    return css_style_value_as_anchor_const(this)

