## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.h:17 Web::CSS::SuperellipseStyleValue::create.
pub func css_superellipse_style_value_create(parameter: CssStyleValue*) -> CssSuperellipseStyleValue*:
    let this = &(alloc CssSuperellipseStyleValue[1] else trap("out of memory"))[0]
    css_superellipse_style_value_construct(this, parameter)
    return this

# NOTE: This function can only be called after absolutization
## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.h:24 Web::CSS::SuperellipseStyleValue::parameter.
pub func css_superellipse_style_value_parameter(this: CssSuperellipseStyleValue*) -> f64:
    return css_number_from_style_value(this.m_parameter, none)

## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.cpp:11 Web::CSS::SuperellipseStyleValue::serialize (override).
pub func css_superellipse_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssSuperellipseStyleValue*)base
    if mode == css_syntax.SerializationMode.resolved_value and css_style_value_is_number(this.m_parameter):
        let number = css_number_style_value_number(css_style_value_as_number(this.m_parameter))
        if number == 1.0:
            ak.string_builder_append(builder, "round")
            return
        if number == 2.0:
            ak.string_builder_append(builder, "squircle")
            return
        if number == math.infinity:
            ak.string_builder_append(builder, "square")
            return
        if number == 0.0:
            ak.string_builder_append(builder, "bevel")
            return
        if number == -1.0:
            ak.string_builder_append(builder, "scoop")
            return
        if number == -math.infinity:
            ak.string_builder_append(builder, "notch")
            return

    ak.string_builder_append(builder, "superellipse(")
    if not css_style_value_is_number(this.m_parameter):
        css_style_value_serialize(this.m_parameter, builder, mode)
    else:
        let number = css_number_style_value_number(css_style_value_as_number(this.m_parameter))
        if number == math.infinity:
            ak.string_builder_append(builder, "infinity")
        elif number == -math.infinity:
            ak.string_builder_append(builder, "-infinity")
        else:
            css_style_value_serialize(this.m_parameter, builder, mode)
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.cpp:63 Web::CSS::SuperellipseStyleValue::absolutized (override).
pub func css_superellipse_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssSuperellipseStyleValue*)base
    let absolutized_parameter = css_style_value_absolutized(this.m_parameter, computation_context)
    if css_style_values_equal(absolutized_parameter, this.m_parameter):
        return base
    return css_superellipse_style_value_create(absolutized_parameter).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.h:33 Web::CSS::SuperellipseStyleValue::properties_equal.
pub func css_superellipse_style_value_properties_equal(this: CssSuperellipseStyleValue*, other: CssSuperellipseStyleValue*) -> bool:
    return css_style_values_equal(this.m_parameter, other.m_parameter)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::SuperellipseStyleValue (CRTP helper) (override).
pub func css_superellipse_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_superellipse_style_value_properties_equal((CssSuperellipseStyleValue*)base, (CssSuperellipseStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.h:35 Web::CSS::SuperellipseStyleValue::is_computationally_independent (override).
pub func css_superellipse_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssSuperellipseStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_parameter)

## Ported from Libraries/LibWeb/CSS/StyleValues/SuperellipseStyleValue.h:38 Web::CSS::SuperellipseStyleValue::SuperellipseStyleValue.
pub func css_superellipse_style_value_construct(this: CssSuperellipseStyleValue*, parameter: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.superellipse)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_superellipse_style_value_vtable, &css_superellipse_style_value_class)
    this.m_parameter = parameter
