    let this = (CssLogCalculationNode*)base
    css_appendff(builder, "{: >{}}LOG:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    css_calculation_node_dump(this.m_x, builder, indent + 2)
    css_calculation_node_dump(this.m_y, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2267 Web::CSS::LogCalculationNode::equals (override).
pub func css_log_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssLogCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_calculation_node_equals(this.m_x, ((CssLogCalculationNode*)other).m_x) and css_calculation_node_equals(this.m_y, ((CssLogCalculationNode*)other).m_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2277 Web::CSS::LogCalculationNode::is_computationally_independent (override).
pub func css_log_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssLogCalculationNode*)base
    return css_calculation_node_is_computationally_independent(this.m_x) and css_calculation_node_is_computationally_independent(this.m_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:695 Web::CSS::LogCalculationNode::children (override).
pub func css_log_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssLogCalculationNode*)base
    var children = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&children, this.m_x)
    ak.vector_append_t(&children, this.m_y)
    return children

