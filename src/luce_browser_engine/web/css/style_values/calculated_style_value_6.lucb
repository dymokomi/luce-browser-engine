## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2500 Web::CSS::RoundCalculationNode::equals (override).
pub func css_round_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssRoundCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    let other_round = (CssRoundCalculationNode*)other
    return (this.m_strategy == other_round.m_strategy and css_calculation_node_equals(this.m_x, other_round.m_x) and css_calculation_node_equals(this.m_y, other_round.m_y))

