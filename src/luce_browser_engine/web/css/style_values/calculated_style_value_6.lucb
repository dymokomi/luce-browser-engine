# https://drafts.csswg.org/css-values-4/#funcdef-exp
## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2303 Web::CSS::ExpCalculationNode::run_operation_if_possible (override).
pub func css_exp_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, arg0: CssCalculationContext, arg1: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    discard(arg0)
    discard(arg1)
    let this = (CssExpCalculationNode*)base
    # The exp(A) function contains one calculation which must resolve to a <number>, and returns the same value as
    # pow(e, A) as a <number> with the return type made consistent with the input calculation’s type.
    let number = css_try_get_number(this.m_value) else return none

    let empty_type = CssNumericType()
    let consistent_type = css_numeric_type_made_consistent_with(&empty_type, css_calculation_node_numeric_type(this.m_value) else trap("VERIFY: has_value")) else return none

    return css_calculated_style_value_calculation_result_new(math.exp(number), consistent_type)

