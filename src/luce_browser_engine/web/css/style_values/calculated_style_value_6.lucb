## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2347 Web::CSS::RoundCalculationNode::RoundCalculationNode.
pub func css_round_calculation_node_construct(this: CssRoundCalculationNode*, mode: css_data.RoundingStrategy, x: CssCalculationNode*, y: CssCalculationNode*, numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .round, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_round_calculation_node_vtable, &css_round_calculation_node_class)
    this.m_strategy = mode
    this.m_x = x
    this.m_y = y

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2357 Web::CSS::RoundCalculationNode::contains_percentage (override).
pub func css_round_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssRoundCalculationNode*)base
    return css_calculation_node_contains_percentage(this.m_x) or css_calculation_node_contains_percentage(this.m_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2362 Web::CSS::RoundCalculationNode::with_simplified_children (override).
pub func css_round_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    let this = (CssRoundCalculationNode*)base
    let simplified_x = css_simplify_a_calculation_tree(this.m_x, context, resolution_context)
    let simplified_y = css_simplify_a_calculation_tree(this.m_y, context, resolution_context)
    if simplified_x != this.m_x or simplified_y != this.m_y:
        return css_round_calculation_node_create(this.m_strategy, simplified_x, simplified_y).css_calculation_node()
    return base

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2372 Web::CSS::RoundCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-round
pub func css_round_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssRoundCalculationNode*)base
    # The round(<rounding-strategy>?, A, B?) function contains an optional rounding strategy, and two calculations A
    # and B, and returns the value of A, rounded according to the rounding strategy, to the nearest integer multiple of
    # B either above or below A. The argument calculations can resolve to any <number>, <dimension>, or <percentage>,
    # but must have a consistent type or else the function is invalid; the result’s type will be the consistent type.

    let maybe_a = css_try_get_value_with_canonical_unit(this.m_x, context, resolution_context)
    let maybe_b = css_try_get_value_with_canonical_unit(this.m_y, context, resolution_context)
    if maybe_a == none or maybe_b == none:
        return none
    let result_a = maybe_a else trap("unreachable")
    let result_b = maybe_b else trap("unreachable")

    let a_type = result_a.m_type else trap("VERIFY: has_value")
    let consistent_type = css_numeric_type_made_consistent_with(&a_type, result_b.m_type else trap("VERIFY: has_value"))
    if consistent_type == none:
        return none

    let a = result_a.m_value
    let b = result_b.m_value

    # https://drafts.csswg.org/css-values-4/#round-infinities
    # In round(A, B), if B is 0, the result is NaN. If A and B are both infinite, the result is NaN.
    if b == 0.0 or (math.is_infinite(a) and math.is_infinite(b)):
        return css_calculated_style_value_calculation_result_new(math.nan, consistent_type)

    # If A is infinite but B is finite, the result is the same infinity.
    if math.is_infinite(a) and math.is_finite(b):
        return css_calculated_style_value_calculation_result_new(a, consistent_type)

    # If A is finite but B is infinite, the result depends on the <rounding-strategy> and the sign of A:
    if math.is_finite(a) and math.is_infinite(b):
        let sign = math.signbit(a)
        match this.m_strategy:
            # nearest, to-zero:
            .nearest, .to_zero:
                # If A is positive or 0⁺, return 0⁺. Otherwise, return 0⁻.
                return css_calculated_style_value_calculation_result_new(0.0 if not sign else -0.0, consistent_type)
            # up:
            .up:
                var result = 0.0
                if a > 0.0:
                    # If A is positive(not zero), return +∞.
                    result = math.infinity
                else:
                    # If A is 0⁺, return 0⁺. Otherwise, return 0⁻.
                    result = 0.0 if not sign else -0.0
                return css_calculated_style_value_calculation_result_new(result, consistent_type)
            # down:
            .down:
                var result = 0.0
                if a < 0.0:
                    # If A is negative (not zero), return −∞.
                    result = -math.infinity
                else:
                    # If A is 0⁻, return 0⁻. Otherwise, return 0⁺.
                    result = -0.0 if sign else 0.0
                return css_calculated_style_value_calculation_result_new(result, consistent_type)
            _:
                discard(0)

    # If A is exactly equal to an integer multiple of B, round() resolves to A exactly (preserving whether A is 0⁻ or
    # 0⁺, if relevant).
    if math.mod(a, b) == 0.0:
        return result_a

    # Otherwise, there are two integer multiples of B that are potentially "closest" to A, lower B which is closer to
    # −∞ and upper B which is closer to +∞. The following <rounding-strategy>s dictate how to choose between them:

    # FIXME: If lower B would be zero, it is specifically equal to 0⁺;
    #        if upper B would be zero, it is specifically equal to 0⁻.
    # get_lower_b: floor(a / b) * b; get_upper_b: ceil(a / b) * b.

    var rounded = 0.0
    match this.m_strategy:
        # -> nearest
        .nearest:
            # Choose whichever of lower B and upper B that has the smallest absolute difference from A.
            # If both have an equal difference (A is exactly between the two values), choose upper B.
            let lower_b = math.floor(a / b) * b
            let upper_b = math.ceil(a / b) * b
            let lower_diff = math.abs(lower_b - a)
            let upper_diff = math.abs(upper_b - a)
            rounded = upper_b if upper_diff <= lower_diff else lower_b
        # -> up
        .up:
            # Choose upper B.
            rounded = math.ceil(a / b) * b
        # -> down
        .down:
            # Choose lower B.
            rounded = math.floor(a / b) * b
        # -> to-zero
        .to_zero:
            # Choose whichever of lower B and upper B that has the smallest absolute difference from 0.
            let lower_b = math.floor(a / b) * b
            let upper_b = math.ceil(a / b) * b
            rounded = upper_b if math.abs(upper_b) < math.abs(lower_b) else lower_b
        _:
            discard(0)

    return css_calculated_style_value_calculation_result_new(rounded, consistent_type)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2493 Web::CSS::RoundCalculationNode::dump (override).
pub func css_round_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssRoundCalculationNode*)base
    css_appendff(builder, "{: >{}}ROUND: {}\n", [ak.arg_str(""), ak.arg_i64((i64)indent), ak.arg_string_view(css_data.to_string_rounding_strategy(this.m_strategy))])
