# https://drafts.csswg.org/css-values-4/#funcdef-log
## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2242 Web::CSS::LogCalculationNode::run_operation_if_possible (override).
pub func css_log_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, arg0: CssCalculationContext, arg1: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    discard(arg0)
    discard(arg1)
    let this = (CssLogCalculationNode*)base
    # The log(A, B?) function contains one or two calculations (representing the value to be logarithmed, and the
    # base of the logarithm, defaulting to e), which must resolve to <number>s, and returns the logarithm base B of
    # the value A, as a <number> with the return type made consistent with the input calculation’s type.
    let number = css_try_get_number(this.m_x)
    let base_number = css_try_get_number(this.m_y)
    if number == none or base_number == none:
        return none

    let empty_type = CssNumericType()
    let consistent_type = css_numeric_type_made_consistent_with(&empty_type, css_calculation_node_numeric_type(this.m_x) else trap("VERIFY: has_value")) else return none

    return css_calculated_style_value_calculation_result_new(math.log(number else trap("unreachable")) / math.log(base_number else trap("unreachable")), consistent_type)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2260 Web::CSS::LogCalculationNode::dump (override).
