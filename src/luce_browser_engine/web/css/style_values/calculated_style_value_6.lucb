# mark: HypotCalculationNode ====================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2130 Web::CSS::HypotCalculationNode::create.
pub func css_hypot_calculation_node_create(values: ak.Vector[CssCalculationNode*]) -> CssHypotCalculationNode*:
    # https://drafts.csswg.org/css-values-4/#determine-the-type-of-a-calculation
    # The result of adding the types of its comma-separated calculations.
    let numeric_type = css_add_the_types_vector(&values)
    let this = &(alloc CssHypotCalculationNode[1] else trap("out of memory"))[0]
    css_hypot_calculation_node_construct(this, values, numeric_type)
    return this

## css_hypot_calculation_node_create as a CssCreateFromChildren.
func css_hypot_calculation_node_create_node(values: ak.Vector[CssCalculationNode*]) -> CssCalculationNode*:
    return css_hypot_calculation_node_create(values).css_calculation_node()

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2138 Web::CSS::HypotCalculationNode::HypotCalculationNode.
pub func css_hypot_calculation_node_construct(this: CssHypotCalculationNode*, values: ak.Vector[CssCalculationNode*], numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .hypot, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_hypot_calculation_node_vtable, &css_hypot_calculation_node_class)
    this.m_values = values

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2146 Web::CSS::HypotCalculationNode::contains_percentage (override).
pub func css_hypot_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssHypotCalculationNode*)base
    for value in ak.vector_span_const(&this.m_values):
        if css_calculation_node_contains_percentage(value):
            return true

    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2156 Web::CSS::HypotCalculationNode::with_simplified_children (override).
pub func css_hypot_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    return css_simplify_children_vector(base, css_hypot_calculation_node_create_node, context, resolution_context)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2162 Web::CSS::HypotCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-hypot
pub func css_hypot_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssHypotCalculationNode*)base
    # The hypot(A, …) function contains one or more comma-separated calculations, and returns the length of an
    # N-dimensional vector with components equal to each of the calculations. (That is, the square root of the sum of
    # the squares of its arguments.) The argument calculations can resolve to any <number>, <dimension>, or
    # <percentage>, but must have a consistent type or else the function is invalid; the result’s type will be the
    # consistent type.

    var consistent_type: CssNumericType? = none
    var value = 0.0

    for child in ak.vector_span_const(&this.m_values):
        let canonical_child = css_try_get_value_with_canonical_unit(child, context, resolution_context) else return none

        if let current = consistent_type:
            consistent_type = css_numeric_type_consistent_type(&current, canonical_child.m_type else trap("VERIFY: has_value"))
        else:
            consistent_type = canonical_child.m_type

        if consistent_type == none:
            return none

        value += canonical_child.m_value * canonical_child.m_value

    if consistent_type == none:
        return none

    return css_calculated_style_value_calculation_result_new(math.sqrt(value), consistent_type)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2195 Web::CSS::HypotCalculationNode::dump (override).
pub func css_hypot_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssHypotCalculationNode*)base
    css_appendff(builder, "{: >{}}HYPOT:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    for value in ak.vector_span_const(&this.m_values):
        css_calculation_node_dump(value, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2202 Web::CSS::HypotCalculationNode::equals (override).
pub func css_hypot_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssHypotCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    # NB: The donor compares no sizes here: an `other` with fewer children reads past its end in C++ and traps here.
    let other_values = &((CssHypotCalculationNode*)other).m_values
    for i in 0..<ak.vector_size(&this.m_values):
        if not css_calculation_node_equals(*ak.vector_at_const(&this.m_values, i), *ak.vector_at_const(other_values, i)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2215 Web::CSS::HypotCalculationNode::is_computationally_independent (override).
pub func css_hypot_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssHypotCalculationNode*)base
    return css_calculation_nodes_are_computationally_independent(&this.m_values)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:675 Web::CSS::HypotCalculationNode::children (override).
pub func css_hypot_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssHypotCalculationNode*)base
    return this.m_values

