## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2516 Web::CSS::ModCalculationNode::create.
pub func css_mod_calculation_node_create(x: CssCalculationNode*, y: CssCalculationNode*) -> CssModCalculationNode*:
    # https://www.w3.org/TR/css-values-4/#determine-the-type-of-a-calculation
    # The result of adding the types of its comma-separated calculations.
    let numeric_type = css_add_the_types_css_calculation_node_css_calculation_node(x, y)
    let this = &(alloc CssModCalculationNode[1] else trap("out of memory"))[0]
    css_mod_calculation_node_construct(this, x, y, numeric_type)
    return this

## css_mod_calculation_node_create as a CssCreateFromTwoChildren.
func css_mod_calculation_node_create_node(x: CssCalculationNode*, y: CssCalculationNode*) -> CssCalculationNode*:
    return css_mod_calculation_node_create(x, y).css_calculation_node()

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2524 Web::CSS::ModCalculationNode::ModCalculationNode.
pub func css_mod_calculation_node_construct(this: CssModCalculationNode*, x: CssCalculationNode*, y: CssCalculationNode*, numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .mod, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_mod_calculation_node_vtable, &css_mod_calculation_node_class)
    this.m_x = x
    this.m_y = y

