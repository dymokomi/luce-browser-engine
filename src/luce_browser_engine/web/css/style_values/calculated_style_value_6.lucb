pub func css_round_calculation_node_create(strategy: css_data.RoundingStrategy, x: CssCalculationNode*, y: CssCalculationNode*) -> CssRoundCalculationNode*:
    # https://www.w3.org/TR/css-values-4/#determine-the-type-of-a-calculation
    # The result of adding the types of its comma-separated calculations.
    let numeric_type = css_add_the_types_css_calculation_node_css_calculation_node(x, y)
    let this = &(alloc CssRoundCalculationNode[1] else trap("out of memory"))[0]
    css_round_calculation_node_construct(this, strategy, x, y, numeric_type)
