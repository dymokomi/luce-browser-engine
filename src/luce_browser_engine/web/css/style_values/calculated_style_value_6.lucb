## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:738 Web::CSS::RoundCalculationNode::children (override).
# NOTE: This excludes the rounding strategy!
pub func css_round_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssRoundCalculationNode*)base
    var children = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&children, this.m_x)
    ak.vector_append_t(&children, this.m_y)
    return children

