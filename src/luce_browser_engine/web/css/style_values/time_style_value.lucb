## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:19 Web::CSS::TimeStyleValue::create.
pub func css_time_style_value_create(time: CssTime) -> CssTimeStyleValue*:
    let this = &(alloc CssTimeStyleValue[1] else trap("out of memory"))[0]
    css_time_style_value_construct(this, time)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:25 Web::CSS::TimeStyleValue::time.
pub func css_time_style_value_time(this: CssTimeStyleValue*) -> CssTime:
    return this.m_time

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:26 Web::CSS::TimeStyleValue::raw_value (override).
pub func css_time_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssTimeStyleValue*)base
    return css_time_raw_value(&this.m_time)

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:27 Web::CSS::TimeStyleValue::unit_name (override).
pub func css_time_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssTimeStyleValue*)base
    return css_time_unit_name(&this.m_time)

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:29 Web::CSS::TimeStyleValue::serialize (override).
pub func css_time_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssTimeStyleValue*)base
    css_time_serialize(&this.m_time, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:31 Web::CSS::TimeStyleValue::equals (override).
pub func css_time_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssTimeStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_time = css_style_value_as_time(other)
    return css_time_eq(&this.m_time, other_time.m_time)

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:39 Web::CSS::TimeStyleValue::is_computationally_independent (override).
pub func css_time_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/TimeStyleValue.h:42 Web::CSS::TimeStyleValue::TimeStyleValue.
pub func css_time_style_value_construct(this: CssTimeStyleValue*, time: CssTime):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.time)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_time_style_value_vtable, &css_time_style_value_class)
    this.m_time = time
