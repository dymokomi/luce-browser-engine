## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.h:25 Web::CSS::TreeCountingFunctionStyleValue::create.
pub func css_tree_counting_function_style_value_create(function: CssTreeCountingFunctionStyleValueTreeCountingFunction, computed_type: CssTreeCountingFunctionStyleValueComputedType) -> CssTreeCountingFunctionStyleValue*:
    let this = &(alloc CssTreeCountingFunctionStyleValue[1] else trap("out of memory"))[0]
    css_tree_counting_function_style_value_construct(this, function, computed_type)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.h:43 Web::CSS::TreeCountingFunctionStyleValue::TreeCountingFunctionStyleValue.
pub func css_tree_counting_function_style_value_construct(this: CssTreeCountingFunctionStyleValue*, function: CssTreeCountingFunctionStyleValueTreeCountingFunction, computed_type: CssTreeCountingFunctionStyleValueComputedType):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.tree_counting_function)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_tree_counting_function_style_value_vtable, &css_tree_counting_function_style_value_class)
    this.m_function = function
    this.m_computed_type = computed_type

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.cpp:15 Web::CSS::TreeCountingFunctionStyleValue::serialize (override).
pub func css_tree_counting_function_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssTreeCountingFunctionStyleValue*)base
    match this.m_function:
        .sibling_count:
            ak.string_builder_append(builder, "sibling-count()")
        .sibling_index:
            ak.string_builder_append(builder, "sibling-index()")
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.cpp:27 Web::CSS::TreeCountingFunctionStyleValue::resolve.
pub func css_tree_counting_function_style_value_resolve(this: CssTreeCountingFunctionStyleValue*, abstract_element: DomAbstractElement) -> usize:
    var element = abstract_element
    dom_element_set_style_uses_tree_counting_function(dom_abstract_element_element(&element))

    let tree_counting_function_resolution_context = dom_abstract_element_tree_counting_function_resolution_context(&abstract_element)

    match this.m_function:
        .sibling_count:
            return tree_counting_function_resolution_context.sibling_count
        .sibling_index:
            return tree_counting_function_resolution_context.sibling_index
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.cpp:43 Web::CSS::TreeCountingFunctionStyleValue::resolve_to_calculation_node (override).
pub func css_tree_counting_function_style_value_resolve_to_calculation_node_impl(base: CssAbstractNonMathCalcFunctionStyleValue*, calculation_context: CssCalculationContext, calculation_resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*?:
    let this = (CssTreeCountingFunctionStyleValue*)base
    let abstract_element = calculation_resolution_context.abstract_element else return none

    return (CssCalculationNode*)css_numeric_calculation_node_create(.number(css_syntax.number_create(css_syntax.NumberType.number, (f64)css_tree_counting_function_style_value_resolve(this, abstract_element))), calculation_context)

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.cpp:51 Web::CSS::TreeCountingFunctionStyleValue::absolutized (override).
pub func css_tree_counting_function_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssTreeCountingFunctionStyleValue*)base
    # FIXME: We should clamp this value in case it falls outside the valid range for the context it is in
    let abstract_element = computation_context.abstract_element else trap("VERIFY: an abstract element")

    let value = css_tree_counting_function_style_value_resolve(this, abstract_element)

    match this.m_computed_type:
        .integer:
            return css_integer_style_value_create((i32)value).css_style_value()
        .number:
            return css_number_style_value_create((f64)value).css_style_value()
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.cpp:68 Web::CSS::TreeCountingFunctionStyleValue::equals (override).
pub func css_tree_counting_function_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssTreeCountingFunctionStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_tree_counting_function = css_style_value_as_tree_counting_function(other)
    return this.m_function == other_tree_counting_function.m_function and this.m_computed_type == other_tree_counting_function.m_computed_type

## Ported from Libraries/LibWeb/CSS/StyleValues/TreeCountingFunctionStyleValue.h:40 Web::CSS::TreeCountingFunctionStyleValue::is_computationally_independent (override).
pub func css_tree_counting_function_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return false
