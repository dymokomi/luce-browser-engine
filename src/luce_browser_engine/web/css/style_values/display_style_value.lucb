## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.cpp:13 Web::CSS::DisplayStyleValue::create.
pub func css_display_style_value_create(display: CssDisplay) -> CssDisplayStyleValue*:
    let this = &(alloc CssDisplayStyleValue[1] else trap("out of memory"))[0]
    css_display_style_value_construct(this, display)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.h:30 Web::CSS::DisplayStyleValue::DisplayStyleValue.
pub func css_display_style_value_construct(this: CssDisplayStyleValue*, display: CssDisplay):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.display)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_display_style_value_vtable, &css_display_style_value_class)
    this.m_display = display

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.h:20 Web::CSS::DisplayStyleValue::serialize (override).
pub func css_display_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssDisplayStyleValue*)base
    let string = css_display_to_string(&this.m_display)
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&string))

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.h:22 Web::CSS::DisplayStyleValue::display.
pub func css_display_style_value_display(this: CssDisplayStyleValue*) -> CssDisplay:
    return this.m_display

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.h:24 Web::CSS::DisplayStyleValue::properties_equal.
pub func css_display_style_value_properties_equal(this: CssDisplayStyleValue*, other: CssDisplayStyleValue*) -> bool:
    return css_display_eq(&this.m_display, other.m_display)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::DisplayStyleValue (CRTP helper) (override).
pub func css_display_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_display_style_value_properties_equal((CssDisplayStyleValue*)base, (CssDisplayStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.cpp:18 Web::CSS::DisplayStyleValue::reify (override).
pub func css_display_style_value_reify_impl(base: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    let this = (CssDisplayStyleValue*)base
    if let keyword = css_display_to_keyword(&this.m_display):
        let keyword_string = css_data.string_from_keyword(keyword)
        return (CssCssStyleValue*)css_keyword_value_create(realm, ak.fly_string_from_utf8_without_validation(ak.string_view_bytes(&keyword_string)))

    return css_css_style_value_create(realm, associated_property, base)

## Ported from Libraries/LibWeb/CSS/StyleValues/DisplayStyleValue.h:27 Web::CSS::DisplayStyleValue::is_computationally_independent (override).
pub func css_display_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true
