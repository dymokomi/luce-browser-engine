# https://drafts.csswg.org/css-values-5/#pending-substitution-value

## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:16 Web::CSS::PendingSubstitutionStyleValue::create.
pub func css_pending_substitution_style_value_create(original_shorthand_value: CssStyleValue*) -> CssPendingSubstitutionStyleValue*:
    let this = &(alloc CssPendingSubstitutionStyleValue[1] else trap("out of memory"))[0]
    css_pending_substitution_style_value_construct(this, original_shorthand_value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:38 Web::CSS::PendingSubstitutionStyleValue::PendingSubstitutionStyleValue.
pub func css_pending_substitution_style_value_construct(this: CssPendingSubstitutionStyleValue*, original_shorthand_value: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.pending_substitution)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_pending_substitution_style_value_vtable, &css_pending_substitution_style_value_class)
    this.m_original_shorthand_value = original_shorthand_value

## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:21 Web::CSS::PendingSubstitutionStyleValue::serialize (override).
pub func css_pending_substitution_style_value_serialize_impl(base: CssStyleValue*, arg0: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(base)
    discard(arg0)
    discard(arg1)

## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:22 Web::CSS::PendingSubstitutionStyleValue::tokenize (override).
pub func css_pending_substitution_style_value_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    discard(base)
    # Not sure what to do here, but this isn't valid so returning GIV seems the most correct.
    var values = ak.Vector[css_syntax.ComponentValue]()
    ak.vector_append_t(&values, css_syntax.component_value_from_guaranteed_invalid_value(css_syntax.GuaranteedInvalidValue()))
    return values

## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:28 Web::CSS::PendingSubstitutionStyleValue::original_shorthand_value.
pub func css_pending_substitution_style_value_original_shorthand_value(this: CssPendingSubstitutionStyleValue*) -> CssStyleValue*:
    return this.m_original_shorthand_value

# We shouldn't need to compare these, but in case we do: The nature of them is that their value is unknown, so
# consider them all to be unique.
## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:32 Web::CSS::PendingSubstitutionStyleValue::properties_equal.
pub func css_pending_substitution_style_value_properties_equal(this: CssPendingSubstitutionStyleValue*, arg0: CssPendingSubstitutionStyleValue*) -> bool:
    discard(this)
    discard(arg0)
    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::PendingSubstitutionStyleValue (CRTP helper) (override).
pub func css_pending_substitution_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_pending_substitution_style_value_properties_equal((CssPendingSubstitutionStyleValue*)base, (CssPendingSubstitutionStyleValue*)other)

# NB: We should never be in a position where we need to check this
## Ported from Libraries/LibWeb/CSS/StyleValues/PendingSubstitutionStyleValue.h:35 Web::CSS::PendingSubstitutionStyleValue::is_computationally_independent (override).
pub func css_pending_substitution_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    trap("VERIFY_NOT_REACHED")
