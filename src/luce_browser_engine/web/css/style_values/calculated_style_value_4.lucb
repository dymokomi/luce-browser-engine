## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1437 Web::CSS::AbsCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-abs
pub func css_abs_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssAbsCalculationNode*)base
    # The abs(A) function contains one calculation A, and returns the absolute value of A, as the same type as the input:
    # if A’s numeric value is positive or 0⁺, just A again; otherwise -1 * A.
    let child_value = css_try_get_value_with_canonical_unit(this.m_value, context, resolution_context) else return none
    return css_calculated_style_value_calculation_result_new(math.abs(child_value.m_value), child_value.m_type)

