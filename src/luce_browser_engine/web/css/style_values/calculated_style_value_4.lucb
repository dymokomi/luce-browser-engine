# mark: MinCalculationNode ======================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1110 Web::CSS::MinCalculationNode::create.
pub func css_min_calculation_node_create(values: ak.Vector[CssCalculationNode*]) -> CssMinCalculationNode*:
    # https://drafts.csswg.org/css-values-4/#determine-the-type-of-a-calculation
    # The result of adding the types of its comma-separated calculations.
    let numeric_type = css_add_the_types_vector(&values)
    let this = &(alloc CssMinCalculationNode[1] else trap("out of memory"))[0]
    css_min_calculation_node_construct(this, values, numeric_type)
    return this

## css_min_calculation_node_create as a CssCreateFromChildren.
func css_min_calculation_node_create_node(values: ak.Vector[CssCalculationNode*]) -> CssCalculationNode*:
    return css_min_calculation_node_create(values).css_calculation_node()

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1118 Web::CSS::MinCalculationNode::MinCalculationNode.
pub func css_min_calculation_node_construct(this: CssMinCalculationNode*, values: ak.Vector[CssCalculationNode*], numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .min, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_min_calculation_node_vtable, &css_min_calculation_node_class)
    this.m_values = values

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1126 Web::CSS::MinCalculationNode::contains_percentage (override).
pub func css_min_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssMinCalculationNode*)base
    for value in ak.vector_span_const(&this.m_values):
        if css_calculation_node_contains_percentage(value):
            return true

    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1136 Web::CSS::MinCalculationNode::with_simplified_children (override).
pub func css_min_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    return css_simplify_children_vector(base, css_min_calculation_node_create_node, context, resolution_context)

## `CalculationResult { value, type }`.
pub func css_calculated_style_value_calculation_result_new(value: f64, type_: CssNumericType?) -> CssCalculatedStyleValueCalculationResult:
    var result = CssCalculatedStyleValueCalculationResult(m_value = 0.0)
    css_calculated_style_value_calculation_result_construct(&result, value, type_)
    return result

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1146 Web::CSS::run_min_or_max_operation_if_possible.
func css_run_min_or_max_operation_if_possible(children: const ak.Vector[CssCalculationNode*]*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext, min_or_max: CssMinOrMax) -> CssCalculatedStyleValueCalculationResult?:
    # The min() or max() functions contain one or more comma-separated calculations, and represent the smallest
    # (most negative) or largest (most positive) of them, respectively.
    var result: CssCalculatedStyleValueCalculationResult? = none
    for child in ak.vector_span_const(children):
        let child_value = css_try_get_value_with_canonical_unit(child, context, resolution_context) else return none

        if let current = result:
            let current_type = current.m_type else trap("VERIFY: has_value")
            let consistent_type = css_numeric_type_consistent_type(&current_type, child_value.m_type else trap("VERIFY: has_value")) else return none

            # https://drafts.csswg.org/css-values-4/#calc-ieee
            # Any operation with at least one NaN argument produces NaN.
            if math.is_nan(child_value.m_value) or math.is_nan(current.m_value):
                result = css_calculated_style_value_calculation_result_new(math.nan, consistent_type)
                continue

            if min_or_max == CssMinOrMax.min:
                if child_value.m_value < current.m_value:
                    result = css_calculated_style_value_calculation_result_new(child_value.m_value, consistent_type)
                else:
                    result = css_calculated_style_value_calculation_result_new(current.m_value, consistent_type)
            else:
                if child_value.m_value > current.m_value:
                    result = css_calculated_style_value_calculation_result_new(child_value.m_value, consistent_type)
                else:
                    result = css_calculated_style_value_calculation_result_new(current.m_value, consistent_type)
        else:
            result = child_value
    return result

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1189 Web::CSS::MinCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-min
pub func css_min_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssMinCalculationNode*)base
    return css_run_min_or_max_operation_if_possible(&this.m_values, context, resolution_context, .min)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1194 Web::CSS::MinCalculationNode::dump (override).
pub func css_min_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssMinCalculationNode*)base
    css_appendff(builder, "{: >{}}MIN:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    for value in ak.vector_span_const(&this.m_values):
        css_calculation_node_dump(value, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1201 Web::CSS::MinCalculationNode::equals (override).
pub func css_min_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssMinCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_calculation_node_vectors_equal(&this.m_values, &((CssMinCalculationNode*)other).m_values)

