## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1576 Web::CSS::run_sin_cos_or_tan_operation_if_possible.
func css_run_sin_cos_or_tan_operation_if_possible(child: CssCalculationNode*, trig_function: CssSinCosOrTan) -> CssCalculatedStyleValueCalculationResult?:
    # The sin(A), cos(A), and tan(A) functions all contain a single calculation which must resolve to either a <number>
    # or an <angle>, and compute their corresponding function by interpreting the result of their argument as radians.
    # (That is, sin(45deg), sin(.125turn), and sin(3.14159 / 4) all represent the same value, approximately .707.) They
    # all represent a <number>, with the return type made consistent with the input calculation’s type. sin() and cos()
    # will always return a number between −1 and 1, while tan() can return any number between −∞ and +∞.
    # (See § 10.9 Type Checking for details on how math functions handle ∞.)

    if css_calculation_node_type(child) != CssCalculationNodeType.numeric:
        return none
    let numeric_child = as_css_numeric_calculation_node(child)

    var radians = 0.0
    match numeric_child.m_value:
        .css_angle(angle): radians = css_angle_to_radians(&angle)
        .number(number): radians = css_syntax.number_value(&number)
        _: trap("VERIFY_NOT_REACHED")

    var result = 0.0
    match trig_function:
        .sin: result = math.sin(radians)
        .cos: result = math.cos(radians)
        .tan: result = math.tan(radians)
        _: discard(0)

    let empty_type = CssNumericType()
    return css_calculated_style_value_calculation_result_new(result, css_numeric_type_made_consistent_with(&empty_type, css_calculation_node_numeric_type(child) else trap("VERIFY: has_value")))

