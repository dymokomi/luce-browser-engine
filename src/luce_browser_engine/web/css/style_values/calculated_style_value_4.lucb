pub func css_clamp_calculation_node_create(min: CssCalculationNode*, center: CssCalculationNode*, max: CssCalculationNode*) -> CssClampCalculationNode*:
    # https://drafts.csswg.org/css-values-4/#determine-the-type-of-a-calculation
    # The result of adding the types of its comma-separated calculations.
    let numeric_type = css_add_the_types_css_calculation_node_css_calculation_node_css_calculation_node(min, center, max)
    let this = &(alloc CssClampCalculationNode[1] else trap("out of memory"))[0]
    css_clamp_calculation_node_construct(this, min, center, max, numeric_type)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1309 Web::CSS::ClampCalculationNode::ClampCalculationNode.
pub func css_clamp_calculation_node_construct(this: CssClampCalculationNode*, min: CssCalculationNode*, center: CssCalculationNode*, max: CssCalculationNode*, numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .clamp, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_clamp_calculation_node_vtable, &css_clamp_calculation_node_class)
    this.m_min_value = min
    this.m_center_value = center
    this.m_max_value = max

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1319 Web::CSS::ClampCalculationNode::contains_percentage (override).
pub func css_clamp_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssClampCalculationNode*)base
    return css_calculation_node_contains_percentage(this.m_min_value) or css_calculation_node_contains_percentage(this.m_center_value) or css_calculation_node_contains_percentage(this.m_max_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1324 Web::CSS::ClampCalculationNode::with_simplified_children (override).
pub func css_clamp_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    let this = (CssClampCalculationNode*)base
    let simplified_min = css_simplify_a_calculation_tree(this.m_min_value, context, resolution_context)
    let simplified_center = css_simplify_a_calculation_tree(this.m_center_value, context, resolution_context)
    let simplified_max = css_simplify_a_calculation_tree(this.m_max_value, context, resolution_context)
    if simplified_min != this.m_min_value or simplified_center != this.m_center_value or simplified_max != this.m_max_value:
        return css_clamp_calculation_node_create(simplified_min, simplified_center, simplified_max).css_calculation_node()
    return base

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1335 Web::CSS::ClampCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-clamp
pub func css_clamp_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssClampCalculationNode*)base
    # The clamp() function takes three calculations — a minimum value, a central value, and a maximum value — and
    # represents its central calculation, clamped according to its min and max calculations, favoring the min
    # calculation if it conflicts with the max. (That is, given clamp(MIN, VAL, MAX), it represents exactly the
    # same value as max(MIN, min(VAL, MAX))).
    #
    # Either the min or max calculations (or even both) can instead be the keyword none, which indicates the value
    # is not clamped from that side. (That is, clamp(MIN, VAL, none) is equivalent to max(MIN, VAL), clamp(none,
    # VAL, MAX) is equivalent to min(VAL, MAX), and clamp(none, VAL, none) is equivalent to just calc(VAL).)
    #
    # For all three functions, the argument calculations can resolve to any <number>, <dimension>, or <percentage>,
    # but must have a consistent type or else the function is invalid; the result’s type will be the consistent type.

    let min_result = css_try_get_value_with_canonical_unit(this.m_min_value, context, resolution_context) else return none

    let center_result = css_try_get_value_with_canonical_unit(this.m_center_value, context, resolution_context) else return none

    let max_result = css_try_get_value_with_canonical_unit(this.m_max_value, context, resolution_context) else return none

    let min_type = min_result.m_type else trap("VERIFY: has_value")
    let min_and_center_type = css_numeric_type_consistent_type(&min_type, center_result.m_type else trap("VERIFY: has_value")) else return none
    let consistent_type = css_numeric_type_consistent_type(&min_and_center_type, max_result.m_type else trap("VERIFY: has_value")) else return none

    # https://drafts.csswg.org/css-values-4/#calc-ieee
    # Any operation with at least one NaN argument produces NaN.
    if math.is_nan(min_result.m_value) or math.is_nan(center_result.m_value) or math.is_nan(max_result.m_value):
        return css_calculated_style_value_calculation_result_new(math.nan, consistent_type)

    let chosen_value = ak.max_f64(min_result.m_value, ak.min_f64(center_result.m_value, max_result.m_value))
    return css_calculated_style_value_calculation_result_new(chosen_value, consistent_type)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1374 Web::CSS::ClampCalculationNode::dump (override).
pub func css_clamp_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssClampCalculationNode*)base
    css_appendff(builder, "{: >{}}CLAMP:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    css_calculation_node_dump(this.m_min_value, builder, indent + 2)
    css_calculation_node_dump(this.m_center_value, builder, indent + 2)
    css_calculation_node_dump(this.m_max_value, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1382 Web::CSS::ClampCalculationNode::equals (override).
pub func css_clamp_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssClampCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    let other_clamp = (CssClampCalculationNode*)other
    return (css_calculation_node_equals(this.m_min_value, other_clamp.m_min_value) and css_calculation_node_equals(this.m_center_value, other_clamp.m_center_value) and css_calculation_node_equals(this.m_max_value, other_clamp.m_max_value))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1393 Web::CSS::ClampCalculationNode::is_computationally_independent (override).
pub func css_clamp_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssClampCalculationNode*)base
    return (css_calculation_node_is_computationally_independent(this.m_min_value) and css_calculation_node_is_computationally_independent(this.m_center_value) and css_calculation_node_is_computationally_independent(this.m_max_value))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1400 Web::CSS::ClampCalculationNode::reify (override).
pub func css_clamp_calculation_node_reify_impl(base: CssCalculationNode*, realm: Realm*) -> CssNumericValue*?:
    let this = (CssClampCalculationNode*)base
    let lower = css_calculation_node_reify(this.m_min_value, realm)
    let value = css_calculation_node_reify(this.m_center_value, realm)
    let upper = css_calculation_node_reify(this.m_max_value, realm)
    if lower == none or value == none or upper == none:
        return none

    return css_math_clamp_create(realm, css_calculation_node_numeric_type(base) else trap("VERIFY: has_value"), lower else trap("unreachable"), value else trap("unreachable"), upper else trap("unreachable"))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:430 Web::CSS::ClampCalculationNode::children (override).
pub func css_clamp_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssClampCalculationNode*)base
    var children = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&children, this.m_min_value)
    ak.vector_append_t(&children, this.m_center_value)
    ak.vector_append_t(&children, this.m_max_value)
    return children

