## The raw value of a numeric node's value: the number, the percentage as a fraction, or the dimension's raw value.
func css_numeric_node_raw_value_or_fraction(numeric_child: CssNumericCalculationNode*) -> f64:
    match numeric_child.m_value:
        .number(number): return css_syntax.number_value(&number)
        .css_percentage(percentage): return css_percentage_as_fraction(&percentage)
        _: return css_numeric_value_dimension_raw_value(&numeric_child.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1493 Web::CSS::SignCalculationNode::run_operation_if_possible (override).
# https://drafts.csswg.org/css-values-4/#funcdef-sign
pub func css_sign_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, arg0: CssCalculationContext, arg1: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    discard(arg0)
    discard(arg1)
    let this = (CssSignCalculationNode*)base
    # The sign(A) function contains one calculation A, and returns -1 if A’s numeric value is negative,
    # +1 if A’s numeric value is positive, 0⁺ if A’s numeric value is 0⁺, and 0⁻ if A’s numeric value is 0⁻.
    # The return type is a <number>, made consistent with the input calculation’s type.

    if css_calculation_node_type(this.m_value) != CssCalculationNodeType.numeric:
        return none
    let numeric_child = as_css_numeric_calculation_node(this.m_value)
    let raw_value = css_numeric_node_raw_value_or_fraction(numeric_child)

    let empty_type = CssNumericType()
    let return_type = css_numeric_type_made_consistent_with(&empty_type, css_calculation_node_numeric_type(numeric_child.css_calculation_node()) else CssNumericType())

    # https://drafts.csswg.org/css-values-4/#calc-ieee
    # Any operation with at least one NaN argument produces NaN.
    if math.is_nan(raw_value):
        return css_calculated_style_value_calculation_result_new(math.nan, return_type)

    var sign = 0.0
    if raw_value < 0.0:
        sign = -1.0
    elif raw_value > 0.0:
        sign = 1.0
    else:
        sign = -0.0 if math.signbit(raw_value) else 0.0

    return css_calculated_style_value_calculation_result_new(sign, return_type)

