## Ported from Libraries/LibWeb/CSS/StyleValues/DimensionStyleValue.h:26 Web::CSS::DimensionStyleValue::DimensionStyleValue.
pub func css_dimension_style_value_construct(this: CssDimensionStyleValue*, type_: CssStyleValueType):
    css_style_value_construct(this.css_style_value(), type_)

## Ported from Libraries/LibWeb/CSS/StyleValues/DimensionStyleValue.h:20 Web::CSS::DimensionStyleValue::raw_value (virtual).
pub func css_dimension_style_value_raw_value_impl(this: CssDimensionStyleValue*) -> f64:
    discard(this)
    trap("pure virtual: Web::CSS::DimensionStyleValue::raw_value")

## Ported from Libraries/LibWeb/CSS/StyleValues/DimensionStyleValue.h:21 Web::CSS::DimensionStyleValue::unit_name (virtual).
pub func css_dimension_style_value_unit_name_impl(this: CssDimensionStyleValue*) -> ak.FlyString:
    discard(this)
    trap("pure virtual: Web::CSS::DimensionStyleValue::unit_name")

## Ported from Libraries/LibWeb/CSS/StyleValues/DimensionStyleValue.cpp:12 Web::CSS::DimensionStyleValue::tokenize (override).
pub func css_dimension_style_value_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    let this = (CssDimensionStyleValue*)base
    var values = ak.Vector[css_syntax.ComponentValue]()
    if css_style_value_is_percentage(base):
        ak.vector_append_t(&values, css_syntax.component_value_from_token(css_syntax.token_create_percentage(css_syntax.number_create(css_syntax.NumberType.number, css_dimension_style_value_raw_value(this)), ak.String())))
        return values
    ak.vector_append_t(&values, css_syntax.component_value_from_token(css_syntax.token_create_dimension_f64(css_dimension_style_value_raw_value(this), css_dimension_style_value_unit_name(this), ak.String())))
    return values

# https://drafts.css-houdini.org/css-typed-om-1/#reify-a-numeric-value
## Ported from Libraries/LibWeb/CSS/StyleValues/DimensionStyleValue.cpp:20 Web::CSS::DimensionStyleValue::reify (override).
pub func css_dimension_style_value_reify_impl(base: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    discard(associated_property)
    let this = (CssDimensionStyleValue*)base
    # NB: Steps 1 and 2 don't apply here.
    # 3. Return a new CSSUnitValue with its value internal slot set to the numeric value of num, and its unit internal
    #    slot set to "number" if num is a <number>, "percent" if num is a <percentage>, and num’s unit if num is a
    #    <dimension>.
    #    If the value being reified is a computed value, the unit used must be the appropriate canonical unit for the
    #    value’s type, with the numeric value scaled accordingly.
    # FIXME: Reify computed value correctly. That sounds like it should work by computing the value properly before we
    #        reach this point.
    return (CssCssStyleValue*)css_unit_value_create(realm, css_dimension_style_value_raw_value(this), css_dimension_style_value_unit_name(this))
