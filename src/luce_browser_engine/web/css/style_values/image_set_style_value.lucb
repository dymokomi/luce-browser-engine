## Ported from Libraries/LibWeb/CSS/StyleValues/ImageSetStyleValue.cpp:201 Web::CSS::ImageSetStyleValue::resolve_for_size (override).
pub func css_image_set_style_value_resolve_for_size_impl(base: CssAbstractImageStyleValue*, layout_node: LayoutNodeWithStyle*, size: gfx.CssPixelSize):
    let this = (CssImageSetStyleValue*)base
    css_image_set_style_value_update_selected_image_for_layout_node(this, layout_node)
    if let selected_image = this.m_selected_image:
        css_abstract_image_style_value_resolve_for_size(selected_image, layout_node, size)

