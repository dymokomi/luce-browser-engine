## Ported from Libraries/LibWeb/CSS/StyleValues/ImageSetStyleValue.h:47 Web::CSS::ImageSetStyleValue::selected_image.
pub func css_image_set_style_value_selected_image(this: CssImageSetStyleValue*) -> CssAbstractImageStyleValue*?:
    return this.m_selected_image

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageSetStyleValue.cpp:228 Web::CSS::ImageSetStyleValue::set_style_sheet (override).
pub func css_image_set_style_value_set_style_sheet_impl(base: CssStyleValue*, style_sheet: CssCssStyleSheet*?):
    let this = (CssImageSetStyleValue*)base
    css_style_value_set_style_sheet_impl(base, style_sheet)
    this.m_style_sheet = style_sheet

    # Propagate the style sheet to candidate images whose type() filter does not exclude them. This ensures the
    # candidate images register themselves as pending image resources on the style sheet, so their fetches start when
    # the style sheet is associated with the document, properly delaying the document's load event.
    for option in ak.vector_span_const(&this.m_options):
        if css_image_set_option_is_excluded_by_type(&option):
            continue
        css_style_value_set_style_sheet(option.image.css_style_value(), style_sheet)

## Ported from Libraries/LibWeb/CSS/StyleValues/ImageSetStyleValue.cpp:243 Web::CSS::ImageSetStyleValue::absolutized (override).
pub func css_image_set_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssImageSetStyleValue*)base
    var options = ak.Vector[CssImageSetStyleValueOption]()
    ak.vector_ensure_capacity(&options, ak.vector_size(&this.m_options))
    for option in ak.vector_span_const(&this.m_options):
        let image = css_style_value_absolutized(option.image.css_style_value(), context)
        assert(css_style_value_is_abstract_image(image))
        ak.vector_append_t(&options, CssImageSetStyleValueOption(image = css_style_value_as_abstract_image(image), resolution = css_style_value_absolutized(option.resolution, context), type_ = option.type_))
    return css_image_set_style_value_create(options).css_style_value()
