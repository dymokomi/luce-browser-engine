## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:19 Web::CSS::FrequencyStyleValue::create.
pub func css_frequency_style_value_create(frequency: CssFrequency) -> CssFrequencyStyleValue*:
    let this = &(alloc CssFrequencyStyleValue[1] else trap("out of memory"))[0]
    css_frequency_style_value_construct(this, frequency)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:25 Web::CSS::FrequencyStyleValue::frequency.
pub func css_frequency_style_value_frequency(this: CssFrequencyStyleValue*) -> CssFrequency:
    return this.m_frequency

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:26 Web::CSS::FrequencyStyleValue::raw_value (override).
pub func css_frequency_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssFrequencyStyleValue*)base
    return css_frequency_raw_value(&this.m_frequency)

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:27 Web::CSS::FrequencyStyleValue::unit_name (override).
pub func css_frequency_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssFrequencyStyleValue*)base
    return css_frequency_unit_name(&this.m_frequency)

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:29 Web::CSS::FrequencyStyleValue::serialize (override).
pub func css_frequency_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssFrequencyStyleValue*)base
    css_frequency_serialize(&this.m_frequency, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:31 Web::CSS::FrequencyStyleValue::equals (override).
pub func css_frequency_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssFrequencyStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_frequency = css_style_value_as_frequency(other)
    return css_frequency_eq(&this.m_frequency, other_frequency.m_frequency)

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:39 Web::CSS::FrequencyStyleValue::is_computationally_independent (override).
pub func css_frequency_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/FrequencyStyleValue.h:42 Web::CSS::FrequencyStyleValue::FrequencyStyleValue.
pub func css_frequency_style_value_construct(this: CssFrequencyStyleValue*, frequency: CssFrequency):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.frequency)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_frequency_style_value_vtable, &css_frequency_style_value_class)
    this.m_frequency = frequency
