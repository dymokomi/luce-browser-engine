## Ported from Libraries/LibWeb/CSS/StyleValues/ComputationContext.h:20 Web::CSS::ComputationContext::visit_edges.
pub func css_computation_context_visit_edges(this: CssComputationContext*, visitor: gc.CellVisitor*):
    if let abstract_element = this.abstract_element:
        dom_abstract_element_visit(&abstract_element, visitor)
