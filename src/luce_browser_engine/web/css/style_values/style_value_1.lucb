## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:178 Web::CSS::StyleValue::equals (virtual).
pub func css_style_value_equals_impl(this: CssStyleValue*, other: CssStyleValue*) -> bool:
