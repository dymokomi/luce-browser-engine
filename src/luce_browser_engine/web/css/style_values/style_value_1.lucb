# https://drafts.css-houdini.org/css-properties-values-api/#computationally-independent
# A property value is computationally independent if it can be converted into a computed value using only the value
# of the property on the element, and "global" information that cannot be changed by CSS.
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:188 Web::CSS::StyleValue::is_computationally_independent (virtual).
pub func css_style_value_is_computationally_independent_impl(this: CssStyleValue*) -> bool:
    discard(this)
    trap("pure virtual: Web::CSS::StyleValue::is_computationally_independent")

# mark: Free functions ==========================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:188 Web::CSS::int_from_style_value.
pub func css_int_from_style_value(style_value: CssStyleValue*) -> i32:
    if css_style_value_is_integer(style_value):
        return css_integer_style_value_integer(css_style_value_as_integer(style_value))

    if css_style_value_is_calculated(style_value):
        return css_calculated_style_value_resolve_integer(css_style_value_as_calculated(style_value), CssCalculationResolutionContext()) else trap("VERIFY: a resolved integer")

    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:199 Web::CSS::number_from_style_value.
pub func css_number_from_style_value(style_value: CssStyleValue*, percentage_basis: f64?) -> f64:
    if css_style_value_is_number(style_value):
        return css_number_style_value_number(css_style_value_as_number(style_value))

    if css_style_value_is_calculated(style_value):
        let calculated_style_value = css_style_value_as_calculated(style_value)

        if css_calculated_style_value_resolves_to_number(calculated_style_value):
            return css_calculated_style_value_resolve_number(calculated_style_value, CssCalculationResolutionContext()) else trap("VERIFY: a resolved number")

        if css_calculated_style_value_resolves_to_percentage(calculated_style_value):
            let basis = percentage_basis else trap("VERIFY: a percentage basis")

            let percentage = css_calculated_style_value_resolve_percentage(calculated_style_value, CssCalculationResolutionContext()) else trap("VERIFY: a resolved percentage")
            return css_percentage_as_fraction(&percentage) * basis

        trap("VERIFY_NOT_REACHED")

    if css_style_value_is_percentage(style_value):
        let basis = percentage_basis else trap("VERIFY: a percentage basis")

        let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(style_value))
        return basis * css_percentage_as_fraction(&percentage)

    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:228 Web::CSS::string_from_style_value.
pub func css_string_from_style_value(style_value: CssStyleValue*) -> ak.FlyString:
    if css_style_value_is_string(style_value):
        return css_string_style_value_string_value(css_style_value_as_string(style_value))

    if css_style_value_is_custom_ident(style_value):
        return css_custom_ident_style_value_custom_ident(css_style_value_as_custom_ident(style_value))

    trap("VERIFY_NOT_REACHED")

# mark: Comparison helpers ======================================================================

## Optional<FlyString>'s operator== (both absent, or both present and equal), for the
## `operator==(...) const = default`s of the values' Properties.
pub func css_optional_fly_strings_equal(a: ak.FlyString?, b: ak.FlyString?) -> bool:
    if let left = a:
        if let right = b:
            return ak.fly_string_eq_fly_string(&left, &right)
        return false
    return b == none

## `builder.appendff(fmtstr, arguments...)` for the style values: AK's format string over ak's
## type-erased arguments (DESIGN.md §2.11).
pub func css_appendff(builder: ak.StringBuilder*, fmtstr: str, arguments: const ak.TypeErasedParameter[]):
    ak.vformat_arguments(builder, ak.sv(fmtstr), arguments) else trap("MUST: StringBuilder::appendff")
