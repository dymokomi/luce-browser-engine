## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:158 Web::CSS::StyleValue::has_auto.
pub func css_style_value_has_auto(this: CssStyleValue*) -> bool:
    return css_style_value_is_keyword(this) and css_keyword_style_value_keyword(css_style_value_as_keyword(this)) == css_data.Keyword.auto

