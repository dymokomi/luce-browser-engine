#==============================================================================================
#
#   style_value_1 - StyleValue: the base of every CSS value, and the helpers on values
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/StyleValues/StyleValue.cpp (lines 1-139, 152-237) and the inline
#       members of StyleValue.h (lines 1-243) other than the per-type `is_*`/`as_*` of
#       ENUMERATE_CSS_STYLE_VALUE_TYPES (style_value_2, style_value_3). StyleValue is reference
#       counted in C++; here values live in managed memory (DESIGN.md §3.3) with the same
#       embedded-base, type and vtable scheme as cells (§2.3): a value's `vtable` and
#       `class_id` are set by its most-derived constructor, as the C++ vptr is.
#       StyleValueWithDefaultOperators<T>::equals is ported as its instantiations, one
#       `<class>_equals_impl` per class in that class's fragment.
#
#       Copyright (c) 2018-2025, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2021-2025, Sam Atkins <sam@ladybird.org>
#       Copyright (c) 2021, Tobias Christiansen <tobyase@serenityos.org>
#       Copyright (c) 2022-2023, MacDue <macdue@dueutil.tech>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: ColorResolutionContext ==================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:94 Web::CSS::ColorResolutionContext::for_element.
pub func css_color_resolution_context_for_element(element: DomAbstractElement) -> CssColorResolutionContext:
    let computed_properties = dom_abstract_element_computed_properties(&element) else trap("VERIFY: computed properties")
    let document = dom_abstract_element_document(&element)
    let supported_color_schemes = dom_document_supported_color_schemes(document)
    var document_supported_schemes: const ak.Vector[ak.String]*? = none
    if let schemes = supported_color_schemes:
        document_supported_schemes = &schemes
    let color_scheme = css_computed_properties_color_scheme(computed_properties, page_preferred_color_scheme(dom_document_page(document)), document_supported_schemes)

    let calculation_resolution_context = CssCalculationResolutionContext(length_resolution_context = css_length_resolution_context_for_element(element))

    # NB: C++ builds this context twice, once for each call below.
    let resolution_context = CssColorResolutionContext(color_scheme = color_scheme, current_color = css_initial_values_color(), accent_color = css_system_color_accent_color(color_scheme), document = document, calculation_resolution_context = calculation_resolution_context)
    return CssColorResolutionContext(
        color_scheme = color_scheme,
        current_color = css_computed_properties_color(computed_properties, css_data.PropertyId.color, resolution_context),
        accent_color = css_computed_properties_accent_color(computed_properties, resolution_context),
        document = document,
        calculation_resolution_context = calculation_resolution_context,
    )

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:109 Web::CSS::ColorResolutionContext::for_layout_node_with_style.
pub func css_color_resolution_context_for_layout_node_with_style(layout_node: LayoutNodeWithStyle*) -> CssColorResolutionContext:
    let computed_values = layout_node_with_style_computed_values(layout_node)
    return CssColorResolutionContext(
        color_scheme = css_computed_values_color_scheme(&computed_values.computed_values),
        current_color = css_computed_values_color(&computed_values.computed_values),
        accent_color = css_computed_values_accent_color(&computed_values.computed_values),
        document = layout_node_document((LayoutNode*)layout_node),
        calculation_resolution_context = CssCalculationResolutionContext(length_resolution_context = css_length_resolution_context_for_layout_node((LayoutNode*)layout_node)),
    )

# mark: StyleValue ==============================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:120 Web::CSS::StyleValue::StyleValue.
pub func css_style_value_construct(this: CssStyleValue*, type_: CssStyleValueType):
    this.m_type = type_

## The value's vtable and class id: what the C++ vptr of the most-derived class gives it. Each
## most-derived constructor calls this after its base constructor.
pub func css_style_value_set_class(this: CssStyleValue*, vtable: const CssStyleValueVTable*, info: const ak.ClassInfo*):
    this.vtable = vtable
    this.class_id = info.first_id

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:125 Web::CSS::StyleValue::to_string.
pub func css_style_value_to_string(this: CssStyleValue*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_style_value_serialize(this, &builder, mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:127 Web::CSS::StyleValue::type.
pub func css_style_value_type(this: CssStyleValue*) -> CssStyleValueType:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:129 Web::CSS::StyleValue::is_abstract_image.
pub func css_style_value_is_abstract_image(this: CssStyleValue*) -> bool:
    let type_ = css_style_value_type(this)
    return type_ == CssStyleValueType.image or type_ == CssStyleValueType.image_set or type_ == CssStyleValueType.linear_gradient or type_ == CssStyleValueType.conic_gradient or type_ == CssStyleValueType.radial_gradient

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:132 Web::CSS::StyleValue::as_abstract_image.
pub func css_style_value_as_abstract_image_const(this: CssStyleValue*) -> CssAbstractImageStyleValue*:
    assert(css_style_value_is_abstract_image(this))
    return (CssAbstractImageStyleValue*)this

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:134 Web::CSS::StyleValue::as_abstract_image.
pub func css_style_value_as_abstract_image(this: CssStyleValue*) -> CssAbstractImageStyleValue*:
    return css_style_value_as_abstract_image_const(this)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:136 Web::CSS::StyleValue::is_dimension.
pub func css_style_value_is_dimension(this: CssStyleValue*) -> bool:
    let type_ = css_style_value_type(this)
    return type_ == CssStyleValueType.angle or type_ == CssStyleValueType.flex or type_ == CssStyleValueType.frequency or type_ == CssStyleValueType.length or type_ == CssStyleValueType.percentage or type_ == CssStyleValueType.resolution or type_ == CssStyleValueType.time

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:138 Web::CSS::StyleValue::as_dimension.
pub func css_style_value_as_dimension_const(this: CssStyleValue*) -> CssDimensionStyleValue*:
    assert(css_style_value_is_dimension(this))
    return (CssDimensionStyleValue*)this

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:141 Web::CSS::StyleValue::as_dimension.
pub func css_style_value_as_dimension(this: CssStyleValue*) -> CssDimensionStyleValue*:
    return css_style_value_as_dimension_const(this)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:143 Web::CSS::StyleValue::is_color_function (virtual).
pub func css_style_value_is_color_function_impl(this: CssStyleValue*) -> bool:
    discard(this)
    return false

# https://www.w3.org/TR/css-values-4/#common-keywords
# https://drafts.csswg.org/css-cascade-4/#valdef-all-revert
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:154 Web::CSS::StyleValue::is_css_wide_keyword.
pub func css_style_value_is_css_wide_keyword(this: CssStyleValue*) -> bool:
    return css_style_value_is_inherit(this) or css_style_value_is_initial(this) or css_style_value_is_revert(this) or css_style_value_is_unset(this) or css_style_value_is_revert_layer(this)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:155 Web::CSS::StyleValue::is_inherit.
pub func css_style_value_is_inherit(this: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(this) == css_data.Keyword.inherit

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:156 Web::CSS::StyleValue::is_initial.
pub func css_style_value_is_initial(this: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(this) == css_data.Keyword.initial

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:157 Web::CSS::StyleValue::is_revert.
pub func css_style_value_is_revert(this: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(this) == css_data.Keyword.revert

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:158 Web::CSS::StyleValue::is_revert_layer.
pub func css_style_value_is_revert_layer(this: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(this) == css_data.Keyword.revert_layer

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:159 Web::CSS::StyleValue::is_unset.
pub func css_style_value_is_unset(this: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(this) == css_data.Keyword.unset

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:153 Web::CSS::StyleValue::absolutized (virtual).
pub func css_style_value_absolutized_impl(this: CssStyleValue*, arg0: CssComputationContext) -> CssStyleValue*:
