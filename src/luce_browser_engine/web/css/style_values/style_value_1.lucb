## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:170 Web::CSS::StyleValue::serialize (virtual).
pub func css_style_value_serialize_impl(this: CssStyleValue*, arg0: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(this)
    discard(arg0)
    discard(arg1)
    trap("pure virtual: Web::CSS::StyleValue::serialize")

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:163 Web::CSS::StyleValue::tokenize (virtual).
pub func css_style_value_tokenize_impl(this: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    # This is an inefficient way of producing ComponentValues, but it's guaranteed to work for types that round-trip.
    # FIXME: Implement better versions in the subclasses.
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_css_parsing_mode(&parsing_params)
    let string = css_style_value_to_string(this, css_syntax.SerializationMode.normal)
    var parser = css_parser_create(parsing_params, ak.string_bytes_as_string_view(&string))
    return css_parser_parse_as_list_of_component_values(&parser)

# https://drafts.css-houdini.org/css-typed-om-1/#reify-as-a-cssstylevalue
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:171 Web::CSS::StyleValue::reify (virtual).
pub func css_style_value_reify_impl(this: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    # 1. Return a new CSSStyleValue object representing value whose [[associatedProperty]] internal slot is set to property.
    return css_css_style_value_create(realm, associated_property, this)

# https://drafts.css-houdini.org/css-typed-om-1/#subdivide-into-iterations
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.cpp:178 Web::CSS::StyleValue::subdivide_into_iterations (virtual).
pub func css_style_value_subdivide_into_iterations_impl(this: CssStyleValue*, arg0: CssPropertyNameAndId) -> ak.Vector[CssStyleValue*]:
    discard(arg0)
    # To subdivide into iterations a CSS value whole value for a property property, execute the following steps:
    # 1. If property is a single-valued property, return a list containing whole value.
    # 2. Otherwise, divide whole value into individual iterations, as appropriate for property, and return a list
    #    containing the iterations in order.
    # NB: We do this by type. By default, we assume step 1 applies. For step 2, override this method.
    var values = ak.Vector[CssStyleValue*]()
    ak.vector_append_t(&values, this)
    return values

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:175 Web::CSS::StyleValue::set_style_sheet (virtual).
