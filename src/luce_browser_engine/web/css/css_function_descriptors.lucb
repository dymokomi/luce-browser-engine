## Ported from Libraries/LibWeb/CSS/CSSFunctionDescriptors.h:27 Web::CSS::CSSFunctionDescriptors::CSSFunctionDescriptors.
pub func css_function_descriptors_construct(this: CssFunctionDescriptors*, realm: Realm*, descriptors: ak.Vector[CssDescriptor]):
    css_descriptors_construct(this.css_descriptors(), realm, css_data.AtRuleId.function, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSFunctionDescriptors.cpp:14 Web::CSS::CSSFunctionDescriptors::create.
pub func css_function_descriptors_create(realm: Realm*, descriptors: ak.Vector[CssDescriptor]) -> CssFunctionDescriptors*:
    return realm_create_css_function_descriptors(realm, realm, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSFunctionDescriptors.cpp:19 Web::CSS::CSSFunctionDescriptors::initialize (override).
pub func css_function_descriptors_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_function_descriptors)
    css_style_declaration_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSFunctionDescriptors.cpp:26 Web::CSS::CSSFunctionDescriptors::result.
# https://drafts.csswg.org/css-mixins-1/#dom-cssfunctiondescriptors-result
pub func css_function_descriptors_result(this: CssFunctionDescriptors*) -> ak.String:
    return css_style_declaration_get_property_value(this.css_style_declaration(), ak.fly_string_from_str("result"))

## Ported from Libraries/LibWeb/CSS/CSSFunctionDescriptors.cpp:32 Web::CSS::CSSFunctionDescriptors::set_result.
# https://drafts.csswg.org/css-mixins-1/#dom-cssfunctiondescriptors-result
pub func css_function_descriptors_set_result(this: CssFunctionDescriptors*, value: ak.StringView) -> !:
    try css_style_declaration_set_property(this.css_style_declaration(), ak.fly_string_from_str("result"), value, ak.sv(""))
