## Ported from Libraries/LibWeb/CSS/ComputedValues.h:1041 Web::CSS::MutableComputedValues::set_border_bottom_left_radius.
pub func css_mutable_computed_values_set_border_bottom_left_radius(this: CssMutableComputedValues*, value: CssBorderRadiusData):
    if css_border_radius_data_is_initial(&value) and not this.computed_values.m_noninherited.has_noninitial_border_radii:
        return
    this.computed_values.m_noninherited.has_noninitial_border_radii = true
    this.computed_values.m_noninherited.border_bottom_left_radius = value

