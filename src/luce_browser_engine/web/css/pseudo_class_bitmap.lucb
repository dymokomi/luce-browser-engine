#==============================================================================================
#
#   pseudo_class_bitmap - a set of pseudo-classes as a bitmap
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/PseudoClassBitmap.h (lines 1-51): its inline members. The storage
#       (`m_bits`, two words for the 65 pseudo-classes) is types_pseudo_class_bitmap's.
#
#       Copyright (c) 2025, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/CSS/PseudoClassBitmap.h:22 Web::CSS::PseudoClassBitmap::set.
pub func css_pseudo_class_bitmap_set(this: CssPseudoClassBitmap*, pseudo_class: css_data.PseudoClass, bit: bool):
    let index = (usize)pseudo_class
    let word_index = index // css_pseudo_class_bitmap_bits_per_word
    let bit_index = index % css_pseudo_class_bitmap_bits_per_word
    if bit:
        this.m_bits[word_index] |= 1u64 << bit_index
    else:
        this.m_bits[word_index] &= ~(1u64 << bit_index)

## Ported from Libraries/LibWeb/CSS/PseudoClassBitmap.h:33 Web::CSS::PseudoClassBitmap::get.
pub func css_pseudo_class_bitmap_get(this: const CssPseudoClassBitmap*, pseudo_class: css_data.PseudoClass) -> bool:
    let index = (usize)pseudo_class
    let word_index = index // css_pseudo_class_bitmap_bits_per_word
    let bit_index = index % css_pseudo_class_bitmap_bits_per_word
    return (this.m_bits[word_index] & (1u64 << bit_index)) != 0

## Ported from Libraries/LibWeb/CSS/PseudoClassBitmap.h:41 Web::CSS::PseudoClassBitmap::operator|=.
pub func css_pseudo_class_bitmap_or_assign(this: CssPseudoClassBitmap*, other: CssPseudoClassBitmap):
    for i in 0..<css_pseudo_class_bitmap_word_count:
        this.m_bits[i] |= other.m_bits[i]
