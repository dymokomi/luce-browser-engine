## Ported from Libraries/LibWeb/CSS/PreferredContrast.cpp:11 Web::CSS::preferred_contrast_from_string.
pub func css_preferred_contrast_from_string(value: ak.StringView) -> CssPreferredContrast:
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("less")):
        return CssPreferredContrast.less
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("more")):
        return CssPreferredContrast.more
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("no-preference")):
        return CssPreferredContrast.no_preference
    return CssPreferredContrast.auto

## Ported from Libraries/LibWeb/CSS/PreferredContrast.cpp:22 Web::CSS::preferred_contrast_to_string.
pub func css_preferred_contrast_to_string(value: CssPreferredContrast) -> ak.StringView:
    match value:
        .auto: return ak.sv("auto")
        .less: return ak.sv("less")
        .more: return ak.sv("more")
        .no_preference: return ak.sv("no-preference")
        _: trap("VERIFY_NOT_REACHED")
