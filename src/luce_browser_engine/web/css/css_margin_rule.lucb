## Ported from Libraries/LibWeb/CSS/CSSMarginRule.h:24 Web::CSS::CSSMarginRule::name.
pub func css_margin_rule_name(this: CssMarginRule*) -> ak.String:
    return ak.fly_string_to_string_const(&this.m_name)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.h:25 Web::CSS::CSSMarginRule::style.
pub func css_margin_rule_style(this: CssMarginRule*) -> CssStyleProperties*:
    return this.m_style

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.h:26 Web::CSS::CSSMarginRule::style (const).
pub func css_margin_rule_style_const(this: CssMarginRule*) -> CssStyleProperties*:
    return this.m_style

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:16 Web::CSS::CSSMarginRule::create.
pub func css_margin_rule_create(realm: Realm*, name: ak.FlyString, style: CssStyleProperties*) -> CssMarginRule*:
    return realm_create_css_margin_rule(realm, realm, name, style)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:21 Web::CSS::CSSMarginRule::CSSMarginRule.
pub func css_margin_rule_construct(this: CssMarginRule*, realm: Realm*, name: ak.FlyString, style: CssStyleProperties*):
    css_rule_construct(this.css_rule(), realm, CssRuleType.margin)
    this.m_name = ak.fly_string_to_ascii_lowercase(&name)
    this.m_style = style
    css_style_declaration_set_parent_rule(this.m_style.css_style_declaration(), this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:29 Web::CSS::CSSMarginRule::initialize (override).
pub func css_margin_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_margin_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:35 Web::CSS::CSSMarginRule::serialized (override).
pub func css_margin_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssMarginRule*)base
    # AD-HOC: There is currently no spec for serializing CSSMarginRule.
    var builder = ak.string_builder_new()
    dump_appendff(&builder, "@{} {{ ", [css_arg_fly_string(&this.m_name)])
    let style = this.m_style.css_style_declaration()
    if css_style_declaration_length(style) > 0:
        let text = css_style_declaration_serialized(style)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))
        ak.string_builder_append_u8(&builder, ' ')
    ak.string_builder_append_u8(&builder, '}')

    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:48 Web::CSS::CSSMarginRule::visit_edges (override).
pub func css_margin_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssMarginRule*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_style)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:54 Web::CSS::CSSMarginRule::dump (override).
pub func css_margin_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssMarginRule*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    let name = css_margin_rule_name(this)
    dump_appendff(builder, "Name: {}\n", [css_arg_string(&name)])
    dump_style_properties(builder, css_margin_rule_style_const(this), indent_levels + 1)

## Ported from Libraries/LibWeb/CSS/CSSMarginRule.cpp:64 Web::CSS::is_margin_rule_name.
# https://drafts.csswg.org/css-page-3/#syntax-page-selector
pub func css_is_margin_rule_name(name: ak.StringView) -> bool:
    return (ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("top-left-corner")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("top-left")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("top-center")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("top-right")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("top-right-corner")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("bottom-left-corner")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("bottom-left")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("bottom-center")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("bottom-right")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("bottom-right-corner")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("left-top")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("left-middle")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("left-bottom")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("right-top")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("right-middle")) or ak.string_view_equals_ignoring_ascii_case(&name, ak.sv("right-bottom")))
