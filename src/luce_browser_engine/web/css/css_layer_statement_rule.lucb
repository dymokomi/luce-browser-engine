## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.h:25 Web::CSS::CSSLayerStatementRule::name_list.
# FIXME: Should be FrozenArray
pub func css_layer_statement_rule_name_list(this: CssLayerStatementRule*) -> const ak.FlyString[]:
    return ak.vector_span_const(&this.m_name_list)

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:16 Web::CSS::CSSLayerStatementRule::create.
pub func css_layer_statement_rule_create(realm: Realm*, name_list: ak.Vector[ak.FlyString]) -> CssLayerStatementRule*:
    return realm_create_css_layer_statement_rule(realm, realm, name_list)

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:21 Web::CSS::CSSLayerStatementRule::CSSLayerStatementRule.
pub func css_layer_statement_rule_construct(this: CssLayerStatementRule*, realm: Realm*, name_list: ak.Vector[ak.FlyString]):
    css_rule_construct(this.css_rule(), realm, CssRuleType.layer_statement)
    this.m_name_list = name_list

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:27 Web::CSS::CSSLayerStatementRule::initialize (override).
pub func css_layer_statement_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_layer_statement_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:33 Web::CSS::CSSLayerStatementRule::serialized (override).
pub func css_layer_statement_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssLayerStatementRule*)base
    # AD-HOC: No spec yet.
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "@layer ")
    ak.string_builder_join_fly_string(&builder, ak.sv(", "), ak.vector_span_const(&this.m_name_list))
    ak.string_builder_append_u8(&builder, ';')
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:43 Web::CSS::CSSLayerStatementRule::internal_qualified_name_list.
pub func css_layer_statement_rule_internal_qualified_name_list(this: CssLayerStatementRule*) -> ak.Vector[ak.FlyString]:
    var qualified_layer_names: ak.Vector[ak.FlyString]

    let qualified_parent_layer_name = css_rule_parent_layer_internal_qualified_name(this.css_rule())
    if ak.fly_string_is_empty(&qualified_parent_layer_name):
        return ak.vector_clone(&this.m_name_list)

    for name in ak.vector_span(&this.m_name_list):
        ak.vector_append_t(&qualified_layer_names, ak.fly_string_from_string(css_string_formatted("{}.{}", [css_arg_fly_string(&qualified_parent_layer_name), css_arg_fly_string(&name)])))

    return qualified_layer_names

## Ported from Libraries/LibWeb/CSS/CSSLayerStatementRule.cpp:57 Web::CSS::CSSLayerStatementRule::dump (override).
pub func css_layer_statement_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssLayerStatementRule*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    ak.string_builder_append(builder, "Names: ")
    ak.string_builder_join_fly_string(builder, ak.sv(", "), css_layer_statement_rule_name_list(this))
