    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a::before", "", "", ""], expected = "  plan .a {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [":host(.x) .y", "", "", ""], expected = "  plan .x {self desc([.y] => {self }) }\n  plan .y {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a:has(.b):has(#c)", "", "", ""], expected = "  plan .a {self }\n  plan :has {self }\n  has-id c: #c/1\n  has-class b: .b/1\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = ["section:has(> h1.title)", "", "", ""], expected = "  plan :has {self }\n  plan section {self }\n  has-class title: > h1.title/0\n  has-tag h1: > h1.title/0\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a .b, .c .b", "", "", ""], expected = "  plan .a {desc([.b] => {self }) }\n  plan .b {self }\n  plan .c {desc([.b] => {self }) }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".x || .y", "", "", ""], expected = "  plan .x {subtree }\n  plan .y {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [":root .a", "", "", ""], expected = "  plan .a {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [":defined", "", "", ""], expected = "  plan :defined {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a:has(:checked, :required)", "", "", ""], expected = "  plan .a {self }\n  plan :has {self }\n  has-pseudo checked: :checked/1\n  has-pseudo required: :required/1\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".p .q + .r ~ .s > .t", "", "", ""], expected = "  plan .p {desc([.q] => {adjacent([.r] => {subsequent([.s] => {desc([.t] => {self }) }) }) }) }\n  plan .q {adjacent([.r] => {subsequent([.s] => {desc([.t] => {self }) }) }) }\n  plan .r {subsequent([.s] => {desc([.t] => {self }) }) }\n  plan .s {desc([.t] => {self }) }\n  plan .t {self }\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a {}", "", "", ""], expected = "  set [.a]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a .b {}", "", "", ""], expected = "  set [.b]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a, #b {}", "", "", ""], expected = "  set [#b .a]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = ["* {}", "", "", ""], expected = "  set [*]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a::before {}", "", "", ""], expected = "  set [.a]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a .b::after {}", "", "", ""], expected = "  set [.b]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a > * {}", "", "", ""], expected = "  set []\n  may-match-shadow-host false\n  may-match-light-dom false\n  trailing-universal-rule [.a] - 1\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a + * {}", "", "", ""], expected = "  set []\n  may-match-shadow-host false\n  may-match-light-dom false\n  trailing-universal-rule [.a] - 3\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a * {}", "", "", ""], expected = "  set []\n  may-match-shadow-host false\n  may-match-light-dom false\n  trailing-universal-rule [.a] - 2\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = ["* > * {}", "", "", ""], expected = "  set [*]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
