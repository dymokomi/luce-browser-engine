    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.a article#b article#c)", ".a:has(+ .b) { color: red }", "attr #b class b", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a N--\n  article#b ---\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.a article#b article#c)", ".a:has(~ .z) { color: red }", "attr #c class z", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a N--\n  article#b ---\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a article#b article#c)", "article:nth-child(2) { color: red }", "before #a article#n", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#n N--\n  article#a N--\n  article#b N--\n  article#c N--\n"),
