    TestMediaInvalidationCase(mode = "media", arguments = ["only screen", "", "", ""], expected = "  list: screen\n  query: screen\n    matches: true\n    dump: Media condition: (matches = true)\n    dump:   Negated: false\n    dump:   Type: screen\n"),
