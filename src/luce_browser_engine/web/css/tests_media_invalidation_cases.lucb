    TestMediaInvalidationCase(mode = "container", arguments = ["@container (foo: bar) { a {} }", "", "", ""], expected = "  query: (foo: bar)\n    matches: false\n    dump: Container query: (matches = false)\n    dump:   GeneralEnclosed: (foo: bar)\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a", "", "", ""], expected = "  plan .a {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = ["#b", "", "", ""], expected = "  plan #b {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = ["div", "", "", ""], expected = "  plan div {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = ["[data-x]", "", "", ""], expected = "  plan [data-x] {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = ["*", "", "", ""], expected = ""),
