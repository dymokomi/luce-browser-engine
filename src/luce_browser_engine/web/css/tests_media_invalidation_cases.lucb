    TestMediaInvalidationCase(mode = "lightdom", arguments = ["::slotted(.x)", "", "", ""], expected = "  may-match-light-dom true\n"),
    TestMediaInvalidationCase(mode = "lightdom", arguments = [".a", "", "", ""], expected = "  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "lightdom", arguments = [":host .x, .y", "", "", ""], expected = "  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "lightdom", arguments = [":bogus", "", "", ""], expected = "  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.x(b#b1 i#i1) article#c(b#b2))", ".x b { color: red }", "attr #c class x", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  i#i1 ---\n  article#c -C-\n  b#b2 N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.x(b#b1 i#i1) article#c(b#b2))", ".x b { color: red }", "attr #a class y", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a -C-\n  b#b1 N--\n  i#i1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ".y { color: red }", "attr #b1 class y", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a -C-\n  b#b1 N--\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "#c > b { color: red }", "attr #a id c", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#c -C-\n  b#b1 N--\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "[data-x] i { color: red }", "attr #r data-x 1", ""], expected = "  full: false\n  document ---\n  section#r ---\n  article#a ---\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ".z { color: red }", "attr #a class q", ""], expected = "  full: false\n  document ---\n  section#r ---\n  article#a ---\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ".a + .b { color: red }", "attr #a class a", ""], expected = "  full: false\n  document ---\n  section#r ---\n  article#a ---\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.a(b#b1) article#c.b(b#b2) article#d.b)", ".a ~ .b { color: red }", "rmattr #a class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  article#c N--\n  b#b2 ---\n  article#d N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "b { color: red }", "append #a i#n1", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a NC-\n  b#b1 ---\n  i#n1 N--\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2) article#d)", "article:first-child { color: red }", "before #a article#n", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#n N--\n  article#a N--\n  b#b1 ---\n  article#c N--\n  b#b2 ---\n  article#d N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2) article#d)", "article:last-child { color: red }", "remove #d", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#a N--\n  b#b1 ---\n  article#c N--\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2) article#d)", "article + article { color: red }", "remove #a", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#c N--\n  b#b2 ---\n  article#d ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.p(b#b1.q) article#c(b#b2))", ".p:has(.q) { color: red }", "rmattr #b1 class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a N--\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
