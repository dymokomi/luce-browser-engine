    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ":not(.x) > b { color: red }", "attr #a class x", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a NC-\n  b#b1 N--\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "section:has(+ aside) b { color: red }", "attr #c class w", ""], expected = "  full: false\n  document ---\n  section#r ---\n  article#a ---\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "* { color: red }", "attr #b2 title t", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  article#c -C-\n  b#b2 N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ".x .y { color: red }", "attr #a class x;attr #b2 class y", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  article#c -C-\n  b#b2 N--\n"),
