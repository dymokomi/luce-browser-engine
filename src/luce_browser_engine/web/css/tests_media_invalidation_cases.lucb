    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a > .b", "", "", ""], expected = "  plan .a {desc([.b] => {self }) }\n  plan .b {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a + .b", "", "", ""], expected = "  plan .a {adjacent([.b] => {self }) }\n  plan .b {self }\n"),
    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a ~ .b", "", "", ""], expected = "  plan .a {subsequent([.b] => {self }) }\n  plan .b {self }\n"),
