    TestMediaInvalidationCase(mode = "media", arguments = ["not tv", "", "", ""], expected = "  list: not tv\n  query: not tv\n    matches: true\n    dump: Media condition: (matches = true)\n    dump:   Negated: true\n    dump:   Type: tv\n"),
    TestMediaInvalidationCase(mode = "media", arguments = ["SCREEN and (color)", "", "", ""], expected = "  list: screen and (color)\n  query: screen and (color)\n    matches: false\n    dump: Media condition: (matches = false)\n    dump:   Negated: false\n    dump:   Type: SCREEN\n    dump:   Condition:\n    dump:     MediaFeature: (color)\n"),
