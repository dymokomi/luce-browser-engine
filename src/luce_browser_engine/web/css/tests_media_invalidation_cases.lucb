    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.x article#b article#c)", ".x ~ article { color: red }", "before #b article#n", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#a ---\n  article#n N--\n  article#b N--\n  article#c N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a article#b.y article#c)", ".x + .y { color: red }", "before #b article#n.x", ""], expected = "  full: false\n  document -C-\n  section#r NC-\n  article#a ---\n  article#n N--\n  article#b N--\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a[data-k=1](b#b1) article#c)", "[data-k=\"2\"] b { color: red }", "attr #a data-k 2", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a -C-\n  b#b1 N--\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c)", "#a b, #c b { color: red }", "attr #a id z;attr #c id a", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#z -C-\n  b#b1 N--\n  article#a ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.p(i#i1(b#b1)) article#c)", ".p > i > b { color: red }", "rmattr #a class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a -C-\n  i#i1 -C-\n  b#b1 N--\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.p(i#i1(b#b1)) article#c)", ".p * { color: red }", "rmattr #a class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a NC-\n  i#i1 NC-\n  b#b1 N--\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(i#i1(b#b1)) article#c)", "section:has(.q) article { color: red }", "attr #b1 class q", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a N--\n  i#i1 ---\n  b#b1 ---\n  article#c N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(i#i1(b#b1)) article#c)", "section:has(article > i .q) { color: red }", "attr #b1 class q", ""], expected = "  full: false\n  document -C-\n  section#r N--\n  article#a ---\n  i#i1 ---\n  b#b1 ---\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(i#i1(b#b1)) article#c)", ":is(.m .n) b { color: red }", "attr #a class m", ""], expected = "  full: false\n  document ---\n  section#r ---\n  article#a ---\n  i#i1 ---\n  b#b1 ---\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c)", "x-foo { color: red }", "append #c x-foo#xf", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  article#c NC-\n  x-foo#xf N--\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c)", "b:empty { color: red }", "append #b1 i#n", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a -C-\n  b#b1 NC-\n  i#n N--\n  article#c ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "article:has(b) { color: red }", "remove #b2", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a ---\n  b#b1 ---\n  article#c NC-\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", "article:has(:empty) { color: red }", "append #b1 'x'", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a NC-\n  b#b1 NC-\n  text N--\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a(b#b1) article#c(b#b2))", ".x { color: red }", "attr #a class x;rmattr #a class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a N--\n  b#b1 ---\n  article#c ---\n  b#b2 ---\n"),
    TestMediaInvalidationCase(mode = "outcome", arguments = ["section#r(article#a.x(b#b1) article#c(b#b2))", ":not(.x) b { color: red }", "rmattr #a class", ""], expected = "  full: false\n  document -C-\n  section#r -C-\n  article#a NC-\n  b#b1 N--\n  article#c ---\n  b#b2 ---\n"),
