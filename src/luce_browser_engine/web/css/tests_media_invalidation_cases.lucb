    TestMediaInvalidationCase(mode = "sheetset", arguments = [":host > * {}", "", "", ""], expected = "  set [*]\n  may-match-shadow-host true\n  may-match-light-dom true\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = ["::slotted(.x) {}", "", "", ""], expected = "  set [.x]\n  may-match-shadow-host false\n  may-match-light-dom true\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a:has(.b) {}", "", "", ""], expected = "  set [.a :has]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = [".a .b:has(.c) {}", "", "", ""], expected = "  set [.b :has]\n  may-match-shadow-host false\n  may-match-light-dom false\n"),
    TestMediaInvalidationCase(mode = "sheetset", arguments = ["div {} .x::marker {} .y ~ * {}", "", "", ""], expected = "  set [.x div]\n  may-match-shadow-host false\n  may-match-light-dom false\n  trailing-universal-rule [.y] - 4\n"),
