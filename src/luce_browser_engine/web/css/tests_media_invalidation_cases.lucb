    TestMediaInvalidationCase(mode = "invalidation", arguments = [".a, .b > .c, #d ~ .e", "", "", ""], expected = "  plan #d {subsequent([.e] => {self }) }\n  plan .a {self }\n  plan .b {desc([.c] => {self }) }\n  plan .c {self }\n  plan .e {self }\n"),
