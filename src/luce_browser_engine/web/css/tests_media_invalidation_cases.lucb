#==============================================================================================
#
#   tests_media_invalidation_cases - media query, @supports, @container and invalidation-set
#                                    cases pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/media_invalidation: cases.txt, oracle.cpp,
#       gen_luce_cases.py, build.sh). tests_media_invalidation runs each case through the port
#       and compares the output.
#
#==============================================================================================

## One oracle case: the mode, its arguments, and the reference build's output.
struct TestMediaInvalidationCase:
    let mode: str
    let arguments: str[4]
    let expected: str

## Every oracle case, in cases.txt order (4 more, marked "!" in cases.txt, wait for other regions).
let test_media_invalidation_cases: TestMediaInvalidationCase[164] = [
    TestMediaInvalidationCase(mode = "media", arguments = ["screen", "", "", ""], expected = "  list: screen\n  query: screen\n    matches: true\n    dump: Media condition: (matches = true)\n    dump:   Negated: false\n    dump:   Type: screen\n"),
    TestMediaInvalidationCase(mode = "media", arguments = ["print", "", "", ""], expected = "  list: print\n  query: print\n    matches: false\n    dump: Media condition: (matches = false)\n    dump:   Negated: false\n    dump:   Type: print\n"),
    TestMediaInvalidationCase(mode = "media", arguments = ["all", "", "", ""], expected = "  list: all\n  query: all\n    matches: true\n    dump: Media condition: (matches = true)\n    dump:   Negated: false\n    dump:   Type: all\n"),
