# mark: StyleSheet.h ============================================================================

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:25 Web::CSS::StyleSheet::type (pure virtual).
pub func css_style_sheet_type_impl(this: CssStyleSheet*) -> ak.String:
    discard(this)
    trap("pure virtual: Web::CSS::StyleSheet::type")

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:27 Web::CSS::StyleSheet::owner_node.
pub func css_style_sheet_owner_node(this: CssStyleSheet*) -> DomElement*?:
    return this.m_owner_node

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:32 Web::CSS::StyleSheet::location.
pub func css_style_sheet_location(this: CssStyleSheet*) -> web_url.Url?:
    return this.m_location

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:33 Web::CSS::StyleSheet::set_location.
pub func css_style_sheet_set_location(this: CssStyleSheet*, location: web_url.Url?):
    this.m_location = location

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:35 Web::CSS::StyleSheet::title.
pub func css_style_sheet_title(this: CssStyleSheet*) -> ak.String:
    return this.m_title

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:37 Web::CSS::StyleSheet::set_title.
pub func css_style_sheet_set_title(this: CssStyleSheet*, title: ak.String):
    this.m_title = title

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:39 Web::CSS::StyleSheet::set_type.
pub func css_style_sheet_set_type(this: CssStyleSheet*, type_: ak.String):
    this.m_type_string = type_

## Ported from Libraries/LibWeb/CSS/StyleSheet.h:41 Web::CSS::StyleSheet::media.
pub func css_style_sheet_media(this: CssStyleSheet*) -> CssMediaList*:
