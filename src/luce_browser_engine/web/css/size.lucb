## Ported from Libraries/LibWeb/CSS/Size.h:52 Web::CSS::Size::is_intrinsic_sizing_constraint.
pub func css_size_is_intrinsic_sizing_constraint(this: const CssSize*) -> bool:
    return css_size_is_min_content(this) or css_size_is_max_content(this) or css_size_is_fit_content(this)

## Ported from Libraries/LibWeb/CSS/Size.h:53 Web::CSS::Size::is_length_percentage.
pub func css_size_is_length_percentage(this: const CssSize*) -> bool:
    return css_size_is_length(this) or css_size_is_percentage(this) or css_size_is_calculated(this)

## Ported from Libraries/LibWeb/CSS/Size.h:59 Web::CSS::Size::calculated.
pub func css_size_calculated(this: const CssSize*) -> CssCalculatedStyleValue*:
    assert(css_size_is_calculated(this))
    let length_percentage = this.m_length_percentage else trap("VERIFY: a length-percentage")
    return css_percentage_or_calculated(&length_percentage.percentage_or)

## Ported from Libraries/LibWeb/CSS/Size.h:65 Web::CSS::Size::length.
