    assert(css_size_is_length(this))
    let length_percentage = this.m_length_percentage else trap("VERIFY: a length-percentage")
    return css_length_percentage_length(&length_percentage)

## Ported from Libraries/LibWeb/CSS/Size.h:71 Web::CSS::Size::percentage.
pub func css_size_percentage(this: const CssSize*) -> CssPercentage:
    assert(css_size_is_percentage(this))
    let length_percentage = this.m_length_percentage else trap("VERIFY: a length-percentage")
