## Ported from Libraries/LibWeb/CSS/Size.cpp:46 Web::CSS::Size::make_calculated.
pub func css_size_make_calculated(calculated: CssCalculatedStyleValue*) -> CssSize:
    return css_size_new(CssSizeType.calculated, css_length_percentage_new_css_calculated_style_value(calculated))

## Ported from Libraries/LibWeb/CSS/Size.cpp:51 Web::CSS::Size::make_length_percentage.
pub func css_size_make_length_percentage(length_percentage: CssLengthPercentage) -> CssSize:
    if css_length_percentage_is_length(&length_percentage):
        return css_size_make_length(css_length_percentage_length(&length_percentage))
    if css_percentage_or_is_percentage(&length_percentage.percentage_or):
        return css_size_make_percentage(css_percentage_or_percentage(&length_percentage.percentage_or))
    assert(css_percentage_or_is_calculated(&length_percentage.percentage_or))
    return css_size_make_calculated(css_percentage_or_calculated(&length_percentage.percentage_or))

