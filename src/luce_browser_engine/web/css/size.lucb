## Ported from Libraries/LibWeb/CSS/Size.cpp:86 Web::CSS::Size::from_style_value.
pub func css_size_from_style_value(value: CssStyleValue*) -> CssSize:
    if css_style_value_is_keyword(value):
        match css_style_value_to_keyword(value):
            .auto: return css_size_make_auto()
            .fit_content: return css_size_make_fit_content()
            .min_content: return css_size_make_min_content()
            .max_content: return css_size_make_max_content()
            .none_: return css_size_make_none()
            _: trap("VERIFY_NOT_REACHED")

    if css_style_value_is_function(value):
        let function = css_style_value_as_function(value)
        let name = css_function_style_value_name(function)
        if ak.fly_string_eq_string_view(&name, ak.sv("fit-content")):
            return css_size_make_fit_content_css_length_percentage(css_length_percentage_from_style_value(css_function_style_value_value(function)))
    if css_style_value_is_calculated(value):
        return css_size_make_calculated(css_style_value_as_calculated(value))
    if css_style_value_is_percentage(value):
        return css_size_make_percentage(css_percentage_style_value_percentage(css_style_value_as_percentage(value)))
    if css_style_value_is_length(value):
        return css_size_make_length(css_length_style_value_length(css_style_value_as_length(value)))
    # FIXME: Support `anchor-size(..)`
    if css_style_value_is_anchor_size(value):
        return css_size_make_none()

    let text = css_style_value_to_string(value, css_syntax.SerializationMode.normal)
    ak.dbgln(f"FIXME: Unsupported size value: `{ak.string_view_text(ak.string_bytes_as_string_view(&text))}`, treating as `auto`")
    return css_size_make_auto()

