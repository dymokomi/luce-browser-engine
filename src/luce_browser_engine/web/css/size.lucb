## Ported from Libraries/LibWeb/CSS/Size.cpp:13 Web::CSS::Size::Size.
pub func css_size_construct(this: CssSize*, type_: CssSizeType, length_percentage: CssLengthPercentage? = none):
    this.m_type = type_
    this.m_length_percentage = length_percentage

## `Size { type, length_percentage }` as a value.
func css_size_new(type_: CssSizeType, length_percentage: CssLengthPercentage? = none) -> CssSize:
    var size: CssSize = ---
    css_size_construct(&size, type_, length_percentage)
    return size

## Ported from Libraries/LibWeb/CSS/Size.cpp:19 Web::CSS::Size::to_px.
pub func css_size_to_px(this: const CssSize*, node: LayoutNode*, reference_value: gfx.CssPixels) -> gfx.CssPixels:
    let length_percentage = this.m_length_percentage else return gfx.css_pixels_from_int(0)
    let resolved = css_percentage_or_resolved_css_pixels(&length_percentage.percentage_or, node, reference_value)
    return css_length_to_px_layout_node(&resolved, node)

## Ported from Libraries/LibWeb/CSS/Size.cpp:26 Web::CSS::Size::make_auto.
pub func css_size_make_auto() -> CssSize:
    return css_size_new(CssSizeType.auto)

## Ported from Libraries/LibWeb/CSS/Size.cpp:31 Web::CSS::Size::make_px.
pub func css_size_make_px(px: gfx.CssPixels) -> CssSize:
