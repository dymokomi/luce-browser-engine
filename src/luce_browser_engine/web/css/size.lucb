## Ported from Libraries/LibWeb/CSS/Size.h:83 Web::CSS::Size::fit_content_available_space.
pub func css_size_fit_content_available_space(this: const CssSize*) -> CssLengthPercentage?:
    assert(css_size_is_fit_content(this))
    return this.m_length_percentage

## Ported from Libraries/LibWeb/CSS/Size.cpp:124 Web::CSS::Size::contains_percentage.
pub func css_size_contains_percentage(this: const CssSize*) -> bool:
    match this.m_type:
        .auto, .min_content, .max_content, .none_:
            return false
        .fit_content:
            if let length_percentage = this.m_length_percentage:
                return css_percentage_or_contains_percentage(&length_percentage.percentage_or)
            return false
        _:
            let length_percentage = this.m_length_percentage else trap("VERIFY: a length-percentage")
            return css_percentage_or_contains_percentage(&length_percentage.percentage_or)

## Ported from Libraries/LibWeb/CSS/Size.cpp:139 Web::CSS::Size::serialize.
pub func css_size_serialize(this: const CssSize*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    match this.m_type:
        .auto:
            ak.string_builder_append(builder, "auto")
        .calculated, .length, .percentage:
            let length_percentage = this.m_length_percentage else trap("VERIFY: a length-percentage")
            css_percentage_or_serialize(&length_percentage.percentage_or, builder, mode)
        .min_content:
            ak.string_builder_append(builder, "min-content")
        .max_content:
            ak.string_builder_append(builder, "max-content")
        .fit_content:
            if let length_percentage = this.m_length_percentage:
                ak.string_builder_append(builder, "fit-content(")
                css_percentage_or_serialize(&length_percentage.percentage_or, builder, mode)
                ak.string_builder_append(builder, ")")
            else:
                ak.string_builder_append(builder, "fit-content")
        .none_:
            ak.string_builder_append(builder, "none")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Size.cpp:171 Web::CSS::Size::to_string.
pub func css_size_to_string(this: const CssSize*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_size_serialize(this, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/Size.h:91 Web::CSS::Size::operator== (defaulted: the type, then the
## length-percentages as PercentageOr<Length>::operator== compares them).
pub func css_size_eq(this: const CssSize*, other: CssSize) -> bool:
    if this.m_type != other.m_type:
        return false
    if let length_percentage = this.m_length_percentage:
        if let other_length_percentage = other.m_length_percentage:
            return css_percentage_or_eq(&length_percentage.percentage_or, other_length_percentage.percentage_or)
        return false
    return other.m_length_percentage == none
