# mark: CSSStyleDeclaration.cpp =================================================================

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:18 Web::CSS::CSSStyleDeclaration::CSSStyleDeclaration.
pub func css_style_declaration_construct(this: CssStyleDeclaration*, realm: Realm*, computed: CssStyleDeclarationComputed, readonly: CssStyleDeclarationReadonly):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_computed = computed == CssStyleDeclarationComputed.yes
    this.m_readonly = readonly == CssStyleDeclarationReadonly.yes
    this.platform_object.m_legacy_platform_object_flags = BindPlatformObjectLegacyPlatformObjectFlags(supports_indexed_properties = 1)

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:29 Web::CSS::CSSStyleDeclaration::initialize (override).
pub func css_style_declaration_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_style_declaration)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:36 Web::CSS::CSSStyleDeclaration::update_style_attribute.
# https://drafts.csswg.org/cssom/#update-style-attribute-for
pub func css_style_declaration_update_style_attribute(this: CssStyleDeclaration*):
    # 1. Assert: declaration block’s computed flag is unset.
    assert(not css_style_declaration_is_computed(this))

    # 2. Let owner node be declaration block’s owner node.
    # 3. If owner node is null, then return.
    var owner_node = css_style_declaration_owner_node(this) else return

    # 4. Set declaration block’s updating flag.
    css_style_declaration_set_is_updating(this, true)

    # 5. Set an attribute value for owner node using "style" and the result of serializing declaration block.
    dom_element_set_attribute_value(dom_abstract_element_element(&owner_node), html_attribute_names_style, css_style_declaration_serialized(this))

    # 6. Unset declaration block’s updating flag.
    css_style_declaration_set_is_updating(this, false)

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:56 Web::CSS::CSSStyleDeclaration::css_text.
# https://drafts.csswg.org/cssom/#dom-cssstyledeclaration-csstext
pub func css_style_declaration_css_text(this: CssStyleDeclaration*) -> ak.String:
    # 1. If the computed flag is set, then return the empty string.
    if css_style_declaration_is_computed(this):
        return ak.string_from_str("")

    # 2. Return the result of serializing the declarations.
    return css_style_declaration_serialized(this)

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:66 Web::CSS::CSSStyleDeclaration::item_value (override).
pub func css_style_declaration_item_value_impl(base: BindPlatformObject*, index: usize) -> JsValue?:
    let this = (CssStyleDeclaration*)base
    let value = css_style_declaration_item(this, index)
    if ak.string_is_empty(&value):
        return none

    return js_primitive_string_create_string(js_cell_vm(this.js_cell()), value)

## Ported from Libraries/LibWeb/CSS/CSSStyleDeclaration.cpp:75 Web::CSS::CSSStyleDeclaration::visit_edges (override).
pub func css_style_declaration_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssStyleDeclaration*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_parent_rule)
    if let owner_node = this.m_owner_node:
        dom_abstract_element_visit(&owner_node, visitor)
