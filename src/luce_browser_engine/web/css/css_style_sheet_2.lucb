## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:573 Web::CSS::CSSStyleSheet::add_critical_subresource.
pub func css_css_style_sheet_add_critical_subresource(this: CssCssStyleSheet*, subresource: CssStyleSheetSubresource*):
    ak.vector_append_t(&this.m_critical_subresources, subresource)

## The predicate of remove_critical_subresource: `&it == &subresource`.
func css_css_style_sheet_is_subresource(context: void*?, it: const (CssStyleSheetSubresource*)*) -> bool:
    return (void*?)*it == context

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:578 Web::CSS::CSSStyleSheet::remove_critical_subresource.
pub func css_css_style_sheet_remove_critical_subresource(this: CssCssStyleSheet*, subresource: CssStyleSheetSubresource*):
    discard(ak.vector_remove_first_matching(&this.m_critical_subresources, ak.Function1[const (CssStyleSheetSubresource*)*, bool](call = css_css_style_sheet_is_subresource, context = subresource)))
    css_css_style_sheet_check_if_loading_completed(this)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:584 Web::CSS::CSSStyleSheet::loading_state.
pub func css_css_style_sheet_loading_state(this: CssCssStyleSheet*) -> CssStyleSheetLoadingState:
    var any_loading = false
    var any_errors = false

    for subresource in ak.vector_span(&this.m_critical_subresources):
        match css_style_sheet_subresource_loading_state(subresource):
            .unloaded, .loading:
                any_loading = true
            .loaded:
                discard(subresource)
            .error_:
                any_errors = true
            _:
                trap("VERIFY_NOT_REACHED")

