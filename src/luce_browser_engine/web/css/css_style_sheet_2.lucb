# mark: Owners ==================================================================================

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:353 Web::CSS::CSSStyleSheet::add_owning_document_or_shadow_root.
pub func css_css_style_sheet_add_owning_document_or_shadow_root(this: CssCssStyleSheet*, document_or_shadow_root: DomNode*):
    assert(dom_node_is_document(document_or_shadow_root) or dom_node_is_shadow_root(document_or_shadow_root))
    discard(ak.hash_table_set(&this.m_owning_documents_or_shadow_roots, document_or_shadow_root))

    # CSSOM's "add a CSS style sheet" steps bail out once the disabled flag is set, so ownership alone should not
    # make a disabled sheet observable in the destination document. Delay CSS-connected font activation until the
    # sheet actually becomes enabled.
    if not css_style_sheet_disabled(this.css_style_sheet()) and ak.hash_table_size(&this.m_owning_documents_or_shadow_roots) == 1:
        css_font_computer_load_fonts_from_sheet(dom_document_font_computer(dom_node_document(document_or_shadow_root)), this)

    for import_rule in ak.vector_span(&this.m_import_rules):
        if let loaded_style_sheet = css_import_rule_loaded_style_sheet(import_rule):
            css_css_style_sheet_add_owning_document_or_shadow_root(loaded_style_sheet, document_or_shadow_root)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:370 Web::CSS::CSSStyleSheet::remove_owning_document_or_shadow_root.
pub func css_css_style_sheet_remove_owning_document_or_shadow_root(this: CssCssStyleSheet*, document_or_shadow_root: DomNode*):
    discard(ak.hash_table_remove_t(&this.m_owning_documents_or_shadow_roots, document_or_shadow_root))

    # All owning documents or shadow roots must be part of the same document so we only need to unload this style
    # sheet's fonts once we have none remaining.
    if ak.hash_table_size(&this.m_owning_documents_or_shadow_roots) == 0:
        css_font_computer_unload_fonts_from_sheet(dom_document_font_computer(dom_node_document(document_or_shadow_root)), this)

    for import_rule in ak.vector_span(&this.m_import_rules):
        if let loaded_style_sheet = css_import_rule_loaded_style_sheet(import_rule):
            css_css_style_sheet_remove_owning_document_or_shadow_root(loaded_style_sheet, document_or_shadow_root)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:385 Web::CSS::CSSStyleSheet::set_disabled (override).
pub func css_css_style_sheet_set_disabled_impl(base: CssStyleSheet*, disabled: bool):
    let this = (CssCssStyleSheet*)base
    if css_style_sheet_disabled(base) == disabled:
        return

    let previous_sheet_effects = css_determine_shadow_root_stylesheet_effects_css_css_style_sheet(this)
    let document = css_css_style_sheet_owning_document(this)
    # When a stylesheet is disabled we stop evaluating its media queries, so both the cached top-level match bit
    # and the MediaList's internal state can go stale across viewport changes. Clear the cache for both
    # directions, and eagerly refresh on re-enable so subsequent rule-cache rebuilds see the current media state
    # instead of the pre-disable one.
    this.m_did_match = none
    css_style_sheet_set_disabled_impl(base, disabled)

    if not disabled:
        if let owning_document = document:
            discard(css_css_style_sheet_evaluate_media_queries(this, owning_document))
            css_font_computer_load_fonts_from_sheet(dom_document_font_computer(owning_document), this)
            css_css_style_sheet_load_pending_image_resources(this, owning_document)
    elif let owning_document = document:
        css_font_computer_unload_fonts_from_sheet(dom_document_font_computer(owning_document), this)

    css_css_style_sheet_invalidate_owners(this, DomStyleInvalidationReason.style_sheet_disabled_state_change, &previous_sheet_effects)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:412 Web::CSS::CSSStyleSheet::for_each_owning_style_scope.
pub func css_css_style_sheet_for_each_owning_style_scope(this: CssCssStyleSheet*, callback: ak.Function1[CssStyleScope*, unit]):
    for entry in ak.hash_table_begin_const(&this.m_owning_documents_or_shadow_roots):
        let document_or_shadow_root = *entry else trap("null owner")
        var style_scope: CssStyleScope* = ---
        if dom_node_is_shadow_root(document_or_shadow_root):
            style_scope = dom_shadow_root_style_scope(as_dom_shadow_root(document_or_shadow_root))
        else:
            style_scope = dom_document_style_scope(dom_node_document(document_or_shadow_root))

        ak.function1_call(&callback, style_scope)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:423 Web::CSS::CSSStyleSheet::shared_single_constructed_sheet_style_cache.
pub func css_css_style_sheet_shared_single_constructed_sheet_style_cache(this: CssCssStyleSheet*, style_scope: CssStyleScope*) -> CssStyleCache*:
    assert(css_css_style_sheet_constructed(this))
    if this.m_shared_single_constructed_sheet_style_cache == none:
        this.m_shared_single_constructed_sheet_style_cache = css_style_cache_create_for_style_scope(style_scope)
    return this.m_shared_single_constructed_sheet_style_cache else trap("unreachable")

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:431 Web::CSS::CSSStyleSheet::invalidate_shared_style_cache.
func css_css_style_sheet_invalidate_shared_style_cache(this: CssCssStyleSheet*):
    this.m_shared_single_constructed_sheet_style_cache = none

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:436 Web::CSS::CSSStyleSheet::invalidate_owners.
pub func css_css_style_sheet_invalidate_owners(this: CssCssStyleSheet*, reason: DomStyleInvalidationReason, previous_sheet_effects: const CssShadowRootStylesheetEffects*? = none):
    this.m_did_match = none
    css_css_style_sheet_invalidate_shared_style_cache(this)

    # The MediaList may have been mutated (e.g. via MediaList::set_media_text), and owner invalidation computes
    # shadow-root effects from effective rules. Refresh the media state first so host-side shadow invalidation
    # sees the updated definitions.
    if let document = css_css_style_sheet_owning_document(this):
        discard(css_css_style_sheet_evaluate_media_queries(this, document))

    css_invalidate_style_for_style_sheet_owners(this, reason, CssShouldInvalidateRuleCache.yes, previous_sheet_effects)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:450 Web::CSS::CSSStyleSheet::owning_document.
pub func css_css_style_sheet_owning_document(this: CssCssStyleSheet*) -> DomDocument*?:
    if not ak.hash_table_is_empty(&this.m_owning_documents_or_shadow_roots):
        var it = ak.hash_table_begin_const(&this.m_owning_documents_or_shadow_roots)
        let first = it.next() else trap("unreachable")
        return dom_node_document(*first else trap("null owner"))

    if let element = css_style_sheet_owner_node(this.css_style_sheet()):
        return dom_node_document(element.dom_node())

    return none

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:461 Web::CSS::CSSStyleSheet::load_pending_image_resources.
pub func css_css_style_sheet_load_pending_image_resources(this: CssCssStyleSheet*, document: DomDocument*):
    if css_style_sheet_disabled(this.css_style_sheet()):
        return

    let pending = this.m_pending_image_values
    this.m_pending_image_values = ak.Vector[gc.Weak[CssImageStyleValue]]()
    for weak_image_value in ak.vector_span_const(&pending):
        if let image_value = css_weak_image_style_value_ptr(&weak_image_value):
            css_abstract_image_style_value_load_any_resources_dom_document(image_value.css_abstract_image_style_value(), document)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:473 Web::CSS::CSSStyleSheet::evaluate_media_queries.
pub func css_css_style_sheet_evaluate_media_queries(this: CssCssStyleSheet*, document: DomDocument*) -> bool:
    var any_media_queries_changed_match_state = false

    let now_matches = css_media_list_evaluate(this.style_sheet.m_media, document)
    # The first evaluation establishes the baseline. The sheet's rules already entered the cascade through
    # StyleSheetListAddSheet, AdoptedStyleSheetsList, or invalidate_owners (each of which performs its own
    # invalidation), so we don't need to also report a match-state change just because no prior result was
    # recorded.
    if let did_match = this.m_did_match:
        if did_match != now_matches:
            any_media_queries_changed_match_state = true
    if now_matches and css_rule_list_evaluate_media_queries(this.m_rules else trap("null m_rules"), document):
        any_media_queries_changed_match_state = true

    this.m_did_match = now_matches
    if any_media_queries_changed_match_state:
        css_css_style_sheet_invalidate_shared_style_cache(this)

    return any_media_queries_changed_match_state

# mark: Namespaces and the rule caches ==========================================================

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:495 Web::CSS::CSSStyleSheet::default_namespace.
pub func css_css_style_sheet_default_namespace(this: CssCssStyleSheet*) -> ak.FlyString?:
    if let rule = this.m_default_namespace_rule:
        return css_namespace_rule_namespace_uri(rule)

    return none

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:503 Web::CSS::CSSStyleSheet::declared_namespaces.
pub func css_css_style_sheet_declared_namespaces(this: CssCssStyleSheet*) -> ak.HashTable[ak.FlyString, ak.FlyStringTraits]:
    var declared_namespaces: ak.HashTable[ak.FlyString, ak.FlyStringTraits]

    for entry in ak.hash_map_begin_const(&this.m_namespace_rules):
        discard(ak.hash_table_set(&declared_namespaces, entry.key))

    return declared_namespaces

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:514 Web::CSS::CSSStyleSheet::namespace_uri.
pub func css_css_style_sheet_namespace_uri(this: CssCssStyleSheet*, namespace_prefix: ak.StringView) -> ak.FlyString?:
    # m_namespace_rules.get(namespace_prefix): the FlyString keys hash and compare as their bytes.
    let key = ak.fly_string_from_utf8_without_validation(ak.string_view_bytes(&namespace_prefix))
    let namespace_ = ak.hash_map_get_k_const(&this.m_namespace_rules, key) else return none
    return css_namespace_rule_namespace_uri(*namespace_ else trap("null namespace rule"))

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:522 Web::CSS::CSSStyleSheet::recalculate_rule_caches.
func css_css_style_sheet_recalculate_rule_caches(this: CssCssStyleSheet*):
    css_css_style_sheet_invalidate_shared_style_cache(this)

    this.m_default_namespace_rule = none
    ak.hash_map_clear(&this.m_namespace_rules)
    ak.vector_clear(&this.m_import_rules)

    let rules = this.m_rules else trap("null m_rules")
    for rule in ak.vector_span(&rules.m_rules):
        # "Any @import rules must precede all other valid at-rules and style rules in a style sheet
        # (ignoring @charset and @layer statement rules) and must not have any other valid at-rules
        # or style rules between it and previous @import rules, or else the @import rule is invalid."
        # https://drafts.csswg.org/css-cascade-5/#at-import
        #
        # "Any @namespace rules must follow all @charset and @import rules and precede all other
        # non-ignored at-rules and style rules in a style sheet.
        # ...
        # A syntactically invalid @namespace rule (whether malformed or misplaced) must be ignored."
        # https://drafts.csswg.org/css-namespaces/#syntax
        match css_rule_type(rule):
            .import_:
                # @import rules must appear before @namespace rules, so skip this if we've seen @namespace.
                if not ak.hash_map_is_empty(&this.m_namespace_rules):
                    continue
                ak.vector_append_t(&this.m_import_rules, as_css_import_rule(rule))
            .namespace:
                let namespace_rule = as_css_namespace_rule(rule)
                let namespace_uri = css_namespace_rule_namespace_uri(namespace_rule)
                let prefix = css_namespace_rule_prefix(namespace_rule)
                if not ak.fly_string_is_empty(&namespace_uri) and ak.fly_string_is_empty(&prefix):
                    this.m_default_namespace_rule = namespace_rule

                discard(ak.hash_map_set(&this.m_namespace_rules, prefix, namespace_rule))
            _:
                # Any other types mean that further @namespace rules are invalid, so we can stop here.
                return

