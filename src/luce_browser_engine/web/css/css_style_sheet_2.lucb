# mark: Weak references to image style values ===================================================

# m_pending_image_values holds WeakPtr<ImageStyleValue>s (IGNORE_GC). A style value is a blob of
# the heap (DESIGN.md §3.3): a Cell header followed by the value, so its Weak is made to the header
# and read back past it.

## `WeakPtr<ImageStyleValue>(value)`.
func css_weak_image_style_value(value: CssImageStyleValue*) -> gc.Weak[CssImageStyleValue]:
    let header = (gc.Cell*)((u8*)value - gc.blob_header_size)
    let weak = gc.make_weak(header)
    return gc.Weak[CssImageStyleValue](m_impl = weak.m_impl, m_generation = weak.m_generation)

## `weak_image_value.ptr()`.
func css_weak_image_style_value_ptr(weak: const gc.Weak[CssImageStyleValue]*) -> CssImageStyleValue*?:
    let header = gc.weak_ptr(weak) else return none
    return (CssImageStyleValue*)((u8*)header + gc.blob_header_size)

# mark: Effective rules =========================================================================

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:323 Web::CSS::CSSStyleSheet::for_each_effective_rule.
pub func css_css_style_sheet_for_each_effective_rule(this: CssCssStyleSheet*, order: TraversalOrder, callback: ak.Function1[CssRule*, unit]):
    if css_media_list_matches(this.style_sheet.m_media):
        css_rule_list_for_each_effective_rule(this.m_rules else trap("null m_rules"), order, callback)

## The filtering lambda of for_each_effective_style_producing_rule (captures: the callback).
func css_css_style_sheet_style_producing_rule_filter(context: void*?, rule: CssRule*):
    let callback = (ak.Function1[CssRule*, unit]*)(context else trap("no callback"))
    if css_rule_type(rule) == CssRuleType.style or css_rule_type(rule) == CssRuleType.nested_declarations:
        ak.function1_call(callback, rule)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:329 Web::CSS::CSSStyleSheet::for_each_effective_style_producing_rule.
pub func css_css_style_sheet_for_each_effective_style_producing_rule(this: CssCssStyleSheet*, callback: ak.Function1[CssRule*, unit]):
    var inner = callback
    css_css_style_sheet_for_each_effective_rule(this, TraversalOrder.preorder, ak.Function1[CssRule*, unit](call = css_css_style_sheet_style_producing_rule_filter, context = &inner))

## The filtering lambda of for_each_effective_keyframes_at_rule (captures: the callback).
func css_css_style_sheet_keyframes_rule_filter(context: void*?, rule: CssRule*):
    let callback = (ak.Function1[CssKeyframesRule*, unit]*)(context else trap("no callback"))
    if css_rule_type(rule) == CssRuleType.keyframes:
        ak.function1_call(callback, (CssKeyframesRule*)rule)

## Ported from Libraries/LibWeb/CSS/CSSStyleSheet.cpp:337 Web::CSS::CSSStyleSheet::for_each_effective_keyframes_at_rule.
pub func css_css_style_sheet_for_each_effective_keyframes_at_rule(this: CssCssStyleSheet*, callback: ak.Function1[CssKeyframesRule*, unit]):
    var inner = callback
    css_css_style_sheet_for_each_effective_rule(this, TraversalOrder.preorder, ak.Function1[CssRule*, unit](call = css_css_style_sheet_keyframes_rule_filter, context = &inner))

## The filtering lambda of for_each_effective_counter_style_at_rule (captures: the callback).
func css_css_style_sheet_counter_style_rule_filter(context: void*?, rule: CssRule*):
