# mark: NonInheritedValues (ComputedValues.h:942-959) ==========================================

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:942 Web::CSS::ComputedValues::NonInheritedValues::visit_edges.
pub func css_computed_values_non_inherited_values_visit_edges(this: CssComputedValuesNonInheritedValues*, visitor: gc.CellVisitor*):
    for layer in ak.vector_span_const(&this.background_layers):
        css_style_value_visit_edges(layer.background_image.css_style_value(), visitor)
    if let mask_image = this.mask_image:
        css_style_value_visit_edges(mask_image.css_style_value(), visitor)
    for transform in ak.vector_span_const(&this.transformations):
        css_style_value_visit_edges(transform.css_style_value(), visitor)
    if let rotate = this.rotate:
        css_style_value_visit_edges(rotate.css_style_value(), visitor)
    if let translate = this.translate:
        css_style_value_visit_edges(translate.css_style_value(), visitor)
    if let scale = this.scale:
        css_style_value_visit_edges(scale.css_style_value(), visitor)
    if let content = this.content:
        css_content_data_visit_edges(&content, visitor)
