# mark: CSSRuleList.h ===========================================================================

## Ported from Libraries/LibWeb/CSS/CSSRuleList.h:32 Web::CSS::CSSRuleList::item (const).
pub func css_rule_list_item_const(this: CssRuleList*, index: usize) -> CssRule*?:
    if index >= css_rule_list_length(this):
        return none
    return *ak.vector_at(&this.m_rules, index)

## Ported from Libraries/LibWeb/CSS/CSSRuleList.h:39 Web::CSS::CSSRuleList::item.
pub func css_rule_list_item(this: CssRuleList*, index: usize) -> CssRule*?:
    if index >= css_rule_list_length(this):
        return none
    return *ak.vector_at(&this.m_rules, index)

## Ported from Libraries/LibWeb/CSS/CSSRuleList.h:46 Web::CSS::CSSRuleList::length.
pub func css_rule_list_length(this: CssRuleList*) -> usize:
    return ak.vector_size(&this.m_rules)

