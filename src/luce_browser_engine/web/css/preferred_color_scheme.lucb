## Ported from Libraries/LibWeb/CSS/PreferredColorScheme.cpp:11 Web::CSS::preferred_color_scheme_from_string.
pub func css_preferred_color_scheme_from_string(value: ak.StringView) -> CssPreferredColorScheme:
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("light")):
        return CssPreferredColorScheme.light
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("dark")):
        return CssPreferredColorScheme.dark
    return CssPreferredColorScheme.auto

## Ported from Libraries/LibWeb/CSS/PreferredColorScheme.cpp:20 Web::CSS::preferred_color_scheme_to_string.
pub func css_preferred_color_scheme_to_string(value: CssPreferredColorScheme) -> ak.StringView:
    match value:
        .light: return ak.sv("light")
        .dark: return ak.sv("dark")
        .auto: return ak.sv("auto")
        _: trap("VERIFY_NOT_REACHED")
