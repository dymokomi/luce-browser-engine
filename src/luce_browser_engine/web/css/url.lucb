# mark: URL =====================================================================================

## Ported from Libraries/LibWeb/CSS/URL.cpp:14 Web::CSS::URL::URL.
pub func css_url_construct(this: CssUrl*, url: ak.String, type_: CssUrlType = CssUrlType.url, request_url_modifiers: ak.Vector[CssRequestUrlModifier]):
    this.m_type = type_
    this.m_url = url
    this.m_request_url_modifiers = request_url_modifiers

## Ported from Libraries/LibWeb/CSS/URL.h:55 Web::CSS::URL::url.
pub func css_url_url(this: const CssUrl*) -> ak.String:
    return this.m_url

## Ported from Libraries/LibWeb/CSS/URL.h:56 Web::CSS::URL::request_url_modifiers.
pub func css_url_request_url_modifiers(this: const CssUrl*) -> ak.Vector[CssRequestUrlModifier]:
    return this.m_request_url_modifiers

## Ported from Libraries/LibWeb/CSS/URL.cpp:22 Web::CSS::URL::to_string.
# https://drafts.csswg.org/cssom-1/#serialize-a-url
pub func css_url_to_string(this: const CssUrl*) -> ak.String:
    # To serialize a URL means to create a string represented by "url(", followed by the serialization of the URL as a
    # string, followed by ")".
    # AD-HOC: Serialize as src() if it was declared as that.
    var builder = ak.string_builder_new()
    match this.m_type:
        .url: ak.string_builder_append(&builder, "url(")
        .src: ak.string_builder_append(&builder, "src(")
        _: trap("VERIFY_NOT_REACHED")
    css_syntax.serialize_a_string_string_builder(&builder, ak.string_bytes_as_string_view(&this.m_url))

    # AD-HOC: Serialize the RequestURLModifiers
    # Spec issue: https://github.com/w3c/csswg-drafts/issues/12057
    for modifier in ak.vector_span_const(&this.m_request_url_modifiers):
        let modifier_string = css_request_url_modifier_to_string(&modifier)
        ak.string_builder_append(&builder, " ")
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&modifier_string))
    ak.string_builder_append_u8(&builder, ')')
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/URL.cpp:48 Web::CSS::URL::operator== (defaulted).
pub func css_url_eq(this: const CssUrl*, arg0: CssUrl) -> bool:
    if this.m_type != arg0.m_type:
        return false
    if not ak.string_equals(&this.m_url, &arg0.m_url):
        return false
    let size = ak.vector_size(&this.m_request_url_modifiers)
    if size != ak.vector_size(&arg0.m_request_url_modifiers):
        return false
    for i in 0..<size:
        let modifier = ak.vector_at_const(&this.m_request_url_modifiers, i)
        if not css_request_url_modifier_eq(modifier, *ak.vector_at_const(&arg0.m_request_url_modifiers, i)):
            return false
    return true

