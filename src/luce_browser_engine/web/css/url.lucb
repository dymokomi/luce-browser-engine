## Ported from Libraries/LibWeb/CSS/URL.cpp:50 Web::CSS::RequestURLModifier::create_cross_origin.
pub func css_request_url_modifier_create_cross_origin(value: css_data.CrossOriginModifierValue) -> CssRequestUrlModifier:
    return css_request_url_modifier_new(CssRequestUrlModifierType.cross_origin, .cross_origin_modifier_value(value))

## Ported from Libraries/LibWeb/CSS/URL.cpp:55 Web::CSS::RequestURLModifier::create_integrity.
pub func css_request_url_modifier_create_integrity(value: ak.FlyString) -> CssRequestUrlModifier:
