## Ported from Libraries/LibWeb/CSS/URL.cpp:65 Web::CSS::RequestURLModifier::RequestURLModifier.
pub func css_request_url_modifier_construct(this: CssRequestUrlModifier*, type_: CssRequestUrlModifierType, value: css_data.CssRequestUrlModifierValue):
    this.m_type = type_
    this.m_value = value

## `RequestURLModifier { type, value }` as a value.
func css_request_url_modifier_new(type_: CssRequestUrlModifierType, value: css_data.CssRequestUrlModifierValue) -> CssRequestUrlModifier:
    var modifier: CssRequestUrlModifier = ---
    css_request_url_modifier_construct(&modifier, type_, value)
    return modifier

## Ported from Libraries/LibWeb/CSS/URL.cpp:71 Web::CSS::RequestURLModifier::modify_request.
pub func css_request_url_modifier_modify_request(this: const CssRequestUrlModifier*, request: FetchRequest*):
    match this.m_type:
        .cross_origin:
            # https://drafts.csswg.org/css-values-5/#typedef-request-url-modifier-crossorigin-modifier
            # The URL request modifier steps for this modifier given request req are:

            # 1. Set req’s mode to "cors".
            fetch_request_set_mode(request, FetchRequestMode.cors)

            # 2. If the given value is use-credentials, set req’s credentials mode to "include".
            if css_request_url_modifier_value_is(this, css_data.CrossOriginModifierValue.use_credentials):
                fetch_request_set_credentials_mode(request, FetchRequestCredentialsMode.include)
            # 3. Otherwise, set req’s credentials mode to "same-origin".
            else:
                fetch_request_set_credentials_mode(request, FetchRequestCredentialsMode.same_origin)
        .integrity:
            # https://drafts.csswg.org/css-values-5/#typedef-request-url-modifier-integrity-modifier
            # The URL request modifier steps for this modifier given request req are to set request’s integrity metadata to
            # the given <string>.
            match this.m_value:
                .fly_string(value): fetch_request_set_integrity_metadata(request, ak.fly_string_to_string_const(&value))
                _: trap("VERIFY: a FlyString")
        .referrer_policy:
            # https://drafts.csswg.org/css-values-5/#typedef-request-url-modifier-referrerpolicy-modifier
            # The URL request modifier steps for this modifier given request req are to set request’s referrer policy to the
            # ReferrerPolicy that matches the given value.
            match this.m_value:
                .referrer_policy_modifier_value(value): fetch_request_set_referrer_policy(request, css_request_url_modifier_referrer_policy(value))
                _: trap("VERIFY: a ReferrerPolicyModifierValue")
        _: trap("VERIFY_NOT_REACHED")

## `m_value == value` for a CrossOriginModifierValue (Variant::operator== with an alternative).
func css_request_url_modifier_value_is(this: const CssRequestUrlModifier*, value: css_data.CrossOriginModifierValue) -> bool:
    match this.m_value:
        .cross_origin_modifier_value(held): return held == value
        _: return false

## modify_request's lambda: the ReferrerPolicy of a referrer-policy() modifier value.
func css_request_url_modifier_referrer_policy(value: css_data.ReferrerPolicyModifierValue) -> ReferrerPolicyReferrerPolicy:
    match value:
        .no_referrer: return ReferrerPolicyReferrerPolicy.no_referrer
        .no_referrer_when_downgrade: return ReferrerPolicyReferrerPolicy.no_referrer_when_downgrade
        .same_origin: return ReferrerPolicyReferrerPolicy.same_origin
        .origin: return ReferrerPolicyReferrerPolicy.origin
        .strict_origin: return ReferrerPolicyReferrerPolicy.strict_origin
        .origin_when_cross_origin: return ReferrerPolicyReferrerPolicy.origin_when_cross_origin
        .strict_origin_when_cross_origin: return ReferrerPolicyReferrerPolicy.strict_origin_when_cross_origin
        .unsafe_url: return ReferrerPolicyReferrerPolicy.unsafe_url
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/URL.h:33 Web::CSS::RequestURLModifier::type.
pub func css_request_url_modifier_type(this: const CssRequestUrlModifier*) -> CssRequestUrlModifierType:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/URL.cpp:130 Web::CSS::RequestURLModifier::to_string.
pub func css_request_url_modifier_to_string(this: const CssRequestUrlModifier*) -> ak.String:
    var builder = ak.string_builder_new()
    match this.m_value:
        .cross_origin_modifier_value(value):
            assert(this.m_type == CssRequestUrlModifierType.cross_origin)
            ak.string_builder_append(&builder, "cross-origin(")
            ak.string_builder_append_string_view(&builder, css_data.to_string_cross_origin_modifier_value(value))
        .fly_string(value):
            assert(this.m_type == CssRequestUrlModifierType.integrity)
            let serialized = css_syntax.serialize_a_string_string_view(ak.fly_string_bytes_as_string_view(&value))
            ak.string_builder_append(&builder, "integrity(")
            ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&serialized))
        .referrer_policy_modifier_value(value):
            assert(this.m_type == CssRequestUrlModifierType.referrer_policy)
            ak.string_builder_append(&builder, "referrer-policy(")
            ak.string_builder_append_string_view(&builder, css_data.to_string_referrer_policy_modifier_value(value))
    ak.string_builder_append(&builder, ")")
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from Libraries/LibWeb/CSS/URL.cpp:143 Web::CSS::RequestURLModifier::operator== (defaulted).
pub func css_request_url_modifier_eq(this: const CssRequestUrlModifier*, arg0: CssRequestUrlModifier) -> bool:
    if this.m_type != arg0.m_type:
        return false
    match this.m_value:
        .cross_origin_modifier_value(value):
            match arg0.m_value:
                .cross_origin_modifier_value(other): return value == other
                _: return false
        .referrer_policy_modifier_value(value):
            match arg0.m_value:
                .referrer_policy_modifier_value(other): return value == other
                _: return false
        .fly_string(value):
            match arg0.m_value:
                .fly_string(other): return ak.fly_string_eq_fly_string(&value, &other)
                _: return false
