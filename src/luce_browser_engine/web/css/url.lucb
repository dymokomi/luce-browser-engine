## Ported from Libraries/LibWeb/CSS/URL.cpp:60 Web::CSS::RequestURLModifier::create_referrer_policy.
pub func css_request_url_modifier_create_referrer_policy(value: css_data.ReferrerPolicyModifierValue) -> CssRequestUrlModifier:
