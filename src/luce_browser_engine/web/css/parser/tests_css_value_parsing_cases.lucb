#==============================================================================================
#
#   tests_css_value_parsing_cases - the value parsing cases pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's CSS::Parser on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/css_value_parsing: cases.txt, oracle.cpp, gen_luce_cases.py).
#       tests_css_value_parsing runs each case through the port and compares the dumps.
#
#==============================================================================================

## One oracle case: what to run, on what input, and the reference build's dump.
struct TestCssValueParsingCase:
    let mode: str
    let input: str
    let expected: str

## Every oracle case, in cases.txt order.
let test_css_value_parsing_cases: TestCssValueParsingCase[447] = [
    TestCssValueParsingCase(mode = "type:integer", input = "12", expected = "  value: 12\n  rest: 0\n"),
    TestCssValueParsingCase(mode = "type:integer", input = "  -7  ", expected = "  value: -7\n  rest: 1\n"),
