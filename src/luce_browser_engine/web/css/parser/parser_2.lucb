# https://drafts.csswg.org/css-syntax/#consume-function
pub func css_parser_consume_a_function(this: CssParser*, input: css_syntax.TokenStream[css_syntax.Token]*) -> css_syntax.Function:
    # To consume a function from a token stream input:

    # Assert: The next token is a <function-token>.
    let next = css_syntax.token_stream_next_token(input)
    assert(css_syntax.token_is(&next, .function))

    # Consume a token from input, and let function be a new function with its name equal the returned token’s value,
    # and a value set to an empty list.
    let name_token = css_syntax.token_stream_consume_a_token(input)
    var function = css_syntax.Function(
        name = css_syntax.token_function(&name_token),
        value = ak.Vector[css_syntax.ComponentValue](),
        name_token = name_token,
        end_token = css_syntax.token_new(),
    )

    # Process input:
    while true:
        let token = css_syntax.token_stream_next_token(input)

        # <eof-token>
        # <)-token>
        if css_syntax.token_is(&token, .end_of_file) or css_syntax.token_is(&token, .close_paren):
            # Discard a token from input. Return function.
            # AD-HOC: Store the token instead as the "end token"
            function.end_token = css_syntax.token_stream_consume_a_token(input)
            return function

        # anything else
        # Consume a component value from input and append the result to function’s value.
        ak.vector_append_t(&function.value, css_parser_consume_a_component_value_token(this, input))

