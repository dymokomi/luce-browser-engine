        _:
            return try css_parser_parse_css_value_after_special_cases(this, property_id, tokens)

## The rest of parse_css_value, after its `switch (property_id)` (whose `default:` breaks): coordinating lists,
## positional shorthands, one or several values, and the expansion of other shorthands.
func css_parser_parse_css_value_after_special_cases(this: CssParser*, property_id: css_data.PropertyId, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*!:
    if css_data.property_multiplicity(property_id) == css_data.PropertyMultiplicity.coordinating_list and not css_data.property_is_shorthand(property_id):
        return try css_parse_all_as(tokens, (CssStyleValue*?)css_parser_parse_simple_comma_separated_value_list(this, property_id, css_parse_all_as_start(tokens)))

    if css_data.property_is_positional_value_list_shorthand(property_id):
        return try css_parse_all_as(tokens, css_parser_parse_positional_value_list_shorthand(this, property_id, css_parse_all_as_start(tokens)))

    if let value = css_parser_parse_css_value_as_list(this, property_id, tokens):
        return value

    # We have more values than the property claims to allow. Check if it's a shorthand.
    # NB: longhands_for_shorthand() answers css_data's shared vector, which this function changes: copy it (DESIGN §3.3).
    let shared_longhands = css_data.longhands_for_shorthand(property_id)
    var unassigned_properties = ak.vector_clone(&shared_longhands)
    if ak.vector_is_empty(&unassigned_properties):
        error(css_parser_parse_error_syntax_error, "")

    var assigned_values = ak.OrderedHashMap[css_data.PropertyId, ak.Vector[CssStyleValue*], css_data.PropertyIdTraits]()

    while css_syntax.token_stream_has_next_token(tokens) and not ak.vector_is_empty(&unassigned_properties):
        if let property_and_value = css_parser_parse_css_value_for_properties(this, ak.vector_span_const(&unassigned_properties), tokens):
            let property = property_and_value.property
            let value = property_and_value.style_value
            let values = ak.ordered_hash_map_ensure(&assigned_values, property)
            if ak.vector_size(values) + 1 == css_data.property_maximum_value_count(property):
                # We're done with this property, move on to the next one.
                css_remove_property(&unassigned_properties, property)

            ak.vector_append_t(values, value else trap("release_nonnull"))
            continue

        # No property matched, so we're done.
        if css_parser_debug:
            let next = css_syntax.token_stream_next_token(tokens)
            let next_debug_string = css_syntax.component_value_to_debug_string(&next)
            let message = css_string_formatted("No property (from {} properties) matched {}", [ak.arg_u64((u64)ak.vector_size(&unassigned_properties)), css_arg_string(&next_debug_string)])
            ak.dbgln(ak.string_view_text(ak.string_bytes_as_string_view(&message)))
            for id in ak.vector_span_const(&unassigned_properties):
                let name = css_data.string_from_property_id(id)
                ak.dbgln(f"    {ak.string_view_text(ak.fly_string_bytes_as_string_view(&name))}")
        break

    for property in ak.vector_span_const(&unassigned_properties):
        ak.vector_append_t(ak.ordered_hash_map_ensure(&assigned_values, property), css_property_initial_value(property))

    css_syntax.token_stream_discard_whitespace(tokens)
    if css_syntax.token_stream_has_next_token(tokens):
        error(css_parser_parse_error_syntax_error, "")

    var longhand_properties = ak.Vector[css_data.PropertyId]()
    ak.vector_ensure_capacity(&longhand_properties, ak.ordered_hash_map_size(&assigned_values))
    for it in ak.ordered_hash_map_begin(&assigned_values):
        ak.vector_unchecked_append_u(&longhand_properties, it.key)

    var longhand_values = ak.Vector[CssStyleValue*]()
    ak.vector_ensure_capacity(&longhand_values, ak.ordered_hash_map_size(&assigned_values))
    for it in ak.ordered_hash_map_begin(&assigned_values):
        var values = it.value
        if ak.vector_size(&values) == 1:
            ak.vector_unchecked_append_u(&longhand_values, ak.vector_take_first(&values))
        else:
            ak.vector_unchecked_append_u(&longhand_values, css_style_value_list_of(values, CssStyleValueListSeparator.space))

    return css_shorthand_of(property_id, longhand_properties, longhand_values)

# mark: Positional value lists ==================================================================

## Ported from Libraries/LibWeb/CSS/Parser/PropertyParsing.cpp:738 Web::CSS::Parser::Parser::parse_positional_value_list_shorthand.
pub func css_parser_parse_positional_value_list_shorthand(this: CssParser*, property_id: css_data.PropertyId, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    let longhands = css_data.longhands_for_shorthand(property_id)

    var parsed_values = ak.Vector[CssStyleValue*]()

    while let parsed_value = css_parser_parse_css_value_for_property(this, property_id, tokens):
        ak.vector_append_t(&parsed_values, parsed_value)

    if ak.vector_size(&parsed_values) == 0 or ak.vector_size(&parsed_values) > ak.vector_size(&longhands):
        return none

    let first = *ak.vector_at(&parsed_values, 0)
    match ak.vector_size(&longhands):
        2:
            match ak.vector_size(&parsed_values):
                1:
                    return css_shorthand_of(property_id, longhands, css_style_values_of([first, first]))
                2:
                    return css_shorthand_of(property_id, longhands, parsed_values)
                _:
                    trap("VERIFY_NOT_REACHED")
        4:
            match ak.vector_size(&parsed_values):
                1:
                    return css_shorthand_of(property_id, longhands, css_style_values_of([first, first, first, first]))
                2:
                    let second = *ak.vector_at(&parsed_values, 1)
                    return css_shorthand_of(property_id, longhands, css_style_values_of([first, second, first, second]))
                3:
                    let second = *ak.vector_at(&parsed_values, 1)
                    let third = *ak.vector_at(&parsed_values, 2)
                    return css_shorthand_of(property_id, longhands, css_style_values_of([first, second, third, second]))
                4:
                    return css_shorthand_of(property_id, longhands, parsed_values)
                _:
                    trap("VERIFY_NOT_REACHED")
        _:
            trap("TODO")
