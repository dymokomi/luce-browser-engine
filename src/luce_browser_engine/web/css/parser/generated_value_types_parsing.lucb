## Ported from Build/Libraries/LibWeb/CSS/Parser/GeneratedValueTypesParsing.cpp:12 Web::CSS::Parser::Parser::parse_font_weight_absolute_value.
# https://drafts.csswg.org/css-fonts-4/#font-weight-absolute-values
pub func css_parser_parse_font_weight_absolute_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <font-weight-absolute> = normal | bold | <number [1,1000]>
    if let font_weight_absolute_alternative_0 = css_parser_parse_specific_keyword_value(this, tokens, css_data.Keyword.normal):
        return font_weight_absolute_alternative_0

    if let font_weight_absolute_alternative_1 = css_parser_parse_specific_keyword_value(this, tokens, css_data.Keyword.bold):
        return font_weight_absolute_alternative_1

    if let font_weight_absolute_alternative_2 = css_parser_parse_number_value(this, tokens, CssNumericRange(min = 1.0, max = 1000.0)):
        return font_weight_absolute_alternative_2

    return none

## Ported from Build/Libraries/LibWeb/CSS/Parser/GeneratedValueTypesParsing.cpp:36 Web::CSS::Parser::Parser::parse_symbol_value.
# https://drafts.csswg.org/css-counter-styles-3/#typedef-symbol
pub func css_parser_parse_symbol_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <symbol> = <string> | <custom-ident>
    if let symbol_alternative_0 = css_parser_parse_string_value(this, tokens):
        return symbol_alternative_0.css_style_value()

    var no_blacklist: ak.StringView[]
    if let symbol_alternative_1 = css_parser_parse_custom_ident_value(this, tokens, no_blacklist):
        return symbol_alternative_1.css_style_value()

    return none
