## Ported from Libraries/LibWeb/CSS/CounterStyle.cpp:83 Web::CSS::CounterStyle::equals.
pub func css_counter_style_equals(this: CssCounterStyle*, other: CssCounterStyle*) -> bool:
    return ak.fly_string_eq_fly_string(&this.m_name, &other.m_name) and css_counter_style_algorithm_eq(&this.m_algorithm, &other.m_algorithm) and css_counter_style_negative_sign_eq(&this.m_negative_sign, &other.m_negative_sign) and ak.fly_string_eq_fly_string(&this.m_prefix, &other.m_prefix) and ak.fly_string_eq_fly_string(&this.m_suffix, &other.m_suffix) and css_counter_style_ranges_eq(&this.m_range, &other.m_range) and css_counter_style_pad_eq(&this.m_pad, &other.m_pad) and css_counter_style_optional_fly_strings_eq(this.m_fallback, other.m_fallback)

## CounterStyleNegativeSign's defaulted operator==.
pub func css_counter_style_negative_sign_eq(a: const CssCounterStyleNegativeSign*, b: const CssCounterStyleNegativeSign*) -> bool:
    return ak.fly_string_eq_fly_string(&a.prefix, &b.prefix) and ak.fly_string_eq_fly_string(&a.suffix, &b.suffix)

## CounterStylePad's defaulted operator==.
pub func css_counter_style_pad_eq(a: const CssCounterStylePad*, b: const CssCounterStylePad*) -> bool:
    return a.minimum_length == b.minimum_length and ak.fly_string_eq_fly_string(&a.symbol, &b.symbol)

## Vector<CounterStyleRangeEntry>'s operator==.
pub func css_counter_style_ranges_eq(a: const ak.Vector[CssCounterStyleRangeEntry]*, b: const ak.Vector[CssCounterStyleRangeEntry]*) -> bool:
    if ak.vector_size(a) != ak.vector_size(b):
        return false
    for i in 0..<ak.vector_size(a):
        if *ak.vector_at_const(a, i) != *ak.vector_at_const(b, i):
            return false
    return true

## Optional<FlyString>'s operator==.
func css_counter_style_optional_fly_strings_eq(a: ak.FlyString?, b: ak.FlyString?) -> bool:
    if let left = a:
        if let right = b:
            return ak.fly_string_eq_fly_string(&left, &right)
        return false
    return b == none

## Vector<FlyString>'s operator==.
func css_counter_style_symbols_eq(a: const ak.Vector[ak.FlyString]*, b: const ak.Vector[ak.FlyString]*) -> bool:
    if ak.vector_size(a) != ak.vector_size(b):
        return false
    for i in 0..<ak.vector_size(a):
        if not ak.fly_string_eq_fly_string(ak.vector_at_const(a, i), ak.vector_at_const(b, i)):
            return false
    return true

## CounterStyleAlgorithm's operator== (Variant's: the same alternative, then its defaulted operator==).
pub func css_counter_style_algorithm_eq(a: const CssCounterStyleAlgorithm*, b: const CssCounterStyleAlgorithm*) -> bool:
    match *a:
        .css_additive_counter_style_algorithm(left):
            match *b:
                .css_additive_counter_style_algorithm(right):
                    if ak.vector_size(&left.symbol_list) != ak.vector_size(&right.symbol_list):
                        return false
                    for i in 0..<ak.vector_size(&left.symbol_list):
                        let left_tuple = ak.vector_at_const(&left.symbol_list, i)
                        let right_tuple = ak.vector_at_const(&right.symbol_list, i)
                        if left_tuple.weight != right_tuple.weight or not ak.fly_string_eq_fly_string(&left_tuple.symbol, &right_tuple.symbol):
                            return false
                    return true
                _: return false
        .css_fixed_counter_style_algorithm(left):
            match *b:
                .css_fixed_counter_style_algorithm(right): return left.first_symbol == right.first_symbol and css_counter_style_symbols_eq(&left.symbol_list, &right.symbol_list)
                _: return false
        .css_generic_counter_style_algorithm(left):
            match *b:
                .css_generic_counter_style_algorithm(right): return left.type_ == right.type_ and css_counter_style_symbols_eq(&left.symbol_list, &right.symbol_list)
                _: return false
        .css_ethiopic_numeric_counter_style_algorithm(_):
            match *b:
                .css_ethiopic_numeric_counter_style_algorithm(_): return true
                _: return false
        .css_extended_cjk_counter_style_algorithm(left):
            match *b:
                .css_extended_cjk_counter_style_algorithm(right): return left.type_ == right.type_
                _: return false

# mark: Extended CJK ============================================================================

## Ported from Libraries/LibWeb/CSS/CounterStyle.cpp:88 Web::CSS::generate_an_initial_representation_for_extended_cjk_system.
# https://drafts.csswg.org/css-counter-styles-3/#extended-range-optional
func css_generate_an_initial_representation_for_extended_cjk_system(value_: i64, type_: CssExtendedCjkCounterStyleAlgorithmType, digit_strings: ak.FlyString[10], digit_marker_strings: ak.FlyString[3], group_marker_strings: ak.FlyString[3]) -> ak.String:
    var value = value_

    # 1. If the counter value is 0, the representation is the character for 0 specified for the given counter style.
    #    Skip the rest of this algorithm.
    if value == 0:
        return ak.fly_string_to_string_const(&digit_strings[0])

    # 2. If the counter value is negative, instead use the absolute value of the counter value for the remaining steps
    #    of this algorithm.
    # NB: This is handled within `generate_a_counter_representation_impl`

    # 3. Initially represent the counter value as a decimal number. Starting from the right (ones place), split the
    #    decimal number into groups of four digits.
    var groups = ak.Vector[u16]()
    while value > 0:
        ak.vector_append_t(&groups, (u16)(value % 10000))
        value = value // 10000

    var builder = ak.string_builder_new()

    let group_count = (i32)ak.vector_size(&groups)
    var group_index = group_count - 1
    while group_index >= 0:
        let group_value = *ak.vector_at_const(&groups, (usize)group_index)

        var digits = ak.Vector[u8]()

        var temp_group_value = group_value
        while temp_group_value > 0:
            ak.vector_append_t(&digits, (u8)(temp_group_value % 10))
            temp_group_value = temp_group_value // 10

        # NB: Pad the group with zeroes up to four digits, unless this is the most significant group.
        if group_index != group_count - 1:
            while ak.vector_size(&digits) < 4:
                ak.vector_append_t(&digits, (u8)0)

        # NB: We move around the order of spec steps to work with a string builder rather than replacing characters in
        #     a string.
        var digit_index = (i32)ak.vector_size(&digits) - 1
        while digit_index >= 0:
            let digit_value = *ak.vector_at_const(&digits, (usize)digit_index)

            var should_drop_digit = false
            # 6. Drop ones:
            #  - For the Chinese informal styles, for any group with a value between ten and nineteen, remove the tens
            #    digit (leave the digit marker).
            if type_ == CssExtendedCjkCounterStyleAlgorithmType.simp_chinese_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.trad_chinese_informal:
                should_drop_digit = should_drop_digit or (group_value >= 10 and group_value < 20 and digit_index == 1)

            #  - For the Japanese informal and Korean informal styles, if any of the digit markers are preceded
            #   by the digit 1, and that digit is not the first digit of the group, remove the digit (leave the
            #    digit marker).
            if type_ == CssExtendedCjkCounterStyleAlgorithmType.japanese_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_informal:
                should_drop_digit = should_drop_digit or (digit_value == 1 and digit_index != 0)

            #  - For Korean informal styles, if the value of the ten-thousands group is 1, drop the digit (leave the
            #    digit marker).
            if type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_informal:
                should_drop_digit = should_drop_digit or (group_index == 1 and group_value == 1 and digit_index == 0)

            # 7. Drop zeros:
            #  - For the Japanese and Korean styles, drop all zero digits.
            if type_ == CssExtendedCjkCounterStyleAlgorithmType.japanese_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.japanese_formal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hangul_formal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_formal:
                should_drop_digit = should_drop_digit or digit_value == 0

            #  - For the Chinese styles, drop any trailing zeros for all non-zero groups and collapse (across groups)
            #    each remaining consecutive group of zeros into a single zero digit.
            if type_ == CssExtendedCjkCounterStyleAlgorithmType.simp_chinese_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.simp_chinese_formal or type_ == CssExtendedCjkCounterStyleAlgorithmType.trad_chinese_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.trad_chinese_formal:
                var is_trailing_zero = true
                var trailing_zero_index = digit_index
                while trailing_zero_index >= 0:
                    if *ak.vector_at_const(&digits, (usize)trailing_zero_index) != 0:
                        is_trailing_zero = false
                        break
                    trailing_zero_index -= 1

                should_drop_digit = should_drop_digit or is_trailing_zero

                # NB: We don't need to worry about collapsing across groups since dropping trailing zeroes above means
                #     that a run of zeroes can't occur at the end of a group.
                should_drop_digit = should_drop_digit or (digit_value == 0 and digit_index != 3 and *ak.vector_at_const(&digits, (usize)(digit_index + 1)) == 0)

            # 9. Replace the digits 0-9 with the appropriate character for the given counter style.
            if not should_drop_digit:
                ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&digit_strings[digit_value]))

            # 5. Within each group, for each digit that is not 0, append the appropriate digit marker to the digit.
            #    The ones digit of each group has no marker.
            if digit_value != 0 and digit_index != 0:
                ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&digit_marker_strings[(usize)(digit_index - 1)]))
            digit_index -= 1

        # 4. For each group with a non-zero value, append the appropriate group marker to the group. The ones group has no marker.
        if *ak.vector_at_const(&groups, (usize)group_index) != 0 and group_index != 0:
            ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&group_marker_strings[(usize)(group_index - 1)]))

        # 8. For the Korean styles, insert a space (" " U+0020) between each group.
        if (type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hangul_formal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_informal or type_ == CssExtendedCjkCounterStyleAlgorithmType.korean_hanja_formal) and group_index != 0:
            ak.string_builder_append_u8(&builder, ' ')
        group_index -= 1

    # 10. If the counter value was negative, prepend the appropriate negative sign character for the given counter
    #     style as specified in the table of characters for each style.
    # NB: This is handled within `generate_a_counter_representation_impl`

    # 11. Return the resultant string as the representation of the counter value.
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")
