# The static `s_anonymous_layer_id` of next_unique_anonymous_layer_name.
var css_layer_block_rule_anonymous_layer_id: u64

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.h:24 Web::CSS::CSSLayerBlockRule::name.
pub func css_layer_block_rule_name(this: CssLayerBlockRule*) -> ak.FlyString:
    return this.m_name

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.h:25 Web::CSS::CSSLayerBlockRule::internal_name.
pub func css_layer_block_rule_internal_name(this: CssLayerBlockRule*) -> ak.FlyString:
    return this.m_name_internal

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:17 Web::CSS::CSSLayerBlockRule::create.
pub func css_layer_block_rule_create(realm: Realm*, name: ak.FlyString, rules: CssRuleList*) -> CssLayerBlockRule*:
    return realm_create_css_layer_block_rule(realm, realm, name, rules)

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:22 Web::CSS::CSSLayerBlockRule::next_unique_anonymous_layer_name.
pub func css_layer_block_rule_next_unique_anonymous_layer_name() -> ak.FlyString:
    css_layer_block_rule_anonymous_layer_id += 1
    let name = css_string_formatted("#{}", [ak.arg_u64(css_layer_block_rule_anonymous_layer_id)])
    return ak.fly_string_from_string(name)

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:28 Web::CSS::CSSLayerBlockRule::CSSLayerBlockRule.
pub func css_layer_block_rule_construct(this: CssLayerBlockRule*, realm: Realm*, name: ak.FlyString, rules: CssRuleList*):
    css_grouping_rule_construct(this.css_grouping_rule(), realm, rules, CssRuleType.layer_block)
    this.m_name = name
    if ak.fly_string_is_empty(&this.m_name):
        this.m_name_internal = css_layer_block_rule_next_unique_anonymous_layer_name()
    else:
        this.m_name_internal = this.m_name

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:39 Web::CSS::CSSLayerBlockRule::initialize (override).
pub func css_layer_block_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_layer_block_rule)
    css_grouping_rule_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:45 Web::CSS::CSSLayerBlockRule::serialized (override).
pub func css_layer_block_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssLayerBlockRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())

    # AD-HOC: No spec yet, so this is based on the @media serialization algorithm.
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "@layer")
    if not ak.fly_string_is_empty(&this.m_name):
        dump_appendff(&builder, " {}", [css_arg_fly_string(&this.m_name)])

    ak.string_builder_append(&builder, " {\n")
    # AD-HOC: All modern browsers omit the ending newline if there are no CSS rules, so let's do the same.
    if css_rule_list_length(rules) == 0:
        ak.string_builder_append_u8(&builder, '}')
        return ak.string_builder_to_string_without_validation(&builder)

    for i in 0..<css_rule_list_length(rules):
        let rule = css_rule_list_item(rules, i) else trap("null rule")
        if i != 0:
            ak.string_builder_append(&builder, "\n")
        ak.string_builder_append(&builder, "  ")
        let text = css_rule_css_text(rule)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))

    ak.string_builder_append(&builder, "\n}")

    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:72 Web::CSS::CSSLayerBlockRule::internal_qualified_name.
pub func css_layer_block_rule_internal_qualified_name(this: CssLayerBlockRule*) -> ak.FlyString:
    let parent_name = css_rule_parent_layer_internal_qualified_name(this.css_rule())
    if ak.fly_string_is_empty(&parent_name):
        return this.m_name_internal
    return ak.fly_string_from_string(css_string_formatted("{}.{}", [css_arg_fly_string(&parent_name), css_arg_fly_string(&this.m_name_internal)]))

## Ported from Libraries/LibWeb/CSS/CSSLayerBlockRule.cpp:80 Web::CSS::CSSLayerBlockRule::dump (override).
pub func css_layer_block_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssLayerBlockRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Name: `{}` (internal `{}`)\n", [css_arg_fly_string(&this.m_name), css_arg_fly_string(&this.m_name_internal)])
    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Rules ({}):\n", [ak.arg_u64((u64)css_rule_list_length(rules))])
    for rule in ak.vector_span(&rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 2)
