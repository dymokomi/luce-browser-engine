# mark: CSSMediaRule.h ==========================================================================

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.h:27 Web::CSS::CSSMediaRule::matches.
pub func css_media_rule_matches(this: CssMediaRule*) -> bool:
    return css_condition_rule_condition_matches(this.css_condition_rule())

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.h:29 Web::CSS::CSSMediaRule::condition_matches (override).
pub func css_media_rule_condition_matches_impl(base: CssConditionRule*) -> bool:
    let this = (CssMediaRule*)base
    return css_media_list_matches(this.m_media)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.h:31 Web::CSS::CSSMediaRule::media.
pub func css_media_rule_media(this: CssMediaRule*) -> CssMediaList*?:
    return this.m_media

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.h:33 Web::CSS::CSSMediaRule::evaluate.
pub func css_media_rule_evaluate(this: CssMediaRule*, document: DomDocument*) -> bool:
    this.m_did_evaluate = true
    return css_media_list_evaluate(this.m_media, document)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.h:39 Web::CSS::CSSMediaRule::did_evaluate.
pub func css_media_rule_did_evaluate(this: CssMediaRule*) -> bool:
    return this.m_did_evaluate

# mark: CSSMediaRule.cpp ========================================================================

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:19 Web::CSS::CSSMediaRule::create.
pub func css_media_rule_create(realm: Realm*, media_queries: CssMediaList*, rules: CssRuleList*) -> CssMediaRule*:
    return realm_create_css_media_rule(realm, realm, media_queries, rules)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:23 Web::CSS::CSSMediaRule::CSSMediaRule.
pub func css_media_rule_construct(this: CssMediaRule*, realm: Realm*, media: CssMediaList*, rules: CssRuleList*):
    css_condition_rule_construct(this.css_condition_rule(), realm, rules, CssRuleType.media)
    this.m_media = media

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:29 Web::CSS::CSSMediaRule::initialize (override).
pub func css_media_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_media_rule)
    css_condition_rule_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:36 Web::CSS::CSSMediaRule::visit_edges (override).
pub func css_media_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssMediaRule*)base
    css_grouping_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_media)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:41 Web::CSS::CSSMediaRule::condition_text (override).
pub func css_media_rule_condition_text_impl(base: CssConditionRule*) -> ak.String:
    let this = (CssMediaRule*)base
    return css_media_list_media_text(this.m_media)

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:47 Web::CSS::CSSMediaRule::serialized (override).
# https://www.w3.org/TR/cssom-1/#serialize-a-css-rule
pub func css_media_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssMediaRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())

    # The result of concatenating the following:
    var builder = ak.string_builder_new()

    # 1. The string "@media", followed by a single SPACE (U+0020).
    ak.string_builder_append(&builder, "@media ")
    # 2. The result of performing serialize a media query list on rule’s media query list.
    let condition_text = css_condition_rule_condition_text(this.css_condition_rule())
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&condition_text))
    # 3. A single SPACE (U+0020), followed by the string "{", i.e., LEFT CURLY BRACKET (U+007B), followed by a newline.
    ak.string_builder_append(&builder, " {\n")
    # 4. The result of performing serialize a CSS rule on each rule in the rule’s cssRules list,
    #    filtering out empty strings, indenting each item with two spaces, all joined with newline.
    for i in 0..<css_rule_list_length(rules):
        let rule = css_rule_list_item(rules, i) else trap("null rule")
        let result = css_rule_css_text(rule)

        if ak.string_is_empty(&result):
            continue

        ak.string_builder_append(&builder, "  ")
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&result))
        ak.string_builder_append_u8(&builder, '\n')
    # 5. A newline, followed by the string "}", i.e., RIGHT CURLY BRACKET (U+007D)
    # AD-HOC: All modern browsers omit the ending newline if there are no CSS rules, so let's do the same.
    #         If there are rules, the required newline will be appended in the for-loop above.
    ak.string_builder_append_u8(&builder, '}')

    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSMediaRule.cpp:80 Web::CSS::CSSMediaRule::dump (override).
pub func css_media_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssMediaRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())
    css_rule_dump_impl(base, builder, indent_levels)

    css_media_list_dump(this.m_media, builder, indent_levels + 1)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Rules ({}):\n", [ak.arg_u64((u64)css_rule_list_length(rules))])
    for rule in ak.vector_span(&rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 2)
