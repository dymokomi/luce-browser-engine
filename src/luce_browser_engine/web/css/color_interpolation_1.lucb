func css_native_components_to_srgb(native: gfx.ColorComponents, source_type: CssColorStyleValueColorType) -> gfx.ColorComponents:
    match source_type:
        .rgb, .s_rgb:
            return native
        .s_rgb_linear:
            return gfx.linear_srgb_to_srgb(native)
        .hsl:
            return gfx.hsl_to_srgb(native)
        .hwb:
            return gfx.hwb_to_srgb(native)
        .lab:
            let xyz50 = gfx.lab_to_xyz50(native)
            let xyz65 = gfx.xyz50_to_xyz65(xyz50)
            return gfx.linear_srgb_to_srgb(gfx.xyz65_to_linear_srgb(xyz65))
        .ok_lab:
