# mark: MissingComponents and ComponentCategories ===============================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.h:21 Web::CSS::MissingComponents::MissingComponents.
pub func css_missing_components_construct(this: CssMissingComponents*, first: bool, second: bool, third: bool, alpha_value: bool = false):
    this.components = [first, second, third]
    this.alpha = alpha_value

## `MissingComponents { first, second, third, alpha }` as a value; `MissingComponents {}` is all false.
pub func css_missing_components_new(first: bool = false, second: bool = false, third: bool = false, alpha_value: bool = false) -> CssMissingComponents:
    var missing: CssMissingComponents = ---
    css_missing_components_construct(&missing, first, second, third, alpha_value)
    return missing

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.h:27 Web::CSS::MissingComponents::component.
pub func css_missing_components_component(this: CssMissingComponents*, index: usize) -> bool*:
    return &this.components[index]

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.h:28 Web::CSS::MissingComponents::component.
pub func css_missing_components_component_const(this: const CssMissingComponents*, index: usize) -> bool:
    return this.components[index]

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.h:47 Web::CSS::ComponentCategories::ComponentCategories.
pub func css_component_categories_construct(this: CssComponentCategories*, first: CssComponentCategory, second: CssComponentCategory, third: CssComponentCategory):
    this.components = [first, second, third]

## `ComponentCategories { first, second, third }` as a value.
pub func css_component_categories_new(first: CssComponentCategory, second: CssComponentCategory, third: CssComponentCategory) -> CssComponentCategories:
    var categories: CssComponentCategories = ---
    css_component_categories_construct(&categories, first, second, third)
    return categories

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.h:52 Web::CSS::ComponentCategories::component.
pub func css_component_categories_component(this: const CssComponentCategories*, index: usize) -> CssComponentCategory:
    return this.components[index]

# mark: Components and hues =====================================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:17 Web::CSS::interpolate_color_component.
func css_interpolate_color_component(from_: f32, to: f32, delta: f32) -> f32:
    return from_ + (to - from_) * delta

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:23 Web::CSS::fixup_hue.
# https://drafts.csswg.org/css-color-4/#hue-interpolation
func css_fixup_hue(hue1: f32*, hue2: f32*, hue_interpolation_method: css_data.HueInterpolationMethod):
    let difference = *hue2 - *hue1
    match hue_interpolation_method:
        # https://drafts.csswg.org/css-color-4/#hue-shorter
        .shorter:
            if difference > 180.0:
                *hue1 += 360.0
            elif difference < -180.0:
                *hue2 += 360.0
        # https://drafts.csswg.org/css-color-4/#hue-longer
        .longer:
            if difference > 0.0 and difference < 180.0:
                *hue1 += 360.0
            elif difference > -180.0 and difference <= 0.0:
                *hue2 += 360.0
        # https://drafts.csswg.org/css-color-4/#hue-increasing
        .increasing:
            if *hue2 < *hue1:
                *hue2 += 360.0
        # https://drafts.csswg.org/css-color-4/#hue-decreasing
        .decreasing:
            if *hue1 < *hue2:
                *hue1 += 360.0
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:54 Web::CSS::srgb_to_rectangular_color_space.
func css_srgb_to_rectangular_color_space(srgb: gfx.ColorComponents, space: css_data.RectangularColorSpace) -> gfx.ColorComponents:
    if space == css_data.RectangularColorSpace.srgb:
        return srgb
    if space == css_data.RectangularColorSpace.srgb_linear:
        return gfx.srgb_to_linear_srgb(srgb)

    let xyz65 = gfx.linear_srgb_to_xyz65(gfx.srgb_to_linear_srgb(srgb))
    match space:
        .srgb, .srgb_linear:
            trap("VERIFY_NOT_REACHED")
        .display_p3:
            return gfx.linear_display_p3_to_display_p3(gfx.xyz65_to_linear_display_p3(xyz65))
        .display_p3_linear:
            return gfx.xyz65_to_linear_display_p3(xyz65)
        .a98_rgb:
            return gfx.linear_a98_rgb_to_a98_rgb(gfx.xyz65_to_linear_a98_rgb(xyz65))
        .prophoto_rgb:
            return gfx.linear_prophoto_rgb_to_prophoto_rgb(gfx.xyz50_to_linear_prophoto_rgb(gfx.xyz65_to_xyz50(xyz65)))
        .rec2020:
            return gfx.linear_rec2020_to_rec2020(gfx.xyz65_to_linear_rec2020(xyz65))
        .lab:
            return gfx.xyz50_to_lab(gfx.xyz65_to_xyz50(xyz65))
        .oklab:
            return gfx.xyz65_to_oklab(xyz65)
        .xyz, .xyz_d65:
            return xyz65
        .xyz_d50:
            return gfx.xyz65_to_xyz50(xyz65)
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:89 Web::CSS::srgb_to_polar_color_space.
func css_srgb_to_polar_color_space(srgb: gfx.ColorComponents, space: css_data.PolarColorSpace) -> gfx.ColorComponents:
    match space:
        .hsl:
            return gfx.srgb_to_hsl(srgb)
        .hwb:
            return gfx.srgb_to_hwb(srgb)
        .lch:
            let xyz65 = gfx.linear_srgb_to_xyz65(gfx.srgb_to_linear_srgb(srgb))
            return gfx.lab_to_lch(gfx.xyz50_to_lab(gfx.xyz65_to_xyz50(xyz65)))
        .oklch:
            let xyz65 = gfx.linear_srgb_to_xyz65(gfx.srgb_to_linear_srgb(srgb))
            return gfx.oklab_to_oklch(gfx.xyz65_to_oklab(xyz65))
        _: trap("VERIFY_NOT_REACHED")

# mark: Missing and analogous components ========================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:108 Web::CSS::is_component_none.
func css_is_component_none(component: CssStyleValue*) -> bool:
    return css_style_value_to_keyword(component) == css_data.Keyword.none_

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:113 Web::CSS::extract_missing_components.
func css_extract_missing_components(style_value: CssStyleValue*) -> CssMissingComponents:
    if not css_style_value_is_color(style_value):
        return css_missing_components_new()

    let color = css_style_value_as_color(style_value)
    if css_color_style_value_color_type(color) == none:
        return css_missing_components_new()
    let function = as_css_color_function_style_value(color)
    return css_missing_components_new(css_is_component_none(css_color_function_style_value_channel(function, 0)), css_is_component_none(css_color_function_style_value_channel(function, 1)), css_is_component_none(css_color_function_style_value_channel(function, 2)), css_is_component_none(css_color_function_style_value_alpha(function)))

# https://drafts.csswg.org/css-color-4/#interpolation-missing
# Analogous component categories for carrying forward missing components across color spaces.
# Each input color space component is classified into a category. If a missing component in
# the source space has an analogous component in the interpolation space, it is carried forward.
## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:130 Web::CSS::categories_for_rectangular_space.
# https://drafts.csswg.org/css-color-4/#interpolation-missing
func css_categories_for_rectangular_space(space: css_data.RectangularColorSpace) -> CssComponentCategories:
    match space:
        .srgb, .srgb_linear, .display_p3, .display_p3_linear, .a98_rgb, .prophoto_rgb, .rec2020:
            return css_component_categories_new(CssComponentCategory.red, CssComponentCategory.green, CssComponentCategory.blue)
        .xyz, .xyz_d50, .xyz_d65:
            # NOTE: The spec says XYZ spaces are considered super-saturated RGB for this purpose.
            return css_component_categories_new(CssComponentCategory.red, CssComponentCategory.green, CssComponentCategory.blue)
        .lab, .oklab:
            return css_component_categories_new(CssComponentCategory.lightness, CssComponentCategory.opponent_a, CssComponentCategory.opponent_b)
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:153 Web::CSS::categories_for_polar_space.
func css_categories_for_polar_space(space: css_data.PolarColorSpace) -> CssComponentCategories:
    match space:
        .hsl:
            return css_component_categories_new(CssComponentCategory.hue, CssComponentCategory.colorfulness, CssComponentCategory.lightness)
        .hwb:
            # NOTE: Whiteness and Blackness have no analogs in other color spaces.
            return css_component_categories_new(CssComponentCategory.hue, CssComponentCategory.not_analogous, CssComponentCategory.not_analogous)
        .lch, .oklch:
            return css_component_categories_new(CssComponentCategory.lightness, CssComponentCategory.colorfulness, CssComponentCategory.hue)
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:168 Web::CSS::categories_for_color_type.
func css_categories_for_color_type(color_type: CssColorStyleValueColorType) -> CssComponentCategories:
    match color_type:
        .hsl:
            return css_component_categories_new(CssComponentCategory.hue, CssComponentCategory.colorfulness, CssComponentCategory.lightness)
        .hwb:
            return css_component_categories_new(CssComponentCategory.hue, CssComponentCategory.not_analogous, CssComponentCategory.not_analogous)
        .lab, .ok_lab:
            return css_component_categories_new(CssComponentCategory.lightness, CssComponentCategory.opponent_a, CssComponentCategory.opponent_b)
        .lch, .oklch:
            return css_component_categories_new(CssComponentCategory.lightness, CssComponentCategory.colorfulness, CssComponentCategory.hue)
        .rgb, .a98_rgb, .display_p3, .display_p3_linear, .s_rgb, .s_rgb_linear, .pro_photo_rgb, .rec2020, .xyzd50, .xyzd65:
            return css_component_categories_new(CssComponentCategory.red, CssComponentCategory.green, CssComponentCategory.blue)
        _:
            return css_component_categories_new(CssComponentCategory.not_analogous, CssComponentCategory.not_analogous, CssComponentCategory.not_analogous)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:201 Web::CSS::carry_forward_missing_components.
# https://drafts.csswg.org/css-color-4/#interpolation-missing
# Carry forward missing components from the input color space to the interpolation color space.
# A missing component is carried forward if it has an analogous component in the target space.
# Additionally, if ALL components of an analogous set are missing, they are all carried forward.
func css_carry_forward_missing_components(source_missing: CssMissingComponents, source_categories: CssComponentCategories, target_categories: CssComponentCategories) -> CssMissingComponents:
    var result = css_missing_components_new()

    # Same-space: all components map to themselves, including NotAnalogous ones (e.g. HWB W/B).
    if source_categories == target_categories:
        for i: usize in 0..<3:
            *css_missing_components_component(&result, i) = css_missing_components_component_const(&source_missing, i)
        result.alpha = source_missing.alpha
        return result

    # Carry forward individual analogous components
    for target_index: usize in 0..<3:
        if css_component_categories_component(&target_categories, target_index) == CssComponentCategory.not_analogous:
            continue
        for source_index: usize in 0..<3:
            if css_missing_components_component_const(&source_missing, source_index) and css_component_categories_component(&source_categories, source_index) == css_component_categories_component(&target_categories, target_index):
                *css_missing_components_component(&result, target_index) = true
                break

    # If every component of an analogous set is missing in the source, carry forward as a set.
    # The analogous set consists of the components that remain after removing individually analogous ones.
    var all_non_analogous_missing = true
    var has_non_analogous = false
    for i: usize in 0..<3:
        var is_individually_analogous = false
        for j: usize in 0..<3:
            if css_component_categories_component(&source_categories, i) != CssComponentCategory.not_analogous and css_component_categories_component(&source_categories, i) == css_component_categories_component(&target_categories, j):
                is_individually_analogous = true
                break
        if not is_individually_analogous:
            has_non_analogous = true
            if not css_missing_components_component_const(&source_missing, i):
                all_non_analogous_missing = false
    if has_non_analogous and all_non_analogous_missing:
        for i: usize in 0..<3:
            var is_individually_analogous = false
            for j: usize in 0..<3:
                if css_component_categories_component(&target_categories, i) != CssComponentCategory.not_analogous and css_component_categories_component(&target_categories, i) == css_component_categories_component(&source_categories, j):
                    is_individually_analogous = true
                    break
            if not is_individually_analogous:
                *css_missing_components_component(&result, i) = true

    # Alpha is always analogous to itself.
    result.alpha = source_missing.alpha
    return result

# mark: Style values out ========================================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:265 Web::CSS::number_or_none.
func css_number_or_none(value: f32, is_missing: bool) -> CssStyleValue*:
    if is_missing:
        return css_keyword_style_value_create(css_data.Keyword.none_).css_style_value()
    return css_number_style_value_create((f64)value).css_style_value()

## `ColorFunctionStyleValue::create(color_type, c1, c2, c3, alpha)` as a StyleValue.
func css_color_function_value(color_type: CssColorStyleValueColorType, c1: CssStyleValue*, c2: CssStyleValue*, c3: CssStyleValue*, alpha: CssStyleValue*) -> CssStyleValue*:
    return css_color_function_style_value_create(color_type, c1, c2, c3, alpha).css_style_value()

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:272 Web::CSS::style_value_from_rectangular_color_space.
func css_style_value_from_rectangular_color_space(components: gfx.ColorComponents, space: css_data.RectangularColorSpace, missing: CssMissingComponents) -> CssStyleValue*:
    let c1 = css_number_or_none(gfx.color_components_at_const(&components, 0), css_missing_components_component_const(&missing, 0))
    let c2 = css_number_or_none(gfx.color_components_at_const(&components, 1), css_missing_components_component_const(&missing, 1))
    let c3 = css_number_or_none(gfx.color_components_at_const(&components, 2), css_missing_components_component_const(&missing, 2))
    let alpha = css_number_or_none(gfx.color_components_alpha(&components), missing.alpha)

    match space:
        .lab: return css_color_function_value(CssColorStyleValueColorType.lab, c1, c2, c3, alpha)
        .oklab: return css_color_function_value(CssColorStyleValueColorType.ok_lab, c1, c2, c3, alpha)
        .srgb: return css_color_function_value(CssColorStyleValueColorType.s_rgb, c1, c2, c3, alpha)
        .srgb_linear: return css_color_function_value(CssColorStyleValueColorType.s_rgb_linear, c1, c2, c3, alpha)
        .display_p3: return css_color_function_value(CssColorStyleValueColorType.display_p3, c1, c2, c3, alpha)
        .display_p3_linear: return css_color_function_value(CssColorStyleValueColorType.display_p3_linear, c1, c2, c3, alpha)
        .a98_rgb: return css_color_function_value(CssColorStyleValueColorType.a98_rgb, c1, c2, c3, alpha)
        .prophoto_rgb: return css_color_function_value(CssColorStyleValueColorType.pro_photo_rgb, c1, c2, c3, alpha)
        .rec2020: return css_color_function_value(CssColorStyleValueColorType.rec2020, c1, c2, c3, alpha)
        .xyz, .xyz_d65: return css_color_function_value(CssColorStyleValueColorType.xyzd65, c1, c2, c3, alpha)
        .xyz_d50: return css_color_function_value(CssColorStyleValueColorType.xyzd50, c1, c2, c3, alpha)
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:307 Web::CSS::style_value_from_polar_color_space.
func css_style_value_from_polar_color_space(components: gfx.ColorComponents, space: css_data.PolarColorSpace, missing: CssMissingComponents) -> CssStyleValue*:
    let alpha = css_number_or_none(gfx.color_components_alpha(&components), missing.alpha)

    match space:
        .hsl:
            # HSL/HWB resolve to sRGB in computed values, so convert and express as color(srgb ...).
            let srgb = gfx.hsl_to_srgb(components)
            return css_color_function_value(CssColorStyleValueColorType.s_rgb,
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 0)).css_style_value(),
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 1)).css_style_value(),
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 2)).css_style_value(),
                                            alpha)
        .hwb:
            let srgb = gfx.hwb_to_srgb(components)
            return css_color_function_value(CssColorStyleValueColorType.s_rgb,
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 0)).css_style_value(),
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 1)).css_style_value(),
                                            css_number_style_value_create((f64)gfx.color_components_at_const(&srgb, 2)).css_style_value(),
                                            alpha)
        .lch:
            return css_color_function_value(CssColorStyleValueColorType.lch,
                                            css_number_or_none(gfx.color_components_at_const(&components, 0), css_missing_components_component_const(&missing, 0)),
                                            css_number_or_none(gfx.color_components_at_const(&components, 1), css_missing_components_component_const(&missing, 1)),
                                            css_number_or_none(gfx.color_components_at_const(&components, 2), css_missing_components_component_const(&missing, 2)),
                                            alpha)
        .oklch:
            return css_color_function_value(CssColorStyleValueColorType.oklch,
                                            css_number_or_none(gfx.color_components_at_const(&components, 0), css_missing_components_component_const(&missing, 0)),
                                            css_number_or_none(gfx.color_components_at_const(&components, 1), css_missing_components_component_const(&missing, 1)),
                                            css_number_or_none(gfx.color_components_at_const(&components, 2), css_missing_components_component_const(&missing, 2)),
                                            alpha)
        _: trap("VERIFY_NOT_REACHED")

# mark: Style values in =========================================================================

## style_value_to_color_components' lambda `resolve_alpha`.
func css_color_interpolation_resolve_alpha(alpha_sv: CssStyleValue*, context: CssCalculationResolutionContext) -> f32?:
    let result = css_color_style_value_resolve_alpha(alpha_sv, context) else return none
    return (f32)result

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:345 Web::CSS::style_value_to_color_components.
func css_style_value_to_color_components(style_value: CssStyleValue*, context: CssCalculationResolutionContext) -> gfx.ColorComponents?:
    if not css_style_value_is_color(style_value):
        return none

    let color = css_style_value_as_color(style_value)
    let color_type = css_color_style_value_color_type(color) else return none

    match color_type:
        .hsl:
            let hsl = as_css_color_function_style_value(color)
            let h = css_color_style_value_resolve_hue(css_color_function_style_value_channel(hsl, 0), context)
            let s = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(hsl, 1), 100.0, context)
            let l = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(hsl, 2), 100.0, context)
            let a = css_color_interpolation_resolve_alpha(css_color_function_style_value_alpha(hsl), context)
            if h == none or s == none or l == none or a == none:
                return none
            let h_value = h else trap("VERIFY: a value")
            let s_value = s else trap("VERIFY: a value")
            let l_value = l else trap("VERIFY: a value")
            let a_value = a else trap("VERIFY: a value")
            # ColorConversion expects S and L as fractions (0-1), not percentages
            return gfx.color_components_new((f32)h_value, (f32)(s_value / 100.0), (f32)(l_value / 100.0), a_value)
        .hwb:
            let hwb = as_css_color_function_style_value(color)
            let h = css_color_style_value_resolve_hue(css_color_function_style_value_channel(hwb, 0), context)
            let w = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(hwb, 1), 100.0, context)
            let b = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(hwb, 2), 100.0, context)
            let a = css_color_interpolation_resolve_alpha(css_color_function_style_value_alpha(hwb), context)
            if h == none or w == none or b == none or a == none:
                return none
            let h_value = h else trap("VERIFY: a value")
            let w_value = w else trap("VERIFY: a value")
            let b_value = b else trap("VERIFY: a value")
            let a_value = a else trap("VERIFY: a value")
            return gfx.color_components_new((f32)h_value, (f32)(w_value / 100.0), (f32)(b_value / 100.0), a_value)
        .lab:
            let lab = as_css_color_function_style_value(color)
            let l = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(lab, 0), 100.0, context)
            let a_comp = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(lab, 1), 125.0, context)
            let b_comp = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(lab, 2), 125.0, context)
            let a = css_color_interpolation_resolve_alpha(css_color_function_style_value_alpha(lab), context)
            if l == none or a_comp == none or b_comp == none or a == none:
                return none
            let l_value = l else trap("VERIFY: a value")
            let a_comp_value = a_comp else trap("VERIFY: a value")
            let b_comp_value = b_comp else trap("VERIFY: a value")
            let a_value = a else trap("VERIFY: a value")
            return gfx.color_components_new((f32)l_value, (f32)a_comp_value, (f32)b_comp_value, a_value)
        .ok_lab:
            let oklab = as_css_color_function_style_value(color)
            let l = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(oklab, 0), 1.0, context)
            let a_comp = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(oklab, 1), 0.4, context)
            let b_comp = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(oklab, 2), 0.4, context)
            let a = css_color_interpolation_resolve_alpha(css_color_function_style_value_alpha(oklab), context)
            if l == none or a_comp == none or b_comp == none or a == none:
                return none
            let l_value = l else trap("VERIFY: a value")
            let a_comp_value = a_comp else trap("VERIFY: a value")
            let b_comp_value = b_comp else trap("VERIFY: a value")
            let a_value = a else trap("VERIFY: a value")
            return gfx.color_components_new((f32)l_value, (f32)a_comp_value, (f32)b_comp_value, a_value)
        .lch:
            let lch = as_css_color_function_style_value(color)
            let l = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(lch, 0), 100.0, context)
            let c = css_color_style_value_resolve_with_reference_value(css_color_function_style_value_channel(lch, 1), 150.0, context)
            let h = css_color_style_value_resolve_hue(css_color_function_style_value_channel(lch, 2), context)
            let a = css_color_interpolation_resolve_alpha(css_color_function_style_value_alpha(lch), context)
            if l == none or c == none or h == none or a == none:
                return none
