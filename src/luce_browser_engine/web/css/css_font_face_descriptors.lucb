#==============================================================================================

## Ported from Libraries/LibWeb/CSS/CSSFontFaceDescriptors.cpp:16 Web::CSS::CSSFontFaceDescriptors::create.
pub func css_css_font_face_descriptors_create(realm: Realm*, descriptors: ak.Vector[CssDescriptor]) -> CssCssFontFaceDescriptors*:
    return realm_create_css_css_font_face_descriptors(realm, realm, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSFontFaceDescriptors.cpp:21 Web::CSS::CSSFontFaceDescriptors::CSSFontFaceDescriptors.
pub func css_css_font_face_descriptors_construct(this: CssCssFontFaceDescriptors*, realm: Realm*, descriptors: ak.Vector[CssDescriptor]):
    css_descriptors_construct(this.css_descriptors(), realm, css_data.AtRuleId.font_face, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSFontFaceDescriptors.cpp:28 Web::CSS::CSSFontFaceDescriptors::initialize (override).
pub func css_css_font_face_descriptors_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_font_face_descriptors)
    css_style_declaration_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSFontFaceDescriptors.cpp:35 Web::CSS::CSSFontFaceDescriptors::set_property (override).
pub func css_css_font_face_descriptors_set_property_impl(base: CssStyleDeclaration*, property: ak.FlyString, value: ak.StringView, priority: ak.StringView) -> !:
    try css_descriptors_set_property_impl(base, property, value, priority)

    if let parent_rule = css_style_declaration_parent_rule(base):
        if let font_face_rule = as_if_css_font_face_rule(parent_rule):
            css_font_face_rule_handle_descriptor_change(font_face_rule, property)

# mark: The descriptor attributes ===============================================================

