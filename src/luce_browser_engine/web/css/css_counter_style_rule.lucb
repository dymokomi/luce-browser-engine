## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:23 Web::CSS::CSSCounterStyleRule::create.
pub func css_counter_style_rule_create(realm: Realm*, name: ak.FlyString, system: CssStyleValue*?, negative: CssStyleValue*?, prefix: CssStyleValue*?, suffix: CssStyleValue*?, range: CssStyleValue*?, pad_: CssStyleValue*?, fallback: CssStyleValue*?, symbols: CssStyleValue*?, additive_symbols: CssStyleValue*?, speak_as: CssStyleValue*?) -> CssCounterStyleRule*:
    return realm_create_css_counter_style_rule(realm, realm, name, system, negative, prefix, suffix, range, pad_, fallback, symbols, additive_symbols, speak_as)

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:28 Web::CSS::CSSCounterStyleRule::CSSCounterStyleRule.
pub func css_counter_style_rule_construct(this: CssCounterStyleRule*, realm: Realm*, name: ak.FlyString, system: CssStyleValue*?, negative: CssStyleValue*?, prefix: CssStyleValue*?, suffix: CssStyleValue*?, range: CssStyleValue*?, pad_: CssStyleValue*?, fallback: CssStyleValue*?, symbols: CssStyleValue*?, additive_symbols: CssStyleValue*?, speak_as: CssStyleValue*?):
    css_rule_construct(this.css_rule(), realm, CssRuleType.counter_style)
    this.m_name = name
    this.m_system = system
    this.m_negative = negative
    this.m_prefix = prefix
    this.m_suffix = suffix
    this.m_range = range
    this.m_pad = pad_
    this.m_fallback = fallback
    this.m_symbols = symbols
    this.m_additive_symbols = additive_symbols
    this.m_speak_as = speak_as

## Serialize one descriptor of the rule after `prefix`, if it is present (serialized()'s `if (m_x) { ... }` blocks).
func css_counter_style_rule_serialize_descriptor(builder: ak.StringBuilder*, prefix: str, value: CssStyleValue*?):
    if let descriptor_value = value:
        ak.string_builder_append(builder, prefix)
        css_style_value_serialize(descriptor_value, builder, css_syntax.SerializationMode.normal)
        ak.string_builder_append_u8(builder, ';')

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:44 Web::CSS::CSSCounterStyleRule::serialized (override).
pub func css_counter_style_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssCounterStyleRule*)base
    var builder = ak.string_builder_new()
    let name = css_syntax.serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&this.m_name))
    dump_appendff(&builder, "@counter-style {} {{", [css_arg_string(&name)])

    css_counter_style_rule_serialize_descriptor(&builder, " system: ", this.m_system)
    css_counter_style_rule_serialize_descriptor(&builder, " negative: ", this.m_negative)
    css_counter_style_rule_serialize_descriptor(&builder, " prefix: ", this.m_prefix)
    css_counter_style_rule_serialize_descriptor(&builder, " suffix: ", this.m_suffix)
    css_counter_style_rule_serialize_descriptor(&builder, " range: ", this.m_range)
    css_counter_style_rule_serialize_descriptor(&builder, " pad: ", this.m_pad)
    css_counter_style_rule_serialize_descriptor(&builder, " fallback: ", this.m_fallback)
    css_counter_style_rule_serialize_descriptor(&builder, " symbols: ", this.m_symbols)
    css_counter_style_rule_serialize_descriptor(&builder, " additive-symbols: ", this.m_additive_symbols)
    css_counter_style_rule_serialize_descriptor(&builder, " speak-as: ", this.m_speak_as)

    ak.string_builder_append(&builder, " }")
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:114 Web::CSS::CSSCounterStyleRule::set_name.
# https://drafts.csswg.org/css-counter-styles-3/#dom-csscounterstylerule-name
pub func css_counter_style_rule_set_name(this: CssCounterStyleRule*, name: ak.FlyString):
    # On setting the name attribute, run the following steps:

    # 1. If the value is an ASCII case-insensitive match for "none" or one of the non-overridable counter-style names, do nothing and return.
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("none")) or css_counter_style_rule_matches_non_overridable_counter_style_name(name):
        return

    # 2. If the value is an ASCII case-insensitive match for any of the predefined counter styles, lowercase it.
    var new_name = name
    if let keyword = css_data.keyword_from_string(ak.fly_string_bytes_as_string_view(&name)):
        if css_data.keyword_to_counter_style_name_keyword(keyword) != none:
            new_name = ak.fly_string_to_ascii_lowercase(&name)

    # 3. Replace the associated rule’s name with an identifier equal to the value.
    this.m_name = new_name

    css_rule_clear_caches(this.css_rule())

# mark: The descriptor attributes ==============================================================

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:132 Web::CSS::CSSCounterStyleRule::system.
pub func css_counter_style_rule_system(this: CssCounterStyleRule*) -> ak.FlyString:
    let value = this.m_system else return ak.fly_string_from_str("")

    return ak.fly_string_from_string(css_style_value_to_string(value, css_syntax.SerializationMode.normal))

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:141 Web::CSS::CSSCounterStyleRule::set_system.
# https://drafts.csswg.org/css-counter-styles-3/#dom-csscounterstylerule-system
pub func css_counter_style_rule_set_system(this: CssCounterStyleRule*, system: ak.FlyString):
    # 1. parse the given value as the descriptor associated with the attribute.
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_realm_css_parsing_mode(&parsing_params, bind_platform_object_realm(this.bind_platform_object()))
    let maybe_value = parse_css_descriptor(parsing_params, css_data.AtRuleId.counter_style, css_descriptor_name_and_id_from_id(css_data.DescriptorId.system), ak.fly_string_bytes_as_string_view(&system))

    # 2. If the result is invalid according to the given descriptor’s grammar, or would cause the @counter-style rule
    #    to not define a counter style, do nothing and abort these steps. (For example, some systems require the
    #    symbols descriptor to contain two values.)
    # NB: Since we only allow changing parameters of the system, not the algorithm itself (see below), we know this
    #     change can't cause the @counter-style to not define a counter style.
    let value = maybe_value else return

    # 3. If the attribute being set is system, and the new value would change the algorithm used, do nothing and abort
    #    these steps.
    # Note: It’s okay to change an aspect of the algorithm, like the first symbol value of a fixed system.
    let current_system = this.m_system else return
    if css_counter_style_system_style_value_algorithm_differs_from(css_style_value_as_counter_style_system(current_system), css_style_value_as_counter_style_system(value)):
        return

    # 4. Set the descriptor to the value.
    this.m_system = value

    css_rule_clear_caches(this.css_rule())

