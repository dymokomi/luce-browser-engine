## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.h:68 Web::CSS::CSSCounterStyleRule::matches_non_overridable_counter_style_name.
# https://drafts.csswg.org/css-counter-styles-3/#non-overridable-counter-style-names
pub func css_counter_style_rule_matches_non_overridable_counter_style_name(name: ak.FlyString) -> bool:
    # The non-overridable counter-style names are the keywords decimal, disc, square, circle, disclosure-open, and disclosure-closed.
    return (ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("decimal")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("disc")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("square")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("circle")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("disclosure-open")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("disclosure-closed")))

