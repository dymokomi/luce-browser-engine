## The lambda of clear_caches's for_each_owning_style_scope.
func css_counter_style_rule_invalidate_style_scope(context: void*?, style_scope: CssStyleScope*):
    discard(context)
    css_style_scope_invalidate_counter_style_cache(style_scope)
    dom_node_invalidate_style(css_style_scope_node(style_scope), DomStyleInvalidationReason.counter_style_cache_invalidated)

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:359 Web::CSS::CSSCounterStyleRule::clear_caches (override).
pub func css_counter_style_rule_clear_caches_impl(base: CssRule*):
    css_rule_clear_caches_impl(base)

    let parent_style_sheet = css_rule_parent_style_sheet(base) else return

    css_css_style_sheet_for_each_owning_style_scope(parent_style_sheet, ak.Function1[CssStyleScope*, unit](call = css_counter_style_rule_invalidate_style_scope, context = none))

## Ported from Libraries/LibWeb/CSS/CSSCounterStyleRule.cpp:374 Web::CSS::CSSCounterStyleRule::initialize (override).
pub func css_counter_style_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_counter_style_rule)
    js_cell_initialize_impl(base, realm)
