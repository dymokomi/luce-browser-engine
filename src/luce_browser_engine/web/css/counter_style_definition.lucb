# mark: AutoRange ===============================================================================

## One `{ start, end }` range as a one-entry Vector.
func css_counter_style_single_range(start: i32, end: i32) -> ak.Vector[CssCounterStyleRangeEntry]:
    var ranges = ak.Vector[CssCounterStyleRangeEntry]()
    ak.vector_append_t(&ranges, CssCounterStyleRangeEntry(start = start, end = end))
    return ranges

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:16 Web::CSS::AutoRange::resolve.
# https://drafts.csswg.org/css-counter-styles-3/#valdef-counter-style-range-auto
pub func css_auto_range_resolve(algorithm: CssCounterStyleAlgorithm) -> ak.Vector[CssCounterStyleRangeEntry]:
    # The range depends on the counter system:
    match algorithm:
        .css_additive_counter_style_algorithm(_):
            # For additive systems, the range is 0 to positive infinity.
            return css_counter_style_single_range(0, 2147483647)
        .css_fixed_counter_style_algorithm(_):
            # For cyclic, numeric, and fixed systems, the range is negative infinity to positive infinity.
            # NB: cyclic and numeric are handled below.
            return css_counter_style_single_range(-2147483648, 2147483647)
        .css_generic_counter_style_algorithm(generic_algorithm):
            match generic_algorithm.type_:
                .cyclic, .numeric:
                    # For cyclic, numeric, and fixed systems, the range is negative infinity to positive infinity.
                    # NB: Fixed is handled above.
                    return css_counter_style_single_range(-2147483648, 2147483647)
                .alphabetic, .symbolic:
                    # For alphabetic and symbolic systems, the range is 1 to positive infinity.
                    return css_counter_style_single_range(1, 2147483647)
                .additive:
                    # NB: Additive is handled above.
                    trap("VERIFY_NOT_REACHED")
                _: trap("VERIFY_NOT_REACHED")
        .css_ethiopic_numeric_counter_style_algorithm(_):
            # NB: All complex predefined counter styles define their range explicitly (i.e. not via auto)
            trap("VERIFY_NOT_REACHED")
        .css_extended_cjk_counter_style_algorithm(_):
            # NB: All complex predefined counter styles define their range explicitly (i.e. not via auto)
            trap("VERIFY_NOT_REACHED")

# mark: CounterStyleDefinition ==================================================================

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.h:97 Web::CSS::CounterStyleDefinition::create.
pub func css_counter_style_definition_create(name: ak.FlyString, algorithm: CssCounterStyleAlgorithmOrExtends, negative_sign: CssCounterStyleNegativeSign?, prefix: ak.FlyString?, suffix: ak.FlyString?, range: EmptyOrCssAutoRangeOrVectorCssCounterStyleRangeEntry, fallback: ak.FlyString?, pad_: CssCounterStylePad?) -> CssCounterStyleDefinition:
    var definition: CssCounterStyleDefinition = ---
    css_counter_style_definition_construct(&definition, name, algorithm, negative_sign, prefix, suffix, range, fallback, pad_)
    return definition

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:56 Web::CSS::CounterStyleDefinition::from_counter_style_rule.
pub func css_counter_style_definition_from_counter_style_rule(rule: CssCounterStyleRule*, computation_context: CssComputationContext) -> CssCounterStyleDefinition?:
    let system_style_value = css_counter_style_rule_system_style_value(rule) else css_counter_style_system_style_value_create(css_data.CounterStyleSystem.symbolic)
    let maybe_algorithm = css_counter_style_definition_resolve_algorithm(system_style_value, css_counter_style_rule_symbols_style_value(rule), css_counter_style_rule_additive_symbols_style_value(rule), computation_context)
    # maybe_algorithm.downcast<CounterStyleAlgorithm, CounterStyleSystemStyleValue::Extends>()
    var algorithm: CssCounterStyleAlgorithmOrExtends = ---
    match maybe_algorithm:
        .empty: return none
        .css_counter_style_algorithm(value): algorithm = .css_counter_style_algorithm(value)
        .css_counter_style_system_style_value_extends(value): algorithm = .css_counter_style_system_style_value_extends(value)

    var negative_sign: CssCounterStyleNegativeSign? = none
    if let negative_style_value = css_counter_style_rule_negative_style_value(rule):
        negative_sign = css_counter_style_definition_resolve_negative_sign(negative_style_value)
    var prefix: ak.FlyString? = none
    if let prefix_style_value = css_counter_style_rule_prefix_style_value(rule):
        prefix = css_string_from_style_value(prefix_style_value)
    var suffix: ak.FlyString? = none
    if let suffix_style_value = css_counter_style_rule_suffix_style_value(rule):
        suffix = css_string_from_style_value(suffix_style_value)
    var range = EmptyOrCssAutoRangeOrVectorCssCounterStyleRangeEntry.empty
    if let range_style_value = css_counter_style_rule_range_style_value(rule):
        range = match css_counter_style_definition_resolve_range(range_style_value, computation_context):
            .css_auto_range(value) => .css_auto_range(value)
            .vector_css_counter_style_range_entry(value) => .vector_css_counter_style_range_entry(value)
    var fallback: ak.FlyString? = none
    if let fallback_style_value = css_counter_style_rule_fallback_style_value(rule):
        fallback = css_string_from_style_value(fallback_style_value)
    var pad_: CssCounterStylePad? = none
    if let pad_style_value = css_counter_style_rule_pad_style_value(rule):
        pad_ = css_counter_style_definition_resolve_pad(pad_style_value, computation_context)

    return css_counter_style_definition_create(css_counter_style_rule_name(rule), algorithm, negative_sign, prefix, suffix, range, fallback, pad_)

