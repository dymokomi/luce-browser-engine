# mark: Resolving the descriptors ===============================================================

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:77 Web::CSS::CounterStyleDefinition::resolve_algorithm.
# https://drafts.csswg.org/css-counter-styles-3/#counter-style-system
func css_counter_style_definition_resolve_algorithm(system_style_value: CssStyleValue*, symbols_style_value: CssStyleValue*?, additive_symbols_style_value: CssStyleValue*?, computation_context: CssComputationContext) -> EmptyOrCssCounterStyleAlgorithmOrCssCounterStyleSystemStyleValueExtends:
    # https://drafts.csswg.org/css-counter-styles-3/#counter-style-symbols
    # The @counter-style rule must have a valid symbols descriptor if the counter system is cyclic,
    # numeric, alphabetic, symbolic, or fixed, or a valid additive-symbols descriptor if the counter system
    # is additive; otherwise, the @counter-style does not define a counter style (but is still a valid
    # at-rule).
    let counter_style_system = css_style_value_as_counter_style_system(system_style_value)
    match css_counter_style_system_style_value_value(counter_style_system):
        .counter_style_system(system):
            match system:
                .cyclic, .alphabetic, .symbolic, .numeric:
                    let symbols = symbols_style_value else return .empty
                    let parsed_symbols = css_counter_style_definition_resolve_symbols(symbols)
                    if not css_counter_style_system_style_value_is_valid_symbol_count(counter_style_system, ak.vector_size(&parsed_symbols)):
                        return .empty
                    return .css_counter_style_algorithm(.css_generic_counter_style_algorithm(CssGenericCounterStyleAlgorithm(
                        type_ = system,
                        symbol_list = parsed_symbols,
                    )))
                .additive:
                    let additive_symbols = additive_symbols_style_value else return .empty
                    let additive_tuples = css_counter_style_definition_resolve_additive_symbols(additive_symbols, computation_context)
                    if not css_counter_style_system_style_value_is_valid_additive_symbol_count(counter_style_system, ak.vector_size(&additive_tuples)):
                        return .empty
                    return .css_counter_style_algorithm(.css_additive_counter_style_algorithm(CssAdditiveCounterStyleAlgorithm(symbol_list = additive_tuples)))
                _: trap("VERIFY_NOT_REACHED")
        .css_counter_style_system_style_value_fixed(fixed):
            let symbols = symbols_style_value else return .empty
            let parsed_symbols = css_counter_style_definition_resolve_symbols(symbols)
            if not css_counter_style_system_style_value_is_valid_symbol_count(counter_style_system, ak.vector_size(&parsed_symbols)):
                return .empty

            # https://drafts.csswg.org/css-counter-styles-3/#fixed-system
            # If it is omitted, the first symbol value is 1.
            var first_symbol: i32 = 1
            if let first_symbol_value = fixed.first_symbol:
                first_symbol = css_int_from_style_value(css_style_value_absolutized(first_symbol_value, computation_context))

            return .css_counter_style_algorithm(.css_fixed_counter_style_algorithm(CssFixedCounterStyleAlgorithm(
                first_symbol = first_symbol,
                symbol_list = parsed_symbols,
            )))
        .css_counter_style_system_style_value_extends(extends):
            return .css_counter_style_system_style_value_extends(extends)

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:150 Web::CSS::CounterStyleDefinition::resolve_symbols.
# https://drafts.csswg.org/css-counter-styles-3/#descdef-counter-style-symbols
func css_counter_style_definition_resolve_symbols(symbols_style_value: CssStyleValue*) -> ak.Vector[ak.FlyString]:
    let entries = css_style_value_list_values(css_style_value_as_value_list(symbols_style_value))
    var symbols = ak.Vector[ak.FlyString]()
    ak.vector_ensure_capacity(&symbols, ak.vector_size(&entries))
    for entry in ak.vector_span_const(&entries):
        ak.vector_append_t(&symbols, css_string_from_style_value(entry))
    return symbols

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:164 Web::CSS::CounterStyleDefinition::resolve_additive_symbols.
# https://drafts.csswg.org/css-counter-styles-3/#descdef-counter-style-additive-symbols
func css_counter_style_definition_resolve_additive_symbols(additive_symbols_style_value: CssStyleValue*, computation_context: CssComputationContext) -> ak.Vector[CssAdditiveCounterStyleAlgorithmAdditiveTuple]:
    let entries = css_style_value_list_values(css_style_value_as_value_list(additive_symbols_style_value))
    var additive_tuples = ak.Vector[CssAdditiveCounterStyleAlgorithmAdditiveTuple]()
    ak.vector_ensure_capacity(&additive_tuples, ak.vector_size(&entries))
    for entry in ak.vector_span_const(&entries):
        let tuple = css_style_value_list_values(css_style_value_as_value_list(entry))
        assert(ak.vector_size(&tuple) == 2)
        let weight = ak.clamp_to_i32_i32(css_int_from_style_value(css_style_value_absolutized(*ak.vector_at_const(&tuple, 0), computation_context)))
        let symbol = css_string_from_style_value(*ak.vector_at_const(&tuple, 1))
        ak.vector_append_t(&additive_tuples, CssAdditiveCounterStyleAlgorithmAdditiveTuple(weight = weight, symbol = symbol))
    return additive_tuples

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:185 Web::CSS::CounterStyleDefinition::resolve_negative_sign.
# https://drafts.csswg.org/css-counter-styles-3/#counter-style-negative
func css_counter_style_definition_resolve_negative_sign(style_value: CssStyleValue*) -> CssCounterStyleNegativeSign:
    let negative_entries = css_style_value_list_values(css_style_value_as_value_list(style_value))
    return CssCounterStyleNegativeSign(
        prefix = css_string_from_style_value(*ak.vector_at_const(&negative_entries, 0)),
        suffix = css_string_from_style_value(*ak.vector_at_const(&negative_entries, 1)) if ak.vector_size(&negative_entries) > 1 else ak.fly_string_from_str(""),
    )

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:196 Web::CSS::CounterStyleDefinition::resolve_range.
# https://drafts.csswg.org/css-counter-styles-3/#counter-style-range
func css_counter_style_definition_resolve_range(style_value: CssStyleValue*, computation_context: CssComputationContext) -> CssAutoRangeOrVectorCssCounterStyleRangeEntry:
    # auto
    # NB: Resolving auto depends on the algorithm, which we may not know at parse time i.e. if the system is 'extends'
    #     To handle this we return an intermediate value which we resolve when creating the CounterStyle.
    if css_style_value_has_auto(style_value):
        return .css_auto_range(CssAutoRange())

    # [ [ <integer> | infinite ]{2} ]#
    # This defines a comma-separated list of ranges. For each individual range, the first value is the lower bound and
    # the second value is the upper bound. This range is inclusive - it contains both the lower and upper bound
    # numbers. If infinite is used as the first value in a range, it represents negative infinity; if used as the
    # second value, it represents positive infinity. The range of the counter style is the union of all the ranges
    # defined in the list.
    let range_entries = css_style_value_list_values(css_style_value_as_value_list(style_value))
    var ranges = ak.Vector[CssCounterStyleRangeEntry]()
    ak.vector_ensure_capacity(&ranges, ak.vector_size(&range_entries))
    for entry in ak.vector_span_const(&range_entries):
        let range_values = css_style_value_list_values(css_style_value_as_value_list(entry))
        assert(ak.vector_size(&range_values) == 2)
        let start = css_counter_style_definition_resolve_range_value(*ak.vector_at_const(&range_values, 0), -2147483648, computation_context)
        let end = css_counter_style_definition_resolve_range_value(*ak.vector_at_const(&range_values, 1), 2147483647, computation_context)
        ak.vector_append_t(&ranges, CssCounterStyleRangeEntry(start = start, end = end))
    return .vector_css_counter_style_range_entry(ranges)

## resolve_range's lambda `resolve_value`: `infinite` is the given infinite value, an integer its value.
func css_counter_style_definition_resolve_range_value(value: CssStyleValue*, infinite_value: i32, computation_context: CssComputationContext) -> i32:
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.infinite:
        return infinite_value
    return css_int_from_style_value(css_style_value_absolutized(value, computation_context))

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.cpp:233 Web::CSS::CounterStyleDefinition::resolve_pad.
# https://drafts.csswg.org/css-counter-styles-3/#counter-style-pad
func css_counter_style_definition_resolve_pad(style_value: CssStyleValue*, computation_context: CssComputationContext) -> CssCounterStylePad:
    let pad_entries = css_style_value_list_values(css_style_value_as_value_list(style_value))
    return CssCounterStylePad(
        minimum_length = ak.clamp_to_i32_i32(css_int_from_style_value(css_style_value_absolutized(*ak.vector_at_const(&pad_entries, 0), computation_context))),
        symbol = css_string_from_style_value(*ak.vector_at_const(&pad_entries, 1)),
    )

## Ported from Libraries/LibWeb/CSS/CounterStyleDefinition.h:129 Web::CSS::CounterStyleDefinition::CounterStyleDefinition.
pub func css_counter_style_definition_construct(this: CssCounterStyleDefinition*, name: ak.FlyString, algorithm: CssCounterStyleAlgorithmOrExtends, negative_sign: CssCounterStyleNegativeSign?, prefix: ak.FlyString?, suffix: ak.FlyString?, range: EmptyOrCssAutoRangeOrVectorCssCounterStyleRangeEntry, fallback: ak.FlyString?, pad_: CssCounterStylePad?):
    this.m_name = name
    this.m_algorithm = algorithm
    this.m_negative_sign = negative_sign
    this.m_prefix = prefix
    this.m_suffix = suffix
    this.m_range = range
    this.m_fallback = fallback
    this.m_pad = pad_
