## `TouchActionData {}`: every interaction allowed (the default member initializers).
pub func css_touch_action_data_new() -> CssTouchActionData:
    var touch_action = CssTouchActionData()
    css_touch_action_data_init_fields(&touch_action)
    return touch_action

## `TransformOrigin {}`: 50% 50% 0% (the default member initializers).
pub func css_transform_origin_new() -> CssTransformOrigin:
    var transform_origin: CssTransformOrigin = ---
    css_transform_origin_init_fields(&transform_origin)
    return transform_origin

## `ShadowData {}`: the default member initializers (zero lengths, transparent, outer).
pub func css_shadow_data_new() -> CssShadowData:
    var shadow: CssShadowData = ---
    css_shadow_data_init_fields(&shadow)
    return shadow

## `BorderRadiusData {}`: both radii InitialValues::border_radius() (the default member initializers).
pub func css_border_radius_data_new() -> CssBorderRadiusData:
    var radius: CssBorderRadiusData = ---
    css_border_radius_data_init_fields(&radius)
    return radius

