## Ported from Libraries/LibWeb/CSS/ComputedValues.h:454 Web::CSS::ContentData::visit_edges.
pub func css_content_data_visit_edges(this: const CssContentData*, visitor: gc.CellVisitor*):
    for item in ak.vector_span_const(&this.data):
        match item:
            .css_image_style_value(ptr):
                css_style_value_visit_edges(ptr.css_style_value(), visitor)
            _:
                continue

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:474 Web::CSS::BorderRadiusData::is_initial.
pub func css_border_radius_data_is_initial(this: const CssBorderRadiusData*) -> bool:
    if not css_length_percentage_is_length(&this.horizontal_radius):
        return false
    let horizontal = css_length_percentage_length(&this.horizontal_radius)
    if not css_length_is_px(&horizontal) or not gfx.eq_css_pixels_int(css_length_absolute_length_to_px(&horizontal), 0):
        return false
    if not css_length_percentage_is_length(&this.vertical_radius):
        return false
    let vertical = css_length_percentage_length(&this.vertical_radius)
    return css_length_is_px(&vertical) and gfx.eq_css_pixels_int(css_length_absolute_length_to_px(&vertical), 0)

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:488 Web::CSS::to_gfx_scaling_mode.
pub func css_to_gfx_scaling_mode(css_value: css_data.ImageRendering, source: gfx.IntSize, target: gfx.IntSize) -> gfx.ScalingMode:
    match css_value:
        .auto, .high_quality, .smooth:
            if target.m_width < source.m_width and target.m_height < source.m_height:
                return gfx.ScalingMode.bilinear_mipmap
            return gfx.ScalingMode.bilinear
        .crisp_edges, .pixelated:
            return gfx.ScalingMode.nearest_neighbor
        _:
            trap("VERIFY_NOT_REACHED")
