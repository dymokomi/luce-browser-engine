#
#   language_invalidator - style invalidation after an element's lang or dir, or the text that
#                          dir=auto resolves from, changes
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Invalidation/LanguageInvalidator.cpp (lines 1-70).
