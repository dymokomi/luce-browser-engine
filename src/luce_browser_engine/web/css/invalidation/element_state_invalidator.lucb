## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:13 Web::CSS::Invalidation::invalidate_style_after_active_state_change.
pub func css_invalidation_invalidate_style_after_active_state_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.element_set_active)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:18 Web::CSS::Invalidation::invalidate_style_after_modal_state_change.
pub func css_invalidation_invalidate_style_after_modal_state_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_dialog_element_set_is_modal)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:23 Web::CSS::Invalidation::invalidate_style_after_open_state_change.
pub func css_invalidation_invalidate_style_after_open_state_change(element: DomElement*):
    # The :open pseudo-class can affect sibling selectors (e.g. dialog:open + sibling), so keep the existing broad
    # subtree and sibling invalidation.
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_details_or_dialog_open_attribute_change)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:30 Web::CSS::Invalidation::invalidate_style_after_option_selected_state_change.
pub func css_invalidation_invalidate_style_after_option_selected_state_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_option_element_selected_change)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:35 Web::CSS::Invalidation::invalidate_style_after_input_open_state_change.
pub func css_invalidation_invalidate_style_after_input_open_state_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_input_element_set_is_open)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:40 Web::CSS::Invalidation::invalidate_style_after_select_open_state_change.
pub func css_invalidation_invalidate_style_after_select_open_state_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_select_element_set_is_open)

## Ported from Libraries/LibWeb/CSS/Invalidation/ElementStateInvalidator.cpp:45 Web::CSS::Invalidation::invalidate_style_after_shadow_root_change.
pub func css_invalidation_invalidate_style_after_shadow_root_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.element_set_shadow_root)
