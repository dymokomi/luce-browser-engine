## Ported from Libraries/LibWeb/CSS/Invalidation/LinkInvalidator.cpp:15 Web::CSS::Invalidation::invalidate_style_after_hyperlink_state_change.
pub func css_invalidation_invalidate_style_after_hyperlink_state_change(element: DomElement*):
    var properties: ak.Vector[CssInvalidationSetProperty]
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.any_link))
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.link))
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.local_link))
    dom_node_invalidate_style_vector(element.dom_node(), DomStyleInvalidationReason.html_hyperlink_element_href_change, properties, DomStyleInvalidationOptions())
