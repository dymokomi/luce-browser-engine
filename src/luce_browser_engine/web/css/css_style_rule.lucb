pub func css_style_rule_selectors(this: CssStyleRule*) -> ak.Vector[CssSelector*]:
    return this.m_selectors

## Ported from Libraries/LibWeb/CSS/CSSStyleRule.h:29 Web::CSS::CSSStyleRule::declaration.
pub func css_style_rule_declaration(this: CssStyleRule*) -> CssStyleProperties*:
