# mark: CSSSupportsRule.h =======================================================================

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.h:27 Web::CSS::CSSSupportsRule::matches.
pub func css_supports_rule_matches(this: CssSupportsRule*) -> bool:
    return css_condition_rule_condition_matches(this.css_condition_rule())

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.h:29 Web::CSS::CSSSupportsRule::condition_matches (override).
pub func css_supports_rule_condition_matches_impl(base: CssConditionRule*) -> bool:
    let this = (CssSupportsRule*)base
    return css_supports_matches(this.m_supports)

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.h:31 Web::CSS::CSSSupportsRule::supports.
pub func css_supports_rule_supports(this: CssSupportsRule*) -> CssSupports*:
    return this.m_supports

# mark: CSSSupportsRule.cpp =====================================================================

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:17 Web::CSS::CSSSupportsRule::create.
pub func css_supports_rule_create(realm: Realm*, supports: CssSupports*, rules: CssRuleList*) -> CssSupportsRule*:
    return realm_create_css_supports_rule(realm, realm, supports, rules)

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:22 Web::CSS::CSSSupportsRule::CSSSupportsRule.
pub func css_supports_rule_construct(this: CssSupportsRule*, realm: Realm*, supports: CssSupports*, rules: CssRuleList*):
    css_condition_rule_construct(this.css_condition_rule(), realm, rules, CssRuleType.supports)
    this.m_supports = supports

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:28 Web::CSS::CSSSupportsRule::initialize (override).
pub func css_supports_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_supports_rule)
    css_condition_rule_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:34 Web::CSS::CSSSupportsRule::condition_text (override).
pub func css_supports_rule_condition_text_impl(base: CssConditionRule*) -> ak.String:
    let this = (CssSupportsRule*)base
    return css_supports_to_string(this.m_supports)

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:40 Web::CSS::CSSSupportsRule::serialized (override).
# https://www.w3.org/TR/cssom-1/#serialize-a-css-rule
pub func css_supports_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssSupportsRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())

    # Note: The spec doesn't cover this yet, so I'm roughly following the spec for the @media rule.
    # It should be pretty close!

    var builder = ak.string_builder_new()

    ak.string_builder_append(&builder, "@supports ")
    let condition_text = css_condition_rule_condition_text(this.css_condition_rule())
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&condition_text))
    ak.string_builder_append(&builder, " {\n")
    for i in 0..<css_rule_list_length(rules):
        let rule = css_rule_list_item(rules, i) else trap("null rule")
        if i != 0:
            ak.string_builder_append(&builder, "\n")
        ak.string_builder_append(&builder, "  ")
        let text = css_rule_css_text(rule)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))
    ak.string_builder_append(&builder, "\n}")

    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSSupportsRule.cpp:63 Web::CSS::CSSSupportsRule::dump (override).
pub func css_supports_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssSupportsRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())
    css_rule_dump_impl(base, builder, indent_levels)

    css_supports_dump(css_supports_rule_supports(this), builder, indent_levels + 1)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Rules ({}):\n", [ak.arg_u64((u64)css_rule_list_length(rules))])
    for rule in ak.vector_span(&rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 2)
