## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.h:25 Web::CSS::CSSNestedDeclarations::declaration.
pub func css_nested_declarations_declaration(this: CssNestedDeclarations*) -> CssStyleProperties*:
    return this.m_declaration

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:18 Web::CSS::CSSNestedDeclarations::create.
pub func css_nested_declarations_create_css_parser(realm: Realm*, parser: CssParser*, declarations: ak.Vector[css_syntax.Declaration]) -> CssNestedDeclarations*:
    return realm_create_css_nested_declarations(realm, realm, css_parser_convert_to_style_declaration(parser, &declarations))

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:23 Web::CSS::CSSNestedDeclarations::create.
pub func css_nested_declarations_create_css_style_properties(realm: Realm*, declaration: CssStyleProperties*) -> CssNestedDeclarations*:
    return realm_create_css_nested_declarations(realm, realm, declaration)

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:28 Web::CSS::CSSNestedDeclarations::CSSNestedDeclarations.
pub func css_nested_declarations_construct(this: CssNestedDeclarations*, realm: Realm*, declaration: CssStyleProperties*):
    css_rule_construct(this.css_rule(), realm, CssRuleType.nested_declarations)
    this.m_declaration = declaration
    css_style_declaration_set_parent_rule(this.m_declaration.css_style_declaration(), this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:35 Web::CSS::CSSNestedDeclarations::initialize (override).
pub func css_nested_declarations_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_nested_declarations)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:41 Web::CSS::CSSNestedDeclarations::visit_edges (override).
pub func css_nested_declarations_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssNestedDeclarations*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_declaration)
    gc.cell_visitor_visit_t(visitor, this.m_parent_style_rule)

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:48 Web::CSS::CSSNestedDeclarations::style.
pub func css_nested_declarations_style(this: CssNestedDeclarations*) -> CssStyleProperties*:
    return this.m_declaration

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:53 Web::CSS::CSSNestedDeclarations::parent_style_rule.
pub func css_nested_declarations_parent_style_rule(this: CssNestedDeclarations*) -> CssStyleRule*:
    if let cached = this.m_parent_style_rule:
        return cached

    var parent = css_rule_parent_rule(this.css_rule())
    while let current = parent:
        if let style_rule = as_if_css_style_rule(current):
            this.m_parent_style_rule = style_rule
            return style_rule
        parent = css_rule_parent_rule(current)

    ak.dbgln("CSSNestedDeclarations has no parent style rule!")
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:69 Web::CSS::CSSNestedDeclarations::serialized (override).
pub func css_nested_declarations_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssNestedDeclarations*)base
    # NOTE: There's no proper spec for this yet, only this note:
    # "The CSSNestedDeclarations rule serializes as if its declaration block had been serialized directly."
    # - https://drafts.csswg.org/css-nesting-1/#ref-for-cssnesteddeclarations%E2%91%A1
    # So, we'll do the simple thing and hope it's good.
    return css_style_declaration_serialized(this.m_declaration.css_style_declaration())

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:78 Web::CSS::CSSNestedDeclarations::clear_caches (override).
pub func css_nested_declarations_clear_caches_impl(base: CssRule*):
    let this = (CssNestedDeclarations*)base
    css_rule_clear_caches_impl(base)
    this.m_parent_style_rule = none

## Ported from Libraries/LibWeb/CSS/CSSNestedDeclarations.cpp:84 Web::CSS::CSSNestedDeclarations::dump (override).
pub func css_nested_declarations_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssNestedDeclarations*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_style_properties(builder, this.m_declaration, indent_levels + 1)
