## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.h:22 Web::CSS::CSSNamespaceRule::set_namespace_uri.
pub func css_namespace_rule_set_namespace_uri(this: CssNamespaceRule*, value: ak.FlyString):
    this.m_namespace_uri = value

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.h:23 Web::CSS::CSSNamespaceRule::namespace_uri.
pub func css_namespace_rule_namespace_uri(this: CssNamespaceRule*) -> ak.FlyString:
    return this.m_namespace_uri

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.h:24 Web::CSS::CSSNamespaceRule::set_prefix.
pub func css_namespace_rule_set_prefix(this: CssNamespaceRule*, value: ak.FlyString):
    this.m_prefix = value

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.h:25 Web::CSS::CSSNamespaceRule::prefix.
pub func css_namespace_rule_prefix(this: CssNamespaceRule*) -> ak.FlyString:
    return this.m_prefix

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.cpp:18 Web::CSS::CSSNamespaceRule::CSSNamespaceRule.
pub func css_namespace_rule_construct(this: CssNamespaceRule*, realm: Realm*, prefix: ak.FlyString?, namespace_uri: ak.FlyString):
    css_rule_construct(this.css_rule(), realm, CssRuleType.namespace)
    this.m_namespace_uri = namespace_uri
    this.m_prefix = prefix else ak.fly_string_from_str("")

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.cpp:28 Web::CSS::CSSNamespaceRule::create.
pub func css_namespace_rule_create(realm: Realm*, prefix: ak.FlyString?, namespace_uri: ak.FlyString) -> CssNamespaceRule*:
    return realm_create_css_namespace_rule(realm, realm, prefix, namespace_uri)

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.cpp:33 Web::CSS::CSSNamespaceRule::initialize (override).
pub func css_namespace_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_namespace_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.cpp:40 Web::CSS::CSSNamespaceRule::serialized (override).
# https://www.w3.org/TR/cssom/#serialize-a-css-rule
pub func css_namespace_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssNamespaceRule*)base
    var builder = ak.string_builder_new()
    # The literal string "@namespace", followed by a single SPACE (U+0020),
    ak.string_builder_append(&builder, "@namespace ")

    # followed by the serialization as an identifier of the prefix attribute (if any),
    if not ak.fly_string_is_empty(&this.m_prefix):
        css_syntax.serialize_an_identifier_string_builder(&builder, ak.fly_string_bytes_as_string_view(&this.m_prefix))
        # followed by a single SPACE (U+0020) if there is a prefix,
        ak.string_builder_append(&builder, " ")

    #  followed by the serialization as URL of the namespaceURI attribute,
    css_syntax.serialize_a_url_string_builder(&builder, ak.fly_string_bytes_as_string_view(&this.m_namespace_uri))

    # followed the character ";" (U+003B).
    ak.string_builder_append(&builder, ";")

    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSNamespaceRule.cpp:62 Web::CSS::CSSNamespaceRule::dump (override).
pub func css_namespace_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssNamespaceRule*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Namespace: {}\n", [css_arg_fly_string(&this.m_namespace_uri)])
    if not ak.fly_string_is_empty(&this.m_prefix):
        dump_indent(builder, indent_levels + 1)
        dump_appendff(builder, "Prefix: {}\n", [css_arg_fly_string(&this.m_prefix)])
