## Ported from Libraries/LibWeb/CSS/ColumnCount.h:18 Web::CSS::ColumnCount::make_auto.
pub func css_column_count_make_auto() -> CssColumnCount:
    var column_count: CssColumnCount = ---
    css_column_count_construct(&column_count)
    return column_count

## Ported from Libraries/LibWeb/CSS/ColumnCount.h:23 Web::CSS::ColumnCount::make_integer.
pub func css_column_count_make_integer(value: i32) -> CssColumnCount:
    var column_count: CssColumnCount = ---
    css_column_count_construct_i32(&column_count, value)
    return column_count

## Ported from Libraries/LibWeb/CSS/ColumnCount.h:28 Web::CSS::ColumnCount::is_auto.
pub func css_column_count_is_auto(this: const CssColumnCount*) -> bool:
    return this.m_type == CssColumnCountType.auto

## Ported from Libraries/LibWeb/CSS/ColumnCount.h:29 Web::CSS::ColumnCount::value.
pub func css_column_count_value(this: const CssColumnCount*) -> i32:
    return this.m_value else trap("VERIFY: an integer column count")

## Ported from Libraries/LibWeb/CSS/ColumnCount.h:32 Web::CSS::ColumnCount::ColumnCount.
pub func css_column_count_construct_i32(this: CssColumnCount*, value: i32):
    this.m_type = CssColumnCountType.integer
    this.m_value = value

## Ported from Libraries/LibWeb/CSS/ColumnCount.h:37 Web::CSS::ColumnCount::ColumnCount.
pub func css_column_count_construct(this: CssColumnCount*):
    # The default member initializers: `Type m_type { Type::Auto }` and an empty `Optional<int> m_value`.
    this.m_type = CssColumnCountType.auto
    this.m_value = none
