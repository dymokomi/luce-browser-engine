#
#   descriptor_name_and_id - DescriptorNameAndID: a descriptor's name with its DescriptorID
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/DescriptorNameAndID.h (lines 1-72), with the hash of
#       AK::Traits<DescriptorNameAndID> (CssDescriptorNameAndIdTraits in
#       generated/types_traits calls css_descriptor_name_and_id_hash and _eq).
