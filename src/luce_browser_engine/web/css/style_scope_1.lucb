#==============================================================================================
#
#   style_scope_1 - CSS::StyleScope: the rule caches of a document or shadow root
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/StyleScope.cpp (lines 1-420) and StyleScope.h's inline members:
#       visiting the caches, StyleCache creation, building the rule cache (the user-agent,
#       user and author style sheets bucketed into RuleCaches per cascade layer, the
#       pseudo-class rule caches and the @keyframes sets), the user-agent style sheets and the
#       selector insights.
#
#       A StyleScope is embedded in its Document or ShadowRoot; a StyleCache is ref-counted in
#       C++ and a managed blob here (DESIGN.md §3.3), as are the per-layer RuleCaches
#       (NonnullOwnPtr) and the pseudo-class RuleCaches (OwnPtr). The lambdas are private
#       functions with capture structs (DESIGN.md §2.7).
#
#       Copyright (c) 2018-2025, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2022-2025, Aliaksandr Kalenik <kalenik.aliaksandr@gmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Visiting and StyleCache =================================================================

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:30 Web::CSS::RuleCaches::visit_edges.
pub func css_rule_caches_visit_edges(this: CssRuleCaches*, visitor: gc.CellVisitor*):
    css_rule_cache_visit_edges(&this.main, visitor)
    for it in ak.hash_map_begin(&this.by_layer):
        css_rule_cache_visit_edges(it.value, visitor)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:38 Web::CSS::StyleCache::create.
pub func css_style_cache_create() -> CssStyleCache*:
    let style_cache = new CssStyleCache else trap("out of memory")
    ak.vector_append_t(&style_cache.qualified_layer_names_in_order, ak.FlyString())
    return style_cache

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:45 Web::CSS::StyleCache::create_for_style_scope.
pub func css_style_cache_create_for_style_scope(style_scope: CssStyleScope*) -> CssStyleCache*:
    let style_cache = css_style_cache_create()
    css_style_scope_populate_rule_cache(style_scope, style_cache)
    return style_cache

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:52 Web::CSS::StyleCache::visit_edges.
pub func css_style_cache_visit_edges(this: CssStyleCache*, visitor: gc.CellVisitor*):
    for cache in this.pseudo_class_rule_cache:
        if let rule_cache = cache:
            css_rule_cache_visit_edges(rule_cache, visitor)
    css_rule_caches_visit_edges(&this.author_rule_cache, visitor)
    css_rule_caches_visit_edges(&this.user_rule_cache, visitor)
    css_rule_caches_visit_edges(&this.user_agent_rule_cache, visitor)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:63 Web::CSS::StyleScope::visit_edges.
pub func css_style_scope_visit_edges(this: CssStyleScope*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_t_2(visitor, this.m_node)
    gc.cell_visitor_visit_t(visitor, this.m_user_style_sheet)
    if let rule_cache = this.m_rule_cache:
        css_style_cache_visit_edges(rule_cache, visitor)
    # visitor.visit(m_pending_has_invalidations): the keys are the cells.
    for it in ak.ordered_hash_map_begin_const(&this.m_pending_has_invalidations):
        gc.cell_visitor_visit_t_2(visitor, it.key)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:72 Web::CSS::MatchingRule::visit_edges.
pub func css_matching_rule_visit_edges(this: CssMatchingRule*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_t(visitor, this.rule)
    gc.cell_visitor_visit_t(visitor, this.sheet)

## RuleCache::visit_edges' `visit_vector` lambda.
func css_rule_cache_visit_vector(vector: ak.Vector[CssMatchingRule]*, visitor: gc.CellVisitor*):
    let rules = ak.vector_span(vector)
    for rule in &rules:
        css_matching_rule_visit_edges(rule, visitor)

## RuleCache::visit_edges' `visit_map` lambda.
func css_rule_cache_visit_map[KT: ak.Traits[ak.FlyString]](map: ak.HashMap[ak.FlyString, ak.Vector[CssMatchingRule], KT]*, visitor: gc.CellVisitor*):
    for it in ak.hash_map_begin(map):
        css_rule_cache_visit_vector(&it.value, visitor)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:78 Web::CSS::RuleCache::visit_edges.
pub func css_rule_cache_visit_edges(this: CssRuleCache*, visitor: gc.CellVisitor*):
    css_rule_cache_visit_map(&this.rules_by_id, visitor)
    css_rule_cache_visit_map(&this.rules_by_class, visitor)
    css_rule_cache_visit_map(&this.rules_by_tag_name, visitor)
    css_rule_cache_visit_map(&this.rules_by_attribute_name, visitor)
    for i in 0..<this.rules_by_pseudo_element.length:
        css_rule_cache_visit_vector(&this.rules_by_pseudo_element[i], visitor)
    css_rule_cache_visit_vector(&this.root_rules, visitor)
    css_rule_cache_visit_vector(&this.slotted_rules, visitor)
    css_rule_cache_visit_vector(&this.part_rules, visitor)
    css_rule_cache_visit_vector(&this.other_rules, visitor)

