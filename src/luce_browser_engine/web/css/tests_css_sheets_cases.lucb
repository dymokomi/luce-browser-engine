#==============================================================================================
#
#   tests_css_sheets_cases - the style sheet, rule list and rule cases pinned to the reference
#                            build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's CSS parser and CSSOM on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/css_sheets: cases.txt, oracle.cpp, gen_luce_cases.py,
#       build.sh). tests_css_sheets runs each case through the port and compares the output.
#
#==============================================================================================

## One oracle case: the mode, its arguments, and the reference build's output.
struct TestCssSheetsCase:
    let mode: str
    let arguments: str[4]
    let expected: str

## Every oracle case, in cases.txt order (21 more, marked "!" in cases.txt, wait for other regions).
let test_css_sheets_cases: TestCssSheetsCase[113] = [
    TestCssSheetsCase(mode = "sheet", arguments = ["", "", "", ""], expected = "  rules 0\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a {}", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a, b > c, .x#y {}", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a, b > c, .x#y { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a {} b {} c {}", "", "", ""], expected = "  rules 3\n    CSSStyleRule type=1 internal=1 text=a { }\n    CSSStyleRule type=1 internal=1 text=b { }\n    CSSStyleRule type=1 internal=1 text=c { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a { b {} }", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & b { }\n}\n      CSSStyleRule type=1 internal=1 text=& b { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a { & b {} .c {} }", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & b { }\n  & .c { }\n}\n      CSSStyleRule type=1 internal=1 text=& b { }\n      CSSStyleRule type=1 internal=1 text=& .c { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a { b { c {} } }", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & b {\n  & c { }\n}\n}\n      CSSStyleRule type=1 internal=1 text=& b {\n  & c { }\n}\n        CSSStyleRule type=1 internal=1 text=& c { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer x;", "", "", ""], expected = "  rules 1\n    CSSLayerStatementRule type=0 internal=101 text=@layer x;\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer x, y.z, w;", "", "", ""], expected = "  rules 1\n    CSSLayerStatementRule type=0 internal=101 text=@layer x, y.z, w;\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer x { a {} }", "", "", ""], expected = "  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  a { }\n}\n      CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer { a {} }", "", "", ""], expected = "  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer {\n  a { }\n}\n      CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer x {}", "", "", ""], expected = "  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n}\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer x { @layer y { a {} } b {} }", "", "", ""], expected = "  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  @layer y {\n  a { }\n}\n  b { }\n}\n      CSSLayerBlockRule type=0 internal=100 text=@layer y {\n  a { }\n}\n        CSSStyleRule type=1 internal=1 text=a { }\n      CSSStyleRule type=1 internal=1 text=b { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@layer a, b; @layer a { x {} } @layer { y {} }", "", "", ""], expected = "  rules 3\n    CSSLayerStatementRule type=0 internal=101 text=@layer a, b;\n    CSSLayerBlockRule type=0 internal=100 text=@layer a {\n  x { }\n}\n      CSSStyleRule type=1 internal=1 text=x { }\n    CSSLayerBlockRule type=0 internal=100 text=@layer {\n  y { }\n}\n      CSSStyleRule type=1 internal=1 text=y { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@namespace url(http://www.w3.org/2000/svg);", "", "", ""], expected = "  rules 1\n    CSSNamespaceRule type=10 internal=10 text=@namespace url(\"http://www.w3.org/2000/svg\");\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@namespace svg url(http://www.w3.org/2000/svg);", "", "", ""], expected = "  rules 1\n    CSSNamespaceRule type=10 internal=10 text=@namespace svg url(\"http://www.w3.org/2000/svg\");\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@namespace svg \"http://www.w3.org/2000/svg\";", "", "", ""], expected = "  rules 1\n    CSSNamespaceRule type=10 internal=10 text=@namespace svg url(\"http://www.w3.org/2000/svg\");\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@namespace svg url(http://www.w3.org/2000/svg); svg|rect {}", "", "", ""], expected = "  rules 2\n    CSSNamespaceRule type=10 internal=10 text=@namespace svg url(\"http://www.w3.org/2000/svg\");\n    CSSStyleRule type=1 internal=1 text=svg|rect { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@namespace a url(x); @namespace b url(y); a|p {} b|q {} *|r {}", "", "", ""], expected = "  rules 5\n    CSSNamespaceRule type=10 internal=10 text=@namespace a url(\"x\");\n    CSSNamespaceRule type=10 internal=10 text=@namespace b url(\"y\");\n    CSSStyleRule type=1 internal=1 text=a|p { }\n    CSSStyleRule type=1 internal=1 text=b|q { }\n    CSSStyleRule type=1 internal=1 text=r { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a {} @namespace x url(y);", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@page {}", "", "", ""], expected = "  rules 1\n    CSSPageRule type=6 internal=6 text=@page { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@page :first {}", "", "", ""], expected = "  rules 1\n    CSSPageRule type=6 internal=6 text=@page :first { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@page foo:left, bar {}", "", "", ""], expected = "  rules 1\n    CSSPageRule type=6 internal=6 text=@page foo:left, bar { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@page { @top-left {} }", "", "", ""], expected = "  rules 1\n    CSSPageRule type=6 internal=6 text=@page { @top-left { } }\n      CSSMarginRule type=9 internal=9 text=@top-left { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@keyframes foo {}", "", "", ""], expected = "  rules 1\n    CSSKeyframesRule type=7 internal=7 text=@keyframes \"foo\" { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@keyframes \"bar\" {}", "", "", ""], expected = "  rules 1\n    CSSKeyframesRule type=7 internal=7 text=@keyframes \"bar\" { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@function --foo() {}", "", "", ""], expected = "  rules 1\n    CSSFunctionRule type=0 internal=104 text=@function --foo() { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@function --foo(--a, --b) {}", "", "", ""], expected = "  rules 1\n    CSSFunctionRule type=0 internal=104 text=@function --foo(--a, --b) { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@function --foo() { @layer x {} }", "", "", ""], expected = "  rules 1\n    CSSFunctionRule type=0 internal=104 text=@function --foo() { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a {} @layer x; b { c {} }", "", "", ""], expected = "  rules 3\n    CSSStyleRule type=1 internal=1 text=a { }\n    CSSLayerStatementRule type=0 internal=101 text=@layer x;\n    CSSStyleRule type=1 internal=1 text=b {\n  & c { }\n}\n      CSSStyleRule type=1 internal=1 text=& c { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["@unknown { a {} } b {}", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=b { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = ["a { @layer x { b {} } }", "", "", ""], expected = "  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  @layer x {\n  & b { }\n}\n}\n      CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  & b { }\n}\n        CSSStyleRule type=1 internal=1 text=& b { }\n"),
    TestCssSheetsCase(mode = "sheet", arguments = [":is(a, b) {} ::before {} a:hover {}", "", "", ""], expected = "  rules 3\n    CSSStyleRule type=1 internal=1 text=:is(a, b) { }\n    CSSStyleRule type=1 internal=1 text=::before { }\n    CSSStyleRule type=1 internal=1 text=a:hover { }\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["a, b {}", "", "", ""], expected = "  dump:   CSSStyleRule:\n  dump:     CSS::Selector:\n  dump:       {None} TagName:NamespaceType=Default, Namespace='', Name='a'\n  dump:     CSS::Selector:\n  dump:       {None} TagName:NamespaceType=Default, Namespace='', Name='b'\n  dump:     Declarations (0):\n  dump:     Child rules (0):\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["a { b {} }", "", "", ""], expected = "  dump:   CSSStyleRule:\n  dump:     CSS::Selector:\n  dump:       {None} TagName:NamespaceType=Default, Namespace='', Name='a'\n  dump:     Declarations (0):\n  dump:     Child rules (1):\n  dump:       CSSStyleRule:\n  dump:         CSS::Selector:\n  dump:           {None} Nesting:\n  dump:           {Descendant} TagName:NamespaceType=Default, Namespace='', Name='b'\n  dump:         Declarations (0):\n  dump:         Child rules (0):\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["@layer x, y;", "", "", ""], expected = "  dump:   CSSLayerStatementRule:\n  dump:     Names: x, y\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["@layer x { a {} }", "", "", ""], expected = "  dump:   CSSLayerBlockRule:\n  dump:     Name: `x` (internal `x`)\n  dump:     Rules (1):\n  dump:       CSSStyleRule:\n  dump:         CSS::Selector:\n  dump:           {None} TagName:NamespaceType=Default, Namespace='', Name='a'\n  dump:         Declarations (0):\n  dump:         Child rules (0):\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["@namespace svg url(http://www.w3.org/2000/svg);", "", "", ""], expected = "  dump:   CSSNamespaceRule:\n  dump:     Namespace: http://www.w3.org/2000/svg\n  dump:     Prefix: svg\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["@page :first {}", "", "", ""], expected = "  dump:   CSSPageRule:\n  dump:     Selector: :first\n  dump:     Declarations (0):\n  dump:     Rules (0):\n"),
    TestCssSheetsCase(mode = "dump", arguments = ["@keyframes foo {}", "", "", ""], expected = "  dump:   CSSKeyframesRule:\n  dump:     Name: foo\n  dump:     Keyframes (0):\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["a {}", "b {}", "2", ""], expected = "  exception IndexSizeError: CSS rule index out of bounds.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["a {}", "@namespace x url(y);", "0", ""], expected = "  exception InvalidStateError: Cannot insert @namespace rule into a stylesheet with non-namespace/import rules\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["a {}", "@namespace x url(y);", "1", ""], expected = "  exception HierarchyRequestError: Cannot insert rule at specified index.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["@namespace x url(y);", "a {}", "0", ""], expected = "  exception HierarchyRequestError: Cannot insert rule at specified index.\n  rules 1\n    CSSNamespaceRule type=10 internal=10 text=@namespace x url(\"y\");\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["a {}", "b {} c {}", "0", ""], expected = "  exception SyntaxError: Unable to parse CSS rule.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "insert", arguments = ["a {}", "q|a {}", "1", ""], expected = "  exception SyntaxError: Unable to parse CSS rule.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "addrule", arguments = ["a {}", "-", "-", "-"], expected = "  exception SyntaxError: Unable to parse CSS rule.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "addrule", arguments = ["a {}", "b", "-", "5"], expected = "  exception IndexSizeError: CSS rule index out of bounds.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a {}", "b {}", "0", ""], expected = "  inserted at 0\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  b { }\n}\n      CSSStyleRule type=1 internal=1 text=b { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a { c {} }", "b {}", "1", ""], expected = "  inserted at 1\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & c { }\n  b { }\n}\n      CSSStyleRule type=1 internal=1 text=& c { }\n      CSSStyleRule type=1 internal=1 text=b { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a { c {} }", "b {}", "2", ""], expected = "  exception IndexSizeError: CSS rule index out of bounds.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & c { }\n}\n      CSSStyleRule type=1 internal=1 text=& c { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a {}", "@namespace x url(y);", "0", ""], expected = "  exception HierarchyRequestError: Cannot insert rule at specified index.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a {}", "@layer x;", "0", ""], expected = "  inserted at 0\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  @layer x;\n}\n      CSSLayerStatementRule type=0 internal=101 text=@layer x;\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["@layer x { a {} }", "b {}", "0", ""], expected = "  inserted at 0\n  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  b { }\n  a { }\n}\n      CSSStyleRule type=1 internal=1 text=b { }\n      CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["@layer x { a {} }", "@layer y { c {} }", "1", ""], expected = "  inserted at 1\n  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  a { }\n  @layer y {\n  c { }\n}\n}\n      CSSStyleRule type=1 internal=1 text=a { }\n      CSSLayerBlockRule type=0 internal=100 text=@layer y {\n  c { }\n}\n        CSSStyleRule type=1 internal=1 text=c { }\n"),
    TestCssSheetsCase(mode = "ginsert", arguments = ["a {}", "bogus", "0", ""], expected = "  exception SyntaxError: Unable to parse CSS declarations block.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "gdelete", arguments = ["a { b {} c {} }", "0", "", ""], expected = "  deleted\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & c { }\n}\n      CSSStyleRule type=1 internal=1 text=& c { }\n"),
    TestCssSheetsCase(mode = "gdelete", arguments = ["a { b {} c {} }", "2", "", ""], expected = "  exception IndexSizeError: CSS rule index out of bounds.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a {\n  & b { }\n  & c { }\n}\n      CSSStyleRule type=1 internal=1 text=& b { }\n      CSSStyleRule type=1 internal=1 text=& c { }\n"),
    TestCssSheetsCase(mode = "gdelete", arguments = ["@layer x { a {} }", "0", "", ""], expected = "  deleted\n  rules 1\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n}\n"),
    TestCssSheetsCase(mode = "selector", arguments = ["a {}", "!!!", "", ""], expected = "  selectorText a\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "selector", arguments = ["a {}", "", "", ""], expected = "  selectorText a\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
