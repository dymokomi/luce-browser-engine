    TestCssSheetsCase(mode = "layers", arguments = ["a {}", "", "", ""], expected = "  style 'a' layer=''\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "b {}", "0", ""], expected = "  inserted at 0\n  rules 2\n    CSSStyleRule type=1 internal=1 text=b { }\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "b {}", "1", ""], expected = "  inserted at 1\n  rules 2\n    CSSStyleRule type=1 internal=1 text=a { }\n    CSSStyleRule type=1 internal=1 text=b { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "b {}", "2", ""], expected = "  exception IndexSizeError: CSS rule index out of bounds.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "bogus {", "0", ""], expected = "  inserted at 0\n  rules 2\n    CSSStyleRule type=1 internal=1 text=bogus { }\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "bogus", "0", ""], expected = "  exception SyntaxError: Unable to parse CSS rule.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "@layer x;", "0", ""], expected = "  inserted at 0\n  rules 2\n    CSSLayerStatementRule type=0 internal=101 text=@layer x;\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "b {} c {}", "0", ""], expected = "  exception SyntaxError: Unable to parse CSS rule.\n  rules 1\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["a {}", "@layer x { y {} }", "1", ""], expected = "  inserted at 1\n  rules 2\n    CSSStyleRule type=1 internal=1 text=a { }\n    CSSLayerBlockRule type=0 internal=100 text=@layer x {\n  y { }\n}\n      CSSStyleRule type=1 internal=1 text=y { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["@layer a; a {}", "@layer b;", "1", ""], expected = "  inserted at 1\n  rules 3\n    CSSLayerStatementRule type=0 internal=101 text=@layer a;\n    CSSLayerStatementRule type=0 internal=101 text=@layer b;\n    CSSStyleRule type=1 internal=1 text=a { }\n"),
    TestCssSheetsCase(mode = "listinsert", arguments = ["@layer a; a {}", "@layer b;", "2", ""], expected = "  inserted at 2\n  rules 3\n    CSSLayerStatementRule type=0 internal=101 text=@layer a;\n    CSSStyleRule type=1 internal=1 text=a { }\n    CSSLayerStatementRule type=0 internal=101 text=@layer b;\n"),
