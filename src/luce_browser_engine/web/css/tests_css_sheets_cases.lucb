    TestCssSheetsCase(mode = "pageselector", arguments = ["@page :left {}", "foo:right, bar", "", ""], expected = "  selectorText foo:right, bar\n  rules 1\n    CSSPageRule type=6 internal=6 text=@page foo:right, bar { }\n"),
    TestCssSheetsCase(mode = "pageselector", arguments = ["@page :left {}", "!!", "", ""], expected = "  selectorText :left\n  rules 1\n    CSSPageRule type=6 internal=6 text=@page :left { }\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["@namespace url(http://example.com/default);", "", "", ""], expected = "  namespace_uri 'http://example.com/default'\n  default 'http://example.com/default'\n  declared '' \n  imports 0\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["@namespace svg url(http://www.w3.org/2000/svg);", "svg", "", ""], expected = "  namespace_uri 'http://www.w3.org/2000/svg'\n  default none\n  declared 'svg' \n  imports 0\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["@namespace svg url(http://www.w3.org/2000/svg);", "html", "", ""], expected = "  namespace_uri none\n  default none\n  declared 'svg' \n  imports 0\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["@namespace svg url(x); @namespace url(y); @namespace svg url(z);", "svg", "", ""], expected = "  namespace_uri 'z'\n  default 'y'\n  declared '' 'svg' \n  imports 0\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["a {} @namespace svg url(x);", "svg", "", ""], expected = "  namespace_uri none\n  default none\n  declared \n  imports 0\n"),
    TestCssSheetsCase(mode = "namespace", arguments = ["@layer a; @namespace svg url(x);", "svg", "", ""], expected = "  namespace_uri none\n  default none\n  declared \n  imports 0\n"),
    TestCssSheetsCase(mode = "layers", arguments = ["@layer x { a {} }", "", "", ""], expected = "  block name='x' qualified='x'\n  style 'a' layer='x'\n"),
    TestCssSheetsCase(mode = "layers", arguments = ["@layer { a {} } @layer { b {} }", "", "", ""], expected = "  block name='' qualified='#3'\n  style 'a' layer='#3'\n  block name='' qualified='#4'\n  style 'b' layer='#4'\n"),
    TestCssSheetsCase(mode = "layers", arguments = ["@layer x { @layer y { a {} } }", "", "", ""], expected = "  block name='x' qualified='x'\n  block name='y' qualified='x.y'\n  style 'a' layer='x.y'\n"),
    TestCssSheetsCase(mode = "layers", arguments = ["@layer x { @layer y, z; }", "", "", ""], expected = "  block name='x' qualified='x'\n  statement 'x.y,x.z'\n"),
