# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:22 Web::CSS::MediaList::create.
pub func css_media_list_create(realm: Realm*, media: ak.Vector[CssMediaQuery*]) -> CssMediaList*:
    return realm_create_css_media_list(realm, realm, media)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:27 Web::CSS::MediaList::MediaList.
pub func css_media_list_construct(this: CssMediaList*, realm: Realm*, media: ak.Vector[CssMediaQuery*]):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_media = media
    this.platform_object.m_legacy_platform_object_flags = BindPlatformObjectLegacyPlatformObjectFlags(supports_indexed_properties = 1)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:34 Web::CSS::MediaList::initialize (override).
pub func css_media_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.media_list)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:40 Web::CSS::MediaList::visit_edges (override).
pub func css_media_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssMediaList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_associated_style_sheet)

# mark: The MediaList interface =================================================================

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:47 Web::CSS::MediaList::media_text.
# https://www.w3.org/TR/cssom-1/#dom-medialist-mediatext
pub func css_media_list_media_text(this: CssMediaList*) -> ak.String:
    return css_serialize_a_media_query_list(this.m_media)

## The previous effects of the associated style sheet, if there is one (the C++ initializer of
## `previous_sheet_effects` in set_media_text, append_medium and delete_medium).
func css_media_list_previous_sheet_effects(this: CssMediaList*) -> CssShadowRootStylesheetEffects?:
    if let sheet = this.m_associated_style_sheet:
        return css_determine_shadow_root_stylesheet_effects_css_css_style_sheet(as_css_css_style_sheet(sheet))
    return none

## Invalidate the owners of the associated style sheet, if there is one, for `reason`.
func css_media_list_invalidate_associated_style_sheet(this: CssMediaList*, reason: DomStyleInvalidationReason, previous_sheet_effects: CssShadowRootStylesheetEffects?):
    let sheet = this.m_associated_style_sheet else return
    if let effects = previous_sheet_effects:
        css_css_style_sheet_invalidate_owners(as_css_css_style_sheet(sheet), reason, &effects)
    else:
        css_css_style_sheet_invalidate_owners(as_css_css_style_sheet(sheet), reason, none)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:53 Web::CSS::MediaList::set_media_text.
# https://www.w3.org/TR/cssom-1/#dom-medialist-mediatext
pub func css_media_list_set_media_text(this: CssMediaList*, text: ak.StringView):
    let previous_sheet_effects = css_media_list_previous_sheet_effects(this)

    # ScopeGuard guard = [&] { ... invalidate_owners(MediaListSetMediaText, ...) };
    defer css_media_list_invalidate_associated_style_sheet(this, DomStyleInvalidationReason.media_list_set_media_text, previous_sheet_effects)

    ak.vector_clear(&this.m_media)
    if ak.string_view_is_empty(&text):
        return
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_realm_css_parsing_mode(&parsing_params, bind_platform_object_realm(this.bind_platform_object()))
    this.m_media = parse_media_query_list(parsing_params, text)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:71 Web::CSS::MediaList::item.
# https://www.w3.org/TR/cssom-1/#dom-medialist-item
pub func css_media_list_item(this: CssMediaList*, index: u32) -> ak.String?:
    if (usize)index >= ak.vector_size(&this.m_media):
        return none

    return css_media_query_to_string(*ak.vector_at(&this.m_media, (usize)index))

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:80 Web::CSS::MediaList::append_medium.
# https://www.w3.org/TR/cssom-1/#dom-medialist-appendmedium
pub func css_media_list_append_medium(this: CssMediaList*, medium: ak.StringView):
    # 1. Let m be the result of parsing the given value.
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_realm_css_parsing_mode(&parsing_params, bind_platform_object_realm(this.bind_platform_object()))

    # 2. If m is null, then return.
    let m = parse_media_query(parsing_params, medium) else return

    # 3. If comparing m with any of the media queries in the collection of media queries returns true, then return.
    let serialized = css_media_query_to_string(m)
    for existing_medium in ak.vector_span(&this.m_media):
        let existing_serialized = css_media_query_to_string(existing_medium)
        if ak.string_equals(&existing_serialized, &serialized):
            return

    let previous_sheet_effects = css_media_list_previous_sheet_effects(this)

    # 4. Append m to the collection of media queries.
    ak.vector_append_t(&this.m_media, m)

    css_media_list_invalidate_associated_style_sheet(this, DomStyleInvalidationReason.media_list_append_medium, previous_sheet_effects)

## The predicate of delete_medium's remove_all_matching: `m->to_string() == existing->to_string()`.
func css_media_list_delete_medium_matches(context: void*?, existing: const (CssMediaQuery*)*) -> bool:
    let m = (CssMediaQuery*)(context else trap("no media query"))
    let serialized = css_media_query_to_string(m)
    let existing_serialized = css_media_query_to_string(*existing)
    return ak.string_equals(&serialized, &existing_serialized)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:107 Web::CSS::MediaList::delete_medium.
# https://www.w3.org/TR/cssom-1/#dom-medialist-deletemedium
pub func css_media_list_delete_medium(this: CssMediaList*, medium: ak.StringView) -> !:
    # 1. Let m be the result of parsing the given value.
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_realm_css_parsing_mode(&parsing_params, bind_platform_object_realm(this.bind_platform_object()))

    # 2. If m is null, then return.
    let m = parse_media_query(parsing_params, medium) else return

    let previous_sheet_effects = css_media_list_previous_sheet_effects(this)

    # 3. Remove any media query from the collection of media queries for which comparing the media query with m
    #    returns true. If nothing was removed, then throw a NotFoundError exception.
    let was_removed = ak.vector_remove_all_matching(&this.m_media, ak.Function1[const (CssMediaQuery*)*, bool](call = css_media_list_delete_medium_matches, context = m))
    if not was_removed:
        try idl_throw(.idl_dom_exception(idl_not_found_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Media query not found in list"))))

    css_media_list_invalidate_associated_style_sheet(this, DomStyleInvalidationReason.media_list_delete_medium, previous_sheet_effects)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:135 Web::CSS::MediaList::evaluate.
pub func css_media_list_evaluate(this: CssMediaList*, document: DomDocument*) -> bool:
    for media in ak.vector_span(&this.m_media):
        discard(css_media_query_evaluate(media, document))

    return css_media_list_matches(this)

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:139 Web::CSS::MediaList::matches.
pub func css_media_list_matches(this: CssMediaList*) -> bool:
    if ak.vector_is_empty(&this.m_media):
        return true

    for media in ak.vector_span(&this.m_media):
        if css_media_query_matches(media):
            return true
    return false

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:155 Web::CSS::MediaList::item_value (override).
pub func css_media_list_item_value_impl(base: BindPlatformObject*, index: usize) -> JsValue?:
    let this = (CssMediaList*)base
    if index >= ak.vector_size(&this.m_media):
        return none
    return js_primitive_string_create_string(js_cell_vm(this.js_cell()), css_media_query_to_string(*ak.vector_at(&this.m_media, index)))

## Ported from Libraries/LibWeb/CSS/MediaList.cpp:162 Web::CSS::MediaList::dump.
pub func css_media_list_dump(this: CssMediaList*, builder: ak.StringBuilder*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    dump_appendff(builder, "Media list ({}):\n", [ak.arg_u64((u64)ak.vector_size(&this.m_media))])
    for media in ak.vector_span(&this.m_media):
        css_media_query_dump(media, builder, indent_levels + 1)

# mark: MediaList.h =============================================================================

## Ported from Libraries/LibWeb/CSS/MediaList.h:28 Web::CSS::MediaList::length.
pub func css_media_list_length(this: CssMediaList*) -> usize:
    return ak.vector_size(&this.m_media)

## Ported from Libraries/LibWeb/CSS/MediaList.h:38 Web::CSS::MediaList::set_associated_style_sheet.
pub func css_media_list_set_associated_style_sheet(this: CssMediaList*, style_sheet: CssStyleSheet*):
    this.m_associated_style_sheet = style_sheet
