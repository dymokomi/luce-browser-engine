# mark: Color types and powerless components ====================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:522 Web::CSS::color_type_matches_rectangular_space.
func css_color_type_matches_rectangular_space(source_type: CssColorStyleValueColorType, space: css_data.RectangularColorSpace) -> bool:
    match space:
        .srgb: return source_type == CssColorStyleValueColorType.s_rgb or source_type == CssColorStyleValueColorType.rgb
        .srgb_linear: return source_type == CssColorStyleValueColorType.s_rgb_linear
        .display_p3: return source_type == CssColorStyleValueColorType.display_p3
        .display_p3_linear: return source_type == CssColorStyleValueColorType.display_p3_linear
        .a98_rgb: return source_type == CssColorStyleValueColorType.a98_rgb
        .prophoto_rgb: return source_type == CssColorStyleValueColorType.pro_photo_rgb
        .rec2020: return source_type == CssColorStyleValueColorType.rec2020
        .lab: return source_type == CssColorStyleValueColorType.lab
        .oklab: return source_type == CssColorStyleValueColorType.ok_lab
        .xyz, .xyz_d65: return source_type == CssColorStyleValueColorType.xyzd65
        .xyz_d50: return source_type == CssColorStyleValueColorType.xyzd50
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:552 Web::CSS::color_type_matches_polar_space.
func css_color_type_matches_polar_space(source_type: CssColorStyleValueColorType, space: css_data.PolarColorSpace) -> bool:
    match space:
        .hsl: return source_type == CssColorStyleValueColorType.hsl
        .hwb: return source_type == CssColorStyleValueColorType.hwb
        .lch: return source_type == CssColorStyleValueColorType.lch
        .oklch: return source_type == CssColorStyleValueColorType.oklch
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:568 Web::CSS::mark_powerless_for_zero_alpha.
# https://drafts.csswg.org/css-color-4/#powerless
func css_mark_powerless_for_zero_alpha(has_native_components: bool, alpha: f32, missing: CssMissingComponents*):
    if has_native_components:
        return
    if not missing.alpha and alpha == 0.0:
        *css_missing_components_component(missing, 0) = true
        *css_missing_components_component(missing, 1) = true
        *css_missing_components_component(missing, 2) = true

# NB: Achromatic colors converted through the sRGB -> XYZ-D65 ->  XYZ-D50 -> Lab -> LCH chain accumulate
#     floating-point error of ~0.016 in the chroma component due to the Bradford chromatic adaptation matrices.
#     This is the worst case for all color conversion types, so the threshold is large enough to account for this.
# (`achromatic_threshold` is css_achromatic_threshold in types_color_interpolation.)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:584 Web::CSS::mark_powerless_hue_after_conversion.
func css_mark_powerless_hue_after_conversion(components: gfx.ColorComponents, interp_missing: CssMissingComponents*, style_value: CssStyleValue*, polar_color_space: css_data.PolarColorSpace, target_categories: CssComponentCategories):
    if css_style_value_is_color(style_value):
        if let color_type = css_color_style_value_color_type(css_style_value_as_color(style_value)):
            if css_color_type_matches_polar_space(color_type, polar_color_space):
                return

    var has_zero_colorfulness = false
    for i: usize in 0..<3:
        if css_component_categories_component(&target_categories, i) == CssComponentCategory.colorfulness and (f32)math.abs((f64)gfx.color_components_at_const(&components, i)) < css_achromatic_threshold:
            has_zero_colorfulness = true
    if polar_color_space == css_data.PolarColorSpace.hwb and gfx.color_components_at_const(&components, 1) + gfx.color_components_at_const(&components, 2) >= 1.0 - css_achromatic_threshold:
        has_zero_colorfulness = true

    if has_zero_colorfulness:
        for i: usize in 0..<3:
            if css_component_categories_component(&target_categories, i) == CssComponentCategory.hue:
                *css_missing_components_component(interp_missing, i) = true

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:612 Web::CSS::substitute_missing_components.
func css_substitute_missing_components(from_components: gfx.ColorComponents*, to_components: gfx.ColorComponents*, from_missing: CssMissingComponents, to_missing: CssMissingComponents):
    for i: usize in 0..<3:
        if css_missing_components_component_const(&from_missing, i) and not css_missing_components_component_const(&to_missing, i):
            *gfx.color_components_at(from_components, i) = gfx.color_components_at_const(to_components, i)
        elif css_missing_components_component_const(&to_missing, i) and not css_missing_components_component_const(&from_missing, i):
            *gfx.color_components_at(to_components, i) = gfx.color_components_at_const(from_components, i)

    if from_missing.alpha and not to_missing.alpha:
        gfx.color_components_set_alpha(from_components, gfx.color_components_alpha(to_components))
    elif to_missing.alpha and not from_missing.alpha:
        gfx.color_components_set_alpha(to_components, gfx.color_components_alpha(from_components))
    elif from_missing.alpha and to_missing.alpha:
        gfx.color_components_set_alpha(from_components, 1.0)
        gfx.color_components_set_alpha(to_components, 1.0)

# mark: Preparing the two colors ================================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:642 Web::CSS::color_syntax_for_interpolation.
func css_color_syntax_for_interpolation(style_value: CssStyleValue*) -> CssColorSyntax:
    if css_style_value_is_keyword(style_value):
        return CssColorSyntax.legacy

    let color = css_style_value_as_color(style_value)
    let color_type = css_color_style_value_color_type(color) else return css_color_style_value_color_syntax(color)
    match color_type:
        .rgb, .hsl, .hwb:
            return CssColorSyntax.legacy
        _:
            return css_color_style_value_color_syntax(color)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:661 Web::CSS::source_categories_for_interpolation.
func css_source_categories_for_interpolation(style_value: CssStyleValue*) -> CssComponentCategories:
    if css_style_value_is_color(style_value):
        if let color_type = css_color_style_value_color_type(css_style_value_as_color(style_value)):
            return css_categories_for_color_type(color_type)
        return css_component_categories_new(CssComponentCategory.not_analogous, CssComponentCategory.not_analogous, CssComponentCategory.not_analogous)
    return css_component_categories_new(CssComponentCategory.red, CssComponentCategory.green, CssComponentCategory.blue)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:671 Web::CSS::resolve_interpolation_policy.
func css_resolve_interpolation_policy(from_: CssStyleValue*, to: CssStyleValue*, color_interpolation_method: display_list.ColorInterpolationMethod?) -> CssInterpolationPolicy:
    # https://drafts.csswg.org/css-color-4/#interpolation-space
    # If the host syntax does not define what color space interpolation should take place in, it defaults to Oklab.
    # However, user agents must handle interpolation between legacy sRGB color formats (hex colors, named colors,
    # rgb(), hsl() or hwb() and the equivalent alpha-including forms) in gamma-encoded sRGB space.
    var color_syntax = CssColorSyntax.legacy
    if css_color_syntax_for_interpolation(from_) == CssColorSyntax.modern or css_color_syntax_for_interpolation(to) == CssColorSyntax.modern:
        color_syntax = CssColorSyntax.modern

    # NB: When no explicit method is provided, derive from the color syntax.
    #     When an explicit method IS provided (e.g. color-mix), always use modern output format.
    return CssInterpolationPolicy(
        use_legacy_output = color_interpolation_method == none and color_syntax == CssColorSyntax.legacy,
        color_interpolation_method = color_interpolation_method else css_color_interpolation_method_style_value_default_color_interpolation_method(color_syntax),
    )

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:695 Web::CSS::initialize_interpolation_color.
func css_initialize_interpolation_color(style_value: CssStyleValue*, color_resolution_context: CssColorResolutionContext) -> CssPreparedInterpolationColor:
    return CssPreparedInterpolationColor(
        missing_components = css_extract_missing_components(style_value),
        source_categories = css_source_categories_for_interpolation(style_value),
        native_components = css_style_value_to_color_components(style_value, color_resolution_context.calculation_resolution_context),
        srgb_components = none,
    )

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:709 Web::CSS::resolve_interpolation_color_to_srgb.
func css_resolve_interpolation_color_to_srgb(style_value: CssStyleValue*, color: CssPreparedInterpolationColor*, color_resolution_context: CssColorResolutionContext) -> gfx.ColorComponents?:
    if color.srgb_components != none:
        return color.srgb_components

    if let native_components = color.native_components:
        color.srgb_components = css_native_components_to_srgb(native_components, css_color_style_value_color_type(css_style_value_as_color(style_value)) else trap("VERIFY: a color type"))
        return color.srgb_components

    let resolved = css_style_value_to_color(style_value, color_resolution_context) else return none

    color.srgb_components = gfx.color_to_srgb(resolved)
    return color.srgb_components

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:732 Web::CSS::resolve_interpolation_color_alpha.
func css_resolve_interpolation_color_alpha(style_value: CssStyleValue*, color: CssPreparedInterpolationColor*, color_resolution_context: CssColorResolutionContext) -> f32?:
    if let native_components = color.native_components:
        return gfx.color_components_alpha(&native_components)

    let srgb = css_resolve_interpolation_color_to_srgb(style_value, color, color_resolution_context) else return none
    return gfx.color_components_alpha(&srgb)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:746 Web::CSS::prepare_interpolation_color_for_conversion.
func css_prepare_interpolation_color_for_conversion(style_value: CssStyleValue*, color: CssPreparedInterpolationColor*, color_resolution_context: CssColorResolutionContext) -> bool:
    let alpha = css_resolve_interpolation_color_alpha(style_value, color, color_resolution_context) else return false

    # https://drafts.csswg.org/css-color-4/#powerless
    # NB: When a color has zero alpha, all color components are powerless and we mark them all as missing.
    #     However, if the alpha is itself `none`, it resolves to 0 but is not truly zero - it will be substituted
    #     with the other color's alpha during interpolation.
    css_mark_powerless_for_zero_alpha(color.native_components != none, alpha, &color.missing_components)
    return true

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:763 Web::CSS::convert_interpolation_color_to_rectangular_space.
func css_convert_interpolation_color_to_rectangular_space(style_value: CssStyleValue*, color: CssPreparedInterpolationColor*, space: css_data.RectangularColorSpace, color_resolution_context: CssColorResolutionContext) -> gfx.ColorComponents:
    if let native_components = color.native_components:
        if css_style_value_is_color(style_value) and css_color_type_matches_rectangular_space(css_color_style_value_color_type(css_style_value_as_color(style_value)) else trap("VERIFY: a color type"), space):
            return native_components

    let srgb = css_resolve_interpolation_color_to_srgb(style_value, color, color_resolution_context) else trap("VERIFY: an sRGB color")
    return css_srgb_to_rectangular_color_space(srgb, space)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:779 Web::CSS::convert_interpolation_color_to_polar_space.
func css_convert_interpolation_color_to_polar_space(style_value: CssStyleValue*, color: CssPreparedInterpolationColor*, space: css_data.PolarColorSpace, color_resolution_context: CssColorResolutionContext) -> gfx.ColorComponents:
    if let native_components = color.native_components:
        if css_style_value_is_color(style_value) and css_color_type_matches_polar_space(css_color_style_value_color_type(css_style_value_as_color(style_value)) else trap("VERIFY: a color type"), space):
            return native_components

    let srgb = css_resolve_interpolation_color_to_srgb(style_value, color, color_resolution_context) else trap("VERIFY: an sRGB color")
    return css_srgb_to_polar_color_space(srgb, space)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:795 Web::CSS::hue_index_for_color_space.
func css_hue_index_for_color_space(space: css_data.PolarColorSpace) -> usize:
    match space:
        .hsl, .hwb: return 0
        .lch, .oklch: return 2
        _: trap("VERIFY_NOT_REACHED")

# mark: The interpolation space =================================================================

## `InterpolationSpaceState state;`: the default member initializers.
func css_interpolation_space_state_new() -> CssInterpolationSpaceState:
    var categories: CssComponentCategories = ---
    css_component_categories_init_fields(&categories)
    return CssInterpolationSpaceState(
        from_components = gfx.color_components_new(0.0, 0.0, 0.0),
        to_components = gfx.color_components_new(0.0, 0.0, 0.0),
        from_missing = css_missing_components_new(),
        to_missing = css_missing_components_new(),
        hue_index = 0,
        hue_interpolation_method = css_data.HueInterpolationMethod.shorter,
        polar_color_space = css_data.PolarColorSpace.hsl,
        rectangular_color_space = css_data.RectangularColorSpace.srgb,
        is_polar = false,
        polar_target_categories = categories,
    )

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:808 Web::CSS::convert_to_interpolation_space.
func css_convert_to_interpolation_space(from_: CssStyleValue*, from_color: CssPreparedInterpolationColor*, to: CssStyleValue*, to_color: CssPreparedInterpolationColor*, color_interpolation_method: display_list.ColorInterpolationMethod, color_resolution_context: CssColorResolutionContext) -> CssInterpolationSpaceState:
    var state = css_interpolation_space_state_new()

    match color_interpolation_method:
        .rectangular_color_space(space):
            state.rectangular_color_space = space
            state.from_components = css_convert_interpolation_color_to_rectangular_space(from_, from_color, space, color_resolution_context)
            state.to_components = css_convert_interpolation_color_to_rectangular_space(to, to_color, space, color_resolution_context)

            let target_categories = css_categories_for_rectangular_space(space)
            state.from_missing = css_carry_forward_missing_components(from_color.missing_components, from_color.source_categories, target_categories)
            state.to_missing = css_carry_forward_missing_components(to_color.missing_components, to_color.source_categories, target_categories)
        .polar_color_interpolation_method(polar_color_interpolation_method):
            state.is_polar = true
            state.polar_color_space = polar_color_interpolation_method.color_space
            state.hue_interpolation_method = polar_color_interpolation_method.hue_interpolation_method
            state.hue_index = css_hue_index_for_color_space(polar_color_interpolation_method.color_space)
            state.from_components = css_convert_interpolation_color_to_polar_space(from_, from_color, polar_color_interpolation_method.color_space, color_resolution_context)
            state.to_components = css_convert_interpolation_color_to_polar_space(to, to_color, polar_color_interpolation_method.color_space, color_resolution_context)

            let target_categories = css_categories_for_polar_space(polar_color_interpolation_method.color_space)
            state.from_missing = css_carry_forward_missing_components(from_color.missing_components, from_color.source_categories, target_categories)
            state.to_missing = css_carry_forward_missing_components(to_color.missing_components, to_color.source_categories, target_categories)
            state.polar_target_categories = target_categories

    if state.is_polar:
        css_mark_powerless_hue_after_conversion(state.from_components, &state.from_missing, from_, state.polar_color_space, state.polar_target_categories)
        css_mark_powerless_hue_after_conversion(state.to_components, &state.to_missing, to, state.polar_color_space, state.polar_target_categories)

    return state

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:860 Web::CSS::reinsert_carried_forward_values.
func css_reinsert_carried_forward_values(state: CssInterpolationSpaceState*) -> bool:
    let both_alpha_missing = state.from_missing.alpha and state.to_missing.alpha
    css_substitute_missing_components(&state.from_components, &state.to_components, state.from_missing, state.to_missing)
    return both_alpha_missing

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:867 Web::CSS::fixup_hues_if_required.
func css_fixup_hues_if_required(state: CssInterpolationSpaceState*):
    if not state.is_polar:
        return
    css_fixup_hue(gfx.color_components_at(&state.from_components, state.hue_index), gfx.color_components_at(&state.to_components, state.hue_index), state.hue_interpolation_method)

# mark: Premultiplied interpolation =============================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:874 Web::CSS::premultiply_color_components.
func css_premultiply_color_components(components: gfx.ColorComponents, is_polar: bool, hue_index: usize) -> gfx.ColorComponents:
    var premultiplied = gfx.color_components_new(0.0, 0.0, 0.0)
    gfx.color_components_set_alpha(&premultiplied, gfx.color_components_alpha(&components))

    for i: usize in 0..<3:
        if is_polar and i == hue_index:
            *gfx.color_components_at(&premultiplied, i) = gfx.color_components_at_const(&components, i)
        else:
            *gfx.color_components_at(&premultiplied, i) = gfx.color_components_at_const(&components, i) * gfx.color_components_alpha(&components)

    return premultiplied

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:892 Web::CSS::interpolate_premultiplied_components.
func css_interpolate_premultiplied_components(from_: gfx.ColorComponents, to: gfx.ColorComponents, delta: f32) -> gfx.ColorComponents:
    var interpolated = gfx.color_components_new(0.0, 0.0, 0.0)
    for i: usize in 0..<3:
        *gfx.color_components_at(&interpolated, i) = css_interpolate_color_component(gfx.color_components_at_const(&from_, i), gfx.color_components_at_const(&to, i), delta)
    return interpolated

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:903 Web::CSS::unpremultiply_color_components.
func css_unpremultiply_color_components(premultiplied: gfx.ColorComponents, interpolated_alpha: f32, is_polar: bool, hue_index: usize) -> gfx.ColorComponents:
    var result = gfx.color_components_new(0.0, 0.0, 0.0)
    gfx.color_components_set_alpha(&result, interpolated_alpha)

    for i: usize in 0..<3:
        let was_premultiplied = not is_polar or i != hue_index
        *gfx.color_components_at(&result, i) = gfx.color_components_at_const(&premultiplied, i) / interpolated_alpha if was_premultiplied else gfx.color_components_at_const(&premultiplied, i)

    return result

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:920 Web::CSS::result_missing_components.
func css_result_missing_components(state: CssInterpolationSpaceState) -> CssMissingComponents:
    # https://drafts.csswg.org/css-color-4/#interpolation-missing
    # NB: If both input colors have a component as missing, the result also has that component as missing.
    return css_missing_components_new(
        css_missing_components_component_const(&state.from_missing, 0) and css_missing_components_component_const(&state.to_missing, 0),
        css_missing_components_component_const(&state.from_missing, 1) and css_missing_components_component_const(&state.to_missing, 1),
        css_missing_components_component_const(&state.from_missing, 2) and css_missing_components_component_const(&state.to_missing, 2),
        state.from_missing.alpha and state.to_missing.alpha,
    )

# mark: Interpolation ===========================================================================

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:932 Web::CSS::style_value_for_interpolated_color.
pub func css_style_value_for_interpolated_color(interpolated: CssInterpolatedColor) -> CssStyleValue*?:
    # https://drafts.csswg.org/css-color-4/#interpolation-space
    # NB: Legacy sRGB content interpolates in sRGB and produces a legacy rgb() result.
    if interpolated.policy.use_legacy_output:
        return css_color_style_value_create_from_color(gfx.srgb_to_color(interpolated.components), CssColorSyntax.legacy).css_style_value()

    # NB: Return as a StyleValue in the interpolation color space.
    if interpolated.state.is_polar:
        return css_style_value_from_polar_color_space(interpolated.components, interpolated.state.polar_color_space, interpolated.missing)
    return css_style_value_from_rectangular_color_space(interpolated.components, interpolated.state.rectangular_color_space, interpolated.missing)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:946 Web::CSS::perform_color_interpolation.
# https://drafts.csswg.org/css-color-4/#interpolation
pub func css_perform_color_interpolation(from_: CssStyleValue*, to: CssStyleValue*, delta: f32, color_interpolation_method: display_list.ColorInterpolationMethod?, color_resolution_context: CssColorResolutionContext) -> CssInterpolatedColor?:
    # 1. checking the two colors for analogous components and analogous sets which will be carried forward
    var from_color = css_initialize_interpolation_color(from_, color_resolution_context)
    var to_color = css_initialize_interpolation_color(to, color_resolution_context)

    # 2. prepare both colors for conversion. this changes any powerless components to missing values
    if not css_prepare_interpolation_color_for_conversion(from_, &from_color, color_resolution_context) or not css_prepare_interpolation_color_for_conversion(to, &to_color, color_resolution_context):
        return none

    # 3. converting them both to a given color space which will be referred to as the interpolation color space
    #    below.
    let interpolation_policy = css_resolve_interpolation_policy(from_, to, color_interpolation_method)
    var state = css_convert_to_interpolation_space(from_, &from_color, to, &to_color, interpolation_policy.color_interpolation_method, color_resolution_context)

    # 4. (if required) re-inserting carried forward values in the converted colors
    let both_alpha_missing = css_reinsert_carried_forward_values(&state)

    # 5. (if required) fixing up the hues, depending on the selected <hue-interpolation-method>
    css_fixup_hues_if_required(&state)

    let interpolated_alpha = css_interpolate_color_component(gfx.color_components_alpha(&state.from_components), gfx.color_components_alpha(&state.to_components), delta)
    let clamped_alpha = ak.clamp_f32(interpolated_alpha, 0.0, 1.0)
    if clamped_alpha == 0.0 and not both_alpha_missing:
        # OPTIMIZATION: Fully transparent results can skip the premultiply/interpolate/unpremultiply cycle.
        let zero_result = gfx.color_components_new(0.0, 0.0, 0.0, 0.0)
        return CssInterpolatedColor(components = zero_result, missing = css_missing_components_new(), policy = interpolation_policy, state = state)

    # 6. changing the color components to premultiplied form
    # https://drafts.csswg.org/css-color-4/#interpolation-alpha
    # For rectangular orthogonal color coordinate systems, all component values are multiplied by the alpha value.
    # For cylindrical polar color coordinate systems, the hue angle is NOT premultiplied.
    let from_premultiplied = css_premultiply_color_components(state.from_components, state.is_polar, state.hue_index)
    let to_premultiplied = css_premultiply_color_components(state.to_components, state.is_polar, state.hue_index)

    # 7. linearly interpolating each component of the computed value of the color separately
    let interpolated_components = css_interpolate_premultiplied_components(from_premultiplied, to_premultiplied, delta)

    # 8. undoing premultiplication
    let result = css_unpremultiply_color_components(interpolated_components, clamped_alpha, state.is_polar, state.hue_index)

    let missing = css_result_missing_components(state)
    return CssInterpolatedColor(components = result, missing = missing, policy = interpolation_policy, state = state)

## Ported from Libraries/LibWeb/CSS/ColorInterpolation.cpp:999 Web::CSS::interpolate_color.
# https://drafts.csswg.org/css-color-4/#interpolation
pub func css_interpolate_color(from_: CssStyleValue*, to: CssStyleValue*, delta: f32, color_interpolation_method: display_list.ColorInterpolationMethod?, color_resolution_context: CssColorResolutionContext) -> CssStyleValue*?:
    let interpolated = css_perform_color_interpolation(from_, to, delta, color_interpolation_method, color_resolution_context) else return none
    return css_style_value_for_interpolated_color(interpolated)
