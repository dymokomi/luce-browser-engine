## Ported from Libraries/LibWeb/CSS/PageSelector.cpp:11 Web::CSS::page_pseudo_class_from_string.
pub func css_page_pseudo_class_from_string(input: ak.StringView) -> CssPagePseudoClass?:
    if ak.string_view_equals_ignoring_ascii_case(&input, ak.sv("blank")):
        return CssPagePseudoClass.blank
    if ak.string_view_equals_ignoring_ascii_case(&input, ak.sv("first")):
        return CssPagePseudoClass.first
    if ak.string_view_equals_ignoring_ascii_case(&input, ak.sv("left")):
        return CssPagePseudoClass.left
    if ak.string_view_equals_ignoring_ascii_case(&input, ak.sv("right")):
        return CssPagePseudoClass.right
    return none

## Ported from Libraries/LibWeb/CSS/PageSelector.cpp:24 Web::CSS::to_string.
pub func css_to_string_css_page_pseudo_class(pseudo_class: CssPagePseudoClass) -> ak.StringView:
    match pseudo_class:
        .blank: return ak.sv("blank")
        .first: return ak.sv("first")
        .left: return ak.sv("left")
        .right: return ak.sv("right")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/PageSelector.cpp:39 Web::CSS::PageSelector::PageSelector.
pub func css_page_selector_construct(this: CssPageSelector*, name: ak.FlyString?, pseudo_classes: ak.Vector[CssPagePseudoClass]):
    this.m_name = name
    this.m_pseudo_classes = pseudo_classes

## Ported from Libraries/LibWeb/CSS/PageSelector.h:28 Web::CSS::PageSelector::name.
pub func css_page_selector_name(this: const CssPageSelector*) -> ak.FlyString?:
    return this.m_name

## Ported from Libraries/LibWeb/CSS/PageSelector.h:29 Web::CSS::PageSelector::pseudo_classes.
pub func css_page_selector_pseudo_classes(this: const CssPageSelector*) -> ak.Vector[CssPagePseudoClass]:
    return this.m_pseudo_classes

## Ported from Libraries/LibWeb/CSS/PageSelector.cpp:45 Web::CSS::PageSelector::serialize.
pub func css_page_selector_serialize(this: const CssPageSelector*) -> ak.String:
    var builder = ak.string_builder_new()
    if let name = this.m_name:
        ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&name))
    for pseudo_class in ak.vector_span_const(&this.m_pseudo_classes):
        # builder.appendff(":{}", to_string(pseudo_class))
        ak.string_builder_append_u8(&builder, ':')
        ak.string_builder_append_string_view(&builder, css_to_string_css_page_pseudo_class(pseudo_class))
    return ak.string_builder_to_string_without_validation(&builder)
