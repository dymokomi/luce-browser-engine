# mark: CSSGroupingRule.h =======================================================================

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.h:23 Web::CSS::CSSGroupingRule::css_rules (const).
pub func css_grouping_rule_css_rules_const(this: CssGroupingRule*) -> CssRuleList*:
    return this.m_rules

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.h:24 Web::CSS::CSSGroupingRule::css_rules.
pub func css_grouping_rule_css_rules(this: CssGroupingRule*) -> CssRuleList*:
    return this.m_rules

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.h:25 Web::CSS::CSSGroupingRule::css_rules_for_bindings.
pub func css_grouping_rule_css_rules_for_bindings(this: CssGroupingRule*) -> CssRuleList*?:
    return this.m_rules

# mark: CSSGroupingRule.cpp =====================================================================

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:16 Web::CSS::CSSGroupingRule::CSSGroupingRule.
pub func css_grouping_rule_construct(this: CssGroupingRule*, realm: Realm*, rules: CssRuleList*, type_: CssRuleType):
    css_rule_construct(this.css_rule(), realm, type_)
    this.m_rules = rules
    css_rule_list_set_owner_rule(this.m_rules, this.css_rule())
    for rule in ak.vector_span(&this.m_rules.m_rules):
        css_rule_set_parent_rule(rule, this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:25 Web::CSS::CSSGroupingRule::initialize (override).
pub func css_grouping_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_grouping_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:31 Web::CSS::CSSGroupingRule::visit_edges (override).
pub func css_grouping_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssGroupingRule*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_rules)

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:37 Web::CSS::CSSGroupingRule::clear_caches (override).
pub func css_grouping_rule_clear_caches_impl(base: CssRule*):
    let this = (CssGroupingRule*)base
    css_rule_clear_caches_impl(base)
    for rule in ak.vector_span(&this.m_rules.m_rules):
        css_rule_clear_caches(rule)

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:45 Web::CSS::CSSGroupingRule::insert_rule.
# https://drafts.csswg.org/cssom/#dom-cssgroupingrule-insertrule
pub func css_grouping_rule_insert_rule(this: CssGroupingRule*, rule: ak.StringView, index: u32 = 0) -> u32!:
    # The insertRule(rule, index) method must return the result of invoking insert a CSS rule rule into the child CSS
    # rules at index, with the nested flag set.
    let parent_style_sheet = this.css_rule_base.m_parent_style_sheet else trap("null m_parent_style_sheet")
    discard(try css_rule_list_insert_a_css_rule(this.m_rules, .string_view(rule), index, CssRuleListNested.yes, css_css_style_sheet_declared_namespaces(parent_style_sheet)))

    # AD-HOC: The spec doesn't say where to set the parent rule, so we'll do it here.
    let inserted = css_rule_list_item(this.m_rules, (usize)index) else trap("null rule")
    css_rule_set_parent_rule(inserted, this.css_rule())
    return index

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:57 Web::CSS::CSSGroupingRule::delete_rule.
pub func css_grouping_rule_delete_rule(this: CssGroupingRule*, index: u32) -> !:
    try css_rule_list_remove_a_css_rule(this.m_rules, index)

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:62 Web::CSS::CSSGroupingRule::for_each_effective_rule (virtual).
pub func css_grouping_rule_for_each_effective_rule_impl(this: CssGroupingRule*, order: TraversalOrder, callback: ak.Function1[CssRule*, unit]):
    css_rule_list_for_each_effective_rule(this.m_rules, order, callback)

## Ported from Libraries/LibWeb/CSS/CSSGroupingRule.cpp:67 Web::CSS::CSSGroupingRule::set_parent_style_sheet (override).
pub func css_grouping_rule_set_parent_style_sheet_impl(base: CssRule*, parent_style_sheet: CssCssStyleSheet*?):
    let this = (CssGroupingRule*)base
    css_rule_set_parent_style_sheet_impl(base, parent_style_sheet)
    for rule in ak.vector_span(&this.m_rules.m_rules):
        css_rule_set_parent_style_sheet(rule, parent_style_sheet)
