## Ported from Libraries/LibWeb/WebIDL/ObservableArray.cpp:14 Web::WebIDL::ObservableArray::create:
## realm.create<ObservableArray>(realm, realm.intrinsics().array_prototype()).
pub func idl_observable_array_create(realm: Realm*) -> IdlObservableArray*:
    trap("unported (P3): Web::WebIDL::ObservableArray::create (a JS::Array)")

## Ported from Libraries/LibWeb/WebIDL/ObservableArray.cpp:20 Web::WebIDL::ObservableArray::ObservableArray:
## JS::Array(realm, prototype), set_may_interfere_with_indexed_property_access().
pub func idl_observable_array_construct(this: IdlObservableArray*, realm: Realm*, prototype: JsObject*):
    trap("unported (P3): Web::WebIDL::ObservableArray::ObservableArray (a JS::Array)")

## Ported from Libraries/LibWeb/WebIDL/ObservableArray.cpp:26 Web::WebIDL::ObservableArray::visit_edges (override).
pub func idl_observable_array_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (IdlObservableArray*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_on_set_an_indexed_value)
    gc.cell_visitor_visit_t(visitor, this.m_on_delete_an_indexed_value)

## Ported from Libraries/LibWeb/WebIDL/ObservableArray.cpp:33 Web::WebIDL::ObservableArray::set_on_set_an_indexed_value_callback.
pub func idl_observable_array_set_on_set_an_indexed_value_callback(this: IdlObservableArray*, callback: ak.Function1[JsValue*, unit]):
    this.m_on_set_an_indexed_value = gc.create_function1[JsValue*, unit](gc.cell_heap(this.cell()), callback)

## Ported from Libraries/LibWeb/WebIDL/ObservableArray.cpp:38 Web::WebIDL::ObservableArray::set_on_delete_an_indexed_value_callback.
pub func idl_observable_array_set_on_delete_an_indexed_value_callback(this: IdlObservableArray*, callback: ak.Function1[JsValue, unit]):
    this.m_on_delete_an_indexed_value = gc.create_function1[JsValue, unit](gc.cell_heap(this.cell()), callback)

