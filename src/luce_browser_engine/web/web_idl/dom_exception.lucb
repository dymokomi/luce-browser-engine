# mark: Throw completion and formatter ==========================================================

## Ported from Libraries/LibWeb/WebIDL/DOMException.h:150 Web::throw_completion:
## `JS::throw_completion(JS::Value(exception))`, a JS completion (phase 3).
pub func throw_completion(exception: IdlDomException*) -> JsCompletion:
    trap("unported (P3): Web::throw_completion (a JS throw completion of the DOMException's wrapper)")

## Ported from Libraries/LibWeb/WebIDL/DOMException.h:161 AK::Formatter<WebIDL::DOMException>::format:
## "[{name}]: {message}".
pub func idl_dom_exception_to_string(exception: IdlDomException*) -> ak.String:
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "[")
    ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&exception.m_name))
    ak.string_builder_append(&builder, "]: ")
    ak.string_builder_append_utf16_view(&builder, ak.utf16_fly_string_view(&exception.m_message))
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")
