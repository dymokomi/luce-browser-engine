# mark: Integer conversions =====================================================================

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:451 Web::WebIDL::integer_part.
## https://webidl.spec.whatwg.org/#abstract-opdef-integerpart
pub func idl_integer_part(n: f64) -> f64:
    # 1. Let r be floor(abs(n)).
    let r = math.floor(math.abs(n))

    # 2. If n < 0, then return -1 × r.
    if n < 0.0:
        return -r

    # 3. Otherwise, return r.
    return r

## The integer types ConvertToInt is instantiated with (AbstractOperations.cpp:550-557, the
## WebIDL::Types.h aliases): convert_to_int<T> takes the type as this argument.
pub enum IdlIntegerType:
    byte  # WebIDL::Byte, i8
    octet  # WebIDL::Octet, u8
    short  # WebIDL::Short, i16
    unsigned_short  # WebIDL::UnsignedShort, u16
    long  # WebIDL::Long, i32
    unsigned_long  # WebIDL::UnsignedLong, u32
    long_long  # WebIDL::LongLong, i64
    unsigned_long_long  # WebIDL::UnsignedLongLong, u64

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:466 Web::WebIDL::convert_to_int:
## 3.2.4.9 ConvertToInt(V, bitLength, signedness), https://webidl.spec.whatwg.org/#abstract-opdef-converttoint.
## C++ instantiates the template per integer type; here the type is `type_` and the result is
## the integer as an f64 (exact: at most 2^64, an integral double), which the caller converts
## to its type as C++'s return statement does.
pub func idl_convert_to_int(vm: Vm*, value: JsValue, type_: IdlIntegerType, enforce_range: IdlEnforceRange = IdlEnforceRange.no, clamp: IdlClamp = IdlClamp.no) -> f64!:
    var upper_bound: f64 = 0.0
    var lower_bound: f64 = 0.0

    let is_signed = type_ == .byte or type_ == .short or type_ == .long or type_ == .long_long
    # NumericLimits<MakeUnsigned<T>>::max() + 1.0
    let two_pow_bitlength: f64 = match type_:
        .byte, .octet => 256.0
        .short, .unsigned_short => 65536.0
        .long, .unsigned_long => 4294967296.0
        .long_long, .unsigned_long_long => 18446744073709551616.0

    # 1. If bitLength is 64, then:
    if type_ == .long_long or type_ == .unsigned_long_long:
        # 1. Let upperBound be 2^(53) − 1
        upper_bound = js_max_array_like_index

        # 2. If signedness is "unsigned", then let lowerBound be 0.
        if not is_signed:
            lower_bound = 0.0
        # 3. Otherwise let lowerBound be −2^(53) + 1.
        else:
            lower_bound = -js_max_array_like_index

        # Note: this ensures long long types associated with [EnforceRange] or [Clamp] extended attributes are representable in ECMAScript’s Number type as unambiguous integers.
    else:
        # 2. Otherwise, if signedness is "unsigned", then:
        #     1. Let lowerBound be 0.
        #     2. Let upperBound be 2^(bitLength) − 1.
        # 3. Otherwise:
        #     1. Let lowerBound be -2^(bitLength − 1).
        #     2. Let upperBound be 2^(bitLength − 1) − 1.
        if is_signed:
            lower_bound = -(two_pow_bitlength / 2.0)
            upper_bound = two_pow_bitlength / 2.0 - 1.0
        else:
            lower_bound = 0.0
            upper_bound = two_pow_bitlength - 1.0

    # 4. Let x be ? ToNumber(V).
    var x = js_value_as_double(try js_value_to_number(vm, value))

    # 5. If x is −0, then set x to +0.
    if x == -0.0:
        x = 0.0

    # 6. If the conversion is to an IDL type associated with the [EnforceRange] extended attribute, then:
    if enforce_range == IdlEnforceRange.yes:
        # 1. If x is NaN, +∞, or −∞, then throw a TypeError.
        if math.is_nan(x) or math.is_infinite(x):
            return try vm_throw_completion(vm, IdlSimpleExceptionType.type_error, .string_view(ak.sv("Number must not be NaN or Infinity")))

        # 2. Set x to IntegerPart(x).
        x = idl_integer_part(x)

        # 3. If x < lowerBound or x > upperBound, then throw a TypeError.
        if x < lower_bound or x > upper_bound:
            var builder = ak.string_builder_new()
            ak.vformat_arguments(&builder, ak.sv("Number '{}' is outside of allowed range of {} to {}"), [ak.arg_f64(x), ak.arg_f64(lower_bound), ak.arg_f64(upper_bound)]) else trap("MUST: String::formatted")
            let message = ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")
            return try vm_throw_completion(vm, IdlSimpleExceptionType.type_error, .string(message))

        # 4. Return x.
        return x

    # 7. If x is not NaN and the conversion is to an IDL type associated with the [Clamp] extended attribute, then:
    if clamp == IdlClamp.yes and not math.is_nan(x):
        # 1. Set x to min(max(x, lowerBound), upperBound).
        x = idl_min(idl_max(x, lower_bound), upper_bound)

        # 2. Round x to the nearest integer, choosing the even integer if it lies halfway between two, and choosing +0 rather than −0.
        # 3. Return x.
        # AK::round_to<T>(x), to nearest even; x is within T's range (the 8- and 16-bit types
        # round as i32, which gives the same value).
        return match type_:
            .byte, .octet, .short, .unsigned_short, .long => (f64)ak.rounding_round_to_f64_i32(x)
            .unsigned_long => (f64)ak.rounding_round_to_f64_u32(x)
            .long_long => (f64)ak.rounding_round_to_f64_i64(x)
            .unsigned_long_long => (f64)ak.rounding_round_to_f64_u64(x)

    # 8. If x is NaN, +0, +∞, or −∞, then return +0.
    if math.is_nan(x) or x == 0.0 or math.is_infinite(x):
        return 0.0

    # 9. Set x to IntegerPart(x).
    x = idl_integer_part(x)

    # 10. Set x to x modulo 2^bitLength.
    x = js_modulo(x, two_pow_bitlength)

    # 11. If signedness is "signed" and x ≥ 2^(bitLength − 1), then return x − 2^(bitLength).
    if is_signed and x > two_pow_bitlength / 2.0 - 1.0:
        return x - two_pow_bitlength

    # 12. Otherwise, return x.
    return x

## AK::min(a, b) on doubles: `b < a ? b : a`.
func idl_min(a: f64, b: f64) -> f64:
    return b if b < a else a

## AK::max(a, b) on doubles: `a < b ? b : a`.
func idl_max(a: f64, b: f64) -> f64:
    return b if a < b else a

## JS::MAX_ARRAY_LIKE_INDEX (Libraries/LibJS/Runtime/Value.h:32): 2^53 - 1.
pub let js_max_array_like_index: f64 = 9007199254740991.0

## Ported from Libraries/LibJS/Runtime/AbstractOperations.h:306 JS::modulo (floating point):
## x modulo y, https://tc39.es/ecma262/#eqn-modulo
pub func js_modulo(x: f64, y: f64) -> f64:
    # The notation “x modulo y” (y must be finite and non-zero) computes a value k of the same sign as y (or zero) such that abs(k) < abs(y) and x - k = q × y for some integer q.
    assert(y != 0.0)
    assert(math.is_finite(y))
    let r = math.mod(x, y)
    return r + y if r < 0.0 else r

# mark: Caches and prototypes ===================================================================

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:561 Web::WebIDL::lists_contain_same_elements.
## AD-HOC: For same-object caching purposes, this can be used to compare a cached JS array of
## DOM::Elements with another list. Either list can be null, in which case they are considered
## the same only if they are both null.
pub func idl_lists_contain_same_elements(array: JsArray*?, elements: ak.Vector[DomElement*]?) -> bool:
    if array == none or elements == none:
        return array == none and elements == none

    # The cached array is a JS Array of the elements' wrappers (phase 3).
    trap("unported (P3): Web::WebIDL::lists_contain_same_elements of a JS::Array")

