# mark: Buffer sources ==========================================================================

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:29 Web::WebIDL::is_buffer_source_type:
## whether the value is a TypedArray, a DataView or an ArrayBuffer (JS objects, phase 3).
pub func idl_is_buffer_source_type(value: JsValue) -> bool:
    if not js_value_is_object(value):
        return false

    # is<JS::TypedArrayBase>(object) || is<JS::DataView>(object) || is<JS::ArrayBuffer>(object): phase 3.
    trap("unported (P3): Web::WebIDL::is_buffer_source_type of a JS object")

