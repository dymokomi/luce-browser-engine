# mark: Callbacks ===============================================================================

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:117 Web::WebIDL::clean_up_on_return.
## https://webidl.spec.whatwg.org/#call-user-object-operation-return
pub func idl_clean_up_on_return(stored_settings: HtmlEnvironmentSettingsObject*, relevant_settings: HtmlEnvironmentSettingsObject*, completion: JsCompletion*, operation_returns_promise: IdlOperationReturnsPromise) -> JsCompletion:
    # Return: at this point completion will be set to an ECMAScript completion value.

    # 1. Clean up after running a callback with stored settings.
    html_clean_up_after_running_callback(stored_settings)

    # 2. Clean up after running script with relevant settings.
    html_clean_up_after_running_script(relevant_settings)

    # 3. If completion is a normal completion, return completion.
    if js_completion_type(completion) == JsCompletionType.normal:
        return *completion

    # 4. If completion is an abrupt completion and the operation has a return type that is not a promise type, return completion.
    if js_completion_is_abrupt(completion) and operation_returns_promise == IdlOperationReturnsPromise.no:
        return *completion

    # 5. Let rejectedPromise be ! Call(%Promise.reject%, %Promise%, «completion.[[Value]]»).
    let rejected_promise = idl_create_rejected_promise(html_environment_settings_object_realm(relevant_settings), js_completion_value(completion))

    # 6. Return the result of converting rejectedPromise to the operation’s return type.
    # Note: The operation must return a promise, so no conversion is necessary
    discard(rejected_promise)
    trap("unported (P3): Web::WebIDL::clean_up_on_return of a promise operation (JS::Value of the promise)")

## Ported from Libraries/LibWeb/WebIDL/AbstractOperations.cpp:144 Web::WebIDL::call_user_object_operation.
## https://webidl.spec.whatwg.org/#call-a-user-objects-operation
## Region r19 ported the steps that call a callable object (a native function before phase 3);
## getting the operation from a callback interface object is phase 3.
pub func idl_call_user_object_operation(callback: IdlCallbackType*, operation_name: ak.Utf16FlyString, this_argument: JsValue?, args: const JsValue[]) -> JsCompletion:
    # 1. Let completion be an uninitialized variable.
    var completion: JsCompletion

    # 2. If thisArg was not given, let thisArg be undefined.
    var this_value = this_argument else js_undefined()

    # 3. Let O be the ECMAScript object corresponding to value.
    let object = callback.callback

    # 4. Let realm be O’s associated realm.
    let realm = js_object_shape_realm(object)

    # 5. Let relevant settings be realm’s settings object.
    let relevant_settings = html_principal_realm_settings_object(realm)

    # 6. Let stored settings be value’s callback context.
    let stored_settings = callback.callback_context

    # 7. Prepare to run script with relevant settings.
    html_prepare_to_run_script(relevant_settings)

    # 8. Prepare to run a callback with stored settings.
    html_prepare_to_run_callback(stored_settings)

    # 9. Let X be O.
    let actual_function_object = object

    # 10. If ! IsCallable(O) is false, then:
    if not js_object_is_function(object):
        # 1. Let getResult be Get(O, opName).
        # 2. If getResult is an abrupt completion, set completion to getResult and jump to the step labeled return.
        # 4. If ! IsCallable(X) is false, then set completion to a new Completion{[[Type]]: throw, [[Value]]: a newly created TypeError object, [[Target]]: empty}, and jump to the step labeled return.
        # 3. Set X to getResult.[[Value]].
        # 5. Set thisArg to O (overriding the provided value).
        # (Get(O, opName) on a callback interface object is a JS property access: phase 3.)
        discard(operation_name)
        trap("unported (P3): Web::WebIDL::call_user_object_operation on a callback interface object (Get(O, opName))")

    # FIXME: 11. Let esArgs be the result of converting args to an ECMAScript arguments list. If this throws an exception, set completion to the completion value representing the thrown exception and jump to the step labeled return.
    #        For simplicity, we currently make the caller do this. However, this means we can't throw exceptions at this point like the spec wants us to.

    # 12. Let callResult be Call(X, thisArg, esArgs).
    let vm = realm_vm(realm)
    let call_result = js_call(vm, (JsFunctionObject*)actual_function_object, this_value, args) catch:
        # 13. If callResult is an abrupt completion, set completion to callResult and jump to the step labeled return.
        completion = vm_take_throw_completion(vm)
        return idl_clean_up_on_return(stored_settings, relevant_settings, &completion, callback.operation_returns_promise)

    # 14. Set completion to the result of converting callResult.[[Value]] to an IDL value of the same type as the operation’s return type.
    # FIXME: This does no conversion.
    completion = js_completion_from_value(call_result)

    return idl_clean_up_on_return(stored_settings, relevant_settings, &completion, callback.operation_returns_promise)

