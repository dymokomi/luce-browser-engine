pub func idl_set_prototype_from_new_target[TPrototypeType](vm: Vm*, new_target: JsFunctionObject*, interface_name: ak.FlyString, object: JsObject*) -> !:
    # 3.2. Let prototype be ? Get(newTarget, "prototype"). ... 9. Set instance.[[Prototype]] to prototype.
    trap("unported (P3): Web::WebIDL::set_prototype_from_new_target (JS prototypes)")
