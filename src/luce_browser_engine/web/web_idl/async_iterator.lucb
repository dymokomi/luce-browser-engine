pub func idl_async_iterator_validate_this[TAsyncIteratorInterface](realm: Realm*, interface_name: ak.StringView, this_validation_promise_capability: JsPromiseCapability*? = none) -> void*?:
    trap("unported (P3): Web::WebIDL::AsyncIterator::validate_this (the JS this value)")

