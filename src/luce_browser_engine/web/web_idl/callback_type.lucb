## Ported from Libraries/LibWeb/WebIDL/CallbackType.cpp:16 Web::WebIDL::CallbackType::CallbackType.
pub func idl_callback_type_construct_html_environment_settings_obje(this: IdlCallbackType*, callback: JsObject*, callback_context: HtmlEnvironmentSettingsObject*, operation_returns_promise: IdlOperationReturnsPromise = IdlOperationReturnsPromise.no):
    this.callback = callback
    this.callback_context = callback_context
    this.operation_returns_promise = operation_returns_promise

## Ported from Libraries/LibWeb/WebIDL/CallbackType.cpp:23 Web::WebIDL::CallbackType::CallbackType.
pub func idl_callback_type_construct_realm(this: IdlCallbackType*, callback: JsObject*, callback_context: Realm*, operation_returns_promise: IdlOperationReturnsPromise = IdlOperationReturnsPromise.no):
    idl_callback_type_construct_html_environment_settings_obje(this, callback, html_principal_realm_settings_object(callback_context), operation_returns_promise)

## Ported from Libraries/LibWeb/WebIDL/CallbackType.cpp:28 Web::WebIDL::CallbackType::visit_edges (override).
pub func idl_callback_type_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (IdlCallbackType*)base
    gc.cell_visit_edges_impl(base, visitor)
    js_visit_object(visitor, this.callback)
    gc.cell_visitor_visit_t_2(visitor, this.callback_context)

## Ported from Libraries/LibWeb/WebIDL/CallbackType.cpp:37 Web::WebIDL::property_to_callback.
## Non-standard function to aid in converting a user-provided function into a WebIDL::Callback.
## This is essentially what the Bindings generator would do at compile time, but at runtime
## instead.
pub func idl_property_to_callback(vm: Vm*, value: JsValue, property_key: JsPropertyKey, operation_returns_promise: IdlOperationReturnsPromise) -> IdlCallbackType*?!:
    # auto property = TRY(value.get(vm, property_key)); undefined: null; not a function: a
    # TypeError; otherwise a CallbackType of the function in the incumbent realm.
    trap("unported (P3): Web::WebIDL::property_to_callback (JS property access)")
