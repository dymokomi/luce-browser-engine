## Ported from Libraries/LibWeb/DOMURL/DOMURL.cpp:450 Web::DOMURL::parse (ported whole, but for the blob
## URL entry of step 4, which needs FileAPI's blob URL store: phase 2).
# https://url.spec.whatwg.org/#concept-url-parser
pub func domurl_parse(input: ak.StringView, base_url: web_url.Url? = none, encoding: ak.StringView? = none) -> web_url.Url?:
    # FIXME: We should probably have an extended version of URL::URL for LibWeb instead of standalone functions like this.

    # 1. Let url be the result of running the basic URL parser on input with base and encoding.
    var base: web_url.Url = web_url.url_empty()
    var base_pointer: const web_url.Url*? = none
    if let base_value = base_url:
        base = base_value
        base_pointer = &base
    let url = web_url.parser_basic_parse(input, base_pointer, none, none, encoding)

    # 2. If url is failure, return failure.
    let parsed = url else return none

    # 3. If url’s scheme is not "blob", return url.
    let scheme = web_url.url_scheme(&parsed)
    if not ak.string_eq_string_view(&scheme, ak.sv("blob")):
        return parsed

    # 4. Set url’s blob URL entry to the result of resolving the blob URL url, if that did not return failure, and null otherwise.
    trap("unported (P2): FileAPI::resolve_a_blob_url")

