## Ported from Libraries/LibWeb/HTML/StructuredSerialize.cpp:1248 Web::HTML::structured_serialize_for_storage.
## (Added by region r28: every SessionHistoryEntry serializes null and undefined in its
## constructor.) Ported with StructuredSerializeInternal's steps for undefined and null
## (StructuredSerialize.cpp:256-287: a record of the one ValueTag byte, as TransferDataEncoder
## encodes the u8 enum); serializing any other value is phase 3.
pub func html_structured_serialize_for_storage(vm: Vm*, value: JsValue) -> ak.Vector[u8]!:
    # 1. Return ? StructuredSerializeInternal(value, true).
    # (Serializer::serialize, step 4: undefined and null are primitives.)
    var serialized = ak.Vector[u8]()
    if js_value_is_undefined(value):
        ak.vector_append_t(&serialized, 1)  # ValueTag::UndefinedPrimitive
    elif js_value_is_null(value):
        ak.vector_append_t(&serialized, 2)  # ValueTag::NullPrimitive
    else:
        trap("unported (P3): Web::HTML::structured_serialize_for_storage of a value other than undefined or null")
    return serialized

