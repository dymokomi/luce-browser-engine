## Ported from Libraries/LibWeb/HTML/CustomElements/CustomElementRegistry.cpp:487 Web::HTML::look_up_a_custom_element_registry.
## Pure DOM steps every element creation runs, so ported whole here.
pub func html_look_up_a_custom_element_registry(node: DomNode*) -> HtmlCustomElementRegistry*?:
    # To look up a custom element registry, given a Node object node:
    # 1. If node is an Element object, then return node's custom element registry.
    if let element = as_if_dom_element(node):
        return dom_element_custom_element_registry(element)

    # 2. If node is a ShadowRoot object, then return node's custom element registry.
    if let shadow_root = as_if_dom_shadow_root(node):
        return dom_shadow_root_custom_element_registry(shadow_root)

    # 3. If node is a Document object, then return node's custom element registry.
    if let document = as_if_dom_document(node):
        return dom_document_custom_element_registry(document)

    # 4. Return null.
    return none

