## SDL_PollEvent (SDL3): the next pending SDL event. Gamepads (SDL) are phase 4: SDL is never
## initialized in phase 1, so there is never an event to poll, as SDL_PollEvent answers then.
## (Added by region r28 for EventHandler::handle_sdl_input_events.)
pub func sdl_poll_event() -> SdlEvent?:
    return none

