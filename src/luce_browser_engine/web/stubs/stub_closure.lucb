## Ported from Libraries/LibWeb/HTML/ScrollOptions.h:20 Web::HTML::normalize_non_finite_values (an inline helper
## of a types-only header).
# https://drafts.csswg.org/cssom-view/#normalize-non-finite-values
pub func html_normalize_non_finite_values_f64(value: f64) -> f64:
    # When asked to normalize non-finite values for a value x, if x is one of the three special floating point
    # literal values (Infinity, -Infinity or NaN), then x must be changed to the value 0. [WEBIDL]
    if math.is_infinite(value) or math.is_nan(value):
        return 0.0

    return value

## Ported from Libraries/LibWeb/HTML/ScrollOptions.h:31 Web::HTML::normalize_non_finite_values.
# https://drafts.csswg.org/cssom-view/#normalize-non-finite-values
pub func html_normalize_non_finite_values_optional(value: f64?) -> f64:
    let present = value else return 0.0
    return html_normalize_non_finite_values_f64(present)

