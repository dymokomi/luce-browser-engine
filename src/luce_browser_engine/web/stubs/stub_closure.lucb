## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/MIME.cpp:71 Web::Fetch::Infrastructure::legacy_extract_an_encoding
## (outside the phase-1 closure; ported whole for region r21's encoding sniffing).
# https://fetch.spec.whatwg.org/#legacy-extract-an-encoding
pub func fetch_legacy_extract_an_encoding(mime_type: MimeType?, fallback_encoding: ak.StringView) -> ak.StringView:
    # 1. If mimeType is failure, then return fallbackEncoding.
    let actual_mime_type = mime_type else return fallback_encoding

    # 2. If mimeType["charset"] does not exist, then return fallbackEncoding.
    let charset = ak.ordered_hash_map_get_k_const(mime_type_parameters(&actual_mime_type), ak.string_from_str("charset")) else return fallback_encoding

    # 3. Let tentativeEncoding be the result of getting an encoding from mimeType["charset"].
    let tentative_encoding = text_codec.get_standardized_encoding(ak.string_bytes_as_string_view(charset))

    # 4. If tentativeEncoding is failure, then return fallbackEncoding.
    # 5. Return tentativeEncoding.
    return tentative_encoding else fallback_encoding

