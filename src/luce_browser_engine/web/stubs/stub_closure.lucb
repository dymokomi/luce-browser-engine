## `TRY(completion)` on a JS::Completion: its value, or the thrown value stored as the pending exception
## (DESIGN.md §2.10). (Region r19 gave JS::Completion its phase-1 form.)
pub func js_completion_release_value(completion: JsCompletion) -> JsValue!:
    if js_completion_is_error(&completion):
        vm_set_pending_exception(vm_the(), .js_completion(completion))
        error(js_exception, "")
    return js_completion_value(&completion)

