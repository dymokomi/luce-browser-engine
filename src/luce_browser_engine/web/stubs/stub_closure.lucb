## Ported from Libraries/LibJS/Runtime/Value.cpp:1264 JS::to_integer_or_infinity(double).
# 7.1.5 ToIntegerOrInfinity ( argument ), https://tc39.es/ecma262/#sec-tointegerorinfinity
pub func js_to_integer_or_infinity(number: f64) -> f64:
    # 1. Let number be ? ToNumber(argument).

    # 2. If number is NaN, +0𝔽, or -0𝔽, return 0.
    if math.is_nan(number) or number == 0.0:
        return 0.0

    # 3. If number is +∞𝔽, return +∞.
    if number == math.infinity:
        return math.infinity

    # 4. If number is -∞𝔽, return -∞.
    if number == -math.infinity:
        return -math.infinity

    # 5. Let integer be floor(abs(ℝ(number))).
    var integer = math.floor(math.abs(number))

    # 6. If number < -0𝔽, set integer to -integer.
    # NOTE: The zero check is required as 'integer' is a double here but an MV in the spec,
    #       which doesn't have negative zero.
    if number < 0.0 and integer != 0.0:
        integer = -integer

    # 7. Return integer.
    return integer

## Ported from Libraries/LibJS/Runtime/Date.cpp:577 JS::make_time.
# 21.4.1.27 MakeTime ( hour, min, sec, ms ), https://tc39.es/ecma262/#sec-maketime
pub func js_make_time(hour: f64, min: f64, sec: f64, ms: f64) -> f64:
    # 1. If hour is not finite or min is not finite or sec is not finite or ms is not finite, return NaN.
    if not math.is_finite(hour) or not math.is_finite(min) or not math.is_finite(sec) or not math.is_finite(ms):
        return math.nan

    # 2. Let h be 𝔽(! ToIntegerOrInfinity(hour)).
    let h = js_to_integer_or_infinity(hour)
    # 3. Let m be 𝔽(! ToIntegerOrInfinity(min)).
    let m = js_to_integer_or_infinity(min)
    # 4. Let s be 𝔽(! ToIntegerOrInfinity(sec)).
    let s = js_to_integer_or_infinity(sec)
    # 5. Let milli be 𝔽(! ToIntegerOrInfinity(ms)).
    let milli = js_to_integer_or_infinity(ms)
    # 6. Let t be ((h * msPerHour + m * msPerMinute) + s * msPerSecond) + milli, performing the arithmetic according to IEEE 754-2019 rules (that is, as if using the ECMAScript operators * and +).
    # NOTE: C++ arithmetic abides by IEEE 754 rules
    let t = ((h * 3600000.0 + m * 60000.0) + s * 1000.0) + milli
    # 7. Return t.
    return t

