## Ported from Libraries/LibWeb/HTML/AudioPlayState.h:23 Web::HTML::invert_mute_state.
## (Added by region r28 for Page::toggle_page_mute_state; the header is outside the phase-1 files.)
pub func html_invert_mute_state(mute_state: HtmlMuteState) -> HtmlMuteState:
    match mute_state:
        .muted:
            return HtmlMuteState.unmuted
        .unmuted:
            return HtmlMuteState.muted
        _:
            trap("VERIFY_NOT_REACHED")

