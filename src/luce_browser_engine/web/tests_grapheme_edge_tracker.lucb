#==============================================================================================
#
#   tests_grapheme_edge_tracker - line boundaries and the grapheme edge tracker
#
#   DESCRIPTION:
#       The donor has no unit test for GraphemeEdgeTracker; the expected values are what the
#       donor's find_line_start, find_line_end and GraphemeEdgeTracker give for the same inputs
#       (checked locally against the reference build's headers).
#
#==============================================================================================

test "GraphemeEdgeTracker: find_line_start and find_line_end":
    let string = ak.utf16_string_from_str("ab\ncde\n\nf")
    let view = ak.utf16_string_base_utf16_view(&string.utf16_string_base)
    let starts: usize[10] = [0, 0, 0, 3, 3, 3, 3, 7, 8, 8]
    let ends: usize[10] = [2, 2, 2, 6, 6, 6, 6, 7, 9, 9]
    for i: usize in 0..<10:
        assert(find_line_start(view, i) == starts[i])
        assert(find_line_end(view, i) == ends[i])

test "GraphemeEdgeTracker: update and resolve":
    # Graphemes of these widths and lengths in code units (a zero width one is skipped).
    let widths: f32[5] = [3.0, 0.0, 4.0, 5.0, 2.0]
    let lengths: usize[5] = [1, 2, 1, 2, 1]
    let targets: f32[9] = [0.0, 2.0, 3.0, 5.0, 6.0, 7.0, 9.0, 12.0, 20.0]
    let expected: usize[9] = [0, 1, 1, 2, 2, 2, 2, 4, 5]
    for t in 0..<9:
        var tracker: GraphemeEdgeTracker
        grapheme_edge_tracker_construct(&tracker, targets[t])
        for i in 0..<5:
            if grapheme_edge_tracker_update(&tracker, lengths[i], widths[i]) == ak.IterationDecision.break_:
                break
        assert(grapheme_edge_tracker_resolve(&tracker) == expected[t])
