#==============================================================================================
#
#   support - cell allocation for the generated creation helpers
#
#   DESCRIPTION:
#       The allocation seam every generated realm_create_<class> helper calls (DESIGN.md §2.3, §3.2):
#       allocate a zeroed cell of a class from the realm's heap under DeferGC and set its vtable and
#       class id; then run the virtual initialize(realm). Region r14 ports these with the heap.
#       Part of the skeleton generator's output (Ladybird 47c82b38d0).
#
#==============================================================================================

## A pending WebIDL exception (`WebIDL::ExceptionOr<T>` is `T!`): the exception itself is stored in
## the VM's pending-exception slot before failing (DESIGN.md §2.10).
pub let webidl_exception: ErrorCode = ErrorCode.package(1)

## A pending JS completion (`JS::ThrowCompletionOr<T>` is `T!`), stored in the same slot (§2.10).
pub let js_exception: ErrorCode = ErrorCode.package(2)

## Offsets of the stateful mixins (secondary bases) inside a cell class; a class that does not
## mix one in leaves it none (DESIGN.md §2.5).
pub struct MixinOffsets:
    pub let animatable: usize?
    pub let aria_mixin: usize?
    pub let autocomplete_element: usize?
    pub let client: usize?
    pub let form_associated_element: usize?
    pub let form_associated_text_control_element: usize?
    pub let generated_css_style_properties: usize?
    pub let global_event_handlers: usize?
    pub let global_privacy_control_mixin: usize?
    pub let html_hyperlink_element_utils: usize?
    pub let image_provider: usize?
    pub let input_events_target: usize?
    pub let navigator_beacon_partial: usize?
    pub let navigator_encrypted_media_extensions_partial: usize?
    pub let navigator_gamepad_partial: usize?
    pub let navigator_storage: usize?
    pub let popover_target_attributes: usize?
    pub let serializable: usize?
    pub let slot: usize?
    pub let slottable_mixin: usize?
    pub let style_element_base: usize?
    pub let subresource: usize?
    pub let svg_fit_to_view_box: usize?
    pub let svg_maskable: usize?
    pub let universal_global_scope_mixin: usize?
    pub let viewport_client: usize?
    pub let window_event_handlers: usize?
    pub let window_global_mixin: usize?
    pub let window_or_worker_global_scope_mixin: usize?

## as_if<Web::Animations::Animatable>: the mixin inside a cell, found through its class's MixinOffsets.
pub func as_if_animatable[P: gc.IsCell](p: P*) -> AnimationsAnimatable*?:
    let info = p.cell().vtable.class_info
    let mixins = (const MixinOffsets*)(info.mixins else return none)
    let offset = mixins.animatable else return none
    return (AnimationsAnimatable*)((u8*)p + offset)

