#==============================================================================================
#
#   event_names - Gamepad::EventNames: the names of the gamepad events
#
#   DESCRIPTION:
#       Port of LibWeb/Gamepad/EventNames.cpp (lines 1-17) with EventNames.h's
#       ENUMERATE_GAMEPAD_EVENTS. The namespace was outside the skeleton's phase-1 closure;
#       region r22 adds it for WindowEventHandlers' ongamepadconnected and ongamepaddisconnected.
#       gamepad_event_names_initialize_strings interns the names and web_initialize_strings runs
#       it at startup (DESIGN.md §2.6).
#
#       Copyright (c) 2025, Luke Wilde <luke@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Web::Gamepad::EventNames::gamepadconnected (Libraries/LibWeb/Gamepad/EventNames.h:18).
pub var gamepad_event_names_gamepadconnected: ak.FlyString

## Web::Gamepad::EventNames::gamepaddisconnected (Libraries/LibWeb/Gamepad/EventNames.h:18).
pub var gamepad_event_names_gamepaddisconnected: ak.FlyString

## Whether gamepad_event_names_initialize_strings has run.
var gamepad_event_names_strings_initialized: bool

## Ported from Libraries/LibWeb/Gamepad/EventNames.cpp:11 the definitions of
## Web::Gamepad::EventNames's FlyStrings (`FlyString name = #name##_fly_string;` for each
## ENUMERATE_GAMEPAD_EVENTS entry).
pub func gamepad_event_names_initialize_strings():
    if gamepad_event_names_strings_initialized:
        return
    gamepad_event_names_gamepadconnected = ak.fly_string_from_str("gamepadconnected")
    gamepad_event_names_gamepaddisconnected = ak.fly_string_from_str("gamepaddisconnected")
    gamepad_event_names_strings_initialized = true
