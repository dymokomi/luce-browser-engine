#
#==============================================================================================

# mark: Selectors ===============================================================================

## Ported from Libraries/LibWeb/Dump.cpp:429 Web::dump_selector.
pub func dump_selector_css_selector(selector: const CssSelector*):
    var builder = ak.string_builder_new()
    dump_selector_string_builder(&builder, selector)
    dump_dbgln(&builder)

## Ported from Libraries/LibWeb/Dump.cpp:436 Web::dump_qualified_name.
# The C++ writes "NamespaceType={Default|None|Any|Named}, Namespace='{}', Name='{}'" from the
# qualified name's namespace_type, namespace_ and name.name.
pub func dump_qualified_name(builder: ak.StringBuilder*, qualified_name: const CssSelectorSimpleSelectorQualifiedName*):
    trap("unported: Web::dump_qualified_name needs CSS::Selector::SimpleSelector::QualifiedName, opaque in the skeleton until region r38 fills it")

## Ported from Libraries/LibWeb/Dump.cpp:456 Web::dump_selector.
pub func dump_selector_string_builder(builder: ak.StringBuilder*, selector: const CssSelector*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    ak.string_builder_append(builder, "CSS::Selector:\n")

    # For each relative_selector of selector.compound_selectors(): the combinator ("{None}",
    # "{ImmediateChild}", "{Descendant}", "{AdjacentSibling}", "{GeneralSibling}", "{Column}"),
    # then each simple selector's type and value, its pseudo-class, pseudo-element or attribute
    # details, joined by ", ".
    let compound_selectors = css_selector_compound_selectors(selector)
    if not ak.vector_is_empty(&compound_selectors):
        trap("unported: Web::dump_selector needs CSS::Selector::CompoundSelector and SimpleSelector, opaque in the skeleton until region r38 fills them")

# mark: Rules and declarations ==================================================================

## Ported from Libraries/LibWeb/Dump.cpp:649 Web::dump_rule.
pub func dump_rule_css_rule(rule: CssRule*):
    var builder = ak.string_builder_new()
    dump_rule_string_builder(&builder, rule)
    dump_dbgln(&builder)

## Ported from Libraries/LibWeb/Dump.cpp:656 Web::dump_rule.
pub func dump_rule_string_builder(builder: ak.StringBuilder*, rule: CssRule*, indent_levels: i32 = 0):
    css_rule_dump(rule, builder, indent_levels)

## Ported from Libraries/LibWeb/Dump.cpp:661 Web::dump_style_properties.
pub func dump_style_properties(builder: ak.StringBuilder*, declaration: CssStyleProperties*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    dump_appendff(builder, "Declarations ({}):\n", [ak.arg_u64((u64)css_style_declaration_length(declaration.css_style_declaration()))])
    let properties = css_style_properties_properties(declaration)
    for property in ak.vector_span_const(&properties):
        dump_indent(builder, indent_levels)
        let name = css_data.string_from_property_id(property.property_id)
        let value = css_style_value_to_string(property.value, css_syntax.SerializationMode.normal)
        dump_appendff(builder, "  {}: '{}'", [dump_arg_fly_string(&name), dump_arg_string(&value)])
        if property.important == css_syntax.Important.yes:
            ak.string_builder_append(builder, " \u{1b}[31;1m!important\u{1b}[0m")
        ak.string_builder_append_u8(builder, '\n')
    let custom_properties = css_style_properties_custom_properties(declaration)
    for property in ak.ordered_hash_map_begin_const(&custom_properties):
        dump_indent(builder, indent_levels)
        let value = css_style_value_to_string(property.value.value, css_syntax.SerializationMode.normal)
        dump_appendff(builder, "  {}: '{}'", [dump_arg_fly_string(&property.key), dump_arg_string(&value)])
        if property.value.important == css_syntax.Important.yes:
            ak.string_builder_append(builder, " \u{1b}[31;1m!important\u{1b}[0m")
        ak.string_builder_append_u8(builder, '\n')

## Ported from Libraries/LibWeb/Dump.cpp:681 Web::dump_descriptors.
pub func dump_descriptors(builder: ak.StringBuilder*, descriptors: CssDescriptors*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    dump_appendff(builder, "Declarations ({}):\n", [ak.arg_u64((u64)css_style_declaration_length(descriptors.css_style_declaration()))])
    let all_descriptors = css_descriptors_descriptors(descriptors)
    for descriptor in ak.vector_span_const(&all_descriptors):
        dump_indent(builder, indent_levels)
        let name = css_descriptor_name_and_id_name(&descriptor.descriptor_name_and_id)
        let value = css_style_value_to_string(descriptor.value, css_syntax.SerializationMode.normal)
        dump_appendff(builder, "  {}: '{}'", [dump_arg_fly_string(&name), dump_arg_string(&value)])
        ak.string_builder_append_u8(builder, '\n')

# mark: Style sheets ============================================================================

## Ported from Libraries/LibWeb/Dump.cpp:692 Web::dump_sheet.
pub func dump_sheet_css_style_sheet(sheet: CssStyleSheet*):
    var builder = ak.string_builder_new()
    dump_sheet_string_builder(&builder, sheet)
    dump_dbgln(&builder)

## Ported from Libraries/LibWeb/Dump.cpp:699 Web::dump_sheet.
pub func dump_sheet_string_builder(builder: ak.StringBuilder*, sheet: CssStyleSheet*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    let css_stylesheet = as_css_css_style_sheet(sheet)
    let rules = css_css_style_sheet_rules(css_stylesheet)
    dump_appendff(builder, "CSSStyleSheet{{{}}}: {} rule(s)\n", [ak.arg_pointer(sheet), ak.arg_u64((u64)css_rule_list_length(rules))])

    # CSSRuleList's begin() and end() are m_rules's.
    for rule in ak.vector_span_const(&rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 1)

# mark: Paintable tree ==========================================================================

## Ported from Libraries/LibWeb/Dump.cpp:709 Web::dump_tree.
pub func dump_tree_paint_paintable(paintable: PaintPaintable*):
    var builder = ak.string_builder_new()
    dump_tree_string_builder_paint_paintable(&builder, paintable, true)
    dump_dbgln(&builder)

## Ported from Libraries/LibWeb/Dump.cpp:716 Web::dump_tree.
pub func dump_tree_string_builder_paint_paintable(builder: ak.StringBuilder*, paintable: PaintPaintable*, colorize: bool = false, indent: i32 = 0):
    # Dump all paintables attached to this layout node at every level.
    # This makes detached/disconnected paintables visible across the full subtree.
    var paintable_with_lines_color_on = ""
    var paintable_box_color_on = ""
    var text_paintable_color_on = ""
    var paintable_color_on = ""
    var color_off = ""

    if colorize:
        paintable_with_lines_color_on = "\u{1b}[34m"
        paintable_box_color_on = "\u{1b}[33m"
        text_paintable_color_on = "\u{1b}[35m"
        paintable_color_on = "\u{1b}[32m"
        color_off = "\u{1b}[0m"

    var dumped_any = false
    for node_paintable in ak.intrusive_list_begin(layout_node_paintables(paint_paintable_layout_node(paintable))):
        if dumped_any:
            ak.string_builder_append(builder, "\n")

        ak.string_builder_append_repeated_string_view(builder, ak.sv("  "), (usize)indent)

        if is_paint_paintable_with_lines(node_paintable):
            ak.string_builder_append(builder, paintable_with_lines_color_on)
        elif is_paint_paintable_box(node_paintable):
            ak.string_builder_append(builder, paintable_box_color_on)
        elif is_paint_text_paintable(node_paintable):
            ak.string_builder_append(builder, text_paintable_color_on)
        else:
            ak.string_builder_append(builder, paintable_color_on)

        let debug_description = layout_node_debug_description(paint_paintable_layout_node(node_paintable))
        dump_appendff(builder, "{}{} ({})", [ak.arg_string_view(dump_class_name(node_paintable.cell())), ak.arg_str(color_off), dump_arg_string(&debug_description)])

        if let paintable_box = as_if_paint_paintable_box(node_paintable):
            ak.string_builder_append(builder, " ")
            dump_append_css_pixel_rect(builder, paint_paintable_box_absolute_border_box_rect(paintable_box))

            if paint_paintable_box_has_scrollable_overflow(paintable_box):
                ak.string_builder_append(builder, " overflow: ")
                # Formatter<Optional<T>>: the value, or "None".
                if let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(paintable_box):
                    dump_append_css_pixel_rect(builder, scrollable_overflow_rect)
                else:
                    ak.string_builder_append(builder, "None")

            let scroll_offset = paint_paintable_box_scroll_offset(paintable_box)
            if not gfx.css_pixel_point_is_zero(&scroll_offset):
                ak.string_builder_append(builder, " scroll-offset: ")
                dump_append_css_pixel_point(builder, scroll_offset)
        ak.string_builder_append(builder, "\n")

        var child = tree_node_first_child(node_paintable)
        while let at = child:
            dump_tree_string_builder_paint_paintable(builder, at, colorize, indent + 1)
            child = tree_node_next_sibling(at)
        dumped_any = true
