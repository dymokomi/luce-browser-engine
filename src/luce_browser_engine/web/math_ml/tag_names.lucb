#==============================================================================================
#
#   tag_names - MathML::TagNames: the local names of the MathML elements
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/MathML/TagNames.cpp (lines 1-16) with TagNames.h's
#       ENUMERATE_MATHML_TAGS. C++ initializes the FlyStrings statically; here
#       math_ml_tag_names_initialize_strings interns them at run time and web_initialize_strings
#       runs it at startup (DESIGN.md §2.6). Ported with region r21 because the HTML parser
#       compares tag and attribute names against them; the owning region keeps the rest of its
#       file.
#
#==============================================================================================

## Whether math_ml_tag_names_initialize_strings has run.
var math_ml_tag_names_strings_initialized: bool

## Ported from Libraries/LibWeb/MathML/TagNames.cpp:11 the definitions of Web::MathML::TagNames's FlyStrings
## (`FlyString name = tag##_fly_string;` for each ENUMERATE_MATHML_TAGS entry).
pub func math_ml_tag_names_initialize_strings():
    if math_ml_tag_names_strings_initialized:
        return
    math_ml_tag_names_annotation = ak.fly_string_from_str("annotation")
    math_ml_tag_names_annotation_xml = ak.fly_string_from_str("annotation-xml")
    math_ml_tag_names_maction = ak.fly_string_from_str("maction")
    math_ml_tag_names_malignmark = ak.fly_string_from_str("malignmark")
    math_ml_tag_names_math = ak.fly_string_from_str("math")
    math_ml_tag_names_merror = ak.fly_string_from_str("merror")
    math_ml_tag_names_mfrac = ak.fly_string_from_str("mfrac")
    math_ml_tag_names_mglyph = ak.fly_string_from_str("mglyph")
    math_ml_tag_names_mi = ak.fly_string_from_str("mi")
    math_ml_tag_names_mmultiscripts = ak.fly_string_from_str("mmultiscripts")
    math_ml_tag_names_mn = ak.fly_string_from_str("mn")
    math_ml_tag_names_mo = ak.fly_string_from_str("mo")
    math_ml_tag_names_mover = ak.fly_string_from_str("mover")
    math_ml_tag_names_mpadded = ak.fly_string_from_str("mpadded")
    math_ml_tag_names_mphantom = ak.fly_string_from_str("mphantom")
    math_ml_tag_names_mprescripts = ak.fly_string_from_str("mprescripts")
    math_ml_tag_names_mroot = ak.fly_string_from_str("mroot")
    math_ml_tag_names_mrow = ak.fly_string_from_str("mrow")
    math_ml_tag_names_ms = ak.fly_string_from_str("ms")
    math_ml_tag_names_mspace = ak.fly_string_from_str("mspace")
    math_ml_tag_names_msqrt = ak.fly_string_from_str("msqrt")
    math_ml_tag_names_mstyle = ak.fly_string_from_str("mstyle")
    math_ml_tag_names_msub = ak.fly_string_from_str("msub")
    math_ml_tag_names_msubsup = ak.fly_string_from_str("msubsup")
    math_ml_tag_names_msup = ak.fly_string_from_str("msup")
    math_ml_tag_names_mtable = ak.fly_string_from_str("mtable")
    math_ml_tag_names_mtd = ak.fly_string_from_str("mtd")
    math_ml_tag_names_mtext = ak.fly_string_from_str("mtext")
    math_ml_tag_names_mtr = ak.fly_string_from_str("mtr")
    math_ml_tag_names_munder = ak.fly_string_from_str("munder")
    math_ml_tag_names_munderover = ak.fly_string_from_str("munderover")
    math_ml_tag_names_semantics = ak.fly_string_from_str("semantics")
    math_ml_tag_names_strings_initialized = true
