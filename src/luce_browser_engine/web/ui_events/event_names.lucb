#==============================================================================================
#
#   event_names - UIEvents::EventNames: the names of the UI events
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/UIEvents/EventNames.cpp (lines 1-17) with EventNames.h's
#       ENUMERATE_UI_EVENTS. The namespace was outside the skeleton's phase-1 closure; region r19
#       added it for EventTarget (activation-triggering input events, the Window-reflecting body
#       element event handlers). The C++ FlyStrings are initialized statically; here
#       ui_events_event_names_initialize_strings interns them and web_initialize_strings runs
#       it at startup (DESIGN.md §2.6).
#
#       Copyright (c) 2020, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Whether ui_events_event_names_initialize_strings has run.
var ui_events_event_names_initialized: bool

## Ported from Libraries/LibWeb/UIEvents/EventNames.cpp:11 the definitions of
## Web::UIEvents::EventNames's FlyStrings (`FlyString name = #name##_fly_string;` for each
## ENUMERATE_UI_EVENTS entry).
pub func ui_events_event_names_initialize_strings():
    if ui_events_event_names_initialized:
        return
    ui_events_event_names_auxclick = ak.fly_string_from_str("auxclick")
    ui_events_event_names_beforeinput = ak.fly_string_from_str("beforeinput")
    ui_events_event_names_click = ak.fly_string_from_str("click")
    ui_events_event_names_contextmenu = ak.fly_string_from_str("contextmenu")
    ui_events_event_names_dblclick = ak.fly_string_from_str("dblclick")
    ui_events_event_names_gotpointercapture = ak.fly_string_from_str("gotpointercapture")
    ui_events_event_names_input = ak.fly_string_from_str("input")
    ui_events_event_names_keydown = ak.fly_string_from_str("keydown")
    ui_events_event_names_keypress = ak.fly_string_from_str("keypress")
    ui_events_event_names_keyup = ak.fly_string_from_str("keyup")
    ui_events_event_names_lostpointercapture = ak.fly_string_from_str("lostpointercapture")
    ui_events_event_names_mousedown = ak.fly_string_from_str("mousedown")
    ui_events_event_names_mouseenter = ak.fly_string_from_str("mouseenter")
    ui_events_event_names_mouseleave = ak.fly_string_from_str("mouseleave")
    ui_events_event_names_mousemove = ak.fly_string_from_str("mousemove")
    ui_events_event_names_mouseout = ak.fly_string_from_str("mouseout")
    ui_events_event_names_mouseover = ak.fly_string_from_str("mouseover")
    ui_events_event_names_mouseup = ak.fly_string_from_str("mouseup")
    ui_events_event_names_pointercancel = ak.fly_string_from_str("pointercancel")
    ui_events_event_names_pointerdown = ak.fly_string_from_str("pointerdown")
    ui_events_event_names_pointerenter = ak.fly_string_from_str("pointerenter")
    ui_events_event_names_pointerleave = ak.fly_string_from_str("pointerleave")
    ui_events_event_names_pointermove = ak.fly_string_from_str("pointermove")
    ui_events_event_names_pointerout = ak.fly_string_from_str("pointerout")
    ui_events_event_names_pointerover = ak.fly_string_from_str("pointerover")
    ui_events_event_names_pointerrawupdate = ak.fly_string_from_str("pointerrawupdate")
    ui_events_event_names_pointerup = ak.fly_string_from_str("pointerup")
    ui_events_event_names_resize = ak.fly_string_from_str("resize")
    ui_events_event_names_wheel = ak.fly_string_from_str("wheel")
    ui_events_event_names_initialized = true

