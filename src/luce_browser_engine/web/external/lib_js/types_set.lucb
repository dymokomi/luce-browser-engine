# mark: JsSet ===================================================================================

## JS::Set (Libraries/LibJS/Runtime/Set.h:17). Unlike what the spec says, LibJS implements Sets
## over a Map.
pub struct JsSet: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::Object, JS::Cell)
    pub var m_realm: Realm*  # the realm of the object's shape (Object::shape().realm())
    pub var m_values: JsMap*?

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of JS::Set: Set::initialize makes its Map.
pub let js_set_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_set_class, class_name = js_set_class_name_impl, visit_edges = js_set_visit_edges_impl), initialize = js_set_initialize_impl)

## Class information of JS::Set (JS::Cell's class id).
pub let js_set_class: ak.ClassInfo = ak.ClassInfo(name = "Set", first_id = 1, last_id = 1, size = sizeof(JsSet), vtable = (const void*)&js_set_vtable)

## is<JS::Set> (Object::fast_is<Set>, is_set_object()): the cell's ClassInfo.
pub func is_js_set[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_set_class
