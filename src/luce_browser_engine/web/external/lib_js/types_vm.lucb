#   DESCRIPTION:
#       Structs, enums, vtables, class information and cast helpers generated from
#       Libraries/LibJS/Runtime/VM.h (Ladybird 47c82b38d0) by the skeleton generator
#       (DESIGN.md §4.4). Regenerate rather than edit, except to fill a field the generator
#       could not map.
#
#       Filled by hand in region r14 (DESIGN.md §2.10, §3.6): the VM owns the heap, the
#       surrounding agent, the execution context stack and the pending exception that every
#       `T!` failing with webidl_exception or js_exception leaves behind. Like JS::VM (reference
#       counted, outside the heap) it lives on the C heap; what it holds in the heap is reported
#       by its gather_roots. The JS engine's own state (the luce-js runtime) comes in phase 3.
#
#==============================================================================================

# mark: Vm ======================================================================================

## JS::VM (Libraries/LibJS/Runtime/VM.h:61).
pub struct Vm:
    pub var m_heap: gc.Heap
    pub var m_agent: HtmlAgent*?  # OwnPtr<Agent>; HTML::Agent is the only kind LibWeb makes
    pub var m_execution_context_stack: ak.Vector[JsExecutionContext*]  # on the C heap, as the VM
    pub var m_pending_exception: JsPendingException*?  # addition (DESIGN.md §2.10): the rooted slot
    pub var m_external_roots: JsVmExternalRoots  # addition (DESIGN.md §3.3 rule 4)
    pub var m_saved_execution_context_stacks: ak.Vector[ak.Vector[JsExecutionContext*]]  # VM.h:533 (added in region r21); on the C heap
    pub var m_execution_generation: u64  # VM.h (added in region r29): ClearKeptObjects' generation

## Addition (DESIGN.md §3.3 rule 4): managed memory that only memory outside the heap refers to
## (a module global such as Gfx::FontDatabase::the()), kept alive by the VM: a
## GC::ConservativeVector whose words the heap scans as conservative roots.
pub struct JsVmExternalRoots:
    pub var base: gc.ConservativeVectorBase  # primary base
    pub var values: ak.Vector[u64]  # on the C heap, as the VM

## Addition (DESIGN.md §2.10): the cell holding the VM's pending exception, so that what it
## refers to (a DOMException, a message String) is marked through it: the VM reports it as a
## root, its visit_edges visits the DOMException and its bytes are scanned for blobs.
pub struct JsPendingException: gc.IsCell:
    pub var cell_base: gc.Cell
    pub var exception: IdlException?

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of the pending-exception cell.
pub let js_pending_exception_vtable: gc.CellVTable = gc.CellVTable(class_info = &js_pending_exception_class, class_name = js_pending_exception_class_name_impl, visit_edges = js_pending_exception_visit_edges_impl)

## Class information of the pending-exception cell (not a JS::Cell: no class id range).
pub let js_pending_exception_class: ak.ClassInfo = ak.ClassInfo(name = "PendingException", first_id = 0, last_id = 0, size = sizeof(JsPendingException), vtable = (const void*)&js_pending_exception_vtable)

## JS::VM::s_the (Libraries/LibJS/Runtime/VM.h:515).
pub var vm_s_the: Vm*?
