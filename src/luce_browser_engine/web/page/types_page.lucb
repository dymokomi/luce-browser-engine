## is<Web::PageClient>: the class-id range test.
pub func is_page_client[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= page_client_class.first_id and id <= page_client_class.last_id

## as_if<Web::PageClient>.
pub func as_if_page_client[P: gc.IsCell](p: P*) -> PageClient*?:
