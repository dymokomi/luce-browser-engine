# mark: Non-blocking dialogs ====================================================================

## Ported from Page.cpp:451 Web::Page::did_request_color_picker.
pub func page_did_request_color_picker(this: Page*, target: gc.Weak[HtmlInputElement], current_color: gfx.Color):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.none_:
        this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.color_picker
        this.m_pending_non_blocking_dialog_target = gc.make_weak((HtmlElement*?)gc.weak_ptr(&target))

        page_client_page_did_request_color_picker(this.m_client, current_color)

## Ported from Page.cpp:461 Web::Page::color_picker_update.
pub func page_color_picker_update(this: Page*, picked_color: gfx.Color?, state: HtmlColorPickerUpdateState):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.color_picker:
        if state == HtmlColorPickerUpdateState.closed:
            this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.none_

        if let target = gc.weak_ptr(&this.m_pending_non_blocking_dialog_target):
            let input_element = as_html_input_element(target)
            html_input_element_did_pick_color(input_element, picked_color, state)
            if state == HtmlColorPickerUpdateState.closed:
                this.m_pending_non_blocking_dialog_target = gc.make_weak[HtmlElement](none)

## Ported from Page.cpp:476 Web::Page::did_request_file_picker.
pub func page_did_request_file_picker(this: Page*, target: gc.Weak[HtmlInputElement], accepted_file_types: HtmlFileFilter, allow_multiple_files: HtmlAllowMultipleFiles):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.none_:
        this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.file_picker
        this.m_pending_non_blocking_dialog_target = gc.make_weak((HtmlElement*?)gc.weak_ptr(&target))

        page_client_page_did_request_file_picker(this.m_client, accepted_file_types, allow_multiple_files)

## Ported from Page.cpp:486 Web::Page::file_picker_closed.
pub func page_file_picker_closed(this: Page*, selected_files: HtmlSelectedFile[]):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.file_picker:
        this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.none_

        if let target = gc.weak_ptr(&this.m_pending_non_blocking_dialog_target):
            let input_element = as_html_input_element(target)
            html_input_element_did_select_files(input_element, selected_files)

            this.m_pending_non_blocking_dialog_target = gc.make_weak[HtmlElement](none)

## Ported from Page.cpp:500 Web::Page::did_request_select_dropdown.
pub func page_did_request_select_dropdown(this: Page*, target: gc.Weak[HtmlSelectElement], content_position: gfx.CssPixelPoint, minimum_width: gfx.CssPixels, items: ak.Vector[HtmlSelectItem]):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.none_:
        this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.select
        this.m_pending_non_blocking_dialog_target = gc.make_weak((HtmlElement*?)gc.weak_ptr(&target))
        page_client_page_did_request_select_dropdown(this.m_client, content_position, minimum_width, items)

## Ported from Page.cpp:509 Web::Page::select_dropdown_closed.
pub func page_select_dropdown_closed(this: Page*, selected_item_id: u32?):
    if this.m_pending_non_blocking_dialog == PagePendingNonBlockingDialog.select:
        this.m_pending_non_blocking_dialog = PagePendingNonBlockingDialog.none_

        if let target = gc.weak_ptr(&this.m_pending_non_blocking_dialog_target):
            let select_element = as_html_select_element(target)
            html_select_element_did_select_item(select_element, selected_item_id)
            this.m_pending_non_blocking_dialog_target = gc.make_weak[HtmlElement](none)

# mark: Clipboard requests ======================================================================

## Ported from Page.cpp:522 Web::Page::request_clipboard_entries.
pub func page_request_clipboard_entries(this: Page*, request: gc.Function1[ak.Vector[ClipboardSystemClipboardItem], unit]*):
    let request_id = this.m_next_clipboard_request_id
    this.m_next_clipboard_request_id += 1
    discard(ak.hash_map_set(&this.m_pending_clipboard_requests, request_id, request))

    page_client_page_did_request_clipboard_entries(page_client(this), request_id)

## Ported from Page.cpp:530 Web::Page::retrieved_clipboard_entries.
pub func page_retrieved_clipboard_entries(this: Page*, request_id: u64, items: ak.Vector[ClipboardSystemClipboardItem]):
    if let request = ak.hash_map_take_k(&this.m_pending_clipboard_requests, request_id):
        ak.function1_call(&request.function, items)

# mark: Media and canvas elements ===============================================================

## Ported from Page.cpp:536 Web::Page::register_media_element.
pub func page_register_media_element(this: Page*, media_id: i64):
    ak.vector_append_t(&this.m_media_elements, media_id)

## The remove_all_matching predicate of the unregister functions (`candidate_id == id`).
func page_is_node_id(context: void*?, candidate_id: const i64*) -> bool:
    return *candidate_id == *(const i64*)(context else trap("no id"))

## Ported from Page.cpp:541 Web::Page::unregister_media_element.
pub func page_unregister_media_element(this: Page*, media_id: i64):
    var id = media_id
    discard(ak.vector_remove_all_matching(&this.m_media_elements, ak.Function1[const i64*, bool](call = page_is_node_id, context = &id)))

## Ported from Page.cpp:549 Web::Page::for_each_media_element.
func page_for_each_media_element(this: Page*, callback: ak.Function1[HtmlMediaElement*, unit]):
    for media_id in ak.vector_span(&this.m_media_elements):
        if let node = dom_node_from_unique_id(media_id):
            ak.function1_call(&callback, as_html_media_element(node))

## update_all_media_element_video_sinks' callback.
func page_update_media_element_video_sink(context: void*?, media_element: HtmlMediaElement*):
    let should_request_another_frame = (bool*)(context else trap("no flag"))
    html_media_element_update_video_frame_and_timeline(media_element)
    *should_request_another_frame = true

## Ported from Page.cpp:557 Web::Page::update_all_media_element_video_sinks.
pub func page_update_all_media_element_video_sinks(this: Page*):
    var should_request_another_frame = false
    page_for_each_media_element(this, ak.Function1[HtmlMediaElement*, unit](call = page_update_media_element_video_sink, context = &should_request_another_frame))

    if should_request_another_frame:
        page_client_request_frame(page_client(this))

## Ported from Page.cpp:569 Web::Page::register_canvas_element.
pub func page_register_canvas_element(this: Page*, canvas_id: i64):
    ak.vector_append_t(&this.m_canvas_elements, canvas_id)

## Ported from Page.cpp:574 Web::Page::unregister_canvas_element.
pub func page_unregister_canvas_element(this: Page*, canvas_id: i64):
    var id = canvas_id
    discard(ak.vector_remove_all_matching(&this.m_canvas_elements, ak.Function1[const i64*, bool](call = page_is_node_id, context = &id)))

## Ported from Page.cpp:582 Web::Page::for_each_canvas_element.
func page_for_each_canvas_element(this: Page*, callback: ak.Function1[HtmlCanvasElement*, unit]):
    for canvas_id in ak.vector_span(&this.m_canvas_elements):
