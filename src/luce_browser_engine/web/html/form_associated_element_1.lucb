## Ported from FormAssociatedElement.cpp:50 Web::HTML::FormAssociatedElement::is_form_associated_element (virtual).
# https://html.spec.whatwg.org/multipage/forms.html#form-associated-element
pub func html_form_associated_element_is_form_associated_element_impl(this: HtmlFormAssociatedElement*) -> bool:
    return html_element_is_form_associated_custom_element(html_form_associated_element_html_element(this))

