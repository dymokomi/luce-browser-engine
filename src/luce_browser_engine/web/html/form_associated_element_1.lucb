#==============================================================================================
#
#   form_associated_element_1 - HTML::FormAssociatedElement: construction, categories
#                               and the form owner
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/FormAssociatedElement.cpp (lines 1-303) and FormAssociatedElement.h:
#       the members' initializers, ValidityStateFlags, the listed / submittable / resettable
#       categories, the reset algorithm, the form owner (set_form, reset the form owner and the
#       insertion, removal, move and attribute steps that reset it), validity, setCustomValidity,
#       enabled, and the disabled state of form-associated custom elements.
#
#       FormAssociatedElement is a stateful mixin embedded in every HTMLElement (DESIGN.md
#       §2.5): its virtuals dispatch through the table of the class that owns it, and the owning
#       element is reached through the virtual form_associated_element_to_html_element.
#
#==============================================================================================

# mark: Helpers =================================================================================

## `form_associated_element_to_html_element()`: the HTML element this mixin lives in.
func html_form_associated_element_html_element(this: HtmlFormAssociatedElement*) -> HtmlElement*:
    return html_form_associated_element_form_associated_element_to_html_element(this)

## `Optional<FlyString> == Optional<String>` (AK::Optional's operator==): both empty, or both
## present with equal strings.
func html_optional_fly_string_eq_optional_string(a: ak.FlyString?, b: ak.String?) -> bool:
    if let a_value = a:
        let b_value = b else return false
        return ak.string_eq_fly_string(&b_value, &a_value)
    return b == none

## `name == HTML::AttributeNames::...` on FlyStrings.
func html_form_name_is(name: ak.FlyString, attribute_name: ak.FlyString) -> bool:
    return ak.fly_string_eq_fly_string(&name, &attribute_name)

# mark: Construction ============================================================================

## FormAssociatedElement.h:167 FormAssociatedElement::FormAssociatedElement() = default: the
## members' initializers (the cell is zeroed; String and the two FACESubmissionValue variants
## are not zero in C++: the empty string, and Empty). HTMLElement's constructor runs it.
pub func html_form_associated_element_construct(this: HtmlFormAssociatedElement*):
    this.m_face_validation_message = ak.string_new()
    this.m_face_submission_value = .empty
    this.m_face_state = .empty
    this.m_custom_validity_error_message = ak.string_new()

# mark: ValidityStateFlags and selection directions =============================================

## Ported from FormAssociatedElement.h:34 Web::HTML::ValidityStateFlags::has_one_or_more_true_values.
pub func html_validity_state_flags_has_one_or_more_true_values(this: const HtmlValidityStateFlags*) -> bool:
    return this.value_missing or this.type_mismatch or this.pattern_mismatch or this.too_long or this.too_short or this.range_underflow or this.range_overflow or this.step_mismatch or this.bad_input or this.custom_error

## Ported from FormAssociatedElement.cpp:38 Web::HTML::string_to_selection_direction.
func html_string_to_selection_direction(value: ak.String?) -> HtmlSelectionDirection:
    let present = value else return HtmlSelectionDirection.none_
    if ak.string_eq_string_view(&present, ak.sv("forward")):
        return HtmlSelectionDirection.forward
    if ak.string_eq_string_view(&present, ak.sv("backward")):
        return HtmlSelectionDirection.backward
    return HtmlSelectionDirection.none_

