## Ported from HTMLVideoElement.h:91 Web::HTML::HTMLVideoElement::supports_dimension_attributes (override).
# https://html.spec.whatwg.org/multipage/media.html#the-video-element:dimension-attributes
pub func html_video_element_supports_dimension_attributes_impl(base: DomElement*) -> bool:
