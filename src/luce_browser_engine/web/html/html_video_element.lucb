#==============================================================================================
#
#   html_video_element - HTML::HTMLVideoElement: <video>, its natural dimensions and poster
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLVideoElement.cpp (lines 1-347) and the inline members of
#       HTMLVideoElement.h: construction (which moves the mixin tables to HTMLVideoElement's,
#       as C++'s vptrs move), initialize, finalize, visit_edges, the poster attribute, the
#       VideoBox layout node, the intrinsic video dimensions and videoWidth / videoHeight, the
#       natural dimensions (from the poster frame or the video), fetching the poster frame
#       (phase 2: Fetch and image decoding), the representation and the current bitmap.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from HTMLVideoElement.cpp:28 Web::HTML::HTMLVideoElement::HTMLVideoElement.
pub func html_video_element_construct(this: HtmlVideoElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_media_element_construct(this.html_media_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLVideoElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_video_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_video_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_video_element_animatable_vtable
    element.global_event_handlers.vtable = &html_video_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_video_element_form_associated_element_vtable

## Ported from HTMLVideoElement.cpp:35 Web::HTML::HTMLVideoElement::initialize (override).
pub func html_video_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_video_element)
    html_media_element_initialize_impl(base, realm)

## Ported from HTMLVideoElement.cpp:41 Web::HTML::HTMLVideoElement::finalize (override).
pub func html_video_element_finalize_impl(base: gc.Cell*):
    html_media_element_finalize_impl(base)

## Ported from HTMLVideoElement.cpp:46 Web::HTML::HTMLVideoElement::visit_edges (override).
pub func html_video_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlVideoElement*)base
    html_media_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_video_track)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_fetch_controller)  # opaque in phase 1

## Ported from HTMLVideoElement.cpp:53 Web::HTML::HTMLVideoElement::attribute_changed (override).
pub func html_video_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (HtmlVideoElement*)base
    html_media_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_poster):
        html_video_element_determine_element_poster_frame(this, value) else trap("FIXME: should propagate errors")

## Ported from HTMLVideoElement.cpp:62 Web::HTML::HTMLVideoElement::create_layout_node (override).
pub func html_video_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    # heap().allocate<Layout::VideoBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_video_box(dom_element_realm(base), dom_node_document(base.dom_node()), base, style).layout_node()

## Ported from HTMLVideoElement.cpp:67 Web::HTML::HTMLVideoElement::layout_node.
