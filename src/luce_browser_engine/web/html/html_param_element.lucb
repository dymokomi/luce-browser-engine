#==============================================================================================
#
#   html_param_element - HTML::HTMLParamElement: <param>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLParamElement.cpp (lines 1-28): construction (which moves the
#       mixin tables to HTMLParamElement's, as C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLParamElement.cpp:15 Web::HTML::HTMLParamElement::HTMLParamElement.
pub func html_param_element_construct(this: HtmlParamElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLParamElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_param_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_param_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_param_element_animatable_vtable
    element.global_event_handlers.vtable = &html_param_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_param_element_form_associated_element_vtable

## Ported from HTMLParamElement.cpp:22 Web::HTML::HTMLParamElement::initialize (override).
pub func html_param_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_param_element)
    html_element_initialize_impl(base, realm)
