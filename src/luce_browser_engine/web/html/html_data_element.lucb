#==============================================================================================
#
#   html_data_element - HTML::HTMLDataElement: <data>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLDataElement.cpp (lines 1-28) and the default_role inline of
#       HTMLDataElement.h: construction (which moves the mixin tables to HTMLDataElement's, as
#       C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLDataElement.cpp:15 Web::HTML::HTMLDataElement::HTMLDataElement.
pub func html_data_element_construct(this: HtmlDataElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLDataElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_data_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_data_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_data_element_animatable_vtable
    element.global_event_handlers.vtable = &html_data_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_data_element_form_associated_element_vtable

## Ported from HTMLDataElement.cpp:22 Web::HTML::HTMLDataElement::initialize (override).
pub func html_data_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_data_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLDataElement.h:22 Web::HTML::HTMLDataElement::default_role (override).
# https://www.w3.org/TR/html-aria/#el-data
pub func html_data_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    return AriaRole.generic
