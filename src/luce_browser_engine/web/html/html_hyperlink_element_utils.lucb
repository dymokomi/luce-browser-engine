    html_hyperlink_element_utils_update_href(this)

## Ported from HTMLHyperlinkElementUtils.cpp:251 Web::HTML::HTMLHyperlinkElementUtils::port.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-port
pub func html_hyperlink_element_utils_port(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url or url's port is null, return the empty string.
    let url = this.m_url else return ak.string_new()
    let port = web_url.url_port(&url) else return ak.string_new()

    # 4. Return url's port, serialized.
    return ak.string_number_u64(port)

## Ported from HTMLHyperlinkElementUtils.cpp:268 Web::HTML::HTMLHyperlinkElementUtils::set_port.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-port
pub func html_hyperlink_element_utils_set_port(this: HtmlHyperlinkElementUtils*, port: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null or url cannot have a username/password/port, then return.
    var url = this.m_url else return
    if web_url.url_cannot_have_a_username_or_password_or_port(&url):
        return

    # 4. If the given value is the empty string, then set url's port to null.
    if ak.string_view_is_empty(&port):
        web_url.url_set_port(&url, none)
    # 5. Otherwise, basic URL parse the given value, with url as url and port state as state override.
    else:
        discard(web_url.parser_basic_parse(port, none, &url, web_url.ParserState.port))
    this.m_url = url

    # 6. Update href.
    html_hyperlink_element_utils_update_href(this)

# mark: pathname, search and hash ===============================================================

## Ported from HTMLHyperlinkElementUtils.cpp:293 Web::HTML::HTMLHyperlinkElementUtils::pathname.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-pathname
pub func html_hyperlink_element_utils_pathname(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null, return the empty string.
    let url = this.m_url else return ak.string_new()

    # 4. Return the result of URL path serializing url.
    return web_url.url_serialize_path(&url)

## Ported from HTMLHyperlinkElementUtils.cpp:309 Web::HTML::HTMLHyperlinkElementUtils::set_pathname.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-pathname
pub func html_hyperlink_element_utils_set_pathname(this: HtmlHyperlinkElementUtils*, pathname: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url is null or url has an opaque path, then return.
    var url = this.m_url else return
    if web_url.url_has_an_opaque_path(&url):
        return

    # 4. Set url's path to the empty list.
    var no_paths: ak.Vector[ak.ByteString]
    web_url.url_set_paths(&url, no_paths)

    # 5. Basic URL parse the given value, with url as url and path start state as state override.
    discard(web_url.parser_basic_parse(pathname, none, &url, web_url.ParserState.path_start))
    this.m_url = url

    # 6. Update href.
    html_hyperlink_element_utils_update_href(this)

## Ported from HTMLHyperlinkElementUtils.cpp:331 Web::HTML::HTMLHyperlinkElementUtils::search.
pub func html_hyperlink_element_utils_search(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null, or url's query is either null or the empty string, return the empty string.
    let url = this.m_url else return ak.string_new()
    let query = web_url.url_query(&url) else return ak.string_new()
    if ak.string_is_empty(&query):
        return ak.string_new()

    # 4. Return "?", followed by url's query.
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "?")
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&query))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from HTMLHyperlinkElementUtils.cpp:346 Web::HTML::HTMLHyperlinkElementUtils::set_search.
pub func html_hyperlink_element_utils_set_search(this: HtmlHyperlinkElementUtils*, search: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null, terminate these steps.
    var url = this.m_url else return

    # 4. If the given value is the empty string, set url's query to null.
    if ak.string_view_is_empty(&search):
        web_url.url_set_query(&url, none)
    else:
        # 5. Otherwise:
        #    1. Let input be the given value with a single leading "?" removed, if any.
        let input = ak.string_view_substring_view(&search, (usize)ak.string_view_starts_with_u8(&search, '?'))

        #    2. Set url's query to the empty string.
        web_url.url_set_query(&url, ak.string_new())

        #    3. Basic URL parse input, with null, this element's node document's document's character encoding, url as url, and query state as state override.
        discard(web_url.parser_basic_parse(input, none, &url, web_url.ParserState.query))
    this.m_url = url

    # 6. Update href.
    html_hyperlink_element_utils_update_href(this)

## Ported from HTMLHyperlinkElementUtils.cpp:376 Web::HTML::HTMLHyperlinkElementUtils::hash.
pub func html_hyperlink_element_utils_hash(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null, or url's fragment is either null or the empty string, return the empty string.
    let url = this.m_url else return ak.string_new()
    let fragment = web_url.url_fragment(&url) else return ak.string_new()
    if ak.string_is_empty(&fragment):
        return ak.string_new()

    # 4. Return "#", followed by url's fragment.
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "#")
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&fragment))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from HTMLHyperlinkElementUtils.cpp:391 Web::HTML::HTMLHyperlinkElementUtils::set_hash.
pub func html_hyperlink_element_utils_set_hash(this: HtmlHyperlinkElementUtils*, hash_: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.

    # 3. If url is null, then return.
    var url = this.m_url else return

    # 4. If the given value is the empty string, set url's fragment to null.
    if ak.string_view_is_empty(&hash_):
        web_url.url_set_fragment(&url, none)
    else:
        # 5. Otherwise:
        #    1. Let input be the given value with a single leading "#" removed, if any.
        let input = ak.string_view_substring_view(&hash_, (usize)ak.string_view_starts_with_u8(&hash_, '#'))

        #    2. Set url's fragment to the empty string.
        web_url.url_set_fragment(&url, ak.string_new())

        #    3. Basic URL parse input, with url as url and fragment state as state override.
        discard(web_url.parser_basic_parse(input, none, &url, web_url.ParserState.fragment))
    this.m_url = url

    # 6. Update href.
    html_hyperlink_element_utils_update_href(this)

# mark: href ====================================================================================

## Ported from HTMLHyperlinkElementUtils.cpp:422 Web::HTML::HTMLHyperlinkElementUtils::href.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-href
pub func html_hyperlink_element_utils_href(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    let url = this.m_url

    # 3. If url is null and this element has no href content attribute, return the empty string.
    let href_content_attribute = dom_element_attribute(html_hyperlink_element_utils_hyperlink_element_utils_element_const(this), html_attribute_names_href)
    if url == none and href_content_attribute == none:
        return ak.string_new()

    # 4. Otherwise, if url is null, return this element's href content attribute's value.
    if url == none:
        return href_content_attribute else trap("unreachable")
    let present_url = url else trap("unreachable")

    # 5. Return url, serialized.
    return web_url.url_serialize(&present_url)

## Ported from HTMLHyperlinkElementUtils.cpp:444 Web::HTML::HTMLHyperlinkElementUtils::set_href.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-href
pub func html_hyperlink_element_utils_set_href(this: HtmlHyperlinkElementUtils*, href: ak.String):
    # The href attribute's setter must set this element's href content attribute's value to the given value.
    dom_element_set_attribute_value(html_hyperlink_element_utils_hyperlink_element_utils_element(this), html_attribute_names_href, href)

## Ported from HTMLHyperlinkElementUtils.cpp:451 Web::HTML::HTMLHyperlinkElementUtils::update_href.
# https://html.spec.whatwg.org/multipage/links.html#update-href
pub func html_hyperlink_element_utils_update_href(this: HtmlHyperlinkElementUtils*):
    # To update href, set the element's href content attribute's value to the element's url, serialized.
    let url = this.m_url else trap("VERIFY: Optional::operator-> on an empty url")
    dom_element_set_attribute_value(html_hyperlink_element_utils_hyperlink_element_utils_element(this), html_attribute_names_href, web_url.url_serialize(&url))

## Ported from HTMLHyperlinkElementUtils.cpp:458 Web::HTML::HTMLHyperlinkElementUtils::hyperlink_element_utils_extract_an_origin.
# https://html.spec.whatwg.org/multipage/links.html#api-for-a-and-area-elements:extract-an-origin
pub func html_hyperlink_element_utils_hyperlink_element_utils_extract_an_origin(this: HtmlHyperlinkElementUtils*) -> web_url.Origin?:
    # 1. If this's url is null, then return null.
    let url = this.m_url else return none

    # 2. Return this's url's origin.
    return web_url.url_origin(&url)

