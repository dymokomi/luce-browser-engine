#==============================================================================================
#
#   html_hyperlink_element_utils - HTML::HTMLHyperlinkElementUtils: the URL decomposition IDL
#                                  attributes of a and area elements
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLHyperlinkElementUtils.cpp (lines 1-468) and the virtuals of
#       HTMLHyperlinkElementUtils.h: reinitializing and setting the url, origin, href, protocol,
#       username, password, host, hostname, port, pathname, search and hash (getters and
#       setters), updating href, and extracting an origin. C++ mutates `m_url` through a
#       reference to the optional's value; here the URL is taken out, changed and stored back
#       (the same URL data: a plain copy does not share a CopyOnWrite reference).
#
#==============================================================================================

# mark: Setting the url =========================================================================

## Ported from HTMLHyperlinkElementUtils.cpp:19 Web::HTML::HTMLHyperlinkElementUtils::reinitialize_url.
# https://html.spec.whatwg.org/multipage/links.html#reinitialise-url
pub func html_hyperlink_element_utils_reinitialize_url(this: HtmlHyperlinkElementUtils*):
    # 1. If the element's url is non-null, its scheme is "blob", and it has an opaque path, then terminate these steps.
    if let url = this.m_url:
        let scheme = web_url.url_scheme(&url)
        if ak.string_eq_string_view(&scheme, ak.sv("blob")) and web_url.url_has_an_opaque_path(&url):
            return

    # 2. Set the url.
    html_hyperlink_element_utils_set_the_url(this)

## `Optional<URL::URL> != Optional<URL::URL>`.
func html_hyperlink_element_utils_optional_urls_differ(a: web_url.Url?, b: web_url.Url?) -> bool:
    if let a_url = a:
        if let b_url = b:
            return not web_url.url_eq(&a_url, b_url)
        return true
    return b != none

## set_the_url's ScopeGuard: invalidates style when the url changed.
func html_hyperlink_element_utils_invalidate_style_if_needed(this: HtmlHyperlinkElementUtils*, old_url: web_url.Url?):
    if html_hyperlink_element_utils_optional_urls_differ(this.m_url, old_url):
        css_invalidation_invalidate_style_after_hyperlink_state_change(html_hyperlink_element_utils_hyperlink_element_utils_element(this))

## Ported from HTMLHyperlinkElementUtils.cpp:30 Web::HTML::HTMLHyperlinkElementUtils::set_the_url.
# https://html.spec.whatwg.org/multipage/links.html#concept-hyperlink-url-set
pub func html_hyperlink_element_utils_set_the_url(this: HtmlHyperlinkElementUtils*):
    let old_url = this.m_url
    defer html_hyperlink_element_utils_invalidate_style_if_needed(this, old_url)

    let element = html_hyperlink_element_utils_hyperlink_element_utils_element(this)

    # 1. Set this element's url to null.
    this.m_url = none

    # 2. If this element's href content attribute is absent, then return.
    let href_content_attribute = dom_element_attribute(element, html_attribute_names_href) else return

    # 3. Let url be the result of encoding-parsing a URL given this element's href content attribute's value, relative to this element's node document.
    let url = dom_document_encoding_parse_url(dom_element_document(element), ak.string_bytes_as_string_view(&href_content_attribute))

    # 4. If url is not failure, then set this element's url to url.
    if let parsed = url:
        this.m_url = parsed

# mark: origin and protocol =====================================================================

## Ported from HTMLHyperlinkElementUtils.cpp:57 Web::HTML::HTMLHyperlinkElementUtils::origin.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-origin
pub func html_hyperlink_element_utils_origin(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. If this element's url is null, return the empty string.
    let url = this.m_url else return ak.string_new()

    # 3. Return the serialization of this element's url's origin.
    let origin = web_url.url_origin(&url)
    return web_url.origin_serialize(&origin)

## Ported from HTMLHyperlinkElementUtils.cpp:71 Web::HTML::HTMLHyperlinkElementUtils::protocol.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-protocol
pub func html_hyperlink_element_utils_protocol(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. If this element's url is null, return ":".
    let url = this.m_url else return ak.string_from_str(":")

    # 3. Return this element's url's scheme, followed by ":".
    let scheme = web_url.url_scheme(&url)
    var builder = ak.string_builder_new()
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&scheme))
    ak.string_builder_append(&builder, ":")
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from HTMLHyperlinkElementUtils.cpp:85 Web::HTML::HTMLHyperlinkElementUtils::set_protocol.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-protocol
pub func html_hyperlink_element_utils_set_protocol(this: HtmlHyperlinkElementUtils*, protocol: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. If this element's url is null, terminate these steps.
    var url = this.m_url else return

    # 3. Basic URL parse the given value, followed by ":", with this element's url as url and scheme start state as state override.
    var builder = ak.string_builder_new()
    ak.string_builder_append_string_view(&builder, protocol)
    ak.string_builder_append(&builder, ":")
    let input = ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")
    discard(web_url.parser_basic_parse(ak.string_bytes_as_string_view(&input), none, &url, web_url.ParserState.scheme_start))
    this.m_url = url

    # 4. Update href.
    html_hyperlink_element_utils_update_href(this)

