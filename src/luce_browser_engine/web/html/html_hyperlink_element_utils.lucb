    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url is null, then return the empty string.
    let url = this.m_url else return ak.string_new()

    # 4. Return url's password.
    return web_url.url_password(&url)

## Ported from HTMLHyperlinkElementUtils.cpp:153 Web::HTML::HTMLHyperlinkElementUtils::set_password.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-password
pub func html_hyperlink_element_utils_set_password(this: HtmlHyperlinkElementUtils*, password: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url is null or url cannot have a username/password/port, then return.
    var url = this.m_url else return
    if web_url.url_cannot_have_a_username_or_password_or_port(&url):
        return

    # 4. Set the password, given url and the given value.
    web_url.url_set_password(&url, password)
    this.m_url = url

    # 5. Update href.
    html_hyperlink_element_utils_update_href(this)

# mark: host, hostname and port =================================================================

## Ported from HTMLHyperlinkElementUtils.cpp:173 Web::HTML::HTMLHyperlinkElementUtils::host.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-host
pub func html_hyperlink_element_utils_host(this: HtmlHyperlinkElementUtils*) -> ak.String:
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url or url's host is null, return the empty string.
    let url = this.m_url else return ak.string_new()
    if web_url.url_host(&url) == none:
        return ak.string_new()

    # 4. If url's port is null, return url's host, serialized.
    let port = web_url.url_port(&url) else return web_url.url_serialized_host(&url)

    # 5. Return url's host, serialized, followed by ":" and url's port, serialized.
    let serialized_host = web_url.url_serialized_host(&url)
    var builder = ak.string_builder_new()
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&serialized_host))
    ak.string_builder_append(&builder, ":")
    let port_string = ak.string_number_u64(port)
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&port_string))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from HTMLHyperlinkElementUtils.cpp:194 Web::HTML::HTMLHyperlinkElementUtils::set_host.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-host
pub func html_hyperlink_element_utils_set_host(this: HtmlHyperlinkElementUtils*, host: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url is null or url has an opaque path, then return.
    var url = this.m_url else return
    if web_url.url_has_an_opaque_path(&url):
        return

    # 4. Basic URL parse the given value, with url as url and host state as state override.
    discard(web_url.parser_basic_parse(host, none, &url, web_url.ParserState.host))
    this.m_url = url

    # 5. Update href.
    html_hyperlink_element_utils_update_href(this)

## Ported from HTMLHyperlinkElementUtils.cpp:214 Web::HTML::HTMLHyperlinkElementUtils::hostname.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-hostname
