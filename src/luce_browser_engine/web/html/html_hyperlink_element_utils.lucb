    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. If this element's url is null, return the empty string.
    let url = this.m_url else return ak.string_new()

    # 3. Return this element's url's username.
    return web_url.url_username(&url)

## Ported from HTMLHyperlinkElementUtils.cpp:116 Web::HTML::HTMLHyperlinkElementUtils::set_username.
# https://html.spec.whatwg.org/multipage/links.html#dom-hyperlink-username
pub func html_hyperlink_element_utils_set_username(this: HtmlHyperlinkElementUtils*, username: ak.StringView):
    # 1. Reinitialize url.
    html_hyperlink_element_utils_reinitialize_url(this)

    # 2. Let url be this element's url.
    # 3. If url is null or url cannot have a username/password/port, then return.
    var url = this.m_url else return
    if web_url.url_cannot_have_a_username_or_password_or_port(&url):
        return

    # 4. Set the username given this’s URL and the given value.
    web_url.url_set_username(&url, username)
    this.m_url = url

    # 5. Update href.
    html_hyperlink_element_utils_update_href(this)

## Ported from HTMLHyperlinkElementUtils.cpp:136 Web::HTML::HTMLHyperlinkElementUtils::password.
