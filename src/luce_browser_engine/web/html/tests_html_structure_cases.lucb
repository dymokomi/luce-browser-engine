#==============================================================================================
#
#   tests_html_structure_cases - region r26's element, table, list, source set and
#                              image-request cases pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/html_structure: cases.txt, oracle.cpp,
#       gen_luce_cases.py, build.sh). tests_html_structure runs each case through the port
#       and compares the output.
#
#==============================================================================================

## One oracle case: the mode, its arguments, and the reference build's output.
struct TestHtmlStructureCase:
    let mode: str
    let arguments: str[3]
    let expected: str

## Every oracle case, in cases.txt order (4 more, marked "!" in cases.txt, wait for other regions).
