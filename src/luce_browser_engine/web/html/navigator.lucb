## Ported from Navigator.cpp:176 Web::HTML::Navigator::get_battery.
# https://w3c.github.io/battery/#the-getbattery-method
pub func html_navigator_get_battery(this: HtmlNavigator*) -> JsPromiseCapability*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # 1. If this.[[BatteryPromise]] is null, then set it to a new promise in this's relevant realm.
    if this.m_battery_promise == none:
        this.m_battery_promise = idl_create_promise(realm)
    let battery_promise = this.m_battery_promise else trap("unreachable")

    # 2. If this's relevant global object's associated Document is not allowed to use the "battery" policy-controlled
    #    feature, then reject this.[[BatteryPromise]] with a "NotAllowedError" DOMException.
    # (`if (true)`: the Battery Status API is not implemented.)
    idl_reject_promise(realm, battery_promise, js_value_from_object((JsObject*)idl_not_allowed_error_create(realm, ak.utf16_string_from_str("Battery Status API is not yet implemented"))))
    # 3. Otherwise:
    # FIXME: 1. If this.[[BatteryManager]] is null, then set it to the result of creating a new BatteryManager in this's
    #           relevant realm.
    # FIXME: 2. Resolve this.[[BatteryPromise]] with this.[[BatteryManager]].

    # 4. Return this.[[BatteryPromise]].
    return battery_promise

