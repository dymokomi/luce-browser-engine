# mark: NavigatorConcurrentHardwareMixin and NavigatorDeviceMemoryMixin =========================

## Ported from NavigatorConcurrentHardware.cpp:14 Web::HTML::NavigatorConcurrentHardwareMixin::hardware_concurrency.
# https://html.spec.whatwg.org/multipage/workers.html#dom-navigator-hardwareconcurrency
pub func html_navigator_concurrent_hardware_mixin_hardware_concurrency() -> u64:
    return core_system_hardware_concurrency()

## AK::count_required_bits (AK/BuiltinWrappers.h): the number of bits needed to write value
## (1 for 0).
func html_count_required_bits(value: u64) -> u64:
    if value == 0:
        return 1
    var bits: u64 = 0
    var rest = value
    while rest != 0:
        bits += 1
        rest >>= 1
    return bits

## Ported from NavigatorDeviceMemory.cpp:14 Web::HTML::NavigatorDeviceMemoryMixin::device_memory.
# https://www.w3.org/TR/device-memory/#computing-device-memory-value
pub func html_navigator_device_memory_mixin_device_memory(this: const HtmlNavigatorDeviceMemoryMixin*) -> f64:
    # The value is calculated by using the actual device memory in MiB then rounding it to the nearest number where
    # only the most significant bit can be set and the rest are zeros (nearest power of two).
    let memory_in_bytes = core_system_physical_memory_bytes()
    let memory_in_mib = memory_in_bytes // (1024 * 1024)
    let required_bits = html_count_required_bits(memory_in_mib)
    let lower_memory_in_mib = (u64)1 << (u64)(required_bits - 1)
    let upper_memory_in_mib = (u64)1 << (u64)required_bits
    var rounded_memory_in_mib = lower_memory_in_mib
    if upper_memory_in_mib - memory_in_mib <= memory_in_mib - lower_memory_in_mib:
        rounded_memory_in_mib = upper_memory_in_mib

    # Then dividing that number by 1024.0 to get the value in GiB.
    let memory_in_gib = (f64)rounded_memory_in_mib / 1024.0

    # An upper bound and a lower bound should be set on the list of values.
    return ak.clamp_f64(memory_in_gib, 1.0, 4.0)

