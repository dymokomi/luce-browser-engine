# mark: Navigator ===============================================================================

## Ported from Navigator.cpp:31 Web::HTML::Navigator::create.
pub func html_navigator_create(realm: Realm*) -> HtmlNavigator*:
    return realm_create_html_navigator(realm, realm)

## Ported from Navigator.cpp:36 Web::HTML::Navigator::Navigator.
pub func html_navigator_construct(this: HtmlNavigator*, realm: Realm*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    # The vptrs of the mixin bases move to Navigator's tables.
    let class_id = this.cell().class_id
    this.navigator_beacon_partial.vtable = &html_navigator_navigator_beacon_partial_vtable
    this.navigator_beacon_partial.class_id = class_id
    this.navigator_gamepad_partial.vtable = &html_navigator_navigator_gamepad_partial_vtable
    this.navigator_gamepad_partial.class_id = class_id
    this.global_privacy_control_mixin.vtable = &html_navigator_global_privacy_control_mixin_vtable
    this.global_privacy_control_mixin.class_id = class_id
    this.navigator_encrypted_media_extensions_partial.vtable = &html_navigator_navigator_encrypted_media_extensions_partial_vtable
    this.navigator_encrypted_media_extensions_partial.class_id = class_id
    this.navigator_storage.vtable = &html_navigator_navigator_storage_vtable
    this.navigator_storage.class_id = class_id

## Ported from Navigator.cpp:43 Web::HTML::Navigator::initialize (override).
pub func html_navigator_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (HtmlNavigator*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.navigator)
    # Base::initialize(realm): PlatformObject inherits JS::Cell's.
    js_cell_initialize_impl(base, realm)
    gamepad_navigator_gamepad_partial_check_for_connected_gamepads(&this.navigator_gamepad_partial)

## Ported from Navigator.cpp:51 Web::HTML::Navigator::pdf_viewer_enabled.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-pdfviewerenabled
pub func html_navigator_pdf_viewer_enabled(this: HtmlNavigator*) -> bool:
    # The NavigatorPlugins mixin's pdfViewerEnabled getter steps are to return the user agent's PDF viewer supported.
    # NOTE: The NavigatorPlugins mixin should only be exposed on the Window object.
    let window = as_html_window((gc.Cell*)html_current_global_object())
    return page_pdf_viewer_supported(html_window_page(window))

## Ported from Navigator.cpp:60 Web::HTML::Navigator::webdriver.
# https://w3c.github.io/webdriver/#dfn-webdriver
pub func html_navigator_webdriver(this: HtmlNavigator*) -> bool:
    # Returns true if webdriver-active flag is set, false otherwise.

    # NOTE: The NavigatorAutomationInformation interface should not be exposed on WorkerNavigator.
    let window = as_html_window((gc.Cell*)html_current_global_object())
    return page_is_webdriver_active(html_window_page(window))

## Ported from Navigator.cpp:69 Web::HTML::Navigator::visit_edges (override).
pub func html_navigator_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlNavigator*)base
    gc.cell_visit_edges_impl(base, visitor)
    gamepad_navigator_gamepad_partial_visit_edges(&this.navigator_gamepad_partial, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_mime_type_array)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_plugin_array)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_clipboard)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_geolocation)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_serial)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_user_activation)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_service_worker_container)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_media_capabilities)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_media_devices)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_credentials)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_battery_promise)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_xr)  # opaque in phase 1

## Ported from Navigator.cpp:87 Web::HTML::Navigator::mime_types.
