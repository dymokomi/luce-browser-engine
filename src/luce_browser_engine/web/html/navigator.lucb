    return ak.string_from_str("Gecko")

## Ported from NavigatorID.cpp:67 Web::HTML::NavigatorIDMixin::product_sub.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-productsub
pub func html_navigator_id_mixin_product_sub(this: const HtmlNavigatorIdMixin*) -> ak.String:
    let navigator_compatibility_mode = resource_loader_navigator_compatibility_mode()

    # Must return the appropriate string from the following list:

    # If the navigator compatibility mode is Chrome or WebKit
    if navigator_compatibility_mode == NavigatorCompatibilityMode.chrome or navigator_compatibility_mode == NavigatorCompatibilityMode.web_kit:
        # The string "20030107".
        return ak.string_from_str("20030107")

    # If the navigator compatibility mode is Gecko
    if navigator_compatibility_mode == NavigatorCompatibilityMode.gecko:
        # The string "20100101".
        return ak.string_from_str("20100101")

    trap("VERIFY_NOT_REACHED")

## Ported from NavigatorID.cpp:89 Web::HTML::NavigatorIDMixin::user_agent.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-useragent
pub func html_navigator_id_mixin_user_agent(this: const HtmlNavigatorIdMixin*) -> ak.String:
    # Must return the default `User-Agent` value.
    return resource_loader_user_agent()

## Ported from NavigatorID.cpp:96 Web::HTML::NavigatorIDMixin::vendor.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-vendor
pub func html_navigator_id_mixin_vendor(this: const HtmlNavigatorIdMixin*) -> ak.String:
    let navigator_compatibility_mode = resource_loader_navigator_compatibility_mode()

    # Must return the appropriate string from the following list:

    # If the navigator compatibility mode is Chrome
    if navigator_compatibility_mode == NavigatorCompatibilityMode.chrome:
        # The string "Google Inc.".
        return ak.string_from_str("Google Inc.")

    # If the navigator compatibility mode is Gecko
    if navigator_compatibility_mode == NavigatorCompatibilityMode.gecko:
        # The empty string.
        return ak.string_from_str("")

    # If the navigator compatibility mode is WebKit
    if navigator_compatibility_mode == NavigatorCompatibilityMode.web_kit:
        # The string "Apple Computer, Inc.".
        return ak.string_from_str("Apple Computer, Inc.")

    trap("VERIFY_NOT_REACHED")

## Ported from NavigatorID.h:44 Web::HTML::NavigatorIDMixin::vendor_sub.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-vendorsub
pub func html_navigator_id_mixin_vendor_sub(this: const HtmlNavigatorIdMixin*) -> ak.String:
    return ak.String()

