## Ported from NavigatorID.cpp:16 Web::HTML::NavigatorIDMixin::app_version.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-appversion
pub func html_navigator_id_mixin_app_version(this: const HtmlNavigatorIdMixin*) -> ak.String:
    # 1. Let userAgent be this's relevant settings object's environment default `User-Agent` value.
    # FIXME: Store that on the settings object?
    let user_agent = resource_loader_user_agent()

    # 2. If userAgent does not start with `Mozilla/5.0 (`, then return the empty string.
    if not ak.string_starts_with_bytes(&user_agent, ak.sv("Mozilla/5.0 (")):
        return ak.String()

    # 3. Let trail be the substring of userAgent, isomorphic decoded, that follows the "Mozilla/" prefix.
    let prefix = ak.sv("Mozilla/")
    let trail = ak.string_substring_from_byte_offset(&user_agent, ak.string_view_length(&prefix)) else trap("MUST: substring_from_byte_offset")

    # 4. -> If the navigator compatibility mode is Chrome or WebKit
    let navigator_compatibility_mode = resource_loader_navigator_compatibility_mode()
    if navigator_compatibility_mode == NavigatorCompatibilityMode.chrome or navigator_compatibility_mode == NavigatorCompatibilityMode.web_kit:
        # Return trail.
        return trail
    #    -> If the navigator compatibility mode is Gecko
    if navigator_compatibility_mode == NavigatorCompatibilityMode.gecko:
        # If trail starts with "5.0 (Windows", then return "5.0 (Windows)".
        if ak.string_starts_with_bytes(&trail, ak.sv("5.0 (Windows")):
            return ak.string_from_str("5.0 (Windows)")

        # Otherwise, return the prefix of trail up to but not including the first U+003B (;), concatenated with the
        # character U+0029 RIGHT PARENTHESIS. For example, "5.0 (Macintosh)", "5.0 (Android 10)", or "5.0 (X11)".
        if let index = ak.string_find_byte_offset_u32(&trail, (u32)';'):
            var output = ak.string_builder_new()
            let prefix_of_trail = ak.string_substring_from_byte_offset_usize(&trail, 0, index) else trap("MUST: substring_from_byte_offset")
            ak.string_builder_append_string_view(&output, ak.string_bytes_as_string_view(&prefix_of_trail))
            ak.string_builder_append(&output, ")")
            return ak.string_from_string_builder(&output) else trap("MUST: StringBuilder::to_string")
        return trail

    trap("VERIFY_NOT_REACHED")

## Ported from NavigatorID.cpp:56 Web::HTML::NavigatorIDMixin::platform.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator-platform
pub func html_navigator_id_mixin_platform(this: const HtmlNavigatorIdMixin*) -> ak.String:
    # Must return a string representing the platform on which the browser is executing (e.g. "MacIntel", "Win32",
    # "Linux x86_64", "Linux armv81") or, for privacy and compatibility, a string that is commonly returned on another
    # platform.

    # FIXME: Use some portion of the user agent string to make spoofing work 100%
    return resource_loader_platform()

## Ported from NavigatorID.h:32 Web::HTML::NavigatorIDMixin::product.
