## Ported from Navigator.cpp:136 Web::HTML::Navigator::xr.
pub func html_navigator_xr(this: HtmlNavigator*) -> WebXrXrSystem*:
    if this.m_xr == none:
        let realm = bind_platform_object_realm(this.bind_platform_object())
        this.m_xr = realm_create_web_xr_xr_system(realm, realm)
        if html_window_is_internals_object_exposed():
            # m_xr->define_direct_property("test", realm.create<Internals::XRTest>(realm), ...): a JS
            # property for the test runner's scripts (phase 3).
            discard(0)
    return this.m_xr else trap("unreachable")

