#==============================================================================================
#
#   window_event_handlers - HTML::WindowEventHandlers: the Window event handler IDL attributes
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/WindowEventHandlers.cpp (lines 1-32): the setter and getter that
#       ENUMERATE_WINDOW_EVENT_HANDLERS expands for each event handler IDL attribute, in the
#       macro's order (setter first). Each forwards to the event target the including class names
#       through the virtual window_event_handlers_to_event_target. The gamepad event names come
#       from Gamepad::EventNames (gamepad/event_names).
#
#==============================================================================================

# mark: Event handler IDL attributes ==========================================================

## Ported from WindowEventHandlers.cpp:15 Web::HTML::WindowEventHandlers::set_onafterprint.
pub func html_window_event_handlers_set_onafterprint(this: HtmlWindowEventHandlers*, value: IdlCallbackType*?):
    if let event_target = html_window_event_handlers_window_event_handlers_to_event_target(this):
        dom_event_target_set_event_handler_attribute(event_target, html_event_names_afterprint, value)

## Ported from WindowEventHandlers.cpp:20 Web::HTML::WindowEventHandlers::onafterprint.
pub func html_window_event_handlers_onafterprint(this: HtmlWindowEventHandlers*) -> IdlCallbackType*?:
    if let event_target = html_window_event_handlers_window_event_handlers_to_event_target(this):
        return dom_event_target_event_handler_attribute(event_target, html_event_names_afterprint)
    return none

