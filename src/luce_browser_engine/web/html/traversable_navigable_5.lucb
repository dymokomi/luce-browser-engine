# mark: Screenshots =============================================================================

## The captures of a screenshot's completion (`[bitmap, &client]`).
struct HtmlTraversableNavigableScreenshotDone:
    var bitmap: gfx.Bitmap*
    var client: PageClient*

## A rendered screenshot's completion: hand the bitmap to the page client.
func html_traversable_navigable_screenshot_done(context: void*?):
    let captures = (HtmlTraversableNavigableScreenshotDone*)(context else trap("no captures"))
    page_client_page_did_take_screenshot(captures.client, gfx.bitmap_to_shareable_bitmap(captures.bitmap))

## Renders `rect` of the page into a new bitmap and hands it to the client (the shared tail of
## both branches of process_screenshot_requests); false when the bitmap cannot be created.
func html_traversable_navigable_take_screenshot(this: HtmlTraversableNavigable*, client: PageClient*, rect: gfx.DevicePixelRect, paint_overlay: bool) -> bool:
    let bitmap = gfx.bitmap_create_int_size(gfx.BitmapFormat.bgra8888, gfx.device_pixel_rect_size(&rect)) else return false
    let painting_surface = gfx.painting_surface_wrap_bitmap(bitmap)
    let paint_config = HtmlPaintConfig(paint_overlay = paint_overlay, canvas_fill_rect = rect)
    let captures = new HtmlTraversableNavigableScreenshotDone(bitmap = bitmap, client = client) else trap("out of memory")
    html_navigable_render_screenshot(this.html_navigable(), painting_surface, paint_config, ak.Function0[unit](call = html_traversable_navigable_screenshot_done, context = captures))
    return true

## Ported from TraversableNavigable.cpp:1806 Web::HTML::TraversableNavigable::process_screenshot_requests.
pub func html_traversable_navigable_process_screenshot_requests(this: HtmlTraversableNavigable*):
    let page = html_navigable_page(this.html_navigable())
    let client = page_client(page)
    while not ak.queue_is_empty(&this.m_screenshot_tasks):
        let task = ak.queue_dequeue(&this.m_screenshot_tasks)
        if let node_id = task.node_id:
            let dom_node = dom_node_from_unique_id(node_id)
            if let node = dom_node:
                dom_document_update_layout(dom_node_document(node), DomUpdateLayoutReason.process_screenshot)
            if dom_node == none or dom_node_paintable_box(dom_node else trap("unreachable")) == none:
                page_client_page_did_take_screenshot(client, gfx.ShareableBitmap())
                continue
            let paintable_box = dom_node_paintable_box(dom_node else trap("unreachable")) else trap("unreachable")
            let rect = page_enclosing_device_rect(page, paint_paintable_box_absolute_border_box_rect(paintable_box))
            if not html_traversable_navigable_take_screenshot(this, client, rect, false):
                page_client_page_did_take_screenshot(client, gfx.ShareableBitmap())
                continue
        else:
            let document = html_navigable_active_document(this.html_navigable()) else trap("no active document")
            dom_document_update_layout(document, DomUpdateLayoutReason.process_screenshot)
            let viewport = dom_document_layout_node(document) else trap("no layout node")
            let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(layout_box_paintable_box(viewport.layout_box()) else trap("no paintable box"))
            let rect = page_enclosing_device_rect(page, scrollable_overflow_rect else trap("Optional::value() on an empty optional"))
            if not html_traversable_navigable_take_screenshot(this, client, rect, true):
                page_client_page_did_take_screenshot(client, gfx.ShareableBitmap())
                continue
