## `static HashTable<NavigableContainer*> set` of all_instances(). Its storage is allocated from the C heap
## (memory.heap), which the collector does not scan; the containers are weak entries, as in C++ (a container
## leaves the set in its destructor).
var html_navigable_container_s_all_instances: ak.HashTable[HtmlNavigableContainer*?, ak.PtrTraits[HtmlNavigableContainer]]

## Ported from Libraries/LibWeb/HTML/NavigableContainer.cpp:29 Web::HTML::NavigableContainer::all_instances.
pub func html_navigable_container_all_instances() -> ak.HashTable[HtmlNavigableContainer*?, ak.PtrTraits[HtmlNavigableContainer]]*:
    return &html_navigable_container_s_all_instances

## Ported from Libraries/LibWeb/HTML/NavigableContainer.cpp:55 Web::HTML::NavigableContainer::navigable_container_with_content_navigable.
pub func html_navigable_container_navigable_container_with_content_navigable(navigable: HtmlNavigable*) -> HtmlNavigableContainer*?:
    for entry in ak.hash_table_begin(html_navigable_container_all_instances()):
        let navigable_container = *entry else continue
        if html_navigable_container_content_navigable(navigable_container) == (HtmlNavigable*?)navigable:
            return navigable_container
    return none
