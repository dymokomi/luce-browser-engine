#==============================================================================================
#
#   html_directory_element - HTML::HTMLDirectoryElement: <dir>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLDirectoryElement.cpp (lines 1-28): the constructor (which moves the mixin tables
#       to HTMLDirectoryElement's, as C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLDirectoryElement.cpp:15 Web::HTML::HTMLDirectoryElement::HTMLDirectoryElement.
pub func html_directory_element_construct(this: HtmlDirectoryElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLDirectoryElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_directory_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_directory_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_directory_element_animatable_vtable
    element.global_event_handlers.vtable = &html_directory_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_directory_element_form_associated_element_vtable

## Ported from HTMLDirectoryElement.cpp:22 Web::HTML::HTMLDirectoryElement::initialize (override).
pub func html_directory_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_directory_element)
    html_element_initialize_impl(base, realm)
