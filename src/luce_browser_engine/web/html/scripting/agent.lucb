## Ported from Libraries/LibWeb/HTML/Scripting/Agent.cpp:14 Web::HTML::Agent::spin_event_loop_until (virtual).
pub func html_agent_spin_event_loop_until_impl(this: HtmlAgent*, goal_condition: gc.Function0[bool]*?):
    platform_event_loop_plugin_spin_until(platform_event_loop_plugin_the(), goal_condition)

## Ported from Libraries/LibWeb/HTML/Scripting/Agent.cpp:20 Web::HTML::relevant_agent.
## https://html.spec.whatwg.org/multipage/webappapis.html#relevant-agent
pub func html_relevant_agent(object: JsObject*) -> HtmlAgent*:
    # The relevant agent for a platform object platformObject is platformObject's relevant Realm's agent.
    # Spec Note: This pointer is not yet defined in the JavaScript specification; see tc39/ecma262#1357.
    return vm_agent(realm_vm(html_relevant_realm(object))) else trap("VERIFY: the VM has an agent")
