## Ported from HTMLImageElement.cpp:152 Web::HTML::HTMLImageElement::dimension_attribute_source.
# https://html.spec.whatwg.org/multipage/embedded-content.html#concept-img-dimension-attribute-source
pub func html_image_element_dimension_attribute_source(this: HtmlImageElement*) -> DomElement*:
    if let source = this.m_dimension_attribute_source:
        return source
    return this.dom_element()

## Ported from HTMLImageElement.cpp:159 Web::HTML::HTMLImageElement::set_dimension_attribute_source.
pub func html_image_element_set_dimension_attribute_source(this: HtmlImageElement*, source: DomElement*?):
    if this.m_dimension_attribute_source != source:
        this.m_dimension_attribute_source = source
        dom_node_set_needs_style_update(this.dom_node(), true)

## Ported from HTMLImageElement.cpp:167 Web::HTML::HTMLImageElement::is_presentational_hint (override).
pub func html_image_element_is_presentational_hint_impl(base: DomElement*, name: ak.FlyString) -> bool:
    if dom_element_is_presentational_hint_impl(base, name):
        return true

    return ak.fly_string_eq_fly_string(&name, &html_attribute_names_hspace) or ak.fly_string_eq_fly_string(&name, &html_attribute_names_vspace) or ak.fly_string_eq_fly_string(&name, &html_attribute_names_border)

## Ported from HTMLImageElement.cpp:178 Web::HTML::HTMLImageElement::apply_presentational_hints (override).
pub func html_image_element_apply_presentational_hints_impl(base: DomElement*, properties: ak.Vector[CssStyleProperty]*):
    dom_element_apply_presentational_hints_impl(base, properties)
    for attribute in dom_element_attribute_span(base):
        let name = dom_attr_name(attribute)
        let value_string = dom_attr_value(attribute)
        let value = ak.string_bytes_as_string_view(&value_string)
        if ak.fly_string_eq_fly_string(&name, &html_attribute_names_hspace):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_left, value = parsed_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_right, value = parsed_value))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_vspace):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_top, value = parsed_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_bottom, value = parsed_value))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_border):
            if let parsed_value = html_parse_non_negative_integer(value):
                let width_value = css_length_style_value_create(css_length_make_px_f64(f64(parsed_value))).css_style_value()
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_top_width, value = width_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_right_width, value = width_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_bottom_width, value = width_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_left_width, value = width_value))

                let solid_value = css_keyword_style_value_create(css_data.Keyword.solid).css_style_value()
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_top_style, value = solid_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_right_style, value = solid_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_bottom_style, value = solid_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_left_style, value = solid_value))

## Ported from HTMLImageElement.cpp:210 Web::HTML::HTMLImageElement::form_associated_element_attribute_changed (override).
pub func html_image_element_form_associated_element_attribute_changed_impl(base: HtmlFormAssociatedElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (HtmlImageElement*)html_form_associated_element_form_associated_element_to_html_element(base)
    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_crossorigin):
        this.m_cors_setting = html_cors_setting_attribute_from_keyword(value)

    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_src) or ak.fly_string_eq_fly_string(&name, &html_attribute_names_srcset):
        html_image_element_update_the_image_data(this, true)

    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_alt):
        # NB: Called from attribute change handler, layout may be stale.
        if let layout_node = dom_element_unsafe_layout_node(this.dom_element()):
            layout_image_provider_did_update_alt_text(as_layout_image_box(layout_node))

    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_decoding):
        if let decoding = value:
            if ak.string_equals_ignoring_ascii_case_string_view(&decoding, ak.sv("sync")):
                ak.dbgln("FIXME: HTMLImageElement.decoding = 'sync' is not implemented yet")

## Ported from HTMLImageElement.cpp:232 Web::HTML::HTMLImageElement::create_layout_node (override).
pub func html_image_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (HtmlImageElement*)base
    # heap().allocate<Layout::ImageBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_image_box(dom_element_realm(base), dom_node_document(base.dom_node()), base, style, &this.image_provider).layout_node()

## Ported from HTMLImageElement.cpp:237 Web::HTML::HTMLImageElement::adjust_computed_style (override).
pub func html_image_element_adjust_computed_style_impl(base: DomElement*, style: CssComputedProperties*):
    # https://drafts.csswg.org/css-display-3/#unbox
    let display = css_computed_properties_display(style)
    if css_display_is_contents(&display):
        css_computed_properties_set_property(style, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.none_)).css_style_value())

