# mark: IDL attributes ==========================================================================

## Ported from HTMLImageElement.cpp:295 Web::HTML::HTMLImageElement::width.
# https://html.spec.whatwg.org/multipage/embedded-content.html#dom-img-width
pub func html_image_element_width(this: HtmlImageElement*) -> u32:
    dom_document_update_layout_if_needed_for_node(dom_node_document(this.dom_node()), this.dom_node(), DomUpdateLayoutReason.html_image_element_width)

    # Return the rendered width of the image, in CSS pixels, if the image is being rendered.
    if let paintable_box = dom_node_paintable_box(this.dom_node()):
        return (u32)paint_paintable_box_content_width(paintable_box).to_int()

    # On setting [the width or height IDL attribute], they must act as if they reflected the respective content attributes of the same name.
    if let width_attr = dom_element_get_attribute(this.dom_element(), html_attribute_names_width):
        if let converted = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&width_attr)):
            if converted <= 2147483647:
                return converted

    # ...or else the density-corrected intrinsic width and height of the image, in CSS pixels,
    # if the image has intrinsic dimensions and is available but not being rendered.
    if let bitmap = layout_image_provider_current_image_bitmap(&this.image_provider):
        return (u32)gfx.immutable_bitmap_width(bitmap)

    # ...or else 0, if the image is not available or does not have intrinsic dimensions.
    return 0

## Ported from HTMLImageElement.cpp:318 Web::HTML::HTMLImageElement::set_width.
pub func html_image_element_set_width(this: HtmlImageElement*, width: u32):
    var value = width
    if value > 2147483647:
        value = 0
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_width, ak.string_number_u64(value))

## Ported from HTMLImageElement.cpp:326 Web::HTML::HTMLImageElement::height.
# https://html.spec.whatwg.org/multipage/embedded-content.html#dom-img-height
pub func html_image_element_height(this: HtmlImageElement*) -> u32:
    dom_document_update_layout_if_needed_for_node(dom_node_document(this.dom_node()), this.dom_node(), DomUpdateLayoutReason.html_image_element_height)

    # Return the rendered height of the image, in CSS pixels, if the image is being rendered.
    if let paintable_box = dom_node_paintable_box(this.dom_node()):
        return (u32)paint_paintable_box_content_height(paintable_box).to_int()

    # On setting [the width or height IDL attribute], they must act as if they reflected the respective content attributes of the same name.
    if let height_attr = dom_element_get_attribute(this.dom_element(), html_attribute_names_height):
        if let converted = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&height_attr)):
            if converted <= 2147483647:
                return converted

    # ...or else the density-corrected intrinsic height and height of the image, in CSS pixels,
    # if the image has intrinsic dimensions and is available but not being rendered.
    if let bitmap = layout_image_provider_current_image_bitmap(&this.image_provider):
        return (u32)gfx.immutable_bitmap_height(bitmap)

    # ...or else 0, if the image is not available or does not have intrinsic dimensions.
    return 0

