#==============================================================================================
#
#   html_image_element_1 - HTML::HTMLImageElement: construction, hints, image provider, IDL
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLImageElement.cpp (lines 1-571) and the inline functions of
#       HTMLImageElement.h: the batching dispatcher of successfully fetched images, the
#       constructor (which moves the mixin tables to HTMLImageElement's, as C++'s vptrs move,
#       and registers the element as a viewport client), initialize, finalize, adopting,
#       visit_edges, the dimension attribute source, the presentational hints, the attribute
#       change steps, the ImageBox layout node, the Layout::ImageProvider overrides, the
#       width/height/naturalWidth/naturalHeight/x/y/complete/currentSrc IDL attributes,
#       decode() and the default role. html_image_element_2 has "update the image data",
#       html_image_element_3 the environment changes, source sets and animation.
#
#==============================================================================================

# mark: The batching dispatcher =================================================================

# We batch handling of successfully fetched images to avoid interleaving 1 image, 1 layout, 1 image, 1 layout, etc.
# The processing timer is 1ms instead of 0ms, since layout is driven by a 0ms timer, and if we use 0ms here,
# the event loop will process them in insertion order. This is a bit of a hack, but it works.

## The timer's handler: `[this] { process(); }`.
func html_batching_dispatcher_on_timer(context: void*?):
    html_batching_dispatcher_process((HtmlBatchingDispatcher*)(context else trap("no dispatcher")))

## Ported from HTMLImageElement.cpp:56 Web::HTML::BatchingDispatcher::BatchingDispatcher.
pub func html_batching_dispatcher_construct(this: HtmlBatchingDispatcher*):
    this.m_timer = core_timer_create_single_shot(1, ak.Function0[unit](call = html_batching_dispatcher_on_timer, context = this))

## Ported from HTMLImageElement.cpp:61 Web::HTML::BatchingDispatcher::enqueue.
pub func html_batching_dispatcher_enqueue(this: HtmlBatchingDispatcher*, callback: gc.Function0[unit]*?):
    # NOTE: We don't want to flush the queue on every image load, since that would be slow.
    #       However, we don't want to keep growing the batch forever either.
    let max_loads_to_batch_before_flushing: usize = 16

    # (The dispatcher is a static, so its queue lives in the C heap; the roots keep the callbacks.)
    with memory.heap:
        ak.vector_append_t(&this.m_queue, gc.root_create(callback))
    if ak.vector_size(&this.m_queue) < max_loads_to_batch_before_flushing:
        core_timer_restart(this.m_timer)

## Ported from HTMLImageElement.cpp:73 Web::HTML::BatchingDispatcher::process.
pub func html_batching_dispatcher_process(this: HtmlBatchingDispatcher*):
    var queue = this.m_queue
    this.m_queue = ak.Vector[gc.Root[gc.Function0[unit]]]()
    for callback in &ak.vector_span(&queue):
        if let function = gc.root_cell(callback):
            ak.function0_call(&function.function)
    # The moved-from queue's roots and storage go with it.
    with memory.heap:
        for callback in &ak.vector_span(&queue):
            gc.root_release(callback)
        ak.vector_clear(&queue)

## The dispatcher (C++: a function-local static), made on first use in the C heap: a module
## global is not scanned by the collector.
var html_batching_dispatcher_s_dispatcher: HtmlBatchingDispatcher*?

## Ported from HTMLImageElement.cpp:84 Web::HTML::batching_dispatcher.
func html_batching_dispatcher() -> HtmlBatchingDispatcher*:
    if let dispatcher = html_batching_dispatcher_s_dispatcher:
        return dispatcher
    with memory.heap:
        var dispatcher: HtmlBatchingDispatcher = ---
        dispatcher.m_queue = ak.Vector[gc.Root[gc.Function0[unit]]]()
        let created = new HtmlBatchingDispatcher(m_timer = core_timer_create(), m_queue = dispatcher.m_queue) else trap("out of memory")
        html_batching_dispatcher_construct(created)
        html_batching_dispatcher_s_dispatcher = created
    return html_batching_dispatcher_s_dispatcher else trap("the batching dispatcher")

# mark: Construction ============================================================================

## The element of its Layout::ImageProvider base (C++'s `this` adjustment).
func html_image_element_from_image_provider(base: LayoutImageProvider*) -> HtmlImageElement*:
    return (HtmlImageElement*)((u8*)base - offsetof(HtmlImageElement, image_provider))

## The animation timer's handler: `[this] { animate(); }`.
func html_image_element_on_animation_timer(context: void*?):
    html_image_element_animate((HtmlImageElement*)(context else trap("no image element")))

## Ported from HTMLImageElement.cpp:92 Web::HTML::HTMLImageElement::HTMLImageElement.
pub func html_image_element_construct(this: HtmlImageElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The Layout::ImageProvider and DOM::ViewportClient bases (no state) get their tables, then the
    # vptrs of the mixin bases move to HTMLImageElement's tables.
    this.image_provider.vtable = &html_image_element_image_provider_vtable
    this.image_provider.class_id = this.cell().class_id
    this.viewport_client.vtable = &html_image_element_viewport_client_vtable
    this.viewport_client.class_id = this.cell().class_id
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_image_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_image_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_image_element_animatable_vtable
    element.global_event_handlers.vtable = &html_image_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_image_element_form_associated_element_vtable
    # SourceSet m_source_set: a default-constructed source set.
    this.m_source_set = html_source_set_new()

    this.m_animation_timer = core_timer_create()
    let timer = this.m_animation_timer else trap("the animation timer")
    timer.on_timeout = ak.Function0[unit](call = html_image_element_on_animation_timer, context = this)

    dom_document_register_viewport_client(document, &this.viewport_client)

## Ported from HTMLImageElement.cpp:103 Web::HTML::HTMLImageElement::finalize (override).
pub func html_image_element_finalize_impl(base: gc.Cell*):
    let this = (HtmlImageElement*)base
    dom_node_finalize_impl(base)
    dom_document_unregister_viewport_client(dom_node_document(this.dom_node()), &this.viewport_client)

## The document observer's document_became_inactive callback (its context is the element).
func html_image_element_document_became_inactive(context: void*?):
    let this = (HtmlImageElement*)(context else trap("no image element"))
    html_image_element_clear_load_event_delayer(this)
    core_timer_stop(this.m_animation_timer else trap("the animation timer"))

## Ported from HTMLImageElement.cpp:109 Web::HTML::HTMLImageElement::initialize (override).
pub func html_image_element_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (HtmlImageElement*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_image_element)
    html_element_initialize_impl(base, realm)

    let document = dom_node_document(this.dom_node())
    this.m_current_request = html_image_request_create(realm, dom_document_page(document))

    # AD-HOC: Create a DocumentObserver eagerly to handle document lifecycle changes.
    #         The document_became_inactive callback handles the navigation case by clearing the
    #         load event delayer and stopping the animation timer.
    #         A document_became_active callback is set lazily by update_the_image_data() when
    #         needed to restart image loading after the document becomes active again.
    let document_observer = realm_create_dom_document_observer(realm, realm, document)
    this.m_document_observer = document_observer
    dom_document_observer_set_document_became_inactive(document_observer, ak.Function0[unit](call = html_image_element_document_became_inactive, context = this))

## Ported from HTMLImageElement.cpp:128 Web::HTML::HTMLImageElement::adopted_from (override).
pub func html_image_element_adopted_from_impl(base: DomNode*, old_document: DomDocument*):
    let this = (HtmlImageElement*)base
    let document = dom_node_document(base)
    dom_document_unregister_viewport_client(old_document, &this.viewport_client)
    dom_document_register_viewport_client(document, &this.viewport_client)

    let document_observer = this.m_document_observer else trap("the document observer")
    dom_document_observer_set_document(document_observer, document)
    if not dom_document_is_fully_active(old_document) and dom_document_is_fully_active(document):
        if let callback = dom_document_observer_document_became_active(document_observer):
            ak.function0_call(&callback.function)

## Ported from HTMLImageElement.cpp:140 Web::HTML::HTMLImageElement::visit_edges (override).
pub func html_image_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlImageElement*)base
    html_element_visit_edges_impl(base, visitor)
    layout_image_provider_image_provider_visit_edges(&this.image_provider, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_current_request)
    gc.cell_visitor_visit_t(visitor, this.m_pending_request)
    gc.cell_visitor_visit_t(visitor, this.m_document_observer)
    gc.cell_visitor_visit_t(visitor, this.m_dimension_attribute_source)
    html_lazy_loading_element_visit_lazy_loading_element(this, visitor)

## `m_load_event_delayer.clear()`: destroys a held delayer.
func html_image_element_clear_load_event_delayer(this: HtmlImageElement*):
    if let delayer = this.m_load_event_delayer:
        var released = delayer
        dom_document_load_event_delayer_destruct(&released)
    this.m_load_event_delayer = none

