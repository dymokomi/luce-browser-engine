## The scroll offset of a paintable box's enclosing scroll frame (x() and y()).
func html_image_element_scroll_offset(paintable_box: PaintPaintableBox*) -> gfx.CssPixelPoint:
    let idx = paint_paintable_box_enclosing_scroll_frame_index(paintable_box)
    if idx != 0:
        let viewport_paintable = dom_document_paintable(paint_paintable_document(paintable_box.paint_paintable())) else trap("the document's paintable")
        let scroll_state = paint_viewport_paintable_scroll_state(viewport_paintable)
        return display_list.scroll_state_cumulative_offset(&scroll_state, idx)
    return gfx.CssPixelPoint()

## Ported from HTMLImageElement.cpp:381 Web::HTML::HTMLImageElement::x.
# https://drafts.csswg.org/cssom-view/#dom-htmlimageelement-x
pub func html_image_element_x(this: HtmlImageElement*) -> i32:
    # The x attribute, on getting, must return the scaled x-coordinate of the left border edge of the first box
    # associated with the element, relative to the initial containing block origin, ignoring any transforms that apply
    # to the element and its ancestors, or zero if there is no box.
    dom_document_update_layout_if_needed_for_node(dom_node_document(this.dom_node()), this.dom_node(), DomUpdateLayoutReason.html_image_element_x)

    let paintable_box = dom_node_paintable_box(this.dom_node()) else return 0

    let scroll_offset = html_image_element_scroll_offset(paintable_box)
    let scroll_offset_x = gfx.css_pixel_point_x(&scroll_offset)

    let rect = paint_paintable_box_absolute_border_box_rect(paintable_box)
    return gfx.css_pixel_rect_x(&rect).sub(scroll_offset_x).to_int()

## Ported from HTMLImageElement.cpp:400 Web::HTML::HTMLImageElement::y.
# https://drafts.csswg.org/cssom-view/#dom-htmlimageelement-y
pub func html_image_element_y(this: HtmlImageElement*) -> i32:
    # The y attribute, on getting, must return the scaled y-coordinate of the top border edge of the first box
    # associated with the element, relative to the initial containing block origin, ignoring any transforms that apply
    # to the element and its ancestors, or zero if there is no box.
    dom_document_update_layout_if_needed_for_node(dom_node_document(this.dom_node()), this.dom_node(), DomUpdateLayoutReason.html_image_element_y)

    let paintable_box = dom_node_paintable_box(this.dom_node()) else return 0

    let scroll_offset = html_image_element_scroll_offset(paintable_box)
    let scroll_offset_y = gfx.css_pixel_point_y(&scroll_offset)

    let rect = paint_paintable_box_absolute_border_box_rect(paintable_box)
    return gfx.css_pixel_rect_y(&rect).sub(scroll_offset_y).to_int()

## Ported from HTMLImageElement.cpp:419 Web::HTML::HTMLImageElement::complete.
# https://html.spec.whatwg.org/multipage/embedded-content.html#dom-img-complete
pub func html_image_element_complete(this: HtmlImageElement*) -> bool:
    let element = this.dom_element()
    # The IDL attribute complete must return true if any of the following conditions is true:

    # - Both the src attribute and the srcset attribute are omitted.
    if not dom_element_has_attribute(element, html_attribute_names_src) and not dom_element_has_attribute(element, html_attribute_names_srcset):
        return true

    # - The srcset attribute is omitted and the src attribute's value is the empty string.
    if not dom_element_has_attribute(element, html_attribute_names_srcset):
        let src = dom_element_attribute(element, html_attribute_names_src) else trap("VERIFY: Optional::value() of the src attribute")
        if ak.string_is_empty(&src):
            return true

    # - The img element's current request's state is completely available and its pending request is null.
    let current_request = html_image_element_current_request(this)
    if html_image_request_state(current_request) == HtmlImageRequestState.completely_available and this.m_pending_request == none:
        return true

    # - The img element's current request's state is broken and its pending request is null.
    if html_image_request_state(current_request) == HtmlImageRequestState.broken and this.m_pending_request == none:
        return true

    return false

## Ported from HTMLImageElement.cpp:443 Web::HTML::HTMLImageElement::current_src.
# https://html.spec.whatwg.org/multipage/embedded-content.html#dom-img-currentsrc
pub func html_image_element_current_src(this: HtmlImageElement*) -> ak.String:
    # The currentSrc IDL attribute must return the img element's current request's current URL.
    return html_image_request_current_url(html_image_element_current_request(this))

# mark: decode() ================================================================================

## The state decode()'s microtask and callbacks share: `[this, promise, &realm]`, the relevant
## global, and (for the callbacks) the expected request and a weak element.
struct HtmlImageElementDecode:
    var this: HtmlImageElement*
    var promise: JsPromiseCapability*
    var realm: Realm*
    var global: JsObject*?
    var expected_request: HtmlImageRequest*?
    var weak_this: gc.Weak[HtmlImageElement]
    var message: ak.Utf16String

    ## reject_promise: reject the promise with an "EncodingError" DOMException.
    static func reject_promise(captures: HtmlImageElementDecode*, message: ak.Utf16String):
        let exception = idl_encoding_error_create(captures.realm, message)
        var context: HtmlTemporaryExecutionContext = ---
        html_temporary_execution_context_construct_realm(&context, captures.realm)
        defer html_temporary_execution_context_destruct(&context)
        idl_reject_promise(captures.realm, captures.promise, bind_platform_object_wrapper(exception.bind_platform_object()))

    ## queue_reject_task: a global task that rejects with `message`.
    static func queue_reject_task(captures: HtmlImageElementDecode*, message: ak.Utf16String):
        let task_captures = new HtmlImageElementDecode(this = captures.this, promise = captures.promise, realm = captures.realm, global = captures.global, expected_request = captures.expected_request, weak_this = captures.weak_this, message = message) else trap("out of memory")
        discard(html_queue_global_task(HtmlTaskSource.dom_manipulation, captures.global else trap("the relevant global"), gc.create_function0(realm_heap(captures.realm), ak.Function0[unit](call = HtmlImageElementDecode.reject_task, context = task_captures))))

    ## The rejecting global task: `[reject_promise, message = message] { reject_promise(message); }`.
    static func reject_task(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        HtmlImageElementDecode.reject_promise(captures, captures.message)

    ## queue_resolve_task: a global task that resolves the promise with undefined.
    static func queue_resolve_task(captures: HtmlImageElementDecode*):
        discard(html_queue_global_task(HtmlTaskSource.dom_manipulation, captures.global else trap("the relevant global"), gc.create_function0(realm_heap(captures.realm), ak.Function0[unit](call = HtmlImageElementDecode.resolve_task, context = captures))))

    ## The resolving global task.
    static func resolve_task(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        var execution_context: HtmlTemporaryExecutionContext = ---
        html_temporary_execution_context_construct_realm(&execution_context, captures.realm)
        defer html_temporary_execution_context_destruct(&execution_context)
        idl_resolve_promise(captures.realm, captures.promise, js_undefined())

    ## The microtask of step 2.
    static func microtask(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        let this = captures.this

        # 1. Let global be this's relevant global object.
        captures.global = html_relevant_global_object((JsObject*)this)

        # 2. If any of the following are true:
        #    - this's node document is not fully active;
        if not dom_document_is_fully_active(dom_node_document(this.dom_node())):
            # then reject promise with an "EncodingError" DOMException.
            HtmlImageElementDecode.reject_promise(captures, ak.utf16_string_from_str("Node document not fully active"))
            return

        #    - or this's current request's state is broken,
        let current_request = html_image_element_current_request(this)
        if html_image_request_state(current_request) == HtmlImageRequestState.broken:
            # then reject promise with an "EncodingError" DOMException.
            HtmlImageElementDecode.reject_promise(captures, ak.utf16_string_from_str("Current request state is broken"))
            return

        captures.expected_request = this.m_current_request
        captures.weak_this = gc.make_weak(this)

        # 3. Otherwise, in parallel wait for one of the following cases to occur, and perform the corresponding actions:
        if html_image_request_state(current_request) == HtmlImageRequestState.completely_available:
            HtmlImageElementDecode.queue_resolve_task(captures)
            return

        html_image_request_add_callbacks(current_request, ak.Function0[unit](call = HtmlImageElementDecode.on_finish, context = captures), ak.Function0[unit](call = HtmlImageElementDecode.on_fail, context = captures))

    ## The request's on_finish callback.
    static func on_finish(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        # AD-HOC: Enqueue on the batching dispatcher to preserve ordering relative to update_the_image_data's step
        #         16, which also goes through the batching dispatcher. Otherwise decode() can resolve before the
        #         current request transitions to CompletelyAvailable, leaving the image dimensions at zero when
        #         callers inspect them.
        html_batching_dispatcher_enqueue(html_batching_dispatcher(), gc.create_function0(realm_heap(captures.realm), ak.Function0[unit](call = HtmlImageElementDecode.on_finish_batched, context = captures)))

    ## The batched part of on_finish.
    static func on_finish_batched(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        if gc.weak_ptr(&captures.weak_this) == none:
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Image element no longer available"))
            return
        let image = gc.weak_ptr(&captures.weak_this) else trap("VERIFY_NOT_REACHED")

        if not dom_document_is_fully_active(dom_node_document(image.dom_node())):
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Node document not fully active"))
            return
        if image.m_current_request != captures.expected_request:
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Current request changed or was mutated"))
            return
        if html_image_request_state(html_image_element_current_request(image)) == HtmlImageRequestState.broken:
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Current request state is broken"))
            return
        HtmlImageElementDecode.queue_resolve_task(captures)

    ## The request's on_fail callback.
    static func on_fail(context: void*?):
        let captures = (HtmlImageElementDecode*)(context else trap("decode: no captures"))
        if gc.weak_ptr(&captures.weak_this) == none:
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Image element no longer available"))
            return
        let image = gc.weak_ptr(&captures.weak_this) else trap("VERIFY_NOT_REACHED")

        if not dom_document_is_fully_active(dom_node_document(image.dom_node())):
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Node document not fully active"))
            return

        if image.m_current_request != captures.expected_request:
            HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Current request changed or was mutated"))
            return
        HtmlImageElementDecode.queue_reject_task(captures, ak.utf16_string_from_str("Current request state is broken"))

## Ported from HTMLImageElement.cpp:450 Web::HTML::HTMLImageElement::decode.
# https://html.spec.whatwg.org/multipage/embedded-content.html#dom-img-decode
pub func html_image_element_decode(this: HtmlImageElement*) -> JsPromiseCapability*!:
    let realm = html_element_realm(this.html_element())

    # 1. Let promise be a new promise.
    let promise = idl_create_promise(realm)

    # 2. Queue a microtask to perform the following steps:
    let captures = new HtmlImageElementDecode(this = this, promise = promise, realm = realm, global = none, expected_request = none, weak_this = gc.Weak[HtmlImageElement](), message = ak.utf16_string_from_str("")) else trap("out of memory")
    html_queue_a_microtask(dom_node_document(this.dom_node()), gc.create_function0(realm_heap(realm), ak.Function0[unit](call = HtmlImageElementDecode.microtask, context = captures)))

    # 3. Return promise.
    return promise

## Ported from HTMLImageElement.cpp:558 Web::HTML::HTMLImageElement::default_role (override).
pub func html_image_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    let this = (HtmlImageElement*)dom_element_from_aria_mixin(base)
    # https://www.w3.org/TR/html-aria/#el-img
    # https://www.w3.org/TR/html-aria/#el-img-no-alt
    # https://w3c.github.io/aria/#image
    # NOTE: The "image" role value is a synonym for the older "img" role value; however, the el-img test in
    #       https://wpt.fyi/results/html-aam/roles.html expects the value to be "image" (not "img").
    let alt = html_image_element_alt(this)
    if not ak.string_is_empty(&alt):
        return AriaRole.image
    # https://www.w3.org/TR/html-aria/#el-img-empty-alt
    # NOTE: The "none" role value is a synonym for the older "presentation" role value; however, the el-img-alt-no-value
    #       test in https://wpt.fyi/results/html-aam/roles.html expects the value to be "none" (not "presentation").
    return AriaRole.none_

