    return html_form_associated_element_suffering_from_a_custom_error(this.m_control)

## Ported from ValidityState.cpp:110 Web::HTML::ValidityState::valid.
# https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#dom-validitystate-valid
pub func html_validity_state_valid(this: HtmlValidityState*) -> bool:
    return not (html_validity_state_value_missing(this) or html_validity_state_type_mismatch(this) or html_validity_state_pattern_mismatch(this) or html_validity_state_too_long(this) or html_validity_state_too_short(this) or html_validity_state_range_underflow(this) or html_validity_state_range_overflow(this) or html_validity_state_step_mismatch(this) or html_validity_state_bad_input(this) or html_validity_state_custom_error(this))
