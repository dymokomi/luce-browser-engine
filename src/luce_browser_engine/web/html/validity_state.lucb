#==============================================================================================
#
#   validity_state - HTML::ValidityState: the live validity states of a form control
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/ValidityState.cpp (lines 1-115): creation, initialize, visit_edges
#       and the eleven getters, each the matching "suffering from" state of the control.
#
#       The C++ member is `FormAssociatedElement const&`; the port keeps the mixin pointer
#       (HtmlFormAssociatedElement*) and visits the HTML element it lives in, as C++ does.
#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from ValidityState.cpp:16 Web::HTML::ValidityState::create.
pub func html_validity_state_create(realm: Realm*, control: HtmlFormAssociatedElement*) -> HtmlValidityState*:
    return realm_create_html_validity_state(realm, realm, control)

## Ported from ValidityState.cpp:21 Web::HTML::ValidityState::ValidityState.
pub func html_validity_state_construct(this: HtmlValidityState*, realm: Realm*, control: HtmlFormAssociatedElement*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_control = control

## Ported from ValidityState.cpp:27 Web::HTML::ValidityState::initialize (override).
pub func html_validity_state_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.validity_state)
    # Base::initialize(realm): PlatformObject inherits JS::Object's.
    js_cell_initialize_impl(base, realm)

## Ported from ValidityState.cpp:33 Web::HTML::ValidityState::visit_edges (override).
pub func html_validity_state_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlValidityState*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t[HtmlElement](visitor, html_form_associated_element_form_associated_element_to_html_element_const(this.m_control))

# mark: The validity states =====================================================================

## Ported from ValidityState.cpp:40 Web::HTML::ValidityState::value_missing.
# https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#dom-validitystate-valuemissing
pub func html_validity_state_value_missing(this: HtmlValidityState*) -> bool:
    # The control is suffering from being missing.
    return html_form_associated_element_suffering_from_being_missing(this.m_control)

## Ported from ValidityState.cpp:47 Web::HTML::ValidityState::type_mismatch.
