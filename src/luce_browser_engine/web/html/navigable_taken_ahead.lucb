## Ported from Libraries/LibWeb/HTML/Navigable.cpp:567 Web::HTML::Navigable::container.
pub func html_navigable_container(this: HtmlNavigable*) -> HtmlNavigableContainer*?:
    # The container of a navigable navigable is the navigable container whose nested navigable is navigable, or null if there is no such element.
    return html_navigable_container_navigable_container_with_content_navigable(this)

## Ported from Libraries/LibWeb/HTML/Navigable.h:194 Web::HTML::Navigable::viewport_rect.
pub func html_navigable_viewport_rect(this: HtmlNavigable*) -> gfx.CssPixelRect:
    var rect: gfx.CssPixelRect = ---
    gfx.css_pixel_rect_construct_css_pixel_point(&rect, this.m_viewport_scroll_offset, this.m_viewport_size)
    return rect
