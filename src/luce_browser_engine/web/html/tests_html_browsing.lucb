#==============================================================================================
#
#   tests_html_browsing - region r28's tests: a top-level traversable for a test page and a
#   document initialized for it end to end (its Window, WindowProxy, browsing context and
#   realm), base URLs, a connected style sheet through the cascade, and a collection over a
#   page with its window and document
#
#   DESCRIPTION:
#       The scenarios follow what Ladybird does for a page's first navigation: create a new
#       top-level traversable (its browsing context and initial about:blank document), then
#       Document::create_and_initialize for a response of the navigation, which creates the
#       realm whose global object is a new Window and whose global this value is the browsing
#       context's WindowProxy.
#
#==============================================================================================

# mark: Helpers =================================================================================

## A response of a navigation to `url`, as Fetch would deliver it: its URL list « url » and a
## `Content-Type: text/html` header.
func test_browsing_response(vm: Vm*, url: str) -> FetchResponse*:
    let response = fetch_infrastructure_response_create(vm)
    ak.vector_append_t(fetch_response_url_list(response), domurl_parse(ak.sv(url)) else trap("the test URL parses"))
    http_header_list_append(fetch_response_header_list(response), ak.sv("Content-Type"), ak.sv("text/html"))
    return response

## Navigation params for a response of `navigable`, as Navigable::populate_session_history_entry
## makes them for a fetched response: the response's origin, a new policy container, no sandboxing.
func test_browsing_navigation_params(vm: Vm*, navigable: HtmlNavigable*, response: FetchResponse*) -> HtmlNavigationParams*:
    let heap = vm_heap(vm)
    let response_url = fetch_response_url(response) else trap("the response has no URL")
    let origin = web_url.url_origin(&response_url)
    let coop = HtmlOpenerPolicy()
    let coop_enforcement_result = HtmlOpenerPolicyEnforcementResult(url = response_url, origin = origin, opener_policy = coop)
    let policy_container = heap_allocate_html_policy_container(heap)
    return heap_allocate_html_navigation_params(heap, ak.string_from_str("test-navigation"), navigable, none, response, none, none, coop_enforcement_result, none, origin, policy_container, (HtmlSandboxingFlagSet)0, coop, none, HtmlUserNavigationInvolvement.none_)

## A page of `vm` with a new top-level traversable (Page::set_top_level_traversable as the
## embedder's create_a_fresh_top_level_traversable does).
func test_browsing_page_with_traversable(vm: Vm*) -> (Page*, HtmlTraversableNavigable*):
    let page = web_test_create_page(vm)
    test_fonts_setup()
    let traversable = html_traversable_navigable_create_a_new_top_level_traversable(page, none, ak.String())
    page_set_top_level_traversable(page, traversable)
    return (page, traversable)

# mark: Document::create_and_initialize =========================================================

test "Document::create_and_initialize: a P1 HTML document with its Window, WindowProxy, browsing context and realm":
    web_initialize_strings()
    let vm = web_test_create_vm()
    defer web_test_destroy_vm(vm)
    discard(web_test_install_agent(vm))
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let (page, traversable) = test_browsing_page_with_traversable(vm)
        let navigable = traversable.html_navigable()

        # The traversable is top-level, on its page, with a browsing context whose initial
        # about:blank document is its active document.
        assert(html_navigable_is_top_level_traversable(navigable))
        assert(html_navigable_page(navigable) == page)
        let browsing_context = html_navigable_active_browsing_context(navigable) else trap("no active browsing context")
        assert(html_browsing_context_is_top_level(browsing_context))
        let initial_document = html_navigable_active_document(navigable) else trap("no active document")
        assert(dom_document_is_initial_about_blank(initial_document))
        assert(test_html_string_is(dom_document_url_string(initial_document), "about:blank"))
        let initial_window = html_navigable_active_window(navigable) else trap("no active window")
        assert(html_window_associated_document(initial_window) == initial_document)
        assert(page_top_level_traversable(page) == traversable)

        # Initialize a document for a navigation response.
        let response = test_browsing_response(vm, "https://example.com/dir/page.html")
        let params = test_browsing_navigation_params(vm, navigable, response)
        let document = dom_document_create_and_initialize(DocumentDomDocumentType.html, ak.string_from_str("text/html"), params) else trap("create_and_initialize threw")

        assert(test_html_string_is(dom_document_url_string(document), "https://example.com/dir/page.html"))
        assert(test_html_string_is(dom_document_content_type(document), "text/html"))
        assert(dom_document_browsing_context(document) == browsing_context)
        assert(dom_document_page(document) == page)
        assert(document.m_readiness == HtmlDocumentReadyState.loading)

        # Its window: a new Window of a new realm, whose associated Document is the document.
        let window = dom_document_window(document) else trap("no window")
        assert(window != initial_window)
        assert(html_window_associated_document(window) == document)
        assert(html_relevant_realm((JsObject*)document) == bind_platform_object_realm(window.bind_platform_object()))
        let realm = bind_platform_object_realm(window.bind_platform_object())
        assert(realm_global_object(realm) == (JsObject*)window)

        # The realm's global this value is the browsing context's WindowProxy.
        let window_proxy = html_browsing_context_window_proxy(browsing_context) else trap("no WindowProxy")
        assert(html_window_window(window) == window_proxy)
        assert(html_window_self(window) == window_proxy)
        assert(html_window_frames(window) == window_proxy)

        # The window's settings object answers from the document.
        let settings = html_relevant_settings_object_js_object((JsObject*)window)
        assert(html_environment_settings_object_responsible_document(settings) == document)
        let api_base_url = html_environment_settings_object_api_base_url(settings)
        assert(test_html_string_is(web_url.url_serialize(&api_base_url), "https://example.com/dir/page.html"))
        let document_origin = dom_document_origin(document)
        assert(web_url.origin_is_same_origin(&document_origin, html_environment_settings_object_origin(settings)))

        # The document has a new, global CustomElementRegistry.
        assert(html_is_a_global_custom_element_registry(dom_document_custom_element_registry(document)))
        assert((HtmlCustomElementRegistry*?)html_window_custom_elements(window) == dom_document_custom_element_registry(document))

        # The window's navigable is the traversable once the document is its active document;
        # until then it is the initial document's.
        assert(html_window_navigable(initial_window) == (HtmlNavigable*?)navigable)

        # Navigating to a URL fetches it, which is phase 2: the documents of phase 1 come from
        # responses made as above (a srcdoc iframe's, an embedder's) or from about:blank.
        assert(test_page_still_unported("stub_closure.lucb", "Web::Fetch::Fetching::fetch"))
