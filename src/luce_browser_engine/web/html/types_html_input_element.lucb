## is<Web::HTML::HTMLInputElement>: the class-id range test.
pub func is_html_input_element[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= html_input_element_class.first_id and id <= html_input_element_class.last_id

## as_if<Web::HTML::HTMLInputElement>.
pub func as_if_html_input_element[P: gc.IsCell](p: P*) -> HtmlInputElement*?:
    if is_html_input_element(p): return (HtmlInputElement*)p
    return none

## as<Web::HTML::HTMLInputElement> (verify_cast).
pub func as_html_input_element[P: gc.IsCell](p: P*) -> HtmlInputElement*:
    return as_if_html_input_element(p) else trap("as<Web::HTML::HTMLInputElement> failed")

## realm.create<Web::HTML::HTMLInputElement>(...): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_html_input_element(realm: Realm*, document: DomDocument*, qualified_name: DomQualifiedName) -> HtmlInputElement*:
    let this = (HtmlInputElement*)web_allocate_cell(realm, &html_input_element_class)
    html_input_element_construct(this, document, qualified_name)
    web_initialize_cell(this.cell(), realm)
    return this

