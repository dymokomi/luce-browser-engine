#==============================================================================================
#
#   tag_names - HTML::TagNames: the local names of the HTML elements
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/TagNames.cpp (lines 1-16) with TagNames.h's
#       ENUMERATE_HTML_TAGS. C++ initializes the FlyStrings statically; here
#       html_tag_names_initialize_strings interns them at run time and web_initialize_strings
#       runs it at startup (DESIGN.md §2.6). Ported with region r21 because the HTML parser
#       compares tag and attribute names against them; the owning region keeps the rest of its
#       file.
#
#==============================================================================================

## Whether html_tag_names_initialize_strings has run.
var html_tag_names_strings_initialized: bool

## Ported from Libraries/LibWeb/HTML/TagNames.cpp:11 the definitions of Web::HTML::TagNames's FlyStrings
## (`FlyString name = tag##_fly_string;` for each ENUMERATE_HTML_TAGS entry).
pub func html_tag_names_initialize_strings():
    if html_tag_names_strings_initialized:
        return
    html_tag_names_a = ak.fly_string_from_str("a")
