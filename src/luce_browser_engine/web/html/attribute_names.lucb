#==============================================================================================
#
#   attribute_names - HTML::AttributeNames: the names of the HTML attributes
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/AttributeNames.cpp (lines 1-67) with AttributeNames.h's
#       ENUMERATE_HTML_ATTRIBUTES. C++ initializes the FlyStrings statically; here
#       html_attribute_names_initialize_strings interns them at run time and
#       web_initialize_strings runs it at startup (DESIGN.md §2.6). The FlyStrings were ported
#       with region r21 (the HTML parser compares attribute names against them);
#       is_boolean_attribute with region r22.
#
#==============================================================================================

## Whether html_attribute_names_initialize_strings has run.
var html_attribute_names_strings_initialized: bool

## Ported from Libraries/LibWeb/HTML/AttributeNames.cpp:12 the definitions of Web::HTML::AttributeNames's FlyStrings
## (`FlyString name = attribute##_fly_string;` for each ENUMERATE_HTML_ATTRIBUTES entry).
