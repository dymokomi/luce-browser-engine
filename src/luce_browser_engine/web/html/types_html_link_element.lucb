## is<Web::HTML::HTMLLinkElement>: the class-id range test.
pub func is_html_link_element[P: gc.IsCell](p: P*) -> bool:
    let id = p.cell().class_id
    return id >= html_link_element_class.first_id and id <= html_link_element_class.last_id

## as_if<Web::HTML::HTMLLinkElement>.
pub func as_if_html_link_element[P: gc.IsCell](p: P*) -> HtmlLinkElement*?:
    if is_html_link_element(p): return (HtmlLinkElement*)p
    return none

