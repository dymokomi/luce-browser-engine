    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><body><div>Start free trial\n", css = "\n    * {\n        outline: 1px solid black;\n    }\n    body {\n        display: flex;\n        flex-direction: column;\n    }\n    div {\n        max-width: 100%;\n        height: 100px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 116 0+0+0] [BFC] children: not-inline\n      Box <body> at [8,8] flex-container(column) [8+0+0 784 0+0+8] [8+0+0 100 0+0+8] [FFC] children: not-inline\n        BlockContainer <div> at [8,8] flex-item [0+0+0 784 0+0+0] [0+0+0 100 0+0+0] [BFC] children: inline\n          frag 0 from TextNode start: 0, length: 16, rect: [8,8 126.390625x18] baseline: 13.796875\n              \"Start free trial\"\n          TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x116]\n      PaintableBox (Box<BODY>) [8,8 784x100]\n        PaintableWithLines (BlockContainer<DIV>) [8,8 784x100]\n          TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x116] [children: 0] (z-index: auto)\n"),
