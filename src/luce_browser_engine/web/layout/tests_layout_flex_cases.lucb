    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><body class=\"flex\"><div class=\"item\">hello", css = "\n* { border: 1px solid black; }\nhtml { background: white; }\n.flex {\n    width: max-content;\n    display: flex;\n    background: pink;\n    height: 50px;\n}\n.item {\n    flex-basis: 1px;\n    background: orange;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 68 0+1+0] [BFC] children: not-inline\n      Box <body.flex> at [10,10] flex-container(row) [8+1+0 38.84375 0+1+749.15625] [8+1+0 50 0+1+8] [FFC] children: not-inline\n        BlockContainer <div.item> at [11,11] flex-item [0+1+0 36.84375 0+1+0] [0+1+0 48 0+1+0] [BFC] children: inline\n          frag 0 from TextNode start: 0, length: 5, rect: [11,11 36.84375x18] baseline: 13.796875\n              \"hello\"\n          TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x70]\n      PaintableBox (Box<BODY>.flex) [9,9 40.84375x52]\n        PaintableWithLines (BlockContainer<DIV>.item) [10,10 38.84375x50]\n          TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x68] [children: 0] (z-index: auto)\n"),
