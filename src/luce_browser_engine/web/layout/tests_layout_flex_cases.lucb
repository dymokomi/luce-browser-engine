    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><div class=\"flexbox\"><div></div><div></div><div></div>", css = "\n* {\n    border: 1px solid black;\n}\n.flexbox {\n    display: flex;\n    flex-direction: column;\n    flex-wrap: wrap;\n    width: 200px;\n}\n.flexbox > div {\n    width: 50px;\n    height: 50px;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 176 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 158 0+1+8] children: not-inline\n        Box <div.flexbox> at [11,11] flex-container(column) [0+1+0 200 0+1+578] [0+1+0 156 0+1+0] [FFC] children: not-inline\n          BlockContainer <div> at [12,12] flex-item [0+1+0 50 0+1+0] [0+1+0 50 0+1+0] [BFC] children: not-inline\n          BlockContainer <div> at [12,64] flex-item [0+1+0 50 0+1+0] [0+1+0 50 0+1+0] [BFC] children: not-inline\n          BlockContainer <div> at [12,116] flex-item [0+1+0 50 0+1+0] [0+1+0 50 0+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x178]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x160]\n        PaintableBox (Box<DIV>.flexbox) [10,10 202x158]\n          PaintableWithLines (BlockContainer<DIV>) [11,11 52x52]\n          PaintableWithLines (BlockContainer<DIV>) [11,63 52x52]\n          PaintableWithLines (BlockContainer<DIV>) [11,115 52x52]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x176] [children: 0] (z-index: auto)\n"),
