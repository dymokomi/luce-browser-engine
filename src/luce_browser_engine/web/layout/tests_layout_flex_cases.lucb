    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><body><div class=\"right\">right</div><div class=\"flex\"><div class=\"item\">item", css = "\n    * { outline: 1px solid black; }\n    body { width: 400px; }\n    .right {\n        float: right;\n        background: orange;\n    }\n    .flex { \n        display: flex;\n        height: 50px;\n        background: wheat;\n    }\n    .item { background: pink; }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 66 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 400 0+0+392] [8+0+0 50 0+0+8] children: not-inline\n        BlockContainer <div.right> at [370.890625,8] floating [0+0+0 37.109375 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n          frag 0 from TextNode start: 0, length: 5, rect: [370.890625,8 37.109375x18] baseline: 13.796875\n              \"right\"\n          TextNode <#text> (not painted)\n        Box <div.flex> at [8,8] flex-container(row) [0+0+0 362.890625 0+0+0] [0+0+0 50 0+0+0] [FFC] children: not-inline\n          BlockContainer <div.item> at [8,8] flex-item [0+0+0 32.34375 0+0+0] [0+0+0 50 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 4, rect: [8,8 32.34375x18] baseline: 13.796875\n                \"item\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x66]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 400x50]\n        PaintableWithLines (BlockContainer<DIV>.right) [370.890625,8 37.109375x18]\n          TextPaintable (TextNode<#text>)\n        PaintableBox (Box<DIV>.flex) [8,8 362.890625x50]\n          PaintableWithLines (BlockContainer<DIV>.item) [8,8 32.34375x50]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-inde