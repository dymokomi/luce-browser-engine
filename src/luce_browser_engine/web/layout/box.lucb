# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/Layout/Box.cpp:20 Web::Layout::Box::Box.
pub func layout_box_construct_css_computed_properties(this: LayoutBox*, document: DomDocument*, node: DomNode*?, style: CssComputedProperties*):
    layout_node_with_style_and_box_model_metrics_construct_css_computed_properties(this.layout_node_with_style_and_box_model_metrics(), document, node, style)

## Ported from Libraries/LibWeb/Layout/Box.cpp:25 Web::Layout::Box::Box.
pub func layout_box_construct_css_computed_values(this: LayoutBox*, document: DomDocument*, node: DomNode*?, computed_values: CssComputedValues*):
