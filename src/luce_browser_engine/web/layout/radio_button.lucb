## Ported from Libraries/LibWeb/Layout/RadioButton.cpp:17 Web::Layout::RadioButton::RadioButton.
pub func layout_radio_button_construct(this: LayoutRadioButton*, document: DomDocument*, element: HtmlInputElement*, style: CssComputedProperties*):
    layout_replaced_box_construct(this.layout_replaced_box(), document, element.dom_element(), style)

## Ported from Libraries/LibWeb/Layout/RadioButton.h:23 Web::Layout::RadioButton::compute_auto_content_box_size (override).
pub func layout_radio_button_compute_auto_content_box_size_impl(base: LayoutBox*) -> CssSizeWithAspectRatio:
    discard(base)
    return CssSizeWithAspectRatio(width = gfx.CssPixels.from_int(12), height = gfx.CssPixels.from_int(12), aspect_ratio = none)

## Ported from Libraries/LibWeb/Layout/RadioButton.cpp:24 Web::Layout::RadioButton::create_paintable (override).
pub func layout_radio_button_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_radio_button_paintable_create((LayoutRadioButton*)base).paint_paintable()
