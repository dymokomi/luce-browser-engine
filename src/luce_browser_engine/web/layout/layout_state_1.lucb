    return rare.override_borders_data != none

## Ported from Libraries/LibWeb/Layout/LayoutState.h:289 Web::Layout::LayoutState::UsedValues::border_left_collapsed.
# Implement the collapsing border model https://www.w3.org/TR/CSS22/tables.html#collapsing-borders.
pub func layout_state_used_values_border_left_collapsed(this: const LayoutStateUsedValues*) -> gfx.CssPixels:
    return gfx.round(layout_div_int(this.border_left, 2)) if layout_state_used_values_use_collapsing_borders_model(this) else this.border_left

