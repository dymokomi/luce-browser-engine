## Ported from Libraries/LibWeb/Layout/LayoutState.h:305 Web::Layout::LayoutState::UsedValues::ensure_rare_data.
pub func layout_state_used_values_ensure_rare_data(this: LayoutStateUsedValues*) -> LayoutStateUsedValuesRareData*:
    if this.m_rare == none:
        this.m_rare = (new LayoutStateUsedValuesRareData) else trap("out of memory")
    return this.m_rare else trap("unreachable: the rare data was just made")

# mark: clamp_to_max_dimension_value ============================================================

## Ported from Libraries/LibWeb/Layout/LayoutState.h:352 Web::Layout::clamp_to_max_dimension_value.
pub func layout_clamp_to_max_dimension_value(value: gfx.CssPixels) -> gfx.CssPixels:
    if value.might_be_saturated():
        return gfx.CssPixels.from_f32(gfx.css_pixels_max_dimension_value)
    return value
