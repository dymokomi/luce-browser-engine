## Ported from Libraries/LibWeb/Layout/LayoutState.h:165 Web::Layout::LayoutState::UsedValues::cumulative_offset.
# Offset from ICB (viewport) content edge to this box's content edge.
# Computed lazily by walking the containing block chain.
# For pre-populated nodes (partial relayout), returns the cached value from paintable absolute position.
pub func layout_state_used_values_cumulative_offset(this: const LayoutStateUsedValues*) -> gfx.CssPixelPoint:
    if let cumulative_offset = this.m_cumulative_offset:
        return cumulative_offset
    if let containing_block_used_values = this.m_containing_block_used_values:
        let containing_block_offset = layout_state_used_values_cumulative_offset(containing_block_used_values)
        return gfx.css_pixel_point_add(&containing_block_offset, this.offset)
    return this.offset

