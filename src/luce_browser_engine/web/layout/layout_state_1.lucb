## Ported from Libraries/LibWeb/Layout/LayoutState.h:274 Web::Layout::LayoutState::UsedValues::static_position.
pub func layout_state_used_values_static_position(this: const LayoutStateUsedValues*) -> gfx.CssPixelPoint:
    let rare = this.m_rare else return gfx.CssPixelPoint()
    let static_position_rect = rare.static_position_rect else return gfx.CssPixelPoint()
    return layout_static_position_rect_aligned_position_for_box_with_size(&static_position_rect,
                                                                          gfx.CssPixelSize(layout_state_used_values_margin_box_width(this), layout_state_used_values_margin_box_height(this)))

