# mark: UsedValues' rare data ===================================================================

## Ported from Libraries/LibWeb/Layout/LayoutState.h:223 Web::Layout::LayoutState::UsedValues::add_floating_descendant.
pub func layout_state_used_values_add_floating_descendant(this: LayoutStateUsedValues*, box: LayoutBox*):
    discard(ak.hash_table_set(&layout_state_used_values_ensure_rare_data(this).floating_descendants, box))

## UsedValues::floating_descendants()'s `static HashTable<GC::Ptr<Box const>> const empty`.
var layout_state_used_values_no_floating_descendants: ak.HashTable[LayoutBox*, ak.PtrTraits[LayoutBox]]

## Ported from Libraries/LibWeb/Layout/LayoutState.h:224 Web::Layout::LayoutState::UsedValues::floating_descendants.
pub func layout_state_used_values_floating_descendants(this: const LayoutStateUsedValues*) -> const ak.HashTable[LayoutBox*, ak.PtrTraits[LayoutBox]]*:
    if let rare = this.m_rare:
        return &rare.floating_descendants
    return &layout_state_used_values_no_floating_descendants

