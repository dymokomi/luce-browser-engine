#==============================================================================================
#
#   layout_state_1 - Layout::LayoutState's inline members: the static position rectangle, the
#                    paged store of used values and UsedValues' accessors
#
#   DESCRIPTION:
#       Port of the inline members of LibWeb/Layout/LayoutState.h (lines 29-352):
#       StaticPositionRect::aligned_position_for_box_with_size, PagedStore (the two-level page
#       table that maps a layout index to its UsedValues), UsedValues' content size, definiteness,
#       box edges, rare data and collapsed borders, and clamp_to_max_dimension_value. Also the
#       CSSPixels / integer helpers the layout fragments of region r44 share.
#
#       PagedStore<T> is instantiated once, with T = LayoutState::UsedValues. A generic Luce body
#       cannot make T's zero value (`entry = T {}`, `make<Page>()`), so its members are written
#       for that instantiation; the iteration of `for_each(callback)` is an iterator loop
#       (DESIGN.md §2.9).
#
#       Copyright (c) 2022, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: CSSPixels arithmetic shared by the layout fragments ======================================

## `value / divisor` read as CSSPixels: `CSSPixels / int` is a CSSPixelFraction, converted by its operator CSSPixels.
func layout_div_int(value: gfx.CssPixels, divisor: i64) -> gfx.CssPixels:
    let fraction = gfx.div_css_pixels_int(value, divisor)
    return gfx.css_pixel_fraction_to_css_pixels(&fraction)

## `CSSPixels(0)`.
func layout_zero_px() -> gfx.CssPixels:
    return gfx.CssPixels.from_int(0)

# mark: StaticPositionRect ======================================================================

## Ported from Libraries/LibWeb/Layout/LayoutState.h:40 Web::Layout::StaticPositionRect::aligned_position_for_box_with_size.
pub func layout_static_position_rect_aligned_position_for_box_with_size(this: const LayoutStaticPositionRect*, size: gfx.CssPixelSize) -> gfx.CssPixelPoint:
    var position = gfx.css_pixel_rect_location(&this.rect)
    let rect_width = gfx.css_pixel_rect_width(&this.rect)
    let rect_height = gfx.css_pixel_rect_height(&this.rect)
    if this.horizontal_alignment == LayoutStaticPositionRectAlignment.center:
        gfx.css_pixel_point_set_x(&position, position.m_x.add(layout_div_int(rect_width.sub(size.m_width), 2)))
    elif this.horizontal_alignment == LayoutStaticPositionRectAlignment.end:
        gfx.css_pixel_point_set_x(&position, position.m_x.add(rect_width).sub(size.m_width))

    if this.vertical_alignment == LayoutStaticPositionRectAlignment.center:
        gfx.css_pixel_point_set_y(&position, position.m_y.add(layout_div_int(rect_height.sub(size.m_height), 2)))
    elif this.vertical_alignment == LayoutStaticPositionRectAlignment.end:
        gfx.css_pixel_point_set_y(&position, position.m_y.add(rect_height).sub(size.m_height))

    return position

# mark: PagedStore ==============================================================================

## PagedStore's PageBits: a page holds 1 << 4 entries.
let layout_paged_store_page_bits: u32 = 4

## PagedStore's PageSize.
let layout_paged_store_page_size: u32 = 1 << layout_paged_store_page_bits

## PagedStore's PageMask.
let layout_paged_store_page_mask: u32 = layout_paged_store_page_size - 1

## Ported from Libraries/LibWeb/Layout/LayoutState.h:73 Web::Layout::PagedStore::ensure_capacity.
pub func layout_paged_store_ensure_capacity(this: LayoutPagedStore[LayoutStateUsedValues]*, count: u32):
    ak.vector_resize(&this.m_pages, (usize)((count + layout_paged_store_page_size - 1) >> layout_paged_store_page_bits))

## Ported from Libraries/LibWeb/Layout/LayoutState.h:78 Web::Layout::PagedStore::get.
pub func layout_paged_store_get(this: const LayoutPagedStore[LayoutStateUsedValues]*, index: u32) -> LayoutStateUsedValues*?:
    let page_index = (usize)(index >> layout_paged_store_page_bits)
    if page_index >= ak.vector_size(&this.m_pages):
        return none
    let page = *ak.vector_at_const(&this.m_pages, page_index) else return none
    let entry_index = (usize)(index & layout_paged_store_page_mask)
    if not page.has_value[entry_index]:
        return none
    return &page.entries[entry_index]

## Ported from Libraries/LibWeb/Layout/LayoutState.h:92 Web::Layout::PagedStore::allocate.
pub func layout_paged_store_allocate(this: LayoutPagedStore[LayoutStateUsedValues]*, index: u32) -> LayoutStateUsedValues*:
    let page_index = (usize)(index >> layout_paged_store_page_bits)
    if page_index >= ak.vector_size(&this.m_pages):
        ak.vector_resize(&this.m_pages, page_index + 1)
    let slot = ak.vector_at(&this.m_pages, page_index)
    if *slot == none:
        *slot = (new LayoutPage[LayoutStateUsedValues]) else trap("out of memory")
    let page = *slot else trap("unreachable: the page was just made")
    let entry_index = (usize)(index & layout_paged_store_page_mask)
    # entry = T {};
    page.entries[entry_index] = LayoutStateUsedValues()
    page.has_value[entry_index] = true
    return &page.entries[entry_index]

## Ported from Libraries/LibWeb/Layout/LayoutState.h:106 Web::Layout::PagedStore::for_each: `for used_values in
## layout_paged_store_for_each(&store)` visits every allocated entry, page by page.
pub func layout_paged_store_for_each(this: LayoutPagedStore[LayoutStateUsedValues]*) -> LayoutPagedStoreEntries:
    return LayoutPagedStoreEntries(store = this)

## The entries of a PagedStore, as an iterable (PagedStore::for_each's loop).
pub struct LayoutPagedStoreEntries: luce.Iterable[LayoutStateUsedValues*, LayoutPagedStoreEntryIterator]:
    pub var store: LayoutPagedStore[LayoutStateUsedValues]*

    func iterator() -> LayoutPagedStoreEntryIterator:
        return LayoutPagedStoreEntryIterator(store = self.store, page_index = 0, entry_index = 0)

## The iterator of LayoutPagedStoreEntries: the allocated entries in page order.
pub struct LayoutPagedStoreEntryIterator: luce.Iterator[LayoutStateUsedValues*]:
    pub var store: LayoutPagedStore[LayoutStateUsedValues]*
    pub var page_index: usize
    pub var entry_index: usize

    mutating func next() -> LayoutStateUsedValues*?:
        while self.page_index < ak.vector_size(&self.store.m_pages):
            if let page = *ak.vector_at(&self.store.m_pages, self.page_index):
                while self.entry_index < (usize)layout_paged_store_page_size:
                    let index = self.entry_index
                    self.entry_index += 1
                    if page.has_value[index]:
                        return &page.entries[index]
            self.page_index += 1
            self.entry_index = 0
        return none

