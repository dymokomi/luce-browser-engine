#
#   viewport - Layout::Viewport: the root of the layout tree, the document's box
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/Viewport.cpp (lines 1-104) and Viewport.h: the constructor,
#       visit_edges, the ViewportPaintable, and the text blocks find-in-page searches (the
#       rendered text of each run of text nodes between boxes, with the offset of each node).
