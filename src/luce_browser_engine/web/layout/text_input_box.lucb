#==============================================================================================
#
#   text_input_box - Layout::TextInputBox: the box of a text-like <input>
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/TextInputBox.cpp (lines 1-30) and TextInputBox.h: its auto size
#       is `size` characters by one line (and the shadow tree's 2px padding).
