    TestLayoutTreeCase(mode = "tree", html = "<body><span>a<em>b<div>c</div>d</em>e<div>f</div></span>g</body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        BlockContainer <(anonymous)> (not painted) children: inline\n          InlineNode <span> (not painted)\n            TextNode <#text> (not painted)\n            InlineNode <em> (not painted)\n              TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: not-inline continuation\n          BlockContainer <div> (not painted) children: inline\n            TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: inline\n          InlineNode <span> (not painted) continuation\n            InlineNode <em> (not painted) continuation\n              TextNode <#text> (not painted)\n            TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: not-inline continuation\n          BlockContainer <div> (not painted) children: inline\n            TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: inline\n          InlineNode <span> (not painted) continuation\n          TextNode <#text> (not painted)\n"),
