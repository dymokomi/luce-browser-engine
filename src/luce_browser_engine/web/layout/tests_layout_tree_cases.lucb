#==============================================================================================
#
#   tests_layout_tree_cases - layout trees, node predicates, text chunks and list markers
#                             pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same documents (luce-browser-tools,
#       oracles/luce-browser-engine/layout_tree: cases.txt, oracle.cpp, gen_luce_cases.py,
#       build.sh). tests_layout_tree runs each case through the port and compares the output.
#
#==============================================================================================

## One oracle case: the mode, the document, its author style sheet, and the reference build's output.
struct TestLayoutTreeCase:
    let mode: str
    let html: str
    let css: str
    let expected: str

## Every oracle case, in cases.txt order (5 more, marked "!" in cases.txt, wait for other regions).
let test_layout_tree_cases: TestLayoutTreeCase[75] = [
    TestLayoutTreeCase(mode = "tree", html = "<!DOCTYPE html><html><body><div>hello <b>world</b></div><p>x</p></body></html>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        BlockContainer <div> (not painted) children: inline\n          TextNode <#text> (not painted)\n          InlineNode <b> (not painted)\n            TextNode <#text> (not painted)\n        BlockContainer <p> (not painted) children: inline\n          TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<!DOCTYPE html>\n<html>\n<head></head>\n<body>\n  <div>\n    one\n    <span>two</span>\n  </div>\n  <p>three</p>\n</body>\n</html>\n", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <(anonymous)> (not painted) children: inline\n        TextNode <#text> (not painted)\n      BlockContainer <body> (not painted) children: not-inline\n        BlockContainer <(anonymous)> (not painted) children: inline\n          TextNode <#text> (not painted)\n        BlockContainer <div> (not painted) children: inline\n          TextNode <#text> (not painted)\n          InlineNode <span> (not painted)\n            TextNode <#text> (not painted)\n          TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: inline\n          TextNode <#text> (not painted)\n        BlockContainer <p> (not painted) children: inline\n          TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: inline\n          TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body>text<div>block</div>more text<span>inline</span></body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        BlockContainer <(anonymous)> (not painted) children: inline\n          TextNode <#text> (not painted)\n        BlockContainer <div> (not painted) children: inline\n          TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: inline\n          TextNode <#text> (not painted)\n          InlineNode <span> (not painted)\n            TextNode <#text> (not painted)\n"),
