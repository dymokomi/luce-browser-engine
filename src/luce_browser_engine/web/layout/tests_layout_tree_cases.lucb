    TestLayoutTreeCase(mode = "tree", html = "<body>a<br>b<br><br>c</body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: inline\n        TextNode <#text> (not painted)\n        BreakNode <br> (not painted)\n        TextNode <#text> (not painted)\n        BreakNode <br> (not painted)\n        BreakNode <br> (not painted)\n        TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body><q>outer <q>inner</q></q> after</body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: inline\n        InlineNode <q> (not painted)\n          InlineNode <(anonymous)> (not painted)\n            TextNode <#text> (not painted)\n          TextNode <#text> (not painted)\n          InlineNode <q> (not painted)\n            InlineNode <(anonymous)> (not painted)\n              TextNode <#text> (not painted)\n            TextNode <#text> (not painted)\n            InlineNode <(anonymous)> (not painted)\n              TextNode <#text> (not painted)\n          InlineNode <(anonymous)> (not painted)\n            TextNode <#text> (not painted)\n        TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body><div id=a class=\"x y\">content</div><span id=b>inline</span></body>", css = "#a::before { content: \"B\" } #a::after { content: \"A\"; display: block } #b::before { content: \"1\" \"2\" } #b::after { content: \"\"; display: block }", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        BlockContainer <div#a.x.y> (not painted) children: not-inline\n          BlockContainer <(anonymous)> (not painted) children: inline\n            InlineNode <(anonymous)> (not painted)\n              TextNode <#text> (not painted)\n            TextNode <#text> (not painted)\n          BlockContainer <(anonymous)> (not painted) children: inline\n            TextNode <#text> (not painted)\n        BlockContainer <(anonymous)> (not painted) children: not-inline\n          BlockContainer <(anonymous)> (not painted) children: inline\n            InlineNode <span#b> (not painted)\n              InlineNode <(anonymous)> (not painted)\n                TextNode <#text> (not painted)\n                TextNode <#text> (not painted)\n              TextNode <#text> (not painted)\n          BlockContainer <(anonymous)> (not painted) children: inline\n            TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body><div style=\"display:list-item\">one</div><div style=\"display:list-item;list-style-type:none\">two</div><div style=\"display:list-item;list-style-position:inside\">three</div></body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        ListItemBox <div> (not painted) children: inline\n          ListItemMarkerBox <(anonymous)> (not painted) children: not-inline\n          TextNode <#text> (not painted)\n        ListItemBox <div> (not painted) children: inline\n          TextNode <#text> (not painted)\n        ListItemBox <div> (not painted) children: inline\n          ListItemMarkerBox <(anonymous)> (not painted) children: not-inline\n          TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body><div style=\"display:list-item;list-style-type:decimal\">one</div><div style=\"display:list-item;list-style-type:lower-roman\">two</div><div style=\"display:list-item;list-style-type:'-> '\">three</div></body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: not-inline\n        ListItemBox <div> (not painted) children: inline\n          ListItemMarkerBox <(anonymous)> (not painted) children: not-inline\n          TextNode <#text> (not painted)\n        ListItemBox <div> (not painted) children: inline\n          ListItemMarkerBox <(anonymous)> (not painted) children: not-inline\n          TextNode <#text> (not painted)\n        ListItemBox <div> (not painted) children: inline\n          ListItemMarkerBox <(anonymous)> (not painted) children: not-inline\n          TextNode <#text> (not painted)\n"),
    TestLayoutTreeCase(mode = "tree", html = "<body><div style=\"float:left\">f</div>text<div style=\"position:absolute\">abs</div><span>s<div style=\"position:absolute\">abs in inline</div>t</span></body>", css = "", expected = "  Viewport <#document> (not painted) children: not-inline\n    BlockContainer <html> (not painted) [BFC] children: not-inline\n      BlockContainer <body> (not painted) children: inline\n        BlockContainer <div> (not painted) floating [BFC] children: inline\n          TextNode <#text> (not painted)\n        TextNode <#text> (not painted)\n        BlockContainer <div> (not painted) positioned [BFC] children: inline\n          TextNode <#text> (not painted)\n        InlineNode <span> (not painted)\n          TextNode <#text> (not painted)\n          TextNode <#text> (not painted)\n        BlockContainer <div> (not painted) positioned [BFC] children: inline\n          TextNode <#text> (not painted)\n"),
