# mark: FlexFormattingContext.h's inline members ================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:19 Web::Layout::FlexFormattingContext::inhibits_floating (override).
pub func layout_flex_formatting_context_inhibits_floating_impl(base: LayoutFormattingContext*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:25 Web::Layout::FlexFormattingContext::flex_container.
pub func layout_flex_formatting_context_flex_container(this: LayoutFlexFormattingContext*) -> LayoutBox*:
    return layout_formatting_context_context_box(this.layout_formatting_context())

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:65 Web::Layout::FlexFormattingContext::FlexItem::hypothetical_cross_size_with_margins.
func layout_flex_formatting_context_flex_item_hypothetical_cross_size_with_margins(this: LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    return this.hypothetical_cross_size.add(this.margins.cross_before).add(this.margins.cross_after).add(this.borders.cross_after).add(this.borders.cross_before).add(this.padding.cross_after).add(this.padding.cross_before)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:72 Web::Layout::FlexFormattingContext::FlexItem::outer_hypothetical_main_size.
func layout_flex_formatting_context_flex_item_outer_hypothetical_main_size(this: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    return this.hypothetical_main_size.add(this.margins.main_before).add(this.margins.main_after).add(this.borders.main_before).add(this.borders.main_after).add(this.padding.main_before).add(this.padding.main_after)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:77 Web::Layout::FlexFormattingContext::FlexItem::outer_target_main_size.
func layout_flex_formatting_context_flex_item_outer_target_main_size(this: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    return this.target_main_size.add(this.margins.main_before).add(this.margins.main_after).add(this.borders.main_before).add(this.borders.main_after).add(this.padding.main_before).add(this.padding.main_after)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:82 Web::Layout::FlexFormattingContext::FlexItem::outer_flex_base_size.
func layout_flex_formatting_context_flex_item_outer_flex_base_size(this: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    return this.flex_base_size.add(this.margins.main_before).add(this.margins.main_after).add(this.borders.main_before).add(this.borders.main_after).add(this.padding.main_before).add(this.padding.main_after)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:101 Web::Layout::FlexFormattingContext::FlexItem::add_main_margin_box_sizes.
func layout_flex_formatting_context_flex_item_add_main_margin_box_sizes(this: const LayoutFlexFormattingContextFlexItem*, content_size: gfx.CssPixels) -> gfx.CssPixels:
    return content_size.add(this.margins.main_before).add(this.margins.main_after).add(this.borders.main_before).add(this.borders.main_after).add(this.padding.main_before).add(this.padding.main_after)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.h:106 Web::Layout::FlexFormattingContext::FlexItem::add_cross_margin_box_sizes.
func layout_flex_formatting_context_flex_item_add_cross_margin_box_sizes(this: const LayoutFlexFormattingContextFlexItem*, content_size: gfx.CssPixels) -> gfx.CssPixels:
    return content_size.add(this.margins.cross_before).add(this.margins.cross_after).add(this.borders.cross_before).add(this.borders.cross_after).add(this.padding.cross_before).add(this.padding.cross_after)

