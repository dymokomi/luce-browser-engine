## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:297 Web::Layout::FlexFormattingContext::populate_specified_margins.
func layout_flex_formatting_context_populate_specified_margins(this: LayoutFlexFormattingContext*, item: LayoutFlexFormattingContextFlexItem*, arg1: css_data.FlexDirection):
    discard(arg1)
    let width_of_containing_block = layout_state_used_values_content_width(this.m_flex_container_state)
    let node = item.box.layout_node()
    let computed_values = layout_box_computed(item.box)
    let padding = css_computed_values_padding(computed_values)
    let padding_left = css_length_box_left_const(&padding)
    let padding_right = css_length_box_right_const(&padding)
    let padding_top = css_length_box_top_const(&padding)
    let padding_bottom = css_length_box_bottom_const(&padding)
    let margin = css_computed_values_margin(computed_values)
    let margin_left = css_length_box_left_const(&margin)
    let margin_right = css_length_box_right_const(&margin)
    let margin_top = css_length_box_top_const(&margin)
    let margin_bottom = css_length_box_bottom_const(&margin)

    item.used_values.padding_left = css_length_percentage_or_auto_to_px_or_zero(&padding_left, node, width_of_containing_block)
    item.used_values.padding_right = css_length_percentage_or_auto_to_px_or_zero(&padding_right, node, width_of_containing_block)
    item.used_values.padding_top = css_length_percentage_or_auto_to_px_or_zero(&padding_top, node, width_of_containing_block)
    item.used_values.padding_bottom = css_length_percentage_or_auto_to_px_or_zero(&padding_bottom, node, width_of_containing_block)

    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        item.borders.main_before = css_computed_values_border_left(computed_values).width
        item.borders.main_after = css_computed_values_border_right(computed_values).width
        item.borders.cross_before = css_computed_values_border_top(computed_values).width
        item.borders.cross_after = css_computed_values_border_bottom(computed_values).width

        item.padding.main_before = css_length_percentage_or_auto_to_px_or_zero(&padding_left, node, width_of_containing_block)
        item.padding.main_after = css_length_percentage_or_auto_to_px_or_zero(&padding_right, node, width_of_containing_block)
        item.padding.cross_before = css_length_percentage_or_auto_to_px_or_zero(&padding_top, node, width_of_containing_block)
        item.padding.cross_after = css_length_percentage_or_auto_to_px_or_zero(&padding_bottom, node, width_of_containing_block)

        item.margins.main_before = css_length_percentage_or_auto_to_px_or_zero(&margin_left, node, width_of_containing_block)
        item.margins.main_after = css_length_percentage_or_auto_to_px_or_zero(&margin_right, node, width_of_containing_block)
        item.margins.cross_before = css_length_percentage_or_auto_to_px_or_zero(&margin_top, node, width_of_containing_block)
        item.margins.cross_after = css_length_percentage_or_auto_to_px_or_zero(&margin_bottom, node, width_of_containing_block)

        item.margins.main_before_is_auto = css_length_percentage_or_auto_is_auto(&margin_left)
        item.margins.main_after_is_auto = css_length_percentage_or_auto_is_auto(&margin_right)
        item.margins.cross_before_is_auto = css_length_percentage_or_auto_is_auto(&margin_top)
        item.margins.cross_after_is_auto = css_length_percentage_or_auto_is_auto(&margin_bottom)
    else:
        item.borders.main_before = css_computed_values_border_top(computed_values).width
        item.borders.main_after = css_computed_values_border_bottom(computed_values).width
        item.borders.cross_before = css_computed_values_border_left(computed_values).width
        item.borders.cross_after = css_computed_values_border_right(computed_values).width

        item.padding.main_before = item.used_values.padding_top
        item.padding.main_after = item.used_values.padding_bottom
        item.padding.cross_before = item.used_values.padding_left
        item.padding.cross_after = item.used_values.padding_right

        item.margins.main_before = css_length_percentage_or_auto_to_px_or_zero(&margin_top, node, width_of_containing_block)
        item.margins.main_after = css_length_percentage_or_auto_to_px_or_zero(&margin_bottom, node, width_of_containing_block)
        item.margins.cross_before = css_length_percentage_or_auto_to_px_or_zero(&margin_left, node, width_of_containing_block)
        item.margins.cross_after = css_length_percentage_or_auto_to_px_or_zero(&margin_right, node, width_of_containing_block)

        item.margins.main_before_is_auto = css_length_percentage_or_auto_is_auto(&margin_top)
        item.margins.main_after_is_auto = css_length_percentage_or_auto_is_auto(&margin_bottom)
        item.margins.cross_before_is_auto = css_length_percentage_or_auto_is_auto(&margin_left)
        item.margins.cross_after_is_auto = css_length_percentage_or_auto_is_auto(&margin_right)
