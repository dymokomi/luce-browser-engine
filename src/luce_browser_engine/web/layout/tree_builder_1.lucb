# mark: Construction and the ancestor stack =====================================================

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:45 Web::Layout::TreeBuilder::TreeBuilder.
pub func layout_tree_builder_construct(this: LayoutTreeBuilder*):
    this.m_layout_root = none
    this.m_ancestor_stack = ak.Vector[LayoutNodeWithStyle*]()
    this.m_quote_nesting_level = 0

## Ported from Libraries/LibWeb/Layout/TreeBuilder.h:40 Web::Layout::TreeBuilder::push_parent.
func layout_tree_builder_push_parent(this: LayoutTreeBuilder*, node: LayoutNodeWithStyle*):
    ak.vector_append_t(&this.m_ancestor_stack, node)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.h:41 Web::Layout::TreeBuilder::pop_parent.
func layout_tree_builder_pop_parent(this: LayoutTreeBuilder*):
    discard(ak.vector_take_last(&this.m_ancestor_stack))

# mark: Insertion parents =======================================================================

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:47 Web::Layout::has_inline_or_in_flow_block_children.
func layout_has_inline_or_in_flow_block_children(layout_node: LayoutNode*) -> bool:
    for child in layout_node_children(layout_node):
        if layout_node_is_inline(child) or layout_node_is_in_flow(child):
            return true
    return false

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:56 Web::Layout::has_in_flow_block_children.
func layout_has_in_flow_block_children(layout_node: LayoutNode*) -> bool:
    if layout_node_children_are_inline(layout_node):
        return false
    for child in layout_node_children(layout_node):
        if layout_node_is_inline(child):
            continue
        if layout_node_is_in_flow(child):
            return true
    return false

# The insertion_parent_for_*() functions maintain the invariant that the in-flow children of
# block-level boxes must be either all block-level or all inline-level.

## `last_child_creating_anonymous_wrapper_if_needed`: the lambda of insertion_parent_for_inline_node.
func layout_last_child_creating_anonymous_wrapper_if_needed(layout_parent: LayoutNodeWithStyle*) -> LayoutNode*:
    let parent = layout_parent.layout_node()
    var needs_wrapper = true
    if let last_child = tree_node_last_child(parent):
        needs_wrapper = not layout_node_is_anonymous(last_child) or not layout_node_children_are_inline(last_child) or layout_node_is_generated_for_pseudo_element(last_child)
    if needs_wrapper:
        tree_node_append_child(parent, layout_node_with_style_create_anonymous_wrapper(layout_parent).layout_node())
    return tree_node_last_child(parent) else trap("unreachable: the parent has a last child")

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:72 Web::Layout::insertion_parent_for_inline_node.
func layout_insertion_parent_for_inline_node(layout_parent: LayoutNodeWithStyle*) -> LayoutNode*:
    if is_layout_field_set_box(layout_parent):
        return layout_last_child_creating_anonymous_wrapper_if_needed(layout_parent)

    if layout_node_is_svg_foreign_object_box(layout_parent.layout_node()):
        return layout_last_child_creating_anonymous_wrapper_if_needed(layout_parent)

    let display = layout_node_display(layout_parent.layout_node())
    if css_display_is_inline_outside(&display) and css_display_is_flow_inside(&display):
        return layout_parent.layout_node()

    if css_display_is_flex_inside(&display) or css_display_is_grid_inside(&display):
        return layout_last_child_creating_anonymous_wrapper_if_needed(layout_parent)

    if not layout_has_in_flow_block_children(layout_parent.layout_node()) or layout_node_children_are_inline(layout_parent.layout_node()):
        return layout_parent.layout_node()

    # Parent has block-level children, insert into an anonymous wrapper block (and create it first if needed)
    return layout_last_child_creating_anonymous_wrapper_if_needed(layout_parent)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:103 Web::Layout::insertion_parent_for_block_node.
func layout_insertion_parent_for_block_node(layout_parent: LayoutNodeWithStyle*, layout_node: LayoutNode*) -> LayoutNode*:
    # Inline is fine for in-flow block children; we'll maintain the (non-)inline invariant after insertion.
    let parent_display = layout_node_display(layout_parent.layout_node())
    if not layout_node_is_anonymous(layout_node) and layout_node_is_inline(layout_parent.layout_node()) and css_display_is_flow_inside(&parent_display) and not layout_node_is_out_of_flow(layout_node):
        return layout_parent.layout_node()

    # Make sure we're not inserting into an inline node, since those do not support block nodes.
    var new_parent = layout_parent
    while is_layout_inline_node(new_parent):
        new_parent = layout_node_parent(new_parent.layout_node()) else trap("an inline node has a parent")

    # If the parent block has no children, insert this block into parent.
    if not layout_has_inline_or_in_flow_block_children(new_parent.layout_node()):
        return new_parent.layout_node()

    # If the block is out-of-flow and is not a pseudo element,
    if layout_node_is_out_of_flow(layout_node) and not layout_node_is_generated_for_pseudo_element(layout_node):
        # And the parent's last child is an anonymous block, join that anonymous block.
        let new_parent_display = layout_node_display(new_parent.layout_node())
        let last_child = tree_node_last_child(new_parent.layout_node()) else trap("the parent has children")
        if not css_display_is_flex_inside(&new_parent_display) and not css_display_is_grid_inside(&new_parent_display) and not layout_node_is_generated_for_pseudo_element(last_child) and layout_node_is_anonymous(last_child) and layout_node_children_are_inline(last_child):
            return last_child

        # Otherwise, insert this block into parent.
        return new_parent.layout_node()

    # If the parent block has block-level children, insert this block into parent.
    if not layout_node_children_are_inline(new_parent.layout_node()):
        return new_parent.layout_node()

    # Parent block has inline-level children (our siblings); wrap these siblings into an anonymous wrapper block.
    let wrapper = layout_node_with_style_create_anonymous_wrapper(new_parent)
    layout_node_set_children_are_inline(wrapper.layout_node(), true)

    var child = tree_node_first_child(new_parent.layout_node())
    while let current = child:
        let next_child = tree_node_next_sibling(current)
        tree_node_remove_child(new_parent.layout_node(), current)
        tree_node_append_child(wrapper.layout_node(), current)
        child = next_child

    layout_node_set_children_are_inline(new_parent.layout_node(), false)
    tree_node_append_child(new_parent.layout_node(), wrapper.layout_node())

    # Then it's safe to insert this block into parent.
    return new_parent.layout_node()

## `nearest_insertion_ancestor`: the lambda of insert_node_into_inline_or_block_ancestor.
func layout_tree_builder_nearest_insertion_ancestor(this: LayoutTreeBuilder*, node: LayoutNode*) -> LayoutNodeWithStyle*:
    var index = ak.vector_size(&this.m_ancestor_stack)
    while index > 0:
        index -= 1
        let ancestor = *ak.vector_at(&this.m_ancestor_stack, index)
        if layout_node_is_svg_foreign_object_box(ancestor.layout_node()):
            return ancestor

        let ancestor_display = layout_node_display(ancestor.layout_node())

        # Out-of-flow nodes cannot be hosted in inline flow nodes.
        if layout_node_is_out_of_flow(node) and css_display_is_inline_outside(&ancestor_display) and css_display_is_flow_inside(&ancestor_display):
            continue

        if not css_display_is_contents(&ancestor_display):
            return ancestor
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:155 Web::Layout::TreeBuilder::insert_node_into_inline_or_block_ancestor.
func layout_tree_builder_insert_node_into_inline_or_block_ancestor(this: LayoutTreeBuilder*, node: LayoutNode*, display: CssDisplay, mode: LayoutTreeBuilderAppendOrPrepend):
    let node_display = layout_node_display(node)
    if css_display_is_contents(&node_display):
        return

    # Find the nearest ancestor that can host the node.
    let nearest_insertion_ancestor = layout_tree_builder_nearest_insertion_ancestor(this, node)

    var insertion_point: LayoutNode* = ---
    if css_display_is_inline_outside(&display):
        insertion_point = layout_insertion_parent_for_inline_node(nearest_insertion_ancestor)
    else:
        insertion_point = layout_insertion_parent_for_block_node(nearest_insertion_ancestor, node)

    if mode == LayoutTreeBuilderAppendOrPrepend.prepend:
        tree_node_prepend_child(insertion_point, node)
    else:
        tree_node_append_child(insertion_point, node)

    if css_display_is_inline_outside(&display):
        # After inserting an inline-level box into a parent, mark the parent as having inline children.
        layout_node_set_children_are_inline(insertion_point, true)
    elif layout_node_is_in_flow(node):
        # After inserting an in-flow block-level box into a parent, mark the parent as having non-inline children.
        layout_node_set_children_are_inline(insertion_point, false)

# mark: GeneratedContentImageProvider (TreeBuilder.cpp:195-273) =================================

## The GeneratedContentImageProvider whose ImageProvider mixin is `base` (C++'s pointer adjustment).
func layout_generated_content_image_provider_from_image_provider(base: LayoutImageProvider*) -> LayoutGeneratedContentImageProvider*:
    return (LayoutGeneratedContentImageProvider*)((u8*)base - offsetof(LayoutGeneratedContentImageProvider, image_provider))

## The GeneratedContentImageProvider whose ImageStyleValue::Client mixin is `base`.
func layout_generated_content_image_provider_from_client(base: CssImageStyleValueClient*) -> LayoutGeneratedContentImageProvider*:
    return (LayoutGeneratedContentImageProvider*)((u8*)base - offsetof(LayoutGeneratedContentImageProvider, client))

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:207 Web::Layout::GeneratedContentImageProvider::finalize (override).
pub func layout_generated_content_image_provider_finalize_impl(base: gc.Cell*):
    let this = (LayoutGeneratedContentImageProvider*)base
    gc.cell_finalize_impl(base)
    css_image_style_value_client_image_style_value_finalize(&this.client)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:213 Web::Layout::GeneratedContentImageProvider::is_image_available (override).
pub func layout_generated_content_image_provider_is_image_available_impl(base: LayoutImageProvider*) -> bool:
    let this = layout_generated_content_image_provider_from_image_provider(base)
    return css_abstract_image_style_value_is_paintable(this.m_image.css_abstract_image_style_value())

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:215 Web::Layout::GeneratedContentImageProvider::intrinsic_width (override).
pub func layout_generated_content_image_provider_intrinsic_width_impl(base: LayoutImageProvider*) -> gfx.CssPixels?:
    let this = layout_generated_content_image_provider_from_image_provider(base)
    return css_abstract_image_style_value_natural_width(this.m_image.css_abstract_image_style_value())

