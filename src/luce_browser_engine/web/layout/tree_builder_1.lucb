## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:229 Web::Layout::GeneratedContentImageProvider::create.
pub func layout_generated_content_image_provider_create(heap: gc.Heap*, image: CssImageStyleValue*) -> LayoutGeneratedContentImageProvider*:
    let this = (LayoutGeneratedContentImageProvider*)web_heap_allocate_cell(heap, &layout_generated_content_image_provider_class)
    gc.heap_defer_gc(heap)
    layout_generated_content_image_provider_construct(this, image)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:234 Web::Layout::GeneratedContentImageProvider::set_layout_node.
pub func layout_generated_content_image_provider_set_layout_node(this: LayoutGeneratedContentImageProvider*, layout_node: LayoutNode*):
