## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:240 Web::Layout::GeneratedContentImageProvider::decoded_image_data (override).
pub func layout_generated_content_image_provider_decoded_image_data_impl(base: LayoutImageProvider*) -> HtmlDecodedImageData*?:
    let this = layout_generated_content_image_provider_from_image_provider(base)
    return css_image_style_value_image_data(this.m_image)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:246 Web::Layout::GeneratedContentImageProvider::GeneratedContentImageProvider.
pub func layout_generated_content_image_provider_construct(this: LayoutGeneratedContentImageProvider*, image: CssImageStyleValue*):
    # The vptrs of the two mixin bases (ImageProvider, ImageStyleValue::Client).
    this.image_provider.vtable = &layout_generated_content_image_provider_image_provider_vtable
    this.image_provider.class_id = this.cell().class_id
    this.client.vtable = &layout_generated_content_image_provider_client_vtable
    this.client.class_id = this.cell().class_id
    css_image_style_value_client_construct(&this.client, image)
    this.m_image = image

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:252 Web::Layout::GeneratedContentImageProvider::visit_edges (override).
pub func layout_generated_content_image_provider_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (LayoutGeneratedContentImageProvider*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_layout_node)
    css_style_value_visit_edges(this.m_image.css_style_value(), visitor)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:259 Web::Layout::GeneratedContentImageProvider::image_provider_visit_edges (override).
pub func layout_generated_content_image_provider_image_provider_visit_edges_impl(base: LayoutImageProvider*, visitor: gc.CellVisitor*):
    let this = layout_generated_content_image_provider_from_image_provider(base)
    layout_image_provider_image_provider_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this)

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:265 Web::Layout::GeneratedContentImageProvider::image_style_value_did_update (override).
pub func layout_generated_content_image_provider_image_style_value_did_update_impl(base: CssImageStyleValueClient*, arg0: CssImageStyleValue*):
    discard(arg0)
    let this = layout_generated_content_image_provider_from_client(base)
    let layout_node = this.m_layout_node else trap("GeneratedContentImageProvider: no layout node")
    layout_node_set_needs_layout_update(layout_node, DomSetNeedsLayoutReason.generated_content_image_finished_loading)

# mark: Pseudo-elements =========================================================================

## Ported from Libraries/LibWeb/Layout/TreeBuilder.cpp:276 Web::Layout::TreeBuilder::create_pseudo_element_if_needed.
func layout_tree_builder_create_pseudo_element_if_needed(this: LayoutTreeBuilder*, element: DomElement*, pseudo_element: css_data.PseudoElement, insertion_mode: LayoutTreeBuilderAppendOrPrepend?) -> LayoutNodeWithStyle*?:
    let document = dom_node_document(element.dom_node())
    let realm = layout_document_realm(document)

    let pseudo_element_style = dom_element_computed_properties(element, pseudo_element) else return none

    let initial_quote_nesting_level = this.m_quote_nesting_level
    var element_reference = dom_element_abstract_element(element, pseudo_element)
    let content_and_level = css_computed_properties_content(pseudo_element_style, &element_reference, initial_quote_nesting_level)
    let pseudo_element_content = content_and_level.content_data
    this.m_quote_nesting_level = content_and_level.final_quote_nesting_level
    let pseudo_element_display = css_computed_properties_display(pseudo_element_style)

    # ::before and ::after only exist if they have content. `content: normal` computes to `none` for them.
    # We also don't create them if they are `display: none`.
    if (pseudo_element == css_data.PseudoElement.before or pseudo_element == css_data.PseudoElement.after) and (css_display_is_none(&pseudo_element_display) or pseudo_element_content.type_ == CssContentDataType.normal or pseudo_element_content.type_ == CssContentDataType.none_):
        return none

    # For ::marker with content or display 'none' -- do nothing.
    if pseudo_element == css_data.PseudoElement.marker and (css_display_is_none(&pseudo_element_display) or pseudo_element_content.type_ == CssContentDataType.none_):
        return none

    # For ::marker with content 'normal', create the marker pseudo-element from a ListItemMarkerBox
    # FIXME: This + ListItemBox + ListItemMarkerBox will disappear once ::marker pseudo-elements with 'normal' content
    #        are rendered using the special list-item counter.
    #        See: https://github.com/LadybirdBrowser/ladybird/issues/4782
    # NB: Called during layout tree construction.
    if pseudo_element == css_data.PseudoElement.marker and pseudo_element_content.type_ == CssContentDataType.normal:
        let element_layout_node = dom_element_unsafe_layout_node(element) else trap("the element has a layout node")
        if let list_box = as_if_layout_list_item_box(element_layout_node):
            # https://www.w3.org/TR/css-lists-3/#content-property
            # "::marker does not generate a box" when list-style-type is 'none' and there's no marker image. Custom
            # ::marker content is already excluded by the outer condition checking for Type::Normal.
            let list_box_values = &layout_node_computed_values(list_box.layout_node()).computed_values
            let list_style_type = css_computed_values_list_style_type(list_box_values)
            let list_style_type_is_empty = match list_style_type:
                .empty => true
                _ => false
            if list_style_type_is_empty and layout_node_with_style_list_style_image(list_box.layout_node_with_style()) == none:
                return none

            let list_item_marker = realm_create_layout_list_item_marker_box(realm, document, list_style_type, css_computed_values_list_style_position(list_box_values), element, pseudo_element_style)
            layout_list_item_box_set_marker(list_box, list_item_marker)
            dom_element_set_computed_properties(element, css_data.PseudoElement.marker, pseudo_element_style)
            dom_element_set_pseudo_element_node(element, css_data.PseudoElement.marker, list_item_marker.layout_node_with_style())
            tree_node_prepend_child(list_box.layout_node(), list_item_marker.layout_node())
            return list_item_marker.layout_node_with_style()

    let pseudo_element_node = dom_element_create_layout_node_for_display_type(document, pseudo_element_display, pseudo_element_style, none) else return none

    # FIXME: This code actually computes style for element::marker, and shouldn't for element::pseudo::marker
    if is_layout_list_item_box(pseudo_element_node):
        let style_computer = dom_document_style_computer(document)

        let marker_style = css_style_computer_compute_style(style_computer, dom_element_abstract_element(element, css_data.PseudoElement.marker))
        let pseudo_element_values = &layout_node_computed_values(pseudo_element_node.layout_node()).computed_values
        let list_item_marker = realm_create_layout_list_item_marker_box(realm, document, css_computed_values_list_style_type(pseudo_element_values), css_computed_values_list_style_position(pseudo_element_values), element, marker_style)
        layout_list_item_box_set_marker((LayoutListItemBox*)pseudo_element_node, list_item_marker)
        dom_element_set_pseudo_element_node(element, css_data.PseudoElement.marker, list_item_marker.layout_node_with_style())
        tree_node_prepend_child(pseudo_element_node.layout_node(), list_item_marker.layout_node())

        # FIXME: Support counters on element::pseudo::marker

    layout_node_set_generated_for(pseudo_element_node.layout_node(), pseudo_element, element)
    layout_node_set_initial_quote_nesting_level(pseudo_element_node.layout_node(), initial_quote_nesting_level)

    dom_element_set_pseudo_element_node(element, pseudo_element, pseudo_element_node)
    if let mode = insertion_mode:
        layout_tree_builder_insert_node_into_inline_or_block_ancestor(this, pseudo_element_node.layout_node(), pseudo_element_display, mode)
    css_mutable_computed_values_set_content(layout_node_with_style_mutable_computed_values(pseudo_element_node), pseudo_element_content)

    css_resolve_counters(&element_reference)
    # Now that we have counters, we can compute the content for real. Which is silly.
    if pseudo_element_content.type_ == CssContentDataType.list:
        let new_content = css_computed_properties_content(pseudo_element_style, &element_reference, initial_quote_nesting_level).content_data
        css_mutable_computed_values_set_content(layout_node_with_style_mutable_computed_values(pseudo_element_node), new_content)

        # FIXME: Handle images, and multiple values
        if new_content.type_ == CssContentDataType.list:
            layout_tree_builder_push_parent(this, pseudo_element_node)
            for item in ak.vector_span_const(&new_content.data):
                var layout_node: LayoutNode* = ---
                match item:
                    .string(string):
                        let text = realm_create_dom_text_utf16_string(realm, document, ak.utf16_string_from_utf8_string(&string))
                        layout_node = realm_create_layout_text_node(realm, document, text).layout_node()
                    .css_image_style_value(image):
                        css_abstract_image_style_value_load_any_resources_dom_document(image.css_abstract_image_style_value(), document)
                        let image_provider = layout_generated_content_image_provider_create(gc.cell_heap(element.cell()), image)
                        layout_node = realm_create_layout_image_box(realm, document, none, pseudo_element_style, &image_provider.image_provider).layout_node()
                        layout_generated_content_image_provider_set_layout_node(image_provider, layout_node)
                layout_node_set_generated_for(layout_node, pseudo_element, element)
                layout_tree_builder_insert_node_into_inline_or_block_ancestor(this, layout_node, layout_node_display(layout_node), LayoutTreeBuilderAppendOrPrepend.append)
            layout_tree_builder_pop_parent(this)
        else:
            trap("TODO")

    return pseudo_element_node
