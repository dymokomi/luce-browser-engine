## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:487 Web::Layout::BlockFormattingContext::resolve_used_height_if_not_treated_as_auto.
pub func layout_block_formatting_context_resolve_used_height_if_not_treated_as_auto(this: LayoutBlockFormattingContext*, box: LayoutBox*, available_space: LayoutAvailableSpace):
    let base = this.layout_formatting_context()
    if layout_formatting_context_should_treat_height_as_auto(base, box, available_space):
        return

    let computed_values = layout_box_computed(box)
    let box_state = layout_state_get_mutable(base.m_state, box.layout_node_with_style())

    var height = layout_formatting_context_calculate_inner_height(base, box, available_space, css_computed_values_height(computed_values))

    if not layout_formatting_context_should_treat_max_height_as_none(base, box, available_space.height):
        let computed_max_height = css_computed_values_max_height(computed_values)
        if not css_size_is_auto(&computed_max_height):
            let max_height = layout_formatting_context_calculate_inner_height(base, box, available_space, computed_max_height)
            height = ak.min(height, max_height)
    let computed_min_height = css_computed_values_min_height(computed_values)
    if not css_size_is_auto(&computed_min_height):
        height = ak.max(height, layout_formatting_context_calculate_inner_height(base, box, available_space, computed_min_height))

    layout_state_used_values_set_content_height(box_state, height)
    layout_state_used_values_set_has_definite_height(box_state, true)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:512 Web::Layout::BlockFormattingContext::resolve_used_height_if_treated_as_auto.
pub func layout_block_formatting_context_resolve_used_height_if_treated_as_auto(this: LayoutBlockFormattingContext*, box: LayoutBox*, available_space: LayoutAvailableSpace, box_formatting_context: LayoutFormattingContext*? = none):
    let base = this.layout_formatting_context()
    if not layout_formatting_context_should_treat_height_as_auto(base, box, available_space):
        return

    let computed_values = layout_box_computed(box)
    let box_state = layout_state_get_mutable(base.m_state, box.layout_node_with_style())

    var height = layout_zero_px()
    if layout_formatting_context_box_is_sized_as_replaced_element(base, box, available_space):
        height = layout_formatting_context_compute_height_for_replaced_element(base, box, available_space)
    else:
        if let context = box_formatting_context:
            height = layout_formatting_context_automatic_content_height(context)
        else:
            height = layout_block_formatting_context_compute_auto_height_for_block_level_element(this, box, layout_state_used_values_available_inner_space_or_constraints_from(layout_state_get(base.m_state, box.layout_node_with_style()), available_space))

    if not layout_formatting_context_should_treat_max_height_as_none(base, box, available_space.height):
        let computed_max_height = css_computed_values_max_height(computed_values)
        if not css_size_is_auto(&computed_max_height):
            let max_height = layout_formatting_context_calculate_inner_height(base, box, available_space, computed_max_height)
            height = ak.min(height, max_height)
    let computed_min_height = css_computed_values_min_height(computed_values)
    if not css_size_is_auto(&computed_min_height):
        height = ak.max(height, layout_formatting_context_calculate_inner_height(base, box, available_space, computed_min_height))

    let document = layout_node_document(box.layout_node())
    let computed_height = css_computed_values_height(computed_values)
    let dom_node = layout_node_dom_node(box.layout_node())
    if dom_document_in_quirks_mode(document) and dom_node != none and dom_node_is_html_html_element(dom_node else trap("unreachable")) and css_size_is_auto(&computed_height):
        # 3.6. The html element fills the viewport quirk
        # https://quirks.spec.whatwg.org/#the-html-element-fills-the-viewport-quirk
        # FIXME: Handle vertical writing mode.

        # 1. Let margins be sum of the used values of the margin-left and margin-right properties of element
        #    if element has a vertical writing mode, otherwise let margins be the sum of the used values of
        #    the margin-top and margin-bottom properties of element.
        let margins = box_state.margin_top.add(box_state.margin_bottom)

        # 2. Let size be the size of the initial containing block in the block flow direction minus margins.
        let containing_block_used_values = layout_state_used_values_containing_block_used_values(box_state) else trap("the html element without its containing block's used values")
        let size = layout_state_used_values_content_height(containing_block_used_values).sub(margins)

        # 3. Return the bigger value of size and the normal border box size the element would have
        #    according to the CSS specification.
        height = ak.max(size, height)

        # NOTE: The height of the root element when affected by this quirk is considered to be definite.
        layout_state_used_values_set_has_definite_height(box_state, true)

    if dom_document_in_quirks_mode(document) and dom_node != none and dom_node_is_html_body_element(dom_node else trap("unreachable")) and css_size_is_auto(&computed_height):
        # 3.7. The body element fills the html element quirk
        # https://quirks.spec.whatwg.org/#the-body-element-fills-the-html-element-quirk
        # FIXME: Handle vertical writing mode.

        # The element body must additionally meet the following conditions:
        # - The computed value of the 'position' property of element is neither 'absolute' nor 'fixed'.
        # - The computed value of the 'float' property of element is 'none'.
        # - Element is not an inline-level element.
        # - Element is not a multi-column spanning element.
        # NON-STANDARD: We don't check column-span since no browser actually excludes it.
        if not layout_node_is_absolutely_positioned(box.layout_node()) and not layout_node_is_floating(box.layout_node()) and not layout_node_is_inline(box.layout_node()):
            # 1. Let margins be sum of the used values of the margin-left and margin-right properties of element
            #    if element has a vertical writing mode, otherwise let margins be the sum of the used values of
            #    the margin-top and margin-bottom properties of element.
            let margins = box_state.margin_top.add(box_state.margin_bottom)

            # 2. Let size be the size of element's parent element's content box in the block flow direction minus margins.
            let containing_block_used_values = layout_state_used_values_containing_block_used_values(box_state) else trap("the body element without its containing block's used values")
            let size = layout_state_used_values_content_height(containing_block_used_values).sub(margins)

            # 3. Return the bigger value of size and the normal border box size the element would have
            #    according to the CSS specification.
            height = ak.max(size, height)

    layout_state_used_values_set_content_height(box_state, height)

# mark: Inline children =========================================================================

## The `should_treat_min_width_as_auto` lambda of layout_inline_children.
func layout_block_formatting_context_should_treat_min_width_as_auto(block_container: LayoutBlockContainer*, available_space: LayoutAvailableSpace) -> bool:
    let available_width = available_space.width
    let min_width = css_computed_values_min_width(layout_box_computed(block_container.layout_box()))
    if css_size_is_auto(&min_width):
        return true
    if css_size_is_fit_content(&min_width) and layout_available_size_is_intrinsic_sizing_constraint(&available_width):
        return true
    if css_size_is_max_content(&min_width) and layout_available_size_is_max_content(&available_width):
        return true
    if css_size_is_min_content(&min_width) and layout_available_size_is_min_content(&available_width):
        return true
    return false

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:598 Web::Layout::BlockFormattingContext::layout_inline_children.
pub func layout_block_formatting_context_layout_inline_children(this: LayoutBlockFormattingContext*, block_container: LayoutBlockContainer*, available_space: LayoutAvailableSpace):
    let base = this.layout_formatting_context()
    assert(layout_node_children_are_inline(block_container.layout_node()))

    let block_container_state = layout_state_get_mutable(base.m_state, block_container.layout_node_with_style())

    var context: LayoutInlineFormattingContext = ---
    layout_inline_formatting_context_construct(&context, base.m_state, base.m_layout_mode, block_container, block_container_state, this)
    layout_formatting_context_run(context.layout_formatting_context(), available_space)

    if not layout_state_used_values_has_definite_width(block_container_state):
        # NOTE: min-width or max-width for boxes with inline children can only be applied after inside layout
        #       is done and width of box content is known
        var used_width_px = layout_formatting_context_automatic_content_width(context.layout_formatting_context())
        # https://www.w3.org/TR/css-sizing-3/#sizing-values
        # Percentages are resolved against the width/height, as appropriate, of the box’s containing block.
        var containing_block_width = layout_zero_px()
        let containing_block = layout_node_containing_block(block_container.layout_node()) else trap("a block container without a containing block")
        if let containing_block_used_values = layout_state_try_get_layout_node_with_style(base.m_state, containing_block.layout_node_with_style()):
            containing_block_width = layout_state_used_values_content_width(containing_block_used_values)
        let available_width = layout_available_size_make_definite(containing_block_width)
        if not layout_formatting_context_should_treat_max_width_as_none(base, block_container.layout_box(), available_space.width):
            let max_width_px = layout_formatting_context_calculate_inner_width(base, block_container.layout_box(), available_width, css_computed_values_max_width(layout_box_computed(block_container.layout_box())))
            if used_width_px.gt(max_width_px):
                used_width_px = max_width_px

        let should_treat_min_width_as_auto = layout_block_formatting_context_should_treat_min_width_as_auto(block_container, available_space)
        if not should_treat_min_width_as_auto:
            let min_width_px = layout_formatting_context_calculate_inner_width(base, block_container.layout_box(), available_width, css_computed_values_min_width(layout_box_computed(block_container.layout_box())))
            if used_width_px.lt(min_width_px):
                used_width_px = min_width_px
        layout_state_used_values_set_content_width(block_container_state, used_width_px)
        layout_state_used_values_set_content_height(block_container_state, layout_formatting_context_automatic_content_height(context.layout_formatting_context()))
