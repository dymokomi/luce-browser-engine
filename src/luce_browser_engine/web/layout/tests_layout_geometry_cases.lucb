#==============================================================================================
#
#   tests_layout_geometry_cases - laid-out layout trees (block layout geometry) pinned to the
#                                 reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same documents (luce-browser-tools,
#       oracles/luce-browser-engine/layout_geometry: cases.txt, oracle.cpp, gen_luce_cases.py,
#       build.sh). tests_layout_geometry runs each case through the port and compares the output.
#
#==============================================================================================

## One oracle case: the mode, the document, its author style sheet, and the reference build's output.
struct TestLayoutGeometryCase:
    let mode: str
    let html: str
    let css: str
    let expected: str

## Every oracle case, in cases.txt order (6 more, marked "!" in cases.txt, wait for other regions).
let test_layout_geometry_cases: TestLayoutGeometryCase[68] = [
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    left: 0;\n    width : 100px;\n    height: 100px;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [12,22] positioned [0+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x332]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x314]\n        PaintableWithLines (BlockContainer<DIV>.box) [10,10 272x312]\n          PaintableWithLines (BlockContainer<DIV>.inner) [11,21 102x102]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x330] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div id=foo></div><div id=bar></div><div id=baz></div>", css = "\n    * {\n        border: 1px solid black;\n    }\n    div {\n        height: 100px;\n        width: 100px;\n        position: absolute;\n        height: 100px;\n    }\n    #foo {\n        margin: auto;\n        left: 0px;\n        right: 0px;\n        top: 0px;\n    }\n    #bar {\n        margin-left: auto;\n        margin-right: 0px;\n        left: 0px;\n        right: 0px;\n        top: 100px;\n    }\n    #baz {\n        margin-left: 0px;\n        margin-right: auto;\n        left: 0px;\n        right: 0px;\n        top: 200px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 18 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 0 0+1+8] children: not-inline\n        BlockContainer <div#foo> at [350,1] positioned [349+1+0 100 0+1+349] [0+1+0 100 0+1+0] [BFC] children: not-inline\n        BlockContainer <div#bar> at [699,101] positioned [698+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n        BlockContainer <div#baz> at [1,201] positioned [0+1+0 100 0+1+698] [0+1+0 100 0+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x20]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x2]\n        PaintableWithLines (BlockContainer<DIV>#foo) [349,0 102x102]\n        PaintableWithLines (BlockContainer<DIV>#bar) [698,100 102x102]\n        PaintableWithLines (BlockContainer<DIV>#baz) [0,200 102x102]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x18] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    width : 100px;\n    height: 100px;\n    bottom: 0;\n    right: 0;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [180,220] positioned [0+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x332]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x314]\n        PaintableWithLines (BlockContainer<DIV>.box) [10,10 272x312]\n          PaintableWithLines (BlockContainer<DIV>.inner) [179,219 102x102]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x330] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><body><div class=\"abspos\">", css = "\n  body {\n    position: relative;\n    padding-top: 30%;\n  }\n  .abspos {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    top: 0px;\n    left: 0px;\n    background: orange;\n  }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 256 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,248] positioned [8+0+0 784 0+0+8] [8+0+240 0 0+0+8] children: not-inline\n        BlockContainer <div.abspos> at [8,8] positioned [0+0+0 784 0+0+0] [0+0+0 240 0+0+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x256]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x240]\n        PaintableWithLines (BlockContainer<DIV>.abspos) [8,8 784x240]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x256] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    left: 0;\n    width : 100px;\n    height: 100px;\n    padding: 20%;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [66,76] positioned [0+1+54 100 54+1+0] [0+1+54 100 54+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x332]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x314]\n        PaintableWithLines (BlockContainer<DIV>.box) [10,10 272x312]\n          PaintableWithLines (BlockContainer<DIV>.inner) [11,21 210x210]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x330] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n<div class=\"box\"><div class=\"inner\"></div></div>", css = "\n.box {\n  position: relative;\n  padding-top: 50px;\n}\n\n.inner {\n  display: block;\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, #FDDE5C 0%, #F8AB5E 16.66667%, #F56A62 33.33333%, #A176C8 50%, #759BEB 66.66667%, #65BEB3 83.33333%, #70DB96);\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 66 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 50 0+0+8] children: not-inline\n        BlockContainer <div.box> at [8,58] positioned [0+0+0 784 0+0+0] [0+0+50 0 0+0+0] children: not-inline\n          BlockContainer <div.inner> at [8,58] positioned [0+0+0 784 0+0+0] [0+0+0 50 0+0+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x66]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x50]\n        PaintableWithLines (BlockContainer<DIV>.box) [8,8 784x50]\n          PaintableWithLines (BlockContainer<DIV>.inner) [8,58 784x50]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x66] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    width : 100px;\n    height: 100px;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [32,22] positioned [0+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x332]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x314]\n        PaintableWithLines (BlockContainer<DIV>.box) [10,10 272x312]\n          PaintableWithLines (BlockContainer<DIV>.inner) [31,21 102x102]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x330] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<div><div class=\"square white\"></div><div class=\"clearfix\"></div><div class=\"square black\"></div></div>", css = "\n.clearfix {\n    clear: both;\n    margin-top: 9999px;\n    margin-bottom: 100px;\n    background-color: black;\n    width: 10px;\n    height: 10px;\n}\n.square {\n    float: left;\n    width: 49px;\n    height: 49px;\n}\n.white {\n    background-color: salmon;\n    width: 100px;\n    height: 100px;\n}\n.black {\n    background-color: slateblue;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 267 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 110 0+0+100] children: not-inline\n        BlockContainer <div> at [8,8] [0+0+0 784 0+0+0] [0+0+0 110 0+0+0] children: not-inline\n          BlockContainer <div.square.white> at [8,8] floating [0+0+0 100 0+0+0] [0+0+0 100 0+0+0] [BFC] children: not-inline\n          BlockContainer <div.clearfix> at [8,108] [0+0+0 10 0+0+774] [9999+0+0 10 0+0+100] children: not-inline\n          BlockContainer <div.square.black> at [8,218] floating [0+0+0 49 0+0+0] [0+0+0 49 0+0+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x267]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x110]\n        PaintableWithLines (BlockContainer<DIV>) [8,8 784x110]\n          PaintableWithLines (BlockContainer<DIV>.square.white) [8,8 100x100]\n          PaintableWithLines (BlockContainer<DIV>.clearfix) [8,108 10x10]\n          PaintableWithLines (BlockContainer<DIV>.square.black) [8,218 49x49]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x267] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"></div>", css = "\n.box {\n    float: left;\n    width: 300px;\n    height: 200px;\n    padding: 100px;\n    background-color: magenta;\n    box-sizing: border-box;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 208 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 0 0+0+8] children: not-inline\n        BlockContainer <div.box> at [108,108] floating [0+0+100 100 100+0+0] [0+0+100 0 100+0+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x208]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x0]\n        PaintableWithLines (BlockContainer<DIV>.box) [8,8 300x200]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x208] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><body><div class=\"box\"></div>", css = "\n    * {\n        outline: 1px solid black !important;\n    }\n    body {\n        border: 10px solid purple;\n        display: block;\n        height: 50%;\n    }\n    .box {\n        background-color: palevioletred;\n        height: 100px;\n        width: 100px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 136 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [18,18] [8+10+0 764 0+10+8] [8+10+0 100 0+10+8] children: not-inline\n        BlockContainer <div.box> at [18,18] [0+0+0 100 0+0+664] [0+0+0 100 0+0+0] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x136]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x120]\n        PaintableWithLines (BlockContainer<DIV>.box) [18,18 100x100]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x136] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE quirks>\n<body><div class=\"box\"></div>", css = "\n    * {\n        outline: 1px solid black !important;\n    }\n    body {\n        border: 10px solid purple;\n        display: block;\n        height: 50%;\n    }\n    .box {\n        background-color: palevioletred;\n        height: 100px;\n        width: 100px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [18,18] [8+10+0 764 0+10+8] [8+10+0 300 0+10+8] children: not-inline\n        BlockContainer <div.box> at [18,18] [0+0+0 100 0+0+664] [0+0+0 100 0+0+0] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x600]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x320]\n        PaintableWithLines (BlockContainer<DIV>.box) [18,18 100x100]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x600] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"outer\"><div class=\"inner\">", css = "\n* {\n    font-family: 'SerenitySans';\n    border: 1px solid black;\n}\nbody {\n    float: left;\n}\n.outer {\n    min-width: 32px;\n    background-color: orange;\n}\n.inner {\n    width: 100px;\n    height: 30px;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 52 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] floating [8+1+0 104 0+1+8] [8+1+0 34 0+1+8] [BFC] children: not-inline\n        BlockContainer <div.outer> at [11,11] [0+1+0 102 0+1+0] [0+1+0 32 0+1+0] children: not-inline\n          BlockContainer <div.inner> at [12,12] [0+1+0 100 0+1+0] [0+1+0 30 0+1+0] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x54]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 106x36]\n        PaintableWithLines (BlockContainer<DIV>.outer) [10,10 104x34]\n          PaintableWithLines (BlockContainer<DIV>.inner) [11,11 102x32]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x52] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><div class=\"upper\"></div><div class=bfc><div class=\"inner\">", css = "\n    .upper { \n        margin-bottom: 50px;\n        height: 20px;\n        background: lime;\n    }\n    .bfc {\n        display: flow-root;\n    }\n    .inner {\n        width: 20px;\n        height: 20px;\n        background: black;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 106 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 90 0+0+8] children: not-inline\n        BlockContainer <div.upper> at [8,8] [0+0+0 784 0+0+0] [0+0+0 20 0+0+50] children: not-inline\n        BlockContainer <div.bfc> at [8,78] [0+0+0 784 0+0+0] [0+0+0 20 0+0+0] [BFC] children: not-inline\n          BlockContainer <div.inner> at [8,78] [0+0+0 20 0+0+764] [0+0+0 20 0+0+0] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x106]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x90]\n        PaintableWithLines (BlockContainer<DIV>.upper) [8,8 784x20]\n        PaintableWithLines (BlockContainer<DIV>.bfc) [8,78 784x20]\n          PaintableWithLines (BlockContainer<DIV>.inner) [8,78 20x20]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x106] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"bump\"></div><div class=\"content\"></div>", css = "\nbody {\n    margin: 0;\n}\n.bump {\n    margin-top: 100px;\n}\n.content {\n    background: green;\n    width: 100px;\n    height: 100px;\n    margin-top: 200px;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 300 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [0,200] [0+0+0 800 0+0+0] [0+0+0 100 0+0+0] children: not-inline\n        BlockContainer <div.bump> at [0,200] [0+0+0 800 0+0+0] [100+0+0 0 0+0+0] children: not-inline\n        BlockContainer <div.content> at [0,200] [0+0+0 100 0+0+700] [200+0+0 100 0+0+0] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x300]\n      PaintableWithLines (BlockContainer<BODY>) [0,200 800x100]\n        PaintableWithLines (BlockContainer<DIV>.bump) [0,200 800x0]\n        PaintableWithLines (BlockContainer<DIV>.content) [0,200 100x100]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x300] [children: 0] (z-index: auto)\n"),
