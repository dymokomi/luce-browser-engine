#==============================================================================================
#
#   tests_layout_geometry_cases - laid-out layout trees (block layout geometry) pinned to the
#                                 reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same documents (luce-browser-tools,
#       oracles/luce-browser-engine/layout_geometry: cases.txt, oracle.cpp, gen_luce_cases.py,
#       build.sh). tests_layout_geometry runs each case through the port and compares the output.
#
#==============================================================================================

## One oracle case: the mode, the document, its author style sheet, and the reference build's output.
struct TestLayoutGeometryCase:
    let mode: str
    let html: str
    let css: str
    let expected: str

## Every oracle case, in cases.txt order (0 more, marked "!" in cases.txt, wait for other regions).
let test_layout_geometry_cases: TestLayoutGeometryCase[74] = [
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    left: 0;\n    width : 100px;\n    height: 100px;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [12,22] positioned [0+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div id=foo></div><div id=bar></div><div id=baz></div>", css = "\n    * {\n        border: 1px solid black;\n    }\n    div {\n        height: 100px;\n        width: 100px;\n        position: absolute;\n        height: 100px;\n    }\n    #foo {\n        margin: auto;\n        left: 0px;\n        right: 0px;\n        top: 0px;\n    }\n    #bar {\n        margin-left: auto;\n        margin-right: 0px;\n        left: 0px;\n        right: 0px;\n        top: 100px;\n    }\n    #baz {\n        margin-left: 0px;\n        margin-right: auto;\n        left: 0px;\n        right: 0px;\n        top: 200px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 18 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 0 0+1+8] children: not-inline\n        BlockContainer <div#foo> at [350,1] positioned [349+1+0 100 0+1+349] [0+1+0 100 0+1+0] [BFC] children: not-inline\n        BlockContainer <div#bar> at [699,101] positioned [698+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n        BlockContainer <div#baz> at [1,201] positioned [0+1+0 100 0+1+698] [0+1+0 100 0+1+0] [BFC] children: not-inline\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"box\"><div class=\"inner\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.box {\n    position: relative;\n    padding: 10px 50px 100px 20px;\n    background-color: mediumseagreen;\n    width: 200px;\n    height: 200px;\n}\n\n.inner {\n    position: absolute;\n    width : 100px;\n    height: 100px;\n    bottom: 0;\n    right: 0;\n    background-color: magenta;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 330 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 312 0+1+8] children: not-inline\n        BlockContainer <div.box> at [31,21] positioned [0+1+20 200 50+1+508] [0+1+10 200 100+1+0] children: not-inline\n          BlockContainer <div.inner> at [180,220] positioned [0+1+0 100 0+1+0] [0+1+0 100 0+1+0] [BFC] children: not-inline\n"),
