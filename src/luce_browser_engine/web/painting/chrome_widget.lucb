# mark: MouseAction (AK_ENUM_BITWISE_OPERATORS) ===================================================

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator&=.
pub func paint_and_assign(lhs: PaintMouseAction*, rhs: PaintMouseAction) -> PaintMouseAction*:
    *lhs = *lhs & rhs
    return lhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator&.
pub func paint_bit_and(lhs: PaintMouseAction, rhs: PaintMouseAction) -> PaintMouseAction:
    return lhs & rhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator~.
pub func paint_bit_not(rhs: PaintMouseAction) -> PaintMouseAction:
    return ~rhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator|.
pub func paint_bit_or(lhs: PaintMouseAction, rhs: PaintMouseAction) -> PaintMouseAction:
    return lhs | rhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator^.
pub func paint_bit_xor(lhs: PaintMouseAction, rhs: PaintMouseAction) -> PaintMouseAction:
    return lhs ^ rhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::has_any_flag.
pub func paint_has_any_flag(value: PaintMouseAction, mask: PaintMouseAction) -> bool:
    return (u8)(value & mask) != 0

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::has_flag.
pub func paint_has_flag(value: PaintMouseAction, mask: PaintMouseAction) -> bool:
    return (value & mask) == mask

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator|=.
pub func paint_or_assign(lhs: PaintMouseAction*, rhs: PaintMouseAction) -> PaintMouseAction*:
    *lhs = *lhs | rhs
    return lhs

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:23 Web::Painting::operator^=.
pub func paint_xor_assign(lhs: PaintMouseAction*, rhs: PaintMouseAction) -> PaintMouseAction*:
    *lhs = *lhs ^ rhs
    return lhs

# mark: ChromeWidget ==============================================================================

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:29 Web::Painting::ChromeWidget::handle_pointer_event (pure virtual).
pub func paint_chrome_widget_handle_pointer_event_impl(this: PaintChromeWidget*, type_: ak.FlyString, button: u32, visual_viewport_position: gfx.CssPixelPoint) -> PaintMouseAction:
    trap("pure virtual: Web::Painting::ChromeWidget::handle_pointer_event")

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:30 Web::Painting::ChromeWidget::mouse_enter (pure virtual).
pub func paint_chrome_widget_mouse_enter_impl(this: PaintChromeWidget*):
    trap("pure virtual: Web::Painting::ChromeWidget::mouse_enter")

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:31 Web::Painting::ChromeWidget::mouse_leave (pure virtual).
pub func paint_chrome_widget_mouse_leave_impl(this: PaintChromeWidget*):
    trap("pure virtual: Web::Painting::ChromeWidget::mouse_leave")

## Ported from Libraries/LibWeb/Painting/ChromeWidget.h:33 Web::Painting::ChromeWidget::cursor (virtual).
pub func paint_chrome_widget_cursor_impl(this: PaintChromeWidget*) -> css_data.CursorPredefined?:
    return none
