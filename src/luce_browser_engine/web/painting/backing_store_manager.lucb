## The backing store shrink timer's handler (BackingStoreManager::BackingStoreManager's lambda).
func paint_backing_store_manager_shrink_timer_fired(context: void*?):
    let this = (PaintBackingStoreManager*)(context else trap("no manager"))
    paint_backing_store_manager_resize_backing_stores_if_needed(this, PaintBackingStoreManagerWindowResizingInProgress.no)

## Ported from Libraries/LibWeb/Painting/BackingStoreManager.cpp:24 Web::Painting::BackingStoreManager::BackingStoreManager,
## with the default member initializers.
pub func paint_backing_store_manager_construct(this: PaintBackingStoreManager*, navigable: HtmlNavigable*):
    paint_backing_store_manager_init_fields(this)
    this.m_navigable = navigable
    this.m_backing_store_shrink_timer = core_timer_create_single_shot(3000, ak.Function0[unit](call = paint_backing_store_manager_shrink_timer_fired, context = this))

## Ported from Libraries/LibWeb/Painting/BackingStoreManager.cpp:32 Web::Painting::BackingStoreManager::visit_edges (override).
pub func paint_backing_store_manager_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (PaintBackingStoreManager*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_navigable)
