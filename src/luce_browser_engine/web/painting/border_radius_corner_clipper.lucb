#==============================================================================================
#
#   border_radius_corner_clipper - Painting::ScopedCornerRadiusClip: a rounded rect clip for
#   the lifetime of a scope
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/BorderRadiusCornerClipper.cpp (lines 1-39) and .h.
#       The C++ object saves the recorder's state and adds the rounded rect clip in its
#       constructor and restores in its destructor; the port's caller constructs it on the stack
#       and runs `paint_scoped_corner_radius_clip_destruct` where the C++ object leaves scope
#       (`defer`). CornerClip lives in the display list (DESIGN.md §4.1.3).
#
#       Copyright (c) 2022, MacDue <macdue@dueutil.tech>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/BorderRadiusCornerClipper.cpp:13 Web::Painting::ScopedCornerRadiusClip::ScopedCornerRadiusClip.
pub func paint_scoped_corner_radius_clip_construct(this: PaintScopedCornerRadiusClip*, context: DisplayListRecordingContext*, border_rect: gfx.DevicePixelRect, border_radii: display_list.BorderRadiiData, corner_clip: display_list.CornerClip = display_list.CornerClip.outside, do_apply: bool = true):
    this.m_context = context
    this.m_has_radius = false
    this.m_do_apply = do_apply
    if not do_apply:
        return
    let converter = display_list_recording_context_device_pixel_converter(context)
    let corner_radii = display_list.CornerRadii(top_left = border_radius_data_as_corner(&border_radii.top_left, converter),
                                                top_right = border_radius_data_as_corner(&border_radii.top_right, converter),
                                                bottom_right = border_radius_data_as_corner(&border_radii.bottom_right, converter),
                                                bottom_left = border_radius_data_as_corner(&border_radii.bottom_left, converter))
    this.m_has_radius = display_list.corner_radii_has_any_radius(&corner_radii)
    if not this.m_has_radius:
        return
    display_list.display_list_recorder_save(display_list_recording_context_display_list_recorder(this.m_context))
    display_list.display_list_recorder_add_rounded_rect_clip(display_list_recording_context_display_list_recorder(this.m_context), corner_radii, border_rect, corner_clip)

## `ScopedCornerRadiusClip clip { context, border_rect, border_radii, corner_clip, do_apply }` as a value; run
## `paint_scoped_corner_radius_clip_destruct` on it where the C++ object leaves scope.
pub func paint_scoped_corner_radius_clip_new(context: DisplayListRecordingContext*, border_rect: gfx.DevicePixelRect, border_radii: display_list.BorderRadiiData, corner_clip: display_list.CornerClip = display_list.CornerClip.outside, do_apply: bool = true) -> PaintScopedCornerRadiusClip:
    var clip: PaintScopedCornerRadiusClip = ---
    paint_scoped_corner_radius_clip_construct(&clip, context, border_rect, border_radii, corner_clip, do_apply)
    return clip

## Ported from Libraries/LibWeb/Painting/BorderRadiusCornerClipper.cpp:32 Web::Painting::ScopedCornerRadiusClip::~ScopedCornerRadiusClip.
pub func paint_scoped_corner_radius_clip_destruct(this: PaintScopedCornerRadiusClip*):
    if not this.m_do_apply or not this.m_has_radius:
        return
    display_list.display_list_recorder_restore(display_list_recording_context_display_list_recorder(this.m_context))
