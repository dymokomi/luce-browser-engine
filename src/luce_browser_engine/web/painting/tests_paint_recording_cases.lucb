#==============================================================================================
#
#   tests_paint_recording_cases - display lists and pixels of small documents, from the
#                                 reference build
#
#   DESCRIPTION:
#       Generated by luce-browser-tools/oracles/luce-browser-engine/paint_recording
#       (gen_luce_cases.py over the oracle's expected.txt): for each document, Ladybird's
#       Document::dump_display_list() and the pixels its DisplayListPlayerSkia renders for a
#       screenshot of the page (identical to Ladybird's own headless screenshot of the document
#       with --test-mode, checked locally), cropped to the painted area and run-length encoded
#       ("COUNTxAARRGGBB" tokens, rows top to bottom; the rest of the 800x600 page is white).
#       Also the DevicePixelConverter / DisplayListRecordingContext / ChromeMetrics values.
#
#==============================================================================================

## A document of the paint recording cases: its markup and author style sheet, and what the reference build answers.
struct TestPaintRecordingCase:
    let name: str
    let html: str
    let css: str
    let width: i32
    let height: i32
    let expected: str

## The oracle's `values` output (two-space indented lines).
let test_paint_recording_values_expected: str = "  scale 1\n    px 0 round 0 enclose 0 floor 0\n    px 64 round 1 enclose 1 floor 1\n    px 33 round 1 enclose 1 floor 0\n    px -33 round -1 enclose 0 floor -1\n    px 96 round 2 enclose 2 floor 1\n    px -96 round -2 enclose -1 floor -2\n    px 1023 round 16 enclose 16 floor 15\n    px -448 round -7 enclose -7 floor -7\n    px 659 round 10 enclose 11 floor 10\n    rect [0.515625,1.015625 10x1.515625] rounded [1,1 10x2] enclosing [0,1 10x2] point [1,1] floored_point [0,1] size [10x2] enclosing_size [10x2]\n    rect [-3,-2.515625 15.625x12] rounded [-3,-3 16x12] enclosing [-3,-3 16x12] point [-3,-3] floored_point [-3,-3] size [16x12] enclosing_size [16x12]\n    rect [8,8 784x18] rounded [8,8 784x18] enclosing [8,8 784x18] point [8,8] floored_point [8,8] size [784x18] enclosing_size [784x18]\n    css_viewport_rect [3,5 801x599]\n    device 0 css 0\n    device 1 css 64\n    device 3 css 192\n    device -5 css -320\n    device 17 css 1088\n    device 799 css 51136\n    css_rect [3,7 11x13]\n    metrics 1536 128 384 512 768 768 128\n  scale 1.5\n    px 0 round 0 enclose 0 floor 0\n    px 64 round 2 enclose 2 floor 1\n    px 33 round 1 enclose 1 floor 0\n    px -33 round -1 enclose 0 floor -1\n    px 96 round 2 enclose 3 floor 2\n    px -96 round -2 enclose -2 floor -3\n    px 1023 round 24 enclose 24 floor 23\n    px -448 round -11 enclose -10 floor -11\n    px 659 round 15 enclose 16 floor 15\n    rect [0.515625,1.015625 10x1.515625] rounded [1,2 15x2] enclosing [0,1 15x3] point [1,2] floored_point [0,1] size [15x2] enclosing_size [15x3]\n    rect [-3,-2.515625 15.625x12] rounded [-5,-4 24x18] enclosing [-5,-4 24x18] point [-5,-4] floored_point [-5,-4] size [23x18] enclosing_size [24x18]\n    rect [8,8 784x18] rounded [12,12 1176x27] enclosing [12,12 1176x27] point [12,12] floored_point [12,12] size [1176x27] enclosing_size [1176x27]\n    css_viewport_rect [2,3.328125 534x399.328125]\n    device 0 css 0\n    device 1 css 