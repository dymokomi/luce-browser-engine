## Document::dump_display_list() of each document (two-space indented lines).
let test_paint_recording_display_list_cases: TestPaintRecordingCase[9] = [
    TestPaintRecordingCase(name = "boxes", html = "<!DOCTYPE html><div class=a></div><div class=b></div>", css = "body { margin: 0; } div { width: 100px; height: 30px; margin: 5px 10px; } .a { background: #3a7; border: 5px solid #c33; } .b { background: rgb(20, 40, 200); border-width: 2px 4px 6px 8px; border-style: solid; border-color: red green blue orange; }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.b))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRect@1 rect=[10,5 110x40] color=rgb(51, 170, 119)\n    FillPath@1 path_bounding_rect=[10,5 110x40]\n    FillRect@1 rect=[10,50 112x38] color=rgb(20, 40, 200)\n    FillPath@1 path_bounding_rect=[118,50 4x38]\n    FillPath@1 path_bounding_rect=[10,82 112x6]\n    FillPath@1 path_bounding_rect=[10,50 8x38]\n    FillPath@1 path_bounding_rect=[10,50 112x2]\n  Restore@0\n"),
    TestPaintRecordingCase(name = "border-styles", html = "<!DOCTYPE html><div class=dotted></div><div class=dashed></div><div class=double></div><div class=groove></div><div class=ridge></div><div class=inset></div><div class=outset></div>", css = "body { margin: 0; display: block; } div { width: 120px; height: 10px; margin: 3px 4px; border: 6px solid rgb(40, 120, 200); } .dotted { border-style: dotted; } .dashed { border-style: dashed; border-color: rgb(200, 30, 30); } .double { border-style: double; border-width: 9px; } .groove { border-style: groove; } .ridge { border-style: ridge; } .inset { border-style: inset; } .outset { border-style: outset; border-color: rgb(10, 10, 10); }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.outset))\n  \n  DisplayList:\n  SaveLayer@0\n    DrawLine@1 from=[7,6] to=[132,6] color=rgb(40, 120, 200) thickness=6\n    DrawLine@1 from=[132,6] to=[132,21] color=rgb(40, 120, 200) thickness=6\n    DrawLine@1 from=[7,21] to=[132,21] color=rgb(40, 120, 200) thickness=6\n    DrawLine@1 from=[7,6] to=[7,21] color=rgb(40, 120, 200) thickness=6\n    DrawLine@1 from=[7,31] to=[132,31] color=rgb(200, 30, 30) thickness=6\n    DrawLine@1 from=[132,31] to=[132,46] color=rgb(200, 30, 30) thickness=6\n    DrawLine@1 from=[7,46] to=[132,46] color=rgb(200, 30, 30) thickness=6\n    DrawLine@1 from=[7,31] to=[7,46] color=rgb(200, 30, 30) thickness=6\n    FillPath@1 path_bounding_rect=[4,53 138x3]\n    FillPath@1 path_bounding_rect=[10,59 126x3]\n    FillPath@1 path_bounding_rect=[139,53 3x28]\n    FillPath@1 path_bounding_rect=[133,59 3x16]\n    FillPath@1 path_bounding_rect=[4,78 138x3]\n    FillPath@1 path_bounding_rect=[10,72 126x3]\n    FillPath@1 path_bounding_rect=[4,53 3x28]\n    FillPath@1 path_bounding_rect=[10,59 3x16]\n    FillPath@1 path_bounding_rect=[4,84 132x3]\n    FillPath@1 path_bounding_rect=[7,87 126x3]\n    FillPath@1 path_bounding_rect=[133,84 3x22]\n    FillPath@1 path_bounding_rect=[130,87 3x16]\n    FillPath@1 path_bounding_rect=[4,103 132x3]\n    FillPath@1 path_bounding_rect=[7,100 126x3]\n    FillPath@1 path_bounding_rect=[4,84 3x22]\n    FillPath@1 path_bounding_rect=[7,87 3x16]\n    FillPath@1 path_bounding_rect=[4,109 132x3]\n    FillPath@1 path_bounding_rect=[7,112 126x3]\n    FillPath@1 path_bounding_rect=[133,109 3x22]\n    FillPath@1 path_bounding_rect=[130,112 3x16]\n    FillPath@1 path_bounding_rect=[4,128 132x3]\n    FillPath@1 path_bounding_rect=[7,125 126x3]\n    FillPath@1 path_bounding_rect=[4,109 3x22]\n    FillPath@1 path_bounding_rect=[7,112 3x16]\n    FillPath@1 path_bounding_rect=[4,134 132x22]\n    FillPath@1 path_bounding_rect=[4,134 132x22]\n    FillPath@1 path_bounding_rect=[4,159 132x22]\n    FillPath@1 path_bounding_rect=[4,159 132x22]\n  Restore@0\n"),
    TestPaintRecordingCase(name = "radii", html = "<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>", css = "body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 6px; vertical-align: top; } .a { background: #c33; border-radius: 12px; } .b { background: #3a7; border: 4px solid #234; border-radius: 20px 6px 30px 0; } .c { border: 8px solid rgb(250, 160, 0); border-radius: 50%; } .d { background: rgb(80, 80, 220); border: 3px dashed rgb(0, 0, 0); border-radius: 10px / 20px; }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.d))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRectWithRoundedCorners@1 rect=[6,6 60x50] color=rgb(204, 51, 51)\n    FillRectWithRoundedCorners@1 rect=[78,6 68x58] color=rgb(51, 170, 119)\n    FillPath@1 path_bounding_rect=[78,5 68x59]\n    FillPath@1 path_bounding_rect=[158,6 76x67]\n    FillRectWithRoundedCorners@1 rect=[246,6 66x56] color=rgb(80, 80, 220)\n    DrawLine@1 from=[257,7] to=[300,7] color=rgb(0, 0, 0) thickness=3\n    DrawLine@1 from=[310,27] to=[310,40] color=rgb(0, 0, 0) thickness=3\n    DrawLine@1 from=[257,60] to=[300,60] color=rgb(0, 0, 0) thickness=3\n    DrawLine@1 from=[247,27] to=[247,40] color=rgb(0, 0, 0) thickness=3\n  Restore@0\n"),
    TestPaintRecordingCase(name = "shadows", html = "<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>", css = "body { margin: 0; } div { display: inline-block; width: 60px; height: 50px; margin: 24px 12px; background: white; vertical-align: top; } .a { box-shadow: 4px 6px 0 rgb(0, 0, 0); } .b { box-shadow: 0 0 8px 2px rgba(200, 0, 0, 0.8); } .c { border-radius: 12px; box-shadow: 5px 5px 6px rgb(0, 80, 160), -3px -3px 0 3px rgb(0, 160, 80); } .d { background: rgb(240, 220, 100); box-shadow: inset 6px 4px 5px rgba(0, 0, 0, 0.6); border-radius: 8px; }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.d))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRect@1 rect=[12,24 60x50] color=rgb(255, 255, 255)\n    PaintOuterBoxShadow@1 content_rect=[12,24 60x50] shadow_rect=[16,30 60x50] blur_radius=0 color=rgb(0, 0, 0)\n    FillRect@1 rect=[96,24 60x50] color=rgb(255, 255, 255)\n    PaintOuterBoxShadow@1 content_rect=[96,24 60x50] shadow_rect=[94,22 64x54] blur_radius=8 color=rgba(200, 0, 0, 0.8)\n    FillRectWithRoundedCorners@1 rect=[180,24 60x50] color=rgb(255, 255, 255)\n    Save@1\n      AddRoundedRectClip@1 rect=[180,24 60x50]\n      PaintOuterBoxShadow@1 content_rect=[180,24 60x50] shadow_rect=[174,18 66x56] blur_radius=0 color=rgb(0, 160, 80)\n    Restore@1\n    Save@1\n      AddRoundedRectClip@1 rect=[180,24 60x50]\n      PaintOuterBoxShadow@1 content_rect=[180,24 60x50] shadow_rect=[185,29 60x50] blur_radius=6 color=rgb(0, 80, 160)\n    Restore@1\n    FillRectWithRoundedCorners@1 rect=[264,24 60x50] color=rgb(240, 220, 100)\n    Save@1\n      AddRoundedRectClip@1 rect=[264,24 60x50]\n      PaintInnerBoxShadow@1 content_rect=[264,24 60x50] outer_shadow_rect=[259,19 82x68] inner_shadow_rect=[270,28 60x50] blur_radius=5 color=rgba(0, 0, 0, 0.6)\n    Restore@1\n  Restore@0\n"),
    TestPaintRecordingCase(name = "gradients", html = "<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div><div class=d></div>", css = "body { margin: 0; } div { display: inline-block; width: 70px; height: 70px; margin: 8px 4px; vertical-align: top; } .a { background: linear-gradient(to right, red, blue); } .b { background: linear-gradient(45deg, rgb(255, 200, 0) 20%, rgb(0, 120, 60) 80%); border-radius: 10px; } .c { background: radial-gradient(circle, white, rgb(0, 0, 160)); } .d { background: repeating-linear-gradient(90deg, black 0 5px, white 5px 10px); }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.d))\n  \n  DisplayList:\n  SaveLayer@0\n    Save@1\n      AddClipRect@1 rect=[4,8 70x70]\n      PaintLinearGradient@1 rect=[4,8 70x70]\n    Restore@1\n    Save@1\n      Save@1\n        AddRoundedRectClip@1 rect=[82,8 70x70]\n        AddClipRect@1 rect=[82,8 70x70]\n        PaintLinearGradient@1 rect=[82,8 70x70]\n      Restore@1\n    Restore@1\n    Save@1\n      AddClipRect@1 rect=[160,8 70x70]\n      PaintRadialGradient@1 rect=[160,8 70x70] center=[35,35] size=[50x50]\n    Restore@1\n    Save@1\n      AddClipRect@1 rect=[238,8 70x70]\n      PaintLinearGradient@1 rect=[238,8 70x70]\n    Restore@1\n  Restore@0\n"),
    TestPaintRecordingCase(name = "outline-clip", html = "<!DOCTYPE html><div class=a></div><div class=b></div>", css = "body { margin: 0; } div { width: 80px; height: 30px; margin: 20px; padding: 6px; border: 4px solid rgba(0, 0, 0, 0.5); } .a { background: rgb(100, 200, 100); background-clip: padding-box; outline: 3px solid rgb(200, 0, 200); outline-offset: 4px; } .b { background: rgb(100, 100, 220); background-clip: content-box; outline: 2px dashed rgb(0, 0, 0); }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.b))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRect@1 rect=[24,24 92x42] color=rgb(100, 200, 100)\n    FillPath@1 path_bounding_rect=[20,20 100x50]\n    FillRect@1 rect=[30,100 80x30] color=rgb(100, 100, 220)\n    FillPath@1 path_bounding_rect=[20,90 100x50]\n    FillPath@1 path_bounding_rect=[13,13 114x64]\n    DrawLine@1 from=[19,89] to=[120,89] color=rgb(0, 0, 0) thickness=2\n    DrawLine@1 from=[120,89] to=[120,140] color=rgb(0, 0, 0) thickness=2\n    DrawLine@1 from=[19,140] to=[120,140] color=rgb(0, 0, 0) thickness=2\n    DrawLine@1 from=[19,89] to=[19,140] color=rgb(0, 0, 0) thickness=2\n  Restore@0\n"),
    TestPaintRecordingCase(name = "text", html = "<!DOCTYPE html><p>Hello, world! The quick brown fox.</p><p class=c>Colored <span>span</span> text</p>", css = "body { margin: 0; } p { margin: 4px; } .c { color: rgb(200, 0, 0); } span { background: rgb(255, 255, 0); color: rgb(0, 0, 160); }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(InlineNode<SPAN>))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRect@1 rect=[73,26 37x18] color=rgb(255, 255, 0)\n    DrawGlyphRun@1 rect=[4,4 284x18] translation=[4,17.796875] color=rgb(0, 0, 0)\n    DrawGlyphRun@1 rect=[4,26 69x18] translation=[4,39.796875] color=rgb(200, 0, 0)\n    DrawGlyphRun@1 rect=[110,26 41x18] translation=[110.390625,39.796875] color=rgb(200, 0, 0)\n    DrawGlyphRun@1 rect=[72,26 38x18] translation=[72.671875,39.796875] color=rgb(0, 0, 160)\n  Restore@0\n"),
    TestPaintRecordingCase(name = "text-shadow", html = "<!DOCTYPE html><p>Shadowed text</p>", css = "body { margin: 0; } p { margin: 6px; font-size: 24px; text-shadow: 2px 2px 0 rgb(255, 0, 0); }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<P>))\n  \n  DisplayList:\n  SaveLayer@0\n    PaintTextShadow@1 shadow_rect=[0,0 176x28] text_rect=[0,21 176x28] draw_location=[8,8] blur_radius=0 color=rgb(255, 0, 0)\n    DrawGlyphRun@1 rect=[6,6 176x28] translation=[6,27.1875] color=rgb(0, 0, 0)\n  Restore@0\n"),
    TestPaintRecordingCase(name = "layers", html = "<!DOCTYPE html><div class=a></div><div class=b></div><div class=c></div>", css = "body { margin: 0; } div { position: absolute; width: 80px; height: 80px; } .a { left: 10px; top: 10px; background: rgb(255, 0, 0); } .b { left: 50px; top: 30px; background: rgb(0, 0, 255); opacity: 0.5; z-index: 2; } .c { left: 30px; top: 50px; background: rgb(0, 160, 0); z-index: 1; }", width = 0, height = 0, expected = "  AccumulatedVisualContext Tree:\n    [1] scroll_frame_id=1 (PaintableWithLines(BlockContainer<DIV>.c))\n      [2] effects=[opacity=0.5] (PaintableWithLines(BlockContainer<DIV>.b))\n  \n  DisplayList:\n  SaveLayer@0\n    FillRect@1 rect=[10,10 80x80] color=rgb(255, 0, 0)\n    FillRect@1 rect=[30,50 80x80] color=rgb(0, 160, 0)\n    FillRect@2 rect=[50,30 80x80] color=rgb(0, 0, 255)\n  Restore@0\n"),
]

