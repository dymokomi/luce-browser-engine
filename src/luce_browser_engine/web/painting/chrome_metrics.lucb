#==============================================================================================
#
#   chrome_metrics - Web::ChromeMetrics: the sizes of scrollbars and resizers at a page zoom
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/ChromeMetrics.h (lines 1-45). The zoom-invariant
#       constants are in types_chrome_metrics; the constructor divides each by the zoom factor,
#       so the sizes stay the same on screen whatever the page zoom.
#
#       Copyright (c) 2025, Jonathan Gamble <gamblej@gmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/ChromeMetrics.h:23 Web::ChromeMetrics::ChromeMetrics.
pub func chrome_metrics_construct(this: ChromeMetrics*, zoom_factor: f64):
    assert(zoom_factor > 0.0)
    # So we can still use device_pixels_per_css_pixel transforms at paint time.
    let inverse_zoom = gfx.CssPixels.from_f64(1.0 / zoom_factor)
    this.scroll_thumb_min_length = chrome_metrics_zoom_invariant_scroll_thumb_min_length.mul(inverse_zoom)
    this.scroll_thumb_padding_thin = chrome_metrics_zoom_invariant_scroll_thumb_padding_thin.mul(inverse_zoom)
    this.scroll_thumb_thickness_thin = chrome_metrics_zoom_invariant_scroll_thumb_thickness_thin.mul(inverse_zoom)
    this.scroll_thumb_thickness = chrome_metrics_zoom_invariant_scroll_thumb_thickness.mul(inverse_zoom)
    this.scroll_gutter_thickness = chrome_metrics_zoom_invariant_scroll_gutter_thickness.mul(inverse_zoom)
    this.resize_gripper_size = chrome_metrics_zoom_invariant_resize_gripper_size.mul(inverse_zoom)
    this.resize_gripper_padding = chrome_metrics_zoom_invariant_resize_gripper_padding.mul(inverse_zoom)

## `ChromeMetrics { zoom_factor }` as a value.
pub func chrome_metrics_new(zoom_factor: f64) -> ChromeMetrics:
    var metrics: ChromeMetrics = ---
    chrome_metrics_construct(&metrics, zoom_factor)
    return metrics
