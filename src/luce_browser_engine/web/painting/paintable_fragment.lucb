# mark: Glyph run clusters =========================================================================

## One cluster of for_each_cluster_in_glyph_run: its code units [start, end) and its advance.
struct PaintGlyphRunCluster:
    var start: usize
    var end: usize
    var width: f32

## Ported from Libraries/LibWeb/Painting/PaintableFragment.cpp:18 Web::Painting::for_each_cluster_in_glyph_run.
## The C++ template calls back for each cluster and stops on IterationDecision::Break; here it is an iterator
## (`for cluster in paint_glyph_run_clusters(...)`, `break`), DESIGN.md §2.9.
struct PaintGlyphRunClusters: luce.Iterable[PaintGlyphRunCluster, PaintGlyphRunClusters], luce.Iterator[PaintGlyphRunCluster]:
    var glyphs: const web_fonts.DrawGlyph[]
    var fragment_length_in_code_units: usize
    var index: usize
    var cursor: usize

    func iterator() -> PaintGlyphRunClusters:
        return self

    mutating func next() -> PaintGlyphRunCluster?:
        while self.index < self.glyphs.length:
            let glyph = self.glyphs[self.index]
            self.index += 1
            if glyph.glyph_width == 0.0:
                continue

            let cluster_start = self.cursor
            let cluster_end = ak.min(self.cursor + glyph.length_in_code_units, self.fragment_length_in_code_units)
            self.cursor = cluster_end

            if cluster_end <= cluster_start:
                continue

            return PaintGlyphRunCluster(start = cluster_start, end = cluster_end, width = glyph.glyph_width)
        return none

## The clusters of `glyph_run` that lie within a fragment of `fragment_length_in_code_units` code units.
func paint_glyph_run_clusters(glyph_run: const web_fonts.GlyphRun*, fragment_length_in_code_units: usize) -> PaintGlyphRunClusters:
    return PaintGlyphRunClusters(glyphs = ak.vector_span_const(&glyph_run.m_glyphs), fragment_length_in_code_units = fragment_length_in_code_units, index = 0, cursor = 0)

# mark: Construction and accessors (PaintableFragment.h) =======================================

## Ported from Libraries/LibWeb/Painting/PaintableFragment.cpp:39 Web::Painting::PaintableFragment::PaintableFragment.
pub func paint_paintable_fragment_construct(this: PaintPaintableFragment*, fragment: LayoutLineBoxFragment):
    this.m_layout_node = layout_line_box_fragment_layout_node(&fragment)
    this.m_offset = layout_line_box_fragment_offset(&fragment)
    this.m_size = layout_line_box_fragment_size(&fragment)
    this.m_start_offset = layout_line_box_fragment_start(&fragment)
    this.m_length_in_code_units = layout_line_box_fragment_length_in_code_units(&fragment)
    this.m_glyph_run = layout_line_box_fragment_glyph_run(&fragment)
    this.m_shadows = ak.Vector[PaintShadowData]()
    this.m_baseline = layout_line_box_fragment_baseline(&fragment)
    this.m_text_decoration_thickness = gfx.CssPixels.from_int(0)
    this.m_writing_mode = layout_line_box_fragment_writing_mode(&fragment)
    this.m_has_trailing_whitespace = layout_line_box_fragment_has_trailing_whitespace(&fragment)

## `PaintableFragment { fragment }` by value.
pub func paint_paintable_fragment_new(fragment: LayoutLineBoxFragment) -> PaintPaintableFragment:
    var paintable_fragment: PaintPaintableFragment = ---
    paint_paintable_fragment_construct(&paintable_fragment, fragment)
    return paintable_fragment

