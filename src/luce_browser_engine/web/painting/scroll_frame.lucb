#==============================================================================================
#
#   scroll_frame - the engine half of Painting::ScrollFrame and ScrollState: the members that
#   take a PaintableBox
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/ScrollFrame.cpp (lines 1-21), ScrollFrame.h (line 39:
#       paintable_box) and ScrollState.h (lines 39-51: create_scroll_frame_for,
#       create_sticky_frame_for). ScrollFrame and ScrollState live in the display list
#       (luce-browser-render, region r51a), where the frame's weak reference to its
#       PaintableBox is a `gc.Weak[gc.Cell]` (DESIGN.md §4.1.3); these functions cast.
#
#       Copyright (c) 2024-2025, Aliaksandr Kalenik <kalenik.aliaksandr@gmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/ScrollFrame.cpp:14 Web::Painting::ScrollFrame::ScrollFrame.
pub func scroll_frame_construct(this: display_list.ScrollFrame*, paintable_box: PaintPaintableBox*, sticky: bool, parent_index: u64):
    *this = display_list.ScrollFrame(m_paintable_box = gc.make_weak(paintable_box.cell()), m_sticky = sticky, m_parent_index = parent_index)

## Ported from Libraries/LibWeb/Painting/ScrollFrame.h:39 Web::Painting::ScrollFrame::paintable_box.
pub func scroll_frame_paintable_box(this: const display_list.ScrollFrame*) -> PaintPaintableBox*:
    let cell = gc.weak_ptr(&this.m_paintable_box) else trap("VERIFY: the scroll frame's paintable box is gone")
    return (PaintPaintableBox*)cell

## Ported from Libraries/LibWeb/Painting/ScrollState.h:39 Web::Painting::ScrollState::create_scroll_frame_for.
pub func scroll_state_create_scroll_frame_for(this: display_list.ScrollState*, paintable_box: PaintPaintableBox*, parent: u64) -> u64:
    let index = (u64)ak.vector_size(&this.m_scroll_frames)
    var frame: display_list.ScrollFrame = ---
    scroll_frame_construct(&frame, paintable_box, false, parent)
    ak.vector_append_t(&this.m_scroll_frames, frame)
    return index

## Ported from Libraries/LibWeb/Painting/ScrollState.h:46 Web::Painting::ScrollState::create_sticky_frame_for.
pub func scroll_state_create_sticky_frame_for(this: display_list.ScrollState*, paintable_box: PaintPaintableBox*, parent: u64) -> u64:
    let index = (u64)ak.vector_size(&this.m_scroll_frames)
    var frame: display_list.ScrollFrame = ---
    scroll_frame_construct(&frame, paintable_box, true, parent)
    ak.vector_append_t(&this.m_scroll_frames, frame)
    return index
