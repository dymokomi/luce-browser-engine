# mark: Construction and state ====================================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:14 Web::DisplayListRecordingContext::DisplayListRecordingContext.
pub func display_list_recording_context_construct(this: DisplayListRecordingContext*, display_list_recorder: display_list.DisplayListRecorder*, palette: gfx.Palette, device_pixels_per_css_pixel: f64, chrome_metrics: ChromeMetrics):
    *this = DisplayListRecordingContext(m_display_list_recorder = display_list_recorder, m_palette = palette, m_device_pixel_converter = PaintDevicePixelConverter(m_device_pixels_per_css_pixel = device_pixels_per_css_pixel), m_chrome_metrics = chrome_metrics)
    display_list_recording_context_init_fields(this)
    gfx.affine_transform_construct(&this.m_svg_transform)
    this.m_paint_generation_id = s_next_paint_generation_id
    s_next_paint_generation_id += 1

## `DisplayListRecordingContext context(recorder, palette, scale, metrics)` as a value.
pub func display_list_recording_context_new(display_list_recorder: display_list.DisplayListRecorder*, palette: gfx.Palette, device_pixels_per_css_pixel: f64, chrome_metrics: ChromeMetrics) -> DisplayListRecordingContext:
    var context: DisplayListRecordingContext = ---
    display_list_recording_context_construct(&context, display_list_recorder, palette, device_pixels_per_css_pixel, chrome_metrics)
    return context

