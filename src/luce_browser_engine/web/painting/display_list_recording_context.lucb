## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:23 Web::DisplayListRecordingContext::css_viewport_rect.
pub func display_list_recording_context_css_viewport_rect(this: const DisplayListRecordingContext*) -> gfx.CssPixelRect:
    let scale = paint_device_pixel_converter_device_pixels_per_css_pixel(&this.m_device_pixel_converter)
    let rect = &this.m_device_viewport_rect
    return gfx.CssPixelRect(m_location = gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64((f64)gfx.device_pixel_rect_x(rect) / scale),
                                                           m_y = gfx.CssPixels.from_f64((f64)gfx.device_pixel_rect_y(rect) / scale)),
                            m_size = gfx.CssPixelSize(m_width = gfx.CssPixels.from_f64((f64)gfx.device_pixel_rect_width(rect) / scale),
                                                      m_height = gfx.CssPixels.from_f64((f64)gfx.device_pixel_rect_height(rect) / scale)))

