# mark: Device pixels to CSS pixels ===============================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:78 Web::DisplayListRecordingContext::scale_to_css_pixels.
pub func display_list_recording_context_scale_to_css_pixels(this: const DisplayListRecordingContext*, device_pixels: i32) -> gfx.CssPixels:
    return gfx.css_pixels_nearest_value_for_f64((f64)device_pixels / paint_device_pixel_converter_device_pixels_per_css_pixel(&this.m_device_pixel_converter))

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:83 Web::DisplayListRecordingContext::scale_to_css_point.
pub func display_list_recording_context_scale_to_css_point(this: const DisplayListRecordingContext*, point: gfx.IntPoint) -> gfx.CssPixelPoint:
    return gfx.CssPixelPoint(m_x = display_list_recording_context_scale_to_css_pixels(this, point.m_x),
                             m_y = display_list_recording_context_scale_to_css_pixels(this, point.m_y))

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:91 Web::DisplayListRecordingContext::scale_to_css_size.
pub func display_list_recording_context_scale_to_css_size(this: const DisplayListRecordingContext*, size: gfx.IntSize) -> gfx.CssPixelSize:
    return gfx.CssPixelSize(m_width = display_list_recording_context_scale_to_css_pixels(this, size.m_width),
                            m_height = display_list_recording_context_scale_to_css_pixels(this, size.m_height))

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.cpp:99 Web::DisplayListRecordingContext::scale_to_css_rect.
pub func display_list_recording_context_scale_to_css_rect(this: const DisplayListRecordingContext*, rect: gfx.DevicePixelRect) -> gfx.CssPixelRect:
    return gfx.CssPixelRect(m_location = display_list_recording_context_scale_to_css_point(this, rect.m_location),
                            m_size = display_list_recording_context_scale_to_css_size(this, rect.m_size))

# mark: Cloning and accessors =====================================================================

## Ported from Libraries/LibWeb/Painting/DisplayListRecordingContext.h:73 Web::DisplayListRecordingContext::clone.
pub func display_list_recording_context_clone(this: const DisplayListRecordingContext*, painter: display_list.DisplayListRecorder*) -> DisplayListRecordingContext:
    var clone = display_list_recording_context_new(painter, this.m_palette, paint_device_pixel_converter_device_pixels_per_css_pixel(&this.m_device_pixel_converter), this.m_chrome_metrics)
    clone.m_device_viewport_rect = this.m_device_viewport_rect
    clone.m_should_show_line_box_borders = this.m_should_show_line_box_borders
    clone.m_should_paint_overlay = this.m_should_paint_overlay
    return clone

