#==============================================================================================
#
#   resolved_css_filter - Painting::ResolvedCSSFilter: CSS filters resolved for painting, and
#   the Gfx::Filter they make
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/ResolvedCSSFilter.cpp (lines 1-116) and the inline
#       members of ResolvedCSSFilter.h: composing the resolved operations (each new filter
#       outside the previous ones) into one Gfx::Filter scaled to device pixels, then the SVG
#       url() filter around them; and the filter's dump.
#
#       Copyright (c) 2025, the Ladybird developers.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/ResolvedCSSFilter.h:46 Web::Painting::ResolvedCSSFilter::has_filters.
pub func paint_resolved_css_filter_has_filters(this: const PaintResolvedCssFilter*) -> bool:
    return not ak.vector_is_empty(&this.operations) or this.svg_filter != none

## Ported from Libraries/LibWeb/Painting/ResolvedCSSFilter.h:47 Web::Painting::ResolvedCSSFilter::has_svg_filters.
pub func paint_resolved_css_filter_has_svg_filters(this: const PaintResolvedCssFilter*) -> bool:
    return this.svg_filter != none

## `resolved_filter = resolved_filter.has_value() ? Gfx::Filter::compose(new_filter, *resolved_filter) : new_filter`.
func paint_compose_resolved_filter(resolved_filter: gfx.Filter?, new_filter: gfx.Filter) -> gfx.Filter:
    if let inner = resolved_filter:
        return gfx.filter_compose(new_filter, inner)
    return new_filter

## Ported from Libraries/LibWeb/Painting/ResolvedCSSFilter.cpp:13 Web::Painting::to_gfx_filter.
pub func paint_to_gfx_filter(css_filter: PaintResolvedCssFilter, device_pixels_per_css_pixel: f64) -> gfx.Filter?:
    var resolved_filter: gfx.Filter? = none

    for operation in ak.vector_span_const(&css_filter.operations):
        match operation:
            .paint_resolved_css_filter_blur(blur):
                let resolved_radius = (f32)(blur.radius.to_double() * device_pixels_per_css_pixel)
                let new_filter = gfx.filter_blur(resolved_radius, resolved_radius)
                resolved_filter = paint_compose_resolved_filter(resolved_filter, new_filter)
            .paint_resolved_css_filter_drop_shadow(drop_shadow):
                let offset_x = (f32)(drop_shadow.offset_x.to_double() * device_pixels_per_css_pixel)
                let offset_y = (f32)(drop_shadow.offset_y.to_double() * device_pixels_per_css_pixel)
                let radius = (f32)(drop_shadow.radius.to_double() * device_pixels_per_css_pixel)
                let new_filter = gfx.filter_drop_shadow(offset_x, offset_y, radius, drop_shadow.color)
                resolved_filter = paint_compose_resolved_filter(resolved_filter, new_filter)
            .paint_resolved_css_filter_color(color):
                let new_filter = gfx.filter_color(color.operation, color.amount)
                resolved_filter = paint_compose_resolved_filter(resolved_filter, new_filter)
            .paint_resolved_css_filter_hue_rotate(hue_rotate):
                let new_filter = gfx.filter_hue_rotate(hue_rotate.angle_degrees)
                resolved_filter = paint_compose_resolved_filter(resolved_filter, new_filter)

    # SVG filters are already resolved in device pixels
    if let svg_filter = css_filter.svg_filter:
        resolved_filter = paint_compose_resolved_filter(resolved_filter, svg_filter)

    return resolved_filter

## Ported from Libraries/LibWeb/Painting/ResolvedCSSFilter.cpp:63 Web::Painting::ResolvedCSSFilter::dump.
pub func paint_resolved_css_filter_dump(this: const PaintResolvedCssFilter*, builder: ak.StringBuilder*):
    if not ak.vector_is_empty(&this.operations):
        ak.string_builder_append(builder, "filters=(")
        var first = true
        for op in ak.vector_span_const(&this.operations):
            if not first:
                ak.string_builder_append(builder, ", ")
            first = false
            match op:
                .paint_resolved_css_filter_blur(blur):
                    ak.string_builder_append(builder, "blur(")
                    ak.format_f32(builder, blur.radius.to_float())
                    ak.string_builder_append(builder, ")")
                .paint_resolved_css_filter_drop_shadow(shadow):
                    ak.string_builder_append(builder, "drop-shadow(")
                    ak.format_f32(builder, shadow.offset_x.to_float())
                    ak.string_builder_append(builder, " ")
                    ak.format_f32(builder, shadow.offset_y.to_float())
                    ak.string_builder_append(builder, " ")
                    ak.format_f32(builder, shadow.radius.to_float())
                    ak.string_builder_append(builder, " ")
                    let color_string = gfx.color_to_string(&shadow.color)
                    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&color_string))
                    ak.string_builder_append(builder, ")")
                .paint_resolved_css_filter_color(color):
                    var name = ""
                    match color.operation:
                        .brightness: name = "brightness"
                        .contrast: name = "contrast"
                        .grayscale: name = "grayscale"
                        .invert: name = "invert"
                        .opacity: name = "opacity"
                        .saturate: name = "saturate"
                        .sepia: name = "sepia"
                        _: trap("VERIFY_NOT_REACHED")
                    ak.string_builder_append(builder, name)
                    ak.string_builder_append(builder, "(")
                    ak.format_f32(builder, color.amount)
                    ak.string_builder_append(builder, ")")
                .paint_resolved_css_filter_hue_rotate(hue):
                    ak.string_builder_append(builder, "hue-rotate(")
                    ak.format_f32(builder, hue.angle_degrees)
                    ak.string_builder_append(builder, "deg)")
        ak.string_builder_append(builder, ")")
    if this.svg_filter != none:
        ak.string_builder_append(builder, " svg_filter")
