## Ported from Libraries/LibWeb/Bindings/Transferable.h:21 Web::Bindings::Transferable::transfer_steps (virtual).
## NOTE: It is an error to call Base::transfer_steps in your impl
pub func bind_transferable_transfer_steps_impl(this: BindTransferable*, arg0: HtmlTransferDataEncoder*) -> !:
    trap("pure virtual: Web::Bindings::Transferable::transfer_steps")

## Ported from Libraries/LibWeb/Bindings/Transferable.h:24 Web::Bindings::Transferable::transfer_receiving_steps (virtual).
## NOTE: It is an error to call Base::transfer_receiving_steps in your impl
pub func bind_transferable_transfer_receiving_steps_impl(this: BindTransferable*, arg0: HtmlTransferDataDecoder*) -> !:
    trap("pure virtual: Web::Bindings::Transferable::transfer_receiving_steps")

## Ported from Libraries/LibWeb/Bindings/Transferable.h:26 Web::Bindings::Transferable::primary_interface (virtual).
pub func bind_transferable_primary_interface_impl(this: BindTransferable*) -> HtmlTransferType:
    trap("pure virtual: Web::Bindings::Transferable::primary_interface")

## Ported from Libraries/LibWeb/Bindings/Transferable.h:28 Web::Bindings::Transferable::is_detached.
pub func bind_transferable_is_detached(this: BindTransferable*) -> bool:
    return this.m_detached

## Ported from Libraries/LibWeb/Bindings/Transferable.h:29 Web::Bindings::Transferable::set_detached.
pub func bind_transferable_set_detached(this: BindTransferable*, b: bool):
    this.m_detached = b
