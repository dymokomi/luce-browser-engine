## Ported from Libraries/LibWeb/Loader/LoadRequest.h:45 Web::LoadRequest::initiator_type.
pub func load_request_initiator_type(this: const LoadRequest*) -> FetchRequestInitiatorType?:
    return this.m_initiator_type

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:46 Web::LoadRequest::set_initiator_type.
pub func load_request_set_initiator_type(this: LoadRequest*, initiator_type: FetchRequestInitiatorType?):
    this.m_initiator_type = initiator_type

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:48 Web::LoadRequest::start_timer.
pub func load_request_start_timer(this: LoadRequest*):
    this.m_load_timer = ak.monotonic_time_now()

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:49 Web::LoadRequest::load_time: the time since
## start_timer (Core::ElapsedTimer::elapsed_time, zero before the timer started).
pub func load_request_load_time(this: const LoadRequest*) -> ak.Duration:
    let start = this.m_load_timer else return ak.duration_zero()
    let now = ak.monotonic_time_now()
    return ak.monotonic_time_sub_monotonic_time(&now, start)

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:51 Web::LoadRequest::page.
