## Ported from Libraries/LibWeb/Loader/LoadRequest.h:25 Web::LoadRequest::LoadRequest.
pub func load_request_construct(this: LoadRequest*, headers: HttpHeaderList*):
    load_request_init_fields(this)
    this.m_headers = headers

## `LoadRequest load_request { headers }`: a new load request over `headers`.
pub func load_request_create(headers: HttpHeaderList*) -> LoadRequest:
    var request = LoadRequest(m_headers = headers)
    load_request_construct(&request, headers)
    return request

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:30 Web::LoadRequest::url.
pub func load_request_url(this: const LoadRequest*) -> web_url.Url?:
    return this.m_url

## Ported from Libraries/LibWeb/Loader/LoadRequest.h:31 Web::LoadRequest::set_url.
pub func load_request_set_url(this: LoadRequest*, url: web_url.Url?):
    this.m_url = url

