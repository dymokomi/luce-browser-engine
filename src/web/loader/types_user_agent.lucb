# The macros of UserAgent.h for the targets the port builds (DESIGN.md §1.1): OS_STRING
# "macOS", "Linux" or "Windows"; CPU_STRING "AArch64" or "x86_64"; BROWSER_NAME "Ladybird",
# BROWSER_VERSION "1.0" and SAD_COMPATIBILITY_HACK. (Filled by region p2d: a constant cannot
# concatenate, so each target's string is written whole.)

## Web::default_user_agent (Libraries/LibWeb/Loader/UserAgent.h:70).
# C++ initializer: "Mozilla/5.0 (" OS_STRING "; " CPU_STRING ") " BROWSER_NAME "/" BROWSER_VERSION " " SAD_COMPATIBILITY_HACK ""sv
pub let default_user_agent: str = ("Mozilla/5.0 (macOS; AArch64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36" if os.macos and os.arm64 else
                                   "Mozilla/5.0 (macOS; x86_64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36" if os.macos else
                                   "Mozilla/5.0 (Linux; AArch64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36" if os.linux and os.arm64 else
                                   "Mozilla/5.0 (Linux; x86_64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36" if os.linux else
                                   "Mozilla/5.0 (Windows; AArch64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36" if os.arm64 else
                                   "Mozilla/5.0 (Windows; x86_64) Ladybird/1.0 Chrome/146.0.0.0 AppleWebKit/537.36 Safari/537.36")

## Web::default_platform (Libraries/LibWeb/Loader/UserAgent.h:71).
# C++ initializer: OS_STRING " " CPU_STRING ""sv
pub let default_platform: str = ("macOS AArch64" if os.macos and os.arm64 else "macOS x86_64" if os.macos else "Linux AArch64" if os.linux and os.arm64 else
                                 "Linux x86_64" if os.linux else "Windows AArch64" if os.arm64 else "Windows x86_64")

## Web::default_navigator_compatibility_mode (Libraries/LibWeb/Loader/UserAgent.h:72).
# C++ initializer: NavigatorCompatibilityMode :: Chrome
pub let default_navigator_compatibility_mode: NavigatorCompatibilityMode = NavigatorCompatibilityMode.chrome
