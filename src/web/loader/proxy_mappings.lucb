#==============================================================================================
#
#   proxy_mappings - ProxyMappings: which proxy a URL's requests go through
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Loader/ProxyMappings.cpp (lines 10-44). ProxyMappings::the()'s
#       static instance and the mappings it is given live in the C heap for the process
#       (DESIGN.md §3.3 rule 7).
#
#       Copyright (c) 2022, Ali Mohammad Pur <mpfard@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## `static ProxyMappings instance {};` of ProxyMappings::the().
var proxy_mappings_s_instance: ProxyMappings*?

## Ported from Libraries/LibWeb/Loader/ProxyMappings.cpp:10 Web::ProxyMappings::the.
pub func proxy_mappings_the() -> ProxyMappings*:
    if let instance = proxy_mappings_s_instance:
        return instance
    with memory.heap:
        let instance = new ProxyMappings else trap("out of memory")
        proxy_mappings_s_instance = instance
        return instance

## Ported from Libraries/LibWeb/Loader/ProxyMappings.cpp:16 Web::ProxyMappings::proxy_for_url.
pub func proxy_mappings_proxy_for_url(this: const ProxyMappings*, url: web_url.Url) -> CoreProxyData:
    let url_string = web_url.url_to_byte_string(&url)
    for it in ak.ordered_hash_map_begin_const(&this.m_mappings):
        if ak.byte_string_matches_case_sensitivity(&url_string, ak.byte_string_view(&it.key)):
            let proxy = ak.vector_at_const(&this.m_proxies, (usize)it.value)
            let maybe_url = web_url.parser_basic_parse(ak.byte_string_view(proxy))
            if maybe_url == none:
                ak.dbgln(f"Failed to parse proxy URL: {ak.string_view_text(ak.byte_string_view(proxy))}")
                continue
            let parsed_url = maybe_url else trap("VERIFY_NOT_REACHED")
            let result = core_proxy_data_parse_url(&parsed_url) catch:
                ak.dbgln(f"Failed to parse proxy URL: {ak.string_view_text(ak.byte_string_view(proxy))}")
                continue
            return result

    return CoreProxyData()

## Ported from Libraries/LibWeb/Loader/ProxyMappings.cpp:38 Web::ProxyMappings::set_mappings: the
## mappings are copied into the C heap with the instance.
pub func proxy_mappings_set_mappings(this: ProxyMappings*, proxies: ak.Vector[ak.ByteString], mappings: ak.OrderedHashMap[ak.ByteString, u64, ByteStringTraits]):
    let saved_atomic_allocator = ak.atomic_allocator
    ak.atomic_allocator = none
    defer ak.atomic_allocator = saved_atomic_allocator
    with memory.heap:
        var kept_proxies: ak.Vector[ak.ByteString]
        for proxy in ak.vector_span_const(&proxies):
            ak.vector_append_t(&kept_proxies, ak.byte_string_from_string_view(ak.byte_string_view(&proxy)))
        var kept_mappings: ak.OrderedHashMap[ak.ByteString, u64, ByteStringTraits]
        for it in ak.ordered_hash_map_begin_const(&mappings):
            _ = ak.ordered_hash_map_set(&kept_mappings, ak.byte_string_from_string_view(ak.byte_string_view(&it.key)), it.value)
        this.m_proxies = kept_proxies
        this.m_mappings = kept_mappings

    var proxies_text = ak.string_builder_new()
    ak.string_builder_append(&proxies_text, "[ ")
    for index in 0..<ak.vector_size(&this.m_proxies):
        if index != 0:
            ak.string_builder_append(&proxies_text, ", ")
        ak.string_builder_append_string_view(&proxies_text, ak.byte_string_view(ak.vector_at_const(&this.m_proxies, index)))
    ak.string_builder_append(&proxies_text, " ]")
    ak.dbgln(f"Proxy mappings updated: proxies: {ak.string_view_text(ak.string_builder_string_view(&proxies_text))}")
