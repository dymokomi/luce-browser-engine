## Ported from Libraries/LibWeb/Loader/FileRequest.cpp:11 Web::FileRequest::FileRequest.
pub func file_request_construct(this: FileRequest*, path: ak.ByteString, on_file_request_finish_callback: ak.Function1[ErrorOrI32, unit]):
    this.on_file_request_finish = on_file_request_finish_callback
    this.m_path = path

## Ported from Libraries/LibWeb/Loader/FileRequest.cpp:17 Web::FileRequest::path.
pub func file_request_path(this: const FileRequest*) -> ak.ByteString:
    return this.m_path
