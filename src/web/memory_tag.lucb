#==============================================================================================
#
#   memory_tag - what the engine is doing, as the tag of the blobs it allocates meanwhile
#
#   DESCRIPTION:
#       Addition, for diagnostics (no donor counterpart). The phases that keep most of the
#       engine's memory (parsing, style, layout, painting, image decoding) tag the blobs they
#       allocate (gc.heap_blob_tag), so that a census of the heap (the webview module's
#       memory census) can tell their storage apart; a nested phase tags its own and restores
#       the outer one's.
#
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## The phases a blob is tagged with (gc.heap_blob_tag).
pub enum MemoryTag as u16:
    untagged = 0
    ## HTML tokenizing and tree building, CSS style sheet parsing.
    parse = 1
    ## Style computation (Document::update_style).
    style = 2
    ## Layout (Document::update_layout).
    layout = 3
    ## Recording the display list (Document::record_display_list).
    paint = 4
    ## Image decoding (ImageCodecPlugin::decode_image's job).
    image = 5
    ## The GPU player's work on the CPU (the view's webview_gpu_draw): its CPU tiles, uploads
    ## and recordings.
    gpu_player = 6
    ## How many tags there are.
    count = 7

## Begins a phase: new blobs carry `tag` until memory_tag_leave(previous) with the answer:
##
##     let memory_tag = memory_tag_enter(MemoryTag.style)
##     defer memory_tag_leave(memory_tag)
pub func memory_tag_enter(tag: MemoryTag) -> u16:
    let previous = gc.heap_blob_tag
    gc.heap_blob_tag = (u16)tag
    return previous

## Ends a phase of memory_tag_enter.
pub func memory_tag_leave(previous: u16):
    gc.heap_blob_tag = previous
