pub func animations_keyframe_effect_pseudo_element(this: AnimationsKeyframeEffect*) -> ak.String?:
    let selector = this.m_target_pseudo_selector else return none
    return css_selector_pseudo_element_selector_serialize(&selector)

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:809 Web::Animations::KeyframeEffect::set_pseudo_element.
