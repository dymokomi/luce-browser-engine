## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:919 Web::Animations::KeyframeEffect::KeyframeEffect (private).
func animations_keyframe_effect_construct(this: AnimationsKeyframeEffect*, realm: Realm*):
    animations_animation_effect_construct(this.animations_animation_effect(), realm)
    # The C++ default member initializers.
    this.m_composite = BindCompositeOperation.replace

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:924 Web::Animations::KeyframeEffect::initialize (override).
func animations_keyframe_effect_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.keyframe_effect)
    animations_animation_effect_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:930 Web::Animations::KeyframeEffect::visit_edges (override).
func animations_keyframe_effect_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (AnimationsKeyframeEffect*)base
    animations_animation_effect_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_target_element)
    for object in ak.vector_span_const(&this.m_keyframe_objects):
        gc.cell_visitor_visit_cell_2(visitor, (gc.Cell*)object)

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:937 Web::Animations::KeyframeEffect::update_computed_properties (override).
func animations_keyframe_effect_update_computed_properties_impl(base: AnimationsAnimationEffect*, context: AnimationsAnimationUpdateContext*):
    let this = (AnimationsKeyframeEffect*)base
    let target = animations_animation_effect_target(base) else return
    if not dom_node_is_connected(target.dom_node()):
        return

    if dom_node_has_inclusive_ancestor_with_display_none_ignoring_animations(target.dom_node()):
        # FIXME: Reaching this point means we failed to cancel animation for an element that started
        #        being nested in "display: none".
        #        For now this hack is needed to avoid lots of unnecessary work.
        return

    let computed_properties = dom_element_computed_properties(target, animations_keyframe_effect_pseudo_element_type(this)) else return
    var abstract_element: DomAbstractElement = ---
    dom_abstract_element_construct(&abstract_element, target, animations_keyframe_effect_pseudo_element_type(this))
    if not ak.hash_map_contains_k(&context.elements, abstract_element):
        # context.elements.ensure(abstract_element, [computed_properties] { ... }): the element's animated properties
        # before this update, and its style.
        let old_animated_properties = css_computed_properties_animated_property_values(computed_properties)
        css_computed_properties_reset_non_inherited_animated_properties(computed_properties)
        let element_data = new AnimationsAnimationUpdateContextElementData(animated_properties_before_update = old_animated_properties, target_style = computed_properties) else trap("out of memory")
        _ = ak.hash_map_set(&context.elements, abstract_element, element_data)

    css_style_computer_collect_animation_into(dom_document_style_computer(dom_node_document(target.dom_node())), abstract_element, this, computed_properties)

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:963 Web::Animations::css_animation_composition_to_bindings_composite_operation.
pub func animations_css_animation_composition_to_bindings_composite_operation(composition: css_data.AnimationComposition) -> BindCompositeOperation:
    match composition:
        .accumulate:
            return BindCompositeOperation.accumulate
        .add:
            return BindCompositeOperation.add
        .replace:
            return BindCompositeOperation.replace
        _:
            trap("VERIFY_NOT_REACHED")
