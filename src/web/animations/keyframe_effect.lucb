## The `[&](CSS::PropertyID longhand_id, CSS::StyleValue const&)` callback of set_keyframes' expansion of a property:
## record the longhand as a target property.
func animations_keyframe_effect_set_keyframes_target_property(context: void*?, longhand_id: css_data.PropertyId, value: CssStyleValue*):
    _ = value
    let this = (AnimationsKeyframeEffect*)(context else trap("no captures"))
    _ = ak.hash_table_set(&this.animation_effect.m_target_properties, longhand_id)

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:882 Web::Animations::KeyframeEffect::set_keyframes.
# https://www.w3.org/TR/web-animations-1/#dom-keyframeeffect-setkeyframes
pub func animations_keyframe_effect_set_keyframes(this: AnimationsKeyframeEffect*, keyframe_object: JsObject*?) -> !:
    ak.vector_clear(&this.m_keyframe_objects)
    this.m_keyframes = try animations_process_a_keyframes_argument(bind_platform_object_realm(this.bind_platform_object()), keyframe_object)
    # FIXME: After processing the keyframe argument, we need to turn the set of keyframes into a set of computed
    #        keyframes using the procedure outlined in the second half of
    #        https://www.w3.org/TR/web-animations-1/#calculating-computed-keyframes. For now, just compute the
    #        missing keyframe offsets
    animations_compute_missing_keyframe_offsets(&this.m_keyframes)

    let keyframe_set = (new AnimationsKeyframeEffectKeyFrameSet) else trap("out of memory")
    ak.hash_table_clear(&this.animation_effect.m_target_properties)

    for keyframe in ak.vector_span(&this.m_keyframes):
        var resolved_keyframe = animations_keyframe_effect_key_frame_set_resolved_key_frame_new()
        resolved_keyframe.composite = keyframe.composite
        match keyframe.easing:
            .css_easing_function(easing):
                resolved_keyframe.easing = EmptyOrCssEasingFunctionOrCssStyleValue.css_easing_function(easing)
            .string(value):
                _ = value

        let computed_offset = keyframe.computed_offset else trap("VERIFY: Optional::value()")
        let key = (u64)(computed_offset * 100.0 * animations_keyframe_effect_animation_key_frame_key_scale_factor)

        match keyframe.properties:
            .parsed_properties(properties):
                for entry in ak.hash_map_begin_const(&properties):
                    _ = ak.hash_map_set(&resolved_keyframe.properties, entry.key, AnimationsKeyframeEffectKeyFrameSetUseInitialOrCssStyleValue.css_style_value(entry.value))
                    css_style_computer_for_each_property_expanding_shorthands(entry.key, entry.value, ak.Function2[css_data.PropertyId, CssStyleValue*, unit](call = animations_keyframe_effect_set_keyframes_target_property, context = this))
            .unparsed_properties(properties):
                _ = properties
                trap("VERIFY: Variant::get<ParsedProperties>()")

        ak.red_black_tree_insert(&keyframe_set.keyframes_by_key, key, resolved_keyframe)

    animations_keyframe_effect_generate_initial_and_final_frames(keyframe_set, &this.animation_effect.m_target_properties)
    this.m_key_frame_set = keyframe_set

