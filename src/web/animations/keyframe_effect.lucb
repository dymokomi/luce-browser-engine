    let target = this.m_target_element else return none
    var abstract_element: DomAbstractElement = ---
    dom_abstract_element_construct(&abstract_element, target, animations_keyframe_effect_pseudo_element_type(this))
    return abstract_element

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:825 Web::Animations::KeyframeEffect::set_target(DOM::AbstractElement).
pub func animations_keyframe_effect_set_target_dom_abstract_element(this: AnimationsKeyframeEffect*, abstract_element: DomAbstractElement):
    var element_reference = abstract_element
    animations_keyframe_effect_set_target(this, dom_abstract_element_element(&element_reference))
    if let pseudo_element = dom_abstract_element_pseudo_element(&element_reference):
        var selector: CssSelectorPseudoElementSelector = ---
        css_selector_pseudo_element_selector_construct_css_selector_pseudo_element_se(&selector, pseudo_element)
        this.m_target_pseudo_selector = selector
    else:
        this.m_target_pseudo_selector = none

