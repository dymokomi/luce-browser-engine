## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:738 Web::Animations::KeyframeEffect::construct_impl (source).
# https://www.w3.org/TR/web-animations-1/#dom-keyframeeffect-keyframeeffect-source
pub func animations_keyframe_effect_construct_impl_keyframe_effect(realm: Realm*, source: AnimationsKeyframeEffect*) -> AnimationsKeyframeEffect*!:
    # 1. Create a new KeyframeEffect object, effect.
    let effect = realm_create_animations_keyframe_effect(realm, realm)
    let effect_base = effect.animations_animation_effect()
    let source_base = source.animations_animation_effect()

    # 2. Set the following properties of effect using the corresponding values of source:

    #   - effect target,
    effect.m_target_element = animations_animation_effect_target(source_base)

    #   - keyframes,
    effect.m_keyframes = ak.vector_clone(&source.m_keyframes)

    #   - composite operation, and
    animations_keyframe_effect_set_composite(effect, animations_keyframe_effect_composite(source))

    #   - all specified timing properties:

    # AD-HOC: This is defined in the web-animations level 1 spec so doesn't explicitly mention the level 2 properties
    #         (specified start delay, specified end delay, specified iteration duration) but it is required that we
    #         copy these and then normalize them as opposed to copying the already normalized values which may be
    #         invalid in this context i.e. if the existing effect was associated with a progress-based timeline

    #     - specified start delay,
    effect_base.m_specified_start_delay = source_base.m_specified_start_delay

    #     - specified end delay,
    effect_base.m_specified_end_delay = source_base.m_specified_end_delay

    #     - fill mode,
    effect_base.m_fill_mode = source_base.m_fill_mode

    #     - iteration start,
    effect_base.m_iteration_start = source_base.m_iteration_start

    #     - iteration count,
    effect_base.m_iteration_count = source_base.m_iteration_count

    #     - specified iteration duration,
    effect_base.m_specified_iteration_duration = source_base.m_specified_iteration_duration

    #     - playback direction, and
    effect_base.m_playback_direction = source_base.m_playback_direction

    #     - timing function.
    effect_base.m_timing_function = source_base.m_timing_function

    animations_animation_effect_normalize_specified_timing(effect_base)

    return effect

# mark: Target ==================================================================================

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:790 Web::Animations::KeyframeEffect::set_target(DOM::Element*).
pub func animations_keyframe_effect_set_target(this: AnimationsKeyframeEffect*, target: DomElement*?):
    if let animation = animations_animation_effect_associated_animation(this.animations_animation_effect()):
        if let old_target = this.m_target_element:
            animations_animatable_disassociate_with_animation(&old_target.animatable, animation)
        if let new_target = target:
            animations_animatable_associate_with_animation(&new_target.animatable, animation)
    this.m_target_element = target

