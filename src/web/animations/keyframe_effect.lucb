# mark: Keyframes ===============================================================================

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:228 Web::Animations::compute_missing_keyframe_offsets.
# https://www.w3.org/TR/web-animations-1/#compute-missing-keyframe-offsets
func animations_compute_missing_keyframe_offsets(keyframes: ak.Vector[AnimationsBaseKeyframe]*):
    let frames = ak.vector_span(keyframes)

    # 1. For each keyframe, in keyframes, let the computed keyframe offset of the keyframe be equal to its keyframe
    #    offset value.
    for i in 0..<frames.length:
        frames[i].computed_offset = frames[i].offset

    # 2. If keyframes contains more than one keyframe and the computed keyframe offset of the first keyframe in
    #    keyframes is null, set the computed keyframe offset of the first keyframe to 0.
    if frames.length > 1 and frames[0].computed_offset == none:
        frames[0].computed_offset = 0.0

    # 3. If the computed keyframe offset of the last keyframe in keyframes is null, set its computed keyframe offset
    #    to 1.
    if frames.length > 0 and frames[frames.length - 1].computed_offset == none:
        frames[frames.length - 1].computed_offset = 1.0

    # 4. For each pair of keyframes A and B where:
    #    - A appears before B in keyframes, and
    #    - A and B have a computed keyframe offset that is not null, and
    #    - all keyframes between A and B have a null computed keyframe offset,
    var index_a = animations_find_next_index_of_keyframe_with_computed_offset(frames, 0) else return
    var maybe_index_b = animations_find_next_index_of_keyframe_with_computed_offset(frames, index_a + 1)

    while let index_b = maybe_index_b:
        # calculate the computed keyframe offset of each keyframe between A and B as follows:
        for keyframe_index in (index_a + 1)..<index_b:
            # 1. Let offsetk be the computed keyframe offset of a keyframe k.
            let offset_a = frames[index_a].computed_offset else trap("VERIFY: Optional::value()")
            let offset_b = frames[index_b].computed_offset else trap("VERIFY: Optional::value()")

            # 2. Let n be the number of keyframes between and including A and B minus 1.
            let n = f64(index_b - index_a)

            # 3. Let index refer to the position of keyframe in the sequence of keyframes between A and B such that the
            #    first keyframe after A has an index of 1.
            let index = f64(keyframe_index - index_a)

            # 4. Set the computed keyframe offset of keyframe to offsetA + (offsetB − offsetA) × index / n.
            # donor bug: the C++ parenthesizes (offsetA + (offsetB − offsetA)) × index / n; kept.
            frames[keyframe_index].computed_offset = (offset_a + (offset_b - offset_a)) * index / n

        index_a = index_b
        maybe_index_b = animations_find_next_index_of_keyframe_with_computed_offset(frames, index_b + 1)

## compute_missing_keyframe_offsets' `find_next_index_of_keyframe_with_computed_offset` lambda.
func animations_find_next_index_of_keyframe_with_computed_offset(keyframes: AnimationsBaseKeyframe[], starting_index: usize) -> usize?:
    for index in starting_index..<keyframes.length:
        if keyframes[index].computed_offset != none:
            return index

    return none

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:291 Web::Animations::is_loosely_sorted_by_offset. (Its caller,
## process_a_keyframes_argument's JS steps, is phase 3; public until then.)
# https://www.w3.org/TR/web-animations-1/#loosely-sorted-by-offset
pub func animations_is_loosely_sorted_by_offset(keyframes: const ak.Vector[AnimationsBaseKeyframe]*) -> bool:
    # The list of keyframes for a keyframe effect must be loosely sorted by offset which means that for each keyframe
    # in the list that has a keyframe offset that is not null, the offset is greater than or equal to the offset of the
    # previous keyframe in the list with a keyframe offset that is not null, if any.

    var last_offset: f64? = none
    for keyframe in ak.vector_span_const(keyframes):
        let offset = keyframe.offset else continue

        if let last = last_offset:
            if offset < last:
                return false

        last_offset = offset

    return true

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:312 Web::Animations::process_a_keyframes_argument.
# https://www.w3.org/TR/web-animations-1/#process-a-keyframes-argument
func animations_process_a_keyframes_argument(realm: Realm*, object: JsObject*?) -> ak.Vector[AnimationsBaseKeyframe]!:
    _ = realm

    # 1. If object is null, return an empty sequence of keyframes.
    if object == none:
        return ak.Vector[AnimationsBaseKeyframe]()

    # 2.-8. The keyframes are read from the JS object (its iterator or its property-indexed members), JS: phase 3.
    trap("unported (P3): Web::Animations::process_a_keyframes_argument (a JS keyframes object)")

# mark: Composite order and creation ============================================================

## Ported from Libraries/LibWeb/Animations/KeyframeEffect.cpp:629 Web::Animations::KeyframeEffect::composite_order.
# https://www.w3.org/TR/web-animations-1/#animation-composite-order
pub func animations_keyframe_effect_composite_order(a: AnimationsKeyframeEffect*, b: AnimationsKeyframeEffect*) -> i32:
    # The relative composite order of any two keyframe effects A and B within an effect stack is established by
    # comparing their properties as follows:
    let a_animation = animations_animation_effect_associated_animation(a.animations_animation_effect()) else trap("a null associated animation")
    let b_animation = animations_animation_effect_associated_animation(b.animations_animation_effect()) else trap("a null associated animation")

    # 1. Sort A and B by applying the following conditions in turn until the order is resolved,

    #    1. If A and B’s associated animations differ by class, sort by any inter-class composite order defined for
    #       the corresponding classes.
    let a_class = animations_animation_animation_class(a_animation)
    let b_class = animations_animation_animation_class(b_animation)

    # From https://www.w3.org/TR/css-animations-2/#animation-composite-order:
    # "CSS Animations with an owning element have a later composite order than CSS Transitions but an earlier
    # composite order than animations without a specific animation class."
    if a_class != b_class:
        return (i32)a_class - (i32)b_class

    #    2. If A and B are still not sorted, sort by any class-specific composite order defined by the common class of
    #       A and B’s associated animations.
    let order = animations_animation_class_specific_composite_order(a_animation, b_animation)
    if order != 0:
        return order

    #    3. If A and B are still not sorted, sort by the position of their associated animations in the global
    #       animation list.
    # (unsigned int subtraction converted to int, as the C++ return does)
    return (i32)(animations_animation_global_animation_list_order(a_animation) -% animations_animation_global_animation_list_order(b_animation))

