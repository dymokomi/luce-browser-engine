## Ported from Libraries/LibWeb/Animations/PseudoElementParsing.cpp:15 Web::Animations::pseudo_element_parsing.
# https://drafts.csswg.org/web-animations-1/#dom-keyframeeffect-pseudo-element-parsing
pub func animations_pseudo_element_parsing(realm: Realm*, value: ak.String?) -> CssSelectorPseudoElementSelector?!:
    # 1. Given the value value, perform the following steps:
    # 2. If value is not null and is an invalid <pseudo-element-selector>,
    var pseudo_element: CssSelectorPseudoElementSelector? = none
    if let text = value:
        var parsing_params: CssParsingParams = ---
        css_parsing_params_construct_realm_css_parsing_mode(&parsing_params, realm)
        pseudo_element = parse_pseudo_element_selector(parsing_params, ak.string_bytes_as_string_view(&text))
        if pseudo_element == none:
            # 1. Throw a DOMException with error name "SyntaxError".
            # 2. Abort.
            var builder = ak.string_builder_new()
            ak.string_builder_append(&builder, "Invalid pseudo-element selector: \"")
            ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))
            ak.string_builder_append(&builder, "\"")
            return try idl_throw(.idl_dom_exception(idl_syntax_error_create(realm, ak.utf16_string_from_string_builder(&builder))))

    # 3. If value is one of the legacy Selectors Level 2 single-colon selectors (':before', ':after', ':first-letter', or ':first-line'),
    # then return the equivalent two-colon selector (e.g. '::before').
    if let text = value:
        if ak.string_eq_string_view(&text, ak.sv(":before")) or ak.string_eq_string_view(&text, ak.sv(":after")) or ak.string_eq_string_view(&text, ak.sv(":first-letter")) or ak.string_eq_string_view(&text, ak.sv(":first-line")):
            let without_colon = ak.string_substring_from_byte_offset(&text, 1) else trap("MUST: substring_from_byte_offset")
            # Optional<PseudoElement> converted to Optional<PseudoElementSelector>.
            let type_ = css_data.pseudo_element_from_string(ak.string_bytes_as_string_view(&without_colon)) else return none
            var selector: CssSelectorPseudoElementSelector = ---
            css_selector_pseudo_element_selector_construct_css_selector_pseudo_element_se(&selector, type_)
            return selector

    # 4. Otherwise, return value.
    return pseudo_element
