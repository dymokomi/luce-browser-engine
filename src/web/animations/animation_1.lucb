## Ported from Libraries/LibWeb/Animations/Animation.h:80 Web::Animations::Animation::pending.
# https://www.w3.org/TR/web-animations-1/#dom-animation-pending
pub func animations_animation_pending(this: AnimationsAnimation*) -> bool:
    return this.m_pending_play_task == AnimationsAnimationTaskState.scheduled or this.m_pending_pause_task == AnimationsAnimationTaskState.scheduled

