#==============================================================================================
#
#   scroll_timeline - Animations::ScrollTimeline: a progress-based timeline driven by the
#                     scroll position of a scroll container
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Animations/ScrollTimeline.cpp (lines 1-227) with the inline
#       members of ScrollTimeline.h, by region p4a: creating one (the `scroll()` notation of
#       animation-timeline makes one with an anonymous source), its source element, the
#       computed scroll axis, its current time (the scroll progress as a percentage), its
#       propagated source, and the CSS axis conversion. construct_impl takes its options from
#       script (phase 3 calls it).
#
#       Copyright (c) 2026, Callum Law <callumlaw1709@outlook.com>.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Creation and source =====================================================================

## Ported from Libraries/LibWeb/Animations/ScrollTimeline.cpp:20 Web::Animations::ScrollTimeline::create.
pub func animations_scroll_timeline_create(realm: Realm*, document: DomDocument*, source: AnimationsScrollTimelineSource, axis: BindScrollAxis) -> AnimationsScrollTimeline*:
    let timeline = realm_create_animations_scroll_timeline(realm, realm, document, source, axis)

    # NB: The passed timestamp is ignored for ScrollTimelines so we can just pass 0 here.
    animations_animation_timeline_update_current_time(timeline.animations_animation_timeline(), 0.0)

    return timeline

## Ported from Libraries/LibWeb/Animations/ScrollTimeline.cpp:31 Web::Animations::ScrollTimeline::construct_impl.
# https://drafts.csswg.org/scroll-animations-1/#dom-scrolltimeline-scrolltimeline
pub func animations_scroll_timeline_construct_impl(realm: Realm*, options: AnimationsScrollTimelineOptions) -> AnimationsScrollTimeline*:
    let document = html_window_associated_document(as_html_window((gc.Cell*)realm_global_object(realm)))

    # 1. Let timeline be the new ScrollTimeline object.
    # 2. Set the source of timeline to:
    var source: DomElement*? = none
    # If the source member of options is present,
    # The source member of options.
    if let given = options.source:
        source = given
    # Otherwise,
    # The scrollingElement of the Document associated with the Window that is the current global object.
    elif let scrolling_element = dom_document_scrolling_element(document):
        source = scrolling_element

    # 3. Set the axis property of timeline to the corresponding value from options.
    return animations_scroll_timeline_create(realm, document, AnimationsScrollTimelineSource.element(source), options.axis)

## Ported from Libraries/LibWeb/Animations/ScrollTimeline.cpp:53 Web::Animations::ScrollTimeline::source.
pub func animations_scroll_timeline_source(this: AnimationsScrollTimeline*) -> DomElement*?:
    match this.m_source:
        .element(source):
            return source
        .anonymous_source(anonymous_source):
            match anonymous_source.scroller:
                .root:
                    return dom_document_document_element(dom_abstract_element_document(&anonymous_source.target))
                .nearest:
                    var ancestor = dom_abstract_element_parent_element(&anonymous_source.target)

                    while let element = ancestor:
                        if dom_element_is_scroll_container(element):
                            break
                        ancestor = dom_node_parent_element(element.dom_node())

                    return ancestor
                .self_:
                    var target = anonymous_source.target
                    return dom_abstract_element_element(&target)
                _:
                    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Animations/ScrollTimeline.h:39 Web::Animations::ScrollTimeline::duration (override).
pub func animations_scroll_timeline_duration_impl(base: AnimationsAnimationTimeline*) -> AnimationsTimeValue?:
    return AnimationsTimeValue(type_ = AnimationsTimeValueType.percentage, value = 100.0)

## Ported from Libraries/LibWeb/Animations/ScrollTimeline.h:42 Web::Animations::ScrollTimeline::axis.
pub func animations_scroll_timeline_axis(this: AnimationsScrollTimeline*) -> BindScrollAxis:
    return this.m_axis

