# mark: Enums ===================================================================================

## Web::Animations::AnimationClass (Libraries/LibWeb/Animations/Animation.h:19). Sorted by composite order:
## https://www.w3.org/TR/css-animations-2/#animation-composite-order
pub enum AnimationsAnimationClass as i32:
    css_animation_with_owning_element = 0
    css_transition = 1
    css_animation_without_owning_element = 2
    none_ = 3

## Web::Animations::Animation::AutoRewind (Libraries/LibWeb/Animations/Animation.h:98).
pub enum AnimationsAnimationAutoRewind as i32:
    yes = 0
    no = 1

## Web::Animations::Animation::ShouldInvalidate (Libraries/LibWeb/Animations/Animation.h:102).
pub enum AnimationsAnimationShouldInvalidate as i32:
    yes = 0
    no = 1

## Web::Animations::Animation::TaskState (Libraries/LibWeb/Animations/Animation.h:149).
pub enum AnimationsAnimationTaskState as i32:
    none_ = 0
    scheduled = 1

## Web::Animations::Animation::DidSeek (Libraries/LibWeb/Animations/Animation.h:154).
pub enum AnimationsAnimationDidSeek as i32:
    yes = 0
    no = 1

## Web::Animations::Animation::SynchronouslyNotify (Libraries/LibWeb/Animations/Animation.h:159).
pub enum AnimationsAnimationSynchronouslyNotify as i32:
    yes = 0
    no = 1

