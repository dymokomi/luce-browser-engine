## The vtable of Web::Animations::Animation.
pub let animations_animation_vtable: AnimationsAnimationVTable = AnimationsAnimationVTable(event_target_vtable = DomEventTargetVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &animations_animation_class, visit_edges = animations_animation_visit_edges_impl, finalize = animations_animation_finalize_impl), initialize = animations_animation_initialize_impl))))

## Class information of Web::Animations::Animation: EventTarget's first class id.
pub let animations_animation_class: ak.ClassInfo = ak.ClassInfo(name = "Animation", first_id = 49, last_id = 49, size = memory.size_of(AnimationsAnimation), vtable = (const void*)&animations_animation_vtable)

## is<Web::Animations::Animation>: the cell's ClassInfo is Animation's, CSSAnimation's or CSSTransition's.
pub func is_animations_animation[P: gc.IsCell](p: P*) -> bool:
    let info = p.cell().vtable.class_info
    return info == &animations_animation_class or info == &css_animation_class or info == &css_transition_class

## as_if<Web::Animations::Animation>.
pub func as_if_animations_animation[P: gc.IsCell](p: P*) -> AnimationsAnimation*?:
    if is_animations_animation(p): return (AnimationsAnimation*)p
    return none

## as<Web::Animations::Animation> (verify_cast).
pub func as_animations_animation[P: gc.IsCell](p: P*) -> AnimationsAnimation*:
    return as_if_animations_animation(p) else trap("as<Web::Animations::Animation> failed")

## realm.create<Web::Animations::Animation>(realm): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_animations_animation(realm: Realm*, realm_: Realm*) -> AnimationsAnimation*:
    let this = (AnimationsAnimation*)web_allocate_cell(realm, &animations_animation_class)
    animations_animation_construct(this, realm_)
    web_initialize_cell(this.cell(), realm)
    return this
