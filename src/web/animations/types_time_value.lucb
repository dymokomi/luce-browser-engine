# mark: AnimationsTimeValue =====================================================================

## Web::Animations::TimeValue::Type (Libraries/LibWeb/Animations/TimeValue.h:18).
pub enum AnimationsTimeValueType as u8:
    milliseconds = 0
    percentage = 1

## Web::Animations::TimeValue (Libraries/LibWeb/Animations/TimeValue.h:14).
pub struct AnimationsTimeValue:
    pub var type_: AnimationsTimeValueType
    pub var value: f64

# mark: CSSNumberish ============================================================================

## Web::CSS::CSSNumberish (Libraries/LibWeb/CSS/CSSNumericValue.h): Variant<double, GC::Root<CSSNumericValue>>.
pub enum CssCssNumberish:
    double_(value: f64)
    css_numeric_value(value: CssNumericValue*)

## Web::Animations::NullableCSSNumberish (Libraries/LibWeb/Animations/TimeValue.h:79): Variant<Empty, double,
## GC::Root<CSSNumericValue>>, where Empty is null.
pub enum AnimationsNullableCssNumberish:
    empty
    double_(value: f64)
    css_numeric_value(value: CssNumericValue*)
