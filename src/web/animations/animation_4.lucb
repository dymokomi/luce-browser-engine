## Animation's `static unsigned int next_animation_list_order` (in its constructor).
var animations_animation_next_animation_list_order: u32 = 0

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1591 Web::Animations::Animation::Animation (protected).
pub func animations_animation_construct(this: AnimationsAnimation*, realm: Realm*):
    # The C++ default member initializers.
    this.m_playback_rate = 1.0
    this.m_replace_state = BindAnimationReplaceState.active
    this.m_pending_play_task = AnimationsAnimationTaskState.none_
    this.m_pending_pause_task = AnimationsAnimationTaskState.none_

    dom_event_target_construct(this.dom_event_target(), realm)
    this.m_global_animation_list_order = animations_animation_next_animation_list_order
    animations_animation_next_animation_list_order +%= 1

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1597 Web::Animations::Animation::initialize (override).
pub func animations_animation_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.animation)
    dom_event_target_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1603 Web::Animations::Animation::visit_edges (override).
pub func animations_animation_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (AnimationsAnimation*)base
    dom_event_target_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_effect)
    gc.cell_visitor_visit_t(visitor, this.m_timeline)
    gc.cell_visitor_visit_t(visitor, this.m_current_ready_promise)
    gc.cell_visitor_visit_t(visitor, this.m_current_finished_promise)
    if let owning_element = this.m_owning_element:
        dom_abstract_element_visit(&owning_element, visitor)

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1614 Web::Animations::Animation::finalize (override).
pub func animations_animation_finalize_impl(base: gc.Cell*):
    let this = (AnimationsAnimation*)base
    gc.cell_finalize_impl(base)
    if let timeline = this.m_timeline:
        animations_animation_timeline_disassociate_with_animation(timeline, this)
