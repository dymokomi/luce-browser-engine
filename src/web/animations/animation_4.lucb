        #    the playback rate is zero, let new start time be simply ready time.
        let new_start_time = animations_time_value_sub(ready_time, animations_time_value_div(hold_time, this.m_playback_rate)) if this.m_playback_rate != 0.0 else ready_time

        # 3. Set the start time of animation to new start time.
        this.m_start_time = new_start_time

        # 4. If animation’s playback rate is not 0, make animation’s hold time unresolved.
        if this.m_playback_rate != 0.0:
            this.m_hold_time = none
    # -> If animation’s start time is resolved and animation has a pending playback rate,
    elif this.m_start_time != none and this.m_pending_playback_rate != none:
        let start_time = this.m_start_time else trap("unreachable: checked above")
        # 1. Let current time to match be the result of evaluating (ready time - start time) × playback rate for
        #    animation.
        let current_time_to_match = animations_time_value_mul(animations_time_value_sub(ready_time, start_time), this.m_playback_rate)

        # 2. Apply any pending playback rate on animation.
        animations_animation_apply_any_pending_playback_rate(this)

        # 3. If animation’s playback rate is zero, let animation’s hold time be current time to match.
        if this.m_playback_rate == 0.0:
            this.m_hold_time = current_time_to_match

        # 4. Let new start time be the result of evaluating ready time - current time to match / playback rate for
        #    animation. If the playback rate is zero, let new start time be simply ready time.
        let new_start_time = animations_time_value_sub(ready_time, animations_time_value_div(current_time_to_match, this.m_playback_rate)) if this.m_playback_rate != 0.0 else ready_time

        # 5. Set the start time of animation to new start time.
        this.m_start_time = new_start_time

    # 4. Resolve animation’s current ready promise with animation.
    idl_resolve_promise(bind_platform_object_realm(this.bind_platform_object()), animations_animation_current_ready_promise(this), bind_platform_object_wrapper(this.bind_platform_object()))

    # 5. Run the procedure to update an animation’s finished state for animation with the did seek flag set to false,
    #    and the synchronously notify flag set to false.
    animations_animation_update_finished_state(this, AnimationsAnimationDidSeek.no, AnimationsAnimationSynchronouslyNotify.no)

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1509 Web::Animations::Animation::is_ready_to_run_pending_pause_task (private).
func animations_animation_is_ready_to_run_pending_pause_task(this: AnimationsAnimation*) -> bool:
    # NB: Step 10 of the procedure to "pause an animation" requires us to schedule the pending pause task to run when
    #     the following conditions are true:

    # https://www.w3.org/TR/web-animations-1/#pause-an-animation
    # https://drafts.csswg.org/web-animations-2/#pausing-an-animation-section
    # FIXME: - the user agent has performed any processing necessary to suspend the playback of animation’s associated
    #       effect, if any.

    # - the animation is associated with a timeline that is not inactive.
    if not animations_animation_has_active_timeline(this):
        return false

    # - the animation has a resolved hold time or start time.
    if this.m_hold_time == none and this.m_start_time == none:
        return false

    return true

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1531 Web::Animations::Animation::run_pending_pause_task (private).
# Step 10 of https://www.w3.org/TR/web-animations-1/#pause-an-animation
func animations_animation_run_pending_pause_task(this: AnimationsAnimation*):
    # 1. Let ready time be the time value of the timeline associated with animation at the moment when the user agent
    #    completed processing necessary to suspend playback of animation’s associated effect.
    # FIXME: We can get a more accurate time here if we record the actual instant the above is true rather than waiting
    #        for this task to run
    let timeline = this.m_timeline else trap("a null timeline: m_timeline->current_time()")
    let ready_time = animations_animation_timeline_current_time(timeline) else trap("VERIFY: Optional::value()")

    # 2. If animation’s start time is resolved and its hold time is not resolved, let animation’s hold time be the
    #    result of evaluating (ready time - start time) × playback rate.
    # Note: The hold time might be already set if the animation is finished, or if the animation has a pending play
    #       task. In either case we want to preserve the hold time as we enter the paused state.
    if let start_time = this.m_start_time:
        if this.m_hold_time == none:
            this.m_hold_time = animations_time_value_mul(animations_time_value_sub(ready_time, start_time), this.m_playback_rate)

    # 3. Apply any pending playback rate on animation.
    animations_animation_apply_any_pending_playback_rate(this)

    # 4. Make animation’s start time unresolved.
    this.m_start_time = none

    # 5. Resolve animation’s current ready promise with animation.
    idl_resolve_promise(bind_platform_object_realm(this.bind_platform_object()), animations_animation_current_ready_promise(this), bind_platform_object_wrapper(this.bind_platform_object()))

    # 6. Run the procedure to update an animation’s finished state for animation with the did seek flag set to false,
    #    and the synchronously notify flag set to false.
    animations_animation_update_finished_state(this, AnimationsAnimationDidSeek.no, AnimationsAnimationSynchronouslyNotify.no)

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1560 Web::Animations::Animation::current_ready_promise (private).
func animations_animation_current_ready_promise(this: AnimationsAnimation*) -> JsPromiseCapability*:
    if this.m_current_ready_promise == none:
        # The current ready promise is initially a resolved Promise created using the procedure to create a new
        # resolved Promise with the animation itself as its value and created in the relevant Realm of the animation.
        this.m_current_ready_promise = idl_create_resolved_promise(bind_platform_object_realm(this.bind_platform_object()), bind_platform_object_wrapper(this.bind_platform_object()))

    return this.m_current_ready_promise else trap("unreachable: set above")

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1571 Web::Animations::Animation::current_finished_promise (private).
func animations_animation_current_finished_promise(this: AnimationsAnimation*) -> JsPromiseCapability*:
    if this.m_current_finished_promise == none:
        # The current finished promise is initially a pending Promise object.
        this.m_current_finished_promise = idl_create_promise(bind_platform_object_realm(this.bind_platform_object()))

    return this.m_current_finished_promise else trap("unreachable: set above")

## Ported from Libraries/LibWeb/Animations/Animation.cpp:1581 Web::Animations::Animation::invalidate_effect (private).
func animations_animation_invalidate_effect(this: AnimationsAnimation*):
    let effect = this.m_effect else return

    if let target = animations_animation_effect_target(effect):
        dom_document_set_needs_animated_style_update(dom_node_document(target.dom_node()))

