#==============================================================================================
#
#   types_animation_effect - declarations of Libraries/LibWeb/Animations/AnimationEffect.h
#
#   DESCRIPTION:
#       AnimationEffect, its timing dictionaries and the AnimationUpdateContext were outside
#       the skeleton's closures (opaque, or not declared); declared here by hand by region p4a
#       in the generator's shape. AnimationEffect has PlatformObject's class id (6), as
#       DocumentTimeline, and is recognized by its ClassInfo (KeyframeEffect's is the only
#       concrete one).
#
#==============================================================================================

# mark: Timing dictionaries =====================================================================

## AK::Variant<double, GC::Root<CSS::CSSNumericValue>, String>: EffectTiming's duration
## (FlattenVariant<CSS::CSSNumberish, Variant<String>>).
pub enum F64OrCssNumericValueOrString:
    f64_(value: f64)
    css_numeric_value(value: CssNumericValue*)
    string(value: ak.String)

## Web::Animations::OptionalEffectTiming (Libraries/LibWeb/Animations/AnimationEffect.h:21).
pub struct AnimationsOptionalEffectTiming:
    pub var delay: f64?
    pub var end_delay: f64?
    pub var fill: BindFillMode?
    pub var iteration_start: f64?
    pub var iterations: f64?
    pub var duration: F64OrString?
    pub var direction: BindPlaybackDirection?
    pub var easing: ak.String?

## Web::Animations::EffectTiming (Libraries/LibWeb/Animations/AnimationEffect.h:34).
pub struct AnimationsEffectTiming:
    pub var delay: f64  # C++ default: { 0 }
    pub var end_delay: f64  # C++ default: { 0 }
    pub var fill: BindFillMode  # C++ default: { Bindings::FillMode::Auto }
    pub var iteration_start: f64  # C++ default: { 0.0 }
    pub var iterations: f64  # C++ default: { 1.0 }
    pub var duration: F64OrCssNumericValueOrString  # C++ default: { "auto"_string }
    pub var direction: BindPlaybackDirection  # C++ default: { Bindings::PlaybackDirection::Normal }
    pub var easing: ak.String  # C++ default: { "linear"_string }

## An EffectTiming with C++'s default member initializers.
pub func animations_effect_timing_new() -> AnimationsEffectTiming:
    return AnimationsEffectTiming(delay = 0.0, end_delay = 0.0, fill = BindFillMode.auto, iteration_start = 0.0, iterations = 1.0, duration = F64OrCssNumericValueOrString.string(ak.string_from_str("auto")), direction = BindPlaybackDirection.normal, easing = ak.string_from_str("linear"))

## Web::Animations::ComputedEffectTiming (Libraries/LibWeb/Animations/AnimationEffect.h:48).
pub struct AnimationsComputedEffectTiming:
    pub var effect_timing: AnimationsEffectTiming  # primary base
    pub var end_time: CssCssNumberish
    pub var active_duration: CssCssNumberish
    pub var local_time: AnimationsNullableCssNumberish?
    pub var progress: f64?
    pub var current_iteration: f64?

## Web::Animations::AnimationDirection (Libraries/LibWeb/Animations/AnimationEffect.h:56).
pub enum AnimationsAnimationDirection as i32:
    forwards = 0
    backwards = 1

# mark: AnimationsAnimationUpdateContext ========================================================

## Web::Animations::AnimationUpdateContext::ElementData::PropertyMap (Libraries/LibWeb/Animations/AnimationEffect.h:68).
pub type AnimationsAnimationUpdateContextElementDataPropertyMap = ak.HashMap[css_data.PropertyId, CssStyleValue*, css_data.PropertyIdTraits]

## Web::Animations::AnimationUpdateContext::ElementData (Libraries/LibWeb/Animations/AnimationEffect.h:67).
pub struct AnimationsAnimationUpdateContextElementData:
    pub var animated_properties_before_update: AnimationsAnimationUpdateContextElementDataPropertyMap
    pub var target_style: CssComputedProperties*?

## Web::Animations::AnimationUpdateContext (Libraries/LibWeb/Animations/AnimationEffect.h:66): lives for the duration of
## an animation update and stores per-element data about animated CSS properties; its destructor
## (animations_animation_update_context_destruct, called by its owner) applies the invalidations.
pub struct AnimationsAnimationUpdateContext:
    # NOTE: This is lazily populated by KeyframeEffects as their respective animations are applied to an element.
    pub var elements: ak.HashMap[DomAbstractElement, AnimationsAnimationUpdateContextElementData*, DomAbstractElementTraits]

# mark: AnimationsAnimationEffect ===============================================================

## Web::Animations::AnimationEffect::Phase (Libraries/LibWeb/Animations/AnimationEffect.h:136). Keep this enum up to
## date with CSSTransition::Phase.
pub enum AnimationsAnimationEffectPhase as i32:
    before = 0
    active = 1
    after = 2
    idle = 3

## Web::Animations::AnimationEffect (Libraries/LibWeb/Animations/AnimationEffect.h:80).
## https://www.w3.org/TR/web-animations-1/#the-animationeffect-interface
pub struct AnimationsAnimationEffect: IsAnimationsAnimationEffect, IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var platform_object: BindPlatformObject  # primary base
    # https://drafts.csswg.org/web-animations-2/#specified-start-delay
    pub var m_specified_start_delay: f64  # C++ default: { 0.0 }
    # https://www.w3.org/TR/web-animations-1/#start-delay
    pub var m_start_delay: AnimationsTimeValue  # C++ default: { TimeValue::Type::Milliseconds, 0.0 }
    # https://drafts.csswg.org/web-animations-2/#specified-end-delay
    pub var m_specified_end_delay: f64  # C++ default: { 0.0 }
    # https://www.w3.org/TR/web-animations-1/#end-delay
    pub var m_end_delay: AnimationsTimeValue  # C++ default: { TimeValue::Type::Milliseconds, 0.0 }
    # https://www.w3.org/TR/web-animations-1/#fill-mode
    pub var m_fill_mode: BindFillMode  # C++ default: { Bindings::FillMode::Auto }
    # https://www.w3.org/TR/web-animations-1/#iteration-start
    pub var m_iteration_start: f64  # C++ default: { 0.0 }
    # https://www.w3.org/TR/web-animations-1/#iteration-count
    pub var m_iteration_count: f64  # C++ default: { 1.0 }
    # https://drafts.csswg.org/web-animations-2/#specified-iteration-duration
    pub var m_specified_iteration_duration: F64OrString  # C++ default: { "auto"_string }
    # https://www.w3.org/TR/web-animations-1/#iteration-duration
    # https://drafts.csswg.org/web-animations-2/#iteration-intervals
    # The initial iteration duration of an animation effect is simply its intrinsic iteration duration
    # NB: 0ms is the intrinsic iteration duration of an effect with no associated animation - we then update this value
    #     when an animation is associated for the first time.
    pub var m_iteration_duration: AnimationsTimeValue  # C++ default: { TimeValue::Type::Milliseconds, 0.0 }
    # https://www.w3.org/TR/web-animations-1/#playback-direction
    pub var m_playback_direction: BindPlaybackDirection  # C++ default: { Bindings::PlaybackDirection::Normal }
    # https://www.w3.org/TR/web-animations-1/#animation-associated-effect
    pub var m_associated_animation: AnimationsAnimation*?
    # https://www.w3.org/TR/web-animations-1/#time-transformations
    pub var m_timing_function: CssEasingFunction  # C++ default: { CSS::EasingFunction::linear() }
    # Used for calculating transitions in StyleComputer
    pub var m_previous_phase: AnimationsAnimationEffectPhase  # C++ default: { Phase::Idle }
    pub var m_previous_current_iteration: f64  # C++ default: { 0.0 }
    # https://www.w3.org/TR/web-animations-1/#target-property
    # Note: Only modified by child classes
    pub var m_target_properties: ak.HashTable[css_data.PropertyId, css_data.PropertyIdTraits]

    func animations_animation_effect() -> AnimationsAnimationEffect*: return (AnimationsAnimationEffect*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## Upcast to Web::Animations::AnimationEffect (implemented by every struct in its hierarchy).
pub interface IsAnimationsAnimationEffect:
    func animations_animation_effect() -> AnimationsAnimationEffect*

## Virtual functions introduced by Web::Animations::AnimationEffect.
pub struct AnimationsAnimationEffectVTable:
    pub let platform_object_vtable: BindPlatformObjectVTable
    pub let target: func(AnimationsAnimationEffect*) -> DomElement*? = animations_animation_effect_target_impl
    pub let is_keyframe_effect: func(AnimationsAnimationEffect*) -> bool = animations_animation_effect_is_keyframe_effect_impl
    pub let update_computed_properties: func(AnimationsAnimationEffect*, AnimationsAnimationUpdateContext*) -> unit

## The vtable of an animation effect: its class's AnimationsAnimationEffectVTable.
func animations_animation_effect_vt(this: AnimationsAnimationEffect*) -> const AnimationsAnimationEffectVTable*:
    return (const AnimationsAnimationEffectVTable*)this.cell().vtable

## Virtual: Web::Animations::AnimationEffect::target.
pub func animations_animation_effect_target(this: AnimationsAnimationEffect*) -> DomElement*?:
    return animations_animation_effect_vt(this).target(this)

## Virtual: Web::Animations::AnimationEffect::is_keyframe_effect.
pub func animations_animation_effect_is_keyframe_effect(this: AnimationsAnimationEffect*) -> bool:
    return animations_animation_effect_vt(this).is_keyframe_effect(this)

## Virtual: Web::Animations::AnimationEffect::update_computed_properties (pure).
pub func animations_animation_effect_update_computed_properties(this: AnimationsAnimationEffect*, context: AnimationsAnimationUpdateContext*):
    animations_animation_effect_vt(this).update_computed_properties(this, context)

## is<Web::Animations::AnimationEffect>: the cell's ClassInfo is an animation effect's (KeyframeEffect is the only
## concrete one).
pub func is_animations_animation_effect[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &animations_keyframe_effect_class
