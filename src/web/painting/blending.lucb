## Ported from Libraries/LibWeb/Painting/Blending.cpp:13 Web::Painting::mix_blend_mode_to_compositing_and_blending_operator.
pub func paint_mix_blend_mode_to_compositing_and_blending_operator(blend_mode: css_data.MixBlendMode) -> gfx.CompositingAndBlendingOperator:
    match blend_mode:
        .normal: return gfx.CompositingAndBlendingOperator.normal
        .multiply: return gfx.CompositingAndBlendingOperator.multiply
        .screen: return gfx.CompositingAndBlendingOperator.screen
        .overlay: return gfx.CompositingAndBlendingOperator.overlay
        .darken: return gfx.CompositingAndBlendingOperator.darken
        .lighten: return gfx.CompositingAndBlendingOperator.lighten
        .color_dodge: return gfx.CompositingAndBlendingOperator.color_dodge
        .color_burn: return gfx.CompositingAndBlendingOperator.color_burn
        .hard_light: return gfx.CompositingAndBlendingOperator.hard_light
        .soft_light: return gfx.CompositingAndBlendingOperator.soft_light
        .difference: return gfx.CompositingAndBlendingOperator.difference
        .exclusion: return gfx.CompositingAndBlendingOperator.exclusion
        .hue: return gfx.CompositingAndBlendingOperator.hue
        .saturation: return gfx.CompositingAndBlendingOperator.saturation
        .color: return gfx.CompositingAndBlendingOperator.color
        .luminosity: return gfx.CompositingAndBlendingOperator.luminosity
        .plus_darker: return gfx.CompositingAndBlendingOperator.plus_darker
        .plus_lighter: return gfx.CompositingAndBlendingOperator.plus_lighter
        _: trap("VERIFY_NOT_REACHED")
