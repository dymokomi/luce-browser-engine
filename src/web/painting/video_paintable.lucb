## Ported from Libraries/LibWeb/Painting/VideoPaintable.cpp:25 Web::Painting::VideoPaintable::create.
pub func paint_video_paintable_create(layout_box: LayoutVideoBox*) -> PaintVideoPaintable*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintVideoPaintable*)web_heap_allocate_cell(heap, &paint_video_paintable_class)
    gc.heap_defer_gc(heap)
    paint_video_paintable_construct(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/VideoPaintable.cpp:30 Web::Painting::VideoPaintable::VideoPaintable.
pub func paint_video_paintable_construct(this: PaintVideoPaintable*, layout_box: LayoutVideoBox*):
    paint_paintable_box_construct_layout_box(this.paint_paintable_box(), layout_box.layout_box())

## Ported from Libraries/LibWeb/Painting/VideoPaintable.cpp:56 the `paint_bitmap` lambda of
## Web::Painting::VideoPaintable::paint.
func paint_video_paintable_paint_bitmap(this: PaintVideoPaintable*, context: DisplayListRecordingContext*, bitmap: gfx.Bitmap*):
    var color_space: gfx.ColorSpace = ---
    gfx.color_space_construct(&color_space)
    let immutable = gfx.immutable_bitmap_create_color_space(bitmap, color_space)
    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
    let dst_rect = paint_get_replaced_box_painting_area(this.paint_paintable_box(), context, css_computed_values_object_fit(computed_values), gfx.bitmap_size(bitmap))
    if gfx.device_pixel_rect_is_empty(&dst_rect):
        return
    let immutable_rect = gfx.immutable_bitmap_rect(immutable)
    let scaling_mode = css_to_gfx_scaling_mode(css_computed_values_image_rendering(computed_values), gfx.device_pixel_rect_size(&immutable_rect), gfx.device_pixel_rect_size(&dst_rect))
    display_list.display_list_recorder_draw_scaled_immutable_bitmap(display_list_recording_context_display_list_recorder(context), dst_rect, dst_rect, immutable, scaling_mode)

## Ported from Libraries/LibWeb/Painting/VideoPaintable.cpp:65 the `paint_video_frame` lambda of
## Web::Painting::VideoPaintable::paint.
func paint_video_paintable_paint_video_frame(this: PaintVideoPaintable*, context: DisplayListRecordingContext*, video_element: HtmlVideoElement*):
    let source = html_media_element_ensure_external_content_source(video_element.html_media_element())
    let current = display_list.external_content_source_current_bitmap(source)

    var src_size: gfx.IntSize
    if let bitmap = current:
        let rect = gfx.immutable_bitmap_rect(bitmap)
        src_size = gfx.device_pixel_rect_size(&rect)
    elif let natural_media_size = html_video_element_natural_media_size(video_element):
        src_size = gfx.size_of_u32_to_type_i32(&natural_media_size)
    else:
        return

    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
    let dst_rect = paint_get_replaced_box_painting_area(this.paint_paintable_box(), context, css_computed_values_object_fit(computed_values), src_size)
    if gfx.device_pixel_rect_is_empty(&dst_rect):
        return
    let scaling_mode = css_to_gfx_scaling_mode(css_computed_values_image_rendering(computed_values), src_size, gfx.device_pixel_rect_size(&dst_rect))
    display_list.display_list_recorder_draw_external_content(display_list_recording_context_display_list_recorder(context), dst_rect, source, scaling_mode)

## Ported from Libraries/LibWeb/Painting/VideoPaintable.cpp:35 Web::Painting::VideoPaintable::paint (override).
pub func paint_video_paintable_paint_impl(base: PaintPaintable*, context: DisplayListRecordingContext*, phase: PaintPhase):
    let this = (PaintVideoPaintable*)base
    if not paint_paintable_is_visible(base):
        return

    paint_paintable_box_paint_impl(base, context, phase)

    if phase != PaintPhase.foreground:
        return

    let recorder = display_list_recording_context_display_list_recorder(context)
    var saver = display_list.display_list_recorder_state_saver_new(recorder)
    defer display_list.display_list_recorder_state_saver_destroy(&saver)

    let video_rect = display_list_recording_context_rounded_device_rect(context, paint_paintable_box_absolute_rect(this.paint_paintable_box()))
    display_list.display_list_recorder_add_clip_rect(recorder, video_rect)

    var corner_clip = paint_scoped_corner_radius_clip_new(context, video_rect, paint_paintable_box_normalized_border_radii_data(this.paint_paintable_box(), PaintPaintableBoxShrinkRadiiForBorders.yes))
    defer paint_scoped_corner_radius_clip_destruct(&corner_clip)

    let video_element = as_html_video_element(paint_paintable_dom_node(base) else trap("VERIFY: a video paintable has a DOM node"))

    let poster_frame = html_video_element_poster_frame(video_element)

    let representation = html_video_element_current_representation(video_element)

    match representation:
        .first_video_frame, .video_frame:
            paint_video_paintable_paint_video_frame(this, context, video_element)
        .poster_frame:
            paint_video_paintable_paint_bitmap(this, context, poster_frame else trap("VERIFY: a poster frame"))
        .transparent_black:
            # The `paint_transparent_black` lambda.
            let transparent_black = gfx.color_from_bgra(0x00000000)
            display_list.display_list_recorder_fill_rect(recorder, video_rect, transparent_black)
        _:
            _ = 0
