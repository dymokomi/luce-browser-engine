            top = paint_default_border_data() if gfx.eq_css_pixels_int(border.top, 0) else css_computed_values_border_top(computed_values),
            right = paint_default_border_data() if gfx.eq_css_pixels_int(border.right, 0) else css_computed_values_border_right(computed_values),
            bottom = paint_default_border_data() if gfx.eq_css_pixels_int(border.bottom, 0) else css_computed_values_border_bottom(computed_values),
            left = paint_default_border_data() if gfx.eq_css_pixels_int(border.left, 0) else css_computed_values_border_left(computed_values),
        )
    let radii = paint_paintable_box_normalized_border_radii_data(this)
    paint_paint_all_borders(display_list_recording_context_display_list_recorder(context), display_list_recording_context_rounded_device_rect(context, paint_paintable_box_absolute_border_box_rect(this)), border_radii_data_as_corners(&radii, display_list_recording_context_device_pixel_converter(context)), borders_data_to_device_pixels(&borders_data, *context))

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:844 Web::Painting::PaintableBox::paint_backdrop_filter (virtual).
pub func paint_paintable_box_paint_backdrop_filter_impl(this: PaintPaintableBox*, context: DisplayListRecordingContext*):
    let backdrop_filter = css_computed_values_backdrop_filter(&paint_paintable_computed_values(this.paint_paintable()).computed_values)
    if not css_filter_has_filters(&backdrop_filter):
        return

    let resolved = paint_resolve_css_filter(backdrop_filter, this)
    let backdrop_region = display_list_recording_context_rounded_device_rect(context, paint_paintable_box_absolute_border_box_rect(this))
    let border_radii_data = paint_paintable_box_normalized_border_radii_data(this)
    var corner_clipper: PaintScopedCornerRadiusClip = ---
    paint_scoped_corner_radius_clip_construct(&corner_clipper, context, backdrop_region, border_radii_data)
    defer paint_scoped_corner_radius_clip_destruct(&corner_clipper)
    if let gfx_filter = paint_to_gfx_filter(resolved, display_list_recording_context_device_pixels_per_css_pixel(context)):
        display_list.display_list_recorder_apply_backdrop_filter(display_list_recording_context_display_list_recorder(context), backdrop_region, border_radii_data_as_corners(&border_radii_data, display_list_recording_context_device_pixel_converter(context)), gfx_filter)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:856 Web::Painting::PaintableBox::paint_background (virtual).
pub func paint_paintable_box_paint_background_impl(this: PaintPaintableBox*, context: DisplayListRecordingContext*):
    let document = paint_paintable_document(this.paint_paintable())
    # If the body's background properties were propagated to the root element, do not re-paint the body's background.
    let layout_node = paint_paintable_box_layout_node_with_style_and_box_metrics(this)
    if layout_node_with_style_is_body(layout_node.layout_node_with_style()):
        let html_element = dom_document_html_element(document) else trap("a body without an html element")
        if html_html_element_should_use_body_background_properties(html_element):
            return

    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values

    var background_rect = gfx.CssPixelRect()
    var background_color = css_computed_values_background_color(computed_values)
    var own_layers = css_computed_values_background_layers(computed_values)
    var background_layers: const ak.Vector[CssBackgroundLayerData]*? = &own_layers

    # https://drafts.csswg.org/css-backgrounds/#root-background
    let is_root = layout_node_is_root_element(layout_node.layout_node())
    if is_root:
        background_rect = paint_paintable_box_absolute_border_box_rect(this)

        let html_element = as_html_html_element(layout_node_dom_node(layout_node.layout_node()) else trap("the root element has no DOM node"))
        if html_html_element_should_use_body_background_properties(html_element):
            background_layers = dom_document_background_layers(document)
            background_color = dom_document_background_color(document)
    else:
        background_rect = paint_paintable_box_absolute_padding_box_rect(this)

    # HACK: If the Box has a border, use the bordered_rect to paint the background.
    #       This way if we have a border-radius there will be no gap between the filling and actual border.
    if css_computed_values_border_top(computed_values).width != gfx.CssPixels.from_int(0) or css_computed_values_border_right(computed_values).width != gfx.CssPixels.from_int(0) or css_computed_values_border_bottom(computed_values).width != gfx.CssPixels.from_int(0) or css_computed_values_border_left(computed_values).width != gfx.CssPixels.from_int(0):
        background_rect = paint_paintable_box_absolute_border_box_rect(this)

    let border_radii = paint_paintable_box_normalized_border_radii_data(this)

    var resolved_background = PaintResolvedBackground()
    if let layers = background_layers:
        resolved_background = paint_resolve_background_layers(*layers, this, background_color, css_computed_values_background_color_clip(computed_values), background_rect, border_radii)

    if is_root:
        let navigable = paint_paintable_navigable(this.paint_paintable()) else trap("the root element's document has no navigable")
        var canvas_rect = html_navigable_viewport_rect(navigable)
        if let overflow_rect = paint_paintable_box_scrollable_overflow_rect(this):
            gfx.css_pixel_rect_unite(&canvas_rect, overflow_rect)
        gfx.css_pixel_rect_unite(&resolved_background.background_rect, canvas_rect)
        gfx.css_pixel_rect_unite(&resolved_background.color_box.rect, canvas_rect)

    # If the body's background was propagated to the root element, use the body's image-rendering value.
    var image_rendering = css_computed_values_image_rendering(computed_values)
    if layout_node_is_root_element(paint_paintable_layout_node(this.paint_paintable())):
        if let html_element = dom_document_html_element(document):
            if html_html_element_should_use_body_background_properties(html_element):
                image_rendering = dom_document_background_image_rendering(document)

    paint_paint_background(context, this, image_rendering, resolved_background, border_radii)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:910 Web::Painting::PaintableBox::paint_box_shadow (virtual).
pub func paint_paintable_box_paint_box_shadow_impl(this: PaintPaintableBox*, context: DisplayListRecordingContext*):
    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
    var box_shadow_layers = css_computed_values_box_shadow(computed_values)
    if ak.vector_is_empty(&box_shadow_layers):
        return
    var resolved_box_shadow_data: ak.Vector[PaintShadowData]
    ak.vector_ensure_capacity(&resolved_box_shadow_data, ak.vector_size(&box_shadow_layers))
    for layer in ak.vector_span(&box_shadow_layers):
        ak.vector_unchecked_append_u(&resolved_box_shadow_data, paint_shadow_data_from_css(layer, paint_paintable_layout_node(this.paint_paintable())))
    let borders_data = display_list.BordersData(
        top = css_computed_values_border_top(computed_values),
        right = css_computed_values_border_right(computed_values),
        bottom = css_computed_values_border_bottom(computed_values),
        left = css_computed_values_border_left(computed_values),
    )
    paint_paint_box_shadow(context, paint_paintable_box_absolute_border_box_rect(this), paint_paintable_box_absolute_padding_box_rect(this),
                           borders_data, paint_paintable_box_normalized_border_radii_data(this), resolved_box_shadow_data)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:929 Web::Painting::PaintableBox::normalized_border_radii_data.
pub func paint_paintable_box_normalized_border_radii_data(this: PaintPaintableBox*, shrink: PaintPaintableBoxShrinkRadiiForBorders = PaintPaintableBoxShrinkRadiiForBorders.no) -> display_list.BorderRadiiData:
    var border_radii_data = paint_paintable_box_border_radii_data(this)
    if shrink == PaintPaintableBoxShrinkRadiiForBorders.yes:
        let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
        display_list.border_radii_data_shrink(&border_radii_data, css_computed_values_border_top(computed_values).width, css_computed_values_border_right(computed_values).width, css_computed_values_border_bottom(computed_values).width, css_computed_values_border_left(computed_values).width)
    return border_radii_data

# mark: Visual contexts ===========================================================================

## `document().page().client().device_pixels_per_css_pixel()` as a float.
func paint_paintable_box_pixel_ratio(this: PaintPaintableBox*) -> f32:
    return (f32)page_client_device_pixels_per_css_pixel(page_client(dom_document_page(paint_paintable_document(this.paint_paintable()))))

## The document's ViewportPaintable.
func paint_paintable_box_viewport_paintable(this: PaintPaintableBox*) -> PaintViewportPaintable*:
    return dom_document_paintable(paint_paintable_document(this.paint_paintable())) else trap("the document has no paintable")

## `point.to_type<float>() * pixel_ratio`.
func paint_css_point_to_device_float(point: gfx.CssPixelPoint, pixel_ratio: f32) -> gfx.FloatPoint:
    return gfx.FloatPoint(m_x = point.m_x.to_float() * pixel_ratio, m_y = point.m_y.to_float() * pixel_ratio)

## `(point / pixel_ratio).to_type<CSSPixels>()`.
func paint_device_float_to_css_point(point: gfx.FloatPoint, pixel_ratio: f32) -> gfx.CssPixelPoint:
    return gfx.CssPixelPoint(gfx.CssPixels.from_f32(point.m_x / pixel_ratio), gfx.CssPixels.from_f32(point.m_y / pixel_ratio))

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:937 Web::Painting::PaintableBox::transform_point_to_local.
pub func paint_paintable_box_transform_point_to_local(this: PaintPaintableBox*, screen_position: gfx.CssPixelPoint) -> gfx.CssPixelPoint?:
    if this.m_accumulated_visual_context_index == 0:
        return screen_position
    let pixel_ratio = paint_paintable_box_pixel_ratio(this)
    let viewport_paintable = paint_paintable_box_viewport_paintable(this)
    let scroll_state = paint_viewport_paintable_scroll_state_snapshot(viewport_paintable)
    let visual_context_tree = paint_viewport_paintable_visual_context_tree(viewport_paintable)
    let result = display_list.accumulated_visual_context_tree_transform_point_for_hit_test(visual_context_tree, this.m_accumulated_visual_context_index, paint_css_point_to_device_float(screen_position, pixel_ratio), &scroll_state) else return none
    return paint_device_float_to_css_point(result, pixel_ratio)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:950 Web::Painting::PaintableBox::transform_point_to_local_for_descendants.
pub func paint_paintable_box_transform_point_to_local_for_descendants(this: PaintPaintableBox*, screen_position: gfx.CssPixelPoint) -> gfx.CssPixelPoint?:
    if this.m_accumulated_visual_context_for_descendants_index == 0:
        return screen_position
    let pixel_ratio = paint_paintable_box_pixel_ratio(this)
    let viewport_paintable = paint_paintable_box_viewport_paintable(this)
    let scroll_state = paint_viewport_paintable_scroll_state_snapshot(viewport_paintable)
    let visual_context_tree = paint_viewport_paintable_visual_context_tree(viewport_paintable)
    let result = display_list.accumulated_visual_context_tree_transform_point_for_hit_test(visual_context_tree, this.m_accumulated_visual_context_for_descendants_index, paint_css_point_to_device_float(screen_position, pixel_ratio), &scroll_state) else return none
    return paint_device_float_to_css_point(result, pixel_ratio)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:963 Web::Painting::PaintableBox::transform_rect_to_viewport.
pub func paint_paintable_box_transform_rect_to_viewport(this: PaintPaintableBox*, rect: gfx.CssPixelRect) -> gfx.CssPixelRect:
    if this.m_accumulated_visual_context_index == 0:
        return rect
    let pixel_ratio = paint_paintable_box_pixel_ratio(this)
    let viewport_paintable = paint_paintable_box_viewport_paintable(this)
    let scroll_state = paint_viewport_paintable_scroll_state_snapshot(viewport_paintable)
    let visual_context_tree = paint_viewport_paintable_visual_context_tree(viewport_paintable)
    let float_rect = gfx.css_pixel_rect_to_type_f32(&rect)
    let device_rect = gfx.float_rect_mul(&float_rect, pixel_ratio)
    let result = display_list.accumulated_visual_context_tree_transform_rect_to_viewport(visual_context_tree, this.m_accumulated_visual_context_index, device_rect, &scroll_state)
    let css_rect = gfx.float_rect_mul(&result, 1.0 / pixel_ratio)
    return gfx.float_rect_to_type_css_pixels(&css_rect)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:974 Web::Painting::PaintableBox::inverse_transform_point.
pub func paint_paintable_box_inverse_transform_point(this: PaintPaintableBox*, screen_position: gfx.CssPixelPoint) -> gfx.CssPixelPoint:
    if this.m_accumulated_visual_context_index == 0:
        return screen_position
    let pixel_ratio = paint_paintable_box_pixel_ratio(this)
    let visual_context_tree = paint_viewport_paintable_visual_context_tree(paint_paintable_box_viewport_paintable(this))
    let result = display_list.accumulated_visual_context_tree_inverse_transform_point(visual_context_tree, this.m_accumulated_visual_context_index, paint_css_point_to_device_float(screen_position, pixel_ratio))
    return paint_device_float_to_css_point(result, pixel_ratio)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:984 Web::Painting::PaintableBox::transform_to_local_coordinates.
pub func paint_paintable_box_transform_to_local_coordinates(this: PaintPaintableBox*, screen_position: gfx.CssPixelPoint) -> gfx.CssPixelPoint:
    return paint_paintable_box_transform_point_to_local(this, screen_position) else screen_position
