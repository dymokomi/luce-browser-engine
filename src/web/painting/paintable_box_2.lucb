        bottom = borders_data.bottom.border_data,
        left = borders_data.left.border_data,
    )

## `CSS::BorderData()`: a default border (transparent, no line style, zero width).
func paint_default_border_data() -> display_list.BorderData:
    var border_data = display_list.BorderData()
    display_list.border_data_init_fields(&border_data)
    return border_data

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:833 Web::Painting::PaintableBox::paint_border (virtual).
pub func paint_paintable_box_paint_border_impl(this: PaintPaintableBox*, context: DisplayListRecordingContext*):
    var borders_data: display_list.BordersData = ---
    if let override_borders_data = this.m_override_borders_data:
