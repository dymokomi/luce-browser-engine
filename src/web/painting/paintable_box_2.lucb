## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:803 Web::Painting::PaintableBox::set_stacking_context.
pub func paint_paintable_box_set_stacking_context(this: PaintPaintableBox*, stacking_context: PaintStackingContext*):
    this.m_stacking_context = stacking_context

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:808 Web::Painting::PaintableBox::invalidate_stacking_context.
