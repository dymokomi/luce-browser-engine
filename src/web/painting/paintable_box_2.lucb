## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:823 Web::Painting::PaintableBox::remove_element_kind_from_borders_data.
pub func paint_paintable_box_remove_element_kind_from_borders_data(borders_data: PaintPaintableBoxBordersDataWithElementKind) -> display_list.BordersData:
    return display_list.BordersData(
        top = borders_data.top.border_data,
