    this.m_stacking_context = none

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:813 Web::Painting::PaintableBox::effective_z_index.
pub func paint_paintable_box_effective_z_index(this: PaintPaintableBox*) -> i32?:
    # https://drafts.csswg.org/css2/#z-index
    # Applies to: positioned elements
    if paint_paintable_is_positioned(this.paint_paintable()):
        return css_computed_values_z_index(&paint_paintable_computed_values(this.paint_paintable()).computed_values)

    return none

