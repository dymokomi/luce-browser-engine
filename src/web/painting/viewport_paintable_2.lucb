## Ported from Libraries/LibWeb/Painting/ViewportPaintable.cpp:515 Web::Painting::ViewportPaintable::selection.
pub func paint_viewport_paintable_selection(this: PaintViewportPaintable*) -> SelectionSelection*?:
    return dom_document_get_selection(paint_paintable_document(this.paint_paintable()))

## Ported from Libraries/LibWeb/Painting/ViewportPaintable.cpp:520 Web::Painting::ViewportPaintable::recompute_selection_states.
pub func paint_viewport_paintable_recompute_selection_states(this: PaintViewportPaintable*, range: DomRange*):
    # 1. Start by resetting the selection state of all layout nodes to None.
    for paintable in paint_paintable_inclusive_subtree(this.paint_paintable()):
        paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.none_)

    let abstract_range = range.dom_abstract_range()
    let start_container = dom_abstract_range_start_container(abstract_range)
    let end_container = dom_abstract_range_end_container(abstract_range)
    let start_node = dom_abstract_range_start(abstract_range).node
    let end_node = dom_abstract_range_end(abstract_range).node

    # 2. If the selection starts and ends in the same node:
    if start_container == end_container:
        # 1. If the selection starts and ends at the same offset, return.
        if dom_abstract_range_start_offset(abstract_range) == dom_abstract_range_end_offset(abstract_range):
            # NOTE: A zero-length selection should not be visible.
            return

        # 2. If it's a text node, mark it as StartAndEnd and return.
        if is_dom_text(start_container) and not dom_node_is_inert(start_node):
            if let paintable = dom_node_unsafe_paintable(start_container):
                paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.start_and_end)
            return

    # 3. Mark the selection start node as Start (if text) or Full (if anything else).
    if let paintable = dom_node_unsafe_paintable(start_container):
        if not dom_node_is_inert(start_node):
            if is_dom_text(start_container):
                paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.start)
            else:
                paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.full)

    # 4. Mark the nodes between the start and end of the selection as Full.
    var start_at = tree_node_child_at_index(start_container, (usize)dom_abstract_range_start_offset(abstract_range))
    # If the start container has no child at that index, we need to start on the node right after the start container.
    if start_at == none:
        if let last_child = tree_node_last_child(start_container):
            start_at = tree_node_next_in_pre_order(last_child)
        else:
            start_at = tree_node_next_in_pre_order(start_container)

    let stop_at = tree_node_child_at_index(end_container, (usize)dom_abstract_range_end_offset(abstract_range))
    # Only stop at the end container if it has no children that may need to be included.
    var node_or_none = start_at
    while let node = node_or_none:
        if node_or_none == stop_at or (node == end_container and not tree_node_has_children(end_container)):
            break
        node_or_none = tree_node_next_in_pre_order_t(node, end_container)
        if dom_node_is_inert(node):
            continue
        if let paintable = dom_node_unsafe_paintable(node):
            paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.full)

    # 5. Mark the selection end node as End if it is a text node.
    if let paintable = dom_node_unsafe_paintable(end_container):
        if not dom_node_is_inert(end_node) and is_dom_text(end_container):
            paint_paintable_set_selection_state(paintable, PaintPaintableSelectionState.end)

