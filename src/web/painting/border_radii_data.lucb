#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/BorderRadiiData.cpp:13 Web::Painting::BorderRadiusData::as_corner.
pub func border_radius_data_as_corner(this: const display_list.BorderRadiusData*, device_pixel_scale: PaintDevicePixelConverter) -> display_list.CornerRadius:
    return display_list.CornerRadius(horizontal_radius = paint_device_pixel_converter_floored_device_pixels(&device_pixel_scale, this.horizontal_radius),
                                     vertical_radius = paint_device_pixel_converter_floored_device_pixels(&device_pixel_scale, this.vertical_radius))

## Ported from Libraries/LibWeb/Painting/BorderRadiiData.h:148 Web::Painting::BorderRadiiData::as_corners.
pub func border_radii_data_as_corners(this: const display_list.BorderRadiiData*, device_pixel_converter: PaintDevicePixelConverter) -> display_list.CornerRadii:
    if not display_list.border_radii_data_has_any_radius(this):
        return display_list.CornerRadii()
    return display_list.CornerRadii(top_left = border_radius_data_as_corner(&this.top_left, device_pixel_converter),
                                    top_right = border_radius_data_as_corner(&this.top_right, device_pixel_converter),
                                    bottom_right = border_radius_data_as_corner(&this.bottom_right, device_pixel_converter),
                                    bottom_left = border_radius_data_as_corner(&this.bottom_left, device_pixel_converter))

## Ported from Libraries/LibWeb/Painting/BordersData.cpp:12 Web::Painting::BordersData::to_device_pixels.
pub func borders_data_to_device_pixels(this: const display_list.BordersData*, context: DisplayListRecordingContext) -> display_list.BordersDataDevicePixels:
    return display_list.BordersDataDevicePixels(
        top = display_list.BorderDataDevicePixels(color = this.top.color, line_style = this.top.line_style, width = display_list_recording_context_enclosing_device_pixels(&context, this.top.width)),
        right = display_list.BorderDataDevicePixels(color = this.right.color, line_style = this.right.line_style, width = display_list_recording_context_enclosing_device_pixels(&context, this.right.width)),
        bottom = display_list.BorderDataDevicePixels(color = this.bottom.color, line_style = this.bottom.line_style, width = display_list_recording_context_enclosing_device_pixels(&context, this.bottom.width)),
        left = display_list.BorderDataDevicePixels(color = this.left.color, line_style = this.left.line_style, width = display_list_recording_context_enclosing_device_pixels(&context, this.left.width)))
