#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## AK/Debug.h's HIGHLIGHT_FOCUSED_FRAME_DEBUG (0 in the reference build).
let paint_highlight_focused_frame_debug: bool = false

## Ported from Libraries/LibWeb/Painting/NavigableContainerViewportPaintable.h:19 Web::Painting::NavigableContainerViewportPaintable::is_navigable_container_viewport_paintable (override).
pub func paint_navigable_container_viewport_paintable_is_navigable_container_viewport_paintable_impl(base: PaintPaintable*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/Painting/NavigableContainerViewportPaintable.cpp:21 Web::Painting::NavigableContainerViewportPaintable::create.
pub func paint_navigable_container_viewport_paintable_create(layout_box: LayoutNavigableContainerViewport*) -> PaintNavigableContainerViewportPaintable*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintNavigableContainerViewportPaintable*)web_heap_allocate_cell(heap, &paint_navigable_container_viewport_paintable_class)
    gc.heap_defer_gc(heap)
    paint_navigable_container_viewport_paintable_construct(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/NavigableContainerViewportPaintable.cpp:26 Web::Painting::NavigableContainerViewportPaintable::NavigableContainerViewportPaintable.
pub func paint_navigable_container_viewport_paintable_construct(this: PaintNavigableContainerViewportPaintable*, layout_box: LayoutNavigableContainerViewport*):
    paint_paintable_box_construct_layout_box(this.paint_paintable_box(), layout_box.layout_box())

## Ported from Libraries/LibWeb/Painting/NavigableContainerViewportPaintable.h:25 Web::Painting::NavigableContainerViewportPaintable::navigable_container.
pub func paint_navigable_container_viewport_paintable_navigable_container(this: PaintNavigableContainerViewportPaintable*) -> HtmlNavigableContainer*:
    return as_html_navigable_container(paint_paintable_dom_node(this.paint_paintable()) else trap("VERIFY: a navigable container viewport paintable has a DOM node"))

## Ported from Libraries/LibWeb/Painting/NavigableContainerViewportPaintable.cpp:31 Web::Painting::NavigableContainerViewportPaintable::paint (override).
pub func paint_navigable_container_viewport_paintable_paint_impl(base: PaintPaintable*, context: DisplayListRecordingContext*, phase: PaintPhase):
    let this = (PaintNavigableContainerViewportPaintable*)base
    if not paint_paintable_is_visible(base):
        return

    paint_paintable_box_paint_impl(base, context, phase)

    if phase == PaintPhase.foreground:
        let absolute_rect = paint_paintable_box_absolute_rect(this.paint_paintable_box())
        let clip_rect = display_list_recording_context_rounded_device_rect(context, absolute_rect)
        var corner_clip = paint_scoped_corner_radius_clip_new(context, clip_rect, paint_paintable_box_normalized_border_radii_data(this.paint_paintable_box(), PaintPaintableBoxShrinkRadiiForBorders.yes))
        defer paint_scoped_corner_radius_clip_destruct(&corner_clip)

        let navigable_container = paint_navigable_container_viewport_paintable_navigable_container(this)
        let hosted_document = html_navigable_container_content_document_without_origin_check(navigable_container) else return

        if dom_document_is_render_blocked(hosted_document):
            return

        let content_navigable = html_navigable_container_content_navigable(navigable_container) else trap("VERIFY: content_navigable")

        let recorder = display_list_recording_context_display_list_recorder(context)
        display_list.display_list_recorder_save(recorder)
        display_list.display_list_recorder_add_clip_rect(recorder, clip_rect)
        display_list.display_list_recorder_draw_external_content(recorder,
                                                                 display_list_recording_context_enclosing_device_rect(context, absolute_rect),
                                                                 html_navigable_external_content_source(content_navigable),
                                                                 gfx.ScalingMode.nearest_neighbor)
        display_list.display_list_recorder_restore(recorder)

        if paint_highlight_focused_frame_debug:
            if html_navigable_is_focused(content_navigable):
                display_list.display_list_recorder_draw_rect(recorder, clip_rect, gfx.color_new_named_color(gfx.ColorNamedColor.cyan))
