## Ported from Libraries/LibWeb/Painting/ShadowData.h:22 Web::Painting::shadow_placement_from_css.
pub func paint_shadow_placement_from_css(placement: CssShadowPlacement) -> PaintShadowPlacement:
    match placement:
        .outer: return PaintShadowPlacement.outer
        .inner: return PaintShadowPlacement.inner
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Painting/ShadowData.h:41 Web::Painting::ShadowData::from_css.
pub func paint_shadow_data_from_css(shadow: CssShadowData, layout_node: LayoutNode*) -> PaintShadowData:
    return PaintShadowData(color = shadow.color,
                           offset_x = css_length_to_px_layout_node(&shadow.offset_x, layout_node),
                           offset_y = css_length_to_px_layout_node(&shadow.offset_y, layout_node),
                           blur_radius = css_length_to_px_layout_node(&shadow.blur_radius, layout_node),
                           spread_distance = css_length_to_px_layout_node(&shadow.spread_distance, layout_node),
                           placement = paint_shadow_placement_from_css(shadow.placement))
