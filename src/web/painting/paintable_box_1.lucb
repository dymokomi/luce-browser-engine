## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:134 Web::Painting::PaintableBox::reset_for_relayout (virtual).
pub func paint_paintable_box_reset_for_relayout_impl(this: PaintPaintableBox*):
    let paintable = this.paint_paintable()
    if tree_node_parent(paintable) != none:
        tree_node_remove(paintable)
    while let child = tree_node_first_child(paintable):
        tree_node_remove(child)

    paintable.m_containing_block = none
    paintable.m_has_containing_block = false

    this.m_offset = gfx.CssPixelPoint()
    this.m_content_size = gfx.CssPixelSize()

    this.m_box_model = PaintBoxModelMetrics()

    this.m_overflow_data = none
    this.m_override_borders_data = none
    this.m_table_cell_coordinates = none
    this.m_sticky_insets = none

    this.m_absolute_rect = none
    this.m_absolute_padding_box_rect = none
    this.m_absolute_border_box_rect = none

    this.m_enclosing_scroll_frame_index = 0
    this.m_own_scroll_frame_index = 0
    this.m_accumulated_visual_context_index = 0
    this.m_accumulated_visual_context_for_descendants_index = 0

    this.m_used_values_for_grid_template_columns = none
    this.m_used_values_for_grid_template_rows = none

    paint_paintable_box_invalidate_paint_cache(this)

    paint_paintable_box_invalidate_stacking_context(this)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:170 Web::Painting::PaintableBox::visit_edges (override).
pub func paint_paintable_box_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (PaintPaintableBox*)base
    paint_paintable_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_stacking_context)
    gc.cell_visitor_visit_t(visitor, this.m_horizontal_scrollbar)
    gc.cell_visitor_visit_t(visitor, this.m_vertical_scrollbar)
    gc.cell_visitor_visit_t(visitor, this.m_resize_handle)

