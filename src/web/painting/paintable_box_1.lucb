pub func paint_paintable_box_compute_absolute_rect_impl(this: PaintPaintableBox*) -> gfx.CssPixelRect:
    var rect = gfx.CssPixelRect(paint_paintable_box_offset(this), paint_paintable_box_content_size(this))
