    let top = css_length_box_top_const(&margin)
    let right = css_length_box_right_const(&margin)
    let bottom = css_length_box_bottom_const(&margin)
    let left = css_length_box_left_const(&margin)
    let top_length = css_length_percentage_or_auto_length(&top)
    let right_length = css_length_percentage_or_auto_length(&right)
    let bottom_length = css_length_percentage_or_auto_length(&bottom)
    let left_length = css_length_percentage_or_auto_length(&left)
