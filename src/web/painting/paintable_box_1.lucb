## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:110 Web::Painting::PaintableBox::create.
pub func paint_paintable_box_create_layout_box(layout_box: LayoutBox*) -> PaintPaintableBox*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintPaintableBox*)web_heap_allocate_cell(heap, &paint_paintable_box_class)
    gc.heap_defer_gc(heap)
    paint_paintable_box_construct_layout_box(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

