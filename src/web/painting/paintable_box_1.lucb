pub func paint_paintable_box_could_be_scrolled_by_wheel_event_paint_paintable_box_scroll_dir(this: PaintPaintableBox*, direction: PaintPaintableBoxScrollDirection) -> bool:
    let is_horizontal = direction == PaintPaintableBoxScrollDirection.horizontal
    let orientation = gfx.Orientation.horizontal if is_horizontal else gfx.Orientation.vertical
    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
    let overflow = css_computed_values_overflow_x(computed_values) if is_horizontal else css_computed_values_overflow_y(computed_values)

    let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(this) else return false

    let scrollable_overflow_size = gfx.css_pixel_rect_primary_size_for_orientation(&scrollable_overflow_rect, orientation)
    let padding_box_rect = paint_paintable_box_absolute_padding_box_rect(this)
    let scrollport_size = gfx.css_pixel_rect_primary_size_for_orientation(&padding_box_rect, orientation)

    let overflow_value_allows_scrolling = overflow == css_data.Overflow.auto or overflow == css_data.Overflow.scroll
    if (paint_paintable_is_viewport_paintable(this.paint_paintable()) and overflow != css_data.Overflow.hidden) or overflow_value_allows_scrolling:
        return scrollable_overflow_size.gt(scrollport_size)

    return false

