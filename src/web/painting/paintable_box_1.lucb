## `CSS::Length::from_style_value(length, {}).absolute_length_to_px()`: the `to_css_px` lambda of resolve_css_filter.
func paint_resolve_css_filter_to_css_px(length: CssStyleValue*) -> gfx.CssPixels:
    let resolved = css_length_from_style_value(length, none)
    return css_length_absolute_length_to_px(&resolved)

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:47 Web::Painting::resolve_css_filter.
pub func paint_resolve_css_filter(computed_filter: CssFilter, paintable_box: PaintPaintableBox*) -> PaintResolvedCssFilter:
    let computed_values = &paint_paintable_computed_values(paintable_box.paint_paintable()).computed_values
    let layout_node = paint_paintable_box_layout_node_with_style_and_box_metrics(paintable_box)

    var result = PaintResolvedCssFilter()
    for filter_operation in css_filter_filters(&computed_filter):
        match filter_operation:
            .css_blur(blur):
                let resolved_radius = css_blur_resolved_radius(&blur)
                ak.vector_append_t(&result.operations, PaintResolvedCssFilterResolvedFilterValue.paint_resolved_css_filter_blur(PaintResolvedCssFilterBlur(
                    radius = gfx.css_pixels_nearest_value_for_f32(resolved_radius),
                )))
            .css_drop_shadow(drop_shadow):
                let color_context = css_color_resolution_context_for_layout_node_with_style(layout_node.layout_node_with_style())
                var resolved_color = css_computed_values_color(computed_values)
                if let drop_shadow_color = drop_shadow.color:
                    resolved_color = css_style_value_to_color(drop_shadow_color, color_context) else css_computed_values_color(computed_values)

                var radius = gfx.CssPixels.from_int(0)
                if let drop_shadow_radius = drop_shadow.radius:
                    radius = paint_resolve_css_filter_to_css_px(drop_shadow_radius)
                ak.vector_append_t(&result.operations, PaintResolvedCssFilterResolvedFilterValue.paint_resolved_css_filter_drop_shadow(PaintResolvedCssFilterDropShadow(
                    offset_x = paint_resolve_css_filter_to_css_px(drop_shadow.offset_x),
                    offset_y = paint_resolve_css_filter_to_css_px(drop_shadow.offset_y),
                    radius = radius,
                    color = resolved_color,
                )))
            .css_color(color_operation):
                ak.vector_append_t(&result.operations, PaintResolvedCssFilterResolvedFilterValue.paint_resolved_css_filter_color(PaintResolvedCssFilterColor(
                    operation = color_operation.operation,
                    amount = css_color_resolved_amount(&color_operation),
                )))
            .css_hue_rotate(hue_rotate):
                ak.vector_append_t(&result.operations, PaintResolvedCssFilterResolvedFilterValue.paint_resolved_css_filter_hue_rotate(PaintResolvedCssFilterHueRotate(
                    angle_degrees = css_hue_rotate_angle_degrees(&hue_rotate),
                )))
            .css_url(css_url):
                let url_string = css_url_url(&css_url)
                if ak.string_is_empty(&url_string) or not ak.string_starts_with(&url_string, (u32)'#'):
                    continue
                let fragment = ak.string_substring_from_byte_offset(&url_string, 1) else continue
                let maybe_filter = dom_parent_node_get_element_by_id(paint_paintable_document(paintable_box.paint_paintable()).dom_parent_node(), ak.fly_string_from_string(fragment)) else continue
                if let filter_element = as_if_svg_filter_element(maybe_filter):
                    result.svg_filter = svg_filter_element_gfx_filter(filter_element, layout_node.layout_node_with_style())
                    let bounds = paint_paintable_box_absolute_border_box_rect(paintable_box)
                    if gfx.css_pixel_rect_is_empty(&bounds):
                        if let svg_ancestor = tree_node_first_ancestor_of_type(paintable_box.paint_paintable(), &paint_svgsvg_paintable_class):
                            result.svg_filter_bounds = paint_paintable_box_absolute_rect((PaintPaintableBox*)svg_ancestor)
                    if not gfx.css_pixel_rect_is_empty(&bounds):
                        result.svg_filter_bounds = bounds
    return result

