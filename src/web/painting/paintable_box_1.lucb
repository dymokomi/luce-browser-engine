            let margin_box = paint_box_model_metrics_margin_box(paint_paintable_box_box_model(paintable_box))
            return gfx.CssPixelRect(
                gfx.CssPixelPoint(paint_paintable_box_absolute_x(paintable_box).sub(margin_box.left), paint_paintable_box_absolute_y(paintable_box).sub(margin_box.top)),
                gfx.CssPixelSize(paint_paintable_box_content_width(paintable_box).add(margin_box.left).add(margin_box.right),
                                 paint_paintable_box_content_height(paintable_box).add(margin_box.top).add(margin_box.bottom)))

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:386 Web::Painting::united_rect_for_continuation_chain.
## The C++ template's `get_rect` callable is the rect it names.
func paint_united_rect_for_continuation_chain(start: PaintPaintableBox*, get_rect: PaintUnitedRect) -> gfx.CssPixelRect:
    # Combine the absolute rects of all paintable boxes of all nodes in the continuation chain. Without this, we
    # calculate the wrong rect for inline nodes that were split because of block elements.
    var result: gfx.CssPixelRect? = none

    # FIXME: instead of walking the continuation chain in the layout tree, also keep track of this chain in the
    #        painting tree so we can skip visiting the layout nodes altogether.
    var node_or_none: LayoutNodeWithStyleAndBoxModelMetrics*? = paint_paintable_box_layout_node_with_style_and_box_metrics(start)
    while let node = node_or_none:
        for paintable in ak.intrusive_list_begin(layout_node_paintables(node.layout_node())):
            if not is_paint_paintable_box(paintable):
                continue
            let paintable_box = (PaintPaintableBox*)paintable
            let paintable_border_box_rect = paint_united_rect_of(paintable_box, get_rect)
            if let current = result:
                if not gfx.css_pixel_rect_is_empty(&paintable_border_box_rect):
                    var united = current
                    gfx.css_pixel_rect_unite(&united, paintable_border_box_rect)
                    result = united
            else:
                result = paintable_border_box_rect
        node_or_none = layout_node_with_style_and_box_model_metrics_continuation_of_node(node)
    return result else gfx.CssPixelRect()

