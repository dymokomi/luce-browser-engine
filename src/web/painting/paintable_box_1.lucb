        full_scrollport_length = full_scrollport_length.sub(metrics.resize_gripper_size)
    else:
        if is_horizontal and paint_paintable_box_could_be_scrolled_by_wheel_event_paint_paintable_box_scroll_dir(this, PaintPaintableBoxScrollDirection.vertical):
            full_scrollport_length = full_scrollport_length.sub(metrics.scroll_gutter_thickness)
        if not is_horizontal and paint_paintable_box_could_be_scrolled_by_wheel_event_paint_paintable_box_scroll_dir(this, PaintPaintableBoxScrollDirection.horizontal):
            full_scrollport_length = full_scrollport_length.sub(metrics.scroll_gutter_thickness)
    return full_scrollport_length
