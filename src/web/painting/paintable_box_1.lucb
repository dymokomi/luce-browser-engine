        let border_bottom = gfx.round(layout_div_int(border.bottom, 2)) if use_collapsing_borders_model else border.bottom
        let border_left = gfx.round(layout_div_int(border.left, 2)) if use_collapsing_borders_model else border.left
        let border_right = gfx.round(layout_div_int(border.right, 2)) if use_collapsing_borders_model else border.right
        gfx.css_pixel_rect_set_x(&rect, gfx.css_pixel_rect_x(&padded_rect).sub(border_left))
        gfx.css_pixel_rect_set_width(&rect, gfx.css_pixel_rect_width(&padded_rect).add(border_left).add(border_right))
        gfx.css_pixel_rect_set_y(&rect, gfx.css_pixel_rect_y(&padded_rect).sub(border_top))
        gfx.css_pixel_rect_set_height(&rect, gfx.css_pixel_rect_height(&padded_rect).add(border_top).add(border_bottom))
        this.m_absolute_border_box_rect = rect
