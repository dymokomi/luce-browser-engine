## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:263 Web::Painting::PaintableBox::scroll_into_view.
pub func paint_paintable_box_scroll_into_view(this: PaintPaintableBox*, rect: gfx.CssPixelRect):
    let scrollport = paint_paintable_box_absolute_padding_box_rect(this)
    let current_offset = paint_paintable_box_scroll_offset(this)

    # Both rect and scrollport are in layout coordinate space (not scroll-adjusted).
    let content_rect = gfx.css_pixel_rect_translated_css_pixels_css_pixels(&rect, gfx.css_pixel_rect_x(&scrollport).neg(), gfx.css_pixel_rect_y(&scrollport).neg())
    var new_offset = current_offset

    if gfx.css_pixel_rect_right(&content_rect).gt(current_offset.m_x.add(gfx.css_pixel_rect_width(&scrollport))):
        gfx.css_pixel_point_set_x(&new_offset, gfx.css_pixel_rect_right(&content_rect).sub(gfx.css_pixel_rect_width(&scrollport)))
    elif gfx.css_pixel_rect_left(&content_rect).lt(current_offset.m_x):
        gfx.css_pixel_point_set_x(&new_offset, gfx.css_pixel_rect_left(&content_rect))

    if gfx.css_pixel_rect_bottom(&content_rect).gt(current_offset.m_y.add(gfx.css_pixel_rect_height(&scrollport))):
        gfx.css_pixel_point_set_y(&new_offset, gfx.css_pixel_rect_bottom(&content_rect).sub(gfx.css_pixel_rect_height(&scrollport)))
    elif gfx.css_pixel_rect_top(&content_rect).lt(current_offset.m_y):
        gfx.css_pixel_point_set_y(&new_offset, gfx.css_pixel_rect_top(&content_rect))

    _ = paint_paintable_box_set_scroll_offset(this, new_offset)

