## Ported from Libraries/LibWeb/Painting/PaintableBox.h:132 Web::Painting::PaintableBox::has_css_transform.
pub func paint_paintable_box_has_css_transform(this: PaintPaintableBox*) -> bool:
    let computed_values = &paint_paintable_computed_values(this.paint_paintable()).computed_values
    var transformations = css_computed_values_transformations(computed_values)
    return not ak.vector_is_empty(&transformations) or css_computed_values_rotate(computed_values) != none or css_computed_values_translate(computed_values) != none or css_computed_values_scale(computed_values) != none

