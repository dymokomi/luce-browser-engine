## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:179 Web::Painting::PaintableBox::scroll_offset.
pub func paint_paintable_box_scroll_offset(this: PaintPaintableBox*) -> gfx.CssPixelPoint:
    if paint_paintable_is_viewport_paintable(this.paint_paintable()):
        let navigable = dom_document_navigable(paint_paintable_document(this.paint_paintable())) else trap("VERIFY: the viewport's document has a navigable")
        return html_navigable_viewport_scroll_offset(navigable)

    let node = paint_paintable_layout_node(this.paint_paintable())
    if let pseudo_element = layout_node_generated_for_pseudo_element(node):
        let generator = layout_node_pseudo_element_generator(node) else trap("a pseudo-element without a generator")
        return dom_element_scroll_offset(generator, pseudo_element)

    if let dom_node = paint_paintable_dom_node(this.paint_paintable()):
        if let element = as_if_dom_element(dom_node):
            return dom_element_scroll_offset(element, none)
    return gfx.CssPixelPoint()

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:194 Web::Painting::PaintableBox::set_scroll_offset.
pub func paint_paintable_box_set_scroll_offset(this: PaintPaintableBox*, offset: gfx.CssPixelPoint) -> PaintPaintableBoxScrollHandled:
    let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(this) else return PaintPaintableBoxScrollHandled.no

    let zero = gfx.CssPixels.from_int(0)
    let padding_rect = paint_paintable_box_absolute_padding_box_rect(this)
    let max_x_offset = ak.max(gfx.css_pixel_rect_width(&scrollable_overflow_rect).sub(gfx.css_pixel_rect_width(&padding_rect)), zero)
    let max_y_offset = ak.max(gfx.css_pixel_rect_height(&scrollable_overflow_rect).sub(gfx.css_pixel_rect_height(&padding_rect)), zero)

    var clamped = offset
    gfx.css_pixel_point_set_x(&clamped, ak.clamp(clamped.m_x, zero, max_x_offset))
    gfx.css_pixel_point_set_y(&clamped, ak.clamp(clamped.m_y, zero, max_y_offset))

    # FIXME: If there is horizontal and vertical scroll ignore only part of the new offset
    let current_offset = paint_paintable_box_scroll_offset(this)
    if clamped.m_y.lt(zero) or gfx.css_pixel_point_eq(&current_offset, clamped):
        return PaintPaintableBoxScrollHandled.no

    if paint_paintable_is_viewport_paintable(this.paint_paintable()):
        let navigable = dom_document_navigable(paint_paintable_document(this.paint_paintable())) else trap("VERIFY: the viewport's document has a navigable")
        html_navigable_perform_scroll_of_viewport_scrolling_box(navigable, clamped)
        return PaintPaintableBoxScrollHandled.yes

    dom_document_set_needs_to_refresh_scroll_state(paint_paintable_document(this.paint_paintable()), true)

    let node = paint_paintable_layout_node(this.paint_paintable())
    if let pseudo_element = layout_node_generated_for_pseudo_element(node):
        let generator = layout_node_pseudo_element_generator(node) else trap("a pseudo-element without a generator")
        dom_element_set_scroll_offset(generator, pseudo_element, clamped)
    else:
        let dom_node = paint_paintable_dom_node(this.paint_paintable()) else trap("as_if<DOM::Element>(*dom_node()): no DOM node")
        let element = as_if_dom_element(dom_node) else return PaintPaintableBoxScrollHandled.no
        dom_element_set_scroll_offset(element, none, clamped)

    # https://drafts.csswg.org/cssom-view-1/#scrolling-events
    # Whenever an element gets scrolled (whether in response to user interaction or by an API),
    # the user agent must run these steps:

    # 1. Let doc be the element’s node document.
    let document = layout_node_document(paint_paintable_layout_node(this.paint_paintable()))

    # FIXME: 2. If the element is a snap container, run the steps to update snapchanging targets for the element with
    #           the element’s eventual snap target in the block axis as newBlockTarget and the element’s eventual snap
    #           target in the inline axis as newInlineTarget.

    var event_target_or_none: DomEventTarget*? = none
    if layout_node_generated_for_pseudo_element(node) != none:
        if let generator = layout_node_pseudo_element_generator(node):
            event_target_or_none = generator.dom_event_target()
    elif let dom_node = paint_paintable_dom_node(this.paint_paintable()):
        event_target_or_none = dom_node.dom_event_target()

    let event_target = event_target_or_none else return PaintPaintableBoxScrollHandled.yes

    # 3. If (element, "scroll") is already in doc’s pending scroll events, abort these steps.
    let pending_scroll_events = dom_document_pending_scroll_events(document)
    for pending in &ak.vector_span(pending_scroll_events):
        if pending.event_target == event_target and ak.fly_string_eq_fly_string(&pending.event_type, &html_event_names_scroll):
            return PaintPaintableBoxScrollHandled.yes

    # 4. Append (element, "scroll") to doc’s pending scroll events.
    ak.vector_append_t(pending_scroll_events, DomDocumentPendingScrollEvent(event_target = event_target, event_type = html_event_names_scroll))

    paint_paintable_set_needs_repaint(this.paint_paintable(), InvalidateDisplayList.no)
    return PaintPaintableBoxScrollHandled.yes

## Ported from Libraries/LibWeb/Painting/PaintableBox.cpp:258 Web::Painting::PaintableBox::scroll_by.
pub func paint_paintable_box_scroll_by(this: PaintPaintableBox*, delta_x: i32, delta_y: i32) -> PaintPaintableBoxScrollHandled:
    let current = paint_paintable_box_scroll_offset(this)
