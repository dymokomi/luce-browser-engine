pub func paint_paintable_box_overflow_clip_edge_rect(this: PaintPaintableBox*) -> gfx.CssPixelRect:
    # https://drafts.csswg.org/css-overflow-4/#overflow-clip-margin
    # Values are defined as follows:
    # '<visual-box>'
