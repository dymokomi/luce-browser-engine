#==============================================================================================
#
#   table_borders_painting - Painting::TableBordersPainting: table cell borders in the
#   collapsing and separated border models
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/TableBordersPainting.cpp (lines 1-449): the cells of a
#       table snapped to device pixel grid lines, the edges each cell contributes (right and down
#       neighbours, the table's first and last rows and columns), sorted at intersections the way
#       other browsers resolve them and painted, then the cells with border radii. A table with
#       separated borders paints each cell's own borders.
#
#       Copyright (c) 2023, the SerenityOS developers.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Cells =====================================================================================

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:19 CellCoordinates::operator==.
pub func cell_coordinates_eq(this: const CellCoordinates*, other: CellCoordinates) -> bool:
    return this.row_index == other.row_index and this.column_index == other.column_index

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:36 Web::Painting::collect_cell_boxes.
func paint_collect_cell_boxes(cell_boxes: ak.Vector[PaintPaintableBox*]*, table_paintable: PaintPaintableBox*):
    for child in paint_paintable_children(table_paintable.paint_paintable()):
        let child_box = as_if_paint_paintable_box(child) else continue
        let display = paint_paintable_display(child)
        if css_display_is_table_cell(&display):
            ak.vector_append_t(cell_boxes, child_box)
        else:
            paint_collect_cell_boxes(cell_boxes, child_box)

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:79 Web::Painting::row_index_for_element_kind.
func paint_row_index_for_element_kind(index: usize, element_kind: PaintPaintableBoxConflictingElementKind) -> u64?:
    match element_kind:
        .cell, .row, .row_group:
            return (u64)index
        _:
            return none

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:92 Web::Painting::column_index_for_element_kind.
func paint_column_index_for_element_kind(index: usize, element_kind: PaintPaintableBoxConflictingElementKind) -> u64?:
    match element_kind:
        .cell, .column, .column_group:
            return (u64)index
        _:
            return none

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:105 Web::Painting::half_ceil.
func paint_half_ceil(width: i32) -> i32:
    return (i32)math.ceil((f64)width / 2.0)

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:110 Web::Painting::half_floor.
func paint_half_floor(width: i32) -> i32:
    return (i32)math.floor((f64)width / 2.0)

## `DevicePixelRect { x, y, width, height }`.
func paint_table_device_rect(x: i32, y: i32, width: i32, height: i32) -> gfx.DevicePixelRect:
    var rect: gfx.DevicePixelRect = ---
    gfx.device_pixel_rect_construct_i32(&rect, x, y, width, height)
    return rect

# mark: Edges =====================================================================================

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:115 Web::Painting::make_right_cell_edge.
func paint_make_right_cell_edge(right_cell_rect: gfx.DevicePixelRect, cell_rect: gfx.DevicePixelRect, borders_data: PaintDeviceBordersDataWithElementKind, coordinates: CellCoordinates) -> PaintBorderEdgePaintingInfo:
    let connect_top_offset = paint_half_ceil(borders_data.top.border_data.width)
    let connect_excess_height = connect_top_offset + paint_half_floor(borders_data.bottom.border_data.width)
    let right_border_rect = paint_table_device_rect(
        gfx.device_pixel_rect_x(&right_cell_rect) - paint_half_ceil(borders_data.right.border_data.width),
        gfx.device_pixel_rect_y(&cell_rect) - connect_top_offset,
        borders_data.right.border_data.width,
        ak.max(gfx.device_pixel_rect_height(&cell_rect), gfx.device_pixel_rect_height(&right_cell_rect)) + connect_excess_height)
    return PaintBorderEdgePaintingInfo(rect = right_border_rect,
                                       border_data_with_element_kind = borders_data.right,
                                       direction = PaintEdgeDirection.vertical,
                                       row = paint_row_index_for_element_kind(coordinates.row_index, borders_data.right.element_kind),
                                       column = paint_column_index_for_element_kind(coordinates.column_index, borders_data.right.element_kind))

## Ported from Libraries/LibWeb/Painting/TableBordersPainting.cpp:138 Web::Painting::make_down_cell_edge.
func paint_make_down_cell_edge(down_cell_rect: gfx.DevicePixelRect, cell_rect: gfx.DevicePixelRect, borders_data: PaintDeviceBordersDataWithElementKind, coordinates: CellCoordinates) -> PaintBorderEdgePaintingInfo:
    let connect_left_offset = paint_half_ceil(borders_data.left.border_data.width)
    let connect_excess_width = connect_left_offset + paint_half_floor(borders_data.right.border_data.width)
    let down_border_rect = paint_table_device_rect(
        gfx.device_pixel_rect_x(&cell_rect) - connect_left_offset,
        gfx.device_pixel_rect_y(&down_cell_rect) - paint_half_ceil(borders_data.bottom.border_data.width),
        ak.max(gfx.device_pixel_rect_width(&cell_rect), gfx.device_pixel_rect_width(&down_cell_rect)) + connect_excess_width,
        borders_data.bottom.border_data.width)
    return PaintBorderEdgePaintingInfo(rect = down_border_rect,
                                       border_data_with_element_kind = borders_data.bottom,
                                       direction = PaintEdgeDirection.horizontal,
                                       row = paint_row_index_for_element_kind(coordinates.row_index, borders_data.bottom.element_kind),
                                       column = paint_column_index_for_element_kind(coordinates.column_index, borders_data.bottom.element_kind))

