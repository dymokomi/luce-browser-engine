## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:19 Web::Painting::ResizeHandle::create.
pub func paint_resize_handle_create(heap: gc.Heap*, paintable_box: PaintPaintableBox*) -> PaintResizeHandle*:
    let this = (PaintResizeHandle*)web_heap_allocate_cell(heap, &paint_resize_handle_class)
    gc.heap_defer_gc(heap)
    paint_resize_handle_construct(this, paintable_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:24 Web::Painting::ResizeHandle::ResizeHandle.
pub func paint_resize_handle_construct(this: PaintResizeHandle*, paintable_box: PaintPaintableBox*):
    this.m_paintable_box = paintable_box
    let dom_node = paint_paintable_dom_node(paintable_box.paint_paintable()) else trap("VERIFY: the resizable box has a DOM node")
    this.m_element = as_dom_element(dom_node)

## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:30 Web::Painting::ResizeHandle::visit_edges (override).
pub func paint_resize_handle_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (PaintResizeHandle*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_paintable_box)
    gc.cell_visitor_visit_t_2(visitor, this.m_element)
    if let resize_action = this.m_resize_action:
        element_resize_action_visit_edges(resize_action, visitor)

## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:39 Web::Painting::ResizeHandle::contains.
pub func paint_resize_handle_contains(this: PaintResizeHandle*, position: gfx.CssPixelPoint, metrics: ChromeMetrics) -> bool:
    return paint_paintable_box_resizer_contains(this.m_paintable_box, position, metrics)

## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:44 Web::Painting::ResizeHandle::cursor (override).
pub func paint_resize_handle_cursor_impl(base: PaintChromeWidget*) -> css_data.CursorPredefined?:
    let this = (PaintResizeHandle*)base
    let axes = paint_paintable_box_physical_resize_axes(this.m_paintable_box)
    if axes.vertical:
        if axes.horizontal:
            if paint_paintable_box_is_chrome_mirrored(this.m_paintable_box):
                return css_data.CursorPredefined.sw_resize
            return css_data.CursorPredefined.se_resize
        return css_data.CursorPredefined.ns_resize
    return css_data.CursorPredefined.ew_resize

## Ported from Libraries/LibWeb/Painting/ResizeHandle.cpp:58 Web::Painting::ResizeHandle::handle_pointer_event (override).
pub func paint_resize_handle_handle_pointer_event_impl(base: PaintChromeWidget*, type_: ak.FlyString, button: u32, visual_viewport_position: gfx.CssPixelPoint) -> PaintMouseAction:
    let this = (PaintResizeHandle*)base
    if ak.fly_string_eq_fly_string(&type_, &ui_events_event_names_pointermove):
        if this.m_resize_action == none:
            return PaintMouseAction.none_
    elif button != (u32)UiEventsMouseButton.primary:
        return PaintMouseAction.none_

    if let resize_action = this.m_resize_action:
        element_resize_action_handle_pointer_move(resize_action, visual_viewport_position)
    else:
        # make<ElementResizeAction>(m_element, visual_viewport_position)
        let resize_action = new ElementResizeAction(m_element = this.m_element) else trap("out of memory")
        element_resize_action_construct(resize_action, this.m_element, visual_viewport_position)
        this.m_resize_action = resize_action

    if ak.fly_string_eq_fly_string(&type_, &ui_events_event_names_pointerup):
        this.m_resize_action = none
        return PaintMouseAction.none_

    return PaintMouseAction.capture_input

## Ported from Libraries/LibWeb/Painting/ResizeHandle.h:24 Web::Painting::ResizeHandle::mouse_enter (override).
pub func paint_resize_handle_mouse_enter_impl(base: PaintChromeWidget*):
    return

## Ported from Libraries/LibWeb/Painting/ResizeHandle.h:25 Web::Painting::ResizeHandle::mouse_leave (override).
pub func paint_resize_handle_mouse_leave_impl(base: PaintChromeWidget*):
