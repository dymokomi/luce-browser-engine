# mark: Construction and edges ===================================================================

## Ported from Libraries/LibWeb/Painting/Paintable.cpp:26 Web::Painting::Paintable::Paintable.
pub func paint_paintable_construct(this: PaintPaintable*, layout_node: LayoutNode*):
    this.m_layout_node = layout_node
    let computed_values = &layout_node_computed_values(layout_node).computed_values
    if (layout_node_is_flex_item(layout_node) or layout_node_is_grid_item(layout_node)) and css_computed_values_z_index(computed_values) != none:
        # https://drafts.csswg.org/css-flexbox-1/#painting
        # https://drafts.csswg.org/css-grid-2/#z-order
        # Flex and grid items with z-index values other than "auto" behave as if position were "relative".
        this.m_positioned = true
    else:
        this.m_positioned = css_computed_values_position(computed_values) != css_data.Positioning.static_

    this.m_fixed_position = css_computed_values_position(computed_values) == css_data.Positioning.fixed
    this.m_sticky_position = css_computed_values_position(computed_values) == css_data.Positioning.sticky
    this.m_absolutely_positioned = css_computed_values_position(computed_values) == css_data.Positioning.absolute
    this.m_floating = layout_node_is_floating(layout_node)
    this.m_inline = layout_node_is_inline(layout_node)
    this.m_display = layout_node_display(layout_node)

## Ported from Libraries/LibWeb/Painting/Paintable.cpp:49 Web::Painting::Paintable::finalize (override).
pub func paint_paintable_finalize_impl(base: gc.Cell*):
    let this = (PaintPaintable*)base
    gc.cell_finalize_impl(base)
    if ak.intrusive_list_node_is_in_list(&this.m_list_node):
        ak.intrusive_list_node_remove(&this.m_list_node)

## Ported from Libraries/LibWeb/Painting/Paintable.cpp:56 Web::Painting::Paintable::visit_edges (override).
pub func paint_paintable_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (PaintPaintable*)base
    gc.cell_visit_edges_impl(base, visitor)
    tree_node_visit_edges(this, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_dom_node)
    gc.cell_visitor_visit_t_2(visitor, this.m_layout_node)
    gc.cell_visitor_visit_t(visitor, this.m_containing_block)

## Ported from Libraries/LibWeb/Painting/Paintable.cpp:65 Web::Painting::Paintable::debug_description.
pub func paint_paintable_debug_description(this: PaintPaintable*) -> ak.String:
    var builder = ak.string_builder_new()
    ak.string_builder_append_string_view(&builder, ak.sv(this.cell().vtable.class_info.name))
    ak.string_builder_append(&builder, "(")
    let layout_description = layout_node_debug_description(paint_paintable_layout_node(this))
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&layout_description))
    ak.string_builder_append(&builder, ")")
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

