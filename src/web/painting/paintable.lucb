# mark: HitTestResult (Paintable.h) ==============================================================

## Ported from Libraries/LibWeb/Painting/Paintable.h:199 Web::Painting::HitTestResult::dom_node.
pub func paint_hit_test_result_dom_node(this: PaintHitTestResult*) -> DomNode*?:
    let paintable = this.paintable else trap("a hit test result without a paintable")
    return paint_paintable_dom_node(paintable)

## Ported from Libraries/LibWeb/Painting/Paintable.h:204 Web::Painting::HitTestResult::dom_node.
pub func paint_hit_test_result_dom_node_const(this: const PaintHitTestResult*) -> DomNode*?:
    let paintable = this.paintable else trap("a hit test result without a paintable")
    return paint_paintable_dom_node_const(paintable)

# mark: Flags (Paintable.h) ======================================================================

## Ported from Libraries/LibWeb/Painting/Paintable.h:69 Web::Painting::Paintable::is_visible.
pub func paint_paintable_is_visible(this: PaintPaintable*) -> bool:
    let cv = &paint_paintable_computed_values(this).computed_values
    return css_computed_values_visibility(cv) == css_data.Visibility.visible and css_computed_values_opacity(cv) != 0.0

