## Ported from Libraries/LibWeb/Painting/Paintable.cpp:95 Web::Painting::Paintable::visible_for_hit_testing.
pub func paint_paintable_visible_for_hit_testing(this: PaintPaintable*) -> bool:
    if let node = paint_paintable_dom_node(this):
        if dom_node_is_inert(node):
            return false
    return css_computed_values_pointer_events(&paint_paintable_computed_values(this).computed_values) != css_data.PointerEvents.none_

