## Ported from Libraries/LibWeb/Painting/Paintable.cpp:80 Web::Painting::Paintable::containing_block.
pub func paint_paintable_containing_block(this: PaintPaintable*) -> PaintPaintableBox*?:
    # m_containing_block.ensure([&] { ... }): computed once, null included.
    if not this.m_has_containing_block:
        var containing_block: PaintPaintableBox*? = none
        if let containing_layout_box = layout_node_containing_block(this.m_layout_node):
            containing_block = layout_box_paintable_box(containing_layout_box)
        this.m_containing_block = containing_block
        this.m_has_containing_block = true
    return this.m_containing_block

