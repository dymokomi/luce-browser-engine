## Ported from Libraries/LibWeb/Painting/SVGClipPaintable.cpp:13 Web::Painting::SVGClipPaintable::create.
pub func paint_svg_clip_paintable_create(layout_box: LayoutSvgClipBox*) -> PaintSvgClipPaintable*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintSvgClipPaintable*)web_heap_allocate_cell(heap, &paint_svg_clip_paintable_class)
    gc.heap_defer_gc(heap)
    paint_svg_clip_paintable_construct(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/SVGClipPaintable.h:21 Web::Painting::SVGClipPaintable::forms_unconnected_subtree (override).
pub func paint_svg_clip_paintable_forms_unconnected_subtree_impl(base: PaintPaintable*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/Painting/SVGClipPaintable.cpp:18 Web::Painting::SVGClipPaintable::SVGClipPaintable.
pub func paint_svg_clip_paintable_construct(this: PaintSvgClipPaintable*, layout_box: LayoutSvgClipBox*):
    paint_svg_paintable_construct(this.paint_svg_paintable(), layout_box.layout_svg_box())
