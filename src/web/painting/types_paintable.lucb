## The iterator of PaintPaintableSubtree (TreeNode<T>::next_in_pre_order with stay_within = the root).
pub struct PaintPaintableSubtreeIterator: luce.Iterator[PaintPaintable*]:
    pub var root: PaintPaintable*
    pub var current: PaintPaintable*?
    pub var inclusive: bool
    pub var started: bool
    pub var skip: bool

    mutating func next() -> PaintPaintable*?:
        if not self.started:
            self.started = true
            self.current = self.root
            if self.inclusive:
                return self.root
        let node = self.current else return none
        var next: PaintPaintable*? = none
        if not self.skip:
            next = node.tree_node.m_first_child
        self.skip = false
        if next == none:
            var walk: PaintPaintable*? = node
            while let at = walk:
                if at == self.root:
                    break
                if let sibling = at.tree_node.m_next_sibling:
                    next = sibling
                    break
                walk = at.tree_node.m_parent
        self.current = next
        return next

    ## Do not descend into the children of the node `next()` returned last.
    mutating func skip_children():
        self.skip = true

## The descendants of `node` in pre-order (not `node` itself).
pub func paint_paintable_subtree(node: PaintPaintable*) -> PaintPaintableSubtree:
    return PaintPaintableSubtree(root = node, inclusive = false)

## `node` and its descendants in pre-order.
pub func paint_paintable_inclusive_subtree(node: PaintPaintable*) -> PaintPaintableSubtree:
