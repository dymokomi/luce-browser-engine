## Ported from Libraries/LibWeb/Painting/SVGPatternPaintable.cpp:13 Web::Painting::SVGPatternPaintable::create.
pub func paint_svg_pattern_paintable_create(layout_box: LayoutSvgPatternBox*) -> PaintSvgPatternPaintable*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintSvgPatternPaintable*)web_heap_allocate_cell(heap, &paint_svg_pattern_paintable_class)
    gc.heap_defer_gc(heap)
    paint_svg_pattern_paintable_construct(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/SVGPatternPaintable.h:21 Web::Painting::SVGPatternPaintable::forms_unconnected_subtree (override).
pub func paint_svg_pattern_paintable_forms_unconnected_subtree_impl(base: PaintPaintable*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/Painting/SVGPatternPaintable.cpp:18 Web::Painting::SVGPatternPaintable::SVGPatternPaintable.
pub func paint_svg_pattern_paintable_construct(this: PaintSvgPatternPaintable*, layout_box: LayoutSvgPatternBox*):
    paint_svg_paintable_construct(this.paint_svg_paintable(), layout_box.layout_svg_box())
