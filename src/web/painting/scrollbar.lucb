#==============================================================================================
#
#   scrollbar - Painting::Scrollbar: the chrome widget of a scroll container's scrollbar
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Painting/Scrollbar.cpp (lines 1-131) and Scrollbar.h: hit
#       testing a scrollbar, dragging its thumb (pointer down captures, moves scroll, pointer up
#       releases) and the hovered state that widens it. `Scrollbar::mouse_down` is declared in
#       the header but never defined in C++, so it has no port.
#
#       Copyright (c) 2026, the Ladybird developers.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:19 Web::Painting::Scrollbar::create.
pub func paint_scrollbar_create(heap: gc.Heap*, paintable_box: PaintPaintableBox*, direction: PaintPaintableBoxScrollDirection) -> PaintScrollbar*:
    let this = (PaintScrollbar*)web_heap_allocate_cell(heap, &paint_scrollbar_class)
    gc.heap_defer_gc(heap)
    paint_scrollbar_construct(this, paintable_box, direction)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/Scrollbar.h:21 Web::Painting::Scrollbar::direction.
pub func paint_scrollbar_direction(this: PaintScrollbar*) -> PaintPaintableBoxScrollDirection:
    return this.m_direction

## Ported from Libraries/LibWeb/Painting/Scrollbar.h:22 Web::Painting::Scrollbar::is_enlarged.
pub func paint_scrollbar_is_enlarged(this: PaintScrollbar*) -> bool:
    return this.m_hovered or this.m_thumb_grab_position != none

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:24 Web::Painting::Scrollbar::Scrollbar.
pub func paint_scrollbar_construct(this: PaintScrollbar*, paintable_box: PaintPaintableBox*, direction: PaintPaintableBoxScrollDirection):
    this.m_paintable_box = paintable_box
    this.m_direction = direction

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:30 Web::Painting::Scrollbar::visit_edges (override).
pub func paint_scrollbar_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (PaintScrollbar*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_paintable_box)

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:36 Web::Painting::Scrollbar::contains.
pub func paint_scrollbar_contains(this: PaintScrollbar*, position: gfx.CssPixelPoint, metrics: ChromeMetrics) -> bool:
    if let rect = paint_paintable_box_absolute_scrollbar_rect(this.m_paintable_box, this.m_direction, paint_scrollbar_is_enlarged(this), metrics):
        return gfx.css_pixel_rect_contains_css_pixel_point(&rect, position)
    return false

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:43 Web::Painting::Scrollbar::handle_pointer_event (override).
pub func paint_scrollbar_handle_pointer_event_impl(base: PaintChromeWidget*, type_: ak.FlyString, button: u32, visual_viewport_position: gfx.CssPixelPoint) -> PaintMouseAction:
    let this = (PaintScrollbar*)base
    if ak.fly_string_eq_fly_string(&type_, &ui_events_event_names_pointermove):
        if this.m_thumb_grab_position == none:
            return PaintMouseAction.none_
    elif button != (u32)UiEventsMouseButton.primary:
        return PaintMouseAction.none_

    let position = paint_paintable_box_transform_to_local_coordinates(this.m_paintable_box, visual_viewport_position)
    paint_scrollbar_scroll_to_mouse_position(this, position)
    paint_paintable_set_needs_repaint(this.m_paintable_box.paint_paintable(), InvalidateDisplayList.yes)

    if ak.fly_string_eq_fly_string(&type_, &ui_events_event_names_pointerup):
        this.m_thumb_grab_position = none
        return PaintMouseAction.none_

    return PaintMouseAction.capture_input

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:64 Web::Painting::Scrollbar::mouse_move.
pub func paint_scrollbar_mouse_move(this: PaintScrollbar*, position: gfx.CssPixelPoint) -> PaintMouseAction:
    if this.m_thumb_grab_position != none:
        let local_position = paint_paintable_box_transform_to_local_coordinates(this.m_paintable_box, position)
        paint_scrollbar_scroll_to_mouse_position(this, local_position)
        return PaintMouseAction.swallow_event
    return PaintMouseAction.none_

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:74 Web::Painting::Scrollbar::mouse_up.
pub func paint_scrollbar_mouse_up(this: PaintScrollbar*, arg0: gfx.CssPixelPoint, button: u32) -> PaintMouseAction:
    this.m_thumb_grab_position = none
    paint_paintable_set_needs_repaint(this.m_paintable_box.paint_paintable(), InvalidateDisplayList.yes)
    return PaintMouseAction.none_

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:81 Web::Painting::Scrollbar::mouse_enter (override).
pub func paint_scrollbar_mouse_enter_impl(base: PaintChromeWidget*):
    let this = (PaintScrollbar*)base
    if this.m_hovered:
        return
    this.m_hovered = true
    paint_paintable_set_needs_repaint(this.m_paintable_box.paint_paintable(), InvalidateDisplayList.yes)

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:89 Web::Painting::Scrollbar::mouse_leave (override).
pub func paint_scrollbar_mouse_leave_impl(base: PaintChromeWidget*):
    let this = (PaintScrollbar*)base
    if not this.m_hovered:
        return
    this.m_hovered = false
    paint_paintable_set_needs_repaint(this.m_paintable_box.paint_paintable(), InvalidateDisplayList.yes)

## Ported from Libraries/LibWeb/Painting/Scrollbar.cpp:97 Web::Painting::Scrollbar::scroll_to_mouse_position.
pub func paint_scrollbar_scroll_to_mouse_position(this: PaintScrollbar*, position: gfx.CssPixelPoint):
    let document = paint_paintable_document(this.m_paintable_box.paint_paintable())
    let metrics = page_chrome_metrics(dom_document_page(document))

    let viewport_paintable = dom_document_paintable(document) else trap("the document has no paintable")
    let scroll_state = paint_viewport_paintable_scroll_state_snapshot(viewport_paintable)
    let scrollbar_data = paint_paintable_box_compute_scrollbar_data(this.m_paintable_box, this.m_direction, metrics, &scroll_state) else trap("VERIFY: scrollbar_data.has_value()")

    let orientation = gfx.Orientation.horizontal if this.m_direction == PaintPaintableBoxScrollDirection.horizontal else gfx.Orientation.vertical
    let gutter_location = gfx.css_pixel_rect_location(&scrollbar_data.gutter_rect)
    let relative_to_gutter = gfx.css_pixel_point_sub(&position, gutter_location)
    let offset_relative_to_gutter = gfx.css_pixel_point_primary_offset_for_orientation(&relative_to_gutter, orientation)
    let gutter_size = gfx.css_pixel_rect_primary_size_for_orientation(&scrollbar_data.gutter_rect, orientation)
    let thumb_size = gfx.css_pixel_rect_primary_size_for_orientation(&scrollbar_data.thumb_rect, orientation)

    if gutter_size.lt(thumb_size):
        return

    if this.m_thumb_grab_position == none:
        if gfx.css_pixel_rect_contains_css_pixel_point(&scrollbar_data.thumb_rect, position):
            let relative_to_thumb = gfx.css_pixel_point_sub(&position, gfx.css_pixel_rect_location(&scrollbar_data.thumb_rect))
            this.m_thumb_grab_position = gfx.css_pixel_point_primary_offset_for_orientation(&relative_to_thumb, orientation)
        else:
            let half_thumb_size = gfx.div_css_pixels_int(thumb_size, 2)
            this.m_thumb_grab_position = ak.max(ak.min(offset_relative_to_gutter, gfx.css_pixel_fraction_to_css_pixels(&half_thumb_size)), offset_relative_to_gutter.sub(gutter_size).add(thumb_size))

    let thumb_grab_position = this.m_thumb_grab_position else trap("VERIFY: m_thumb_grab_position.has_value()")
    let constrained_offset = ak.clamp(offset_relative_to_gutter.sub(thumb_grab_position), gfx.CssPixels.from_int(0), gutter_size.sub(thumb_size))
    let scroll_position = constrained_offset.to_double() / gutter_size.sub(thumb_size).to_double()

    let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(this.m_paintable_box) else trap("VERIFY: no scrollable overflow rect")
    let scrollable_overflow_size = gfx.css_pixel_rect_primary_size_for_orientation(&scrollable_overflow_rect, orientation)
    let padding_box_rect = paint_paintable_box_absolute_padding_box_rect(this.m_paintable_box)
    let padding_size = gfx.css_pixel_rect_primary_size_for_orientation(&padding_box_rect, orientation)
    # scroll_position * (scrollable_overflow_size - padding_size): double * CSSPixels is a double.
    let scroll_position_in_pixels = gfx.css_pixels_nearest_value_for_f64(gfx.mul_f64(scroll_position, scrollable_overflow_size.sub(padding_size)))

    var new_scroll_offset = paint_paintable_box_scroll_offset(this.m_paintable_box)
    gfx.css_pixel_point_set_primary_offset_for_orientation(&new_scroll_offset, orientation, scroll_position_in_pixels)
    _ = paint_paintable_box_set_scroll_offset(this.m_paintable_box, new_scroll_offset)
