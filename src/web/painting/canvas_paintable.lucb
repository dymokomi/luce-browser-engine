## Ported from Libraries/LibWeb/Painting/CanvasPaintable.cpp:14 Web::Painting::CanvasPaintable::create.
pub func paint_canvas_paintable_create(layout_box: LayoutCanvasBox*) -> PaintCanvasPaintable*:
    let heap = gc.cell_heap(layout_box.cell())
    let this = (PaintCanvasPaintable*)web_heap_allocate_cell(heap, &paint_canvas_paintable_class)
    gc.heap_defer_gc(heap)
    paint_canvas_paintable_construct(this, layout_box)
    gc.heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibWeb/Painting/CanvasPaintable.cpp:19 Web::Painting::CanvasPaintable::CanvasPaintable.
pub func paint_canvas_paintable_construct(this: PaintCanvasPaintable*, layout_box: LayoutCanvasBox*):
    paint_paintable_box_construct_layout_box(this.paint_paintable_box(), layout_box.layout_box())

## Ported from Libraries/LibWeb/Painting/CanvasPaintable.cpp:24 Web::Painting::CanvasPaintable::paint (override).
pub func paint_canvas_paintable_paint_impl(base: PaintPaintable*, context: DisplayListRecordingContext*, phase: PaintPhase):
    let this = (PaintCanvasPaintable*)base
    if not paint_paintable_is_visible(base):
        return

    paint_paintable_box_paint_impl(base, context, phase)

    if phase == PaintPhase.foreground:
        let canvas_rect = display_list_recording_context_rounded_device_rect(context, paint_paintable_box_absolute_rect(this.paint_paintable_box()))
        var corner_clip = paint_scoped_corner_radius_clip_new(context, canvas_rect, paint_paintable_box_normalized_border_radii_data(this.paint_paintable_box(), PaintPaintableBoxShrinkRadiiForBorders.yes))
        defer paint_scoped_corner_radius_clip_destruct(&corner_clip)

        let canvas_element = as_html_canvas_element(paint_paintable_dom_node(base) else trap("VERIFY: a canvas paintable has a DOM node"))
        if let surface = html_canvas_element_surface(canvas_element):
            # present() snapshots the surface and publishes to ExternalContentSource.
            # FIXME: Remove this const_cast.
            html_canvas_element_present(canvas_element)
            let canvas_int_rect = canvas_rect
            let scaling_mode = css_to_gfx_scaling_mode(css_computed_values_image_rendering(&paint_paintable_computed_values(base).computed_values),
                                                       gfx.painting_surface_size(surface), gfx.device_pixel_rect_size(&canvas_int_rect))
            display_list.display_list_recorder_draw_external_content(display_list_recording_context_display_list_recorder(context), canvas_int_rect,
                                                                     html_canvas_element_ensure_external_content_source(canvas_element), scaling_mode)
