## Ported from Libraries/LibWeb/CSS/StyleSheetIdentifier.h:29 Web::CSS::StyleSheetIdentifier::operator==.
pub func css_style_sheet_identifier_eq(this: const CssStyleSheetIdentifier*, other: CssStyleSheetIdentifier) -> bool:
    if this.type_ != other.type_ or this.dom_element_unique_id != other.dom_element_unique_id:
        return false
    if let url = this.url:
        let other_url = other.url else return false
        return ak.string_equals(&url, &other_url)
    return other.url == none

## Ported from Libraries/LibWeb/CSS/StyleSheetIdentifier.cpp:13 Web::CSS::style_sheet_identifier_type_to_string.
pub func css_style_sheet_identifier_type_to_string(type_: CssStyleSheetIdentifierType) -> ak.StringView:
    match type_:
        .style_element: return ak.sv("StyleElement")
        .link_element: return ak.sv("LinkElement")
        .import_rule: return ak.sv("ImportRule")
        .user_agent: return ak.sv("UserAgent")
        .user_style: return ak.sv("UserStyle")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleSheetIdentifier.cpp:30 Web::CSS::style_sheet_identifier_type_from_string.
pub func css_style_sheet_identifier_type_from_string(string: ak.StringView) -> CssStyleSheetIdentifierType?:
    if ak.string_view_equals(&string, "StyleElement"):
        return CssStyleSheetIdentifierType.style_element
    if ak.string_view_equals(&string, "LinkElement"):
        return CssStyleSheetIdentifierType.link_element
    if ak.string_view_equals(&string, "ImportRule"):
        return CssStyleSheetIdentifierType.import_rule
    if ak.string_view_equals(&string, "UserAgent"):
        return CssStyleSheetIdentifierType.user_agent
    if ak.string_view_equals(&string, "UserStyle"):
        return CssStyleSheetIdentifierType.user_style
    return none
