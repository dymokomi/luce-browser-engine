## Ported from Libraries/LibWeb/CSS/PreferredMotion.cpp:11 Web::CSS::preferred_motion_from_string.
pub func css_preferred_motion_from_string(value: ak.StringView) -> CssPreferredMotion:
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("no-preference")):
        return CssPreferredMotion.no_preference
    if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("reduce")):
        return CssPreferredMotion.reduce
    return CssPreferredMotion.auto

## Ported from Libraries/LibWeb/CSS/PreferredMotion.cpp:20 Web::CSS::preferred_motion_to_string.
pub func css_preferred_motion_to_string(value: CssPreferredMotion) -> ak.StringView:
    match value:
        .auto: return ak.sv("auto")
        .no_preference: return ak.sv("no-preference")
        .reduce: return ak.sv("reduce")
        _: trap("VERIFY_NOT_REACHED")
