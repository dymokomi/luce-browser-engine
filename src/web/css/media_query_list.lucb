# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:21 Web::CSS::MediaQueryList::create.
pub func css_media_query_list_create(document: DomDocument*, media: ak.Vector[CssMediaQuery*]) -> CssMediaQueryList*:
    return realm_create_css_media_query_list(bind_platform_object_realm(document.bind_platform_object()), document, media)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:26 Web::CSS::MediaQueryList::MediaQueryList.
pub func css_media_query_list_construct(this: CssMediaQueryList*, document: DomDocument*, media: ak.Vector[CssMediaQuery*]):
    dom_event_target_construct(this.dom_event_target(), bind_platform_object_realm(document.bind_platform_object()))
    this.m_document = document
    this.m_media = media
    this.m_has_changed_state = false
    _ = css_media_query_list_evaluate(this)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:34 Web::CSS::MediaQueryList::initialize (override).
pub func css_media_query_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.media_query_list)
    dom_event_target_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:40 Web::CSS::MediaQueryList::visit_edges (override).
pub func css_media_query_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssMediaQueryList*)base
    dom_event_target_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_document)

# mark: The MediaQueryList interface ============================================================

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:47 Web::CSS::MediaQueryList::media.
# https://drafts.csswg.org/cssom-view/#dom-mediaquerylist-media
pub func css_media_query_list_media(this: CssMediaQueryList*) -> ak.String:
    return css_serialize_a_media_query_list(this.m_media)

## Whether any of the list's media queries matches (the loops of MediaQueryList::matches).
func css_media_query_list_any_matches(this: CssMediaQueryList*) -> bool:
    for media in ak.vector_span(&this.m_media):
        if css_media_query_matches(media):
            return true
    return false

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:53 Web::CSS::MediaQueryList::matches.
# https://drafts.csswg.org/cssom-view/#dom-mediaquerylist-matches
pub func css_media_query_list_matches(this: CssMediaQueryList*) -> bool:
    if ak.vector_is_empty(&this.m_media):
        return true

    let did_match = css_media_query_list_any_matches(this)

    # NOTE: If our document is inside a frame, we need to update layout
    #       since that may cause our frame (and thus viewport) to resize.
    if let container_document = dom_document_container_document(this.m_document):
        dom_document_update_layout(container_document, DomUpdateLayoutReason.media_query_list_matches)
        _ = css_media_query_list_evaluate(this)

    let now_matches = css_media_query_list_any_matches(this)

    if did_match != now_matches:
        this.m_has_changed_state = true

    return now_matches

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:87 Web::CSS::MediaQueryList::evaluate.
pub func css_media_query_list_evaluate(this: CssMediaQueryList*) -> bool:
    if ak.vector_is_empty(&this.m_media):
        return true

    var now_matches = false
    for media in ak.vector_span(&this.m_media):
        now_matches = now_matches or css_media_query_evaluate(media, this.m_document)

    return now_matches

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:101 Web::CSS::MediaQueryList::add_listener.
# https://www.w3.org/TR/cssom-view/#dom-mediaquerylist-addlistener
pub func css_media_query_list_add_listener(this: CssMediaQueryList*, listener: DomIdlEventListener*?):
    # 1. If listener is null, terminate these steps.
    let listener_ = listener else return

    # 2. Append an event listener to the associated list of event listeners with type set to change,
    #    callback set to listener, and capture set to false, unless there already is an event listener
    #    in that list with the same type, callback, and capture.
    #    (NOTE: capture is set to false by default)
    dom_event_target_add_event_listener_without_options(this.dom_event_target(), html_event_names_change, listener_)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:115 Web::CSS::MediaQueryList::remove_listener.
# https://www.w3.org/TR/cssom-view/#dom-mediaquerylist-removelistener
pub func css_media_query_list_remove_listener(this: CssMediaQueryList*, listener: DomIdlEventListener*?):
    # 1. Remove an event listener from the associated list of event listeners, whose type is change, callback is listener, and capture is false.
    # NOTE: While the spec doesn't technically use remove_event_listener and instead manipulates the list directly, every major engine uses remove_event_listener.
    #       This means if an event listener removes another event listener that comes after it, the removed event listener will not be invoked.
    if let listener_ = listener:
        dom_event_target_remove_event_listener_without_options(this.dom_event_target(), html_event_names_change, listener_)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:124 Web::CSS::MediaQueryList::set_onchange.
pub func css_media_query_list_set_onchange(this: CssMediaQueryList*, event_handler: IdlCallbackType*?):
    dom_event_target_set_event_handler_attribute(this.dom_event_target(), html_event_names_change, event_handler)

## Ported from Libraries/LibWeb/CSS/MediaQueryList.cpp:129 Web::CSS::MediaQueryList::onchange.
pub func css_media_query_list_onchange(this: CssMediaQueryList*) -> IdlCallbackType*?:
    return dom_event_target_event_handler_attribute(this.dom_event_target(), html_event_names_change)

# mark: MediaQueryList.h ========================================================================

## Ported from Libraries/LibWeb/CSS/MediaQueryList.h:35 Web::CSS::MediaQueryList::has_changed_state.
pub func css_media_query_list_has_changed_state(this: CssMediaQueryList*) -> bool?:
    return this.m_has_changed_state

## Ported from Libraries/LibWeb/CSS/MediaQueryList.h:36 Web::CSS::MediaQueryList::set_has_changed_state.
pub func css_media_query_list_set_has_changed_state(this: CssMediaQueryList*, has_changed_state: bool):
    this.m_has_changed_state = has_changed_state
