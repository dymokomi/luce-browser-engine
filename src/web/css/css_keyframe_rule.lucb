# mark: CSSKeyframeRule =========================================================================

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.h:28 Web::CSS::CSSKeyframeRule::key.
pub func css_keyframe_rule_key(this: CssKeyframeRule*) -> CssPercentage:
    return this.m_key

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.h:29 Web::CSS::CSSKeyframeRule::style.
pub func css_keyframe_rule_style(this: CssKeyframeRule*) -> CssStyleProperties*:
    return this.m_declarations

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.h:31 Web::CSS::CSSKeyframeRule::key_text.
pub func css_keyframe_rule_key_text(this: CssKeyframeRule*) -> ak.String:
    return css_percentage_to_string(&this.m_key)

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.h:36 Web::CSS::CSSKeyframeRule::set_key_text.
pub func css_keyframe_rule_set_key_text(this: CssKeyframeRule*, key_text: ak.String):
    _ = this
    ak.dbgln(f"FIXME: CSSKeyframeRule::set_key_text is not implemented: {ak.string_view_text(ak.string_bytes_as_string_view(&key_text))}")

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:18 Web::CSS::CSSKeyframeRule::create.
pub func css_keyframe_rule_create(realm: Realm*, key: CssPercentage, declarations: CssStyleProperties*) -> CssKeyframeRule*:
    return realm_create_css_keyframe_rule(realm, realm, key, declarations)

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:23 Web::CSS::CSSKeyframeRule::CSSKeyframeRule.
pub func css_keyframe_rule_construct(this: CssKeyframeRule*, realm: Realm*, key: CssPercentage, declarations: CssStyleProperties*):
    css_rule_construct(this.css_rule(), realm, CssRuleType.keyframe)
    this.m_key = key
    this.m_declarations = declarations
    css_style_declaration_set_parent_rule(this.m_declarations.css_style_declaration(), this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:31 Web::CSS::CSSKeyframeRule::visit_edges (override).
pub func css_keyframe_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssKeyframeRule*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_declarations)

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:37 Web::CSS::CSSKeyframeRule::initialize (override).
pub func css_keyframe_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_keyframe_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:43 Web::CSS::CSSKeyframeRule::serialized (override).
pub func css_keyframe_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssKeyframeRule*)base
    var builder = ak.string_builder_new()
    let declarations = css_style_declaration_serialized(this.m_declarations.css_style_declaration())
    dump_appendff(&builder, "{}% {{ {} }}", [ak.arg_f64(css_percentage_value(&this.m_key)), css_arg_string(&declarations)])
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSKeyframeRule.cpp:50 Web::CSS::CSSKeyframeRule::dump (override).
pub func css_keyframe_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssKeyframeRule*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    let key_text = css_keyframe_rule_key_text(this)
    dump_appendff(builder, "Key: {}\n", [css_arg_string(&key_text)])
    dump_style_properties(builder, css_keyframe_rule_style(this), indent_levels + 1)
