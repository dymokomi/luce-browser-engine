## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1412 Web::CSS::ComputedProperties::vertical_align.
pub func css_computed_properties_vertical_align(this: CssComputedProperties*) -> VerticalAlignOrCssLengthPercentage:
    let value = css_computed_properties_property(this, css_data.PropertyId.vertical_align)

    if css_style_value_is_keyword(value):
        return VerticalAlignOrCssLengthPercentage.vertical_align(css_data.keyword_to_vertical_align(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()"))

    return VerticalAlignOrCssLengthPercentage.css_length_percentage(css_length_percentage_from_style_value(value))

