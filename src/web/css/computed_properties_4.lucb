# mark: Text wrap, box sizing, vertical-align ===================================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1400 Web::CSS::ComputedProperties::text_wrap_mode.
pub func css_computed_properties_text_wrap_mode(this: CssComputedProperties*) -> css_data.TextWrapMode:
    let value = css_computed_properties_property(this, css_data.PropertyId.text_wrap_mode)
    return css_data.keyword_to_text_wrap_mode(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()")

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1406 Web::CSS::ComputedProperties::box_sizing.
pub func css_computed_properties_box_sizing(this: CssComputedProperties*) -> css_data.BoxSizing:
    let value = css_computed_properties_property(this, css_data.PropertyId.box_sizing)
