## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1522 Web::CSS::ComputedProperties::font_variant_ligatures.
pub func css_computed_properties_font_variant_ligatures(this: CssComputedProperties*) -> CssFontVariantLigatures?:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_variant_ligatures)

    if css_style_value_to_keyword(value) == css_data.Keyword.normal:
        return none

    if css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return CssFontVariantLigatures(none_ = true)

    let tuple = css_tuple_style_value_tuple(css_style_value_as_tuple(value))

    var ligatures = CssFontVariantLigatures()

    if let common = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_ligatures_common):
        ligatures.common = css_data.keyword_to_common_lig_value(css_style_value_to_keyword(common)) else trap("VERIFY: Optional::value()")

    if let discretionary = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_ligatures_discretionary):
        ligatures.discretionary = css_data.keyword_to_discretionary_lig_value(css_style_value_to_keyword(discretionary)) else trap("VERIFY: Optional::value()")

    if let historical = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_ligatures_historical):
        ligatures.historical = css_data.keyword_to_historical_lig_value(css_style_value_to_keyword(historical)) else trap("VERIFY: Optional::value()")

    if let contextual = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_ligatures_contextual):
        ligatures.contextual = css_data.keyword_to_contextual_alt_value(css_style_value_to_keyword(contextual)) else trap("VERIFY: Optional::value()")

    return ligatures

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1551 Web::CSS::ComputedProperties::font_variant_numeric.
pub func css_computed_properties_font_variant_numeric(this: CssComputedProperties*) -> CssFontVariantNumeric?:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_variant_numeric)

    if css_style_value_to_keyword(value) == css_data.Keyword.normal:
        return none

    let tuple = css_tuple_style_value_tuple(css_style_value_as_tuple(value))

    var numeric = CssFontVariantNumeric()

    if let figure = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_numeric_figure):
        numeric.figure = css_data.keyword_to_numeric_figure_value(css_style_value_to_keyword(figure)) else trap("VERIFY: Optional::value()")

    if let spacing = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_numeric_spacing):
        numeric.spacing = css_data.keyword_to_numeric_spacing_value(css_style_value_to_keyword(spacing)) else trap("VERIFY: Optional::value()")

    if let fraction = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_numeric_fraction):
        numeric.fraction = css_data.keyword_to_numeric_fraction_value(css_style_value_to_keyword(fraction)) else trap("VERIFY: Optional::value()")

    if *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_numeric_ordinal) != none:
        numeric.ordinal = true

    if *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_numeric_slashed_zero) != none:
        numeric.slashed_zero = true

    return numeric

