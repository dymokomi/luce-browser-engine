## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1436 Web::CSS::ComputedProperties::font_feature_data.
pub func css_computed_properties_font_feature_data(this: CssComputedProperties*) -> CssFontFeatureData:
    return CssFontFeatureData(
        font_variant_alternates = css_computed_properties_font_variant_alternates(this),
        font_variant_caps = css_computed_properties_font_variant_caps(this),
        font_variant_east_asian = css_computed_properties_font_variant_east_asian(this),
        font_variant_emoji = css_computed_properties_font_variant_emoji(this),
        font_variant_ligatures = css_computed_properties_font_variant_ligatures(this),
        font_variant_numeric = css_computed_properties_font_variant_numeric(this),
        font_variant_position = css_computed_properties_font_variant_position(this),
        font_feature_settings = css_computed_properties_font_feature_settings(this),
        font_kerning = css_computed_properties_font_kerning(this),
        text_rendering = css_computed_properties_text_rendering(this))

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1452 Web::CSS::ComputedProperties::font_variant_alternates.
pub func css_computed_properties_font_variant_alternates(this: CssComputedProperties*) -> CssFontVariantAlternates?:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_variant_alternates)

    # normal
    if css_style_value_is_keyword(value):
        assert(css_style_value_to_keyword(value) == css_data.Keyword.normal)
        return none

    var alternates = CssFontVariantAlternates()

    let values = css_style_value_list_values(css_style_value_as_value_list(value))
    for item in ak.vector_span_const(&values):
        # historical-forms
        if css_style_value_is_keyword(item) and css_style_value_to_keyword(item) == css_data.Keyword.historical_forms:
            alternates.historical_forms = true
            continue

        if css_style_value_is_function(item):
            let function = css_style_value_as_function(item)
            let function_type = css_font_feature_value_type_from_string(css_function_style_value_name(function)) else trap("VERIFY: Optional::release_value()")
            let names = css_style_value_list_values(css_style_value_as_value_list(css_function_style_value_value(function)))

            for name in ak.vector_span_const(&names):
                ak.vector_append_t(&alternates.font_feature_value_entries, CssFontFeatureValueKey(type_ = function_type, name = css_string_from_style_value(name)))

            continue

        trap("VERIFY_NOT_REACHED")

    return alternates

