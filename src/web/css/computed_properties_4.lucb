## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1753 Web::CSS::ComputedProperties::touch_action.
pub func css_computed_properties_touch_action(this: CssComputedProperties*) -> CssTouchActionData:
    let touch_action = css_computed_properties_property(this, css_data.PropertyId.touch_action)
    if css_style_value_is_keyword(touch_action):
        match css_style_value_to_keyword(touch_action):
            .auto:
                return css_touch_action_data_new()
            .none_:
                return css_touch_action_data_none()
            .manipulation:
                var manipulation = css_touch_action_data_new()
                manipulation.allow_other = false
                return manipulation
            _:
                trap("VERIFY_NOT_REACHED")
    if css_style_value_is_value_list(touch_action):
        var touch_action_data = css_touch_action_data_none()
        let values = css_style_value_list_values(css_style_value_as_value_list(touch_action))
        for value in ak.vector_span_const(&values):
            match css_keyword_style_value_keyword(css_style_value_as_keyword(value)):
                .pan_x:
                    touch_action_data.allow_right = true
                    touch_action_data.allow_left = true
                .pan_left:
                    touch_action_data.allow_left = true
                .pan_right:
                    touch_action_data.allow_right = true
                .pan_y:
                    touch_action_data.allow_up = true
                    touch_action_data.allow_down = true
                .pan_up:
                    touch_action_data.allow_up = true
                .pan_down:
                    touch_action_data.allow_down = true
                _:
                    trap("VERIFY_NOT_REACHED")
        return touch_action_data
    return css_touch_action_data_new()

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1801 Web::CSS::ComputedProperties::contain.
pub func css_computed_properties_contain(this: CssComputedProperties*) -> CssContainment:
    var containment = CssContainment()
    let value = css_computed_properties_property(this, css_data.PropertyId.contain)

    match css_style_value_to_keyword(value):
        .none_:
            # This value indicates that the property has no effect. The element renders as normal, with no containment effects applied.
