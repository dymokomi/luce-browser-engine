## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1493 Web::CSS::ComputedProperties::font_variant_east_asian.
pub func css_computed_properties_font_variant_east_asian(this: CssComputedProperties*) -> CssFontVariantEastAsian?:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_variant_east_asian)

    if css_style_value_to_keyword(value) == css_data.Keyword.normal:
        return none

    let tuple = css_tuple_style_value_tuple(css_style_value_as_tuple(value))

    var east_asian = CssFontVariantEastAsian()

    if let variant = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_east_asian_variant):
        east_asian.variant = css_data.keyword_to_east_asian_variant(css_style_value_to_keyword(variant)) else trap("VERIFY: Optional::value()")

    if let width = *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_east_asian_width):
        east_asian.width = css_data.keyword_to_east_asian_width(css_style_value_to_keyword(width)) else trap("VERIFY: Optional::value()")

    if *ak.vector_at_const(&tuple, css_tuple_style_value_indices_font_variant_east_asian_ruby) != none:
        east_asian.ruby = true

    return east_asian

