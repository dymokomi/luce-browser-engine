## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1654 Web::CSS::ComputedProperties::grid_auto_flow.
pub func css_computed_properties_grid_auto_flow(this: CssComputedProperties*) -> CssGridAutoFlow:
    let value = css_computed_properties_property(this, css_data.PropertyId.grid_auto_flow)
    if not css_style_value_is_grid_auto_flow(value):
        var grid_auto_flow = CssGridAutoFlow()
        css_grid_auto_flow_init_fields(&grid_auto_flow)
        return grid_auto_flow
    let grid_auto_flow_value = css_style_value_as_grid_auto_flow(value)
    return CssGridAutoFlow(row = css_grid_auto_flow_style_value_is_row(grid_auto_flow_value), dense = css_grid_auto_flow_style_value_is_dense(grid_auto_flow_value))

