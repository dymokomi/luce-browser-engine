## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1586 Web::CSS::ComputedProperties::font_feature_settings.
pub func css_computed_properties_font_feature_settings(this: CssComputedProperties*) -> ak.HashMap[ak.FlyString, u8, ak.FlyStringTraits]:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_feature_settings)

    if css_style_value_is_keyword(value):
        return ak.HashMap[ak.FlyString, u8, ak.FlyStringTraits]()  # normal

    if css_style_value_is_value_list(value):
        let feature_tags = css_style_value_list_values(css_style_value_as_value_list(value))
        var result: ak.HashMap[ak.FlyString, u8, ak.FlyStringTraits]
        ak.hash_map_ensure_capacity(&result, ak.vector_size(&feature_tags))
        for tag_value in ak.vector_span_const(&feature_tags):
            let feature_tag = css_style_value_as_open_type_tagged(tag_value)

            # The C++ int converts to u8 implicitly (HashMap<FlyString, u8>::set).
            _ = ak.hash_map_set(&result, css_open_type_tagged_style_value_tag(feature_tag), (u8)css_int_from_style_value(css_open_type_tagged_style_value_value(feature_tag)))
        return result

    return ak.HashMap[ak.FlyString, u8, ak.FlyStringTraits]()

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1608 Web::CSS::ComputedProperties::font_variation_settings.
pub func css_computed_properties_font_variation_settings(this: CssComputedProperties*) -> ak.HashMap[ak.FlyString, f64, ak.FlyStringTraits]:
    let value = css_computed_properties_property(this, css_data.PropertyId.font_variation_settings)

    if css_style_value_is_keyword(value):
        return ak.HashMap[ak.FlyString, f64, ak.FlyStringTraits]()  # normal

    if css_style_value_is_value_list(value):
        let axis_tags = css_style_value_list_values(css_style_value_as_value_list(value))
        var result: ak.HashMap[ak.FlyString, f64, ak.FlyStringTraits]
        ak.hash_map_ensure_capacity(&result, ak.vector_size(&axis_tags))
        for tag_value in ak.vector_span_const(&axis_tags):
            let axis_tag = css_style_value_as_open_type_tagged(tag_value)

            _ = ak.hash_map_set(&result, css_open_type_tagged_style_value_tag(axis_tag), css_number_from_style_value(css_open_type_tagged_style_value_value(axis_tag), none))
        return result

    return ak.HashMap[ak.FlyString, f64, ak.FlyStringTraits]()

