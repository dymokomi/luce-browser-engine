## accumulate_filter_function's `add_lengths` lambda.
func css_filter_add_lengths(a: CssStyleValue*, b: CssStyleValue*) -> CssStyleValue*:
    let a_length = css_length_from_style_value(a, none)
    let b_length = css_length_from_style_value(b, none)
    let a_value = css_length_absolute_length_to_px_without_rounding(&a_length)
    let b_value = css_length_absolute_length_to_px_without_rounding(&b_length)

    return css_length_style_value_create(css_length_make_px_f64(a_value + b_value)).css_style_value()

## A drop shadow's radius in pixels, or zero without one.
func css_filter_drop_shadow_radius_px(radius: CssStyleValue*?) -> f64:
    let value = radius else return 0.0
    let length = css_length_from_style_value(value, none)
    return css_length_absolute_length_to_px_without_rounding(&length)

## AK::min(255, a + b) over a color channel.
func css_filter_add_channels(a: u8, b: u8) -> u8:
    let sum = (i32)a + (i32)b
    return (u8)(sum if sum < 255 else 255)

## `filter_value.has<FilterOperation::Blur>()` then `get<FilterOperation::Blur>()`: the blur, or none.
func css_filter_value_as_blur(value: const CssFilterValue*) -> CssBlur?:
    match *value:
