## Ported from Libraries/LibWeb/CSS/Interpolation.cpp:2076 Web::CSS::accumulate_filter_function.
# https://drafts.fxtf.org/filter-effects/#accumulation
pub func css_accumulate_filter_function(underlying_list: CssFilterValueListStyleValue*, animated_list: CssFilterValueListStyleValue*) -> ak.Vector[CssFilterValue]:
    # Accumulation of <filter-value-list>s follows the same matching and extending rules as interpolation, falling
    # back to replace behavior if the lists do not match. However instead of interpolating the matching
    # <filter-function> pairs, their arguments are arithmetically added together - except in the case of
    # <filter-function>s whose initial value for interpolation is 1, which combine using one-based addition:
    # Vresult = Va + Vb - 1

    # Extend shorter list with initial values
    let underlying_size = css_filter_value_list_style_value_size(underlying_list)
    let animated_size = css_filter_value_list_style_value_size(animated_list)
    let max_size = animated_size if underlying_size < animated_size else underlying_size
    var extended_underlying: ak.Vector[CssFilterValue]
    var extended_animated: ak.Vector[CssFilterValue]

    for i in 0..<max_size:
        if i < underlying_size:
            ak.vector_append_t(&extended_underlying, *ak.vector_at_const(&underlying_list.m_filter_value_list, i))
        else:
            ak.vector_append_t(&extended_underlying, css_filter_initial_value_for_accumulation(ak.vector_at_const(&animated_list.m_filter_value_list, i)))

        if i < animated_size:
            ak.vector_append_t(&extended_animated, *ak.vector_at_const(&animated_list.m_filter_value_list, i))
        else:
            ak.vector_append_t(&extended_animated, css_filter_initial_value_for_accumulation(ak.vector_at_const(&underlying_list.m_filter_value_list, i)))

    var result: ak.Vector[CssFilterValue]
    ak.vector_ensure_capacity(&result, max_size)
    for i in 0..<max_size:
        let accumulated = css_accumulate_filter(ak.vector_at_const(&extended_underlying, i), ak.vector_at_const(&extended_animated, i)) else return ak.Vector[CssFilterValue]()
        ak.vector_append_t(&result, accumulated)
    return result

