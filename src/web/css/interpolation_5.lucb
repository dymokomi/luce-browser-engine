## Ported from Libraries/LibWeb/CSS/Interpolation.cpp:2246 Web::CSS::interpolate_value.
pub func css_interpolate_value(element: DomElement*, calculation_context: const CssCalculationContext*, from_: CssStyleValue*, to: CssStyleValue*, delta: f32, allow_discrete: CssAllowDiscrete) -> CssStyleValue*?:
    if let result = css_interpolate_value_impl(element, calculation_context, from_, to, delta, allow_discrete):
        return result
    return css_interpolate_discrete(from_, to, delta, allow_discrete)
