        _:
            return none

## `filter_value.has<FilterOperation::HueRotate>()` then `get<...>()`: the hue rotation, or none.
func css_filter_value_as_hue_rotate(value: const CssFilterValue*) -> CssHueRotate?:
    match *value:
        .css_hue_rotate(hue_rotate):
            return hue_rotate
        _:
            return none

## `filter_value.has<FilterOperation::Color>()` then `get<...>()`: the color filter, or none.
func css_filter_value_as_color(value: const CssFilterValue*) -> CssColor?:
    match *value:
        .css_color(color):
            return color
        _:
            return none

## `filter_value.has<FilterOperation::DropShadow>()` then `get<...>()`: the drop shadow, or none.
func css_filter_value_as_drop_shadow(value: const CssFilterValue*) -> CssDropShadow?:
    match *value:
        .css_drop_shadow(drop_shadow):
            return drop_shadow
        _:
            return none

