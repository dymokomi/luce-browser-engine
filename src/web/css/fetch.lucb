## Ported from Libraries/LibWeb/CSS/Fetch.cpp:23 Web::CSS::style_resource_base_url.
# https://drafts.csswg.org/css-values-4/#style-resource-base-url
func css_style_resource_base_url(css_rule_or_declaration: CssRuleOrDeclaration) -> CssStyleSheetAndUrl:
    var rule_or_declaration = css_rule_or_declaration

    # 1. Let sheet be null.
    var sheet: CssCssStyleSheet*? = none

    # 2. If cssRuleOrDeclaration is a CSS declaration block whose parent CSS rule is not null, set cssRuleOrDeclaration to cssRuleOrDeclaration’s parent CSS rule.
    match rule_or_declaration.value:
        .css_rule_or_declaration_style_declaration(block):
            if let parent_rule = block.parent_rule:
                rule_or_declaration.value = .css_rule_or_declaration_rule(CssRuleOrDeclarationRule(parent_style_sheet = css_rule_parent_style_sheet(parent_rule)))
        _: _ = sheet

    # 3. If cssRuleOrDeclaration is a CSS rule, set sheet to cssRuleOrDeclaration’s parent style sheet.
    match rule_or_declaration.value:
        .css_rule_or_declaration_rule(rule):
            if let parent_style_sheet = rule.parent_style_sheet:
                sheet = parent_style_sheet
        _: _ = sheet

    # 4. If sheet is not null:
    if let style_sheet = sheet:
        # 1. If sheet’s stylesheet base URL is not null, return sheet’s stylesheet base URL.
        if let base_url = css_css_style_sheet_base_url(style_sheet):
            return CssStyleSheetAndUrl(sheet = style_sheet, url = base_url)

        # 2. If sheet’s location is not null, return sheet’s location.
        if let location = css_style_sheet_location(style_sheet.css_style_sheet()):
            return CssStyleSheetAndUrl(sheet = style_sheet, url = location)

    # 5. Return cssRuleOrDeclaration’s relevant settings object’s API base URL.
    return CssStyleSheetAndUrl(sheet = sheet, url = html_environment_settings_object_api_base_url(rule_or_declaration.environment_settings_object))

## Ported from Libraries/LibWeb/CSS/Fetch.cpp:57 Web::CSS::resolve_a_style_resource_url.
# https://drafts.csswg.org/css-values-4/#resolve-a-style-resource-url
func css_resolve_a_style_resource_url(url_value: CssStyleResourceUrl, css_rule_or_declaration: CssRuleOrDeclaration) -> web_url.Url?:
    # 1. Let baseURL be the style resource base URL given cssRuleOrDeclaration.
    let base_url = css_style_resource_base_url(css_rule_or_declaration).url

    # 2. Return the result of the URL parser steps with urlValue’s url and base.
    let url_string = match url_value:
        .url(url) => web_url.url_to_string(&url)
        .css_url(url) => css_url_url(&url)
    return domurl_parse(ak.string_bytes_as_string_view(&url_string), base_url)

## Ported from Libraries/LibWeb/CSS/Fetch.cpp:70 Web::CSS::fetch_a_style_resource_impl.
# https://drafts.csswg.org/css-values-4/#fetch-a-style-resource
func css_fetch_a_style_resource_impl(url_value: CssStyleResourceUrl, css_rule_or_declaration: CssRuleOrDeclaration, destination: FetchRequestDestination, cors_mode: CssCorsMode) -> FetchRequest*?:
    let vm = js_cell_vm(css_rule_or_declaration.environment_settings_object.js_cell())

    # 1. Let parsedUrl be the result of resolving urlValue given cssRuleOrDeclaration. If that failed, return.
    let parsed_url = css_resolve_a_style_resource_url(url_value, css_rule_or_declaration) else return none

    # 2. Let settingsObject be cssRuleOrDeclaration’s relevant settings object.
    let environment_settings = css_rule_or_declaration.environment_settings_object

    # 3. Let req be a new request whose url is parsedUrl, whose destination is destination, mode is corsMode,
    #    origin is environmentSettings’s origin, credentials mode is "same-origin", use-url-credentials flag is set,
    #    client is environmentSettings, and whose referrer is environmentSettings’s API base URL.
    let request = fetch_request_create(vm)
    fetch_request_set_url(request, parsed_url)
    fetch_request_set_destination(request, destination)
    fetch_request_set_mode(request, FetchRequestMode.cors if cors_mode == CssCorsMode.cors else FetchRequestMode.no_cors)
    fetch_request_set_origin(request, .origin(html_environment_settings_object_origin(environment_settings)))
    fetch_request_set_credentials_mode(request, FetchRequestCredentialsMode.same_origin)
    fetch_request_set_use_url_credentials(request, true)
    fetch_request_set_client(request, environment_settings)
    fetch_request_set_referrer(request, .url(html_environment_settings_object_api_base_url(environment_settings)))

    # 4. If corsMode is "no-cors", set req’s credentials mode to "include".
    if cors_mode == CssCorsMode.no_cors:
        fetch_request_set_credentials_mode(request, FetchRequestCredentialsMode.include)

    # 5. Apply any URL request modifier steps that apply to this request.
    match url_value:
        .css_url(css_url): css_apply_request_modifiers_from_url_value(css_url, request)
        _: _ = request

    # 6. If req’s mode is "cors", and sheet is not null, then set req’s referrer to the style resource base URL given cssRuleOrDeclaration. [CSSOM]
    # FIXME: Spec issue - sheet is not defined as a variable, we use the sheet determined from 'style resource base URL' instead.
    #        https://github.com/w3c/csswg-drafts/issues/12288
    let sheet_and_url = css_style_resource_base_url(css_rule_or_declaration)
    if fetch_request_mode(request) == FetchRequestMode.cors and sheet_and_url.sheet != none:
        fetch_request_set_referrer(request, .url(sheet_and_url.url))

    # 7. If sheet’s origin-clean flag is set, set req’s initiator type to "css". [CSSOM]
    if let sheet = sheet_and_url.sheet:
        if css_style_sheet_is_origin_clean(sheet.css_style_sheet()):
            fetch_request_set_initiator_type(request, FetchRequestInitiatorType.css)
    else:
        # AD-HOC: If the resource is not associated with a stylesheet, we must still set an initiator type in order
        #         for this resource to be observable through a PerformanceObserver. WPT relies on this.
        fetch_request_set_initiator_type(request, FetchRequestInitiatorType.script)

    # 9. Fetch req, with processresponseconsumebody set to processResponse.
    # NB: Implemented by caller.
    return request

## Ported from Libraries/LibWeb/CSS/Fetch.cpp:126 Web::CSS::fetch_a_style_resource.
# https://drafts.csswg.org/css-values-4/#fetch-a-style-resource
pub func css_fetch_a_style_resource(url_value: CssStyleResourceUrl, css_rule_or_declaration: CssRuleOrDeclaration, destination: FetchRequestDestination, cors_mode: CssCorsMode, process_response: ak.Function2[FetchResponse*, FetchAlgorithmsBodyBytes, unit]) -> FetchController*?:
    let request = css_fetch_a_style_resource_impl(url_value, css_rule_or_declaration, destination, cors_mode) else return none

    let environment_settings = css_rule_or_declaration.environment_settings_object
    let vm = js_cell_vm(environment_settings.js_cell())
    let fetch_algorithms = fetch_algorithms_create(vm, FetchAlgorithmsInput(process_response_consume_body = process_response))
    return fetch_fetching_fetch(html_environment_settings_object_realm(environment_settings), request, fetch_algorithms)

## Ported from Libraries/LibWeb/CSS/Fetch.cpp:142 Web::CSS::fetch_an_external_image_for_a_stylesheet.
# https://drafts.csswg.org/css-images-4/#fetch-an-external-image-for-a-stylesheet
pub func css_fetch_an_external_image_for_a_stylesheet(url_value: CssStyleResourceUrl, declaration: CssRuleOrDeclaration, document: DomDocument*) -> HtmlSharedResourceRequest*?:
    # To fetch an external image for a stylesheet, given a <url> url and a CSS declaration block declaration, fetch a
    # style resource given url, with ruleOrDeclaration being declaration, destination "image", CORS mode "no-cors",
    # and processResponse being the following steps given response res and null, failure or a byte stream byteStream:
    # If byteStream is a byte stream, load the image from the byte stream.
    # NB: We can't directly call fetch_a_style_resource() because we want to make use of SharedResourceRequest to
    #     deduplicate image requests.
    let request = css_fetch_a_style_resource_impl(url_value, declaration, FetchRequestDestination.image, CssCorsMode.no_cors) else return none

    let realm = dom_document_realm(document)
    let shared_resource_request = html_shared_resource_request_get_or_create(realm, dom_document_page(document), fetch_request_url(request))
    if html_shared_resource_request_needs_fetching(shared_resource_request):
        html_shared_resource_request_fetch_resource(shared_resource_request, realm, request)
    return shared_resource_request

## Ported from Libraries/LibWeb/CSS/Fetch.cpp:167 Web::CSS::apply_request_modifiers_from_url_value.
# https://drafts.csswg.org/css-values-5/#apply-request-modifiers-from-url-value
pub func css_apply_request_modifiers_from_url_value(url: CssUrl, request: FetchRequest*):
    # To apply request modifiers from URL value given a request req and a <url> url, call the URL request modifier
    # steps for url’s <request-url-modifier>s in sequence given req.
    let modifiers = css_url_request_url_modifiers(&url)
    for request_url_modifier in ak.vector_span_const(&modifiers):
        css_request_url_modifier_modify_request(&request_url_modifier, request)
