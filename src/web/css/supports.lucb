#==============================================================================================
#
#   supports - CSS::Supports: the condition of an @supports rule or CSS.supports(), and its
#              declaration, selector(), font-tech(), font-format() and env() tests
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Supports.cpp (lines 1-112) and the inline members of Supports.h
#       (lines 19-146). Each test is a BooleanExpression evaluated by the parser
#       (`matches`), so a Supports evaluates its condition once, with no document.
#
#       Copyright (c) 2021-2026, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Supports ================================================================================

## Ported from Libraries/LibWeb/CSS/Supports.h:131 Web::CSS::Supports::create.
pub func css_supports_create(condition: CssBooleanExpression*) -> CssSupports*:
    let this = &(new CssSupports[1] --- else trap("out of memory"))[0]
    css_supports_construct(this, condition)
    return this

## Ported from Libraries/LibWeb/CSS/Supports.cpp:14 Web::CSS::Supports::Supports.
pub func css_supports_construct(this: CssSupports*, condition: CssBooleanExpression*):
    this.m_condition = condition
    this.m_matches = false
    this.m_matches = css_boolean_expression_evaluate_to_boolean(this.m_condition, none)

## Ported from Libraries/LibWeb/CSS/Supports.h:136 Web::CSS::Supports::matches.
pub func css_supports_matches(this: const CssSupports*) -> bool:
    return this.m_matches

## Ported from Libraries/LibWeb/CSS/Supports.cpp:100 Web::CSS::Supports::to_string.
pub func css_supports_to_string(this: const CssSupports*) -> ak.String:
    return css_boolean_expression_to_string(this.m_condition)

## Ported from Libraries/LibWeb/CSS/Supports.cpp:105 Web::CSS::Supports::dump.
pub func css_supports_dump(this: const CssSupports*, builder: ak.StringBuilder*, indent_levels: i32 = 0):
    dump_indent(builder, indent_levels)
    dump_appendff(builder, "Supports condition: (matches = {})\n", [ak.arg_bool(this.m_matches)])
    css_boolean_expression_dump(this.m_condition, builder, indent_levels + 1)

## `String::formatted("<name>({})", argument)`: a test serialized as a function of its argument.
func css_supports_function_string(name: str, argument: ak.StringView) -> ak.String:
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, name)
    ak.string_builder_append(&builder, "(")
    ak.string_builder_append_string_view(&builder, argument)
    ak.string_builder_append(&builder, ")")
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

# mark: Supports::Declaration ===================================================================

## Ported from Libraries/LibWeb/CSS/Supports.h:23 Web::CSS::Supports::Declaration::create.
pub func css_supports_declaration_create(declaration: ak.String, matches: bool) -> CssSupportsDeclaration*:
    let this = &(new CssSupportsDeclaration[1] --- else trap("out of memory"))[0]
    css_supports_declaration_construct(this, declaration, matches)
    return this

## Ported from Libraries/LibWeb/CSS/Supports.h:34 Web::CSS::Supports::Declaration::Declaration.
pub func css_supports_declaration_construct(this: CssSupportsDeclaration*, declaration: ak.String, matches: bool):
    css_boolean_expression_set_class(this.css_boolean_expression(), (const CssBooleanExpressionVTable*)&css_supports_declaration_vtable, &css_supports_declaration_class)
    this.m_declaration = declaration
    this.m_matches = matches

## Ported from Libraries/LibWeb/CSS/Supports.cpp:20 Web::CSS::Supports::Declaration::evaluate (override).
pub func css_supports_declaration_evaluate_impl(base: CssBooleanExpression*, arg0: DomDocument*?) -> CssMatchResult:
    let this = (CssSupportsDeclaration*)base
    return css_as_match_result(this.m_matches)

## Ported from Libraries/LibWeb/CSS/Supports.cpp:25 Web::CSS::Supports::Declaration::to_string (override).
pub func css_supports_declaration_to_string_impl(base: CssBooleanExpression*) -> ak.String:
    let this = (CssSupportsDeclaration*)base
    return this.m_declaration

## Ported from Libraries/LibWeb/CSS/Supports.cpp:30 Web::CSS::Supports::Declaration::dump (override).
pub func css_supports_declaration_dump_impl(base: CssBooleanExpression*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssSupportsDeclaration*)base
    css_boolean_expression_indent(builder, indent_levels)
    dump_appendff(builder, "Declaration: `{}`, matches={}\n", [dump_arg_string(&this.m_declaration), ak.arg_bool(this.m_matches)])

