## Ported from Libraries/LibWeb/CSS/Supports.cpp:89 Web::CSS::Supports::Env::to_string (override).
pub func css_supports_env_to_string_impl(base: CssBooleanExpression*) -> ak.String:
    let this = (CssSupportsEnv*)base
    # Donor quirk kept: env() serializes as `font-format(...)`.
    let identifier = css_syntax.serialize_an_identifier_string_view(ak.fly_string_bytes_as_string_view(&this.m_variable_name))
    return css_supports_function_string("font-format", ak.string_bytes_as_string_view(&identifier))

