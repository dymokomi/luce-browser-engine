# mark: CSSKeyframesRule ========================================================================

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.h:31 Web::CSS::CSSKeyframesRule::css_rules.
pub func css_keyframes_rule_css_rules(this: CssKeyframesRule*) -> CssRuleList*:
    return this.m_rules

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.h:32 Web::CSS::CSSKeyframesRule::name.
pub func css_keyframes_rule_name(this: CssKeyframesRule*) -> ak.FlyString:
    return this.m_name

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.h:35 Web::CSS::CSSKeyframesRule::set_name.
pub func css_keyframes_rule_set_name(this: CssKeyframesRule*, name: ak.String):
    this.m_name = ak.fly_string_from_string(name)

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:19 Web::CSS::CSSKeyframesRule::create.
pub func css_keyframes_rule_create(realm: Realm*, name: ak.FlyString, css_rules: CssRuleList*) -> CssKeyframesRule*:
    return realm_create_css_keyframes_rule(realm, realm, name, css_rules)

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:24 Web::CSS::CSSKeyframesRule::CSSKeyframesRule.
pub func css_keyframes_rule_construct(this: CssKeyframesRule*, realm: Realm*, name: ak.FlyString, keyframes: CssRuleList*):
    css_rule_construct(this.css_rule(), realm, CssRuleType.keyframes)
    this.m_name = name
    this.m_rules = keyframes
    for rule in ak.vector_span(&this.m_rules.m_rules):
        css_rule_set_parent_rule(rule, this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:33 Web::CSS::CSSKeyframesRule::visit_edges (override).
pub func css_keyframes_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssKeyframesRule*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_rules)

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:39 Web::CSS::CSSKeyframesRule::initialize (override).
pub func css_keyframes_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_keyframes_rule)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:45 Web::CSS::CSSKeyframesRule::serialized (override).
pub func css_keyframes_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssKeyframesRule*)base
    var builder = ak.string_builder_new()
    dump_appendff(&builder, "@keyframes \"{}\"", [css_arg_fly_string(&this.m_name)])
    ak.string_builder_append(&builder, " { ")
    for keyframe in ak.vector_span(&this.m_rules.m_rules):
        let text = css_rule_css_text(keyframe)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))
        ak.string_builder_append_u8(&builder, ' ')
    ak.string_builder_append_u8(&builder, '}')
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:58 Web::CSS::CSSKeyframesRule::length.
pub func css_keyframes_rule_length(this: CssKeyframesRule*) -> u32:
    return (u32)css_rule_list_length(this.m_rules)

## Ported from Libraries/LibWeb/CSS/CSSKeyframesRule.cpp:63 Web::CSS::CSSKeyframesRule::dump (override).
pub func css_keyframes_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssKeyframesRule*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Name: {}\n", [css_arg_fly_string(&this.m_name)])
    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Keyframes ({}):\n", [ak.arg_u64((u64)css_keyframes_rule_length(this))])
    for rule in ak.vector_span(&this.m_rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 2)
