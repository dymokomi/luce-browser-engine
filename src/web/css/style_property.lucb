## Ported from Libraries/LibWeb/CSS/StyleProperty.cpp:14 Web::CSS::StyleProperty::operator==.
pub func css_style_property_eq(this: const CssStyleProperty*, other: CssStyleProperty) -> bool:
    if this.important != other.important or this.property_id != other.property_id:
        return false
    return css_style_value_equals(this.value, other.value)
