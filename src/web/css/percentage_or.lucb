#==============================================================================================
#
#   percentage_or - PercentageOr<T>, LengthPercentage and LengthPercentageOrAuto
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/PercentageOr.h (lines 1-306). PercentageOr<T> is a generic struct
#       over CssPercentageOrValue[T] (types_percentage_or). Its members that only look at
#       the variant stay generic; the members that use T's own operations (serialize,
#       operator==, to_px, resolved, T::resolve_calculated) are written for the template's
#       one instantiation, PercentageOr<Length> (the C++ says so in its FIXME; a luce-base
#       generic cannot call a type parameter's functions without an interface). For the same
#       reason `resolved(Layout::Node const&, T)`, which `requires(!IsSame<T, Length>)` and so
#       is never instantiated, is not ported.
#
#       LengthPercentage embeds PercentageOr<Length> as `percentage_or`; its inherited
#       constructors are css_length_percentage_new_*. The defaulted operator== of
#       LengthPercentageOrAuto compares calculated values by value and is
#       css_length_percentage_or_auto_eq.
#
#       Copyright (c) 2022-2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# FIXME: LengthPercentage is the only remaining derived class of PercentageOr so we can just merge them together. It
#        should also probably instead be CSSPixelsPercentage since it is only used after computation where we resolve
#        all relative lengths.

# mark: PercentageOr<T> =========================================================================

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:30 Web::CSS::PercentageOr::PercentageOr<T>.
pub func css_percentage_or_construct_t[T](this: CssPercentageOr[T]*, t: T):
    this.m_value = .t(t)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:35 Web::CSS::PercentageOr::PercentageOr<T>.
pub func css_percentage_or_construct_css_percentage[T](this: CssPercentageOr[T]*, percentage: CssPercentage):
    this.m_value = .css_percentage(percentage)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:40 Web::CSS::PercentageOr::PercentageOr<T>.
pub func css_percentage_or_construct_css_calculated_style_value[T](this: CssPercentageOr[T]*, calculated: CssCalculatedStyleValue*):
    this.m_value = .css_calculated_style_value(calculated)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:59 Web::CSS::PercentageOr::is_percentage.
pub func css_percentage_or_is_percentage[T](this: const CssPercentageOr[T]*) -> bool:
    match this.m_value:
        .css_percentage(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:60 Web::CSS::PercentageOr::is_calculated.
pub func css_percentage_or_is_calculated[T](this: const CssPercentageOr[T]*) -> bool:
    match this.m_value:
        .css_calculated_style_value(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:62 Web::CSS::PercentageOr::contains_percentage.
pub func css_percentage_or_contains_percentage[T](this: const CssPercentageOr[T]*) -> bool:
    match this.m_value:
        .t(_): return false
        .css_percentage(_): return true
        .css_calculated_style_value(calculated): return css_calculated_style_value_contains_percentage(calculated)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:76 Web::CSS::PercentageOr::percentage.
pub func css_percentage_or_percentage[T](this: const CssPercentageOr[T]*) -> CssPercentage:
    match this.m_value:
        .css_percentage(percentage): return percentage
        _: trap("VERIFY: is_percentage()")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:82 Web::CSS::PercentageOr::calculated.
pub func css_percentage_or_calculated[T](this: const CssPercentageOr[T]*) -> CssCalculatedStyleValue*:
    match this.m_value:
        .css_calculated_style_value(calculated): return calculated
        _: trap("VERIFY: is_calculated()")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:88 Web::CSS::PercentageOr::to_px (T = Length).
pub func css_percentage_or_to_px(this: const CssPercentageOr[CssLength]*, layout_node: LayoutNode*, reference_value: gfx.CssPixels) -> gfx.CssPixels:
    # `if constexpr (IsSame<T, Length>)`: always, here.
    if css_percentage_or_is_t(this):
        let length = css_percentage_or_get_t(this)
        if css_length_is_absolute(&length):
            return css_length_absolute_length_to_px(&length)
    let resolved = css_percentage_or_resolved_css_pixels(this, layout_node, reference_value)
    return css_length_to_px_layout_node(&resolved, layout_node)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:114 Web::CSS::PercentageOr::resolved (T = Length).
pub func css_percentage_or_resolved_css_pixels(this: const CssPercentageOr[CssLength]*, layout_node: LayoutNode*, reference_value: gfx.CssPixels) -> CssLength:
    match this.m_value:
        .t(t): return t
        .css_percentage(percentage):
            let pixels = gfx.css_pixels_from_f64(gfx.mul_f64(css_percentage_value(&percentage), reference_value))
            let fraction = gfx.div_css_pixels_int(pixels, 100)
            return css_length_make_px_css_pixels(gfx.css_pixel_fraction_to_css_pixels(&fraction))
        .css_calculated_style_value(calculated):
            return css_length_resolve_calculated_css_pixels(calculated, layout_node, reference_value)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:128 Web::CSS::PercentageOr::serialize (T = Length).
pub func css_percentage_or_serialize(this: const CssPercentageOr[CssLength]*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    match this.m_value:
        .css_calculated_style_value(calculated): css_style_value_serialize(calculated.css_style_value(), builder, mode)
        .css_percentage(percentage): css_percentage_serialize(&percentage, builder, mode)
        .t(t): css_length_serialize(&t, builder, mode)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:139 Web::CSS::PercentageOr::to_string (T = Length).
pub func css_percentage_or_to_string(this: const CssPercentageOr[CssLength]*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_percentage_or_serialize(this, &builder, mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:146 Web::CSS::PercentageOr::operator== (T = Length).
pub func css_percentage_or_eq(this: const CssPercentageOr[CssLength]*, other: CssPercentageOr[CssLength]) -> bool:
    if css_percentage_or_is_calculated(this) != css_percentage_or_is_calculated(&other):
        return false
    if css_percentage_or_is_percentage(this) != css_percentage_or_is_percentage(&other):
        return false
    if css_percentage_or_is_calculated(this):
        return css_style_value_eq(css_percentage_or_calculated(this).css_style_value(), css_percentage_or_calculated(&other).css_style_value())
    if css_percentage_or_is_percentage(this):
        return css_percentage_eq_value(css_percentage_or_percentage(this), css_percentage_or_percentage(&other))
    let length = css_percentage_or_get_t(this)
    return css_length_eq(&length, css_percentage_or_get_t(&other))

## `Percentage == Percentage` on two values.
func css_percentage_eq_value(left: CssPercentage, right: CssPercentage) -> bool:
    return css_percentage_eq(&left, right)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:160 Web::CSS::PercentageOr::is_t.
pub func css_percentage_or_is_t[T](this: const CssPercentageOr[T]*) -> bool:
    match this.m_value:
        .t(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:161 Web::CSS::PercentageOr::get_t.
pub func css_percentage_or_get_t[T](this: const CssPercentageOr[T]*) -> T:
    match this.m_value:
        .t(t): return t
        _: trap("VERIFY: is_t()")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:168 Web::CSS::operator==(PercentageOr<T> const&, T const&) (T = Length).
pub func css_eq_css_percentage_or_t(percentage_or: CssPercentageOr[CssLength], t: CssLength) -> bool:
    var other: CssPercentageOr[CssLength] = ---
    css_percentage_or_construct_t(&other, t)
    return css_percentage_or_eq(&percentage_or, other)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:174 Web::CSS::operator==(T const&, PercentageOr<T> const&) (T = Length).
pub func css_eq_t(t: CssLength, percentage_or: CssPercentageOr[CssLength]) -> bool:
    return css_eq_css_percentage_or_t(percentage_or, t)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:180 Web::CSS::operator==(PercentageOr<T> const&, Percentage const&) (T = Length).
pub func css_eq_css_percentage_or_css_percentage(percentage_or: CssPercentageOr[CssLength], percentage: CssPercentage) -> bool:
    var other: CssPercentageOr[CssLength] = ---
    css_percentage_or_construct_css_percentage(&other, percentage)
    return css_percentage_or_eq(&percentage_or, other)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:186 Web::CSS::operator==(Percentage const&, PercentageOr<T> const&) (T = Length).
pub func css_eq_css_percentage(percentage: CssPercentage, percentage_or: CssPercentageOr[CssLength]) -> bool:
    return css_eq_css_percentage_or_css_percentage(percentage_or, percentage)

# mark: LengthPercentage ========================================================================

## `LengthPercentage { length }`: the inherited PercentageOr<Length>(Length) constructor.
pub func css_length_percentage_new_css_length(length: CssLength) -> CssLengthPercentage:
    var length_percentage: CssLengthPercentage = ---
    css_percentage_or_construct_t(&length_percentage.percentage_or, length)
    return length_percentage

## `LengthPercentage { percentage }`: the inherited PercentageOr<Length>(Percentage) constructor.
pub func css_length_percentage_new_css_percentage(percentage: CssPercentage) -> CssLengthPercentage:
    var length_percentage: CssLengthPercentage = ---
    css_percentage_or_construct_css_percentage(&length_percentage.percentage_or, percentage)
    return length_percentage

## `LengthPercentage { calculated }`: the inherited PercentageOr<Length>(NonnullRefPtr<CalculatedStyleValue const>)
## constructor.
pub func css_length_percentage_new_css_calculated_style_value(calculated: CssCalculatedStyleValue*) -> CssLengthPercentage:
    var length_percentage: CssLengthPercentage = ---
    css_percentage_or_construct_css_calculated_style_value(&length_percentage.percentage_or, calculated)
    return length_percentage

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:195 Web::CSS::LengthPercentage::from_style_value.
pub func css_length_percentage_from_style_value(style_value: CssStyleValue*) -> CssLengthPercentage:
    if css_style_value_is_percentage(style_value):
        return css_length_percentage_new_css_percentage(css_percentage_style_value_percentage(css_style_value_as_percentage(style_value)))
    if css_style_value_is_length(style_value):
        return css_length_percentage_new_css_length(css_length_style_value_length(css_style_value_as_length(style_value)))
    if css_style_value_is_calculated(style_value):
        return css_length_percentage_new_css_calculated_style_value(css_style_value_as_calculated(style_value))
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:207 Web::CSS::LengthPercentage::is_length.
pub func css_length_percentage_is_length(this: const CssLengthPercentage*) -> bool:
    return css_percentage_or_is_t(&this.percentage_or)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:208 Web::CSS::LengthPercentage::length.
pub func css_length_percentage_length(this: const CssLengthPercentage*) -> CssLength:
    return css_percentage_or_get_t(&this.percentage_or)

# mark: LengthPercentageOrAuto ==================================================================

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:213 Web::CSS::LengthPercentageOrAuto::LengthPercentageOrAuto.
pub func css_length_percentage_or_auto_construct_css_length_percentage(this: CssLengthPercentageOrAuto*, length_percentage: CssLengthPercentage):
    this.m_length_percentage = length_percentage

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:218 Web::CSS::LengthPercentageOrAuto::LengthPercentageOrAuto.
pub func css_length_percentage_or_auto_construct_css_length(this: CssLengthPercentageOrAuto*, length: CssLength):
    this.m_length_percentage = css_length_percentage_new_css_length(length)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:223 Web::CSS::LengthPercentageOrAuto::LengthPercentageOrAuto.
pub func css_length_percentage_or_auto_construct_css_percentage(this: CssLengthPercentageOrAuto*, percentage: CssPercentage):
    this.m_length_percentage = css_length_percentage_new_css_percentage(percentage)

## `LengthPercentageOrAuto { length_percentage }` (the implicit conversion) as a value.
pub func css_length_percentage_or_auto_new(length_percentage: CssLengthPercentage) -> CssLengthPercentageOrAuto:
    var result: CssLengthPercentageOrAuto = ---
    css_length_percentage_or_auto_construct_css_length_percentage(&result, length_percentage)
    return result

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:228 Web::CSS::LengthPercentageOrAuto::make_auto.
pub func css_length_percentage_or_auto_make_auto() -> CssLengthPercentageOrAuto:
    # LengthPercentageOrAuto() = default: no length-percentage.
    return CssLengthPercentageOrAuto(m_length_percentage = none)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:233 Web::CSS::LengthPercentageOrAuto::from_style_value.
pub func css_length_percentage_or_auto_from_style_value(style_value: CssStyleValue*) -> CssLengthPercentageOrAuto:
    if css_style_value_has_auto(style_value):
        return css_length_percentage_or_auto_make_auto()
    return css_length_percentage_or_auto_new(css_length_percentage_from_style_value(style_value))

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:241 Web::CSS::LengthPercentageOrAuto::is_auto.
pub func css_length_percentage_or_auto_is_auto(this: const CssLengthPercentageOrAuto*) -> bool:
    return this.m_length_percentage == none

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:242 Web::CSS::LengthPercentageOrAuto::is_length.
pub func css_length_percentage_or_auto_is_length(this: const CssLengthPercentageOrAuto*) -> bool:
    if let length_percentage = this.m_length_percentage:
        return css_length_percentage_is_length(&length_percentage)
    return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:243 Web::CSS::LengthPercentageOrAuto::is_percentage.
pub func css_length_percentage_or_auto_is_percentage(this: const CssLengthPercentageOrAuto*) -> bool:
    if let length_percentage = this.m_length_percentage:
        return css_percentage_or_is_percentage(&length_percentage.percentage_or)
    return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:244 Web::CSS::LengthPercentageOrAuto::is_calculated.
pub func css_length_percentage_or_auto_is_calculated(this: const CssLengthPercentageOrAuto*) -> bool:
    if let length_percentage = this.m_length_percentage:
        return css_percentage_or_is_calculated(&length_percentage.percentage_or)
    return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:246 Web::CSS::LengthPercentageOrAuto::contains_percentage.
pub func css_length_percentage_or_auto_contains_percentage(this: const CssLengthPercentageOrAuto*) -> bool:
    if let length_percentage = this.m_length_percentage:
        return css_percentage_or_contains_percentage(&length_percentage.percentage_or)
    return false

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:248 Web::CSS::LengthPercentageOrAuto::length_percentage.
pub func css_length_percentage_or_auto_length_percentage(this: const CssLengthPercentageOrAuto*) -> CssLengthPercentage:
    return this.m_length_percentage else trap("VERIFY: not auto")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:249 Web::CSS::LengthPercentageOrAuto::length.
pub func css_length_percentage_or_auto_length(this: const CssLengthPercentageOrAuto*) -> CssLength:
    let length_percentage = this.m_length_percentage else trap("VERIFY: not auto")
    return css_length_percentage_length(&length_percentage)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:250 Web::CSS::LengthPercentageOrAuto::percentage.
pub func css_length_percentage_or_auto_percentage(this: const CssLengthPercentageOrAuto*) -> CssPercentage:
    let length_percentage = this.m_length_percentage else trap("VERIFY: not auto")
    return css_percentage_or_percentage(&length_percentage.percentage_or)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:251 Web::CSS::LengthPercentageOrAuto::calculated.
pub func css_length_percentage_or_auto_calculated(this: const CssLengthPercentageOrAuto*) -> CssCalculatedStyleValue*:
    let length_percentage = this.m_length_percentage else trap("VERIFY: not auto")
    return css_percentage_or_calculated(&length_percentage.percentage_or)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:253 Web::CSS::LengthPercentageOrAuto::resolved_or_auto.
pub func css_length_percentage_or_auto_resolved_or_auto(this: const CssLengthPercentageOrAuto*, layout_node: LayoutNode*, reference_value: gfx.CssPixels) -> CssLengthOrAuto:
    if css_length_percentage_or_auto_is_auto(this):
        return css_length_or_auto_make_auto()
    let length_percentage = css_length_percentage_or_auto_length_percentage(this)
    return css_length_or_auto_new(css_percentage_or_resolved_css_pixels(&length_percentage.percentage_or, layout_node, reference_value))

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:260 Web::CSS::LengthPercentageOrAuto::to_px_or_zero.
pub func css_length_percentage_or_auto_to_px_or_zero(this: const CssLengthPercentageOrAuto*, layout_node: LayoutNode*, reference_value: gfx.CssPixels) -> gfx.CssPixels:
    if css_length_percentage_or_auto_is_auto(this):
        return gfx.css_pixels_from_int(0)
    let length_percentage = css_length_percentage_or_auto_length_percentage(this)
    return css_percentage_or_to_px(&length_percentage.percentage_or, layout_node, reference_value)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:267 Web::CSS::LengthPercentageOrAuto::serialize.
pub func css_length_percentage_or_auto_serialize(this: const CssLengthPercentageOrAuto*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    if let length_percentage = this.m_length_percentage:
        css_percentage_or_serialize(&length_percentage.percentage_or, builder, mode)
    else:
        ak.string_builder_append(builder, "auto")

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:275 Web::CSS::LengthPercentageOrAuto::to_string.
pub func css_length_percentage_or_auto_to_string(this: const CssLengthPercentageOrAuto*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_length_percentage_or_auto_serialize(this, &builder, mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/PercentageOr.h:282 Web::CSS::LengthPercentageOrAuto::operator== (defaulted:
## the optionals compare as PercentageOr<Length>::operator== does).
pub func css_length_percentage_or_auto_eq(this: const CssLengthPercentageOrAuto*, other: CssLengthPercentageOrAuto) -> bool:
    if let length_percentage = this.m_length_percentage:
        if let other_length_percentage = other.m_length_percentage:
            return css_percentage_or_eq(&length_percentage.percentage_or, other_length_percentage.percentage_or)
        return false
    return other.m_length_percentage == none
