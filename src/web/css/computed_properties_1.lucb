# mark: Inline members of ComputedProperties.h ==================================================

## The callback of ComputedProperties::for_each_property: the C++ template takes any callable
## `callback(PropertyID, StyleValue const&)`; a Luce caller passes a pointer to a struct that
## conforms (Dump's cascaded-properties lambda is DumpTreeComputedProperty).
pub interface CssComputedPropertiesPropertyCallback:
    mutating func call(property_id: css_data.PropertyId, value: CssStyleValue*)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:53 Web::CSS::ComputedProperties::for_each_property.
pub func css_computed_properties_for_each_property[TCallback: CssComputedPropertiesPropertyCallback](this: CssComputedProperties*, callback: TCallback*):
    for i in 0..<css_data.number_of_longhand_properties:
        if let value = this.m_property_values[i]:
            callback.call((css_data.PropertyId)(i + (usize)css_data.first_longhand_property_id), value)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:68 Web::CSS::ComputedProperties::animated_property_values.
pub func css_computed_properties_animated_property_values(this: CssComputedProperties*) -> ak.HashMap[css_data.PropertyId, CssStyleValue*, css_data.PropertyIdTraits]:
    return this.m_animated_property_values

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:250 Web::CSS::ComputedProperties::cached_computed_font_list.
pub func css_computed_properties_cached_computed_font_list(this: CssComputedProperties*) -> const web_fonts.FontCascadeList*?:
    return this.m_cached_computed_font_list

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:277 Web::CSS::ComputedProperties::has_attempted_match_against_pseudo_class.
pub func css_computed_properties_has_attempted_match_against_pseudo_class(this: CssComputedProperties*, pseudo_class: css_data.PseudoClass) -> bool:
    return css_pseudo_class_bitmap_get(&this.m_attempted_pseudo_class_matches, pseudo_class)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:282 Web::CSS::ComputedProperties::set_attempted_pseudo_class_matches.
pub func css_computed_properties_set_attempted_pseudo_class_matches(this: CssComputedProperties*, results: CssPseudoClassBitmap):
    this.m_attempted_pseudo_class_matches = results

## Ported from Libraries/LibWeb/CSS/ComputedProperties.h:308 Web::CSS::ComputedProperties::clear_computed_font_list_cache.
pub func css_computed_properties_clear_computed_font_list_cache(this: CssComputedProperties*):
    this.m_cached_computed_font_list = none
    this.m_cached_first_available_computed_font = none

# mark: Construction and the property store =====================================================

## The index of `property_id` in the per-longhand arrays (C++ `to_underlying(id) -
## to_underlying(first_longhand_property_id)`), after the VERIFY that it is a longhand.
func css_computed_properties_longhand_index(property_id: css_data.PropertyId) -> usize:
    assert((usize)property_id >= (usize)css_data.first_longhand_property_id and (usize)property_id <= (usize)css_data.last_longhand_property_id)
    return (usize)property_id - (usize)css_data.first_longhand_property_id

## Bit `n` of a per-longhand flag array (`flags[n // 8] & (1 << (n % 8))`).
func css_computed_properties_flag(flags: const u8[], n: usize) -> bool:
    return (flags[n // 8] & ((u8)1 << (u8)(n % 8))) != 0

## Sets or clears bit `n` of a per-longhand flag array (`flags[n // 8] |= ...` / `&= ~...`).
func css_computed_properties_set_flag(flags: u8[], n: usize, value: bool):
    if value:
        flags[n // 8] |= (u8)1 << (u8)(n % 8)
    else:
        flags[n // 8] &= ~((u8)1 << (u8)(n % 8))

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:62 Web::CSS::ComputedProperties::ComputedProperties.
pub func css_computed_properties_construct(this: CssComputedProperties*):
    css_computed_properties_init_fields(this)

