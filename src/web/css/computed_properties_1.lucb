## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:71 Web::CSS::ComputedProperties::is_property_important.
pub func css_computed_properties_is_property_important(this: CssComputedProperties*, property_id: css_data.PropertyId) -> bool:
    let n = css_computed_properties_longhand_index(property_id)
    return css_computed_properties_flag(this.m_property_important, n)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:79 Web::CSS::ComputedProperties::set_property_important.
pub func css_computed_properties_set_property_important(this: CssComputedProperties*, property_id: css_data.PropertyId, important: css_syntax.Important):
    let n = css_computed_properties_longhand_index(property_id)
    css_computed_properties_set_flag(this.m_property_important, n, important == css_syntax.Important.yes)

