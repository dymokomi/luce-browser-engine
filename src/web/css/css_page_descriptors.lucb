## Ported from Libraries/LibWeb/CSS/CSSPageDescriptors.cpp:16 Web::CSS::CSSPageDescriptors::create.
pub func css_page_descriptors_create(realm: Realm*, descriptors: ak.Vector[CssDescriptor]) -> CssPageDescriptors*:
    return realm_create_css_page_descriptors(realm, realm, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSPageDescriptors.cpp:21 Web::CSS::CSSPageDescriptors::CSSPageDescriptors.
pub func css_page_descriptors_construct(this: CssPageDescriptors*, realm: Realm*, descriptors: ak.Vector[CssDescriptor]):
    css_descriptors_construct(this.css_descriptors(), realm, css_data.AtRuleId.page, descriptors)

## Ported from Libraries/LibWeb/CSS/CSSPageDescriptors.cpp:28 Web::CSS::CSSPageDescriptors::initialize (override).
pub func css_page_descriptors_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_page_descriptors)
    css_style_declaration_initialize_impl(base, realm)

# mark: The descriptor attributes ===============================================================

## Ported from Libraries/LibWeb/CSS/CSSPageDescriptors.cpp:34 Web::CSS::CSSPageDescriptors::set_margin.
pub func css_page_descriptors_set_margin(this: CssPageDescriptors*, value: ak.StringView) -> !:
    try css_style_declaration_set_property(this.css_style_declaration(), ak.fly_string_from_str("margin"), value, ak.sv(""))

## Ported from Libraries/LibWeb/CSS/CSSPageDescriptors.cpp:39 Web::CSS::CSSPageDescriptors::margin.
pub func css_page_descriptors_margin(this: CssPageDescriptors*) -> ak.String:
    return css_style_declaration_get_property_value(this.css_style_declaration(), ak.fly_string_from_str("margin"))

