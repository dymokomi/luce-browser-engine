#==============================================================================================
#
#   tests_css_sheets_3 - focused tests of style sheet structure the oracle cases do not print
#
#   DESCRIPTION:
#       Parent rule and parent style sheet links through grouping rules, the traversal of
#       effective rules, StyleSheetList's tree-order list, the critical-subresource loading
#       state, and the GeneratedCSSStyleProperties mixin's link back to its CSSStyleProperties.
#       Expected values follow the C++ (CSSRule.cpp, CSSGroupingRule.cpp, CSSRuleList.cpp,
#       StyleSheetList.cpp, CSSStyleSheet.cpp).
#
#==============================================================================================

## The class names of the rules a traversal visits, as one string.
func test_css_sheets_3_visit(context: void*?, rule: CssRule*):
    let builder = (ak.StringBuilder*)(context else trap("no builder"))
    if css_rule_type(rule) == CssRuleType.style:
        let selector = css_style_rule_selector_text(as_css_style_rule(rule))
        dump_appendff(builder, "{} ", [css_arg_string(&selector)])
    else:
        dump_appendff(builder, "{} ", [ak.arg_string_view(dump_class_name(rule.cell()))])

test "parent links: nested rules know their parent rule and the sheet, and losing the sheet propagates (CSSGroupingRule.cpp:16, 67)":
    let (vm, realm, _) = test_html_setup()
    defer web_test_destroy_vm(vm)
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let sheet = parse_css_stylesheet(test_css_sheets_params(realm), ak.sv("a { b { c {} } } @layer x { d {} }"))
        let rules = css_css_style_sheet_rules(sheet)
        let a = css_rule_list_item(rules, 0) else trap("a")
        let b = css_rule_list_item(css_grouping_rule_css_rules(as_css_grouping_rule(a)), 0) else trap("b")
        let c = css_rule_list_item(css_grouping_rule_css_rules(as_css_grouping_rule(b)), 0) else trap("c")
        assert(css_rule_parent_rule(a) == none)
        assert(css_rule_parent_rule(b) == a and css_rule_parent_rule(c) == b)
        assert(css_rule_parent_style_sheet(a) == sheet and css_rule_parent_style_sheet(c) == sheet)
        # The declaration block of a style rule has the rule as its parent.
        let declaration = css_style_rule_declaration(as_css_style_rule(c))
        assert(css_style_declaration_parent_rule(declaration.css_style_declaration()) == c)
        # set_parent_style_sheet(nullptr) on a grouping rule reaches every descendant.
        css_rule_set_parent_style_sheet(a, none)
        assert(css_rule_parent_style_sheet(b) == none and css_rule_parent_style_sheet(c) == none)
        # set_parent_rule takes the parent's sheet (here none) and clears the layer cache.
        let layer = css_rule_list_item(rules, 1) else trap("layer")
        let d = css_rule_list_item(css_grouping_rule_css_rules(as_css_grouping_rule(layer)), 0) else trap("d")
        let layer_name = css_style_rule_qualified_layer_name(as_css_style_rule(d))
        assert(ak.fly_string_eq_string_view(&layer_name, ak.sv("x")))
        assert(d.m_cached_layer_name != none)
        css_rule_set_parent_rule(d, none)
        assert(d.m_cached_layer_name == none and css_rule_parent_style_sheet(d) == none)
        let no_layer = css_style_rule_qualified_layer_name(as_css_style_rule(d))
        assert(ak.fly_string_is_empty(&no_layer))

test "effective rules: pre-order and post-order walks of a sheet, and only style-producing rules (CSSRuleList.cpp:187, CSSStyleSheet.cpp:329)":
    let (vm, realm, document) = test_html_setup()
    defer web_test_destroy_vm(vm)
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let sheet = parse_css_stylesheet(test_css_sheets_params(realm), ak.sv("a { b {} } @layer x { c {} } @layer y; @page { @top-left {} }"))
        var pre = ak.string_builder_new()
        css_css_style_sheet_for_each_effective_rule(sheet, TraversalOrder.preorder, ak.Function1[CssRule*, unit](call = test_css_sheets_3_visit, context = &pre))
        let pre_text = ak.string_builder_string_view(&pre)
        assert(ak.string_view_equals(&pre_text, "a & b CSSLayerBlockRule c CSSLayerStatementRule CSSPageRule CSSMarginRule "))
        var post = ak.string_builder_new()
        css_css_style_sheet_for_each_effective_rule(sheet, TraversalOrder.postorder, ak.Function1[CssRule*, unit](call = test_css_sheets_3_visit, context = &post))
        let post_text = ak.string_builder_string_view(&post)
        assert(ak.string_view_equals(&post_text, "& b a c CSSLayerBlockRule CSSLayerStatementRule CSSMarginRule CSSPageRule "))
        var producing = ak.string_builder_new()
        css_css_style_sheet_for_each_effective_style_producing_rule(sheet, ak.Function1[CssRule*, unit](call = test_css_sheets_3_visit, context = &producing))
        let producing_text = ak.string_builder_string_view(&producing)
        assert(ak.string_view_equals(&producing_text, "a & b c "))
        # No media query changes match state in a sheet without @media.
        assert(not css_rule_list_evaluate_media_queries(css_css_style_sheet_rules(sheet), document))

test "StyleSheetList: a disabled empty sheet is added in tree order without invalidation (StyleSheetList.cpp:35, 136)":
    let (vm, realm, document) = test_html_setup()
    defer web_test_destroy_vm(vm)
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let list = css_style_sheet_list_create(document.dom_node())
        assert(css_style_sheet_list_length(list) == 0 and css_style_sheet_list_item(list, 0) == none)
        assert(css_style_sheet_list_document(list) == document)
        let sheet = parse_css_stylesheet(test_css_sheets_params(realm), ak.sv(""))
        # StyleSheet::set_disabled: the base's flag (CSSStyleSheet's override invalidates owners, region r42).
        css_style_sheet_set_disabled_impl(sheet.css_style_sheet(), true)
        css_style_sheet_list_add_a_css_style_sheet(list, sheet)
        assert(css_style_sheet_list_length(list) == 1 and css_style_sheet_list_item(list, 0) == sheet)
        assert(css_css_style_sheet_owning_document(sheet) == document)
        let owners = css_css_style_sheet_owning_documents_or_shadow_roots(sheet)
        assert(ak.hash_table_size(&owners) == 1)
        assert(sheet.m_did_match == true)

test "CSSStyleSheet loading state follows its critical subresources (CSSStyleSheet.cpp:573-626)":
    let (vm, realm, _) = test_html_setup()
    defer web_test_destroy_vm(vm)
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let sheet = parse_css_stylesheet(test_css_sheets_params(realm), ak.sv("a {}"))
        assert(css_css_style_sheet_loading_state(sheet) == CssStyleSheetLoadingState.loaded)
        var url: CssUrl = ---
        css_url_construct(&url, ak.string_from_str("x.css"), CssUrlType.url, ak.Vector[CssRequestUrlModifier]())
        let first = css_import_rule_create(realm, url, none, none, none, css_media_list_create(realm, ak.Vector[CssMediaQuery*]()))
        let second = css_import_rule_create(realm, url, none, none, none, css_media_list_create(realm, ak.Vector[CssMediaQuery*]()))
        css_css_style_sheet_add_critical_subresource(sheet, &first.subresource)
        css_css_style_sheet_add_critical_subresource(sheet, &second.subresource)
        # Unloaded counts as loading.
        assert(css_css_style_sheet_loading_state(sheet) == CssStyleSheetLoadingState.loading)
        css_style_sheet_subresource_set_loading_state(&first.subresource, CssStyleSheetLoadingState.error_)
        assert(css_css_style_sheet_loading_state(sheet) == CssStyleSheetLoadingState.loading)
        css_style_sheet_subresource_set_loading_state(&second.subresource, CssStyleSheetLoadingState.loaded)
        assert(css_css_style_sheet_loading_state(sheet) == CssStyleSheetLoadingState.error_)
        css_css_style_sheet_remove_critical_subresource(sheet, &first.subresource)
        assert(css_css_style_sheet_loading_state(sheet) == CssStyleSheetLoadingState.loaded)
        # The Subresource mixin finds its rule again.
        assert(css_style_sheet_subresource_parent_style_sheet_for_subresource(&second.subresource) == none)

test "GeneratedCSSStyleProperties: the mixin answers its CSSStyleProperties (CSSStyleProperties.h:68)":
    let (vm, realm, _) = test_html_setup()
    defer web_test_destroy_vm(vm)
    let allocator: memory.Allocator = vm_heap(vm)
    with allocator:
        let props = test_css_sheets_empty_properties(realm)
        let mixin = as_if_generated_css_style_properties(props) else trap("the mixin")
        assert(mixin == &props.generated_css_style_properties)
        assert(bind_generated_css_style_properties_generated_style_properties_to_css_style_properties(mixin) == props)
        assert(bind_generated_css_style_properties_generated_style_properties_to_css_style_properties_const(mixin) == props)
        let float_value = bind_generated_css_style_properties_float(mixin)
        assert(ak.string_is_empty(&float_value))
