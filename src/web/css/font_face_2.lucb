## Ported from Libraries/LibWeb/CSS/FontFace.cpp:550 Web::CSS::FontFace::set_unicode_range.
# https://drafts.csswg.org/css-font-loading/#dom-fontface-unicoderange
pub func css_font_face_set_unicode_range(this: CssFontFace*, string: ak.String) -> !:
    # On setting, parse the string according to the grammar for the corresponding @font-face descriptor.
    # If it does not match the grammar, throw a SyntaxError; otherwise, set the attribute to the serialization of the
    # parsed value.

    let property = css_font_face_parse_descriptor(css_data.DescriptorId.unicode_range, &string) else try css_font_face_throw_syntax_error(this, "FontFace.unicodeRange setter: Invalid descriptor value")

    if let rule = this.m_css_font_face_rule:
        try css_css_font_face_descriptors_set_unicode_range(css_font_face_rule_descriptors(rule), ak.string_bytes_as_string_view(&string))

    css_font_face_set_unicode_range_impl(this, property)

    if css_font_face_should_be_registered_with_font_computer(this):
        if let font_computer = css_font_face_font_computer(this):
            css_font_computer_did_load_font(font_computer, ak.fly_string_from_string(this.m_family))

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:573 Web::CSS::FontFace::set_unicode_range_impl.
pub func css_font_face_set_unicode_range_impl(this: CssFontFace*, value: CssStyleValue*):
    this.m_unicode_range = css_style_value_to_string(value, css_syntax.SerializationMode.normal)
    let ranges = css_style_value_list_values(css_style_value_as_value_list(value))
    ak.vector_clear_with_capacity(&this.m_unicode_ranges)
    ak.vector_ensure_capacity(&this.m_unicode_ranges, ak.vector_size(&ranges))
    for range in ak.vector_span_const(&ranges):
        ak.vector_unchecked_append_u(&this.m_unicode_ranges, css_unicode_range_style_value_unicode_range(css_style_value_as_unicode_range(range)))

