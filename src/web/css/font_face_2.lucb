#==============================================================================================
#
#   font_face_2 - CSS::FontFace: the descriptor attributes, load(), the face's sets, and the
#                 supported font formats and technologies
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/FontFace.cpp (lines 409-899): the setters of the FontFace
#       attributes (parse the descriptor, update the connected @font-face rule, re-register
#       with the font computer) and their `_impl`s, FontFace::load (the font loader of the
#       face's ParsedFontFace and the steps when it completes), add_to_set and
#       remove_from_set, and font_format_is_supported / font_tech_is_supported.
#
#       Copyright (c) 2024, Andrew Kaster <akaster@serenityos.org>
#       Copyright (c) 2025-2026, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Setting the descriptors =================================================================

## `parse_css_descriptor(Parser::ParsingParams(), AtRuleID::FontFace, DescriptorNameAndID::from_id(id), string)`.
func css_font_face_parse_descriptor(descriptor_id: css_data.DescriptorId, string: const ak.String*) -> CssStyleValue*?:
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_css_parsing_mode(&parsing_params)
    return parse_css_descriptor(parsing_params, css_data.AtRuleId.font_face, css_descriptor_name_and_id_from_id(descriptor_id), ak.string_bytes_as_string_view(string))

## `return WebIDL::SyntaxError::create(realm(), message)` from a setter.
func css_font_face_throw_syntax_error(this: CssFontFace*, message: str) -> never!:
    try idl_throw(.idl_dom_exception(idl_syntax_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str(message))))

## The setters' `if (should_be_registered_with_font_computer()) { if (auto font_computer = this->font_computer(); ...) font_computer->unregister_font_face(*this); }`.
func css_font_face_unregister_if_registered(this: CssFontFace*):
    if css_font_face_should_be_registered_with_font_computer(this):
        if let font_computer = css_font_face_font_computer(this):
            css_font_computer_unregister_font_face(font_computer, this)

## The setters' `if (should_be_registered_with_font_computer()) { if (auto font_computer = this->font_computer(); ...) font_computer->register_font_face(*this); }`.
func css_font_face_register_if_registered(this: CssFontFace*):
    if css_font_face_should_be_registered_with_font_computer(this):
        if let font_computer = css_font_face_font_computer(this):
            css_font_computer_register_font_face(font_computer, this)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:410 Web::CSS::FontFace::set_family.
# https://drafts.csswg.org/css-font-loading/#dom-fontface-family
pub func css_font_face_set_family(this: CssFontFace*, string: ak.String) -> !:
    # On setting, parse the string according to the grammar for the corresponding @font-face descriptor.
    # If it does not match the grammar, throw a SyntaxError; otherwise, set the attribute to the serialization of the
    # parsed value.

    let property = css_font_face_parse_descriptor(css_data.DescriptorId.font_family, &string) else try css_font_face_throw_syntax_error(this, "FontFace.family setter: Invalid descriptor value")

    if let rule = this.m_css_font_face_rule:
        try css_css_font_face_descriptors_set_font_family(css_font_face_rule_descriptors(rule), ak.string_bytes_as_string_view(&string))

    css_font_face_unregister_if_registered(this)

    css_font_face_set_family_impl(this, property)

    css_font_face_register_if_registered(this)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:438 Web::CSS::FontFace::set_family_impl.
pub func css_font_face_set_family_impl(this: CssFontFace*, value: CssStyleValue*):
    let family = css_string_from_style_value(value)
    this.m_family = ak.fly_string_to_string_const(&family)

