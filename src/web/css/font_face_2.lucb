# mark: Loading =================================================================================

## The captures of the task load() queues when the font load completes: the face and the typeface.
struct CssFontFaceLoadCompleted:
    var this: CssFontFace*
    var maybe_typeface: web_fonts.Typeface*?

## load()'s step 5: the steps of the task, run synchronously.
func css_font_face_load_completed(context: void*?):
    let captures = (CssFontFaceLoadCompleted*)(context else trap("no captures"))
    let this = captures.this
    let realm = bind_platform_object_realm(this.bind_platform_object())
    var execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&execution_context, realm, HtmlTemporaryExecutionContextCallbacksEnabled.yes)
    defer html_temporary_execution_context_destruct(&execution_context)
    # 1. If the attempt to load fails, reject font face’s [[FontStatusPromise]] with a DOMException whose name
    #    is "NetworkError" and set font face’s status attribute to "error".
    if captures.maybe_typeface == none:
        this.m_status = BindFontFaceLoadStatus.error_
        idl_reject_promise(realm, this.m_font_status_promise, css_font_face_exception_value(idl_network_error_create(realm, ak.utf16_string_from_str("Failed to load font"))))

        # For each FontFaceSet font face is in:
        for entry in ak.hash_table_begin(&this.m_containing_sets):
            let font_face_set = *entry
            # 1. Add font face to the FontFaceSet’s [[FailedFonts]] list.
            ak.vector_append_t(css_font_face_set_failed_fonts(font_face_set), this)

            # 2. Remove font face from the FontFaceSet’s [[LoadingFonts]] list. If font was the last item
            #    in that list (and so the list is now empty), switch the FontFaceSet to loaded.
            css_font_face_remove_from_loading_fonts(font_face_set, this)

    # 2. Otherwise, font face now represents the loaded font; fulfill font face’s [[FontStatusPromise]] with font face
    #    and set font face’s status attribute to "loaded".
    else:
        this.m_parsed_font = captures.maybe_typeface
        this.m_status = BindFontFaceLoadStatus.loaded
        idl_resolve_promise(realm, this.m_font_status_promise, bind_platform_object_wrapper(this.bind_platform_object()))

        if let font_computer = css_font_face_font_computer(this):
            css_font_computer_register_font_face(font_computer, this)

        # For each FontFaceSet font face is in:
        for entry in ak.hash_table_begin(&this.m_containing_sets):
            let font_face_set = *entry
            # 1. Add font face to the FontFaceSet’s [[LoadedFonts]] list.
            ak.vector_append_t(css_font_face_set_loaded_fonts(font_face_set), this)

            # 2. Remove font face from the FontFaceSet’s [[LoadingFonts]] list. If font was the last item
            #    in that list (and so the list is now empty), switch the FontFaceSet to loaded.
            css_font_face_remove_from_loading_fonts(font_face_set, this)

    this.m_font_loader = none

## load()'s on_load callback: when the load operation completes, successfully or not, queue a task.
func css_font_face_load_on_load(context: void*?, maybe_typeface: web_fonts.Typeface*?):
    let this = (CssFontFace*)(context else trap("no face"))
    let captures = new CssFontFaceLoadCompleted(this = this, maybe_typeface = maybe_typeface) else trap("out of memory")
    _ = html_queue_global_task(HtmlTaskSource.font_loading, html_relevant_global_object((JsObject*)this), gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = css_font_face_load_completed, context = captures)))

## load()'s deferred steps 4 and 5: load the face's sources with the document's font computer.
func css_font_face_load_deferred(context: void*?):
    let this = (CssFontFace*)(context else trap("no face"))
    # 4. Using the value of font face’s [[Urls]] slot, attempt to load a font as defined in [CSS-FONTS-3],
    #     as if it was the value of a @font-face rule’s src descriptor.

    # 5. When the load operation completes, successfully or not, queue a task to run the following steps synchronously:
    let on_load = gc.create_function1(gc.cell_heap(this.cell()), ak.Function1[web_fonts.Typeface*?, unit](call = css_font_face_load_on_load, context = this))

    # FIXME: We should probably put the 'font cache' on the WindowOrWorkerGlobalScope instead of tying it to the document's style computer
    let global = html_relevant_global_object((JsObject*)this)
    if let window = as_if_html_window((gc.Cell*)global):
        let font_computer = dom_document_font_computer(html_window_document(window))

        let parsed_font_face = css_font_face_parsed_font_face(this)
        if let loader = css_font_computer_load_font_face(font_computer, &parsed_font_face, on_load):
            this.m_font_loader = loader
            css_font_loader_start_loading_next_url(loader)
    else:
        # FIXME: Don't know how to load fonts in workers! They don't have a StyleComputer
        ak.dbgln("FIXME: Worker font loading not implemented")

## load()'s AD-HOC block: switch the containing FontFaceSets to "loading" and append the face to
## their [[LoadingFonts]], in a temporary execution context (the C++ block scope).
func css_font_face_load_switch_sets_to_loading(this: CssFontFace*):
    var execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&execution_context, bind_platform_object_realm(this.bind_platform_object()), HtmlTemporaryExecutionContextCallbacksEnabled.yes)
    defer html_temporary_execution_context_destruct(&execution_context)
    for entry in ak.hash_table_begin(&this.m_containing_sets):
        let font_face_set = *entry
        if ak.vector_is_empty(css_font_face_set_loading_fonts(font_face_set)):
            css_font_face_set_switch_to_loading(font_face_set)
        ak.vector_append_t(css_font_face_set_loading_fonts(font_face_set), this)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:728 Web::CSS::FontFace::load.
# https://drafts.csswg.org/css-font-loading/#dom-fontface-load
pub func css_font_face_load(this: CssFontFace*) -> JsPromiseCapability*:
    #  1. Let font face be the FontFace object on which this method was called.
    let font_face = this

    # 2. If font face’s [[Urls]] slot is null, or its status attribute is anything other than "unloaded",
    #    return font face’s [[FontStatusPromise]] and abort these steps.
    if ak.vector_is_empty(&font_face.m_urls) or font_face.m_status != BindFontFaceLoadStatus.unloaded:
        return css_font_face_loaded(font_face)

    # 3. Otherwise, set font face’s status attribute to "loading", return font face’s [[FontStatusPromise]],
    #    and continue executing the rest of this algorithm asynchronously.
    this.m_status = BindFontFaceLoadStatus.loading

    # AD-HOC: Switch the containing FontFaceSets to "loading" for URL-backed fonts too, mirroring the step the
    #         constructor performs for BufferSource-backed fonts.
    # Spec issue: https://github.com/w3c/csswg-drafts/issues/13235
    css_font_face_load_switch_sets_to_loading(this)

    platform_event_loop_plugin_deferred_invoke(platform_event_loop_plugin_the(), gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = css_font_face_load_deferred, context = this)))

    return css_font_face_loaded(font_face)

# mark: Sets ====================================================================================

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:826 Web::CSS::FontFace::add_to_set.
pub func css_font_face_add_to_set(this: CssFontFace*, set: CssFontFaceSet*):
    _ = ak.hash_table_set(&this.m_containing_sets, set)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:831 Web::CSS::FontFace::remove_from_set.
pub func css_font_face_remove_from_set(this: CssFontFace*, set: CssFontFaceSet*):
    _ = ak.hash_table_remove_t(&this.m_containing_sets, set)

# mark: Supported formats and technologies ======================================================

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:836 Web::CSS::font_format_is_supported.
pub func css_font_format_is_supported(name: ak.FlyString) -> bool:
    # https://drafts.csswg.org/css-fonts-4/#font-format-definitions
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("collection")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.true_type_collection)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("embedded-opentype")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.embedded_open_type)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("opentype")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.open_type)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("svg")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.svg)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("truetype")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.true_type)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("woff")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.woff)
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("woff2")):
        return web_fonts.font_format_is_supported(web_fonts.FontFormat.woff2)
    return false

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:856 Web::CSS::font_tech_is_supported.
pub func css_font_tech_is_supported_font_tech(font_tech: css_data.FontTech) -> bool:
    # https://drafts.csswg.org/css-fonts-4/#font-tech-definitions
    match font_tech:
        .features_opentype:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.features_opentype)
        .features_aat:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.features_aat)
        .features_graphite:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.features_graphite)
        .variations:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.variations)
        .color_colrv0:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.color_colrv0)
        .color_colrv1:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.color_colrv1)
        .color_svg:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.color_svg)
        .color_sbix:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.color_sbix)
        .color_cbdt:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.color_cbdt)
        .palettes:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.palettes)
        .incremental:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.incremental)
        # https://drafts.csswg.org/css-fonts-5/#font-tech-definitions
        .avar2:
            return web_fonts.font_tech_is_supported(web_fonts.FontTech.avar2)
        _:
            return false

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:889 Web::CSS::font_tech_is_supported.
pub func css_font_tech_is_supported_fly_string(name: ak.FlyString) -> bool:
    if let keyword = css_data.keyword_from_string(ak.fly_string_bytes_as_string_view(&name)):
        if let font_tech = css_data.keyword_to_font_tech(keyword):
            return css_font_tech_is_supported_font_tech(font_tech)
    return false
