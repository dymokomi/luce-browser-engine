#   DESCRIPTION:
#       Port of LibWeb/CSS/SelectorEngine.cpp (lines 1079-1476): the last cases of
#       matches_pseudo_class's switch (:valid, :invalid, :user-valid, :user-invalid, :required,
#       :optional, :default, :autofill, :state() and :heading, as
#       matches_pseudo_class_forms), matches_namespace and matches_simple_selector.
