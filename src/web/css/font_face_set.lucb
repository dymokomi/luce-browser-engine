# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:35 Web::CSS::FontFaceSet::create.
pub func css_font_face_set_create(realm: Realm*) -> CssFontFaceSet*:
    var temporary_execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&temporary_execution_context, realm)
    defer html_temporary_execution_context_destruct(&temporary_execution_context)
    return realm_create_css_font_face_set(realm, realm)

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:41 Web::CSS::FontFaceSet::FontFaceSet.
pub func css_font_face_set_construct(this: CssFontFaceSet*, realm: Realm*):
    dom_event_target_construct(this.dom_event_target(), realm)
    css_font_face_set_init_fields(this)
    this.m_set_entries = js_set_create(realm)
    this.m_ready_promise = idl_create_promise(realm)

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:48 Web::CSS::FontFaceSet::initialize (override).
pub func css_font_face_set_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.font_face_set)
    dom_event_target_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:54 Web::CSS::FontFaceSet::visit_edges (override).
pub func css_font_face_set_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssFontFaceSet*)base
    dom_event_target_visit_edges_impl(base, visitor)
    # visitor.visit(m_set_entries), visitor.visit(m_ready_promise): JS::Set and WebIDL::Promise are opaque until
    # phase 3 (cells in the donor).
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_set_entries)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_ready_promise)
    gc.cell_visitor_visit_vector(visitor, &this.m_loading_fonts)
    gc.cell_visitor_visit_vector(visitor, &this.m_loaded_fonts)
    gc.cell_visitor_visit_vector(visitor, &this.m_failed_fonts)

# mark: The set entries =========================================================================

## The JS value of a FontFace (the platform object as a JS::Value).
func css_font_face_value(face: CssFontFace*) -> JsValue:
    return bind_platform_object_wrapper(face.bind_platform_object())

## The FontFace of a set entry: `as<FontFace>(value.as_object())`.
func css_font_face_from_value(value: JsValue) -> CssFontFace*:
    return as_css_font_face((gc.Cell*)js_value_as_object(value))

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:65 Web::CSS::FontFaceSet::add.
# https://drafts.csswg.org/css-font-loading/#dom-fontfaceset-add
pub func css_font_face_set_add(this: CssFontFaceSet*, face: CssFontFace*?) -> CssFontFaceSet*!:
    let font_face = face else trap("VERIFY: GC::Root<FontFace>")
    # 1. If font is already in the FontFaceSet’s set entries, skip to the last step of this algorithm immediately.
    if js_set_set_has(this.m_set_entries, css_font_face_value(font_face)):
        return this

    # 2. If font is CSS-connected, throw an InvalidModificationError exception and exit this algorithm immediately.
    if css_font_face_is_css_connected(font_face):
        try idl_throw(.idl_dom_exception(idl_invalid_modification_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Cannot add a CSS-connected FontFace to a FontFaceSet"))))

    # NB: This method implements steps 3 and 4.
    css_font_face_set_add_css_connected_font(this, font_face)

    # 5. Return the FontFaceSet.
    return this

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:84 Web::CSS::FontFaceSet::add_css_connected_font.
# https://drafts.csswg.org/css-font-loading/#dom-fontfaceset-add
pub func css_font_face_set_add_css_connected_font(this: CssFontFaceSet*, face: CssFontFace*):
    # 3. Add the font argument to the FontFaceSet’s set entries.
    js_set_set_add(this.m_set_entries, css_font_face_value(face))
    css_font_face_add_to_set(face, this)

    if css_font_face_should_be_registered_with_font_computer(face):
        let global = html_relevant_global_object((JsObject*)this)
        if let window = as_if_html_window((gc.Cell*)global):
            css_font_computer_register_font_face(dom_document_font_computer(html_window_associated_document(window)), face)

    # 4. If font’s status attribute is "loading"
    if css_font_face_status(face) == BindFontFaceLoadStatus.loading:

        # 1. If the FontFaceSet’s [[LoadingFonts]] list is empty, switch the FontFaceSet to loading.
        if ak.vector_is_empty(&this.m_loading_fonts):
            css_font_face_set_switch_to_loading(this)

        # 2. Append font to the FontFaceSet’s [[LoadingFonts]] list.
        ak.vector_append_t(&this.m_loading_fonts, face)

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:109 Web::CSS::FontFaceSet::delete_.
# https://drafts.csswg.org/css-font-loading/#dom-fontfaceset-delete
pub func css_font_face_set_delete(this: CssFontFaceSet*, face: CssFontFace*?) -> bool:
    let font_face = face else trap("VERIFY: GC::Root<FontFace>")
    # 1. If font is CSS-connected, return false and exit this algorithm immediately.
    if css_font_face_is_css_connected(font_face):
        return false

    if css_font_face_should_be_registered_with_font_computer(font_face):
        let global = html_relevant_global_object((JsObject*)this)
        if let window = as_if_html_window((gc.Cell*)global):
            css_font_computer_unregister_font_face(dom_document_font_computer(html_window_associated_document(window)), font_face)

    # 2. Let deleted be the result of removing font from the FontFaceSet’s set entries.
    let deleted = js_set_set_remove(this.m_set_entries, css_font_face_value(font_face))
    css_font_face_remove_from_set(font_face, this)

    # 3. If font is present in the FontFaceSet’s [[LoadedFonts]], or [[FailedFonts]] lists, remove it.
    let is_face = ak.Function1[const (CssFontFace*)*, bool](call = css_font_computer_is_face, context = font_face)
    _ = ak.vector_remove_all_matching(&this.m_loaded_fonts, is_face)
    _ = ak.vector_remove_all_matching(&this.m_failed_fonts, is_face)

    # 4. If font is present in the FontFaceSet’s [[LoadingFonts]] list, remove it.
    #    If font was the last item in that list (and so the list is now empty), switch the FontFaceSet to loaded.
    let was_in_loading_fonts = ak.vector_remove_all_matching(&this.m_loading_fonts, is_face)
    if was_in_loading_fonts and ak.vector_is_empty(&this.m_loading_fonts):
        css_font_face_set_switch_to_loaded(this)

    return deleted

## The predicate of clear()'s `remove_all_matching([](auto const& font) { return !font->is_css_connected(); })`.
func css_font_face_is_not_css_connected(context: void*?, font: const (CssFontFace*)*) -> bool:
    return not css_font_face_is_css_connected(*font)

## Ported from Libraries/LibWeb/CSS/FontFaceSet.cpp:140 Web::CSS::FontFaceSet::clear.
# https://drafts.csswg.org/css-font-loading/#dom-fontfaceset-clear
pub func css_font_face_set_clear(this: CssFontFaceSet*):
    # 1. Remove all non-CSS-connected items from the FontFaceSet's set entries,
    #    its [[LoadedFonts]] list, and its [[FailedFonts]] list.
    let window = as_if_html_window((gc.Cell*)html_relevant_global_object((JsObject*)this))
    var to_remove: ak.Vector[JsValue]
    let entries = js_set_values(this.m_set_entries)
    for font_face_value in ak.vector_span_const(&entries):
        let font_face = css_font_face_from_value(font_face_value)
        if not css_font_face_is_css_connected(font_face):
            if window != none and css_font_face_should_be_registered_with_font_computer(font_face):
                css_font_computer_unregister_font_face(dom_document_font_computer(html_window_associated_document(window else trap("window"))), font_face)
            ak.vector_append_t(&to_remove, font_face_value)
            css_font_face_remove_from_set(font_face, this)
    for value in ak.vector_span_const(&to_remove):
        _ = js_set_set_remove(this.m_set_entries, value)

    let is_not_css_connected = ak.Function1[const (CssFontFace*)*, bool](call = css_font_face_is_not_css_connected, context = none)
    _ = ak.vector_remove_all_matching(&this.m_loaded_fonts, is_not_css_connected)
    _ = ak.vector_remove_all_matching(&this.m_failed_fonts, is_not_css_connected)

    # 2. If the FontFaceSet's [[LoadingFonts]] list is non-empty, remove all items from it,
    #    then switch the FontFaceSet to loaded.
    if not ak.vector_is_empty(&this.m_loading_fonts):
        ak.vector_clear(&this.m_loading_fonts)
        css_font_face_set_switch_to_loaded(this)

