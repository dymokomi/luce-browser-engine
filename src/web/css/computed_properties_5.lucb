## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:2221 Web::CSS::ComputedProperties::paint_order.
pub func css_computed_properties_paint_order(this: CssComputedProperties*) -> css_data.PaintOrder[3]:
    let value = css_computed_properties_property(this, css_data.PropertyId.paint_order)
    if css_style_value_is_keyword(value):
        let keyword = css_keyword_style_value_keyword(css_style_value_as_keyword(value))
        if keyword == css_data.Keyword.normal:
            return css_initial_values_paint_order()
        let paint_order_keyword = css_data.keyword_to_paint_order(keyword) else trap("VERIFY: paint_order_keyword.has_value()")
        match paint_order_keyword:
            .fill:
                return css_initial_values_paint_order()
            .stroke:
                return [css_data.PaintOrder.stroke, css_data.PaintOrder.fill, css_data.PaintOrder.markers]
            .markers:
                return [css_data.PaintOrder.markers, css_data.PaintOrder.fill, css_data.PaintOrder.stroke]
            _:
                trap("VERIFY_NOT_REACHED")

    assert(css_style_value_is_value_list(value))
    let value_list = css_style_value_as_value_list(value)
    # The list must contain 2 values at this point, since the third value is omitted during parsing due to the
    # shortest-serialization principle.
    assert(css_style_value_list_size(value_list) == 2)
    var paint_order_list: css_data.PaintOrder[3]

    # We use the sum of the keyword values to infer what the missing keyword is. Since each keyword can only appear in
    # the list once, the sum of their values will always be 3.
    var sum: i32 = 0
    for i in 0..<2:
        let keyword = css_keyword_style_value_keyword(css_style_value_as_keyword(css_style_value_list_value_at(value_list, (usize)i, false)))
        let paint_order_keyword = css_data.keyword_to_paint_order(keyword) else trap("VERIFY: paint_order_keyword.has_value()")
        sum += (i32)paint_order_keyword
        paint_order_list[i] = paint_order_keyword
    assert(sum <= 3)
    paint_order_list[2] = (css_data.PaintOrder)(3 - sum)
    return paint_order_list

## The `to_will_change_entry` lambda of ComputedProperties::will_change.
func css_computed_properties_to_will_change_entry(value: CssStyleValue*) -> CssWillChangeWillChangeEntry?:
    if css_style_value_is_keyword(value):
        match css_keyword_style_value_keyword(css_style_value_as_keyword(value)):
            .contents:
                return CssWillChangeWillChangeEntry.css_will_change_type(CssWillChangeType.contents)
