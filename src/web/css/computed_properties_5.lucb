## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:2130 Web::CSS::ComputedProperties::quotes.
pub func css_computed_properties_quotes(this: CssComputedProperties*) -> CssQuotesData:
    let value = css_computed_properties_property(this, css_data.PropertyId.quotes)
    if css_style_value_is_keyword(value):
        match css_style_value_to_keyword(value):
            .auto:
                return CssQuotesData(type_ = CssQuotesDataType.auto)
            .none_:
                return CssQuotesData(type_ = CssQuotesDataType.none_)
            _:
                _ = value
    if css_style_value_is_value_list(value):
        let value_list = css_style_value_as_value_list(value)
        var quotes_data = CssQuotesData(type_ = CssQuotesDataType.specified)
        assert(css_style_value_list_size(value_list) % 2 == 0)
        var i: u32 = 0
        while (usize)i < css_style_value_list_size(value_list):
            ak.vector_append_t(&quotes_data.strings, [
                css_string_style_value_string_value(css_style_value_as_string(css_style_value_list_value_at(value_list, (usize)i, false))),
                css_string_style_value_string_value(css_style_value_as_string(css_style_value_list_value_at(value_list, (usize)(i + 1), false)))])
            i += 2
        return quotes_data

    return css_initial_values_quotes()

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:2158 Web::CSS::ComputedProperties::counter_data.
pub func css_computed_properties_counter_data(this: CssComputedProperties*, property_id: css_data.PropertyId) -> ak.Vector[CssCounterData]:
    let value = css_computed_properties_property(this, property_id)

    if css_style_value_is_counter_definitions(value):
        let counter_definitions = css_counter_definitions_style_value_counter_definitions(css_style_value_as_counter_definitions(value))
        var result: ak.Vector[CssCounterData]
        for counter in ak.vector_span_const(&counter_definitions):
            var data = CssCounterData(
                name = counter.name,
                is_reversed = counter.is_reversed,
                value = none)

            if let counter_value = counter.value:
                data.value = ak.clamp_to_i32_i32(css_int_from_style_value(counter_value))

            ak.vector_append_t(&result, data)
        return result

    if css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return ak.Vector[CssCounterData]()

    let name = css_data.string_from_property_id(property_id)
    let text = css_style_value_to_string(value, css_syntax.SerializationMode.normal)
    ak.dbgln(f"Unhandled type for {ak.string_view_text(ak.fly_string_bytes_as_string_view(&name))} value: '{ak.string_view_text(ak.string_bytes_as_string_view(&text))}'")
    return ak.Vector[CssCounterData]()

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:2187 Web::CSS::ComputedProperties::scrollbar_color.
pub func css_computed_properties_scrollbar_color(this: CssComputedProperties*, layout_node: LayoutNodeWithStyle*) -> CssScrollbarColorData:
    let value = css_computed_properties_property(this, css_data.PropertyId.scrollbar_color)
    if css_style_value_is_keyword(value) and css_keyword_style_value_keyword(css_style_value_as_keyword(value)) == css_data.Keyword.auto:
        return css_initial_values_scrollbar_color()

    if css_style_value_is_scrollbar_color(value):
        let scrollbar_color_value = css_style_value_as_scrollbar_color(value)
        let thumb_color = css_style_value_to_color(css_scrollbar_color_style_value_thumb_color(scrollbar_color_value), css_color_resolution_context_for_layout_node_with_style(layout_node)) else trap("VERIFY: Optional::value() of to_color()")
        let track_color = css_style_value_to_color(css_scrollbar_color_style_value_track_color(scrollbar_color_value), css_color_resolution_context_for_layout_node_with_style(layout_node)) else trap("VERIFY: Optional::value() of to_color()")
        return CssScrollbarColorData(thumb_color = thumb_color, track_color = track_color)

    var scrollbar_color: CssScrollbarColorData = ---
    css_scrollbar_color_data_init_fields(&scrollbar_color)
    return scrollbar_color

