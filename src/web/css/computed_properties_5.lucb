        this.m_cached_computed_font_list = css_font_computer_compute_font_for_style_values(font_computer, css_computed_properties_property(this, css_data.PropertyId.font_family), css_computed_properties_font_size(this), css_computed_properties_font_slope(this), css_computed_properties_font_weight(this), css_computed_properties_font_width(this), css_computed_properties_font_optical_sizing(this), css_computed_properties_font_variation_settings(this), css_computed_properties_font_feature_data(this))
