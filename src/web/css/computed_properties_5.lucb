# mark: Blending and view transitions ===========================================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1901 Web::CSS::ComputedProperties::mix_blend_mode.
pub func css_computed_properties_mix_blend_mode(this: CssComputedProperties*) -> css_data.MixBlendMode:
    let value = css_computed_properties_property(this, css_data.PropertyId.mix_blend_mode)
    return css_data.keyword_to_mix_blend_mode(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()")

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1907 Web::CSS::ComputedProperties::view_transition_name.
pub func css_computed_properties_view_transition_name(this: CssComputedProperties*) -> ak.FlyString?:
    let value = css_computed_properties_property(this, css_data.PropertyId.view_transition_name)
    if css_style_value_is_custom_ident(value):
        return css_custom_ident_style_value_custom_ident(css_style_value_as_custom_ident(value))
    return none

# mark: Animations and transitions ==============================================================

## The `duration` lambda of ComputedProperties::animations.
# https://drafts.csswg.org/css-animations-2/#animation-duration
func css_computed_properties_animation_duration(animation_duration_style_value: CssStyleValue*) -> F64OrString:
    # auto
    if css_style_value_to_keyword(animation_duration_style_value) == css_data.Keyword.auto:
        # For time-driven animations, equivalent to 0s.
        return F64OrString.f64_(0.0)

        # FIXME: For scroll-driven animations, equivalent to the duration necessary to fill the timeline in
        #        consideration of animation-range, animation-delay, and animation-iteration-count. See
        #        Scroll-driven Animations § 4.1 Finite Timeline Calculations.

    # <time [0s,∞]>

    # FIXME: For scroll-driven animations, treated as auto.

    # For time-driven animations, specifies the length of time that an animation takes to complete one cycle.
    # A negative <time> is invalid.
    let time = css_time_from_style_value(animation_duration_style_value, none)
    return F64OrString.f64_(css_time_to_milliseconds(&time))

## The `iteration_count` lambda of ComputedProperties::animations.
func css_computed_properties_animation_iteration_count(animation_iteration_count_style_value: CssStyleValue*) -> f64:
    if css_style_value_to_keyword(animation_iteration_count_style_value) == css_data.Keyword.infinite:
        return ak.infinity_f64

    return css_number_from_style_value(animation_iteration_count_style_value, none)

## The `timeline` lambda of ComputedProperties::animations.
# https://drafts.csswg.org/css-animations-2/#animation-timeline
func css_computed_properties_animation_timeline(abstract_element: DomAbstractElement, animation_timeline_style_value: CssStyleValue*) -> AnimationsAnimationTimeline*?:
    let document_timeline = dom_document_timeline(dom_abstract_element_document(&abstract_element)).animations_animation_timeline()

    # auto
    # The animation’s timeline is a DocumentTimeline, more specifically the default document timeline.
    if css_style_value_to_keyword(animation_timeline_style_value) == css_data.Keyword.auto:
        return document_timeline

    # none
    # The animation is not associated with a timeline.
    if css_style_value_to_keyword(animation_timeline_style_value) == css_data.Keyword.none_:
        return none

    # <dashed-ident>
    # FIXME: If a named scroll progress timeline or view progress timeline is in scope on this element, use the
    #        referenced timeline as defined in Scroll-driven Animations §  Declaring a Named Timeline’s Scope:
    #        the timeline-scope property. Otherwise the animation is not associated with a timeline.

    # <scroll()>
    # Use the scroll progress timeline indicated by the given scroll() function. See Scroll-driven Animations
    # § 2.2.1 The scroll() notation.
    if css_style_value_is_function(animation_timeline_style_value):
        let function = css_style_value_as_function(animation_timeline_style_value)
        let function_name = css_function_style_value_name(function)
        if ak.fly_string_eq_string_view(&function_name, ak.sv("scroll")):
            let arguments = css_tuple_style_value_tuple(css_style_value_as_tuple(css_function_style_value_value(function)))

            var scroller = css_data.Scroller.nearest
            if let scroller_value = *ak.vector_at_const(&arguments, css_tuple_style_value_indices_scroll_function_scroller):
                scroller = css_data.keyword_to_scroller(css_style_value_to_keyword(scroller_value)) else trap("VERIFY: Optional::value()")

            var axis = BindScrollAxis.block
            if let axis_value = *ak.vector_at_const(&arguments, css_tuple_style_value_indices_scroll_function_axis):
                axis = animations_css_axis_to_bindings_scroll_axis(css_data.keyword_to_axis(css_style_value_to_keyword(axis_value)) else trap("VERIFY: Optional::value()"))

            let source = AnimationsScrollTimelineAnonymousSource(scroller = scroller, target = abstract_element)

            var element_reference = abstract_element
            let element = dom_abstract_element_element(&element_reference)
            return animations_scroll_timeline_create(bind_platform_object_realm(element.bind_platform_object()), dom_abstract_element_document(&abstract_element), AnimationsScrollTimelineSource.anonymous_source(source), axis).animations_animation_timeline()

    # <view()>
    # FIXME: Use the view progress timeline indicated by the given view() function. See Scroll-driven
    #        Animations § 3.3.1 The view() notation.

    # FIXME: We fall back to document timeline for now as though we don't support the `animation-timeline`
    #        property at all
    return document_timeline

## The entry `property_id` of a coordinated value list, by value (C++ `.get(id).value()`).
func css_computed_properties_coordinated_list(list: const ak.HashMap[css_data.PropertyId, ak.Vector[CssStyleValue*], css_data.PropertyIdTraits]*, property_id: css_data.PropertyId) -> ak.Vector[CssStyleValue*]:
    return *(ak.hash_map_get_k_const(list, property_id) else trap("VERIFY: Optional::value() of a coordinated value list entry"))

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1915 Web::CSS::ComputedProperties::animations.
pub func css_computed_properties_animations(this: CssComputedProperties*, abstract_element: DomAbstractElement) -> ak.Vector[CssComputedPropertiesAnimationProperties]:
    let animation_name_values = css_style_value_list_values(css_style_value_as_value_list(css_computed_properties_property(this, css_data.PropertyId.animation_name)))

    # OPTIMIZATION: If all animation names are 'none', there are no animations to process
    var all_none = true
    for value in ak.vector_span_const(&animation_name_values):
        if css_style_value_to_keyword(value) != css_data.Keyword.none_:
            all_none = false
            break
    if all_none:
        return ak.Vector[CssComputedPropertiesAnimationProperties]()

    # CSS Animations are defined by binding keyframes to an element using the animation-* properties. These list-valued
    # properties, which are all longhands of the animation shorthand, form a coordinating list property group with
    # animation-name as the coordinating list base property and each item in the coordinated value list defining the
    # properties of a single animation effect.
    var property_ids: ak.Vector[css_data.PropertyId]
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_duration)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_timing_function)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_iteration_count)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_direction)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_play_state)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_delay)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_fill_mode)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_composition)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_name)
    ak.vector_append_t(&property_ids, css_data.PropertyId.animation_timeline)
    let coordinated_properties = css_computed_properties_assemble_coordinated_value_list(this, css_data.PropertyId.animation_name, property_ids)

    let names = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_name)
    let durations = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_duration)
    let timing_functions = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_timing_function)
    let iteration_counts = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_iteration_count)
    let directions = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_direction)
    let play_states = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_play_state)
    let delays = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_delay)
    let fill_modes = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_fill_mode)
    let compositions = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_composition)
    let timelines = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.animation_timeline)

    var animations: ak.Vector[CssComputedPropertiesAnimationProperties]

    for i in 0..<ak.vector_size(&names):
        # https://drafts.csswg.org/css-animations-1/#propdef-animation-name
        # none: No keyframes are specified at all, so there will be no animation. Any other animations properties
        #       specified for this animation have no effect.
        if css_style_value_to_keyword(*ak.vector_at_const(&names, i)) == css_data.Keyword.none_:
            continue

        let animation_name_style_value = *ak.vector_at_const(&names, i)
        let animation_duration_style_value = *ak.vector_at_const(&durations, i)
        let animation_timing_function_style_value = *ak.vector_at_const(&timing_functions, i)
        let animation_iteration_count_style_value = *ak.vector_at_const(&iteration_counts, i)
        let animation_direction_style_value = *ak.vector_at_const(&directions, i)
        let animation_play_state_style_value = *ak.vector_at_const(&play_states, i)
        let animation_delay_style_value = *ak.vector_at_const(&delays, i)
        let animation_fill_mode_style_value = *ak.vector_at_const(&fill_modes, i)
        let animation_composition_style_value = *ak.vector_at_const(&compositions, i)
        let animation_timeline_style_value = *ak.vector_at_const(&timelines, i)

        let duration = css_computed_properties_animation_duration(animation_duration_style_value)

        let timing_function = css_easing_function_from_style_value(animation_timing_function_style_value)

        let iteration_count = css_computed_properties_animation_iteration_count(animation_iteration_count_style_value)

        let direction = css_data.keyword_to_animation_direction(css_style_value_to_keyword(animation_direction_style_value)) else trap("VERIFY: Optional::value()")
        let play_state = css_data.keyword_to_animation_play_state(css_style_value_to_keyword(animation_play_state_style_value)) else trap("VERIFY: Optional::value()")
        let delay_time = css_time_from_style_value(animation_delay_style_value, none)
        let delay = css_time_to_milliseconds(&delay_time)
        let fill_mode = css_data.keyword_to_animation_fill_mode(css_style_value_to_keyword(animation_fill_mode_style_value)) else trap("VERIFY: Optional::value()")
        let composition = css_data.keyword_to_animation_composition(css_style_value_to_keyword(animation_composition_style_value)) else trap("VERIFY: Optional::value()")
        let name = css_string_from_style_value(animation_name_style_value)

        let timeline = css_computed_properties_animation_timeline(abstract_element, animation_timeline_style_value)

        ak.vector_append_t(&animations, CssComputedPropertiesAnimationProperties(
            duration = duration,
            timing_function = timing_function,
            iteration_count = iteration_count,
            direction = direction,
            play_state = play_state,
            delay = delay,
            fill_mode = fill_mode,
            composition = composition,
            name = name,
            timeline = timeline))

    return animations

## The `append_property_mapping_logical_aliases` lambda of ComputedProperties::transitions.
func css_computed_properties_append_property_mapping_logical_aliases(this: CssComputedProperties*, properties: ak.Vector[css_data.PropertyId]*, property_id: css_data.PropertyId):
    if css_data.property_is_logical_alias(property_id):
        ak.vector_append_t(properties, css_data.map_logical_alias_to_physical_property(property_id, css_data.LogicalAliasMappingContext(writing_mode = css_computed_properties_writing_mode(this), direction = css_computed_properties_direction(this))))
    elif property_id != css_data.PropertyId.custom:
        ak.vector_append_t(properties, property_id)

## The `properties` lambda of ComputedProperties::transitions: the longhands one transition-property entry names.
func css_computed_properties_transition_properties(this: CssComputedProperties*, property_value: CssStyleValue*) -> ak.Vector[css_data.PropertyId]:
    if css_style_value_is_keyword(property_value) and css_style_value_to_keyword(property_value) == css_data.Keyword.none_:
        return ak.Vector[css_data.PropertyId]()

    let custom_ident = css_custom_ident_style_value_custom_ident(css_style_value_as_custom_ident(property_value))
    let transition_property = css_data.property_id_from_string(ak.fly_string_bytes_as_string_view(&custom_ident)) else return ak.Vector[css_data.PropertyId]()

    var properties: ak.Vector[css_data.PropertyId]

    if css_data.property_is_shorthand(transition_property):
        let expanded_longhands = css_data.expanded_longhands_for_shorthand(transition_property)

        ak.vector_ensure_capacity(&properties, ak.vector_size(&expanded_longhands))

        let longhands = css_data.expanded_longhands_for_shorthand(transition_property)
        for prop in ak.vector_span_const(&longhands):
            css_computed_properties_append_property_mapping_logical_aliases(this, &properties, prop)
    else:
        css_computed_properties_append_property_mapping_logical_aliases(this, &properties, transition_property)

    return properties

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:2062 Web::CSS::ComputedProperties::transitions.
pub func css_computed_properties_transitions(this: CssComputedProperties*) -> ak.Vector[CssTransitionProperties]:
    var property_ids: ak.Vector[css_data.PropertyId]
    ak.vector_append_t(&property_ids, css_data.PropertyId.transition_property)
    ak.vector_append_t(&property_ids, css_data.PropertyId.transition_duration)
    ak.vector_append_t(&property_ids, css_data.PropertyId.transition_timing_function)
    ak.vector_append_t(&property_ids, css_data.PropertyId.transition_delay)
    ak.vector_append_t(&property_ids, css_data.PropertyId.transition_behavior)
    let coordinated_properties = css_computed_properties_assemble_coordinated_value_list(this, css_data.PropertyId.transition_property, property_ids)

    let property_values = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.transition_property)
    let duration_values = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.transition_duration)
    let timing_function_values = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.transition_timing_function)
    let delay_values = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.transition_delay)
    let behavior_values = css_computed_properties_coordinated_list(&coordinated_properties, css_data.PropertyId.transition_behavior)

    var transitions: ak.Vector[CssTransitionProperties]
    ak.vector_ensure_capacity(&transitions, ak.vector_size(&property_values))

    for i in 0..<ak.vector_size(&property_values):
        let properties = css_computed_properties_transition_properties(this, *ak.vector_at_const(&property_values, i))

        let duration = css_time_from_style_value(*ak.vector_at_const(&duration_values, i), none)
        let delay = css_time_from_style_value(*ak.vector_at_const(&delay_values, i), none)
        ak.vector_append_t(&transitions, CssTransitionProperties(
            properties = properties,
            duration = css_time_to_milliseconds(&duration),
            timing_function = css_easing_function_from_style_value(*ak.vector_at_const(&timing_function_values, i)),
            delay = css_time_to_milliseconds(&delay),
            transition_behavior = css_data.keyword_to_transition_behavior(css_style_value_to_keyword(*ak.vector_at_const(&behavior_values, i))) else trap("VERIFY: Optional::value()")))

    return transitions

