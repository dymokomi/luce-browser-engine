## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1025 Web::CSS::ComputedProperties::white_space_trim.
pub func css_computed_properties_white_space_trim(this: CssComputedProperties*) -> CssWhiteSpaceTrimData:
    let value = css_computed_properties_property(this, css_data.PropertyId.white_space_trim)

    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return CssWhiteSpaceTrimData()

    if css_style_value_is_value_list(value):
        var white_space_trim_data = CssWhiteSpaceTrimData()

        let values = css_style_value_list_values(css_style_value_as_value_list(value))
        for item in ak.vector_span_const(&values):
            match css_keyword_style_value_keyword(css_style_value_as_keyword(item)):
                .discard_before:
                    white_space_trim_data.discard_before = true
                .discard_after:
                    white_space_trim_data.discard_after = true
                .discard_inner:
                    white_space_trim_data.discard_inner = true
                _:
                    trap("VERIFY_NOT_REACHED")

        return white_space_trim_data

    trap("VERIFY_NOT_REACHED")

