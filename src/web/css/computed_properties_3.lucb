## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:956 Web::CSS::ComputedProperties::text_underline_offset.
pub func css_computed_properties_text_underline_offset(this: CssComputedProperties*) -> gfx.CssPixels:
    let computed_text_underline_offset = css_computed_properties_property(this, css_data.PropertyId.text_underline_offset)

    # auto
    if css_style_value_to_keyword(computed_text_underline_offset) == css_data.Keyword.auto:
        return css_initial_values_text_underline_offset()

    # <length>
    # <percentage>
    let length = css_length_from_style_value(computed_text_underline_offset, css_length_make_px_css_pixels(css_computed_properties_font_size(this)))
    return css_length_absolute_length_to_px(&length)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:969 Web::CSS::ComputedProperties::text_underline_position.
pub func css_computed_properties_text_underline_position(this: CssComputedProperties*) -> CssTextUnderlinePosition:
    let computed_text_underline_position = css_style_value_as_text_underline_position(css_computed_properties_property(this, css_data.PropertyId.text_underline_position))

    return CssTextUnderlinePosition(
        horizontal = css_text_underline_position_style_value_horizontal(computed_text_underline_position),
        vertical = css_text_underline_position_style_value_vertical(computed_text_underline_position))

