# mark: content =================================================================================

## The `get_quote_string` lambda of ComputedProperties::content: the open or close quote at `depth`.
func css_computed_properties_get_quote_string(quotes_data: const CssQuotesData*, open: bool, depth: u32) -> ak.FlyString:
    match quotes_data.type_:
        .none_:
            return ak.FlyString()
        .auto:
            # FIXME: "A typographically appropriate used value for quotes is automatically chosen by the UA
            #        based on the content language of the element and/or its parent."
            if open:
                return ak.fly_string_from_str("“") if depth == 0 else ak.fly_string_from_str("‘")
            return ak.fly_string_from_str("”") if depth == 0 else ak.fly_string_from_str("’")
        .specified:
            # If the depth is greater than the number of pairs, the last pair is repeated.
            let level = ak.vector_at_const(&quotes_data.strings, ak.min((usize)depth, ak.vector_size(&quotes_data.strings) - 1))
            return (*level)[0] if open else (*level)[1]
        _:
            trap("VERIFY_NOT_REACHED")

## C++ `dbgln("`{}` is not supported in `<property>` (yet?)", item->to_string(SerializationMode::Normal))`.
func css_computed_properties_dbgln_unsupported(item: CssStyleValue*, property: str):
    let text = css_style_value_to_string(item, css_syntax.SerializationMode.normal)
    ak.dbgln(f"`{ak.string_view_text(ak.string_bytes_as_string_view(&text))}` is not supported in `{property}` (yet?)")

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1108 Web::CSS::ComputedProperties::content.
pub func css_computed_properties_content(this: CssComputedProperties*, element_reference: DomAbstractElement*, initial_quote_nesting_level: u32) -> CssComputedPropertiesContentDataAndQuoteNestingLevel:
    let value = css_computed_properties_property(this, css_data.PropertyId.content)
    let quotes_data = css_computed_properties_quotes(this)

    var quote_nesting_level = initial_quote_nesting_level

    if css_style_value_is_content(value):
        let content_style_value = css_style_value_as_content(value)

        var content_data = CssContentData()

        let items = css_style_value_list_values(css_content_style_value_content(content_style_value))
        for item in ak.vector_span_const(&items):
            if css_style_value_is_string(item):
                let string_value = css_string_style_value_string_value(css_style_value_as_string(item))
                ak.vector_append_t(&content_data.data, StringOrCssImageStyleValue.string(ak.fly_string_to_string_const(&string_value)))
            elif css_style_value_is_keyword(item):
                match css_style_value_to_keyword(item):
                    .open_quote:
                        let quote = css_computed_properties_get_quote_string(&quotes_data, true, quote_nesting_level)
                        quote_nesting_level += 1
                        ak.vector_append_t(&content_data.data, StringOrCssImageStyleValue.string(ak.fly_string_to_string_const(&quote)))
                    .close_quote:
                        # A 'close-quote' or 'no-close-quote' that would make the depth negative is in error and is ignored
                        # (at rendering time): the depth stays at 0 and no quote mark is rendered (although the rest of the
                        # 'content' property's value is still inserted).
                        # - https://www.w3.org/TR/CSS21/generate.html#quotes-insert
                        # (This is missing from the CONTENT-3 spec.)
                        if quote_nesting_level > 0:
                            quote_nesting_level -= 1
                            let quote = css_computed_properties_get_quote_string(&quotes_data, false, quote_nesting_level)
                            ak.vector_append_t(&content_data.data, StringOrCssImageStyleValue.string(ak.fly_string_to_string_const(&quote)))
                    .no_open_quote:
                        quote_nesting_level += 1
                    .no_close_quote:
                        # NOTE: See CloseQuote
                        if quote_nesting_level > 0:
                            quote_nesting_level -= 1
                    _:
                        css_computed_properties_dbgln_unsupported(item, "content")
            elif css_style_value_is_counter(item):
                let counter = css_style_value_as_counter(item)
                let counter_style = css_style_value_as_counter_style(css_counter_style_value_counter_style(counter))
                ak.vector_append_t(&content_data.counter_style_dependencies, css_counter_style_style_value_resolve_counter_style(counter_style, dom_abstract_element_style_scope(element_reference)))
                ak.vector_append_t(&content_data.data, StringOrCssImageStyleValue.string(css_counter_style_value_resolve(counter, element_reference)))
            elif css_style_value_is_image(item):
                ak.vector_append_t(&content_data.data, StringOrCssImageStyleValue.css_image_style_value(css_style_value_as_image(item)))
            else:
                # TODO: Implement images, and other things.
                css_computed_properties_dbgln_unsupported(item, "content")
        content_data.type_ = CssContentDataType.list

        if let alt_text = css_content_style_value_alt_text(content_style_value):
            var alt_text_builder = ak.string_builder_new()
            let alt_items = css_style_value_list_values(alt_text)
            for item in ak.vector_span_const(&alt_items):
                if css_style_value_is_string(item):
                    let string_value = css_string_style_value_string_value(css_style_value_as_string(item))
                    ak.string_builder_append_string_view(&alt_text_builder, ak.fly_string_bytes_as_string_view(&string_value))
                elif css_style_value_is_counter(item):
                    let counter = css_style_value_as_counter(item)
                    let counter_style = css_style_value_as_counter_style(css_counter_style_value_counter_style(counter))
                    ak.vector_append_t(&content_data.counter_style_dependencies, css_counter_style_style_value_resolve_counter_style(counter_style, dom_abstract_element_style_scope(element_reference)))
                    let resolved = css_counter_style_value_resolve(counter, element_reference)
                    ak.string_builder_append_string_view(&alt_text_builder, ak.string_bytes_as_string_view(&resolved))
                else:
                    css_computed_properties_dbgln_unsupported(item, "content` alt-text")
            content_data.alt_text = ak.string_builder_to_string(&alt_text_builder) else trap("MUST: StringBuilder::to_string()")

        return CssComputedPropertiesContentDataAndQuoteNestingLevel(content_data = content_data, final_quote_nesting_level = quote_nesting_level)

    match css_style_value_to_keyword(value):
        .none_:
            return CssComputedPropertiesContentDataAndQuoteNestingLevel(content_data = CssContentData(type_ = CssContentDataType.none_), final_quote_nesting_level = quote_nesting_level)
        .normal:
            return CssComputedPropertiesContentDataAndQuoteNestingLevel(content_data = CssContentData(type_ = CssContentDataType.normal), final_quote_nesting_level = quote_nesting_level)
        _:
            _ = value

    return CssComputedPropertiesContentDataAndQuoteNestingLevel(content_data = CssContentData(), final_quote_nesting_level = quote_nesting_level)

