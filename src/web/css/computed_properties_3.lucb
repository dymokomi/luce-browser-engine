## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1010 Web::CSS::ComputedProperties::word_spacing.
pub func css_computed_properties_word_spacing(this: CssComputedProperties*) -> gfx.CssPixels:
    let value = css_computed_properties_property(this, css_data.PropertyId.word_spacing)
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.normal:
        return gfx.css_pixels_from_int(0)

    let length = css_length_from_style_value(value, css_length_make_px_css_pixels(css_computed_properties_font_size(this)))
    return css_length_absolute_length_to_px(&length)

