## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1254 Web::CSS::ComputedProperties::text_decoration_line.
pub func css_computed_properties_text_decoration_line(this: CssComputedProperties*) -> ak.Vector[css_data.TextDecorationLine]:
    let value = css_computed_properties_property(this, css_data.PropertyId.text_decoration_line)

    if css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return ak.Vector[css_data.TextDecorationLine]()

    if css_style_value_is_value_list(value):
        var lines: ak.Vector[css_data.TextDecorationLine]
        let values = css_style_value_list_values(css_style_value_as_value_list(value))
        for item in ak.vector_span_const(&values):
            ak.vector_append_t(&lines, css_data.keyword_to_text_decoration_line(css_style_value_to_keyword(item)) else trap("VERIFY: Optional::value()"))
        return lines

    trap("VERIFY_NOT_REACHED")

