# mark: Equality and text =======================================================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:897 Web::CSS::ComputedProperties::operator==.
pub func css_computed_properties_eq(this: CssComputedProperties*, other: CssComputedProperties*) -> bool:
    for i in 0..<css_data.number_of_longhand_properties:
        let my_style = this.m_property_values[i]
        let other_style = other.m_property_values[i]
        if let my_value = my_style:
            let other_value = other_style else return false
            if css_style_value_type(my_value) != css_style_value_type(other_value):
                return false
            if not css_style_value_equals(my_value, other_value):
                return false
        elif other_style != none:
            return false

    return true

