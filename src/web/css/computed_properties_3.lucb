## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:985 Web::CSS::ComputedProperties::tab_size.
pub func css_computed_properties_tab_size(this: CssComputedProperties*) -> CssLengthOrF64:
    let value = css_computed_properties_property(this, css_data.PropertyId.tab_size)
    if css_style_value_is_calculated(value):
        let math_value = css_style_value_as_calculated(value)
        if css_calculated_style_value_resolves_to_length(math_value):
            return CssLengthOrF64.css_length(css_calculated_style_value_resolve_length(math_value, CssCalculationResolutionContext()) else trap("VERIFY: Optional::value() of resolve_length()"))
        if css_calculated_style_value_resolves_to_number(math_value):
            return CssLengthOrF64.f64_(css_calculated_style_value_resolve_number(math_value, CssCalculationResolutionContext()) else trap("VERIFY: Optional::value() of resolve_number()"))

    if css_style_value_is_length(value):
        return CssLengthOrF64.css_length(css_length_style_value_length(css_style_value_as_length(value)))

    return CssLengthOrF64.f64_(css_number_style_value_number(css_style_value_as_number(value)))

