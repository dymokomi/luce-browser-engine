# mark: Cursor, visibility, display, decorations, lists =========================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1215 Web::CSS::ComputedProperties::cursor.
pub func css_computed_properties_cursor(this: CssComputedProperties*) -> ak.Vector[CssCursorData]:
    # Return the first available cursor.
    let value = css_computed_properties_property(this, css_data.PropertyId.cursor)
    var cursors: ak.Vector[CssCursorData]
    if css_style_value_is_value_list(value):
        let items = css_style_value_list_values(css_style_value_as_value_list(value))
        for item in ak.vector_span_const(&items):
            if css_style_value_is_cursor(item):
                ak.vector_append_t(&cursors, CssCursorData.css_cursor_style_value(css_style_value_as_cursor(item)))
                continue

            if let keyword = css_data.keyword_to_cursor_predefined(css_style_value_to_keyword(item)):
                ak.vector_append_t(&cursors, CssCursorData.cursor_predefined(keyword))
    elif css_style_value_is_keyword(value):
        if let keyword = css_data.keyword_to_cursor_predefined(css_style_value_to_keyword(value)):
            ak.vector_append_t(&cursors, CssCursorData.cursor_predefined(keyword))

    if ak.vector_is_empty(&cursors):
        ak.vector_append_t(&cursors, CssCursorData.cursor_predefined(css_data.CursorPredefined.auto))

    return cursors

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1241 Web::CSS::ComputedProperties::visibility.
pub func css_computed_properties_visibility(this: CssComputedProperties*) -> css_data.Visibility:
    let value = css_computed_properties_property(this, css_data.PropertyId.visibility)
    if not css_style_value_is_keyword(value):
        return css_data.Visibility.collapse  # `return {};`: the enum's zero value
    return css_data.keyword_to_visibility(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()")

