## The `make_shadow_data` lambda of ComputedProperties::shadow.
func css_computed_properties_make_shadow_data(layout_node: LayoutNode*, value: CssShadowStyleValue*) -> CssShadowData?:
    let offset_x = css_length_from_style_value(css_shadow_style_value_offset_x(value), none)
    let offset_y = css_length_from_style_value(css_shadow_style_value_offset_y(value), none)
    let blur_radius = css_length_from_style_value(css_shadow_style_value_blur_radius(value), none)
    let spread_distance = css_length_from_style_value(css_shadow_style_value_spread_distance(value), none)
    return CssShadowData(
        offset_x = offset_x,
        offset_y = offset_y,
        blur_radius = blur_radius,
        spread_distance = spread_distance,
        color = css_style_value_to_color(css_shadow_style_value_color(value), css_color_resolution_context_for_layout_node_with_style(as_layout_node_with_style(layout_node))) else trap("VERIFY: Optional::value() of to_color()"),
        placement = css_shadow_style_value_placement(value))

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1343 Web::CSS::ComputedProperties::shadow.
pub func css_computed_properties_shadow(this: CssComputedProperties*, property_id: css_data.PropertyId, layout_node: LayoutNode*) -> ak.Vector[CssShadowData]:
    let value = css_computed_properties_property(this, property_id)

    if css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return ak.Vector[CssShadowData]()

    let value_list = css_style_value_as_value_list(value)

    var shadow_data: ak.Vector[CssShadowData]
    ak.vector_ensure_capacity(&shadow_data, css_style_value_list_size(value_list))
    let layers = css_style_value_list_values(value_list)
    for layer_value in ak.vector_span_const(&layers):
        let maybe_shadow_data = css_computed_properties_make_shadow_data(layout_node, css_style_value_as_shadow(layer_value)) else return ak.Vector[CssShadowData]()
        ak.vector_append_t(&shadow_data, maybe_shadow_data)

    return shadow_data

