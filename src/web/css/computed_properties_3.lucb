## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1285 Web::CSS::ComputedProperties::text_decoration_thickness.
pub func css_computed_properties_text_decoration_thickness(this: CssComputedProperties*) -> CssTextDecorationThickness:
    let value = css_computed_properties_property(this, css_data.PropertyId.text_decoration_thickness)
    if css_style_value_is_keyword(value):
        match css_style_value_to_keyword(value):
            .auto:
                return CssTextDecorationThickness(value = CssTextDecorationThicknessAutoOrCssTextDecorationThicknessFromFontOrCssLengthPercentage.css_text_decoration_thickness_auto(CssTextDecorationThicknessAuto()))
            .from_font:
                return CssTextDecorationThickness(value = CssTextDecorationThicknessAutoOrCssTextDecorationThicknessFromFontOrCssLengthPercentage.css_text_decoration_thickness_from_font(CssTextDecorationThicknessFromFont()))
            _:
                trap("VERIFY_NOT_REACHED")

