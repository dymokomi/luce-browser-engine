## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:1084 Web::CSS::ComputedProperties::caret_color.
pub func css_computed_properties_caret_color(this: CssComputedProperties*, node: LayoutNodeWithStyle*) -> gfx.Color:
    let value = css_computed_properties_property(this, css_data.PropertyId.caret_color)
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.auto:
        let computed_values = layout_node_with_style_computed_values(node)
        return css_computed_values_color(&computed_values.computed_values)

    if css_style_value_has_color(value):
        return css_style_value_to_color(value, css_color_resolution_context_for_layout_node_with_style(node)) else trap("VERIFY: Optional::value() of to_color()")

    return css_initial_values_caret_color()

