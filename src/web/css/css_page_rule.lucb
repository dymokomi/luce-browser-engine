## Ported from Libraries/LibWeb/CSS/CSSPageRule.h:29 Web::CSS::CSSPageRule::style.
pub func css_page_rule_style(this: CssPageRule*) -> CssPageDescriptors*:
    return this.m_style

## Ported from Libraries/LibWeb/CSS/CSSPageRule.h:29 Web::CSS::CSSPageRule::descriptors.
pub func css_page_rule_descriptors(this: CssPageRule*) -> CssPageDescriptors*:
    return this.m_style

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:19 Web::CSS::CSSPageRule::create.
pub func css_page_rule_create(realm: Realm*, selectors: ak.Vector[CssPageSelector], style: CssPageDescriptors*, rules: CssRuleList*) -> CssPageRule*:
    return realm_create_css_page_rule(realm, realm, selectors, style, rules)

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:21 Web::CSS::CSSPageRule::CSSPageRule.
pub func css_page_rule_construct(this: CssPageRule*, realm: Realm*, selectors: ak.Vector[CssPageSelector], style: CssPageDescriptors*, rules: CssRuleList*):
    css_grouping_rule_construct(this.css_grouping_rule(), realm, rules, CssRuleType.page)
    this.m_selectors = selectors
    this.m_style = style
    css_style_declaration_set_parent_rule(this.m_style.css_style_declaration(), this.css_rule())

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:32 Web::CSS::CSSPageRule::initialize (override).
pub func css_page_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_page_rule)
    css_grouping_rule_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:39 Web::CSS::CSSPageRule::selector_text.
# https://drafts.csswg.org/cssom/#dom-csspagerule-selectortext
pub func css_page_rule_selector_text(this: CssPageRule*) -> ak.String:
    # The selectorText attribute, on getting, must return the result of serializing the associated selector list.

    # https://www.w3.org/TR/cssom/#serialize-a-group-of-selectors
    # To serialize a group of selectors serialize each selector in the group of selectors and then serialize a comma-separated list of these serializations.
    var builder = ak.string_builder_new()
    for i in 0..<ak.vector_size(&this.m_selectors):
        if i != 0:
            ak.string_builder_append(&builder, ", ")
        let selector = css_page_selector_serialize(ak.vector_at(&this.m_selectors, i))
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&selector))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::join")

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:49 Web::CSS::CSSPageRule::set_selector_text.
# https://drafts.csswg.org/cssom/#dom-csspagerule-selectortext
pub func css_page_rule_set_selector_text(this: CssPageRule*, text: ak.StringView):
    # On setting the selectorText attribute these steps must be run:
    # 1. Run the parse a list of CSS page selectors algorithm on the given value.
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_css_parsing_mode(&parsing_params)
    let page_selector_list = parse_page_selector_list(parsing_params, text)

    # 2. If the algorithm returns a non-null value replace the associated selector list with the returned value.
    if let selectors = page_selector_list:
        this.m_selectors = selectors

    # 3. Otherwise, if the algorithm returns a null value, do nothing.

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:63 Web::CSS::CSSPageRule::serialized (override).
# https://drafts.csswg.org/cssom/#ref-for-csspagerule
pub func css_page_rule_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssPageRule*)base
    let descriptors = this.m_style.css_style_declaration()
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())

    var builder = ak.string_builder_new()

    # AD-HOC: There's no spec for this yet, but Chrome puts declarations before margin rules.
    ak.string_builder_append(&builder, "@page ")
    let selector = css_page_rule_selector_text(this)
    if not ak.string_is_empty(&selector):
        dump_appendff(&builder, "{} ", [css_arg_string(&selector)])
    ak.string_builder_append(&builder, "{ ")
    if css_style_declaration_length(descriptors) > 0:
        let text = css_style_declaration_serialized(descriptors)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&text))
        ak.string_builder_append_u8(&builder, ' ')
    for i in 0..<css_rule_list_length(rules):
        let rule = css_rule_list_item(rules, i) else trap("null rule")
        let result = css_rule_css_text(rule)

        if ak.string_is_empty(&result):
            continue

        dump_appendff(&builder, "{} ", [css_arg_string(&result)])
    ak.string_builder_append(&builder, "}")

    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:92 Web::CSS::CSSPageRule::visit_edges (override).
pub func css_page_rule_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssPageRule*)base
    css_grouping_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_style)

## Ported from Libraries/LibWeb/CSS/CSSPageRule.cpp:98 Web::CSS::CSSPageRule::dump (override).
pub func css_page_rule_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssPageRule*)base
    let rules = css_grouping_rule_css_rules(this.css_grouping_rule())
    css_rule_dump_impl(base, builder, indent_levels)

    dump_indent(builder, indent_levels + 1)
    let selector = css_page_rule_selector_text(this)
    dump_appendff(builder, "Selector: {}\n", [css_arg_string(&selector)])
    dump_descriptors(builder, css_page_rule_descriptors(this).css_descriptors(), indent_levels + 1)

    dump_indent(builder, indent_levels + 1)
    dump_appendff(builder, "Rules ({}):\n", [ak.arg_u64((u64)css_rule_list_length(rules))])
    for rule in ak.vector_span(&rules.m_rules):
        dump_rule_string_builder(builder, rule, indent_levels + 2)
