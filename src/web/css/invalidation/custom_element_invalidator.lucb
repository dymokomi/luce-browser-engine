## Ported from Libraries/LibWeb/CSS/Invalidation/CustomElementInvalidator.cpp:15 Web::CSS::Invalidation::invalidate_style_after_custom_element_state_change.
pub func css_invalidation_invalidate_style_after_custom_element_state_change(element: DomElement*):
    var properties: ak.Vector[CssInvalidationSetProperty]
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.defined))
    dom_node_invalidate_style_vector(element.dom_node(), DomStyleInvalidationReason.custom_element_state_change, properties, DomStyleInvalidationOptions())

## Ported from Libraries/LibWeb/CSS/Invalidation/CustomElementInvalidator.cpp:25 Web::CSS::Invalidation::invalidate_style_after_custom_state_set_change.
pub func css_invalidation_invalidate_style_after_custom_state_set_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.custom_state_set_change)
