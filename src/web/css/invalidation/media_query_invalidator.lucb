## The captures of evaluate_media_rules_and_invalidate_style's for_each_active_css_style_sheet lambdas.
struct CssInvalidationEvaluateMediaRulesSheets:
    var document: DomDocument*
    var media_queries_changed_match_state: bool

## evaluate_media_rules_and_invalidate_style's for_each_active_css_style_sheet lambdas.
func css_invalidation_evaluate_media_rules_of_sheet(context: void*?, style_sheet: CssCssStyleSheet*):
    let captures = (CssInvalidationEvaluateMediaRulesSheets*)(context else trap("no captures"))
    if css_css_style_sheet_evaluate_media_queries(style_sheet, captures.document):
        captures.media_queries_changed_match_state = true

## Ported from Libraries/LibWeb/CSS/Invalidation/MediaQueryInvalidator.cpp:17 Web::CSS::Invalidation::evaluate_media_rules_and_invalidate_style.
pub func css_invalidation_evaluate_media_rules_and_invalidate_style(document: DomDocument*):
    var document_sheets = CssInvalidationEvaluateMediaRulesSheets(document = document, media_queries_changed_match_state = false)
    css_style_scope_for_each_active_css_style_sheet(dom_document_style_scope(document), ak.Function1[CssCssStyleSheet*, unit](call = css_invalidation_evaluate_media_rules_of_sheet, context = &document_sheets))

    # document.for_each_shadow_root([&](auto& shadow_root) { ... })
    for shadow_root in ak.intrusive_list_begin(&document.m_shadow_roots):
        var shadow_root_sheets = CssInvalidationEvaluateMediaRulesSheets(document = document, media_queries_changed_match_state = false)
        css_style_scope_for_each_active_css_style_sheet(dom_shadow_root_style_scope(shadow_root), ak.Function1[CssCssStyleSheet*, unit](call = css_invalidation_evaluate_media_rules_of_sheet, context = &shadow_root_sheets))

        if not shadow_root_sheets.media_queries_changed_match_state:
            continue

        css_style_scope_invalidate_rule_cache(dom_shadow_root_style_scope(shadow_root))
        dom_node_invalidate_style(shadow_root.dom_node(), DomStyleInvalidationReason.media_query_changed_match_state)
        css_invalidate_assigned_elements_for_dirty_slots(shadow_root)

        if let host = dom_document_fragment_host(shadow_root.dom_document_fragment()):
            dom_node_invalidate_style(tree_node_root(host.dom_node()), DomStyleInvalidationReason.media_query_changed_match_state)

    if document_sheets.media_queries_changed_match_state:
        css_style_scope_invalidate_rule_cache(dom_document_style_scope(document))
        dom_node_invalidate_style(document.dom_node(), DomStyleInvalidationReason.media_query_changed_match_state)
