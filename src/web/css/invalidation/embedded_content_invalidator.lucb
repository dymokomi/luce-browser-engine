## Ported from Libraries/LibWeb/CSS/Invalidation/EmbeddedContentInvalidator.cpp:13 Web::CSS::Invalidation::invalidate_style_after_embedded_content_geometry_change.
pub func css_invalidation_invalidate_style_after_embedded_content_geometry_change(element: DomElement*):
    # FIXME: This should only invalidate the layout, not the style.
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.htmli_frame_element_geometry_change)

## Ported from Libraries/LibWeb/CSS/Invalidation/EmbeddedContentInvalidator.cpp:19 Web::CSS::Invalidation::invalidate_style_after_object_representation_change.
pub func css_invalidation_invalidate_style_after_object_representation_change(element: DomElement*):
    dom_node_invalidate_style(element.dom_node(), DomStyleInvalidationReason.html_object_element_update_layout_and_child_objects)
