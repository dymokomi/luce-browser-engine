## Ported from Libraries/LibWeb/CSS/Invalidation/FormControlInvalidator.cpp:14 Web::CSS::Invalidation::invalidate_style_after_checked_state_change.
pub func css_invalidation_invalidate_style_after_checked_state_change(element: DomElement*, reason: DomStyleInvalidationReason):
    var properties: ak.Vector[CssInvalidationSetProperty]
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.checked))
    ak.vector_append_t(&properties, css_invalidation_pseudo_class_property(css_data.PseudoClass.unchecked))
    dom_node_invalidate_style_vector(element.dom_node(), reason, properties, DomStyleInvalidationOptions())
