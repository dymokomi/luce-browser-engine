#
#   ratio - Ratio: a <ratio> value
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Ratio.cpp (lines 1-39) and the inline members of Ratio.h. C++'s
#       operator== and operator<=> are css_ratio_eq and css_ratio_cmp.
