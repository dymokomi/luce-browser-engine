pub func css_style_scope_have_has_selectors_with_relative_selector_that_has_sibling_combinator(this: const CssStyleScope*) -> bool:
    css_style_scope_build_rule_cache_if_needed(this)
    let rule_cache = this.m_rule_cache else trap("VERIFY: the rule cache was built")
