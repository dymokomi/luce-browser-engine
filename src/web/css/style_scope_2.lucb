## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:827 Web::CSS::StyleScope::document.
pub func css_style_scope_document(this: const CssStyleScope*) -> DomDocument*:
    return dom_node_document(this.m_node)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:832 Web::CSS::StyleScope::get_pseudo_class_rule_cache.
pub func css_style_scope_get_pseudo_class_rule_cache(this: const CssStyleScope*, pseudo_class: css_data.PseudoClass) -> const CssRuleCache*:
    css_style_scope_build_rule_cache_if_needed(this)
    let rule_cache = this.m_rule_cache else trap("VERIFY: the rule cache was built")
    return rule_cache.pseudo_class_rule_cache[(usize)pseudo_class] else trap("VERIFY: a rule cache for the pseudo-class")

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:838 Web::CSS::StyleScope::for_each_active_css_style_sheet.
pub func css_style_scope_for_each_active_css_style_sheet(this: const CssStyleScope*, callback: ak.Function1[CssCssStyleSheet*, unit]):
    if let shadow_root = as_if_dom_shadow_root(this.m_node):
        dom_shadow_root_for_each_active_css_style_sheet(shadow_root, callback)
    else:
        dom_document_for_each_active_css_style_sheet(dom_node_document(this.m_node), callback)

# mark: Pending :has() invalidations ============================================================

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:847 Web::CSS::StyleScope::schedule_ancestors_style_invalidation_due_to_presence_of_has.
pub func css_style_scope_schedule_ancestors_style_invalidation_due_to_presence_of_has(this: CssStyleScope*, node: DomNode*):
    let previous_size = ak.ordered_hash_map_size(&this.m_pending_has_invalidations)
    let mutation_features = ak.ordered_hash_map_ensure(&this.m_pending_has_invalidations, node)
    if ak.ordered_hash_map_size(&this.m_pending_has_invalidations) == previous_size:
        return
    mutation_features.is_conservative = true
    dom_document_set_needs_invalidation_of_elements_affected_by_has(css_style_scope_document(this))

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:857 Web::CSS::merge_pending_has_invalidation_mutation_features.
func css_merge_pending_has_invalidation_mutation_features(target: CssPendingHasInvalidationMutationFeatures*, source: const CssPendingHasInvalidationMutationFeatures*):
    target.is_conservative = target.is_conservative or source.is_conservative
    target.may_affect_sibling_relationships = target.may_affect_sibling_relationships or source.may_affect_sibling_relationships
    target.may_affect_pseudo_classes = target.may_affect_pseudo_classes or source.may_affect_pseudo_classes
    for tag_name in ak.hash_table_begin_const(&source.tag_names):
        discard(ak.hash_table_set(&target.tag_names, *tag_name))
    for id in ak.hash_table_begin_const(&source.ids):
        discard(ak.hash_table_set(&target.ids, *id))
    for class_name in ak.hash_table_begin_const(&source.class_names):
        discard(ak.hash_table_set(&target.class_names, *class_name))
    for attribute_name in ak.hash_table_begin_const(&source.attribute_names):
        discard(ak.hash_table_set(&target.attribute_names, *attribute_name))
    for pseudo_class in ak.hash_table_begin_const(&source.pseudo_classes):
        discard(ak.hash_table_set(&target.pseudo_classes, *pseudo_class))

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:874 Web::CSS::collect_pending_has_invalidation_features_from_element.
func css_collect_pending_has_invalidation_features_from_element(features: CssPendingHasInvalidationMutationFeatures*, element: DomElement*):
    discard(ak.hash_table_set(&features.tag_names, dom_element_local_name(element)))
    let is_html = css_optional_fly_strings_equal(dom_element_namespace_uri(element), namespace_html)
    if not is_html:
        discard(ak.hash_table_set(&features.tag_names, dom_element_lowercased_local_name(element)))

    if let id = dom_element_id(element):
        discard(ak.hash_table_set(&features.ids, id))

    let class_names = dom_element_class_names(element)
    for class_name in ak.vector_span_const(&class_names):
        discard(ak.hash_table_set(&features.class_names, class_name))

    # element.for_each_attribute([&](FlyString const& name, String const&) { ... })
    if let attributes = element.m_attributes:
        for i in 0..<dom_named_node_map_length(attributes):
            let attribute = dom_named_node_map_item(attributes, (u32)i) else trap("NamedNodeMap::item in range")
            let name = dom_attr_name(attribute)
            discard(ak.hash_table_set(&features.attribute_names, name))
            if not is_html:
                discard(ak.hash_table_set(&features.attribute_names, ak.fly_string_to_ascii_lowercase(&name)))

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:893 Web::CSS::StyleScope::record_conservative_pending_has_invalidation.
pub func css_style_scope_record_conservative_pending_has_invalidation(this: CssStyleScope*, scheduled_node: DomNode*, may_affect_sibling_relationships: bool):
    let previous_size = ak.ordered_hash_map_size(&this.m_pending_has_invalidations)
    let mutation_features = ak.ordered_hash_map_ensure(&this.m_pending_has_invalidations, scheduled_node)
    mutation_features.is_conservative = true
    mutation_features.may_affect_sibling_relationships = mutation_features.may_affect_sibling_relationships or may_affect_sibling_relationships
    mutation_features.may_affect_pseudo_classes = true

    if ak.ordered_hash_map_size(&this.m_pending_has_invalidations) != previous_size:
        dom_document_set_needs_invalidation_of_elements_affected_by_has(css_style_scope_document(this))

## collect_pending_has_invalidation_mutation_features' `collect_node` lambda.
func css_collect_pending_has_invalidation_mutation_features_node(features: CssPendingHasInvalidationMutationFeatures*, node: DomNode*):
    if dom_node_is_character_data(node):
        return
    if let element = as_if_dom_element(node):
        css_collect_pending_has_invalidation_features_from_element(features, element)

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:905 Web::CSS::collect_pending_has_invalidation_mutation_features.
func css_collect_pending_has_invalidation_mutation_features_dom_node(mutation_root: DomNode*, includes_descendants: bool) -> CssPendingHasInvalidationMutationFeatures:
    var features: CssPendingHasInvalidationMutationFeatures
    features.may_affect_sibling_relationships = includes_descendants
    features.may_affect_pseudo_classes = true

    if not includes_descendants:
        css_collect_pending_has_invalidation_mutation_features_node(&features, mutation_root)
        return features

    for node in dom_node_inclusive_subtree(mutation_root):
        css_collect_pending_has_invalidation_mutation_features_node(&features, node)
    return features

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:929 Web::CSS::collect_pending_has_invalidation_mutation_features.
func css_collect_pending_has_invalidation_mutation_features_vector(properties: const ak.Vector[CssInvalidationSetProperty]*) -> CssPendingHasInvalidationMutationFeatures:
    var features: CssPendingHasInvalidationMutationFeatures
    for property in ak.vector_span_const(properties):
        match property.type_:
            .class_:
                discard(ak.hash_table_set(&features.class_names, css_invalidation_set_property_name(&property)))
            .id:
                discard(ak.hash_table_set(&features.ids, css_invalidation_set_property_name(&property)))
            .tag_name:
                discard(ak.hash_table_set(&features.tag_names, css_invalidation_set_property_name(&property)))
            .attribute:
                discard(ak.hash_table_set(&features.attribute_names, css_invalidation_set_property_name(&property)))
            .invalidate_self, .invalidate_whole_subtree:
                features.is_conservative = true
            .pseudo_class:
                match property.value:
                    .pseudo_class(pseudo_class):
                        discard(ak.hash_table_set(&features.pseudo_classes, pseudo_class))
                    _:
                        trap("VERIFY: Variant::get<PseudoClass>")
            _:
                trap("VERIFY_NOT_REACHED")
    return features

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:958 Web::CSS::StyleScope::record_pending_has_invalidation_mutation_features.
pub func css_style_scope_record_pending_has_invalidation_mutation_features_dom_node(this: CssStyleScope*, scheduled_node: DomNode*, mutation_root: DomNode*, includes_descendants: bool):
    let features = css_collect_pending_has_invalidation_mutation_features_dom_node(mutation_root, includes_descendants)
    let previous_size = ak.ordered_hash_map_size(&this.m_pending_has_invalidations)
    let existing_features = ak.ordered_hash_map_ensure(&this.m_pending_has_invalidations, scheduled_node)
    if ak.ordered_hash_map_size(&this.m_pending_has_invalidations) == previous_size:
        css_merge_pending_has_invalidation_mutation_features(existing_features, &features)
        return
    *existing_features = features
    dom_document_set_needs_invalidation_of_elements_affected_by_has(css_style_scope_document(this))

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:971 Web::CSS::StyleScope::record_pending_has_invalidation_mutation_features.
pub func css_style_scope_record_pending_has_invalidation_mutation_features_vector(this: CssStyleScope*, scheduled_node: DomNode*, properties: const ak.Vector[CssInvalidationSetProperty]*):
    let features = css_collect_pending_has_invalidation_mutation_features_vector(properties)
    let previous_size = ak.ordered_hash_map_size(&this.m_pending_has_invalidations)
    let existing_features = ak.ordered_hash_map_ensure(&this.m_pending_has_invalidations, scheduled_node)
    if ak.ordered_hash_map_size(&this.m_pending_has_invalidations) == previous_size:
        css_merge_pending_has_invalidation_mutation_features(existing_features, &features)
        return
    *existing_features = features
    dom_document_set_needs_invalidation_of_elements_affected_by_has(css_style_scope_document(this))

# mark: Tree-scoped references ==================================================================

## get_registered_counter_style's lambda: `scope.m_registered_counter_styles.get(name)`.
func css_style_scope_get_registered_counter_style_in(context: void*?, scope: const CssStyleScope*) -> CssCounterStyle*?:
    let name = (ak.FlyString*)(context else trap("no captures"))
    let counter_style = ak.hash_map_get_k_const(&scope.m_registered_counter_styles, *name) else return none
    return *counter_style

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:984 Web::CSS::StyleScope::get_registered_counter_style.
pub func css_style_scope_get_registered_counter_style(this: const CssStyleScope*, name: ak.FlyString) -> CssCounterStyle*?:
    if this.m_needs_counter_style_cache_update and not this.m_is_doing_counter_style_cache_update:
        css_style_scope_build_counter_style_cache((CssStyleScope*)this)

    var captured_name = name
    return css_style_scope_dereference_global_tree_scoped_reference[CssCounterStyle*](this, ak.Function1[const CssStyleScope*, CssCounterStyle*?](call = css_style_scope_get_registered_counter_style_in, context = &captured_name))

## Ported from Libraries/LibWeb/CSS/StyleScope.cpp:994 Web::CSS::StyleScope::dereference_global_tree_scoped_reference.
pub func css_style_scope_dereference_global_tree_scoped_reference[T](this: const CssStyleScope*, callback: ak.Function1[const CssStyleScope*, T?]) -> T?:
    # https://drafts.csswg.org/css-shadow-1/#tree-scoped-name-global
    # If a tree-scoped name is global (such as @font-face names), then when a tree-scoped reference is dereferenced to
    # find it, first search only the tree-scoped names associated with the same root as the tree-scoped reference. If
    # no relevant tree-scoped name is found, and the root is a shadow root, then repeat this search in the root’s
    # host’s node tree (recursively). (In other words, global tree-scoped names “inherit” into descendant shadow trees,
    # so long as they don’t define the same name themselves.)
    if let result = ak.function1_call(&callback, this):
        return result

    if let shadow_root = as_if_dom_shadow_root(this.m_node):
        if let host = dom_document_fragment_host(shadow_root.dom_document_fragment()):
            let root = tree_node_root(host.dom_node())

            if dom_node_is_shadow_root(root):
                let root_shadow_root = as_dom_shadow_root(root)
                if dom_shadow_root_uses_document_style_sheets(root_shadow_root):
                    return css_style_scope_dereference_global_tree_scoped_reference(dom_document_style_scope(dom_node_document(root)), callback)

                return css_style_scope_dereference_global_tree_scoped_reference(dom_shadow_root_style_scope(root_shadow_root), callback)

            return css_style_scope_dereference_global_tree_scoped_reference(dom_document_style_scope(as_dom_document(root)), callback)

    return none
