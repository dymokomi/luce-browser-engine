## Ported from Libraries/LibWeb/CSS/NumericRange.h:17 Web::CSS::NumericRange::contains.
pub func css_numeric_range_contains(this: const CssNumericRange*, value: f64) -> bool:
    return value >= this.min and value <= this.max
