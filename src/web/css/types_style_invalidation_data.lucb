    pub var combinator: CssSelectorCombinator
    pub var is_rightmost: bool

## `for group in css_for_each_consecutive_simple_selector_group(selector)`: the template's callback walk as a loop
## (added by region r42, DESIGN §2.9).
pub struct CssConsecutiveSimpleSelectorGroups: luce.Iterable[CssSimpleSelectorGroup, CssConsecutiveSimpleSelectorGroupIterator]:
    pub var selector: const CssSelector*

    func iterator() -> CssConsecutiveSimpleSelectorGroupIterator:
        let compound_selectors = css_selector_compound_selectors(self.selector)
        return CssConsecutiveSimpleSelectorGroupIterator(compound_selectors = compound_selectors, compound_selector_index = (isize)ak.vector_size(&compound_selectors) - 1, combinator = CssSelectorCombinator.none_, is_rightmost = true, finished = false)

## The iterator of CssConsecutiveSimpleSelectorGroups: the state of the C++ loop between two callbacks.
pub struct CssConsecutiveSimpleSelectorGroupIterator: luce.Iterator[CssSimpleSelectorGroup]:
