# mark: Value structs (ComputedValues.h:39-148) ================================================

## `Position {}`: a Position with its default member initializers (left 50%, top 50%).
pub func css_position_new() -> CssPosition:
    var position: CssPosition = ---
    css_position_init_fields(&position)
    return position

## The C++ `Vector<WillChangeEntry>::contains_slow(entry)` of WillChange's has_*: Variant equality.
func css_will_change_contains_slow(this: const CssWillChange*, entry: CssWillChangeWillChangeEntry) -> bool:
    for value in ak.vector_span_const(&this.m_value):
        match value:
            .css_will_change_type(type_):
                match entry:
                    .css_will_change_type(other):
                        if type_ == other:
                            return true
                    _:
                        continue
            .property_id(property_id):
                match entry:
                    .property_id(other):
                        if property_id == other:
                            return true
                    _:
                        continue
    return false

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:71 Web::CSS::Position::resolved.
pub func css_position_resolved(this: const CssPosition*, node: LayoutNode*, rect: gfx.CssPixelRect) -> gfx.CssPixelPoint:
    let x_offset = this.offset_x
    let y_offset = this.offset_y
    var x = css_percentage_or_to_px(&x_offset.percentage_or, node, gfx.css_pixel_rect_width(&rect))
    var y = css_percentage_or_to_px(&y_offset.percentage_or, node, gfx.css_pixel_rect_height(&rect))
    if this.edge_x == css_data.PositionEdge.right:
        let width = gfx.css_pixel_rect_width(&rect)
        x = gfx.css_pixels_sub(&width, x)
    if this.edge_y == css_data.PositionEdge.bottom:
        let height = gfx.css_pixel_rect_height(&rect)
        y = gfx.css_pixels_sub(&height, y)
    let rect_x = gfx.css_pixel_rect_x(&rect)
    let rect_y = gfx.css_pixel_rect_y(&rect)
    return gfx.CssPixelPoint(m_x = gfx.css_pixels_add_css_pixels(&rect_x, x), m_y = gfx.css_pixels_add_css_pixels(&rect_y, y))

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:91 Web::CSS::Containment::is_empty.
pub func css_containment_is_empty(this: const CssContainment*) -> bool:
    return not (this.size_containment or this.inline_size_containment or this.layout_containment or this.style_containment or this.paint_containment)

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:99 Web::CSS::ContainerType::is_empty.
pub func css_container_type_is_empty(this: const CssContainerType*) -> bool:
    return not (this.is_size_container or this.is_inline_size_container or this.is_scroll_state_container)

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:125 Web::CSS::WillChange::WillChange.
pub func css_will_change_construct_vector(this: CssWillChange*, values: ak.Vector[CssWillChangeWillChangeEntry]):
    this.m_value = values

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:130 Web::CSS::WillChange::make_auto.
pub func css_will_change_make_auto() -> CssWillChange:
    var will_change: CssWillChange = ---
    css_will_change_construct(&will_change)
    return will_change

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:132 Web::CSS::WillChange::is_auto.
pub func css_will_change_is_auto(this: const CssWillChange*) -> bool:
    return ak.vector_is_empty(&this.m_value)

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:133 Web::CSS::WillChange::has_contents.
pub func css_will_change_has_contents(this: const CssWillChange*) -> bool:
    return css_will_change_contains_slow(this, CssWillChangeWillChangeEntry.css_will_change_type(CssWillChangeType.contents))

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:134 Web::CSS::WillChange::has_scroll_position.
pub func css_will_change_has_scroll_position(this: const CssWillChange*) -> bool:
    return css_will_change_contains_slow(this, CssWillChangeWillChangeEntry.css_will_change_type(CssWillChangeType.scroll_position))

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:135 Web::CSS::WillChange::has_property.
pub func css_will_change_has_property(this: const CssWillChange*, property_id: css_data.PropertyId) -> bool:
    return css_will_change_contains_slow(this, CssWillChangeWillChangeEntry.property_id(property_id))

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:138 Web::CSS::WillChange::WillChange.
pub func css_will_change_construct(this: CssWillChange*):
    this.m_value = ak.Vector[CssWillChangeWillChangeEntry]()

