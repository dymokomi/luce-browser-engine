#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/CSS/TransitionEvent.cpp:15 Web::CSS::TransitionEvent::create.
pub func css_transition_event_create(realm: Realm*, type_: ak.FlyString, event_init: const CssTransitionEventInit*) -> CssTransitionEvent*:
    let event = realm_create_css_transition_event(realm, realm, type_, event_init)
    dom_event_set_is_trusted(event.dom_event(), true)
    return event

## Ported from Libraries/LibWeb/CSS/TransitionEvent.cpp:22 Web::CSS::TransitionEvent::construct_impl.
pub func css_transition_event_construct_impl(realm: Realm*, type_: ak.FlyString, event_init: const CssTransitionEventInit*) -> CssTransitionEvent*:
    return realm_create_css_transition_event(realm, realm, type_, event_init)

## Ported from Libraries/LibWeb/CSS/TransitionEvent.cpp:27 Web::CSS::TransitionEvent::TransitionEvent (private).
func css_transition_event_construct(this: CssTransitionEvent*, realm: Realm*, type_: ak.FlyString, event_init: const CssTransitionEventInit*):
    dom_event_construct_dom_event_init(this.dom_event(), realm, type_, event_init.event_init)
    this.m_property_name = event_init.property_name
    this.m_elapsed_time = event_init.elapsed_time
    this.m_pseudo_element = event_init.pseudo_element

## Ported from Libraries/LibWeb/CSS/TransitionEvent.cpp:37 Web::CSS::TransitionEvent::initialize (override).
func css_transition_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.transition_event)
    dom_event_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/TransitionEvent.h:28 Web::CSS::TransitionEvent::property_name.
pub func css_transition_event_property_name(this: CssTransitionEvent*) -> ak.String:
    return this.m_property_name

## Ported from Libraries/LibWeb/CSS/TransitionEvent.h:29 Web::CSS::TransitionEvent::elapsed_time.
pub func css_transition_event_elapsed_time(this: CssTransitionEvent*) -> f64:
    return this.m_elapsed_time

## Ported from Libraries/LibWeb/CSS/TransitionEvent.h:30 Web::CSS::TransitionEvent::pseudo_element.
pub func css_transition_event_pseudo_element(this: CssTransitionEvent*) -> ak.String:
    return this.m_pseudo_element
