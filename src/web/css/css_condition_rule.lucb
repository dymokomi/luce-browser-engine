## Ported from Libraries/LibWeb/CSS/CSSConditionRule.h:21 Web::CSS::CSSConditionRule::condition_text (pure virtual).
pub func css_condition_rule_condition_text_impl(this: CssConditionRule*) -> ak.String:
    discard(this)
    trap("pure virtual: Web::CSS::CSSConditionRule::condition_text")

## Ported from Libraries/LibWeb/CSS/CSSConditionRule.h:22 Web::CSS::CSSConditionRule::condition_matches (pure virtual).
pub func css_condition_rule_condition_matches_impl(this: CssConditionRule*) -> bool:
    discard(this)
    trap("pure virtual: Web::CSS::CSSConditionRule::condition_matches")

## Ported from Libraries/LibWeb/CSS/CSSConditionRule.cpp:13 Web::CSS::CSSConditionRule::CSSConditionRule.
pub func css_condition_rule_construct(this: CssConditionRule*, realm: Realm*, rules: CssRuleList*, type_: CssRuleType):
    css_grouping_rule_construct(this.css_grouping_rule(), realm, rules, type_)

## Ported from Libraries/LibWeb/CSS/CSSConditionRule.cpp:19 Web::CSS::CSSConditionRule::for_each_effective_rule (override).
pub func css_condition_rule_for_each_effective_rule_impl(base: CssGroupingRule*, order: TraversalOrder, callback: ak.Function1[CssRule*, unit]):
    let this = (CssConditionRule*)base
    if css_condition_rule_condition_matches(this):
        css_grouping_rule_for_each_effective_rule_impl(base, order, callback)

## Ported from Libraries/LibWeb/CSS/CSSConditionRule.cpp:25 Web::CSS::CSSConditionRule::initialize (override).
pub func css_condition_rule_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_condition_rule)
    css_grouping_rule_initialize_impl(base, realm)
