## Ported from Libraries/LibWeb/CSS/MediaQuery.h:50 Web::CSS::MediaFeatureValue::is_same_type.
pub func css_media_feature_value_is_same_type(this: const CssMediaFeatureValue*, other: CssMediaFeatureValue) -> bool:
