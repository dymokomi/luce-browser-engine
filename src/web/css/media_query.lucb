## Ported from Libraries/LibWeb/CSS/MediaQuery.h:113 Web::CSS::MediaFeature::max.
pub func css_media_feature_max(id: css_data.MediaFeatureId, value: CssMediaFeatureValue) -> CssMediaFeature*:
