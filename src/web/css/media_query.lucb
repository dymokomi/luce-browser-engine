#==============================================================================================
#
#   media_query - CSS::MediaQuery and CSS::MediaFeature: media queries, their features and
#                 values, evaluation against a document and serialization
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/MediaQuery.cpp (lines 1-359) and the inline members of MediaQuery.h
#       (lines 18-218). A MediaFeature is a BooleanExpression; a MediaQuery (C++ RefCounted) is
#       a managed blob whose `m_matches` caches the last evaluation.
#
#       Copyright (c) 2021-2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: MediaFeatureValue =======================================================================

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:36 Web::CSS::MediaFeatureValue::MediaFeatureValue.
pub func css_media_feature_value_construct(this: CssMediaFeatureValue*, type_: CssMediaFeatureValueType, value: CssStyleValue*):
    this.m_type = type_
    this.m_value = value

## Ported from Libraries/LibWeb/CSS/MediaQuery.cpp:29 Web::CSS::MediaFeatureValue::to_string.
pub func css_media_feature_value_to_string(this: const CssMediaFeatureValue*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_style_value_serialize(this.m_value, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:44 Web::CSS::MediaFeatureValue::is_ident.
pub func css_media_feature_value_is_ident(this: const CssMediaFeatureValue*) -> bool:
