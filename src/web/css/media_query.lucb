## Ported from Libraries/LibWeb/CSS/MediaQuery.h:52 Web::CSS::MediaFeatureValue::ident.
pub func css_media_feature_value_ident(this: const CssMediaFeatureValue*) -> css_data.Keyword:
    assert(css_media_feature_value_is_ident(this))
    return css_style_value_to_keyword(this.m_value)

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:58 Web::CSS::MediaFeatureValue::length.
pub func css_media_feature_value_length(this: const CssMediaFeatureValue*, computation_context: CssComputationContext) -> CssLength:
    assert(css_media_feature_value_is_length(this))
    return css_length_from_style_value(css_style_value_absolutized(this.m_value, computation_context), none)

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:64 Web::CSS::MediaFeatureValue::ratio.
pub func css_media_feature_value_ratio(this: const CssMediaFeatureValue*, computation_context: CssComputationContext) -> CssRatio:
    assert(css_media_feature_value_is_ratio(this))
    return css_ratio_style_value_resolved(css_style_value_as_ratio(css_style_value_absolutized(this.m_value, computation_context)))

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:70 Web::CSS::MediaFeatureValue::resolution.
pub func css_media_feature_value_resolution(this: const CssMediaFeatureValue*, computation_context: CssComputationContext) -> CssResolution:
    assert(css_media_feature_value_is_resolution(this))
    return css_resolution_from_style_value(css_style_value_absolutized(this.m_value, computation_context))

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:76 Web::CSS::MediaFeatureValue::integer.
pub func css_media_feature_value_integer(this: const CssMediaFeatureValue*, computation_context: CssComputationContext) -> i32:
    assert(css_media_feature_value_is_integer(this))
    return css_int_from_style_value(css_style_value_absolutized(this.m_value, computation_context))

# mark: MediaFeature ============================================================================

## A MediaFeature allocated and constructed (`adopt_own(*new MediaFeature(...))`).
func css_media_feature_new(type_: CssMediaFeatureType, id: css_data.MediaFeatureId, value: EmptyOrCssMediaFeatureValueOrCssMediaFeatureRange) -> CssMediaFeature*:
    let this = &(alloc CssMediaFeature[1] else trap("out of memory"))[0]
    css_media_feature_construct(this, type_, id, value)
    return this

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:99 Web::CSS::MediaFeature::boolean.
# Corresponds to `<mf-boolean>` grammar
pub func css_media_feature_boolean(id: css_data.MediaFeatureId) -> CssMediaFeature*:
    return css_media_feature_new(CssMediaFeatureType.is_true, id, EmptyOrCssMediaFeatureValueOrCssMediaFeatureRange.empty)

## Ported from Libraries/LibWeb/CSS/MediaQuery.h:105 Web::CSS::MediaFeature::plain.
# Corresponds to `<mf-plain>` grammar
pub func css_media_feature_plain(id: css_data.MediaFeatureId, value: CssMediaFeatureValue) -> CssMediaFeature*:
    return css_media_feature_new(CssMediaFeatureType.exact_value, id, EmptyOrCssMediaFeatureValueOrCssMediaFeatureRange.css_media_feature_value(value))

