## Ported from Libraries/LibWeb/CSS/Filter.h:17 Web::CSS::Filter::Filter.
pub func css_filter_construct(this: CssFilter*, filter_value_list: CssStyleValue*):
    this.m_filter_value_list = filter_value_list

## Ported from Libraries/LibWeb/CSS/Filter.h:22 Web::CSS::Filter::make_none.
pub func css_filter_make_none() -> CssFilter:
    # Filter() = default: no filter value list.
    return CssFilter(m_filter_value_list = none)

## Ported from Libraries/LibWeb/CSS/Filter.h:27 Web::CSS::Filter::has_filters.
pub func css_filter_has_filters(this: const CssFilter*) -> bool:
    return this.m_filter_value_list != none

## Ported from Libraries/LibWeb/CSS/Filter.h:28 Web::CSS::Filter::is_none.
pub func css_filter_is_none(this: const CssFilter*) -> bool:
    return not css_filter_has_filters(this)

## Ported from Libraries/LibWeb/CSS/Filter.cpp:13 Web::CSS::Filter::filters.
pub func css_filter_filters(this: const CssFilter*) -> const CssFilterValue[]:
    assert(css_filter_has_filters(this))
    let filter_value_list = this.m_filter_value_list else trap("VERIFY: has_filters()")
    let filters = css_filter_value_list_style_value_filter_value_list(css_style_value_as_filter_value_list(filter_value_list))
    return ak.vector_span_const(&filters)
