## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.h:24 Web::CSS::CSSFunctionDeclarations::style.
pub func css_function_declarations_style(this: CssFunctionDeclarations*) -> CssFunctionDescriptors*:
    return this.m_style

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:17 Web::CSS::CSSFunctionDeclarations::create.
pub func css_function_declarations_create(realm: Realm*, parser: CssParser*, declarations: ak.Vector[css_syntax.Declaration]) -> CssFunctionDeclarations*:
    return realm_create_css_function_declarations(realm, realm, css_parser_convert_to_descriptors[CssFunctionDescriptors](parser, css_data.AtRuleId.function, declarations))

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:22 Web::CSS::CSSFunctionDeclarations::CSSFunctionDeclarations.
pub func css_function_declarations_construct(this: CssFunctionDeclarations*, realm: Realm*, style: CssFunctionDescriptors*):
    css_rule_construct(this.css_rule(), realm, CssRuleType.function_declarations)
    this.m_style = style

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:28 Web::CSS::CSSFunctionDeclarations::initialize (override).
pub func css_function_declarations_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.css_function_declarations)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:34 Web::CSS::CSSFunctionDeclarations::visit_edges (override).
pub func css_function_declarations_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssFunctionDeclarations*)base
    css_rule_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_style)

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:40 Web::CSS::CSSFunctionDeclarations::serialized (override).
pub func css_function_declarations_serialized_impl(base: CssRule*) -> ak.String:
    let this = (CssFunctionDeclarations*)base
    # https://drafts.csswg.org/css-mixins-1/#the-function-declarations-interface
    # The CSSFunctionDeclarations rule, like CSSNestedDeclarations, serializes as if its declaration block had been
    # serialized directly.
    return css_style_declaration_serialized(this.m_style.css_style_declaration())

## Ported from Libraries/LibWeb/CSS/CSSFunctionDeclarations.cpp:48 Web::CSS::CSSFunctionDeclarations::dump (override).
pub func css_function_declarations_dump_impl(base: CssRule*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssFunctionDeclarations*)base
    css_rule_dump_impl(base, builder, indent_levels)

    dump_descriptors(builder, this.m_style.css_descriptors(), indent_levels + 1)
