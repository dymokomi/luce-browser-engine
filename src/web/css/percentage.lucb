## Ported from Libraries/LibWeb/CSS/Percentage.h:18 Web::CSS::Percentage::Percentage.
pub func css_percentage_construct(this: CssPercentage*, value: f64):
    this.m_value = value

## `Percentage { value }` as a value.
pub func css_percentage_new(value: f64) -> CssPercentage:
    var percentage: CssPercentage = ---
    css_percentage_construct(&percentage, value)
    return percentage

## Ported from Libraries/LibWeb/CSS/Percentage.cpp:13 Web::CSS::Percentage::from_style_value.
pub func css_percentage_from_style_value(value: CssStyleValue*) -> CssPercentage:
    if css_style_value_is_percentage(value):
        return css_percentage_style_value_percentage(css_style_value_as_percentage(value))

    if css_style_value_is_calculated(value):
        return css_calculated_style_value_resolve_percentage(css_style_value_as_calculated(value), CssCalculationResolutionContext()) else trap("VERIFY: a resolved percentage")

    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Percentage.h:25 Web::CSS::Percentage::value.
pub func css_percentage_value(this: const CssPercentage*) -> f64:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/Percentage.h:26 Web::CSS::Percentage::as_fraction.
pub func css_percentage_as_fraction(this: const CssPercentage*) -> f64:
    return this.m_value * 0.01

## Ported from Libraries/LibWeb/CSS/Percentage.h:28 Web::CSS::Percentage::serialize.
pub func css_percentage_serialize(this: const CssPercentage*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode = css_syntax.SerializationMode.normal):
    _ = arg1
    # https://drafts.csswg.org/cssom/#serialize-a-css-value
    # -> <percentage>
    # The <number> component serialized as per <number> followed by the literal string "%" (U+0025).
    css_syntax.serialize_a_number_string_builder(builder, this.m_value)
    ak.string_builder_append_u8(builder, '%')

## Ported from Libraries/LibWeb/CSS/Percentage.h:37 Web::CSS::Percentage::to_string.
pub func css_percentage_to_string(this: const CssPercentage*, mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal) -> ak.String:
    var builder = ak.string_builder_new()
    css_percentage_serialize(this, &builder, mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Percentage.h:44 Web::CSS::Percentage::operator==.
pub func css_percentage_eq(this: const CssPercentage*, other: CssPercentage) -> bool:
    return this.m_value == other.m_value

## Ported from Libraries/LibWeb/CSS/Percentage.h:46 Web::CSS::Percentage::operator<=>.
pub func css_percentage_cmp(this: const CssPercentage*, other: CssPercentage) -> i32:
    if this.m_value < other.m_value:
        return -1
    if this.m_value > other.m_value:
        return 1
    return 0
