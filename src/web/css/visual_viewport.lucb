# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:20 Web::CSS::VisualViewport::create.
pub func css_visual_viewport_create(document: DomDocument*) -> CssVisualViewport*:
    return realm_create_css_visual_viewport(bind_platform_object_realm(document.bind_platform_object()), document)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:25 Web::CSS::VisualViewport::VisualViewport.
pub func css_visual_viewport_construct(this: CssVisualViewport*, document: DomDocument*):
    dom_event_target_construct(this.dom_event_target(), bind_platform_object_realm(document.bind_platform_object()))
    css_visual_viewport_init_fields(this)
    this.m_document = document

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:31 Web::CSS::VisualViewport::initialize (override).
pub func css_visual_viewport_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.visual_viewport)
    dom_event_target_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:37 Web::CSS::VisualViewport::visit_edges (override).
pub func css_visual_viewport_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssVisualViewport*)base
    dom_event_target_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_document)

# mark: Offsets, size and scale =================================================================

## Ported from Libraries/LibWeb/CSS/VisualViewport.h:26 Web::CSS::VisualViewport::offset.
pub func css_visual_viewport_offset(this: CssVisualViewport*) -> gfx.CssPixelPoint:
    return this.m_offset

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:44 Web::CSS::VisualViewport::offset_left.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-offsetleft
pub func css_visual_viewport_offset_left(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the offset of the left edge of the visual viewport from the left edge of the layout viewport.
    let x = gfx.css_pixel_point_x(&this.m_offset)
    return gfx.css_pixels_to_double_const(&x)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:55 Web::CSS::VisualViewport::offset_top.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-offsettop
pub func css_visual_viewport_offset_top(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the offset of the top edge of the visual viewport from the top edge of the layout viewport.
    let y = gfx.css_pixel_point_y(&this.m_offset)
    return gfx.css_pixels_to_double_const(&y)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:66 Web::CSS::VisualViewport::page_left.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-pageleft
pub func css_visual_viewport_page_left(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the offset of the left edge of the visual viewport from the
    #    left edge of the initial containing block of the layout viewport’s document.
    let viewport_rect = dom_document_viewport_rect(this.m_document)
    let x = gfx.css_pixel_rect_x(&viewport_rect)
    return gfx.css_pixels_to_double_const(&x) + css_visual_viewport_offset_left(this)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:78 Web::CSS::VisualViewport::page_top.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-pagetop
pub func css_visual_viewport_page_top(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the offset of the top edge of the visual viewport from the
    #    top edge of the initial containing block of the layout viewport’s document.
    let viewport_rect = dom_document_viewport_rect(this.m_document)
    let y = gfx.css_pixel_rect_y(&viewport_rect)
    return gfx.css_pixels_to_double_const(&y) + css_visual_viewport_offset_top(this)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:90 Web::CSS::VisualViewport::width.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-width
pub func css_visual_viewport_width(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the width of the visual viewport
    #    FIXME: excluding the width of any rendered vertical classic scrollbar that is fixed to the visual viewport.
    let viewport_rect = dom_document_viewport_rect(this.m_document)
    let size = gfx.css_pixel_rect_size(&viewport_rect)
    let width = gfx.css_pixel_size_width(&size)
    return gfx.css_pixels_to_double_const(&width) / this.m_scale

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:102 Web::CSS::VisualViewport::height.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-height
pub func css_visual_viewport_height(this: CssVisualViewport*) -> f64:
    # 1. If the visual viewport’s associated document is not fully active, return 0.
    if not dom_document_is_fully_active(this.m_document):
        return 0.0

    # 2. Otherwise, return the height of the visual viewport
    #    FIXME: excluding the height of any rendered vertical classic scrollbar that is fixed to the visual viewport.
    let viewport_rect = dom_document_viewport_rect(this.m_document)
    let size = gfx.css_pixel_rect_size(&viewport_rect)
    let height = gfx.css_pixel_size_height(&size)
    return gfx.css_pixels_to_double_const(&height) / this.m_scale

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:114 Web::CSS::VisualViewport::scale.
# https://drafts.csswg.org/cssom-view/#dom-visualviewport-scale
pub func css_visual_viewport_scale(this: CssVisualViewport*) -> f64:
    return this.m_scale

