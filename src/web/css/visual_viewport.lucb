# mark: Scrolling and zooming ===================================================================

## Ported from Libraries/LibWeb/CSS/VisualViewport.h:46 Web::CSS::VisualViewport::scroll_by.
pub func css_visual_viewport_scroll_by(this: CssVisualViewport*, delta: gfx.CssPixelPoint):
    _ = gfx.css_pixel_point_add_assign(&this.m_offset, delta)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:149 Web::CSS::VisualViewport::transform.
pub func css_visual_viewport_transform(this: CssVisualViewport*) -> gfx.AffineTransform:
    var transform: gfx.AffineTransform = ---
    gfx.affine_transform_construct(&transform)
    # auto offset = m_offset.to_type<double>() * m_scale;
    let offset_x_value = gfx.css_pixel_point_x(&this.m_offset)
    let offset_y_value = gfx.css_pixel_point_y(&this.m_offset)
    let offset_x = gfx.css_pixels_to_double_const(&offset_x_value) * this.m_scale
    let offset_y = gfx.css_pixels_to_double_const(&offset_y_value) * this.m_scale
    _ = gfx.affine_transform_translate_f32(&transform, (f32)(-offset_x), (f32)(-offset_y))
    _ = gfx.affine_transform_scale_float_point(&transform, gfx.FloatPoint(m_x = (f32)this.m_scale, m_y = (f32)this.m_scale))
    return transform

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:158 Web::CSS::VisualViewport::zoom.
pub func css_visual_viewport_zoom(this: CssVisualViewport*, position: gfx.CssPixelPoint, scale_delta: f64):
    let min_allowed_scale: f64 = 1.0
    let max_allowed_scale: f64 = 5.0
    let new_scale = ak.clamp_f64(this.m_scale * (1.0 + scale_delta), min_allowed_scale, max_allowed_scale)
    let applied_delta = new_scale / this.m_scale

    # For pinch zoom we want focal_point to stay put on screen:
    # scale_new * (focal_point - offset_new) = scale_old * (focal_point - offset_old)
    # (Point<double> arithmetic, coordinate by coordinate.)
    let offset_x = gfx.css_pixel_point_x(&this.m_offset)
    let offset_y = gfx.css_pixel_point_y(&this.m_offset)
    var new_offset_x = gfx.css_pixels_to_double_const(&offset_x) * this.m_scale * applied_delta
    var new_offset_y = gfx.css_pixels_to_double_const(&offset_y) * this.m_scale * applied_delta
    let position_int = gfx.css_pixel_point_to_type_i32(&position)
    new_offset_x += f64(position_int.m_x) * (applied_delta - 1.0)
    new_offset_y += f64(position_int.m_y) * (applied_delta - 1.0)

    let navigable = dom_document_navigable(this.m_document) else trap("VERIFY: navigable")
    let viewport_rect = html_navigable_viewport_rect(navigable)
    let viewport_size = gfx.css_pixel_rect_size(&viewport_rect)
    let viewport_width = gfx.css_pixel_size_width(&viewport_size)
    let viewport_height = gfx.css_pixel_size_height(&viewport_size)
    let max_x_offset = ak.max_f64(0.0, gfx.css_pixels_to_double_const(&viewport_width) * (new_scale - 1.0))
    let max_y_offset = ak.max_f64(0.0, gfx.css_pixels_to_double_const(&viewport_height) * (new_scale - 1.0))
    new_offset_x = ak.clamp_f64(new_offset_x, 0.0, max_x_offset)
    new_offset_y = ak.clamp_f64(new_offset_y, 0.0, max_y_offset)

    this.m_scale = new_scale
    # m_offset = (new_offset / m_scale).to_type<CSSPixels>();
    gfx.css_pixel_point_construct(&this.m_offset, gfx.css_pixels_nearest_value_for_f64(new_offset_x / this.m_scale), gfx.css_pixels_nearest_value_for_f64(new_offset_y / this.m_scale))
    dom_document_set_needs_accumulated_visual_contexts_update(this.m_document, true)
    dom_document_set_needs_repaint_t(this.m_document, InvalidateDisplayList.yes)

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:181 Web::CSS::VisualViewport::map_to_layout_viewport.
pub func css_visual_viewport_map_to_layout_viewport(this: CssVisualViewport*, position: gfx.CssPixelPoint) -> gfx.CssPixelPoint:
    let transform = css_visual_viewport_transform(this)
    var inverse: gfx.AffineTransform = ---
    if let transform_inverse = gfx.affine_transform_inverse(&transform):
        inverse = transform_inverse
    else:
        gfx.affine_transform_construct(&inverse)
    let mapped = gfx.affine_transform_map_i32_int_point(&inverse, gfx.css_pixel_point_to_type_i32(&position))
    var result: gfx.CssPixelPoint = ---
    gfx.css_pixel_point_construct_int(&result, i64(mapped.m_x), i64(mapped.m_y))
    return result

## Ported from Libraries/LibWeb/CSS/VisualViewport.cpp:187 Web::CSS::VisualViewport::reset.
pub func css_visual_viewport_reset(this: CssVisualViewport*):
    this.m_scale = 1.0
    gfx.css_pixel_point_construct_int(&this.m_offset, 0, 0)
    dom_document_set_needs_accumulated_visual_contexts_update(this.m_document, true)
    dom_document_set_needs_repaint_t(this.m_document, InvalidateDisplayList.yes)
