## Web::CSS::CSSAnimation (Libraries/LibWeb/CSS/CSSAnimation.h:17).
## https://www.w3.org/TR/css-animations-2/#cssanimation
pub struct CssAnimation: IsAnimationsAnimation, IsDomEventTarget, IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var animation: AnimationsAnimation  # primary base
    # https://drafts.csswg.org/css-animations-2/#dom-cssanimation-animationname
    pub var m_animation_name: ak.FlyString
    # https://drafts.csswg.org/css-animations-1/#animation-timing-function
    # The default per-keyframe easing, from the animation-timing-function property on the element.
    pub var m_default_easing: CssEasingFunction  # C++ default: { EasingFunction::ease() }
    pub var m_ignored_css_properties: ak.HashTable[css_data.PropertyId, css_data.PropertyIdTraits]

    func animations_animation() -> AnimationsAnimation*: return (AnimationsAnimation*)&self

    func dom_event_target() -> DomEventTarget*: return (DomEventTarget*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of Web::CSS::CSSAnimation.
pub let css_animation_vtable: AnimationsAnimationVTable = AnimationsAnimationVTable(event_target_vtable = DomEventTargetVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &css_animation_class, visit_edges = animations_animation_visit_edges_impl, finalize = animations_animation_finalize_impl), initialize = css_animation_initialize_impl))), set_timeline_for_bindings = css_animation_set_timeline_for_bindings_impl, is_css_animation = css_animation_is_css_animation_impl, animation_class = css_animation_animation_class_impl, class_specific_composite_order = css_animation_class_specific_composite_order_impl)

## Class information of Web::CSS::CSSAnimation: EventTarget's first class id, recognized by its ClassInfo.
pub let css_animation_class: ak.ClassInfo = ak.ClassInfo(name = "CSSAnimation", first_id = 49, last_id = 49, size = memory.size_of(CssAnimation), vtable = (const void*)&css_animation_vtable)

## is<Web::CSS::CSSAnimation>: the cell's ClassInfo.
pub func is_css_animation[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &css_animation_class

## as_if<Web::CSS::CSSAnimation>.
pub func as_if_css_animation[P: gc.IsCell](p: P*) -> CssAnimation*?:
    if is_css_animation(p): return (CssAnimation*)p
    return none

## as<Web::CSS::CSSAnimation> (verify_cast).
pub func as_css_animation[P: gc.IsCell](p: P*) -> CssAnimation*:
    return as_if_css_animation(p) else trap("as<Web::CSS::CSSAnimation> failed")

## realm.create<Web::CSS::CSSAnimation>(realm): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_css_animation(realm: Realm*, realm_: Realm*) -> CssAnimation*:
    let this = (CssAnimation*)web_allocate_cell(realm, &css_animation_class)
    css_animation_construct(this, realm_)
    web_initialize_cell(this.cell(), realm)
    return this
