# mark: ComputedValues (ComputedValues.h:504-640) ==============================================

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:509 Web::CSS::ComputedValues::ComputedValues (defaulted: the
## inherited and non-inherited values' default member initializers).
pub func css_computed_values_construct(this: CssComputedValues*):
    css_computed_values_inherited_values_init_fields(&this.m_inherited)
    css_computed_values_non_inherited_values_init_fields(&this.m_noninherited)

## `make<ComputedValues>()`: a default-constructed ComputedValues in managed memory (the current allocator).
pub func css_computed_values_create() -> CssComputedValues*:
    let this = &(new CssComputedValues[1] --- else trap("out of memory"))[0]
    css_computed_values_construct(this)
    return this

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:512 Web::CSS::ComputedValues::visit_edges.
pub func css_computed_values_visit_edges(this: CssComputedValues*, visitor: gc.CellVisitor*):
    css_computed_values_non_inherited_values_visit_edges(&this.m_noninherited, visitor)

