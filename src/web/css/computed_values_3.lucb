## Ported from Libraries/LibWeb/CSS/ComputedValues.h:609 Web::CSS::ComputedValues::inline_axis_is_reverse.
pub func css_computed_values_inline_axis_is_reverse(this: const CssComputedValues*) -> bool:
    match css_computed_values_writing_mode(this):
        .horizontal_tb, .vertical_rl, .vertical_lr, .sideways_rl:
            return css_computed_values_direction(this) == css_data.Direction.rtl
        .sideways_lr:
            return css_computed_values_direction(this) == css_data.Direction.ltr
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:623 Web::CSS::ComputedValues::block_axis_is_reverse.
pub func css_computed_values_block_axis_is_reverse(this: const CssComputedValues*) -> bool:
    match css_computed_values_writing_mode(this):
        .horizontal_tb, .vertical_lr, .sideways_lr:
            return false
        .vertical_rl, .sideways_rl:
            return true
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/ComputedValues.h:637 Web::CSS::ComputedValues::user_select.
pub func css_computed_values_user_select(this: const CssComputedValues*) -> css_data.UserSelect:
    return this.m_noninherited.user_select
