## Ported from Libraries/LibWeb/CSS/Angle.cpp:17 Web::CSS::Angle::Angle.
pub func css_angle_construct(this: CssAngle*, value: f64, unit_: css_data.AngleUnit):
    this.m_unit = unit_
    this.m_value = value

## `Angle { value, unit }` as a value.
pub func css_angle_new(value: f64, unit_: css_data.AngleUnit) -> CssAngle:
    var angle: CssAngle = ---
    css_angle_construct(&angle, value, unit_)
    return angle

## Ported from Libraries/LibWeb/CSS/Angle.cpp:23 Web::CSS::Angle::make_degrees.
pub func css_angle_make_degrees(value: f64) -> CssAngle:
    return css_angle_new(value, css_data.AngleUnit.deg)

## Ported from Libraries/LibWeb/CSS/Angle.cpp:28 Web::CSS::Angle::percentage_of.
pub func css_angle_percentage_of(this: const CssAngle*, percentage: CssPercentage) -> CssAngle:
    return css_angle_new(css_percentage_as_fraction(&percentage) * this.m_value, this.m_unit)

## Ported from Libraries/LibWeb/CSS/Angle.cpp:33 Web::CSS::Angle::serialize.
pub func css_angle_serialize(this: const CssAngle*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal):
    # https://drafts.csswg.org/cssom/#serialize-a-css-value
    # -> <angle>
    # The <number> component serialized as per <number> followed by the unit in canonical form as defined in its
    # respective specification.
    if serialization_mode == css_syntax.SerializationMode.resolved_value:
        css_syntax.serialize_a_number_string_builder(builder, css_angle_to_degrees(this))
        ak.string_builder_append(builder, "deg")
        return
    css_syntax.serialize_a_number_string_builder(builder, css_angle_raw_value(this))
    let unit_name = css_angle_unit_name(this)
    ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&unit_name))

## Ported from Libraries/LibWeb/CSS/Angle.cpp:48 Web::CSS::Angle::to_string.
pub func css_angle_to_string(this: const CssAngle*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal) -> ak.String:
    var builder = ak.string_builder_new()
    css_angle_serialize(this, &builder, serialization_mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Angle.cpp:55 Web::CSS::Angle::to_degrees.
pub func css_angle_to_degrees(this: const CssAngle*) -> f64:
    return css_data.ratio_between_units_angle_unit(this.m_unit, css_data.AngleUnit.deg) * this.m_value

## Ported from Libraries/LibWeb/CSS/Angle.cpp:60 Web::CSS::Angle::to_radians.
pub func css_angle_to_radians(this: const CssAngle*) -> f64:
    return css_data.ratio_between_units_angle_unit(this.m_unit, css_data.AngleUnit.rad) * this.m_value

## Ported from Libraries/LibWeb/CSS/Angle.h:29 Web::CSS::Angle::raw_value.
pub func css_angle_raw_value(this: const CssAngle*) -> f64:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/Angle.h:30 Web::CSS::Angle::unit.
pub func css_angle_unit(this: const CssAngle*) -> css_data.AngleUnit:
    return this.m_unit

## Ported from Libraries/LibWeb/CSS/Angle.h:31 Web::CSS::Angle::unit_name.
pub func css_angle_unit_name(this: const CssAngle*) -> ak.FlyString:
    return css_data.to_string_angle_unit(this.m_unit)

## Ported from Libraries/LibWeb/CSS/Angle.h:33 Web::CSS::Angle::operator==.
pub func css_angle_eq(this: const CssAngle*, other: CssAngle) -> bool:
    return this.m_unit == other.m_unit and this.m_value == other.m_value

## Ported from Libraries/LibWeb/CSS/Angle.h:38 Web::CSS::Angle::operator<=>.
pub func css_angle_cmp(this: const CssAngle*, other: CssAngle) -> i32:
    let this_degrees = css_angle_to_degrees(this)
    let other_degrees = css_angle_to_degrees(&other)

    if this_degrees < other_degrees:
        return -1
    if this_degrees > other_degrees:
        return 1
    return 0

## Ported from Libraries/LibWeb/CSS/Angle.cpp:65 Web::CSS::Angle::from_style_value.
pub func css_angle_from_style_value(style_value: CssStyleValue*, percentage_basis: CssAngle?) -> CssAngle:
    if css_style_value_is_angle(style_value):
        return css_angle_style_value_angle(css_style_value_as_angle(style_value))

    if css_style_value_is_calculated(style_value):
        var resolved_percentage_basis = CssCalculationResolutionContextPercentageBasis.empty

        if let basis = percentage_basis:
            resolved_percentage_basis = .css_angle(basis)

        return css_calculated_style_value_resolve_angle(css_style_value_as_calculated(style_value), CssCalculationResolutionContext(percentage_basis = resolved_percentage_basis)) else trap("VERIFY: a resolved angle")

    if css_style_value_is_percentage(style_value):
        let basis = percentage_basis else trap("VERIFY: a percentage basis")

        return css_angle_percentage_of(&basis, css_percentage_style_value_percentage(css_style_value_as_percentage(style_value)))

    trap("VERIFY_NOT_REACHED")
