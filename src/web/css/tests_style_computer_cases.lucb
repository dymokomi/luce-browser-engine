#==============================================================================================
#
#   tests_style_computer_cases - the cascade cases pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's test-web on a Text test computing the same styles
#       (luce-browser-tools, oracles/luce-browser-engine/style_computer: cases.txt,
#       gen_cases.py). tests_style_computer builds each tree with the case's author style
#       sheet, runs the port's cascade and compares the values it answers.
#
#==============================================================================================

## One oracle case: the author style sheet, div#root's markup, the queries ("<id> <property>...",
## one per line) and the reference build's getComputedStyle() values ("<id> <property>: <value>",
## one per line).
struct TestStyleComputerCase:
    let css: str
    let markup: str
    let queries: str
    let expected: str

## Every oracle case, in cases.txt order.
let test_style_computer_cases: TestStyleComputerCase[24] = [
    TestStyleComputerCase(css = "", markup = "<div id=a><span id=b></span><p id=c></p><em id=d></em><section id=e></section><ul id=f><li id=g></li></ul><b id=h></b><i id=i></i><cite id=j></cite></div>", queries = "html display text-align visibility\nbody display\nroot display\na display font-style\nb display font-style\nc display\nd display font-style\ne display\nf display list-style-position\ng display list-style-position\nh display\ni display font-style\nj display font-style\n", expected = "html display: block\nhtml text-align: start\nhtml visibility: visible\nbody display: block\nroot display: block\na display: block\na font-style: normal\nb display: inline\nb font-style: normal\nc display: block\nd display: inline\nd font-style: italic\ne display: block\nf display: block\nf list-style-position: outside\ng display: list-item\ng list-style-position: outside\nh display: inline\ni display: inline\ni font-style: italic\nj display: inline\nj font-style: italic\n"),
    TestStyleComputerCase(css = "div { display: inline } .k { display: inline-block } #x { display: none } p { visibility: hidden } p { visibility: collapse } span.k { cursor: pointer } .k.k { cursor: text } span { cursor: move }", markup = "<div id=x class=k></div><div id=y class=k></div><div id=z></div><p id=p></p><span id=s class=k></span><span id=t></span>", queries = "x display\ny display\nz display\np visibility\ns cursor\nt cursor\n", expected = "x display: none\ny display: inline-block\nz display: inline\np visibility: collapse\ns cursor: text\nt cursor: move\n"),
    TestStyleComputerCase(css = "#a { display: inline } div { display: block !important } .b { z-index: 3 !important } #b { z-index: 5 } #c { order: 2 } .d { order: 4 !important }", markup = "<div id=a></div><div id=b class=b style=\"z-index: 7\"></div><div id=c style=\"order: 1\"></div><div id=d class=d style=\"order: 9\"></div><div id=e style=\"order: 6 !important\" class=d></div>", queries = "a display\nb z-index\nc order\nd order\ne order\n", expected = "a display: block\nb z-index: 3\nc order: 1\nd order: 4\ne order: 6\n"),
    TestStyleComputerCase(css = "#o { visibility: hidden; cursor: pointer; text-align: center; z-index: 4; text-transform: uppercase; font-style: italic; direction: rtl }", markup = "<div id=o><span id=p><b id=q></b></span></div>", queries = "o visibility cursor text-align z-index text-transform font-style direction\np visibility cursor text-align z-index text-transform font-style direction\nq visibility cursor text-align z-index text-transform font-style direction\n", expected = "o visibility: hidden\no cursor: pointer\no text-align: center\no z-index: 4\no text-transform: uppercase\no font-style: italic\no direction: rtl\np visibility: hidden\np cursor: pointer\np text-align: center\np z-index: auto\np text-transform: uppercase\np font-style: italic\np direction: rtl\nq visibility: hidden\nq cursor: pointer\nq text-align: center\nq z-index: auto\nq text-transform: uppercase\nq font-style: italic\nq direction: rtl\n"),
    TestStyleComputerCase(css = "#o { z-index: 4; cursor: pointer; display: inline-block; opacity: 0.25 } #p { z-index: inherit; cursor: initial; display: inherit; opacity: inherit } #q { cursor: unset; z-index: unset; display: unset } #r { visibility: hidden } #s { visibility: initial } #t { visibility: unset }", markup = "<div id=o><span id=p><b id=q></b></span></div><div id=r><span id=s></span><span id=t></span></div>", queries = "p z-index cursor display opacity\nq z-index cursor display opacity\ns visibility\nt visibility\n", expected = "p z-index: 4\np cursor: auto\np display: inline-block\np opacity: 0.25\nq z-index: auto\nq cursor: auto\nq display: inline\nq opacity: 1\ns visibility: visible\nt visibility: hidden\n"),
    TestStyleComputerCase(css = "@layer one, two;\n@layer two { #a { z-index: 2 } #b { z-index: 2 !important } }\n@layer one { #a { z-index: 1 } #b { z-index: 1 !important } #c { order: 1 } }\n#c { order: 5 } #a { z-index: 9 } #b { z-index: 9 !important } #d { order: 3 !important }\n@layer two { #d { order: 2 !important } }", markup = "<div id=a></div><div id=b></div><div id=c></div><div id=d></div>", queries = "a z-index\nb z-index\nc order\nd order\n", expected = "a z-index: 9\nb z-index: 1\nc order: 5\nd order: 2\n"),
    TestStyleComputerCase(css = "@layer outer { @layer inner { #a { order: 1 } #b { order: 1 } } #a { order: 2 } }\n@layer { #b { order: 3 } }\n@layer outer.inner { #c { order: 4 } }\n@layer { #c { order: 5 } }\n@layer late, early;\n@layer early { #d { z-index: 1 } }\n@layer late { #d { z-index: 2 } }", markup = "<div id=a></div><div id=b></div><div id=c></div><div id=d></div>", queries = "a order\nb order\nc order\nd z-index\n", expected = "a order: 2\nb order: 3\nc order: 5\nd z-index: 1\n"),
    TestStyleComputerCase(css = "@layer low { #a.x.y { cursor: pointer } }\n@layer high { div { cursor: text } }", markup = "<div id=a class=\"x y\"></div>", queries = "a cursor\n", expected = "a cursor: text\n"),
    TestStyleComputerCase(css = "div { display: inline } #b { display: revert } p { visibility: hidden }\n@layer base { #c { z-index: 4 } }\n@layer top { #c { z-index: revert-layer } #d { z-index: revert-layer } }\n#e { visibility: revert }", markup = "<div id=a></div><div id=b></div><div id=c></div><div id=d></div><p id=e></p>", queries = "a display\nb display\nc z-index\nd z-index\ne visibility\n", expected = "a display: inline\nb display: block\nc z-index: 4\nd z-index: auto\ne visibility: visible\n"),
    TestStyleComputerCase(css = "", markup = "<div id=a hidden></div><span id=b hidden=\"until-found\"></span><table id=t><tbody id=tb><tr id=tr><td id=td></td><th id=th></th></tr></tbody></table>", queries = "a display\nb display\nt display\ntb display\ntr display\ntd display\nth display\n", expected = "a display: none\nb display: inline\nt display: table\ntb display: table-row-group\ntr display: table-row\ntd display: table-cell\nth display: table-cell\n"),
    TestStyleComputerCase(css = "#a { list-style: square inside } #b { list-style: inside; list-style-position: outside } #c { overflow: hidden } #d { place-self: center }", markup = "<ul><li id=a></li><li id=b></li></ul><div id=c></div><div id=d></div>", queries = "a list-style-position\nb list-style-position\nc overflow-x overflow-y\nd align-self justify-self\n", expected = "a list-style-position: inside\nb list-style-position: outside\nc overflow-x: hidden\nc overflow-y: hidden\nd align-self: center\nd justify-self: center\n"),
    TestStyleComputerCase(css = "#o { cursor: pointer; z-index: 3 } #p { all: initial } #q { all: inherit } #r { all: unset }", markup = "<div id=o><span id=p></span><span id=q></span><span id=r></span></div>", queries = "p cursor z-index display\nq cursor z-index display\nr cursor z-index display\n", expected = "p cursor: auto\np z-index: auto\np display: inline\nq cursor: pointer\nq z-index: 3\nq display: block\nr cursor: pointer\nr z-index: auto\nr display: inline\n"),
    TestStyleComputerCase(css = "#o { --a: 10px; --b: var(--a); --c: foo  bar; --d: block } #p { --a: 20px; display: var(--d) } #q { --e: var(--missing, inline-block); display: var(--e) } #r { display: var(--nothing) } #s { z-index: var(--z, 8) }", markup = "<div id=o><span id=p><b id=q></b><b id=r></b><b id=s></b></span></div>", queries = "o --a --b --c --d\np --a --b --c display\nq --a --e display\nr display\ns z-index\n", expected = "o --a: 10px\no --b: 10px\no --c: foo  bar\no --d: block\np --a: 20px\np --b: 10px\np --c: foo  bar\np display: block\nq --a: 20px\nq --e: inline-block\nq display: inline-block\nr display: inline\ns z-index: 8\n"),
    TestStyleComputerCase(css = "#a { --x: one !important } #a { --x: two } .b { --y: sheet } #c { --z: first; --z: second }", markup = "<div id=a style=\"--x: inline\"></div><div id=b class=b style=\"--y: inline\"></div><div id=c></div>", queries = "a --x\nb --y\nc --z\n", expected = "a --x: one\nb --y: inline\nc --z: second\n"),
    TestStyleComputerCase(css = "[data-x] { cursor: pointer } [data-x=\"b\"] { cursor: text } * { z-index: 1 } :is(.k) { order: 3 } :where(#w) { order: 4 } :root { cursor: move } :is(section) { text-transform: uppercase } div:not(.k) { visibility: hidden }", markup = "<div id=a data-x></div><div id=b data-x=b></div><div id=k class=k></div><div id=w></div><section id=s></section>", queries = "html cursor\na cursor z-index visibility\nb cursor\nk order visibility\nw order\ns text-transform\n", expected = "html cursor: move\na cursor: pointer\na z-index: 1\na visibility: hidden\nb cursor: text\nk order: 3\nk visibility: hidden\nw order: 4\ns text-transform: uppercase\n"),
    TestStyleComputerCase(css = "#o > span { z-index: 1 } #o span { order: 2 } span + b { cursor: pointer } span ~ i { cursor: text } li:first-child { z-index: 5 } li:nth-child(2n) { z-index: 6 } li:last-child { order: 7 }", markup = "<div id=o><span id=a><span id=b></span></span><b id=c></b><i id=d></i></div><ul><li id=e></li><li id=f></li><li id=g></li></ul>", queries = "a z-index order\nb z-index order\nc cursor\nd cursor\ne z-index order\nf z-index\ng z-index order\n", expected = "a z-index: 1\na order: 2\nb z-index: auto\nb order: 2\nc cursor: pointer\nd cursor: text\ne z-index: 5\ne order: 0\nf z-index: 6\ng z-index: auto\ng order: 7\n"),
    TestStyleComputerCase(css = "#a { display: banana; z-index: 2; z-index: 1.5 } #b { cursor: pointer; colour: red; cursor: nope }", markup = "<div id=a></div><div id=b></div>", queries = "a display z-index\nb cursor\n", expected = "a display: block\na z-index: 2\nb cursor: pointer\n"),
    TestStyleComputerCase(css = ".p { z-index: 1; & > .c { z-index: 2 } .d & { z-index: 3 } &.e { order: 4 } }", markup = "<div id=a class=p><span id=b class=c></span></div><div class=d><div id=c class=p></div></div><div id=d class=\"p e\"></div>", queries = "a z-index\nb z-index\nc z-index\nd order\n", expected = "a z-index: 1\nb z-index: 2\nc z-index: 3\nd order: 4\n"),
    TestStyleComputerCase(css = ":where(#a) { z-index: 1 } div { z-index: 2 } :is(#b, div) { z-index: 3 } #b { z-index: 4 } [data-k=\"X\" i] { cursor: pointer } [data-k=\"X\"] { cursor: text }", markup = "<div id=a></div><div id=b></div><div id=c data-k=x></div><div id=d data-k=X></div>", queries = "a z-index\nb z-index\nc cursor\nd cursor\n", expected = "a z-index: 3\nb z-index: 4\nc cursor: pointer\nd cursor: text\n"),
    TestStyleComputerCase(css = "#a { --p: inside; list-style: square var(--p) } #b { --o: hidden; overflow: var(--o) } #c { overflow: var(--none) }", markup = "<ul><li id=a></li></ul><div id=b></div><div id=c></div>", queries = "a list-style-position\nb overflow-x overflow-y\nc overflow-x overflow-y\n", expected = "a list-style-position: inside\nb overflow-x: hidden\nb overflow-y: hidden\nc overflow-x: visible\nc overflow-y: visible\n"),
    TestStyleComputerCase(css = "#o { --a: one; --b: two; --c: three } #p { --a: initial; --b: inherit; --c: unset } #q { --i: sheet !important }", markup = "<div id=o><span id=p></span></div><div id=q style=\"--i: inline !important\"></div>", queries = "p --a --b --c\nq --i\n", expected = "p --a: \np --b: two\np --c: three\nq --i: inline\n"),
    TestStyleComputerCase(css = "@layer a { #x { z-index: 1 !important } }\n@layer b { #x { z-index: revert-layer !important } }\n#y { z-index: 2; all: revert } #z { display: contents }", markup = "<div id=x></div><div id=y></div><div id=z></div>", queries = "x z-index\ny z-index display\nz display\n", expected = "x z-index: 1\ny z-index: auto\ny display: block\nz display: contents\n"),
    TestStyleComputerCase(css = ".a { order: 1 } div { order: 2 } #m { order: 3 } .a.b { order: 4 } div.a { order: 5 } [title] { cursor: pointer } div[title] { cursor: text } * { cursor: move }", markup = "<div id=m class=\"a b\" title=t></div><div id=n class=a></div><span id=o title=t></span>", queries = "m order cursor\nn order cursor\no order cursor\n", expected = "m order: 3\nm cursor: text\nn order: 5\nn cursor: move\no order: 0\no cursor: pointer\n"),
    TestStyleComputerCase(css = "[hidden] { display: block } #b { display: block }", markup = "<div id=a hidden></div><div id=b hidden></div>", queries = "a display\nb display\n", expected = "a display: block\nb display: block\n"),
]
