# mark: Factories and queries ===================================================================

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:19 Web::CSS::GridTrackPlacement::make_auto.
pub func css_grid_track_placement_make_auto() -> CssGridTrackPlacement:
    var placement: CssGridTrackPlacement = ---
    css_grid_track_placement_construct(&placement)
    return placement

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:24 Web::CSS::GridTrackPlacement::make_line.
pub func css_grid_track_placement_make_line(line_number: CssStyleValue*?, name: ak.String?) -> CssGridTrackPlacement:
    var placement: CssGridTrackPlacement = ---
    css_grid_track_placement_construct_css_grid_track_placement_area_(&placement, CssGridTrackPlacementAreaOrLine(line_number = line_number, name = name))
    return placement

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:29 Web::CSS::GridTrackPlacement::make_span.
pub func css_grid_track_placement_make_span(value: CssStyleValue*, name: ak.String?) -> CssGridTrackPlacement:
    var placement: CssGridTrackPlacement = ---
    css_grid_track_placement_construct_css_grid_track_placement_span(&placement, CssGridTrackPlacementSpan(value = value, name = name))
    return placement

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:34 Web::CSS::GridTrackPlacement::is_auto.
pub func css_grid_track_placement_is_auto(this: const CssGridTrackPlacement*) -> bool:
    match this.m_value:
        .css_grid_track_placement_auto(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:35 Web::CSS::GridTrackPlacement::is_span.
pub func css_grid_track_placement_is_span(this: const CssGridTrackPlacement*) -> bool:
    match this.m_value:
        .css_grid_track_placement_span(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:36 Web::CSS::GridTrackPlacement::is_area_or_line.
pub func css_grid_track_placement_is_area_or_line(this: const CssGridTrackPlacement*) -> bool:
    match this.m_value:
        .css_grid_track_placement_area_or_line(_): return true
        _: return false

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:38 Web::CSS::GridTrackPlacement::is_auto_positioned.
pub func css_grid_track_placement_is_auto_positioned(this: const CssGridTrackPlacement*) -> bool:
    return css_grid_track_placement_is_auto(this) or css_grid_track_placement_is_span(this)

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:39 Web::CSS::GridTrackPlacement::is_positioned.
pub func css_grid_track_placement_is_positioned(this: const CssGridTrackPlacement*) -> bool:
    return not css_grid_track_placement_is_auto_positioned(this)

## `m_value.get<AreaOrLine>()`.
func css_grid_track_placement_area_or_line(this: const CssGridTrackPlacement*) -> CssGridTrackPlacementAreaOrLine:
    match this.m_value:
        .css_grid_track_placement_area_or_line(area_or_line): return area_or_line
        _: trap("VERIFY: an AreaOrLine")

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:41 Web::CSS::GridTrackPlacement::is_custom_ident.
pub func css_grid_track_placement_is_custom_ident(this: const CssGridTrackPlacement*) -> bool:
    return css_grid_track_placement_is_area_or_line(this) and css_grid_track_placement_area_or_line(this).line_number == none

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:43 Web::CSS::GridTrackPlacement::has_identifier.
pub func css_grid_track_placement_has_identifier(this: const CssGridTrackPlacement*) -> bool:
    return css_grid_track_placement_is_area_or_line(this) and css_grid_track_placement_area_or_line(this).name != none

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:48 Web::CSS::GridTrackPlacement::has_line_number.
pub func css_grid_track_placement_has_line_number(this: const CssGridTrackPlacement*) -> bool:
    return css_grid_track_placement_is_area_or_line(this) and css_grid_track_placement_area_or_line(this).line_number != none

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:53 Web::CSS::GridTrackPlacement::identifier.
pub func css_grid_track_placement_identifier(this: const CssGridTrackPlacement*) -> ak.String:
    return css_grid_track_placement_area_or_line(this).name else trap("VERIFY: a name")

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:55 Web::CSS::GridTrackPlacement::line_number.
pub func css_grid_track_placement_line_number(this: const CssGridTrackPlacement*) -> CssStyleValue*:
    return css_grid_track_placement_area_or_line(this).line_number else trap("VERIFY: a line number")

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:56 Web::CSS::GridTrackPlacement::span.
pub func css_grid_track_placement_span(this: const CssGridTrackPlacement*) -> CssStyleValue*:
    match this.m_value:
        .css_grid_track_placement_span(span): return span.value
        _: trap("VERIFY: a Span")

# mark: Serialization and computation ===========================================================

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.cpp:16 Web::CSS::GridTrackPlacement::serialize.
pub func css_grid_track_placement_serialize(this: const CssGridTrackPlacement*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    match this.m_value:
        .css_grid_track_placement_auto(_):
            ak.string_builder_append(builder, "auto")
        .css_grid_track_placement_area_or_line(area_or_line):
            if let line_number = area_or_line.line_number:
                css_style_value_serialize(line_number, builder, mode)
                if let name = area_or_line.name:
                    ak.string_builder_append_u8(builder, ' ')
                    css_syntax.serialize_an_identifier_string_builder(builder, ak.string_bytes_as_string_view(&name))
            elif let name = area_or_line.name:
                css_syntax.serialize_an_identifier_string_builder(builder, ak.string_bytes_as_string_view(&name))
        .css_grid_track_placement_span(span):
            ak.string_builder_append(builder, "span")
            if span.name == none or not css_style_value_is_integer(span.value) or css_integer_style_value_integer(css_style_value_as_integer(span.value)) != 1:
                ak.string_builder_append_u8(builder, ' ')
                css_style_value_serialize(span.value, builder, mode)
            if let name = span.name:
                ak.string_builder_append_u8(builder, ' ')
                ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&name))

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.cpp:48 Web::CSS::GridTrackPlacement::to_string.
pub func css_grid_track_placement_to_string(this: const CssGridTrackPlacement*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_grid_track_placement_serialize(this, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.cpp:55 Web::CSS::GridTrackPlacement::absolutized.
pub func css_grid_track_placement_absolutized(this: const CssGridTrackPlacement*, context: CssComputationContext) -> CssGridTrackPlacement:
    match this.m_value:
        .css_grid_track_placement_auto(_):
            return *this
        .css_grid_track_placement_area_or_line(area_or_line):
            var line_number: CssStyleValue*? = none
            if let value = area_or_line.line_number:
                line_number = css_style_value_absolutized(value, context)
            var placement: CssGridTrackPlacement = ---
            css_grid_track_placement_construct_css_grid_track_placement_area_(&placement, CssGridTrackPlacementAreaOrLine(line_number = line_number, name = area_or_line.name))
            return placement
        .css_grid_track_placement_span(span):
            var placement: CssGridTrackPlacement = ---
            css_grid_track_placement_construct_css_grid_track_placement_span(&placement, CssGridTrackPlacementSpan(value = css_style_value_absolutized(span.value, context), name = span.name))
            return placement

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:63 Web::CSS::GridTrackPlacement::is_computationally_independent.
pub func css_grid_track_placement_is_computationally_independent(this: const CssGridTrackPlacement*) -> bool:
    match this.m_value:
        .css_grid_track_placement_auto(value): return css_grid_track_placement_auto_is_computationally_independent(&value)
        .css_grid_track_placement_area_or_line(value): return css_grid_track_placement_area_or_line_is_computationally_independent(&value)
        .css_grid_track_placement_span(value): return css_grid_track_placement_span_is_computationally_independent(&value)

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:68 Web::CSS::GridTrackPlacement::operator== (defaulted: the
## alternatives compare their members, style values by value).
pub func css_grid_track_placement_eq(this: const CssGridTrackPlacement*, other: CssGridTrackPlacement) -> bool:
    match this.m_value:
        .css_grid_track_placement_auto(_):
            return css_grid_track_placement_is_auto(&other)
        .css_grid_track_placement_area_or_line(area_or_line):
            match other.m_value:
                .css_grid_track_placement_area_or_line(other_area_or_line):
                    return css_optional_style_values_equal(area_or_line.line_number, other_area_or_line.line_number) and css_optional_strings_equal(area_or_line.name, other_area_or_line.name)
                _: return false
        .css_grid_track_placement_span(span):
            match other.m_value:
                .css_grid_track_placement_span(other_span):
                    return css_style_values_equal(span.value, other_span.value) and css_optional_strings_equal(span.name, other_span.name)
                _: return false

## ValueComparingNonnullRefPtr<StyleValue const>'s operator== (AK/ValueComparingRefPtr.h): the same value, or
## values that StyleValue::equals.
pub func css_style_values_equal(a: CssStyleValue*, b: CssStyleValue*) -> bool:
    return a == b or css_style_value_equals(a, b)

## ValueComparingRefPtr<StyleValue const>'s operator== (AK/ValueComparingRefPtr.h): the same pointer (null
## included), or two values that StyleValue::equals.
pub func css_optional_style_values_equal(a: CssStyleValue*?, b: CssStyleValue*?) -> bool:
    if a == b:
        return true
    if let left = a:
        if let right = b:
            return css_style_value_equals(left, right)
    return false

## Optional<String>'s operator==.
func css_optional_strings_equal(a: ak.String?, b: ak.String?) -> bool:
    if let left = a:
        if let right = b:
            return ak.string_equals(&left, &right)
        return false
    return b == none

# mark: The alternatives ========================================================================

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:73 Web::CSS::GridTrackPlacement::Auto::is_computationally_independent.
pub func css_grid_track_placement_auto_is_computationally_independent(this: const CssGridTrackPlacementAuto*) -> bool:
    return true

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:80 Web::CSS::GridTrackPlacement::AreaOrLine::is_computationally_independent.
pub func css_grid_track_placement_area_or_line_is_computationally_independent(this: const CssGridTrackPlacementAreaOrLine*) -> bool:
    if let line_number = this.line_number:
        return css_style_value_is_computationally_independent(line_number)
    return true

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:87 Web::CSS::GridTrackPlacement::Span::is_computationally_independent.
pub func css_grid_track_placement_span_is_computationally_independent(this: const CssGridTrackPlacementSpan*) -> bool:
    return css_style_value_is_computationally_independent(this.value)

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:90 Web::CSS::GridTrackPlacement::GridTrackPlacement.
pub func css_grid_track_placement_construct(this: CssGridTrackPlacement*):
    this.m_value = .css_grid_track_placement_auto(CssGridTrackPlacementAuto())

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:94 Web::CSS::GridTrackPlacement::GridTrackPlacement.
pub func css_grid_track_placement_construct_css_grid_track_placement_area_(this: CssGridTrackPlacement*, value: CssGridTrackPlacementAreaOrLine):
    this.m_value = .css_grid_track_placement_area_or_line(value)

## Ported from Libraries/LibWeb/CSS/GridTrackPlacement.h:98 Web::CSS::GridTrackPlacement::GridTrackPlacement.
pub func css_grid_track_placement_construct_css_grid_track_placement_span(this: CssGridTrackPlacement*, value: CssGridTrackPlacementSpan):
    this.m_value = .css_grid_track_placement_span(value)
