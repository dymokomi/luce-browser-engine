## Ported from Libraries/LibWeb/CSS/Selector.h:221 Web::CSS::Selector::contains_pseudo_class.
pub func css_selector_contains_pseudo_class(this: const CssSelector*, pseudo_class: css_data.PseudoClass) -> bool:
    return css_pseudo_class_bitmap_get(&this.m_contained_pseudo_classes, pseudo_class)

## Ported from Libraries/LibWeb/CSS/Selector.h:227 Web::CSS::Selector::ancestor_hashes.
pub func css_selector_ancestor_hashes(this: const CssSelector*) -> u32[8]:
