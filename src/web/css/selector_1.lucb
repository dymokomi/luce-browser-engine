#==============================================================================================
#
#   selector_1 - CSS::Selector: Selector.h's inline members, construction, the ancestor hashes
#                and specificity
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Selector.h's inline members (PseudoElementSelector's constructors
#       and accessors, SimpleSelector's value accessors, Selector::create and the accessors)
#       and LibWeb/CSS/Selector.cpp (lines 1-332): component_value_contains_nesting_selector,
#       can_selector_use_fast_matches, the constructor, collect_ancestor_hashes and
#       specificity.
#
#       A Selector is ref-counted in C++ (RefCounted<Selector>): here it is a managed blob made
#       with `new` (DESIGN.md §2.3, §3.3), passed as `CssSelector*`. The two caches that C++
#       declares `mutable` (m_specificity, m_sibling_invalidation_distance) are written through
#       a cast of the const receiver.
#
#       Copyright (c) 2018-2025, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2021-2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Selector::PseudoElementSelector (Selector.h) ============================================

## Ported from Libraries/LibWeb/CSS/Selector.h:37 Web::CSS::Selector::PseudoElementSelector::PseudoElementSelector.
pub func css_selector_pseudo_element_selector_construct_css_selector_pseudo_element_se(this: CssSelectorPseudoElementSelector*, type_: css_data.PseudoElement, value: CssSelectorPseudoElementSelectorValue = CssSelectorPseudoElementSelectorValue.empty):
    this.m_type = type_
    this.m_name = ak.string_new()
    this.m_value = value
    assert(css_selector_pseudo_element_selector_is_known_pseudo_element_type(type_))

## Ported from Libraries/LibWeb/CSS/Selector.h:44 Web::CSS::Selector::PseudoElementSelector::PseudoElementSelector.
pub func css_selector_pseudo_element_selector_construct_string(this: CssSelectorPseudoElementSelector*, type_: css_data.PseudoElement, name: ak.String, value: CssSelectorPseudoElementSelectorValue = CssSelectorPseudoElementSelectorValue.empty):
    this.m_type = type_
    this.m_name = name
    this.m_value = value

## Ported from Libraries/LibWeb/CSS/Selector.h:53 Web::CSS::Selector::PseudoElementSelector::is_known_pseudo_element_type.
pub func css_selector_pseudo_element_selector_is_known_pseudo_element_type(type_: css_data.PseudoElement) -> bool:
    return (u8)type_ < (u8)css_data.PseudoElement.known_pseudo_element_count

## Ported from Libraries/LibWeb/CSS/Selector.h:60 Web::CSS::Selector::PseudoElementSelector::type.
pub func css_selector_pseudo_element_selector_type(this: const CssSelectorPseudoElementSelector*) -> css_data.PseudoElement:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/Selector.h:62 Web::CSS::Selector::PseudoElementSelector::pt_name_selector.
pub func css_selector_pseudo_element_selector_pt_name_selector(this: const CssSelectorPseudoElementSelector*) -> CssSelectorPseudoElementSelectorPtNameSelector:
    match this.m_value:
        .css_selector_pseudo_element_selector_pt_name_selector(pt_name_selector): return pt_name_selector
        _: trap("VERIFY: PseudoElementSelector::pt_name_selector() on another alternative")

## Ported from Libraries/LibWeb/CSS/Selector.h:65 Web::CSS::Selector::PseudoElementSelector::compound_selector.
# NOTE: This can't (currently) be a CompoundSelector due to cyclic dependencies.
pub func css_selector_pseudo_element_selector_compound_selector(this: const CssSelectorPseudoElementSelector*) -> CssSelector*:
    match this.m_value:
        .css_selector(compound_selector): return compound_selector
        _: trap("VERIFY: PseudoElementSelector::compound_selector() on another alternative")

## Ported from Libraries/LibWeb/CSS/Selector.h:67 Web::CSS::Selector::PseudoElementSelector::ident_list.
pub func css_selector_pseudo_element_selector_ident_list(this: const CssSelectorPseudoElementSelector*) -> ak.Vector[ak.FlyString]:
    match this.m_value:
        .vector_fly_string(ident_list): return ident_list
        _: trap("VERIFY: PseudoElementSelector::ident_list() on another alternative")

