# mark: Selector (Selector.h) ===================================================================

## Ported from Libraries/LibWeb/CSS/Selector.h:210 Web::CSS::Selector::create.
pub func css_selector_create(compound_selectors: ak.Vector[CssSelectorCompoundSelector]) -> CssSelector*:
    let selector = new CssSelector else trap("out of memory")
    css_selector_construct(selector, compound_selectors)
    return selector

## Ported from Libraries/LibWeb/CSS/Selector.h:217 Web::CSS::Selector::compound_selectors.
pub func css_selector_compound_selectors(this: const CssSelector*) -> ak.Vector[CssSelectorCompoundSelector]:
    return this.m_compound_selectors

## Ported from Libraries/LibWeb/CSS/Selector.h:218 Web::CSS::Selector::target_pseudo_element.
pub func css_selector_target_pseudo_element(this: const CssSelector*) -> CssSelectorPseudoElementSelector?:
    return this.m_target_pseudo_element

## Ported from Libraries/LibWeb/CSS/Selector.h:220 Web::CSS::Selector::contains_the_nesting_selector.
pub func css_selector_contains_the_nesting_selector(this: const CssSelector*) -> bool:
