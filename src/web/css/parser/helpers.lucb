# mark: The internal CSS realm ==================================================================

## `static GC::Root<JS::Realm> realm` of internal_css_realm().
var internal_css_realm_s_realm: gc.Root[Realm]

## `static GC::Root<HTML::Window> window` of internal_css_realm().
var internal_css_realm_s_window: gc.Root[HtmlWindow]

## `static OwnPtr<JS::ExecutionContext> execution_context` of internal_css_realm().
var internal_css_realm_s_execution_context: JsExecutionContext*?

## The first customization of internal_css_realm's realm: a new Window as the global object.
func internal_css_realm_create_global_object(context: void*?, realm: Realm*) -> JsObject*?:
    discard(context)
    internal_css_realm_s_window = gc.root_create(html_window_create(realm))
    return (JsObject*?)gc.root_cell(&internal_css_realm_s_window)

## The second customization: the same Window as the global this value.
func internal_css_realm_create_global_this_value(context: void*?, realm: Realm*) -> JsObject*?:
    discard(context)
    discard(realm)
    return (JsObject*?)gc.root_cell(&internal_css_realm_s_window)

## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:24 Web::internal_css_realm.
pub func internal_css_realm() -> Realm*:
    if gc.root_is_null(&internal_css_realm_s_realm):
        internal_css_realm_s_execution_context = bind_create_a_new_javascript_realm(
            bind_main_thread_vm(),
            ak.Function1[Realm*, JsObject*?](call = internal_css_realm_create_global_object, context = none),
            ak.Function1[Realm*, JsObject*?](call = internal_css_realm_create_global_this_value, context = none),
        )

        let execution_context = internal_css_realm_s_execution_context else trap("VERIFY: an execution context")
        let realm = execution_context.realm else trap("VERIFY: the execution context has a realm")
        internal_css_realm_s_realm = gc.root_create(realm)
        let intrinsics = realm_create_bind_intrinsics(realm, realm)
        let host_defined = bind_host_defined_create(intrinsics)
        realm_set_host_defined(realm, host_defined)
    return gc.root_cell(&internal_css_realm_s_realm) else trap("VERIFY: the internal CSS realm")

# mark: Parsing entry points ====================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:48 Web::parse_css_stylesheet.
pub func parse_css_stylesheet(context: CssParsingParams, css: ak.StringView, location: web_url.Url? = none, media_list: CssMediaList*? = none) -> CssCssStyleSheet*:
    let realm = context.realm else trap("VERIFY: the parsing params have a realm")
    if ak.string_view_is_empty(&css):
        let no_rules = ak.Vector[CssRule*]()
        let rule_list = css_rule_list_create(realm, ak.vector_span_const(&no_rules))
        var media = media_list
        if media == none:
            media = css_media_list_create(realm, ak.Vector[CssMediaQuery*]())
        let style_sheet = css_css_style_sheet_create(realm, rule_list, media else trap("VERIFY: a media list"), location)
        css_css_style_sheet_set_source_text(style_sheet, ak.string_new())
        return style_sheet
    var parser = css_parser_create(context, css)
    let style_sheet = css_parser_parse_as_css_stylesheet(&parser, location, media_list)
    # FIXME: Avoid this copy
    css_css_style_sheet_set_source_text(style_sheet, ak.string_from_utf8(css) else trap("MUST: String::from_utf8"))
    return style_sheet

## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:64 Web::parse_css_property_declaration_block.
pub func parse_css_property_declaration_block(context: CssParsingParams, css: ak.StringView) -> CssParserPropertiesAndCustomProperties:
    if ak.string_view_is_empty(&css):
        return CssParserPropertiesAndCustomProperties()
    var parser = css_parser_create(context, css)
    return css_parser_parse_as_property_declaration_block(&parser)

