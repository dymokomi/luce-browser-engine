## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:109 Web::parse_selector_for_nested_style_rule.
pub func parse_selector_for_nested_style_rule(context: CssParsingParams, selector_text: ak.StringView) -> ak.Vector[CssSelector*]?:
    var parser = css_parser_create(context, selector_text)

    let maybe_selectors = css_parser_parse_as_relative_selector(&parser, CssParserSelectorParsingMode.standard)
    let selectors = maybe_selectors else return none

    return css_adapt_nested_relative_selector_list(selectors)

