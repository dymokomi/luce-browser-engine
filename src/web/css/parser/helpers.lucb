# mark: CSS decode bytes ========================================================================

## The `check_stylesheets_byte_stream` lambda of determine_the_fallback_encoding: 2. of
## https://drafts.csswg.org/css-syntax/#determine-the-fallback-encoding
func css_check_stylesheets_byte_stream(encoded_string: const ak.ByteBuffer*) -> ak.StringView?:
    let scan_length = ak.min(ak.byte_buffer_size(encoded_string), 1024)
    let pattern_start = ak.sv("@charset \"")
    let pattern_end = ak.sv("\";")

    if scan_length < ak.string_view_length(&pattern_start):
        return none

    let buffer_view = ak.string_view_from_bytes(ak.byte_buffer_bytes_const(encoded_string)[0..<scan_length])
    if not ak.string_view_starts_with_string_view(&buffer_view, pattern_start):
        return none

    let encoding_start = ak.string_view_length(&pattern_start)
    let end_index = ak.string_view_find_string_view(&buffer_view, pattern_end, encoding_start) else return none

    let encoding_length = end_index - encoding_start
    let encoding_view = ak.string_view_substring_view_usize(&buffer_view, encoding_start, encoding_length)

    for byte in ak.string_view_bytes(&encoding_view):
        if (byte < 0x01 or byte > 0x21) and (byte < 0x23 or byte > 0x7F):
            return none

    return text_codec.get_standardized_encoding(encoding_view)

## The `determine_the_fallback_encoding` lambda of css_decode_bytes.
# https://drafts.csswg.org/css-syntax/#determine-the-fallback-encoding
func css_determine_the_fallback_encoding(environment_encoding: ak.StringView?, mime_type_charset: ak.String?, encoded_string: const ak.ByteBuffer*) -> ak.StringView:
    # 1. If HTTP or equivalent protocol provides an encoding label (e.g. via the charset parameter of the Content-Type header) for the stylesheet,
    #    get an encoding from encoding label. If that does not return failure, return it.
    if let charset = mime_type_charset:
        if let encoding = text_codec.get_standardized_encoding(ak.string_bytes_as_string_view(&charset)):
            return encoding
    # 2. Otherwise, check stylesheet’s byte stream. If the first 1024 bytes of the stream begin with the hex sequence
    # 40 63 68 61 72 73 65 74 20 22 XX* 22 3B
    # where each XX byte is a value between 0x16 and 0x21 inclusive or a value between 0x23 and 0x7F inclusive,
    # then get an encoding from a string formed out of the sequence of XX bytes, interpreted as ASCII.
    # If the return value was utf-16be or utf-16le, return utf-8; if it was anything else except failure, return it.
    if let byte_stream_value = css_check_stylesheets_byte_stream(encoded_string):
        if ak.string_view_equals(&byte_stream_value, "UTF-16BE") or ak.string_view_equals(&byte_stream_value, "UTF-16LE"):
            return ak.sv("utf-8")
        return byte_stream_value

    # 3. Otherwise, if an environment encoding is provided by the referring document, return it.
    if let encoding = environment_encoding:
        return encoding

    # 4. Otherwise, return utf-8.
    return ak.sv("utf-8")

## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:153 Web::css_decode_bytes.
# https://drafts.csswg.org/css-syntax/#css-decode-bytes
pub func css_decode_bytes(environment_encoding: ak.StringView?, mime_type_charset: ak.String?, encoded_string: const ak.ByteBuffer*) -> ak.String!:
    # 1. Determine the fallback encoding of stylesheet, and let fallback be the result.
    let fallback = css_determine_the_fallback_encoding(environment_encoding, mime_type_charset, encoded_string)
    if let decoder = text_codec.decoder_for(fallback):
        # 2. Decode stylesheet’s stream of bytes with fallback encoding fallback, and return the result.
        return try text_codec.convert_input_to_utf8_using_given_decoder_unless_there_is_a_byte_order_mark(decoder, ak.string_view_from_bytes(ak.byte_buffer_bytes_const(encoded_string)))
    # If we don't support the encoding yet, let's error out instead of trying to decode it as something it's most likely not.
    ak.dbgln(f"FIXME: Style sheet encoding '{ak.string_view_text(fallback)}' is not supported yet")
    error(ak.ak_error, "No Decoder found")

# mark: <custom-ident> ==========================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Helpers.cpp:224 Web::is_valid_custom_ident.
# https://drafts.csswg.org/css-values-4/#identifier-value
pub func is_valid_custom_ident(ident: ak.FlyString, blacklist: const ak.StringView[]) -> bool:
    # The CSS-wide keywords are not valid <custom-ident>s.
    if css_data.is_css_wide_keyword(ak.fly_string_bytes_as_string_view(&ident)):
        return false

    # The default keyword is reserved and is also not a valid <custom-ident>.
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&ident, ak.sv("default")):
        return false

    # Specifications using <custom-ident> must specify clearly what other keywords are excluded from <custom-ident>,
    # if any—for example by saying that any pre-defined keywords in that property’s value definition are excluded.
    # Excluded keywords are excluded in all ASCII case permutations.
    for value in blacklist:
        if ak.fly_string_equals_ignoring_ascii_case_string_view(&ident, value):
            return false

    return true
