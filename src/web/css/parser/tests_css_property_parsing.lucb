#==============================================================================================
#
#   tests_css_property_parsing - tests of property parsing, the arbitrary substitution
#                                functions and the generated property data
#
#   DESCRIPTION:
#       Ladybird has no unit tests for PropertyParsing.cpp, ArbitrarySubstitutionFunctions.cpp
#       or the value-dependent part of the generated PropertyID.cpp. The oracle cases
#       (tests_css_property_parsing_cases) run the reference build on the same inputs
#       (luce-browser-tools, oracles/luce-browser-engine/css_property_parsing); the test below
#       runs each through the port and compares the output: every property's accepted value
#       types, numeric ranges, percentage basis and range checks, every environment variable's
#       value type, every initial value, parse_css_value (longhands, shorthand expansion, the
#       special-cased properties and their errors), parse_css_value_for_properties, the
#       arbitrary substitution function names and their argument grammars. The focused tests
#       after it cover substitution contexts and the substitution of values without an element.
#
#==============================================================================================

# mark: The oracle cases ========================================================================

## The parsing parameters of the cases: the realm only, as the oracle's internal CSS realm.
func test_css_property_parsing_params(realm: Realm*) -> CssParsingParams:
    var params: CssParsingParams = ---
    css_parsing_params_construct_realm_css_parsing_mode(&params, realm)
    return params

## Append `text` to `out`, indented by `indent` levels of two spaces, and a line feed (the oracle's `line`).
func test_property_line(out: ak.StringBuilder*, indent: i32, text: ak.StringView):
    for _ in 0..<indent:
        ak.string_builder_append(out, "  ")
    ak.string_builder_append_string_view(out, text)
    ak.string_builder_append_u8(out, '\n')

## The oracle's `d`: a double as AK formats it with `{}`.
func test_property_double(builder: ak.StringBuilder*, value: f64):
    css_appendff(builder, "{}", [ak.arg_f64(value)])

## The type's snake-case name, as ENUMERATE_CSS_STYLE_VALUE_TYPES spells it (every type).
