        .anchor: return "anchor"
        .anchor_size: return "anchor_size"
        .angle: return "angle"
        .background_size: return "background_size"
        .basic_shape: return "basic_shape"
        .border_image_slice: return "border_image_slice"
        .border_radius: return "border_radius"
        .border_radius_rect: return "border_radius_rect"
        .calculated: return "calculated"
        .color_interpolation_method: return "color_interpolation_method"
        .color_scheme: return "color_scheme"
        .color: return "color"
        .conic_gradient: return "conic_gradient"
        .content: return "content"
        .counter: return "counter"
        .counter_style: return "counter_style"
        .counter_definitions: return "counter_definitions"
        .counter_style_system: return "counter_style_system"
        .cursor: return "cursor"
        .custom_ident: return "custom_ident"
        .display: return "display"
        .easing: return "easing"
        .edge: return "edge"
        .filter_value_list: return "filter_value_list"
        .function: return "function"
        .flex: return "flex"
        .font_source: return "font_source"
        .font_style: return "font_style"
        .frequency: return "frequency"
        .grid_auto_flow: return "grid_auto_flow"
        .grid_template_area: return "grid_template_area"
        .grid_track_placement: return "grid_track_placement"
        .grid_track_size_list: return "grid_track_size_list"
        .guaranteed_invalid: return "guaranteed_invalid"
        .image: return "image"
        .image_set: return "image_set"
        .integer: return "integer"
        .keyword: return "keyword"
        .length: return "length"
        .linear_gradient: return "linear_gradient"
        .number: return "number"
        .opacity_value: return "opacity_value"
        .open_type_tagged: return "open_type_tagged"
        .pending_substitution: return "pending_substitution"
        .percentage: return "percentage"
        .position: return "position"
        .radial_gradient: return "radial_gradient"
        .radial_size: return "radial_size"
        .random_value_sharing: return "random_value_sharing"
        .ratio: return "ratio"
        .rect: return "rect"
        .repeat_style: return "repeat_style"
        .resolution: return "resolution"
        .scrollbar_color: return "scrollbar_color"
