## The `parse_zero_or_more_fixed_tracks` lambda of parse_grid_auto_track_list: the number of tracks it parsed.
func css_parser_parse_zero_or_more_fixed_tracks(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*, track_list: CssGridTrackSizeList*) -> usize:
    return css_parser_parse_track_list_impl(this, tokens, track_list, css_grid_track_parser(this, css_parser_parse_auto_track_list_fixed_track))

## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:4801 Web::CSS::Parser::Parser::parse_grid_auto_track_list.
# https://www.w3.org/TR/css-grid-2/#typedef-auto-track-list
pub func css_parser_parse_grid_auto_track_list(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssGridTrackSizeList:
    # <auto-track-list> = [ <line-names>? [ <fixed-size> | <fixed-repeat> ] ]* <line-names>? <auto-repeat>
    #                     [ <line-names>? [ <fixed-size> | <fixed-repeat> ] ]* <line-names>?

    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    var track_list = CssGridTrackSizeList()
    var parsed_track_count: usize = 0

    parsed_track_count += css_parser_parse_zero_or_more_fixed_tracks(this, tokens, &track_list)
    css_syntax.token_stream_discard_whitespace(tokens)
    if not css_syntax.token_stream_has_next_token(tokens):
        if parsed_track_count == 0:
            return CssGridTrackSizeList()
        css_syntax.state_transaction_commit(&transaction)
        return track_list

    if let auto_repeat = css_parser_parse_grid_auto_repeat(this, tokens):
        css_grid_track_size_list_append_css_explicit_grid_track(&track_list, css_explicit_grid_track_new(CssGridRepeatOrCssGridMinMaxOrCssGridSize.css_grid_repeat(auto_repeat)))
    else:
        return CssGridTrackSizeList()

    parsed_track_count += css_parser_parse_zero_or_more_fixed_tracks(this, tokens, &track_list)
    css_syntax.state_transaction_commit(&transaction)
    return track_list

