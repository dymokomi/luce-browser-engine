# mark: <grid-line> =============================================================================

## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:4855 Web::CSS::Parser::Parser::parse_grid_track_placement.
pub func css_parser_parse_grid_track_placement(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssGridTrackPlacementStyleValue*?:
    # https://www.w3.org/TR/css-grid-2/#line-placement
    # Line-based Placement: the grid-row-start, grid-column-start, grid-row-end, and grid-column-end properties
    # <grid-line> =
    #     auto |
    #     <custom-ident> |
    #     [ [ <integer [-∞,-1]> | <integer [1,∞]> ] && <custom-ident>? ] |
    #     [ span && [ <integer [1,∞]> || <custom-ident> ] ]
    var is_span = false
    var parsed_custom_ident: ak.String? = none
    var parsed_integer: CssStyleValue*? = none

    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    css_syntax.token_stream_discard_whitespace(tokens)

    if css_parser_parse_all_as_single_keyword_value(this, tokens, css_data.Keyword.auto) != none:
        css_syntax.state_transaction_commit(&transaction)
        return css_grid_track_placement_style_value_create(css_grid_track_placement_make_auto())

    while css_syntax.token_stream_has_next_token(tokens):
        if css_next_token_is_ident(tokens, "span"):
            if is_span:
                return none

            css_syntax.token_stream_discard_a_token(tokens)  # span

            # NOTE: "span" must not appear in between <custom-ident> and <integer>
            if css_syntax.token_stream_has_next_token(tokens) and (parsed_custom_ident != none or parsed_integer != none):
                return none

            is_span = true
            css_syntax.token_stream_discard_whitespace(tokens)
            continue

        let blacklist: ak.StringView[1] = [ak.sv("auto")]
        if let maybe_parsed_custom_ident = css_parser_parse_custom_ident(this, tokens, blacklist):
            if parsed_custom_ident != none:
                return none

            parsed_custom_ident = ak.fly_string_to_string_const(&maybe_parsed_custom_ident)
            css_syntax.token_stream_discard_whitespace(tokens)
            continue

        # FIXME: Use the correct value parsing context here to clamp calculated values (note the non-contiguous valid
        #        range for integers for non-span)
        if let maybe_parsed_integer = css_parser_parse_integer_value(this, tokens, css_infinite_integer_range):
            if parsed_integer != none:
                return none

            parsed_integer = maybe_parsed_integer
            css_syntax.token_stream_discard_whitespace(tokens)
            continue

        return none

    css_syntax.state_transaction_commit(&transaction)

    # <custom-ident>
    # [ [ <integer [-∞,-1]> | <integer [1,∞]> ] && <custom-ident>? ]
    if not is_span and (parsed_integer != none or parsed_custom_ident != none) and css_grid_placement_integer_is(parsed_integer, false):
        return css_grid_track_placement_style_value_create(css_grid_track_placement_make_line(parsed_integer, parsed_custom_ident))

    # [ span && [ <integer [1,∞]> || <custom-ident> ] ]
    if is_span and (parsed_integer != none or parsed_custom_ident != none) and css_grid_placement_integer_is(parsed_integer, true):
        # If the <integer> is omitted, it defaults to 1.
        let span_value = parsed_integer else css_integer_style_value_create(1).css_style_value()
        return css_grid_track_placement_style_value_create(css_grid_track_placement_make_span(span_value, parsed_custom_ident))

    return none

## `!parsed_integer || !parsed_integer->is_integer() || parsed_integer->as_integer().integer() != 0` (`> 0` when
## `positive`) of parse_grid_track_placement.
func css_grid_placement_integer_is(parsed_integer: CssStyleValue*?, positive: bool) -> bool:
    let integer = parsed_integer else return true
    if not css_style_value_is_integer(integer):
        return true
    let value = css_integer_style_value_integer(css_style_value_as_integer(integer))
    if positive:
        return value > 0
    return value != 0
