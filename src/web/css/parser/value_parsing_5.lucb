## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:2623 Web::CSS::Parser::Parser::parse_ratio_value.
# https://drafts.csswg.org/css-values-4/#ratios
pub func css_parser_parse_ratio_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <ratio> = <number [0,∞]> [ / <number [0,∞]> ]?
    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)

    css_syntax.token_stream_discard_whitespace(tokens)

    let numerator = css_parser_parse_number_value(this, tokens, css_non_negative_range) else return none

    css_syntax.token_stream_discard_whitespace(tokens)

    if css_next_token_is_delim(tokens, (u32)'/'):
        css_syntax.token_stream_discard_a_token(tokens)
        css_syntax.token_stream_discard_whitespace(tokens)

        let denominator = css_parser_parse_number_value(this, tokens, css_non_negative_range) else return none

        css_syntax.state_transaction_commit(&transaction)
        return css_ratio_style_value_create(numerator, denominator).css_style_value()

    css_syntax.state_transaction_commit(&transaction)
    # The second <number> is optional, defaulting to 1.
    return css_ratio_style_value_create(numerator, css_number_style_value_create(1.0).css_style_value()).css_style_value()

## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:2654 Web::CSS::Parser::Parser::parse_string_value.
pub func css_parser_parse_string_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStringStyleValue*?:
    _ = this
    css_syntax.token_stream_discard_whitespace(tokens)
    let peek = css_syntax.token_stream_next_token(tokens)
    if css_syntax.component_value_is(&peek, .string):
        css_syntax.token_stream_discard_a_token(tokens)
        let token = css_syntax.component_value_token(&peek)
        return css_string_style_value_create(css_syntax.token_string(&token))

    return none
