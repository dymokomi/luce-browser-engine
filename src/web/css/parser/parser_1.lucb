## Ported from Libraries/LibWeb/CSS/Parser/Parser.cpp:38 log_parse_error.
func log_parse_error(location: io.Location = luce.location):
    if css_parser_debug:
        ak.dbgln(f"Parse error (CSS) {location.function} @ {location.file}:{location.line}")

## The ParseError of Parser.h's `ParseErrorOr<T>`, as the code of the failure.
pub let css_parser_parse_error_includes_ignored_vendor_prefix: ErrorCode = ErrorCode.package(3)

## ParseError::SyntaxError.
pub let css_parser_parse_error_syntax_error: ErrorCode = ErrorCode.package(4)

# mark: Component value helpers =================================================================

## `value.is_block() && value.block().is_paren()`.
func css_component_value_is_paren_block(value: const css_syntax.ComponentValue*) -> bool:
    if not css_syntax.component_value_is_block(value):
        return false
    let block = css_syntax.component_value_block(value)
    return css_syntax.simple_block_is_paren(&block)

## `value.token().ident()`.
func css_component_value_ident(value: const css_syntax.ComponentValue*) -> ak.FlyString:
    let token = css_syntax.component_value_token(value)
    return css_syntax.token_ident(&token)

## `value.token().type()`.
func css_component_value_token_type(value: const css_syntax.ComponentValue*) -> css_syntax.TokenType:
    let token = css_syntax.component_value_token(value)
    return css_syntax.token_type(&token)

