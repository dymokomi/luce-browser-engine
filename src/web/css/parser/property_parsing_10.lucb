# mark: position-anchor and position-try-fallbacks ==============================================

## Ported from Libraries/LibWeb/CSS/Parser/PropertyParsing.cpp:3508 Web::CSS::Parser::Parser::parse_position_anchor_value.
# https://drafts.csswg.org/css-anchor-position/#position-anchor
pub func css_parser_parse_position_anchor_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # normal | none | auto | <anchor-name>
    if let keyword = css_parser_parse_all_as_single_keyword_value(this, tokens, css_data.Keyword.normal):
        return keyword
    if let keyword = css_parser_parse_all_as_single_keyword_value(this, tokens, css_data.Keyword.none_):
        return keyword
    if let keyword = css_parser_parse_all_as_single_keyword_value(this, tokens, css_data.Keyword.auto):
        return keyword

    # <anchor-name> = <dashed-ident>
    return (CssStyleValue*?)css_parser_parse_dashed_ident_value(this, tokens)

## `[&](auto& inner_tokens) { return parse_single_position_try_fallbacks_value(inner_tokens); }` (the context is the
## parser).
func css_parser_parse_single_position_try_fallbacks_callback(context: void*?, inner_tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    let this = (CssParser*)(context else trap("no parser"))
    return css_parser_parse_single_position_try_fallbacks_value(this, inner_tokens)

## Ported from Libraries/LibWeb/CSS/Parser/PropertyParsing.cpp:3523 Web::CSS::Parser::Parser::parse_position_try_fallbacks_value.
# https://drafts.csswg.org/css-anchor-position/#position-try-fallbacks
pub func css_parser_parse_position_try_fallbacks_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # none | [ [<dashed-ident> || <try-tactic>] | <position-area> ]#

    if let none_ = css_parser_parse_all_as_single_keyword_value(this, tokens, css_data.Keyword.none_):
        return none_

    return css_parser_parse_comma_separated_values(this, tokens, css_parser_parse_single_position_try_fallbacks_callback)

## Ported from Libraries/LibWeb/CSS/Parser/PropertyParsing.cpp:3535 Web::CSS::Parser::Parser::parse_single_position_try_fallbacks_value.
pub func css_parser_parse_single_position_try_fallbacks_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # [<dashed-ident> || <try-tactic>] | <position-area>
    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    css_syntax.token_stream_discard_whitespace(tokens)

    if let position_area = css_parser_parse_position_area(this, tokens):
        css_syntax.state_transaction_commit(&transaction)
        return position_area

    var dashed_ident: CssStyleValue*? = none
    var try_tactic: CssStyleValue*? = none
    while css_syntax.token_stream_has_next_token(tokens):
        if let try_tactic_value = css_parser_parse_try_tactic_value(this, tokens):
            if try_tactic != none:
                return none
            try_tactic = try_tactic_value
        elif let maybe_dashed_ident = css_parser_parse_dashed_ident_value(this, tokens):
            if dashed_ident != none:
                return none
            dashed_ident = maybe_dashed_ident.css_style_value()
        else:
            break
        css_syntax.token_stream_discard_whitespace(tokens)

    var values = ak.Vector[CssStyleValue*]()
    if let ident = dashed_ident:
        ak.vector_append_t(&values, ident)
    if let tactic = try_tactic:
        ak.vector_append_t(&values, tactic)

    if ak.vector_is_empty(&values):
        return none

    css_syntax.state_transaction_commit(&transaction)
    return css_style_value_list_of(values, CssStyleValueListSeparator.space)

## Ported from Libraries/LibWeb/CSS/Parser/PropertyParsing.cpp:3577 Web::CSS::Parser::Parser::parse_try_tactic_value.
# https://drafts.csswg.org/css-anchor-position-1/#typedef-position-try-fallbacks-try-tactic
pub func css_parser_parse_try_tactic_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # <try-tactic> = flip-block || flip-inline || flip-start
    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    css_syntax.token_stream_discard_whitespace(tokens)
    var values = ak.Vector[CssStyleValue*]()
    var has_flip_block = false
    var has_flip_inline = false
    var has_flip_start = false
    while css_syntax.token_stream_has_next_token(tokens):
        let keyword_value = css_parser_parse_keyword_value(this, tokens) else break
        match css_style_value_to_keyword(keyword_value):
            .flip_block:
                if has_flip_block:
                    return none
                has_flip_block = true
                ak.vector_append_t(&values, keyword_value)
            .flip_inline:
                if has_flip_inline:
                    return none
                has_flip_inline = true
                ak.vector_append_t(&values, keyword_value)
            .flip_start:
                if has_flip_start:
                    return none
                has_flip_start = true
                ak.vector_append_t(&values, keyword_value)
            _:
                return none
        css_syntax.token_stream_discard_whitespace(tokens)

    css_syntax.state_transaction_commit(&transaction)
    if ak.vector_is_empty(&values):
        return none
    return css_style_value_list_of(values, CssStyleValueListSeparator.space)
