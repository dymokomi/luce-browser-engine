#==============================================================================================
#
#   tests_css_rule_parsing_cases - the rule, selector, media and syntax parsing cases pinned
#                                  to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's CSS::Parser on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/css_rule_parsing: cases.txt, oracle.cpp, gen_luce_cases.py).
#       tests_css_rule_parsing runs each case through the port and compares the dumps.
#
#==============================================================================================

## One oracle case: what to run, on what input, and the reference build's dump.
struct TestCssRuleParsingCase:
    let mode: str
    let input: str
    let expected: str

## Every oracle case, in cases.txt order.
let test_css_rule_parsing_cases: TestCssRuleParsingCase[279] = [
    TestCssRuleParsingCase(mode = "syntax", input = "*", expected = "  Universal\n  to_string: *\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "  *  ", expected = "  Universal\n  to_string: *\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "* foo", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo", expected = "  Ident: foo\n  to_string: foo\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo | bar", expected = "  Alternatives:\n    Ident: foo\n    Ident: bar\n  to_string: foo | bar\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo+ | bar# | baz", expected = "  Alternatives:\n    Multiplier:\n      Ident: foo\n    CommaSeparatedMultiplier:\n      Ident: bar\n    Ident: baz\n  to_string: foo+ | bar# | baz\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "\"foo | bar+\"", expected = "  Alternatives:\n    Ident: foo\n    Multiplier:\n      Ident: bar\n  to_string: foo | bar+\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "\"*\"", expected = "  Universal\n  to_string: *\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo bar", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo |", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "| foo", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "foo || bar", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "<bogus>", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "<length", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "1px", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "auto | Inherit", expected = "  Alternatives:\n    Ident: auto\n    Ident: Inherit\n  to_string: auto | Inherit\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "\"x\" y", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntax", input = "", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntaxcustom", input = "foo | bar", expected = "  Alternatives:\n    Ident: foo\n    Ident: bar\n  to_string: foo | bar\n"),
    TestCssRuleParsingCase(mode = "syntaxcustom", input = "inherit", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntaxcustom", input = "default", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntaxcustom", input = "foo | initial", expected = "  none\n"),
    TestCssRuleParsingCase(mode = "syntaxcustom", input = "\"auto+\"", expected = "  Multiplier:\n    Ident: auto\n  to_string: auto+\n"),
    TestCssRuleParsingCase(mode = "compound", input = "div", expected = "  combinator None\n    TagName ns=0 ns_name='' name='div' lower='div'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "DiV.Foo#Bar", expected = "  combinator None\n    TagName ns=0 ns_name='' name='DiV' lower='div'\n    Class name='Foo' lower='foo'\n    Id name='Bar' lower='bar'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "*.a", expected = "  combinator None\n    Universal ns=0 ns_name='' name='*' lower='*'\n    Class name='a' lower='a'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "svg|rect", expected = "  combinator None\n    TagName ns=3 ns_name='svg' name='rect' lower='rect'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "*|*", expected = "  combinator None\n    Universal ns=2 ns_name='*' name='*' lower='*'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "|p", expected = "  combinator None\n    TagName ns=1 ns_name='' name='p' lower='p'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "html|p", expected = "  error SyntaxError\n  rest: 2\n  error: style selector `html|p` is invalid: Invalid start of a simple selector: Token: Ident(value=\"html\", source=\"html\", start=0:0, end=0:4) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "*|p.x", expected = "  combinator None\n    TagName ns=2 ns_name='*' name='p' lower='p'\n    Class name='x' lower='x'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ".a.b.c", expected = "  combinator None\n    Class name='a' lower='a'\n    Class name='b' lower='b'\n    Class name='c' lower='c'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "#id", expected = "  combinator None\n    Id name='id' lower='id'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "#1a", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `#1a` is invalid: Hash token is not an id: Token: Hash(value=\"1a\", hash_type=Unrestricted, source=\"#1a\", start=0:0, end=0:3) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ".", expected = "  error SyntaxError\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ".1", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `0.1` is invalid: Invalid start of a simple selector: Token: Number(value=0.1, number_type=Number, source=\".1\", start=0:0, end=0:2) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "&", expected = "  combinator None\n    Nesting\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "&.a", expected = "  combinator None\n    Nesting\n    Class name='a' lower='a'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a b", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a>b", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a+b", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a~b", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a|", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 1\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a!", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `a!` is invalid: Unrecognized delimiter: ! (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "div.a span", expected = "  combinator None\n    TagName ns=0 ns_name='' name='div' lower='div'\n    Class name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = ".a div", expected = "  combinator None\n    Class name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x]", expected = "  combinator None\n    Attribute match=0 case=0 ns=0 ns_name='' name='x' lower='x' value=''\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[ x ]", expected = "  combinator None\n    Attribute match=0 case=0 ns=0 ns_name='' name='x' lower='x' value=''\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y]", expected = "  combinator None\n    Attribute match=1 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=\"y z\"]", expected = "  combinator None\n    Attribute match=1 case=0 ns=0 ns_name='' name='x' lower='x' value='y z'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x~=y]", expected = "  combinator None\n    Attribute match=2 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x*=y]", expected = "  combinator None\n    Attribute match=3 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x|=y]", expected = "  combinator None\n    Attribute match=4 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x^=y]", expected = "  combinator None\n    Attribute match=5 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x$=y]", expected = "  combinator None\n    Attribute match=6 case=0 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y i]", expected = "  combinator None\n    Attribute match=1 case=2 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y S]", expected = "  combinator None\n    Attribute match=1 case=1 ns=0 ns_name='' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[svg|x=y]", expected = "  combinator None\n    Attribute match=1 case=0 ns=3 ns_name='svg' name='x' lower='x' value='y'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[*|x]", expected = "  combinator None\n    Attribute match=0 case=0 ns=2 ns_name='*' name='x' lower='x' value=''\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[|x]", expected = "  combinator None\n    Attribute match=0 case=0 ns=1 ns_name='' name='x' lower='x' value=''\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[]` is invalid: Attribute selector is empty. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[*]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[*]` is invalid: Expected qualified-name, got: 'Token: Delim(value=\"*\", code_point=U+002A, source=\"*\", start=0:1, end=0:2)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[1]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[1]` is invalid: Expected qualified-name, got: 'Token: Number(value=1, number_type=Integer, source=\"1\", start=0:1, end=0:2)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x=]` is invalid: Attribute selector ended without a value to match. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x~]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x~]` is invalid: Attribute selector ended part way through a match type. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x!=y]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x!=y]` is invalid: Invalid attribute selector match type `!=` (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x~~y]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x~~y]` is invalid: Expected a double delim for attribute comparison, got: 'Token: Delim(value=\"~\", code_point=U+007E, source=\"~\", start=0:2, end=0:3)Token: Delim(value=\"~\", code_point=U+007E, source=\"~\", start=0:3, end=0:4)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=1]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x=1]` is invalid: Expected a string or ident for the value to match attribute against, got: 'Token: Number(value=1, number_type=Integer, source=\"1\", start=0:3, end=0:4)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y z]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x=y z]` is invalid: Expected a \"i\" or \"s\" attribute selector case sensitivity identifier, got: 'Token: Ident(value=\"z\", source=\"z\", start=0:5, end=0:6)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y 1]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x=y 1]` is invalid: Expected an attribute selector case sensitivity identifier, got: 'Token: Number(value=1, number_type=Integer, source=\"1\", start=0:5, end=0:6)' (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x=y i j]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x=y i j]` is invalid: Trailing tokens in attribute selector. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "[x 1]", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `[x 1]` is invalid: Expected delim for attribute comparison, got: 'Token: Number(value=1, number_type=Integer, source=\"1\", start=0:3, end=0:4)'. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":hover", expected = "  combinator None\n    PseudoClass hover anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":HOVER", expected = "  combinator None\n    PseudoClass hover anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a:hover:focus", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n    PseudoClass hover anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n    PseudoClass focus anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":root.x", expected = "  combinator None\n    PseudoClass root anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n    Class name='x' lower='x'\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":foo", expected = "  error SyntaxError\n  rest: 0\n  error: Unknown pseudo class or element ':foo' in style selector. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":-webkit-foo", expected = "  error IncludesIgnoredVendorPrefix\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":-moz-foo", expected = "  error IncludesIgnoredVendorPrefix\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ": hover", expected = "  error SyntaxError\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":", expected = "  error SyntaxError\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child(2n+1)", expected = "  combinator None\n    PseudoClass nth-child anb=2,1 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child(odd)", expected = "  combinator None\n    PseudoClass nth-child anb=2,1 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child( even )", expected = "  combinator None\n    PseudoClass nth-child anb=2,0 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-of-type(3)", expected = "  combinator None\n    PseudoClass nth-of-type anb=0,3 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-last-child(-n+3)", expected = "  combinator None\n    PseudoClass nth-last-child anb=-1,3 forgiving=0 args=0 langs=[] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child(foo)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':nth-child' value `foo` is invalid: Invalid An+B format. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-of-type(2n of a)", expected = "  error SyntaxError\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child(2n+1 bar)", expected = "  error SyntaxError\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child()", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':nth-child' value `nth-child` is invalid: Missing arguments. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":lang(en)", expected = "  combinator None\n    PseudoClass lang anb=0,0 forgiving=0 args=0 langs=[en] ident=- levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":lang(en, \"fr-CA\", de-*)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':lang' value `lang` is invalid: Failed to parse argument as a language range: Has trailing tokens. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":lang(1)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':lang' value `lang` is invalid: Failed to parse argument as a language range: Not a string/ident. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":lang(en fr)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':lang' value `lang` is invalid: Failed to parse argument as a language range: Has trailing tokens. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":dir(ltr)", expected = "  combinator None\n    PseudoClass dir anb=0,0 forgiving=0 args=0 langs=[] ident=ltr/ltr levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":dir(rtl)", expected = "  combinator None\n    PseudoClass dir anb=0,0 forgiving=0 args=0 langs=[] ident=rtl/rtl levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":dir(Sideways)", expected = "  combinator None\n    PseudoClass dir anb=0,0 forgiving=0 args=0 langs=[] ident=(invalid CSS::Keyword)/Sideways levels=[]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":dir(ltr x)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':dir' value `dir` is invalid: Failed to parse argument as an ident. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":dir(1)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':dir' value `dir` is invalid: Failed to parse argument as an ident. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":heading(1, 2,3)", expected = "  combinator None\n    PseudoClass heading anb=0,0 forgiving=0 args=0 langs=[] ident=- levels=[1,2,3,]\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":heading(1.5)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':heading' value `heading` is invalid: Failed to parse argument as a <level>: Not an <integer> literal. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":heading(1 2)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':heading' value `heading` is invalid: Failed to parse argument as a <level>: Has trailing tokens. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":hover(x)", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':hover' value `hover` is invalid: Not valid as a function. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":nth-child", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':nth-child' value `nth-child` is invalid: Only valid as a function. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":bogus(x)", expected = "  error SyntaxError\n  rest: 0\n  error: Unknown pseudo class or element ':bogus' in style selector. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = ":is()", expected = "  error SyntaxError\n  rest: 0\n  error: Pseudo ':is' value `is` is invalid: Missing arguments. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "::-webkit-thing(x)", expected = "  error IncludesIgnoredVendorPrefix\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "::bogus", expected = "  error SyntaxError\n  rest: 0\n  error: Unknown pseudo class or element '::bogus' in style selector. (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "::-moz-bogus", expected = "  error IncludesIgnoredVendorPrefix\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "compound", input = "::1", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `1` is invalid: Pseudo-element should be an ident or function, got: 'Token: Number(value=1, number_type=Integer, source=\"1\", start=0:2, end=0:3)' (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "\"x\"", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `\"x\"` is invalid: Invalid start of a simple selector: Token: String(value=\"x\", source=\"\\\"x\\\"\", start=0:0, end=0:3) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "1px", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `1px` is invalid: Invalid start of a simple selector: Token: Dimension(value=1, number_type=Integer, unit=\"px\", source=\"1px\", start=0:0, end=0:3) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "{}", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `{}` is invalid: Invalid start of a simple selector: Block: {} (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "(a)", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `(a)` is invalid: Invalid start of a simple selector: Block: (a) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "f(x)", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `f(x)` is invalid: Invalid start of a simple selector: Function: f(x) (1)\n"),
    TestCssRuleParsingCase(mode = "compound", input = "a,b", expected = "  combinator None\n    TagName ns=0 ns_name='' name='a' lower='a'\n  rest: 2\n"),
    TestCssRuleParsingCase(mode = "compound", input = "@x", expected = "  error SyntaxError\n  rest: 0\n  error: style selector `@x` is invalid: Invalid start of a simple selector: Token: AtKeyword(value=\"x\", source=\"@x\", start=0:0, end=0:2) (1)\n"),
    TestCssRuleParsingCase(mode = "anb", input = "odd", expected = "  2 1\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "anb", input = "EVEN", expected = "  2 0\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "anb", input = "3", expected = "  0 3\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "anb", input = "-3", expected = "  0 -3\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "anb", input = "+3", expected = "  0 3\n  rest: 0\n"),
    TestCssRuleParsingCase(mode = "anb", input = "n", expected = "  1 0\n  rest: 0\n"),
