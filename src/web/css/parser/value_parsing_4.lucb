# mark: color() =================================================================================

## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:1966 Web::CSS::Parser::Parser::parse_color_function.
# https://www.w3.org/TR/css-color-4/#funcdef-color
pub func css_parser_parse_color_function(this: CssParser*, outer_tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssStyleValue*?:
    # color() = color( <colorspace-params> [ / [ <alpha-value> | none ] ]? )
    #     <colorspace-params> = [ <predefined-rgb-params> | <xyz-params>]
    #     <predefined-rgb-params> = <predefined-rgb> [ <number> | <percentage> | none ]{3}
    #     <predefined-rgb> = srgb | srgb-linear | display-p3 | a98-rgb | prophoto-rgb | rec2020
    #     <xyz-params> = <xyz-space> [ <number> | <percentage> | none ]{3}
    #     <xyz-space> = xyz | xyz-d50 | xyz-d65

    var transaction = css_syntax.token_stream_begin_transaction(outer_tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    css_syntax.token_stream_discard_whitespace(outer_tokens)

    let function = css_consume_color_function(outer_tokens, "color", none) else return none

    css_parser_push_temporary_value_parsing_context(this, css_function_context_of(&function))
    defer css_parser_pop_temporary_value_parsing_context(this)

    var inner_tokens = css_syntax.token_stream_create(function.value)
    css_syntax.token_stream_discard_whitespace(&inner_tokens)

    let maybe_color_space = css_syntax.token_stream_consume_a_token(&inner_tokens)
    css_syntax.token_stream_discard_whitespace(&inner_tokens)
    if not css_syntax.component_value_is(&maybe_color_space, .ident):
        return none

    let ident = css_component_value_ident(&maybe_color_space)
    let color_space = ak.fly_string_to_ascii_lowercase(&ident)
    if css_color_type_from_color_function_name(ak.fly_string_bytes_as_string_view(&color_space)) == none:
        return none

    let c1 = css_parser_parse_number_percentage_none_value(this, &inner_tokens) else return none
    css_syntax.token_stream_discard_whitespace(&inner_tokens)

    let c2 = css_parser_parse_number_percentage_none_value(this, &inner_tokens) else return none
    css_syntax.token_stream_discard_whitespace(&inner_tokens)

    let c3 = css_parser_parse_number_percentage_none_value(this, &inner_tokens) else return none
    css_syntax.token_stream_discard_whitespace(&inner_tokens)

    var alpha: CssStyleValue*? = none
    if css_syntax.token_stream_has_next_token(&inner_tokens):
        alpha = css_parser_parse_solidus_and_alpha_value(this, &inner_tokens)
        if alpha == none or css_syntax.token_stream_has_next_token(&inner_tokens):
            return none

    if alpha == none:
        alpha = css_number_style_value_create(1.0).css_style_value()

    css_syntax.state_transaction_commit(&transaction)
    let color_type = css_color_type_from_color_function_name(ak.fly_string_bytes_as_string_view(&color_space)) else trap("VERIFY: a color type")
    return css_color_function_style_value_create(color_type, c1, c2, c3, alpha).css_style_value()

# mark: <color-interpolation-method> ============================================================

## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:2032 Web::CSS::Parser::Parser::parse_color_interpolation_method_value.
# https://drafts.csswg.org/css-color-5/#color-interpolation-method
pub func css_parser_parse_color_interpolation_method_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> CssColorInterpolationMethodStyleValue*?:
    # <rectangular-color-space> = srgb | srgb-linear | display-p3 | display-p3-linear | a98-rgb | prophoto-rgb | rec2020 | lab | oklab | <xyz-space>
    # <polar-color-space> = hsl | hwb | lch | oklch
    # <custom-color-space> = <dashed-ident>
    # <hue-interpolation-method> = [ shorter | longer | increasing | decreasing ] hue
    # <color-interpolation-method> = in [ <rectangular-color-space> | <polar-color-space> <hue-interpolation-method>? | <custom-color-space> ]
    var transaction = css_syntax.token_stream_begin_transaction(tokens)
    defer css_syntax.state_transaction_destroy(&transaction)
    css_syntax.token_stream_discard_whitespace(tokens)
    let in_token = css_syntax.token_stream_consume_a_token(tokens)
    if not css_syntax.component_value_is_ident(&in_token, ak.sv("in")):
        return none

    css_syntax.token_stream_discard_whitespace(tokens)

    if let maybe_keyword_value = css_parser_parse_keyword_value(this, tokens):
        let keyword = css_style_value_to_keyword(maybe_keyword_value)

        # <rectangular-color-space>
        if let rectangular_color_space = css_data.keyword_to_rectangular_color_space(keyword):
            var color_space = rectangular_color_space
            if color_space == css_data.RectangularColorSpace.xyz:
                color_space = css_data.RectangularColorSpace.xyz_d65
            css_syntax.state_transaction_commit(&transaction)
            return css_color_interpolation_method_style_value_create(display_list.ColorInterpolationMethod.rectangular_color_space(color_space))

        # <polar-color-space> <hue-interpolation-method>?
        if let polar_color_space = css_data.keyword_to_polar_color_space(keyword):
            var hue_interpolation_method = css_data.HueInterpolationMethod.shorter
            css_syntax.token_stream_discard_whitespace(tokens)
            if let hue_interpolation_method_keyword = css_parser_parse_keyword_value(this, tokens):
                let maybe_hue_interpolation_method = css_data.keyword_to_hue_interpolation_method(css_style_value_to_keyword(hue_interpolation_method_keyword)) else return none

                hue_interpolation_method = maybe_hue_interpolation_method
                css_syntax.token_stream_discard_whitespace(tokens)
                let hue_token = css_syntax.token_stream_consume_a_token(tokens)
                if not css_syntax.component_value_is_ident(&hue_token, ak.sv("hue")):
                    return none

            css_syntax.state_transaction_commit(&transaction)
            return css_color_interpolation_method_style_value_create(display_list.ColorInterpolationMethod.polar_color_interpolation_method(display_list.PolarColorInterpolationMethod(color_space = polar_color_space, hue_interpolation_method = hue_interpolation_method)))

    # TODO: Support <custom-color-space> once we support @color-profile rules

    return none
