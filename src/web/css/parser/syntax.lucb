## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:89 Web::CSS::Parser::MultiplierSyntaxNode::to_string (override).
pub func css_multiplier_syntax_node_to_string_impl(base: CssSyntaxNode*) -> ak.String:
    let this = (CssMultiplierSyntaxNode*)base
    let child = css_syntax_node_to_string(this.m_child)
    return css_string_formatted("{}+", [css_arg_string(&child)])

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:94 Web::CSS::Parser::MultiplierSyntaxNode::dump (override).
pub func css_multiplier_syntax_node_dump_string_builder_impl(base: CssSyntaxNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssMultiplierSyntaxNode*)base
    css_syntax_node_dump_indent(builder, indent)
    ak.string_builder_append_string_view(builder, ak.sv("Multiplier:\n"))
    css_syntax_node_dump_string_builder(this.m_child, builder, indent + 2)

