# mark: AlternativesSyntaxNode ==================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:142 Web::CSS::Parser::AlternativesSyntaxNode::create.
pub func css_alternatives_syntax_node_create(children: ak.Vector[CssSyntaxNode*]) -> CssAlternativesSyntaxNode*:
    let this = &(new CssAlternativesSyntaxNode[1] --- else trap("out of memory"))[0]
    css_alternatives_syntax_node_construct(this, children)
    return this

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:119 Web::CSS::Parser::AlternativesSyntaxNode::AlternativesSyntaxNode.
pub func css_alternatives_syntax_node_construct(this: CssAlternativesSyntaxNode*, children: ak.Vector[CssSyntaxNode*]):
    css_syntax_node_construct(this.css_syntax_node(), CssSyntaxNodeNodeType.alternatives)
    css_syntax_node_set_class(this.css_syntax_node(), (const CssSyntaxNodeVTable*)&css_alternatives_syntax_node_vtable, &css_alternatives_syntax_node_class)
    this.m_children = children

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:148 Web::CSS::Parser::AlternativesSyntaxNode::children.
pub func css_alternatives_syntax_node_children_2(this: CssAlternativesSyntaxNode*) -> const (CssSyntaxNode*)[]:
    return ak.vector_span_const(&this.m_children)

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:127 Web::CSS::Parser::AlternativesSyntaxNode::to_string (override).
pub func css_alternatives_syntax_node_to_string_impl(base: CssSyntaxNode*) -> ak.String:
    let this = (CssAlternativesSyntaxNode*)base
    var builder = ak.string_builder_new()

    var first = true
    for child in ak.vector_span_const(&this.m_children):
        if first:
            first = false
        else:
            ak.string_builder_append_string_view(&builder, ak.sv(" | "))
        let child_string = css_syntax_node_to_string(child)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&child_string))

    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:144 Web::CSS::Parser::AlternativesSyntaxNode::dump (override).
pub func css_alternatives_syntax_node_dump_string_builder_impl(base: CssSyntaxNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssAlternativesSyntaxNode*)base
    css_syntax_node_dump_indent(builder, indent)
    ak.string_builder_append_string_view(builder, ak.sv("Alternatives:\n"))
    for child in ak.vector_span_const(&this.m_children):
        css_syntax_node_dump_string_builder(child, builder, indent + 2)
