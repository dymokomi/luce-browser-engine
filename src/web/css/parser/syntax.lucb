#==============================================================================================
#
#   syntax - the nodes of a CSS <syntax> definition (`*`, idents, types, `+`, `#`, `|`)
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/Parser/Syntax.cpp (lines 1-151) and the inline members of
#       Syntax.h (lines 1-158). SyntaxNode is an OwnPtr'd hierarchy without a GC header: each
#       node carries its vtable and class id (types_syntax), set by the most-derived
#       constructor as the C++ vptr is, and `create` allocates the node in managed memory.
#
#       Copyright (c) 2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: SyntaxNode ==============================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:29 Web::CSS::Parser::SyntaxNode::type.
pub func css_syntax_node_type(this: CssSyntaxNode*) -> CssSyntaxNodeNodeType:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:32 Web::CSS::Parser::SyntaxNode::to_string (virtual).
pub func css_syntax_node_to_string_impl(this: CssSyntaxNode*) -> ak.String:
    _ = this
    trap("pure virtual: Web::CSS::Parser::SyntaxNode::to_string")

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:33 Web::CSS::Parser::SyntaxNode::dump (virtual).
pub func css_syntax_node_dump_string_builder_impl(this: CssSyntaxNode*, arg0: ak.StringBuilder*, indent: i32):
    _ = this
    _ = arg0
    _ = indent
    trap("pure virtual: Web::CSS::Parser::SyntaxNode::dump")

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:13 Web::CSS::Parser::SyntaxNode::dump.
pub func css_syntax_node_dump(this: CssSyntaxNode*) -> ak.String:
    var builder = ak.string_builder_new()
    css_syntax_node_dump_string_builder(this, &builder, 0)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:37 Web::CSS::Parser::SyntaxNode::SyntaxNode.
pub func css_syntax_node_construct(this: CssSyntaxNode*, type_: CssSyntaxNodeNodeType):
    this.m_type = type_

## The node's vtable and class id: what the C++ vptr of the most-derived class gives it.
func css_syntax_node_set_class(this: CssSyntaxNode*, vtable: const CssSyntaxNodeVTable*, info: const ak.ClassInfo*):
    this.vtable = vtable
    this.class_id = info.first_id

## `builder.appendff("{: >{}}<text>", "", indent, arguments...)`: the dump line's indentation.
func css_syntax_node_dump_indent(builder: ak.StringBuilder*, indent: i32):
    dump_appendff(builder, "{: >{}}", [ak.arg_str(""), ak.arg_i64((i64)indent)])

# mark: UniversalSyntaxNode =====================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:49 Web::CSS::Parser::UniversalSyntaxNode::create.
pub func css_universal_syntax_node_create() -> CssUniversalSyntaxNode*:
    let this = &(new CssUniversalSyntaxNode[1] --- else trap("out of memory"))[0]
    css_universal_syntax_node_construct(this)
    return this

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:20 Web::CSS::Parser::UniversalSyntaxNode::UniversalSyntaxNode.
pub func css_universal_syntax_node_construct(this: CssUniversalSyntaxNode*):
    css_syntax_node_construct(this.css_syntax_node(), CssSyntaxNodeNodeType.universal)
    css_syntax_node_set_class(this.css_syntax_node(), (const CssSyntaxNodeVTable*)&css_universal_syntax_node_vtable, &css_universal_syntax_node_class)

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:27 Web::CSS::Parser::UniversalSyntaxNode::to_string (override).
pub func css_universal_syntax_node_to_string_impl(base: CssSyntaxNode*) -> ak.String:
    _ = base
    return ak.string_from_str("*")

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:32 Web::CSS::Parser::UniversalSyntaxNode::dump (override).
pub func css_universal_syntax_node_dump_string_builder_impl(base: CssSyntaxNode*, builder: ak.StringBuilder*, indent: i32):
    _ = base
    css_syntax_node_dump_indent(builder, indent)
    ak.string_builder_append_string_view(builder, ak.sv("Universal\n"))

# mark: TypeSyntaxNode ==========================================================================

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:37 Web::CSS::Parser::TypeSyntaxNode::create.
pub func css_type_syntax_node_create(type_name: ak.FlyString) -> CssTypeSyntaxNode*:
    let value_type = css_value_type_from_string(ak.fly_string_bytes_as_string_view(&type_name))
    let this = &(new CssTypeSyntaxNode[1] --- else trap("out of memory"))[0]
    css_type_syntax_node_construct(this, type_name, value_type)
    return this

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:43 Web::CSS::Parser::TypeSyntaxNode::TypeSyntaxNode.
pub func css_type_syntax_node_construct(this: CssTypeSyntaxNode*, type_name: ak.FlyString, value_type: CssValueType?):
    css_syntax_node_construct(this.css_syntax_node(), CssSyntaxNodeNodeType.type_)
    css_syntax_node_set_class(this.css_syntax_node(), (const CssSyntaxNodeVTable*)&css_type_syntax_node_vtable, &css_type_syntax_node_class)
    this.m_type_name = type_name
    this.m_value_type = value_type

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:89 Web::CSS::Parser::TypeSyntaxNode::type_name.
pub func css_type_syntax_node_type_name(this: CssTypeSyntaxNode*) -> ak.FlyString:
    return this.m_type_name

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.h:90 Web::CSS::Parser::TypeSyntaxNode::value_type.
pub func css_type_syntax_node_value_type(this: CssTypeSyntaxNode*) -> CssValueType?:
    return this.m_value_type

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:52 Web::CSS::Parser::TypeSyntaxNode::to_string (override).
pub func css_type_syntax_node_to_string_impl(base: CssSyntaxNode*) -> ak.String:
    let this = (CssTypeSyntaxNode*)base
    return css_string_formatted("<{}>", [css_arg_fly_string(&this.m_type_name)])

## Ported from Libraries/LibWeb/CSS/Parser/Syntax.cpp:57 Web::CSS::Parser::TypeSyntaxNode::dump (override).
pub func css_type_syntax_node_dump_string_builder_impl(base: CssSyntaxNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssTypeSyntaxNode*)base
    css_syntax_node_dump_indent(builder, indent)
    dump_appendff(builder, "Type: {}\n", [css_arg_fly_string(&this.m_type_name)])

