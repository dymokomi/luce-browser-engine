pub func css_multiplier_syntax_node_construct(this: CssMultiplierSyntaxNode*, child: CssSyntaxNode*):
    css_syntax_node_construct(this.css_syntax_node(), CssSyntaxNodeNodeType.multiplier)
    css_syntax_node_set_class(this.css_syntax_node(), (const CssSyntaxNodeVTable*)&css_multiplier_syntax_node_vtable, &css_multiplier_syntax_node_class)
