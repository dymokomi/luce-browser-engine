## Ported from Libraries/LibWeb/CSS/Parser/RuleContext.cpp:13 Web::CSS::Parser::rule_context_type_for_rule.
pub func css_rule_context_type_for_rule(rule_type: CssRuleType) -> CssRuleContext:
    match rule_type:
        .container: return CssRuleContext.at_container
        .counter_style: return CssRuleContext.at_counter_style
        .style: return CssRuleContext.style
        .media: return CssRuleContext.at_media
        .font_face: return CssRuleContext.at_font_face
        .font_feature_values: return CssRuleContext.at_font_feature_values
        .function: return CssRuleContext.at_function
        .keyframes: return CssRuleContext.at_keyframes
        .keyframe: return CssRuleContext.keyframe
        .supports: return CssRuleContext.at_supports
        .layer_block: return CssRuleContext.at_layer
        .margin: return CssRuleContext.margin
        .nested_declarations: return CssRuleContext.style
        .page: return CssRuleContext.at_page
        .property: return CssRuleContext.at_property
        # Other types shouldn't be trying to create a context.
        .import_, .layer_statement, .namespace, .function_declarations: trap("VERIFY_NOT_REACHED")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Parser/RuleContext.cpp:56 Web::CSS::Parser::rule_context_type_for_at_rule.
pub func css_rule_context_type_for_at_rule(name: ak.FlyString) -> CssRuleContext:
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("media")):
        return CssRuleContext.at_media
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("container")):
        return CssRuleContext.at_container
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("counter-style")):
        return CssRuleContext.at_counter_style
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("font-face")):
        return CssRuleContext.at_font_face
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("keyframes")) or ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("-webkit-keyframes")):
        return CssRuleContext.at_keyframes
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("font-feature-values")):
        return CssRuleContext.at_font_feature_values
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("function")):
        return CssRuleContext.at_function
    if css_font_feature_values_rule_is_font_feature_value_type_at_keyword(name):
        return CssRuleContext.font_feature_value
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("supports")):
        return CssRuleContext.at_supports
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("layer")):
        return CssRuleContext.at_layer
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("property")):
        return CssRuleContext.at_property
    if ak.fly_string_equals_ignoring_ascii_case_string_view(&name, ak.sv("page")):
        return CssRuleContext.at_page
    if css_is_margin_rule_name(ak.fly_string_bytes_as_string_view(&name)):
        return CssRuleContext.margin
    return CssRuleContext.unknown
