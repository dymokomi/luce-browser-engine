pub func css_parser_parse_resolution_value(this: CssParser*, tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*, accepted_range: CssNumericRange) -> CssStyleValue*?:
    css_syntax.token_stream_discard_whitespace(tokens)

    if css_next_token_is(tokens, .dimension):
        var transaction = css_syntax.token_stream_begin_transaction(tokens)
        defer css_syntax.state_transaction_destroy(&transaction)
        let dimension_token = css_consume_a_token_token(tokens)
        let unit_ = css_syntax.token_dimension_unit(&dimension_token)
        if let resolution_type = css_data.string_to_resolution_unit(ak.fly_string_bytes_as_string_view(&unit_)):
            let resolution = css_resolution_new(css_syntax.token_dimension_value(&dimension_token), resolution_type)

