## Ported from Libraries/LibWeb/CSS/Parser/ValueParsing.cpp:1016 Web::CSS::Parser::parse_literal_length_value.
func css_parse_literal_length_value(tokens: css_syntax.TokenStream[css_syntax.ComponentValue]*, context_allows_quirky_length: bool, is_parsing_svg_presentation_attribute: bool, accepted_range: CssNumericRange) -> CssLengthStyleValue*?:
    css_syntax.token_stream_discard_whitespace(tokens)

    if css_next_token_is(tokens, .dimension):
        var transaction = css_syntax.token_stream_begin_transaction(tokens)
        defer css_syntax.state_transaction_destroy(&transaction)
        let dimension_token = css_consume_a_token_token(tokens)
        let unit_ = css_syntax.token_dimension_unit(&dimension_token)
        if let length_type = css_data.string_to_length_unit(ak.fly_string_bytes_as_string_view(&unit_)):
            let length = css_length_new(css_syntax.token_dimension_value(&dimension_token), length_type)

            # NB: Since we can't convert font/viewport relative lengths to their canonical units at parse time it
            #     doesn't make sense to have non-zero/non-infinite bounds for lengths
            assert(accepted_range.min == f64(ak.f32_lowest) or accepted_range.min == 0.0)
            assert(accepted_range.max == f64(ak.f32_max) or accepted_range.max == 0.0)

            if not css_numeric_range_contains(&accepted_range, css_length_raw_value(&length)):
                return none

            css_syntax.state_transaction_commit(&transaction)
            return css_length_style_value_create(length)
        return none

    if css_next_token_is(tokens, .number):
        var transaction = css_syntax.token_stream_begin_transaction(tokens)
        defer css_syntax.state_transaction_destroy(&transaction)
        let number_token = css_consume_a_token_token(tokens)
        let numeric_value = css_syntax.token_number_value(&number_token)
        if numeric_value == 0.0:
            if not css_numeric_range_contains(&accepted_range, 0.0):
                return none

            css_syntax.state_transaction_commit(&transaction)
            return css_length_style_value_create(css_length_make_px_f64(0.0))
        if context_allows_quirky_length:
            let nearest_value = gfx.css_pixels_nearest_value_for_f64(numeric_value)

            if not css_numeric_range_contains(&accepted_range, nearest_value.to_double()):
                return none

            css_syntax.state_transaction_commit(&transaction)
            return css_length_style_value_create(css_length_make_px_css_pixels(nearest_value))

        # https://svgwg.org/svg2-draft/types.html#presentation-attribute-css-value
        # When parsing an SVG attribute, a length is allowed without a unit.
        # FIXME: How should these numbers be interpreted? https://github.com/w3c/svgwg/issues/792
        #        For now: Convert to a length in pixels.
        if is_parsing_svg_presentation_attribute:
            let nearest_value = gfx.css_pixels_nearest_value_for_f64(numeric_value)

            if not css_numeric_range_contains(&accepted_range, nearest_value.to_double()):
                return none

            css_syntax.state_transaction_commit(&transaction)
            return css_length_style_value_create(css_length_make_px_css_pixels(nearest_value))

    return none

