                return none

            css_syntax.state_transaction_commit(&transaction)
            return css_resolution_style_value_create(resolution).css_style_value()
        return none

    return css_parser_parse_calculated_fallback(this, tokens, css_calculation_context_accepting(CssValueType.resolution, accepted_range), css_calculated_style_value_resolves_to_resolution)

