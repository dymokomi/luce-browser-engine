## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:106 Web::CSS::GeneralEnclosed::GeneralEnclosed.
pub func css_general_enclosed_construct(this: CssGeneralEnclosed*, serialized_contents: ak.String, matches: CssMatchResult):
    css_boolean_expression_set_class(this.css_boolean_expression(), (const CssBooleanExpressionVTable*)&css_general_enclosed_vtable, &css_general_enclosed_class)
    this.m_serialized_contents = serialized_contents
    this.m_matches = matches

# mark: BooleanNotExpression ====================================================================

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:118 Web::CSS::BooleanNotExpression::create.
pub func css_boolean_not_expression_create(child: CssBooleanExpression*) -> CssBooleanNotExpression*:
    let this = &(alloc CssBooleanNotExpression[1] else trap("out of memory"))[0]
    css_boolean_not_expression_construct(this, child)
    return this

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:28 Web::CSS::BooleanNotExpression::evaluate (override).
pub func css_boolean_not_expression_evaluate_impl(base: CssBooleanExpression*, document: DomDocument*?) -> CssMatchResult:
    let this = (CssBooleanNotExpression*)base
    # https://drafts.csswg.org/css-values-5/#boolean-logic
    # `not test` evaluates to true if its contained test is false, false if it’s true, and unknown if it’s unknown.
    match css_boolean_expression_evaluate(this.m_child, document):
        .false_: return CssMatchResult.true_
        .true_: return CssMatchResult.false_
        .unknown: return CssMatchResult.unknown
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:43 Web::CSS::BooleanNotExpression::to_string (override).
pub func css_boolean_not_expression_to_string_impl(base: CssBooleanExpression*) -> ak.String:
    let this = (CssBooleanNotExpression*)base
    var builder = ak.string_builder_new()
    let child = css_boolean_expression_to_string(this.m_child)
    ak.string_builder_append(&builder, "not ")
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&child))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:48 Web::CSS::BooleanNotExpression::dump (override).
pub func css_boolean_not_expression_dump_impl(base: CssBooleanExpression*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssBooleanNotExpression*)base
    css_boolean_expression_indent(builder, indent_levels)
    ak.string_builder_append(builder, "NOT:\n")
    css_boolean_expression_dump(this.m_child, builder, indent_levels + 1)

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:129 Web::CSS::BooleanNotExpression::BooleanNotExpression.
pub func css_boolean_not_expression_construct(this: CssBooleanNotExpression*, child: CssBooleanExpression*):
    css_boolean_expression_set_class(this.css_boolean_expression(), (const CssBooleanExpressionVTable*)&css_boolean_not_expression_vtable, &css_boolean_not_expression_class)
    this.m_child = child

