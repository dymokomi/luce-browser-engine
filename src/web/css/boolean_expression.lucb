    var builder = ak.string_builder_new()
    let child = css_boolean_expression_to_string(this.m_child)
    ak.string_builder_append(&builder, "(")
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&child))
    ak.string_builder_append(&builder, ")")
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:65 Web::CSS::BooleanExpressionInParens::dump (override).
pub func css_boolean_expression_in_parens_dump_impl(base: CssBooleanExpression*, builder: ak.StringBuilder*, indent_levels: i32):
