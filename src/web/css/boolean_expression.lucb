# mark: BooleanAndExpression ====================================================================

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:160 Web::CSS::BooleanAndExpression::create.
pub func css_boolean_and_expression_create(children: ak.Vector[CssBooleanExpression*]) -> CssBooleanAndExpression*:
    let this = &(alloc CssBooleanAndExpression[1] else trap("out of memory"))[0]
    css_boolean_and_expression_construct(this, children)
    return this

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:74 Web::CSS::BooleanAndExpression::evaluate (override).
pub func css_boolean_and_expression_evaluate_impl(base: CssBooleanExpression*, document: DomDocument*?) -> CssMatchResult:
    let this = (CssBooleanAndExpression*)base
    # https://drafts.csswg.org/css-values-5/#boolean-logic
    # Multiple tests connected with `and` evaluate to true if all of those tests are true, false if any of them are
    # false, and unknown otherwise (i.e. if at least one unknown, but no false).
    var true_results: usize = 0
    for child in ak.vector_span(&this.m_children):
        let child_match = css_boolean_expression_evaluate(child, document)
        if child_match == CssMatchResult.false_:
            return CssMatchResult.false_
        if child_match == CssMatchResult.true_:
            true_results += 1

    if true_results == ak.vector_size(&this.m_children):
        return CssMatchResult.true_
    return CssMatchResult.unknown

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:92 Web::CSS::BooleanAndExpression::to_string (override).
pub func css_boolean_and_expression_to_string_impl(base: CssBooleanExpression*) -> ak.String:
    let this = (CssBooleanAndExpression*)base
    return css_boolean_expression_join(" and ", &this.m_children)

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:97 Web::CSS::BooleanAndExpression::dump (override).
pub func css_boolean_and_expression_dump_impl(base: CssBooleanExpression*, builder: ak.StringBuilder*, indent_levels: i32):
    let this = (CssBooleanAndExpression*)base
    css_boolean_expression_indent(builder, indent_levels)
    ak.string_builder_append(builder, "AND:\n")
    for child in ak.vector_span(&this.m_children):
        css_boolean_expression_dump(child, builder, indent_levels + 1)

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:171 Web::CSS::BooleanAndExpression::BooleanAndExpression.
pub func css_boolean_and_expression_construct(this: CssBooleanAndExpression*, children: ak.Vector[CssBooleanExpression*]):
    css_boolean_expression_set_class(this.css_boolean_expression(), (const CssBooleanExpressionVTable*)&css_boolean_and_expression_vtable, &css_boolean_and_expression_class)
    this.m_children = children

# mark: BooleanOrExpression =====================================================================

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:181 Web::CSS::BooleanOrExpression::create.
pub func css_boolean_or_expression_create(children: ak.Vector[CssBooleanExpression*]) -> CssBooleanOrExpression*:
    let this = &(alloc CssBooleanOrExpression[1] else trap("out of memory"))[0]
    css_boolean_or_expression_construct(this, children)
    return this

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:105 Web::CSS::BooleanOrExpression::evaluate (override).
pub func css_boolean_or_expression_evaluate_impl(base: CssBooleanExpression*, document: DomDocument*?) -> CssMatchResult:
    let this = (CssBooleanOrExpression*)base
    # https://drafts.csswg.org/css-values-5/#boolean-logic
    # Multiple tests connected with `or` evaluate to true if any of those tests are true, false if all of them are
    # false, and unknown otherwise (i.e. at least one unknown, but no true).
    var false_results: usize = 0
    for child in ak.vector_span(&this.m_children):
        let child_match = css_boolean_expression_evaluate(child, document)
        if child_match == CssMatchResult.true_:
            return CssMatchResult.true_
        if child_match == CssMatchResult.false_:
            false_results += 1

    if false_results == ak.vector_size(&this.m_children):
        return CssMatchResult.false_
    return CssMatchResult.unknown

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:123 Web::CSS::BooleanOrExpression::to_string (override).
pub func css_boolean_or_expression_to_string_impl(base: CssBooleanExpression*) -> ak.String:
    let this = (CssBooleanOrExpression*)base
    return css_boolean_expression_join(" or ", &this.m_children)

