## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:95 Web::CSS::GeneralEnclosed::create.
pub func css_general_enclosed_create(serialized_contents: ak.String, matches: CssMatchResult = CssMatchResult.unknown) -> CssGeneralEnclosed*:
