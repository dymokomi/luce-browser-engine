#==============================================================================================
#
#   boolean_expression - CSS::BooleanExpression: the <boolean-expr> tree of @media, @supports,
#                        @container and if() conditions, in Kleene three-valued logic
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/BooleanExpression.cpp (lines 1-142) and the inline members of
#       BooleanExpression.h (lines 15-229): MatchResult's operators, the abstract
#       BooleanExpression, GeneralEnclosed, the not / parenthesized / and / or nodes and the
#       constant node. Expressions are managed blobs (C++ NonnullOwnPtr), each with the class id
#       and vtable of its most-derived class.
#
#       Copyright (c) 2021-2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: MatchResult =============================================================================

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:23 Web::CSS::operator&&.
pub func css_and(a: CssMatchResult, b: CssMatchResult) -> CssMatchResult:
    # If either is false, false.
    if a == CssMatchResult.false_ or b == CssMatchResult.false_:
        return CssMatchResult.false_
    # If both are true, true.
    if a == CssMatchResult.true_ and b == CssMatchResult.true_:
        return CssMatchResult.true_
    # Otherwise, unknown.
    return CssMatchResult.unknown

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:35 Web::CSS::operator||.
pub func css_or(a: CssMatchResult, b: CssMatchResult) -> CssMatchResult:
    # If either is true, true.
    if a == CssMatchResult.true_ or b == CssMatchResult.true_:
        return CssMatchResult.true_
    # If both are false, false.
    if a == CssMatchResult.false_ and b == CssMatchResult.false_:
        return CssMatchResult.false_
    # Otherwise, unknown.
    return CssMatchResult.unknown

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:47 Web::CSS::as_match_result.
pub func css_as_match_result(value: bool) -> CssMatchResult:
    return CssMatchResult.true_ if value else CssMatchResult.false_

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:52 Web::CSS::negate.
pub func css_negate(value: CssMatchResult) -> CssMatchResult:
    match value:
        .false_: return CssMatchResult.true_
        .true_: return CssMatchResult.false_
        .unknown: return CssMatchResult.unknown
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:65 Web::CSS::to_string.
pub func css_to_string_css_match_result(result: CssMatchResult) -> ak.StringView:
    match result:
        .false_: return ak.sv("false")
        .true_: return ak.sv("true")
        .unknown: return ak.sv("unknown")
        _: trap("VERIFY_NOT_REACHED")

# mark: BooleanExpression =======================================================================

## Installs the vtable and class id of the most-derived expression class (the C++ vptr).
pub func css_boolean_expression_set_class(this: CssBooleanExpression*, vtable: const CssBooleanExpressionVTable*, info: const ak.ClassInfo*):
    this.vtable = vtable
    this.class_id = info.first_id

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:12 Web::CSS::BooleanExpression::evaluate_to_boolean.
pub func css_boolean_expression_evaluate_to_boolean(this: CssBooleanExpression*, document: DomDocument*?) -> bool:
    return css_boolean_expression_evaluate(this, document) == CssMatchResult.true_

## Ported from Libraries/LibWeb/CSS/BooleanExpression.cpp:17 Web::CSS::BooleanExpression::indent.
pub func css_boolean_expression_indent(builder: ak.StringBuilder*, levels: i32):
    ak.string_builder_append_repeated_string_view(builder, ak.sv("  "), (usize)levels)

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:87 Web::CSS::BooleanExpression::evaluate (virtual).
pub func css_boolean_expression_evaluate_impl(this: CssBooleanExpression*, arg0: DomDocument*?) -> CssMatchResult:
    trap("pure virtual: Web::CSS::BooleanExpression::evaluate")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:88 Web::CSS::BooleanExpression::to_string (virtual).
pub func css_boolean_expression_to_string_impl(this: CssBooleanExpression*) -> ak.String:
    trap("pure virtual: Web::CSS::BooleanExpression::to_string")

## Ported from Libraries/LibWeb/CSS/BooleanExpression.h:89 Web::CSS::BooleanExpression::dump (virtual).
pub func css_boolean_expression_dump_impl(this: CssBooleanExpression*, arg0: ak.StringBuilder*, indent_levels: i32):
    trap("pure virtual: Web::CSS::BooleanExpression::dump")

## `String::join(separator, children)` over expressions (Formatter<BooleanExpression> is their to_string()).
func css_boolean_expression_join(separator: str, children: const ak.Vector[CssBooleanExpression*]*) -> ak.String:
    var builder = ak.string_builder_new()
    var first = true
    for child in ak.vector_span_const(children):
        if not first:
            ak.string_builder_append(&builder, separator)
        first = false
        let child_string = css_boolean_expression_to_string(child)
        ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&child_string))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::join")

