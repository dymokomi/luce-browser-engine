pub func css_grid_min_max_serialize(this: const CssGridMinMax*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    ak.string_builder_append(builder, "minmax(")
    css_grid_size_serialize(&this.m_min_grid_size, builder, mode)
