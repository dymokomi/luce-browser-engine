        _: return false

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:193 Web::CSS::ExplicitGridTrack::grid_size.
pub func css_explicit_grid_track_grid_size(this: const CssExplicitGridTrack*) -> CssGridSize:
    match this.m_value:
        .css_grid_size(grid_size): return grid_size
        _: trap("VERIFY: a GridSize")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:198 Web::CSS::ExplicitGridTrack::serialize.
pub func css_explicit_grid_track_serialize(this: const CssExplicitGridTrack*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    match this.m_value:
        .css_grid_repeat(track): css_grid_repeat_serialize(&track, builder, mode)
        .css_grid_min_max(track): css_grid_min_max_serialize(&track, builder, mode)
        .css_grid_size(track): css_grid_size_serialize(&track, builder, mode)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:205 Web::CSS::ExplicitGridTrack::to_string.
pub func css_explicit_grid_track_to_string(this: const CssExplicitGridTrack*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_explicit_grid_track_serialize(this, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:212 Web::CSS::ExplicitGridTrack::absolutized.
pub func css_explicit_grid_track_absolutized(this: const CssExplicitGridTrack*, context: CssComputationContext) -> CssExplicitGridTrack:
    match this.m_value:
        .css_grid_repeat(it): return css_explicit_grid_track_new(.css_grid_repeat(css_grid_repeat_absolutized(&it, context)))
        .css_grid_min_max(it): return css_explicit_grid_track_new(.css_grid_min_max(css_grid_min_max_absolutized(&it, context)))
        .css_grid_size(it): return css_explicit_grid_track_new(.css_grid_size(css_grid_size_absolutized(&it, context)))

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:198 Web::CSS::ExplicitGridTrack::operator== (defaulted).
pub func css_explicit_grid_track_eq(this: const CssExplicitGridTrack*, other: CssExplicitGridTrack) -> bool:
    match this.m_value:
        .css_grid_repeat(track):
            match other.m_value:
                .css_grid_repeat(other_track): return css_grid_repeat_eq(&track, other_track)
                _: return false
        .css_grid_min_max(track):
            match other.m_value:
                .css_grid_min_max(other_track): return css_grid_min_max_eq(&track, other_track)
                _: return false
        .css_grid_size(track):
            match other.m_value:
                .css_grid_size(other_track): return css_grid_size_eq(&track, other_track)
                _: return false

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:200 Web::CSS::ExplicitGridTrack::is_computationally_independent.
pub func css_explicit_grid_track_is_computationally_independent(this: const CssExplicitGridTrack*) -> bool:
    match this.m_value:
        .css_grid_repeat(value): return css_grid_repeat_is_computationally_independent(&value)
        .css_grid_min_max(value): return css_grid_min_max_is_computationally_independent(&value)
        .css_grid_size(value): return css_grid_size_is_computationally_independent(&value)

