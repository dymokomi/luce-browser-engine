## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:136 Web::CSS::GridMinMax::absolutized.
pub func css_grid_min_max_absolutized(this: const CssGridMinMax*, context: CssComputationContext) -> CssGridMinMax:
    var result: CssGridMinMax = ---
    css_grid_min_max_construct(&result, css_grid_size_absolutized(&this.m_min_grid_size, context), css_grid_size_absolutized(&this.m_max_grid_size, context))
    return result

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:66 Web::CSS::GridMinMax::operator== (defaulted).
pub func css_grid_min_max_eq(this: const CssGridMinMax*, other: CssGridMinMax) -> bool:
