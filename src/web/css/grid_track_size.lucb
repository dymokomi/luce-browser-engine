## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:144 Web::CSS::GridRepeat::GridRepeat.
pub func css_grid_repeat_construct_css_grid_repeat_type(this: CssGridRepeat*, grid_repeat_type: CssGridRepeatType, grid_track_size_list: CssGridTrackSizeList, repeat_count: CssStyleValue*?):
    this.m_type = grid_repeat_type
    this.m_grid_track_size_list = grid_track_size_list
    this.m_repeat_count = repeat_count

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:151 Web::CSS::GridRepeat::GridRepeat.
pub func css_grid_repeat_construct_css_grid_track_size_list(this: CssGridRepeat*, grid_track_size_list: CssGridTrackSizeList, params: CssGridRepeatParams):
    css_grid_repeat_construct_css_grid_repeat_type(this, params.type_, grid_track_size_list, params.count)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:158 Web::CSS::GridRepeat::is_auto_fill.
pub func css_grid_repeat_is_auto_fill(this: const CssGridRepeat*) -> bool:
    return this.m_type == CssGridRepeatType.auto_fill

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:159 Web::CSS::GridRepeat::is_auto_fit.
pub func css_grid_repeat_is_auto_fit(this: const CssGridRepeat*) -> bool:
    return this.m_type == CssGridRepeatType.auto_fit

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:160 Web::CSS::GridRepeat::is_fixed.
pub func css_grid_repeat_is_fixed(this: const CssGridRepeat*) -> bool:
    return this.m_type == CssGridRepeatType.fixed

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:161 Web::CSS::GridRepeat::repeat_count.
pub func css_grid_repeat_repeat_count(this: const CssGridRepeat*) -> usize:
    assert(css_grid_repeat_is_fixed(this))
    let repeat_count = this.m_repeat_count else trap("VERIFY: a repeat count")
    # int -> size_t, as C++ converts it.
    return (usize)(i64)css_int_from_style_value(repeat_count)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:166 Web::CSS::GridRepeat::grid_track_size_list.
pub func css_grid_repeat_grid_track_size_list(this: const CssGridRepeat*) -> CssGridTrackSizeList:
    return this.m_grid_track_size_list

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:167 Web::CSS::GridRepeat::type.
pub func css_grid_repeat_type(this: const CssGridRepeat*) -> CssGridRepeatType:
    return this.m_type

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:156 Web::CSS::GridRepeat::serialize.
pub func css_grid_repeat_serialize(this: const CssGridRepeat*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    ak.string_builder_append(builder, "repeat(")
    match this.m_type:
        .auto_fit:
            ak.string_builder_append(builder, "auto-fit")
        .auto_fill:
            ak.string_builder_append(builder, "auto-fill")
        .fixed:
            css_style_value_serialize(this.m_repeat_count else trap("VERIFY: a repeat count"), builder, mode)
        _: trap("VERIFY_NOT_REACHED")
    ak.string_builder_append(builder, ", ")
    css_grid_track_size_list_serialize(&this.m_grid_track_size_list, builder, mode)
    ak.string_builder_append(builder, ")")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:177 Web::CSS::GridRepeat::to_string.
pub func css_grid_repeat_to_string(this: const CssGridRepeat*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_grid_repeat_serialize(this, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:184 Web::CSS::GridRepeat::absolutized.
pub func css_grid_repeat_absolutized(this: const CssGridRepeat*, context: CssComputationContext) -> CssGridRepeat:
    var repeat_count: CssStyleValue*? = none
    if let count = this.m_repeat_count:
        repeat_count = css_style_value_absolutized(count, context)
    var result: CssGridRepeat = ---
    css_grid_repeat_construct_css_grid_repeat_type(&result, this.m_type, css_grid_track_size_list_absolutized(&this.m_grid_track_size_list, context), repeat_count)
    return result

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:172 Web::CSS::GridRepeat::operator== (defaulted).
pub func css_grid_repeat_eq(this: const CssGridRepeat*, other: CssGridRepeat) -> bool:
    return this.m_type == other.m_type and css_grid_track_size_list_eq(&this.m_grid_track_size_list, other.m_grid_track_size_list) and css_optional_style_values_equal(this.m_repeat_count, other.m_repeat_count)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:174 Web::CSS::GridRepeat::is_computationally_independent.
pub func css_grid_repeat_is_computationally_independent(this: const CssGridRepeat*) -> bool:
    if not css_grid_track_size_list_is_computationally_independent(&this.m_grid_track_size_list):
        return false
    if let repeat_count = this.m_repeat_count:
        return css_style_value_is_computationally_independent(repeat_count)
    return true

