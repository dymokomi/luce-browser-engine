## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:99 Web::CSS::GridTemplateAreas::is_empty.
pub func css_grid_template_areas_is_empty(this: const CssGridTemplateAreas*) -> bool:
    return this.row_count == 0

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:105 Web::CSS::GridLineNames::append.
pub func css_grid_line_names_append(this: CssGridLineNames*, name: ak.FlyString):
    ak.vector_append_t(&this.m_names, CssGridLineName(name = name, implicit = false))

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:106 Web::CSS::GridLineNames::is_empty.
pub func css_grid_line_names_is_empty(this: const CssGridLineNames*) -> bool:
    return ak.vector_is_empty(&this.m_names)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:107 Web::CSS::GridLineNames::names.
pub func css_grid_line_names_names(this: const CssGridLineNames*) -> ak.Vector[CssGridLineName]:
    return this.m_names

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:219 Web::CSS::GridLineNames::serialize.
pub func css_grid_line_names_serialize(this: const CssGridLineNames*, builder: ak.StringBuilder*):
    ak.string_builder_append(builder, "[")
    for i in 0..<ak.vector_size(&this.m_names):
        if i > 0:
            ak.string_builder_append(builder, " ")
        let name = ak.vector_at_const(&this.m_names, i).name
        ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&name))
    ak.string_builder_append(builder, "]")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:230 Web::CSS::GridLineNames::to_string.
pub func css_grid_line_names_to_string(this: const CssGridLineNames*) -> ak.String:
    var builder = ak.string_builder_new()
    css_grid_line_names_serialize(this, &builder)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:112 Web::CSS::GridLineNames::operator== (defaulted: the names
## and their implicit flags, in order).
pub func css_grid_line_names_eq(this: const CssGridLineNames*, other: CssGridLineNames) -> bool:
    let size = ak.vector_size(&this.m_names)
    if size != ak.vector_size(&other.m_names):
        return false
    for i in 0..<size:
        let name = ak.vector_at_const(&this.m_names, i)
        let other_name = ak.vector_at_const(&other.m_names, i)
        if not ak.fly_string_eq_fly_string(&name.name, &other_name.name) or name.implicit != other_name.implicit:
            return false
    return true

