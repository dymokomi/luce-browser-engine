#==============================================================================================
#
#   grid_track_size - the grid track sizing values: GridSize, GridMinMax, GridRepeat,
#   ExplicitGridTrack, GridLineNames, GridTrackSizeList
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/GridTrackSize.cpp (lines 1-321) and the inline members of
#       GridTrackSize.h, in the order of GridTrackSize.cpp with each class's header members
#       first. The variant visits are matches. The defaulted operator==s that the C++ relies
#       on (style values compare by value: ValueComparingRefPtr) are the css_*_eq functions;
#       GridTrackSizeList's out-of-line defaulted operator== is css_grid_track_size_list_eq.
#
#       Copyright (c) 2022, Martin Falisse <mfalisse@outlook.com>
#       Copyright (c) 2025, Aliaksandr Kalenik <kalenik.aliaksandr@gmail.com>
#       Copyright (c) 2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: GridSize ================================================================================

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:17 Web::CSS::GridSize::GridSize.
pub func css_grid_size_construct(this: CssGridSize*, size: CssStyleValue*):
    this.m_value = size

## `GridSize { size }` as a value.
pub func css_grid_size_new(size: CssStyleValue*) -> CssGridSize:
    var grid_size: CssGridSize = ---
    css_grid_size_construct(&grid_size, size)
    return grid_size

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:24 Web::CSS::GridSize::is_auto.
pub func css_grid_size_is_auto(this: const CssGridSize*, available_size: LayoutAvailableSize) -> bool:
    if css_style_value_to_keyword(this.m_value) == css_data.Keyword.auto:
        return true

    if css_style_value_is_percentage(this.m_value) or (css_style_value_is_calculated(this.m_value) and css_calculated_style_value_contains_percentage(css_style_value_as_calculated(this.m_value))):
        return not layout_available_size_is_definite(&available_size)

    return false

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:35 Web::CSS::is_length_percentage.
func css_is_length_percentage(value: CssStyleValue*) -> bool:
    return css_style_value_is_length(value) or css_style_value_is_percentage(value) or (css_style_value_is_calculated(value) and css_calculated_style_value_resolves_to_length(css_style_value_as_calculated(value)))

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:40 Web::CSS::GridSize::is_fixed.
pub func css_grid_size_is_fixed(this: const CssGridSize*, available_size: LayoutAvailableSize) -> bool:
    if not css_is_length_percentage(this.m_value):
        return false
    if css_style_value_is_percentage(this.m_value) or (css_style_value_is_calculated(this.m_value) and css_calculated_style_value_contains_percentage(css_style_value_as_calculated(this.m_value))):
        return layout_available_size_is_definite(&available_size)
    return true

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:51 Web::CSS::GridSize::is_flexible_length.
pub func css_grid_size_is_flexible_length(this: const CssGridSize*) -> bool:
    return css_style_value_is_flex(this.m_value) or (css_style_value_is_calculated(this.m_value) and css_calculated_style_value_resolves_to_flex(css_style_value_as_calculated(this.m_value)))

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:56 Web::CSS::GridSize::is_fit_content.
pub func css_grid_size_is_fit_content(this: const CssGridSize*) -> bool:
    if css_style_value_to_keyword(this.m_value) == css_data.Keyword.fit_content:
        return true
    if css_style_value_is_function(this.m_value):
        let name = css_function_style_value_name(css_style_value_as_function(this.m_value))
        if ak.fly_string_eq_string_view(&name, ak.sv("fit-content")):
            return true
    return false

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:67 Web::CSS::GridSize::is_max_content.
pub func css_grid_size_is_max_content(this: const CssGridSize*) -> bool:
    return css_style_value_to_keyword(this.m_value) == css_data.Keyword.max_content

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:72 Web::CSS::GridSize::is_min_content.
pub func css_grid_size_is_min_content(this: const CssGridSize*) -> bool:
    return css_style_value_to_keyword(this.m_value) == css_data.Keyword.min_content

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:34 Web::CSS::GridSize::css_size.
pub func css_grid_size_css_size(this: const CssGridSize*) -> CssSize:
    return css_size_from_style_value(this.m_value)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:35 Web::CSS::GridSize::flex_factor.
pub func css_grid_size_flex_factor(this: const CssGridSize*) -> f64:
    let flex = css_flex_from_style_value(this.m_value)
    return css_flex_to_fr(&flex)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:37 Web::CSS::GridSize::style_value.
pub func css_grid_size_style_value(this: const CssGridSize*) -> CssStyleValue*:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:77 Web::CSS::GridSize::is_intrinsic.
# https://www.w3.org/TR/css-grid-2/#layout-algorithm
# An intrinsic sizing function (min-content, max-content, auto, fit-content()).
pub func css_grid_size_is_intrinsic(this: const CssGridSize*, available_size: LayoutAvailableSize) -> bool:
    return css_grid_size_is_auto(this, available_size) or css_grid_size_is_max_content(this) or css_grid_size_is_min_content(this) or css_grid_size_is_fit_content(this)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:82 Web::CSS::GridSize::is_definite.
pub func css_grid_size_is_definite(this: const CssGridSize*) -> bool:
    return css_is_length_percentage(this.m_value)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:87 Web::CSS::GridSize::make_auto.
pub func css_grid_size_make_auto() -> CssGridSize:
    return css_grid_size_new(css_keyword_style_value_create(css_data.Keyword.auto).css_style_value())

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:92 Web::CSS::GridSize::serialize.
pub func css_grid_size_serialize(this: const CssGridSize*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    css_style_value_serialize(this.m_value, builder, mode)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:97 Web::CSS::GridSize::to_string.
pub func css_grid_size_to_string(this: const CssGridSize*, mode: css_syntax.SerializationMode) -> ak.String:
    var builder = ak.string_builder_new()
    css_grid_size_serialize(this, &builder, mode)
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Libraries/LibWeb/CSS/GridTrackSize.cpp:104 Web::CSS::GridSize::absolutized.
pub func css_grid_size_absolutized(this: const CssGridSize*, context: CssComputationContext) -> CssGridSize:
    let absolutized_value = css_style_value_absolutized(this.m_value, context)
    if absolutized_value == this.m_value:
        return *this
    return css_grid_size_new(absolutized_value)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:48 Web::CSS::GridSize::operator== (defaulted: the values
## compare by value).
pub func css_grid_size_eq(this: const CssGridSize*, other: CssGridSize) -> bool:
    return css_style_values_equal(this.m_value, other.m_value)

## Ported from Libraries/LibWeb/CSS/GridTrackSize.h:50 Web::CSS::GridSize::is_computationally_independent.
pub func css_grid_size_is_computationally_independent(this: const CssGridSize*) -> bool:
    return css_style_value_is_computationally_independent(this.m_value)

