# mark: CSSTransition ===========================================================================

## Ported from Libraries/LibWeb/CSS/CSSTransition.cpp:23 Web::CSS::CSSTransition::start_a_transition.
pub func css_transition_start_a_transition(abstract_element: DomAbstractElement, property_id: css_data.PropertyId, transition_generation: usize, delay: f64, start_time: f64, end_time: f64, start_value: CssStyleValue*, end_value: CssStyleValue*, reversing_adjusted_start_value: CssStyleValue*, reversing_shortening_factor: f64) -> CssTransition*:
    var element_reference = abstract_element
    let realm = dom_element_realm(dom_abstract_element_element(&element_reference))
    return realm_create_css_transition(realm, realm, abstract_element, property_id, transition_generation, delay, start_time, end_time, start_value, end_value, reversing_adjusted_start_value, reversing_shortening_factor)

## Ported from Libraries/LibWeb/CSS/CSSTransition.cpp:39 Web::CSS::CSSTransition::transition_property. (C++ answers the
## StringView of the property's name; the name is a FlyString here.)
pub func css_transition_transition_property(this: CssTransition*) -> ak.FlyString:
    return css_data.string_from_property_id(this.m_transition_property)

