## Ported from Libraries/LibWeb/CSS/Frequency.cpp:14 Web::CSS::Frequency::Frequency.
pub func css_frequency_construct(this: CssFrequency*, value: f64, unit_: css_data.FrequencyUnit):
    this.m_unit = unit_
    this.m_value = value

## `Frequency { value, unit }` as a value.
pub func css_frequency_new(value: f64, unit_: css_data.FrequencyUnit) -> CssFrequency:
    var frequency: CssFrequency = ---
    css_frequency_construct(&frequency, value, unit_)
    return frequency

## Ported from Libraries/LibWeb/CSS/Frequency.cpp:20 Web::CSS::Frequency::make_hertz.
pub func css_frequency_make_hertz(value: f64) -> CssFrequency:
    return css_frequency_new(value, css_data.FrequencyUnit.hz)

## Ported from Libraries/LibWeb/CSS/Frequency.cpp:25 Web::CSS::Frequency::percentage_of.
pub func css_frequency_percentage_of(this: const CssFrequency*, percentage: CssPercentage) -> CssFrequency:
    return css_frequency_new(css_percentage_as_fraction(&percentage) * this.m_value, this.m_unit)

## Ported from Libraries/LibWeb/CSS/Frequency.cpp:30 Web::CSS::Frequency::serialize.
pub func css_frequency_serialize(this: const CssFrequency*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal):
    # https://drafts.csswg.org/cssom/#serialize-a-css-value
    # -> <frequency>
    # The <number> component serialized as per <number> followed by the unit in its canonical form as defined in its
    # respective specification.
    if serialization_mode == css_syntax.SerializationMode.resolved_value:
        css_syntax.serialize_a_number_string_builder(builder, css_frequency_to_hertz(this))
        ak.string_builder_append(builder, "hz")
        return
    css_syntax.serialize_a_number_string_builder(builder, css_frequency_raw_value(this))
    let unit_name = css_frequency_unit_name(this)
    ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&unit_name))

## Ported from Libraries/LibWeb/CSS/Frequency.cpp:45 Web::CSS::Frequency::to_string.
pub func css_frequency_to_string(this: const CssFrequency*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal) -> ak.String:
    var builder = ak.string_builder_new()
    css_frequency_serialize(this, &builder, serialization_mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Frequency.cpp:52 Web::CSS::Frequency::to_hertz.
pub func css_frequency_to_hertz(this: const CssFrequency*) -> f64:
    return css_data.ratio_between_units_frequency_unit(this.m_unit, css_data.FrequencyUnit.hz) * this.m_value

## Ported from Libraries/LibWeb/CSS/Frequency.h:27 Web::CSS::Frequency::raw_value.
pub func css_frequency_raw_value(this: const CssFrequency*) -> f64:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/Frequency.h:28 Web::CSS::Frequency::unit.
pub func css_frequency_unit(this: const CssFrequency*) -> css_data.FrequencyUnit:
    return this.m_unit

## Ported from Libraries/LibWeb/CSS/Frequency.h:29 Web::CSS::Frequency::unit_name.
pub func css_frequency_unit_name(this: const CssFrequency*) -> ak.FlyString:
    return css_data.to_string_frequency_unit(this.m_unit)

## Ported from Libraries/LibWeb/CSS/Frequency.h:31 Web::CSS::Frequency::operator==.
pub func css_frequency_eq(this: const CssFrequency*, other: CssFrequency) -> bool:
    return this.m_unit == other.m_unit and this.m_value == other.m_value

## Ported from Libraries/LibWeb/CSS/Frequency.h:36 Web::CSS::Frequency::operator<=>.
pub func css_frequency_cmp(this: const CssFrequency*, other: CssFrequency) -> i32:
    let this_hertz = css_frequency_to_hertz(this)
    let other_hertz = css_frequency_to_hertz(&other)

    if this_hertz < other_hertz:
        return -1
    if this_hertz > other_hertz:
        return 1
    return 0
