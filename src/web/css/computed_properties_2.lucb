    return css_data.keyword_to_transform_style(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()")

# mark: Accent color, alignment, appearance, filters ============================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:817 Web::CSS::ComputedProperties::accent_color.
pub func css_computed_properties_accent_color(this: CssComputedProperties*, color_resolution_context: CssColorResolutionContext) -> gfx.Color:
    let value = css_computed_properties_property(this, css_data.PropertyId.accent_color)

    if css_style_value_to_keyword(value) == css_data.Keyword.auto:
        return css_system_color_accent_color(color_resolution_context.color_scheme else trap("VERIFY: Optional::value() of the color scheme"))

    return css_style_value_to_color(value, color_resolution_context) else trap("VERIFY: Optional::value() of to_color()")

