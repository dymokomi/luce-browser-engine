## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:845 Web::CSS::ComputedProperties::appearance.
pub func css_computed_properties_appearance(this: CssComputedProperties*) -> css_data.Appearance:
    let value = css_computed_properties_property(this, css_data.PropertyId.appearance)
    var appearance = css_data.keyword_to_appearance(css_style_value_to_keyword(value)) else trap("VERIFY: Optional::release_value()")
    match appearance:
        # Note: All these compatibility values can be treated as 'auto'
        .searchfield, .textarea, .push_button, .slider_horizontal, .checkbox, .radio, .square_button, .menulist, .listbox, .meter, .progress_bar, .button:
            appearance = css_data.Appearance.auto
        # NB: <compat-special> values behave like auto but can also have an effect. Preserve them.
        .textfield, .menulist_button:
            _ = appearance
        _:
            _ = appearance
    return appearance

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:875 Web::CSS::ComputedProperties::backdrop_filter.
pub func css_computed_properties_backdrop_filter(this: CssComputedProperties*) -> CssFilter:
    let value = css_computed_properties_property(this, css_data.PropertyId.backdrop_filter)
    if css_style_value_is_filter_value_list(value):
        var filter: CssFilter = ---
        css_filter_construct(&filter, css_style_value_as_filter_value_list(value).css_style_value())
        return filter
    return css_filter_make_none()

