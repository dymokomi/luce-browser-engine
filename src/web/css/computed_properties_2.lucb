# mark: SVG fill and stroke =====================================================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:422 Web::CSS::ComputedProperties::fill_opacity.
pub func css_computed_properties_fill_opacity(this: CssComputedProperties*) -> f32:
    return (f32)css_opacity_value_style_value_resolved(css_style_value_as_opacity_value(css_computed_properties_property(this, css_data.PropertyId.fill_opacity)))

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:427 Web::CSS::ComputedProperties::stroke_dasharray.
pub func css_computed_properties_stroke_dasharray(this: CssComputedProperties*) -> ak.Vector[CssLengthPercentageOrF32]:
    let value = css_computed_properties_property(this, css_data.PropertyId.stroke_dasharray)

    # none
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return ak.Vector[CssLengthPercentageOrF32]()

    let stroke_dasharray = css_style_value_list_values(css_style_value_as_value_list(value))
    var dashes: ak.Vector[CssLengthPercentageOrF32]

    for item in ak.vector_span_const(&stroke_dasharray):
        if css_style_value_is_length(item):
            ak.vector_append_t(&dashes, CssLengthPercentageOrF32.css_length_percentage(css_length_percentage_new_css_length(css_length_style_value_length(css_style_value_as_length(item)))))
        elif css_style_value_is_percentage(item):
            ak.vector_append_t(&dashes, CssLengthPercentageOrF32.css_length_percentage(css_length_percentage_new_css_percentage(css_percentage_style_value_percentage(css_style_value_as_percentage(item)))))
        elif css_style_value_is_calculated(item):
            let calculated_value = css_style_value_as_calculated(item)

            if css_calculated_style_value_resolves_to_length(calculated_value):
                ak.vector_append_t(&dashes, CssLengthPercentageOrF32.css_length_percentage(css_length_percentage_new_css_calculated_style_value(calculated_value)))
            elif css_calculated_style_value_resolves_to_number(calculated_value):
                let number = css_calculated_style_value_resolve_number(calculated_value, CssCalculationResolutionContext()) else trap("VERIFY: Optional::value() of resolve_number()")
                ak.vector_append_t(&dashes, CssLengthPercentageOrF32.f32_((f32)number))
            else:
                trap("VERIFY_NOT_REACHED")
        elif css_style_value_is_number(item):
            ak.vector_append_t(&dashes, CssLengthPercentageOrF32.f32_((f32)css_number_style_value_number(css_style_value_as_number(item))))
        else:
            trap("VERIFY_NOT_REACHED")

    return dashes

