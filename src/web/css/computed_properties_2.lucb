## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:769 Web::CSS::ComputedProperties::perspective.
pub func css_computed_properties_perspective(this: CssComputedProperties*) -> gfx.CssPixels?:
    let value = css_computed_properties_property(this, css_data.PropertyId.perspective)
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return none

    let length = css_length_from_style_value(value, none)
    return css_length_absolute_length_to_px(&length)

