# mark: Transforms ==============================================================================

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:717 Web::CSS::ComputedProperties::transformations_for_style_value.
pub func css_computed_properties_transformations_for_style_value(value: CssStyleValue*) -> ak.Vector[CssTransformationStyleValue*]:
    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.none_:
        return ak.Vector[CssTransformationStyleValue*]()

    if not css_style_value_is_value_list(value):
        return ak.Vector[CssTransformationStyleValue*]()

    let list = css_style_value_list_values(css_style_value_as_value_list(value))
    var transformations: ak.Vector[CssTransformationStyleValue*]
    for transform_value in ak.vector_span_const(&list):
        assert(css_style_value_is_transformation(transform_value))
        ak.vector_append_t(&transformations, css_style_value_as_transformation(transform_value))
    return transformations

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:734 Web::CSS::ComputedProperties::transformations.
pub func css_computed_properties_transformations(this: CssComputedProperties*) -> ak.Vector[CssTransformationStyleValue*]:
    return css_computed_properties_transformations_for_style_value(css_computed_properties_property(this, css_data.PropertyId.transform))

