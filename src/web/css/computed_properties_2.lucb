# mark: Backgrounds and tables ==================================================================

## The entry `property_id` of a coordinated value list (C++ `coordinated_value_list.get(id)`, then `->` or `.value()`).
func css_computed_properties_coordinated_values(list: const ak.HashMap[css_data.PropertyId, ak.Vector[CssStyleValue*], css_data.PropertyIdTraits]*, property_id: css_data.PropertyId) -> const ak.Vector[CssStyleValue*]*:
    return ak.hash_map_get_k_const(list, property_id) else trap("VERIFY: Optional::value() of a coordinated value list entry")

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:561 Web::CSS::ComputedProperties::background_layers.
# https://drafts.csswg.org/css-backgrounds-4/#layering
pub func css_computed_properties_background_layers(this: CssComputedProperties*) -> ak.Vector[CssBackgroundLayerData]:
    let background_image_values = css_style_value_list_values(css_style_value_as_value_list(css_computed_properties_property(this, css_data.PropertyId.background_image)))

    # OPTIMIZATION: If all background-image values are `none`, we can skip computing the layers entirely
    var all_none = true
    for value in ak.vector_span_const(&background_image_values):
        if css_style_value_to_keyword(value) != css_data.Keyword.none_:
            all_none = false
            break
    if all_none:
        return ak.Vector[CssBackgroundLayerData]()

    var property_ids: ak.Vector[css_data.PropertyId]
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_attachment)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_blend_mode)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_clip)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_image)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_origin)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_position_x)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_position_y)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_repeat)
    ak.vector_append_t(&property_ids, css_data.PropertyId.background_size)
    let coordinated_value_list = css_computed_properties_assemble_coordinated_value_list(this, css_data.PropertyId.background_image, property_ids)

    let images = css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_image)
    var layers: ak.Vector[CssBackgroundLayerData]
    # The number of layers is determined by the number of comma-separated values in the background-image property
    ak.vector_ensure_capacity(&layers, ak.vector_size(images))

    for i in 0..<ak.vector_size(images):
        let background_image_value = *ak.vector_at_const(images, i)

        if css_style_value_to_keyword(background_image_value) == css_data.Keyword.none_:
            continue

        let background_attachment_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_attachment), i)
        let background_blend_mode_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_blend_mode), i)
        let background_clip_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_clip), i)
        let background_origin_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_origin), i)
        let background_position_x_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_position_x), i)
        let background_position_y_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_position_y), i)
        let background_repeat_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_repeat), i)
        let background_size_value = *ak.vector_at_const(css_computed_properties_coordinated_values(&coordinated_value_list, css_data.PropertyId.background_size), i)

        var layer: CssBackgroundLayerData = ---
        css_background_layer_data_init_fields(&layer)
        layer.background_image = css_style_value_as_abstract_image(background_image_value)

        layer.attachment = css_data.keyword_to_background_attachment(css_style_value_to_keyword(background_attachment_value)) else trap("VERIFY: Optional::value()")
        layer.blend_mode = css_data.keyword_to_mix_blend_mode(css_style_value_to_keyword(background_blend_mode_value)) else trap("VERIFY: Optional::value()")
        layer.clip = css_data.keyword_to_background_box(css_style_value_to_keyword(background_clip_value)) else trap("VERIFY: Optional::value()")

        layer.origin = css_data.keyword_to_background_box(css_style_value_to_keyword(background_origin_value)) else trap("VERIFY: Optional::value()")

        layer.position_x = css_length_percentage_from_style_value(css_edge_style_value_offset(css_style_value_as_edge(background_position_x_value)))
        layer.position_y = css_length_percentage_from_style_value(css_edge_style_value_offset(css_style_value_as_edge(background_position_y_value)))

        layer.repeat_x = css_repeat_style_style_value_repeat_x(css_style_value_as_repeat_style(background_repeat_value))
        layer.repeat_y = css_repeat_style_style_value_repeat_y(css_style_value_as_repeat_style(background_repeat_value))

        if css_style_value_is_background_size(background_size_value):
            layer.size_type = CssBackgroundSize.length_percentage
            layer.size_x = css_length_percentage_or_auto_from_style_value(css_background_size_style_value_size_x(css_style_value_as_background_size(background_size_value)))
            layer.size_y = css_length_percentage_or_auto_from_style_value(css_background_size_style_value_size_y(css_style_value_as_background_size(background_size_value)))
        elif css_style_value_is_keyword(background_size_value):
            match css_style_value_to_keyword(background_size_value):
                .contain:
                    layer.size_type = CssBackgroundSize.contain
                .cover:
                    layer.size_type = CssBackgroundSize.cover
                _:
                    trap("VERIFY_NOT_REACHED")
        else:
            trap("VERIFY_NOT_REACHED")

        ak.vector_unchecked_append_u(&layers, layer)

    return layers

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:644 Web::CSS::ComputedProperties::background_color_clip.
pub func css_computed_properties_background_color_clip(this: CssComputedProperties*) -> css_data.BackgroundBox:
    # The background color is clipped according to the final layer's background-clip value. We propagate this
    # separately to allow us to avoid computing layer data in the case a layer's `background-image` is `none`

    let background_image_values = css_style_value_list_values(css_style_value_as_value_list(css_computed_properties_property(this, css_data.PropertyId.background_image)))
    let background_clip_values = css_style_value_list_values(css_style_value_as_value_list(css_computed_properties_property(this, css_data.PropertyId.background_clip)))

    # Background clip values are coordinated against background image values so the value used for the final layer is
    # not necessarily the last specified one.
    let final_layer_index = (ak.vector_size(&background_image_values) - 1) % ak.vector_size(&background_clip_values)

    return css_data.keyword_to_background_box(css_style_value_to_keyword(*ak.vector_at_const(&background_clip_values, final_layer_index))) else trap("VERIFY: Optional::value()")

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:659 Web::CSS::ComputedProperties::border_spacing_horizontal.
pub func css_computed_properties_border_spacing_horizontal(this: CssComputedProperties*) -> CssLength:
    let style_value = css_computed_properties_property(this, css_data.PropertyId.border_spacing)

    if css_style_value_is_value_list(style_value):
        let list = css_style_value_as_value_list(style_value)
        assert(css_style_value_list_size(list) > 0)
        return css_length_from_style_value(css_style_value_list_value_at(list, 0, false), none)

    return css_length_from_style_value(style_value, none)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:672 Web::CSS::ComputedProperties::border_spacing_vertical.
pub func css_computed_properties_border_spacing_vertical(this: CssComputedProperties*) -> CssLength:
    let style_value = css_computed_properties_property(this, css_data.PropertyId.border_spacing)

    if css_style_value_is_value_list(style_value):
        let list = css_style_value_as_value_list(style_value)
        assert(css_style_value_list_size(list) > 1)
        return css_length_from_style_value(css_style_value_list_value_at(list, 1, false), none)

    return css_length_from_style_value(style_value, none)

