## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:691 Web::CSS::ComputedProperties::clip.
pub func css_computed_properties_clip(this: CssComputedProperties*) -> CssClip:
    let value = css_computed_properties_property(this, css_data.PropertyId.clip)
    if not css_style_value_is_rect(value):
        return css_clip_make_auto()
    var clip: CssClip = ---
    css_clip_construct_css_edge_rect(&clip, css_rect_style_value_rect(css_style_value_as_rect(value)))
    return clip

