## The `length_percentage_with_keywords_resolved` lambda of ComputedProperties::transform_origin.
func css_computed_properties_length_percentage_with_keywords_resolved(value: CssStyleValue*) -> CssLengthPercentage:
    if css_style_value_is_keyword(value):
        let keyword = css_style_value_to_keyword(value)
        if keyword == css_data.Keyword.left or keyword == css_data.Keyword.top:
            return css_length_percentage_new_css_percentage(css_percentage_new(0.0))
        if keyword == css_data.Keyword.center:
            return css_length_percentage_new_css_percentage(css_percentage_new(50.0))
        if keyword == css_data.Keyword.right or keyword == css_data.Keyword.bottom:
            return css_length_percentage_new_css_percentage(css_percentage_new(100.0))

        trap("VERIFY_NOT_REACHED")
    return css_length_percentage_from_style_value(value)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:783 Web::CSS::ComputedProperties::transform_origin.
pub func css_computed_properties_transform_origin(this: CssComputedProperties*) -> CssTransformOrigin:
    let value = css_computed_properties_property(this, css_data.PropertyId.transform_origin)
    if not css_style_value_is_value_list(value) or css_style_value_list_size(css_style_value_as_value_list(value)) != 3:
        return css_transform_origin_new()
    let list = css_style_value_list_values(css_style_value_as_value_list(value))

    let x_value = css_computed_properties_length_percentage_with_keywords_resolved(*ak.vector_at_const(&list, 0))
    let y_value = css_computed_properties_length_percentage_with_keywords_resolved(*ak.vector_at_const(&list, 1))
    let z_value = css_length_percentage_from_style_value(*ak.vector_at_const(&list, 2))
    return CssTransformOrigin(x = x_value, y = y_value, z = z_value)

## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:811 Web::CSS::ComputedProperties::transform_style.
pub func css_computed_properties_transform_style(this: CssComputedProperties*) -> css_data.TransformStyle:
