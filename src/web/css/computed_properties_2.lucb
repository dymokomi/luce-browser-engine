## Ported from Libraries/LibWeb/CSS/ComputedProperties.cpp:519 Web::CSS::ComputedProperties::flex_basis.
pub func css_computed_properties_flex_basis(this: CssComputedProperties*) -> CssFlexBasis:
    let value = css_computed_properties_property(this, css_data.PropertyId.flex_basis)

    if css_style_value_is_keyword(value) and css_style_value_to_keyword(value) == css_data.Keyword.content:
