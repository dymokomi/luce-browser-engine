## Ported from Libraries/LibWeb/CSS/Resolution.cpp:15 Web::CSS::Resolution::Resolution.
pub func css_resolution_construct(this: CssResolution*, value: f64, unit_: css_data.ResolutionUnit):
    this.m_unit = unit_
    this.m_value = value

## `Resolution { value, unit }` as a value.
pub func css_resolution_new(value: f64, unit_: css_data.ResolutionUnit) -> CssResolution:
    var resolution: CssResolution = ---
    css_resolution_construct(&resolution, value, unit_)
    return resolution

## Ported from Libraries/LibWeb/CSS/Resolution.cpp:21 Web::CSS::Resolution::make_dots_per_pixel.
pub func css_resolution_make_dots_per_pixel(value: f64) -> CssResolution:
    return css_resolution_new(value, css_data.ResolutionUnit.dppx)

## Ported from Libraries/LibWeb/CSS/Resolution.cpp:26 Web::CSS::Resolution::from_style_value.
pub func css_resolution_from_style_value(style_value: CssStyleValue*) -> CssResolution:
    if css_style_value_is_resolution(style_value):
        return css_resolution_style_value_resolution(css_style_value_as_resolution(style_value))

    if css_style_value_is_calculated(style_value):
        return css_calculated_style_value_resolve_resolution(css_style_value_as_calculated(style_value), CssCalculationResolutionContext()) else trap("VERIFY: a resolved resolution")

    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/Resolution.cpp:37 Web::CSS::Resolution::serialize.
pub func css_resolution_serialize(this: const CssResolution*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal):
    # https://drafts.csswg.org/cssom/#serialize-a-css-value
    # -> <resolution>
    # The resolution in dots per CSS pixel serialized as per <number> followed by the literal string "dppx".
    # AD-HOC: WPT expects us to serialize using the actual unit, like for other dimensions.
    #         https://github.com/w3c/csswg-drafts/issues/12616
    if serialization_mode == css_syntax.SerializationMode.resolved_value:
        css_syntax.serialize_a_number_string_builder(builder, css_resolution_to_dots_per_pixel(this))
        ak.string_builder_append(builder, "dppx")
        return
    css_syntax.serialize_a_number_string_builder(builder, css_resolution_raw_value(this))
    let unit_name = css_resolution_unit_name(this)
    ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&unit_name))

## Ported from Libraries/LibWeb/CSS/Resolution.cpp:53 Web::CSS::Resolution::to_string.
pub func css_resolution_to_string(this: const CssResolution*, serialization_mode: css_syntax.SerializationMode = css_syntax.SerializationMode.normal) -> ak.String:
    var builder = ak.string_builder_new()
    css_resolution_serialize(this, &builder, serialization_mode)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/Resolution.cpp:60 Web::CSS::Resolution::to_dots_per_pixel.
pub func css_resolution_to_dots_per_pixel(this: const CssResolution*) -> f64:
    return css_data.ratio_between_units_resolution_unit(this.m_unit, css_data.ResolutionUnit.dppx) * this.m_value

## Ported from Libraries/LibWeb/CSS/Resolution.h:28 Web::CSS::Resolution::raw_value.
pub func css_resolution_raw_value(this: const CssResolution*) -> f64:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/Resolution.h:29 Web::CSS::Resolution::unit.
pub func css_resolution_unit(this: const CssResolution*) -> css_data.ResolutionUnit:
    return this.m_unit

## Ported from Libraries/LibWeb/CSS/Resolution.h:30 Web::CSS::Resolution::unit_name.
pub func css_resolution_unit_name(this: const CssResolution*) -> ak.FlyString:
    return css_data.to_string_resolution_unit(this.m_unit)

## Ported from Libraries/LibWeb/CSS/Resolution.h:32 Web::CSS::Resolution::operator==.
pub func css_resolution_eq(this: const CssResolution*, other: CssResolution) -> bool:
    return this.m_unit == other.m_unit and this.m_value == other.m_value

## Ported from Libraries/LibWeb/CSS/Resolution.h:37 Web::CSS::Resolution::operator<=>.
pub func css_resolution_cmp(this: const CssResolution*, other: CssResolution) -> i32:
    let this_dots_per_pixel = css_resolution_to_dots_per_pixel(this)
    let other_dots_per_pixel = css_resolution_to_dots_per_pixel(&other)

    if this_dots_per_pixel < other_dots_per_pixel:
        return -1
    if this_dots_per_pixel > other_dots_per_pixel:
        return 1
    return 0
