## Ported from Libraries/LibWeb/CSS/SystemColor.cpp:21 Web::CSS::SystemColor::active_text.
pub func css_system_color_active_text(scheme: CssPreferredColorScheme) -> gfx.Color:
    if scheme == CssPreferredColorScheme.dark:
        return gfx.color_new_u8_u8_u8(213, 97, 82)
    return gfx.color_new_u8_u8_u8(255, 0, 0)

