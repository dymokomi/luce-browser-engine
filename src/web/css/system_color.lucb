## Ported from Libraries/LibWeb/CSS/SystemColor.cpp:11 Web::CSS::SystemColor::accent_color.
pub func css_system_color_accent_color(arg0: CssPreferredColorScheme) -> gfx.Color:
    discard(arg0)
    return gfx.color_new_u8_u8_u8(61, 174, 233)

