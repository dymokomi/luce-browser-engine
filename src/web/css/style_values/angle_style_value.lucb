## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.h:19 Web::CSS::AngleStyleValue::create.
pub func css_angle_style_value_create(angle: CssAngle) -> CssAngleStyleValue*:
    let this = &(new CssAngleStyleValue[1] --- else trap("out of memory"))[0]
    css_angle_style_value_construct(this, angle)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.cpp:14 Web::CSS::AngleStyleValue::AngleStyleValue.
pub func css_angle_style_value_construct(this: CssAngleStyleValue*, angle: CssAngle):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.angle)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_angle_style_value_vtable, &css_angle_style_value_class)
    this.m_angle = angle

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.h:25 Web::CSS::AngleStyleValue::angle.
pub func css_angle_style_value_angle(this: CssAngleStyleValue*) -> CssAngle:
    return this.m_angle

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.h:26 Web::CSS::AngleStyleValue::raw_value (override).
pub func css_angle_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssAngleStyleValue*)base
    return css_angle_raw_value(&this.m_angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.h:27 Web::CSS::AngleStyleValue::unit_name (override).
pub func css_angle_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssAngleStyleValue*)base
    return css_angle_unit_name(&this.m_angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.cpp:22 Web::CSS::AngleStyleValue::serialize (override).
pub func css_angle_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssAngleStyleValue*)base
    css_angle_serialize(&this.m_angle, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.cpp:27 Web::CSS::AngleStyleValue::equals (override).
pub func css_angle_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssAngleStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_angle = css_style_value_as_angle(other)
    return css_angle_eq(&this.m_angle, other_angle.m_angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/AngleStyleValue.h:33 Web::CSS::AngleStyleValue::is_computationally_independent (override).
pub func css_angle_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true
