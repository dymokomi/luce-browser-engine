# mark: The type of a numeric value =============================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:635 Web::CSS::numeric_type_from_calculated_style_value.
func css_numeric_type_from_calculated_style_value(value: CssCalculationNodeNumericValue, context: CssCalculationContext) -> CssNumericType:
    # https://drafts.csswg.org/css-values-4/#determine-the-type-of-a-calculation
    # Anything else is a terminal value, whose type is determined based on its CSS type.
    # (Unless otherwise specified, the type’s associated percent hint is null.)
    match value:
        .number(_):
            # -> <number>
            # -> <integer>
            #    the type is «[ ]» (empty map)
            return CssNumericType()
        .css_length(_):
            # -> <length>
            #    the type is «[ "length" → 1 ]»
            return css_numeric_type_new(.length, 1)
        .css_angle(_):
            # -> <angle>
            #    the type is «[ "angle" → 1 ]»
            return css_numeric_type_new(.angle, 1)
        .css_time(_):
            # -> <time>
            #    the type is «[ "time" → 1 ]»
            return css_numeric_type_new(.time, 1)
        .css_frequency(_):
            # -> <frequency>
            #    the type is «[ "frequency" → 1 ]»
            return css_numeric_type_new(.frequency, 1)
        .css_resolution(_):
            # -> <resolution>
            #    the type is «[ "resolution" → 1 ]»
            return css_numeric_type_new(.resolution, 1)
        .css_flex(_):
            # -> <flex>
            #    the type is «[ "flex" → 1 ]»
            return css_numeric_type_new(.flex, 1)
        # NOTE: <calc-constant> is a separate node type. (FIXME: Should it be?)
        .css_percentage(_):
            # -> <percentage>
            #    If, in the context in which the math function containing this calculation is placed,
            #    <percentage>s are resolved relative to another type of value (such as in width,
            #    where <percentage> is resolved against a <length>), and that other type is not <number>,
            #    the type is determined as the other type, but with a percent hint set to that other type.
            if let resolve_as = context.percentages_resolve_as:
                if resolve_as != CssValueType.number and resolve_as != CssValueType.percentage:
                    let base_type = css_numeric_type_base_type_from_value_type(resolve_as) else trap("VERIFY: base_type.has_value()")
                    var result = css_numeric_type_new(base_type, 1)
                    css_numeric_type_set_percent_hint(&result, base_type)
                    return result

            #    Otherwise, the type is «[ "percent" → 1 ]», with a percent hint of "percent".
            let result = css_numeric_type_new(.percent, 1)
            # FIXME: Setting the percent hint to "percent" causes us to fail tests.
            # result.set_percent_hint(NumericType::BaseType::Percent);
            return result

# mark: NumericCalculationNode ==================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:700 Web::CSS::NumericCalculationNode::create.
pub func css_numeric_calculation_node_create(value: CssCalculationNodeNumericValue, context: CssCalculationContext) -> CssNumericCalculationNode*:
    let numeric_type = css_numeric_type_from_calculated_style_value(value, context)
    let this = &(new CssNumericCalculationNode[1] --- else trap("out of memory"))[0]
    css_numeric_calculation_node_construct(this, value, numeric_type)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:706 Web::CSS::NumericCalculationNode::from_keyword.
pub func css_numeric_calculation_node_from_keyword(keyword: css_data.Keyword, context: CssCalculationContext) -> CssNumericCalculationNode*?:
    match keyword:
        .e:
            # https://drafts.csswg.org/css-values-4/#valdef-calc-e
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.NumberType.number, ak.e_f64)), context)
        .pi:
            # https://drafts.csswg.org/css-values-4/#valdef-calc-pi
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.NumberType.number, ak.pi_f64)), context)
        .infinity:
            # https://drafts.csswg.org/css-values-4/#valdef-calc-infinity
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.NumberType.number, math.infinity)), context)
        .negative_infinity:
            # https://drafts.csswg.org/css-values-4/#valdef-calc--infinity
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.NumberType.number, -math.infinity)), context)
        .nan:
            # https://drafts.csswg.org/css-values-4/#valdef-calc-nan
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.NumberType.number, math.nan)), context)
        _:
            return none

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:729 Web::CSS::NumericCalculationNode::NumericCalculationNode.
pub func css_numeric_calculation_node_construct(this: CssNumericCalculationNode*, value: CssCalculationNodeNumericValue, numeric_type: CssNumericType):
    css_calculation_node_construct(this.css_calculation_node(), .numeric, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_numeric_calculation_node_vtable, &css_numeric_calculation_node_class)
    this.m_value = value

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:737 Web::CSS::NumericCalculationNode::serialize_value.
pub func css_numeric_calculation_node_serialize_value(this: CssNumericCalculationNode*, builder: ak.StringBuilder*):
    css_numeric_value_serialize(&this.m_value, builder)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:742 Web::CSS::NumericCalculationNode::value_to_string.
pub func css_numeric_calculation_node_value_to_string(this: CssNumericCalculationNode*) -> ak.String:
    var builder = ak.StringBuilder()
    ak.string_builder_construct(&builder)
    css_numeric_calculation_node_serialize_value(this, &builder)
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:749 Web::CSS::NumericCalculationNode::contains_percentage (override).
pub func css_numeric_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssNumericCalculationNode*)base
    return css_numeric_value_is_percentage(&this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:754 Web::CSS::NumericCalculationNode::is_in_canonical_unit.
pub func css_numeric_calculation_node_is_in_canonical_unit(this: CssNumericCalculationNode*) -> bool:
    match this.m_value:
        .css_angle(angle): return css_angle_unit(&angle) == css_data.AngleUnit.deg
        .css_flex(flex): return css_flex_unit(&flex) == css_data.FlexUnit.fr
        .css_frequency(frequency): return css_frequency_unit(&frequency) == css_data.FrequencyUnit.hz
        .css_length(length): return css_length_unit(&length) == css_data.LengthUnit.px
        .number(_): return true
        .css_percentage(_): return true
        .css_resolution(resolution): return css_resolution_unit(&resolution) == css_data.ResolutionUnit.dppx
        .css_time(time): return css_time_unit(&time) == css_data.TimeUnit.s

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:767 Web::CSS::try_get_value_with_canonical_unit.
func css_try_get_value_with_canonical_unit(child: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    if css_calculation_node_type(child) != CssCalculationNodeType.numeric:
        return none
    let numeric_child = as_css_numeric_calculation_node(child)

    # Can't run with non-canonical units or unresolved percentages.
    # We've already attempted to resolve both in with_simplified_children().
    if (not css_numeric_calculation_node_is_in_canonical_unit(numeric_child) or (css_numeric_value_is_percentage(&numeric_child.m_value) and context.percentages_resolve_as != none)):
        return none

    # Can't run if a child has an invalid type.
    if css_calculation_node_numeric_type(child) == none:
        return none

    return css_calculated_style_value_calculation_result_from_value(numeric_child.m_value, resolution_context, css_calculation_node_numeric_type(child))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:786 Web::CSS::try_get_number.
func css_try_get_number(child: CssCalculationNode*) -> f64?:
    if css_calculation_node_type(child) != CssCalculationNodeType.numeric:
        return none
    let maybe_number = css_numeric_value_number(&as_css_numeric_calculation_node(child).m_value) else return none
    return css_syntax.number_value(&maybe_number)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:796 Web::CSS::NumericCalculationNode::infinite_or_nan_value.
pub func css_numeric_calculation_node_infinite_or_nan_value(this: CssNumericCalculationNode*) -> CssNonFiniteValue?:
    var raw_value = 0.0
    match this.m_value:
        .number(number): raw_value = css_syntax.number_value(&number)
        .css_percentage(percentage): raw_value = css_percentage_as_fraction(&percentage)
        _: raw_value = css_numeric_value_dimension_raw_value(&this.m_value)

    if math.is_nan(raw_value):
        return CssNonFiniteValue.na_n
    if not math.is_finite(raw_value):
        if raw_value < 0.0:
            return CssNonFiniteValue.negative_infinity
        return CssNonFiniteValue.infinity

    return none

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:814 Web::CSS::NumericCalculationNode::is_negative.
pub func css_numeric_calculation_node_is_negative(this: CssNumericCalculationNode*) -> bool:
    match this.m_value:
        .number(number): return css_syntax.number_value(&number) < 0.0
        .css_percentage(percentage): return css_percentage_value(&percentage) < 0.0
        _: return css_numeric_value_dimension_raw_value(&this.m_value) < 0.0

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:822 Web::CSS::NumericCalculationNode::negated.
pub func css_numeric_calculation_node_negated(this: CssNumericCalculationNode*, context: CssCalculationContext) -> CssNumericCalculationNode*:
    match this.m_value:
        .css_percentage(percentage):
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.css_percentage(css_percentage_new(-css_percentage_value(&percentage))), context)
        .number(number):
            return css_numeric_calculation_node_create(CssCalculationNodeNumericValue.number(css_syntax.number_create(css_syntax.number_type(&number), -css_syntax.number_value(&number))), context)
        _:
            return css_numeric_calculation_node_create(css_numeric_value_dimension_with_raw_value(&this.m_value, -css_numeric_value_dimension_raw_value(&this.m_value)), context)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:836 Web::CSS::NumericCalculationNode::dump (override).
pub func css_numeric_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssNumericCalculationNode*)base
    let value_string = css_numeric_value_to_string(&this.m_value)
    css_appendff(builder, "{: >{}}NUMERIC({})\n", [ak.arg_str(""), ak.arg_i64((i64)indent), css_arg_string(&value_string)])

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:841 Web::CSS::NumericCalculationNode::equals (override).
pub func css_numeric_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssNumericCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_numeric_values_equal(&this.m_value, &((CssNumericCalculationNode*)other).m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:850 Web::CSS::NumericCalculationNode::is_computationally_independent (override).
pub func css_numeric_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssNumericCalculationNode*)base
    match this.m_value:
        .css_length(length): return css_length_is_computationally_independent(&length)
        _: return true

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:857 Web::CSS::NumericCalculationNode::reify (override).
pub func css_numeric_calculation_node_reify_impl(base: CssCalculationNode*, realm: Realm*) -> CssNumericValue*?:
    let this = (CssNumericCalculationNode*)base
    match this.m_value:
        .number(number):
            return (CssNumericValue*)css_unit_value_create(realm, css_syntax.number_value(&number), ak.fly_string_from_str("number"))
        .css_percentage(percentage):
            return (CssNumericValue*)css_unit_value_create(realm, css_percentage_value(&percentage), ak.fly_string_from_str("percent"))
        _:
            return (CssNumericValue*)css_unit_value_create(realm, css_numeric_value_dimension_raw_value(&this.m_value), css_numeric_value_dimension_unit_name(&this.m_value))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:276 Web::CSS::NumericCalculationNode::with_simplified_children (override).
pub func css_numeric_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, arg0: CssCalculationContext, arg1: CssCalculationResolutionContext) -> CssCalculationNode*:
    _ = arg0
    _ = arg1
    return base

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:278 Web::CSS::NumericCalculationNode::children (override).
pub func css_numeric_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
