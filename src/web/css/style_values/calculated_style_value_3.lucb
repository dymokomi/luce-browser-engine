pub func css_product_calculation_node_create(values: ak.Vector[CssCalculationNode*]) -> CssProductCalculationNode*:
    # https://drafts.csswg.org/css-values-4/#determine-the-type-of-a-calculation
    # At a * sub-expression, multiply the types of the left and right arguments.
    # The sub-expression’s type is the returned result.
    let numeric_type = css_multiply_the_types(&values)
    let this = &(new CssProductCalculationNode[1] --- else trap("out of memory"))[0]
    css_product_calculation_node_construct(this, values, numeric_type)
    return this

