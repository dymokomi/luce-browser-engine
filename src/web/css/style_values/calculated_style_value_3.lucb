# mark: SumCalculationNode ======================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:865 Web::CSS::SumCalculationNode::create.
pub func css_sum_calculation_node_create(values: ak.Vector[CssCalculationNode*]) -> CssSumCalculationNode*:
    # https://www.w3.org/TR/css-values-4/#determine-the-type-of-a-calculation
    # At a + or - sub-expression, attempt to add the types of the left and right arguments.
    # If this returns failure, the entire calculation’s type is failure.
    # Otherwise, the sub-expression’s type is the returned type.
    let numeric_type = css_add_the_types_vector(&values)
    let this = &(new CssSumCalculationNode[1] --- else trap("out of memory"))[0]
    css_sum_calculation_node_construct(this, values, numeric_type)
    return this

## css_sum_calculation_node_create as a CssCreateFromChildren.
func css_sum_calculation_node_create_node(values: ak.Vector[CssCalculationNode*]) -> CssCalculationNode*:
    return css_sum_calculation_node_create(values).css_calculation_node()

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:875 Web::CSS::SumCalculationNode::SumCalculationNode.
pub func css_sum_calculation_node_construct(this: CssSumCalculationNode*, values: ak.Vector[CssCalculationNode*], numeric_type: CssNumericType?):
    css_calculation_node_construct(this.css_calculation_node(), .sum, numeric_type)
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_sum_calculation_node_vtable, &css_sum_calculation_node_class)
    this.m_values = values
    assert(not ak.vector_is_empty(&this.m_values))

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:884 Web::CSS::SumCalculationNode::contains_percentage (override).
pub func css_sum_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssSumCalculationNode*)base
    for value in ak.vector_span_const(&this.m_values):
        if css_calculation_node_contains_percentage(value):
            return true
    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:893 Web::CSS::SumCalculationNode::with_simplified_children (override).
pub func css_sum_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    return css_simplify_children_vector(base, css_sum_calculation_node_create_node, context, resolution_context)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:898 Web::CSS::SumCalculationNode::dump (override).
pub func css_sum_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssSumCalculationNode*)base
    css_appendff(builder, "{: >{}}SUM:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    for item in ak.vector_span_const(&this.m_values):
        css_calculation_node_dump(item, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:905 Web::CSS::SumCalculationNode::equals (override).
pub func css_sum_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssSumCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_calculation_node_vectors_equal(&this.m_values, &((CssSumCalculationNode*)other).m_values)

## The element-wise `equals` of two lists of children, sizes first (Sum, Product, Min and Max nodes' `equals`).
func css_calculation_node_vectors_equal(a: const ak.Vector[CssCalculationNode*]*, b: const ak.Vector[CssCalculationNode*]*) -> bool:
    if ak.vector_size(a) != ak.vector_size(b):
        return false
    for i in 0..<ak.vector_size(a):
        if not css_calculation_node_equals(*ak.vector_at_const(a, i), *ak.vector_at_const(b, i)):
            return false
    return true

## `all_of(values, is_computationally_independent)`.
func css_calculation_nodes_are_computationally_independent(values: const ak.Vector[CssCalculationNode*]*) -> bool:
    for value in ak.vector_span_const(values):
        if not css_calculation_node_is_computationally_independent(value):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:920 Web::CSS::SumCalculationNode::is_computationally_independent (override).
pub func css_sum_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssSumCalculationNode*)base
    return css_calculation_nodes_are_computationally_independent(&this.m_values)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:925 Web::CSS::SumCalculationNode::reify (override).
pub func css_sum_calculation_node_reify_impl(base: CssCalculationNode*, realm: Realm*) -> CssNumericValue*?:
    let this = (CssSumCalculationNode*)base
    let reified_children = css_reify_children(realm, ak.vector_span_const(&this.m_values)) else return none
    return css_math_sum_create(realm, css_calculation_node_numeric_type(base) else trap("VERIFY: has_value"), reified_children)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:305 Web::CSS::SumCalculationNode::children (override).
pub func css_sum_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssSumCalculationNode*)base
    return this.m_values

