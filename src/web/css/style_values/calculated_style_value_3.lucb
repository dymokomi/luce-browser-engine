## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:279 Web::CSS::NumericCalculationNode::value.
pub func css_numeric_calculation_node_value(this: CssNumericCalculationNode*) -> CssCalculationNodeNumericValue:
