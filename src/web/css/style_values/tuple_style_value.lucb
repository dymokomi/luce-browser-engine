## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.h:69 Web::CSS::TupleStyleValue::TupleStyleValue.
pub func css_tuple_style_value_construct(this: CssTupleStyleValue*, values: ak.Vector[CssStyleValue*?]):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.tuple)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_tuple_style_value_vtable, &css_tuple_style_value_class)
    this.m_tuple = values
