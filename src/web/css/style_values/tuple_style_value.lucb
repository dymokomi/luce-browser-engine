## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.h:15 Web::CSS::TupleStyleValue::create.
pub func css_tuple_style_value_create(values: ak.Vector[CssStyleValue*?]) -> CssTupleStyleValue*:
    let this = &(new CssTupleStyleValue[1] --- else trap("out of memory"))[0]
    css_tuple_style_value_construct(this, values)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.h:21 Web::CSS::TupleStyleValue::tuple.
pub func css_tuple_style_value_tuple(this: CssTupleStyleValue*) -> ak.Vector[CssStyleValue*?]:
    return this.m_tuple

## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.cpp:11 Web::CSS::TupleStyleValue::serialize (override).
pub func css_tuple_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssTupleStyleValue*)base
    var first = true
    for maybe_value in ak.vector_span_const(&this.m_tuple):
        if let value = maybe_value:
            if not first:
                ak.string_builder_append_u8(builder, ' ')
            css_style_value_serialize(value, builder, mode)
            first = false

## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.cpp:25 Web::CSS::TupleStyleValue::absolutized (override).
pub func css_tuple_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssTupleStyleValue*)base
    var absolutized_tuple = ak.Vector[CssStyleValue*?]()
    ak.vector_ensure_capacity(&absolutized_tuple, ak.vector_size(&this.m_tuple))
    var any_value_changed = false
    for maybe_value in ak.vector_span_const(&this.m_tuple):
        if let value = maybe_value:
            let absolutized_value = css_style_value_absolutized(value, context)
            if not css_style_values_equal(absolutized_value, value):
                any_value_changed = true
            ak.vector_append_t(&absolutized_tuple, absolutized_value)
        else:
            ak.vector_append_t(&absolutized_tuple, none)

    if not any_value_changed:
        return base

    return css_tuple_style_value_create(absolutized_tuple).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.h:28 Web::CSS::TupleStyleValue::properties_equal.
pub func css_tuple_style_value_properties_equal(this: CssTupleStyleValue*, other: CssTupleStyleValue*) -> bool:
    if ak.vector_size(&this.m_tuple) != ak.vector_size(&other.m_tuple):
        return false
    for i in 0..<ak.vector_size(&this.m_tuple):
        if not css_optional_style_values_equal(*ak.vector_at_const(&this.m_tuple, i), *ak.vector_at_const(&other.m_tuple, i)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::TupleStyleValue (CRTP helper) (override).
pub func css_tuple_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_tuple_style_value_properties_equal((CssTupleStyleValue*)base, (CssTupleStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/TupleStyleValue.h:30 Web::CSS::TupleStyleValue::is_computationally_independent (override).
pub func css_tuple_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssTupleStyleValue*)base
    for maybe_value in ak.vector_span_const(&this.m_tuple):
        # NB: C++ dereferences every element; a tuple's absent members are never asked.
        let value = maybe_value else trap("VERIFY: a tuple member")
        if not css_style_value_is_computationally_independent(value):
            return false
    return true

