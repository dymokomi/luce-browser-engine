#                              CalculatedStyleValue itself
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp (lines 2905-3212) and the inline
#       members of CalculatedStyleValue.h they belong with: CalculatedStyleValue::CalculationResult,
#       and CalculatedStyleValue's construction, serialization, absolutization, equality,
#       resolution (resolve_value and the resolve_* of every numeric type), dump and reify.
#       CalculatedStyleValue::percentage_resolved_type is declared in the donor's header and
#       defined nowhere, so it has no port.
