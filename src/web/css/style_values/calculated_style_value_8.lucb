## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:3204 Web::CSS::CalculatedStyleValue::reify (override).
# https://drafts.css-houdini.org/css-typed-om-1/#reify-a-math-expression
pub func css_calculated_style_value_reify_impl(base: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    let this = (CssCalculatedStyleValue*)base
    # NB: This spec algorithm isn't really implementable here - it's incomplete, and assumes we don't already have a
    #     calculation tree. So we have a per-node method instead.
    if let reified = css_calculation_node_reify(this.m_calculation, realm):
        return (CssCssStyleValue*)reified

    # Some math functions are not reifiable yet. If we contain one, we have to fall back to CSSStyleValue.
    # https://github.com/w3c/css-houdini-drafts/issues/1090
    return css_style_value_reify_impl(base, realm, associated_property)

