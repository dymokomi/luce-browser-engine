# mark: UnresolvedStyleValue ====================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.cpp:22 Web::CSS::UnresolvedStyleValue::create.
pub func css_unresolved_style_value_create(values: ak.Vector[css_syntax.ComponentValue], substitution_presence: css_syntax.SubstitutionFunctionsPresence, original_source_text: ak.String? = none) -> CssUnresolvedStyleValue*:
    let this = &(new CssUnresolvedStyleValue[1] --- else trap("out of memory"))[0]
    css_unresolved_style_value_construct(this, values, substitution_presence, original_source_text)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.cpp:27 Web::CSS::UnresolvedStyleValue::UnresolvedStyleValue.
pub func css_unresolved_style_value_construct(this: CssUnresolvedStyleValue*, values: ak.Vector[css_syntax.ComponentValue], substitution_presence: css_syntax.SubstitutionFunctionsPresence, original_source_text: ak.String?):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.unresolved)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_unresolved_style_value_vtable, &css_unresolved_style_value_class)
    this.m_values = values
    this.m_substitution_functions_presence = substitution_presence
    this.m_original_source_text = original_source_text

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.cpp:35 Web::CSS::UnresolvedStyleValue::serialize (override).
pub func css_unresolved_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    _ = arg1
    let this = (CssUnresolvedStyleValue*)base
    if let original_source_text = this.m_original_source_text:
        ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&original_source_text))
        return

    let serialized = css_serialize_a_series_of_component_values(ak.vector_span_const(&this.m_values))
    let trimmed = ak.string_trim_ascii_whitespace(&serialized) else trap("MUST: String::trim_ascii_whitespace")
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&trimmed))

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.h:24 Web::CSS::UnresolvedStyleValue::tokenize (override).
pub func css_unresolved_style_value_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    let this = (CssUnresolvedStyleValue*)base
    return ak.vector_clone(&this.m_values)

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.h:26 Web::CSS::UnresolvedStyleValue::values.
pub func css_unresolved_style_value_values(this: CssUnresolvedStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    return this.m_values

## Ported from Libraries/LibWeb/CSS/StyleValues/UnresolvedStyleValue.h:27 Web::CSS::UnresolvedStyleValue::contains_arbitrary_substitution_function.
pub func css_unresolved_style_value_contains_arbitrary_substitution_function(this: CssUnresolvedStyleValue*) -> bool:
