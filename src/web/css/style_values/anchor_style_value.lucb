# https://drafts.csswg.org/css-anchor-position-1/#funcdef-anchor-size

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.cpp:11 Web::CSS::AnchorStyleValue::create.
pub func css_anchor_style_value_create(anchor_name: ak.FlyString?, anchor_side: CssStyleValue*, fallback_value: CssStyleValue*?) -> CssAnchorStyleValue*:
    let this = &(new CssAnchorStyleValue[1] --- else trap("out of memory"))[0]
    css_anchor_style_value_construct(this, anchor_name, anchor_side, fallback_value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.cpp:19 Web::CSS::AnchorStyleValue::AnchorStyleValue.
pub func css_anchor_style_value_construct(this: CssAnchorStyleValue*, anchor_name: ak.FlyString?, anchor_side: CssStyleValue*, fallback_value: CssStyleValue*?):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.anchor)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_anchor_style_value_vtable, &css_anchor_style_value_class)
    this.m_properties = CssAnchorStyleValueProperties(anchor_name = anchor_name, anchor_side = anchor_side, fallback_value = fallback_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.cpp:27 Web::CSS::AnchorStyleValue::serialize (override).
pub func css_anchor_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode):
    let this = (CssAnchorStyleValue*)base
    ak.string_builder_append(builder, "anchor(")

    if let anchor_name = css_anchor_style_value_anchor_name(this):
        ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&anchor_name))

    if css_anchor_style_value_anchor_name(this) != none:
        ak.string_builder_append_u8(builder, ' ')
    css_style_value_serialize(css_anchor_style_value_anchor_side(this), builder, serialization_mode)

    if let fallback_value = css_anchor_style_value_fallback_value(this):
        ak.string_builder_append(builder, ", ")
        css_style_value_serialize(fallback_value, builder, serialization_mode)

    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.h:25 Web::CSS::AnchorStyleValue::properties_equal.
pub func css_anchor_style_value_properties_equal(this: CssAnchorStyleValue*, other: CssAnchorStyleValue*) -> bool:
    return css_optional_fly_strings_equal(this.m_properties.anchor_name, other.m_properties.anchor_name) and css_style_values_equal(this.m_properties.anchor_side, other.m_properties.anchor_side) and css_optional_style_values_equal(this.m_properties.fallback_value, other.m_properties.fallback_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::AnchorStyleValue (CRTP helper) (override).
pub func css_anchor_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_anchor_style_value_properties_equal((CssAnchorStyleValue*)base, (CssAnchorStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.h:27 Web::CSS::AnchorStyleValue::is_computationally_independent (override).
pub func css_anchor_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.h:29 Web::CSS::AnchorStyleValue::anchor_name.
pub func css_anchor_style_value_anchor_name(this: CssAnchorStyleValue*) -> ak.FlyString?:
    return this.m_properties.anchor_name

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.h:30 Web::CSS::AnchorStyleValue::anchor_side.
pub func css_anchor_style_value_anchor_side(this: CssAnchorStyleValue*) -> CssStyleValue*:
    return this.m_properties.anchor_side

## Ported from Libraries/LibWeb/CSS/StyleValues/AnchorStyleValue.h:34 Web::CSS::AnchorStyleValue::fallback_value.
pub func css_anchor_style_value_fallback_value(this: CssAnchorStyleValue*) -> CssStyleValue*?:
    return this.m_properties.fallback_value
