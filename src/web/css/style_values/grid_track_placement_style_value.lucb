## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.cpp:14 Web::CSS::GridTrackPlacementStyleValue::create.
pub func css_grid_track_placement_style_value_create(grid_track_placement: CssGridTrackPlacement) -> CssGridTrackPlacementStyleValue*:
    let this = &(new CssGridTrackPlacementStyleValue[1] --- else trap("out of memory"))[0]
    css_grid_track_placement_style_value_construct(this, grid_track_placement)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.h:32 Web::CSS::GridTrackPlacementStyleValue::GridTrackPlacementStyleValue.
pub func css_grid_track_placement_style_value_construct(this: CssGridTrackPlacementStyleValue*, grid_track_placement: CssGridTrackPlacement):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.grid_track_placement)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_grid_track_placement_style_value_vtable, &css_grid_track_placement_style_value_class)
    this.m_grid_track_placement = grid_track_placement

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.h:22 Web::CSS::GridTrackPlacementStyleValue::grid_track_placement.
pub func css_grid_track_placement_style_value_grid_track_placement(this: CssGridTrackPlacementStyleValue*) -> CssGridTrackPlacement:
    return this.m_grid_track_placement

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.cpp:19 Web::CSS::GridTrackPlacementStyleValue::serialize (override).
pub func css_grid_track_placement_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssGridTrackPlacementStyleValue*)base
    css_grid_track_placement_serialize(&this.m_grid_track_placement, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.cpp:24 Web::CSS::GridTrackPlacementStyleValue::absolutized (override).
pub func css_grid_track_placement_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssGridTrackPlacementStyleValue*)base
    let absolutized_placement = css_grid_track_placement_absolutized(&this.m_grid_track_placement, context)
    if css_grid_track_placement_eq(&absolutized_placement, this.m_grid_track_placement):
        return base
    return css_grid_track_placement_style_value_create(absolutized_placement).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.h:27 Web::CSS::GridTrackPlacementStyleValue::properties_equal.
pub func css_grid_track_placement_style_value_properties_equal(this: CssGridTrackPlacementStyleValue*, other: CssGridTrackPlacementStyleValue*) -> bool:
    return css_grid_track_placement_eq(&this.m_grid_track_placement, other.m_grid_track_placement)

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackPlacementStyleValue.h:29 Web::CSS::GridTrackPlacementStyleValue::is_computationally_independent (override).
pub func css_grid_track_placement_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssGridTrackPlacementStyleValue*)base
    return css_grid_track_placement_is_computationally_independent(&this.m_grid_track_placement)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::GridTrackPlacementStyleValue (CRTP helper) (override).
pub func css_grid_track_placement_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_grid_track_placement_style_value_properties_equal((CssGridTrackPlacementStyleValue*)base, (CssGridTrackPlacementStyleValue*)other)
