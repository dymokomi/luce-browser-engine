# mark: CosCalculationNode =================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1636 Web::CSS::CosCalculationNode::create.
pub func css_cos_calculation_node_create(value: CssCalculationNode*) -> CssCosCalculationNode*:
    let this = &(new CssCosCalculationNode[1] --- else trap("out of memory"))[0]
    css_cos_calculation_node_construct(this, value)
    return this

## css_cos_calculation_node_create as a CssCreateFromChild.
func css_cos_calculation_node_create_node(value: CssCalculationNode*) -> CssCalculationNode*:
    return css_cos_calculation_node_create(value).css_calculation_node()

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1641 Web::CSS::CosCalculationNode::CosCalculationNode.
pub func css_cos_calculation_node_construct(this: CssCosCalculationNode*, value: CssCalculationNode*):
    # https://www.w3.org/TR/css-values-4/#determine-the-type-of-a-calculation
    # «[ ]» (empty map).
    css_calculation_node_construct(this.css_calculation_node(), .cos, CssNumericType())
    css_calculation_node_set_class(this.css_calculation_node(), (const CssCalculationNodeVTable*)&css_cos_calculation_node_vtable, &css_cos_calculation_node_class)
    this.m_value = value

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1651 Web::CSS::CosCalculationNode::contains_percentage (override).
pub func css_cos_calculation_node_contains_percentage_impl(base: CssCalculationNode*) -> bool:
    let this = (CssCosCalculationNode*)base
    return css_calculation_node_contains_percentage(this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1656 Web::CSS::CosCalculationNode::with_simplified_children (override).
pub func css_cos_calculation_node_with_simplified_children_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculationNode*:
    let this = (CssCosCalculationNode*)base
    return css_simplify_child(base, css_cos_calculation_node_create_node, this.m_value, context, resolution_context)

# https://drafts.csswg.org/css-values-4/#funcdef-cos
## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1662 Web::CSS::CosCalculationNode::run_operation_if_possible (override).
pub func css_cos_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, arg0: CssCalculationContext, arg1: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    _ = arg0
    _ = arg1
    let this = (CssCosCalculationNode*)base
    return css_run_sin_cos_or_tan_operation_if_possible(this.m_value, .cos)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1667 Web::CSS::CosCalculationNode::dump (override).
pub func css_cos_calculation_node_dump_impl(base: CssCalculationNode*, builder: ak.StringBuilder*, indent: i32):
    let this = (CssCosCalculationNode*)base
    css_appendff(builder, "{: >{}}COS:\n", [ak.arg_str(""), ak.arg_i64((i64)indent)])
    css_calculation_node_dump(this.m_value, builder, indent + 2)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1673 Web::CSS::CosCalculationNode::equals (override).
pub func css_cos_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssCosCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_calculation_node_equals(this.m_value, ((CssCosCalculationNode*)other).m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1682 Web::CSS::CosCalculationNode::is_computationally_independent (override).
pub func css_cos_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssCosCalculationNode*)base
    return css_calculation_node_is_computationally_independent(this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:513 Web::CSS::CosCalculationNode::children (override).
pub func css_cos_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssCosCalculationNode*)base
    var children = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&children, this.m_value)
    return children

