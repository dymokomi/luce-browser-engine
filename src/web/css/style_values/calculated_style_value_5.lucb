## run_asin_acos_or_atan_operation_if_possible's `normalize_angle` lambda.
func css_normalize_angle(radians: f64, min_degrees: f64, max_degrees: f64) -> f64:
    var degrees = ak.to_degrees_f64(radians)
    while degrees < min_degrees:
        degrees += 360.0
    while degrees > max_degrees:
        degrees -= 360.0
    return degrees

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1768 Web::CSS::run_asin_acos_or_atan_operation_if_possible.
func css_run_asin_acos_or_atan_operation_if_possible(child: CssCalculationNode*, trig_function: CssAsinAcosOrAtan) -> CssCalculatedStyleValueCalculationResult?:
    # The asin(A), acos(A), and atan(A) functions are the "arc" or "inverse" trigonometric functions, representing
    # the inverse function to their corresponding "normal" trig functions. All of them contain a single calculation
    # which must resolve to a <number>, and compute their corresponding function, interpreting their result as a
    # number of radians, representing an <angle> with the return type made consistent with the input calculation’s
    # type. The angle returned by asin() must be normalized to the range [-90deg, 90deg]; the angle returned by acos()
    # to the range [0deg, 180deg]; and the angle returned by atan() to the range [-90deg, 90deg].
    let number = css_try_get_number(child) else return none

    var result = 0.0
    match trig_function:
        .asin: result = css_normalize_angle(math.asin(number), -90.0, 90.0)
        .acos: result = css_normalize_angle(math.acos(number), 0.0, 180.0)
        .atan: result = css_normalize_angle(math.atan(number), -90.0, 90.0)
        _: _ = 0

    let angle_type = css_numeric_type_new(.angle, 1)
    return css_calculated_style_value_calculation_result_new(result, css_numeric_type_made_consistent_with(&angle_type, css_calculation_node_numeric_type(child) else trap("VERIFY: has_value")))

