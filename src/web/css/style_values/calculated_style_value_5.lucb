# https://drafts.csswg.org/css-values-4/#funcdef-atan2
## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:1962 Web::CSS::Atan2CalculationNode::run_operation_if_possible (override).
pub func css_atan2_calculation_node_run_operation_if_possible_impl(base: CssCalculationNode*, context: CssCalculationContext, resolution_context: CssCalculationResolutionContext) -> CssCalculatedStyleValueCalculationResult?:
    let this = (CssAtan2CalculationNode*)base
    # The atan2(A, B) function contains two comma-separated calculations, A and B. A and B can resolve to any <number>,
    # <dimension>, or <percentage>, but must have a consistent type or else the function is invalid. The function
    # returns the <angle> between the positive X-axis and the point (B,A), with the return type made consistent with the
    # input calculation’s type. The returned angle must be normalized to the interval (-180deg, 180deg] (that is,
    # greater than -180deg, and less than or equal to 180deg).
    let x_value = css_try_get_value_with_canonical_unit(this.m_x, context, resolution_context) else return none
    let y_value = css_try_get_value_with_canonical_unit(this.m_y, context, resolution_context) else return none

    let x_type = x_value.m_type else trap("VERIFY: has_value")
    let input_consistent_type = css_numeric_type_consistent_type(&x_type, y_value.m_type else trap("VERIFY: has_value")) else return none

    var degrees = ak.to_degrees_f64(math.atan2(y_value.m_value, x_value.m_value))
    while degrees <= -180.0:
        degrees += 360.0
    while degrees > 180.0:
        degrees -= 360.0

    let angle_type = css_numeric_type_new(.angle, 1)
    return css_calculated_style_value_calculation_result_new(degrees, css_numeric_type_made_consistent_with(&angle_type, input_consistent_type))

