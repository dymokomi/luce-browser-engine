## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:15 Web::CSS::ColorSchemeStyleValue::create.
pub func css_color_scheme_style_value_create(schemes: ak.Vector[ak.String], only: bool) -> CssColorSchemeStyleValue*:
    let this = &(alloc CssColorSchemeStyleValue[1] else trap("out of memory"))[0]
    css_color_scheme_style_value_construct(this, schemes, only)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:19 Web::CSS::ColorSchemeStyleValue::normal.
pub func css_color_scheme_style_value_normal() -> CssColorSchemeStyleValue*:
    let this = &(alloc CssColorSchemeStyleValue[1] else trap("out of memory"))[0]
    css_color_scheme_style_value_construct(this, ak.Vector[ak.String](), false)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:25 Web::CSS::ColorSchemeStyleValue::schemes.
pub func css_color_scheme_style_value_schemes(this: CssColorSchemeStyleValue*) -> ak.Vector[ak.String]:
    return this.m_properties.schemes

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:26 Web::CSS::ColorSchemeStyleValue::only.
pub func css_color_scheme_style_value_only(this: CssColorSchemeStyleValue*) -> bool:
    return this.m_properties.only

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.cpp:12 Web::CSS::ColorSchemeStyleValue::serialize (override).
pub func css_color_scheme_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssColorSchemeStyleValue*)base
    if ak.vector_is_empty(&this.m_properties.schemes):
        ak.string_builder_append(builder, "normal")
        return

    var first = true
    for scheme in ak.vector_span_const(&this.m_properties.schemes):
        if first:
            first = false
        else:
            ak.string_builder_append_u8(builder, ' ')
        let serialized = css_syntax.serialize_an_identifier_string_view(ak.string_bytes_as_string_view(&scheme))
        ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&serialized))

    if css_color_scheme_style_value_only(this):
        ak.string_builder_append(builder, " only")

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:29 Web::CSS::ColorSchemeStyleValue::properties_equal.
pub func css_color_scheme_style_value_properties_equal(this: CssColorSchemeStyleValue*, other: CssColorSchemeStyleValue*) -> bool:
    let a = &this.m_properties.schemes
    let b = &other.m_properties.schemes
    if ak.vector_size(a) != ak.vector_size(b):
        return false
    for i in 0..<ak.vector_size(a):
        if not ak.string_equals(ak.vector_at_const(a, i), ak.vector_at_const(b, i)):
            return false
    return this.m_properties.only == other.m_properties.only

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::ColorSchemeStyleValue (CRTP helper) (override).
pub func css_color_scheme_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_color_scheme_style_value_properties_equal((CssColorSchemeStyleValue*)base, (CssColorSchemeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:31 Web::CSS::ColorSchemeStyleValue::is_computationally_independent (override).
pub func css_color_scheme_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorSchemeStyleValue.h:34 Web::CSS::ColorSchemeStyleValue::ColorSchemeStyleValue.
pub func css_color_scheme_style_value_construct(this: CssColorSchemeStyleValue*, schemes: ak.Vector[ak.String], only: bool):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.color_scheme)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_color_scheme_style_value_vtable, &css_color_scheme_style_value_class)
    this.m_properties = CssColorSchemeStyleValueProperties(schemes = schemes, only = only)
