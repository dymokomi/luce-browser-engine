# An `<opentype-tag>` followed by an optional value.
# For example, <feature-tag-value> ( https://drafts.csswg.org/css-fonts/#feature-tag-value )
# and the `<opentype-tag> <number>` construct for `font-variation-settings`.

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.h:23 Web::CSS::OpenTypeTaggedStyleValue::create.
pub func css_open_type_tagged_style_value_create(mode: CssOpenTypeTaggedStyleValueMode, tag: ak.FlyString, value: CssStyleValue*) -> CssOpenTypeTaggedStyleValue*:
    let this = &(new CssOpenTypeTaggedStyleValue[1] --- else trap("out of memory"))[0]
    css_open_type_tagged_style_value_construct(this, mode, tag, value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.h:29 Web::CSS::OpenTypeTaggedStyleValue::tag.
pub func css_open_type_tagged_style_value_tag(this: CssOpenTypeTaggedStyleValue*) -> ak.FlyString:
    return this.m_tag

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.h:30 Web::CSS::OpenTypeTaggedStyleValue::value.
pub func css_open_type_tagged_style_value_value(this: CssOpenTypeTaggedStyleValue*) -> CssStyleValue*:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.cpp:12 Web::CSS::OpenTypeTaggedStyleValue::absolutized (override).
pub func css_open_type_tagged_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssOpenTypeTaggedStyleValue*)base
    let absolutized_value = css_style_value_absolutized(this.m_value, computation_context)
    if css_style_values_equal(absolutized_value, this.m_value):
        return base
    return css_open_type_tagged_style_value_create(this.m_mode, this.m_tag, absolutized_value).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.cpp:22 Web::CSS::OpenTypeTaggedStyleValue::serialize (override).
pub func css_open_type_tagged_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssOpenTypeTaggedStyleValue*)base
    css_syntax.serialize_a_string_string_builder(builder, ak.fly_string_bytes_as_string_view(&this.m_tag))
    match this.m_mode:
        .font_feature_settings:
            # For font-feature-settings, a 1 value is implicit, so we shouldn't output it.
            let value_string = css_style_value_to_string(this.m_value, mode)
            if not ak.string_eq_string_view(&value_string, ak.sv("1")):
                ak.string_builder_append_u8(builder, ' ')
                css_style_value_serialize(this.m_value, builder, mode)
        .font_variation_settings:
            ak.string_builder_append_u8(builder, ' ')
            css_style_value_serialize(this.m_value, builder, mode)
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.cpp:42 Web::CSS::OpenTypeTaggedStyleValue::properties_equal.
pub func css_open_type_tagged_style_value_properties_equal(this: CssOpenTypeTaggedStyleValue*, other: CssOpenTypeTaggedStyleValue*) -> bool:
    let other_tag = css_open_type_tagged_style_value_tag(other)
    let tag = css_open_type_tagged_style_value_tag(this)
    return ak.fly_string_eq_fly_string(&other_tag, &tag) and css_style_values_equal(css_open_type_tagged_style_value_value(other), css_open_type_tagged_style_value_value(this))

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::OpenTypeTaggedStyleValue (CRTP helper) (override).
pub func css_open_type_tagged_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_open_type_tagged_style_value_properties_equal((CssOpenTypeTaggedStyleValue*)base, (CssOpenTypeTaggedStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.h:38 Web::CSS::OpenTypeTaggedStyleValue::is_computationally_independent (override).
pub func css_open_type_tagged_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssOpenTypeTaggedStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpenTypeTaggedStyleValue.h:41 Web::CSS::OpenTypeTaggedStyleValue::OpenTypeTaggedStyleValue.
pub func css_open_type_tagged_style_value_construct(this: CssOpenTypeTaggedStyleValue*, mode: CssOpenTypeTaggedStyleValueMode, tag: ak.FlyString, value: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.open_type_tagged)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_open_type_tagged_style_value_vtable, &css_open_type_tagged_style_value_class)
    this.m_mode = mode
    this.m_tag = tag
    this.m_value = value
