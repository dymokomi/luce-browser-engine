## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:20 Web::CSS::BorderRadiusStyleValue::create_zero.
pub func css_border_radius_style_value_create_zero() -> CssBorderRadiusStyleValue*:
    return css_border_radius_style_value_create(css_length_style_value_create(css_length_make_px_css_pixels(gfx.CssPixels.from_int(0))).css_style_value(), css_length_style_value_create(css_length_make_px_css_pixels(gfx.CssPixels.from_int(0))).css_style_value())

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:25 Web::CSS::BorderRadiusStyleValue::create.
pub func css_border_radius_style_value_create(horizontal_radius: CssStyleValue*, vertical_radius: CssStyleValue*) -> CssBorderRadiusStyleValue*:
    let this = &(new CssBorderRadiusStyleValue[1] --- else trap("out of memory"))[0]
    css_border_radius_style_value_construct(this, horizontal_radius, vertical_radius)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:31 Web::CSS::BorderRadiusStyleValue::horizontal_radius.
pub func css_border_radius_style_value_horizontal_radius(this: CssBorderRadiusStyleValue*) -> CssStyleValue*:
    return this.m_properties.horizontal_radius

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:32 Web::CSS::BorderRadiusStyleValue::vertical_radius.
pub func css_border_radius_style_value_vertical_radius(this: CssBorderRadiusStyleValue*) -> CssStyleValue*:
    return this.m_properties.vertical_radius

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:33 Web::CSS::BorderRadiusStyleValue::is_elliptical.
pub func css_border_radius_style_value_is_elliptical(this: CssBorderRadiusStyleValue*) -> bool:
    return this.m_properties.is_elliptical

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.cpp:14 Web::CSS::BorderRadiusStyleValue::serialize (override).
pub func css_border_radius_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssBorderRadiusStyleValue*)base
    if css_style_values_equal(this.m_properties.horizontal_radius, this.m_properties.vertical_radius):
        css_style_value_serialize(this.m_properties.horizontal_radius, builder, mode)
        return
    css_style_value_serialize(this.m_properties.horizontal_radius, builder, mode)
    ak.string_builder_append_u8(builder, ' ')
    css_style_value_serialize(this.m_properties.vertical_radius, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:37 Web::CSS::BorderRadiusStyleValue::properties_equal.
pub func css_border_radius_style_value_properties_equal(this: CssBorderRadiusStyleValue*, other: CssBorderRadiusStyleValue*) -> bool:
    return this.m_properties.is_elliptical == other.m_properties.is_elliptical and css_style_values_equal(this.m_properties.horizontal_radius, other.m_properties.horizontal_radius) and css_style_values_equal(this.m_properties.vertical_radius, other.m_properties.vertical_radius)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::BorderRadiusStyleValue (CRTP helper) (override).
pub func css_border_radius_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_border_radius_style_value_properties_equal((CssBorderRadiusStyleValue*)base, (CssBorderRadiusStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:39 Web::CSS::BorderRadiusStyleValue::is_computationally_independent (override).
pub func css_border_radius_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssBorderRadiusStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_properties.horizontal_radius) and css_style_value_is_computationally_independent(this.m_properties.vertical_radius)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.h:42 Web::CSS::BorderRadiusStyleValue::BorderRadiusStyleValue.
pub func css_border_radius_style_value_construct(this: CssBorderRadiusStyleValue*, horizontal_radius: CssStyleValue*, vertical_radius: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.border_radius)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_border_radius_style_value_vtable, &css_border_radius_style_value_class)
    this.m_properties = CssBorderRadiusStyleValueProperties(is_elliptical = not css_style_values_equal(horizontal_radius, vertical_radius), horizontal_radius = horizontal_radius, vertical_radius = vertical_radius)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusStyleValue.cpp:25 Web::CSS::BorderRadiusStyleValue::absolutized (override).
pub func css_border_radius_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssBorderRadiusStyleValue*)base
    let absolutized_horizontal_radius = css_style_value_absolutized(this.m_properties.horizontal_radius, computation_context)
    let absolutized_vertical_radius = css_style_value_absolutized(this.m_properties.vertical_radius, computation_context)
    if css_style_values_equal(absolutized_vertical_radius, this.m_properties.vertical_radius) and css_style_values_equal(absolutized_horizontal_radius, this.m_properties.horizontal_radius):
        return base
    return css_border_radius_style_value_create(absolutized_horizontal_radius, absolutized_vertical_radius).css_style_value()
