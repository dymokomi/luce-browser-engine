## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:17 Web::CSS::URLStyleValue::create.
pub func css_url_style_value_create(url: CssUrl, paint_fallback: CssStyleValue*? = none) -> CssUrlStyleValue*:
    let this = &(new CssUrlStyleValue[1] --- else trap("out of memory"))[0]
    css_url_style_value_construct(this, url, paint_fallback)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:42 Web::CSS::URLStyleValue::URLStyleValue.
pub func css_url_style_value_construct(this: CssUrlStyleValue*, url: CssUrl, paint_fallback: CssStyleValue*? = none):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.url)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_url_style_value_vtable, &css_url_style_value_class)
    this.m_url = url
    this.m_paint_fallback = paint_fallback

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:24 Web::CSS::URLStyleValue::url.
pub func css_url_style_value_url(this: CssUrlStyleValue*) -> CssUrl:
    return this.m_url

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:26 Web::CSS::URLStyleValue::paint_fallback.
pub func css_url_style_value_paint_fallback(this: CssUrlStyleValue*) -> CssStyleValue*?:
    return this.m_paint_fallback

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:28 Web::CSS::URLStyleValue::properties_equal.
pub func css_url_style_value_properties_equal(this: CssUrlStyleValue*, other: CssUrlStyleValue*) -> bool:
    return css_url_eq(&this.m_url, other.m_url) and css_optional_style_values_equal(this.m_paint_fallback, other.m_paint_fallback)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::URLStyleValue (CRTP helper) (override).
pub func css_url_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_url_style_value_properties_equal((CssUrlStyleValue*)base, (CssUrlStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:30 Web::CSS::URLStyleValue::is_computationally_independent (override).
pub func css_url_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssUrlStyleValue*)base
    let paint_fallback = this.m_paint_fallback else return true
    return css_style_value_is_computationally_independent(paint_fallback)

## Ported from Libraries/LibWeb/CSS/StyleValues/URLStyleValue.h:32 Web::CSS::URLStyleValue::serialize (override).
pub func css_url_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssUrlStyleValue*)base
    let url_string = css_url_to_string(&this.m_url)
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&url_string))
    if let paint_fallback = this.m_paint_fallback:
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(paint_fallback, builder, mode)
