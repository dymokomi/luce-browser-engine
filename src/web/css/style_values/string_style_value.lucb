## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:18 Web::CSS::StringStyleValue::create.
pub func css_string_style_value_create(string: ak.FlyString) -> CssStringStyleValue*:
    let this = &(alloc CssStringStyleValue[1] else trap("out of memory"))[0]
    css_string_style_value_construct(this, string)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:36 Web::CSS::StringStyleValue::StringStyleValue.
pub func css_string_style_value_construct(this: CssStringStyleValue*, string: ak.FlyString):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.string)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_string_style_value_vtable, &css_string_style_value_class)
    this.m_string = string

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:24 Web::CSS::StringStyleValue::string_value.
pub func css_string_style_value_string_value(this: CssStringStyleValue*) -> ak.FlyString:
    return this.m_string

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:25 Web::CSS::StringStyleValue::serialize (override).
pub func css_string_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssStringStyleValue*)base
    let serialized = css_syntax.serialize_a_string_string_view(ak.fly_string_bytes_as_string_view(&this.m_string))
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&serialized))

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:26 Web::CSS::StringStyleValue::tokenize (override).
pub func css_string_style_value_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    let this = (CssStringStyleValue*)base
    var values = ak.Vector[css_syntax.ComponentValue]()
    ak.vector_append_t(&values, css_syntax.component_value_from_token(css_syntax.token_create_string(this.m_string, ak.String())))
    return values

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:31 Web::CSS::StringStyleValue::properties_equal.
pub func css_string_style_value_properties_equal(this: CssStringStyleValue*, other: CssStringStyleValue*) -> bool:
    return ak.fly_string_eq_fly_string(&this.m_string, &other.m_string)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::StringStyleValue (CRTP helper) (override).
pub func css_string_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_string_style_value_properties_equal((CssStringStyleValue*)base, (CssStringStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/StringStyleValue.h:33 Web::CSS::StringStyleValue::is_computationally_independent (override).
pub func css_string_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true
