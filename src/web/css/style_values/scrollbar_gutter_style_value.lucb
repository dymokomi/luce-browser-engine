## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:15 Web::CSS::ScrollbarGutterStyleValue::create.
pub func css_scrollbar_gutter_style_value_create(value: css_data.ScrollbarGutter) -> CssScrollbarGutterStyleValue*:
    let this = &(new CssScrollbarGutterStyleValue[1] --- else trap("out of memory"))[0]
    css_scrollbar_gutter_style_value_construct(this, value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:21 Web::CSS::ScrollbarGutterStyleValue::value.
pub func css_scrollbar_gutter_style_value_value(this: CssScrollbarGutterStyleValue*) -> css_data.ScrollbarGutter:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:23 Web::CSS::ScrollbarGutterStyleValue::serialize (override).
pub func css_scrollbar_gutter_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    _ = arg1
    let this = (CssScrollbarGutterStyleValue*)base
    match this.m_value:
        .auto:
            ak.string_builder_append(builder, "auto")
        .stable:
            ak.string_builder_append(builder, "stable")
        .both_edges:
            ak.string_builder_append(builder, "stable both-edges")
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:40 Web::CSS::ScrollbarGutterStyleValue::properties_equal.
pub func css_scrollbar_gutter_style_value_properties_equal(this: CssScrollbarGutterStyleValue*, other: CssScrollbarGutterStyleValue*) -> bool:
    return this.m_value == other.m_value

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::ScrollbarGutterStyleValue (CRTP helper) (override).
pub func css_scrollbar_gutter_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_scrollbar_gutter_style_value_properties_equal((CssScrollbarGutterStyleValue*)base, (CssScrollbarGutterStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:42 Web::CSS::ScrollbarGutterStyleValue::is_computationally_independent (override).
pub func css_scrollbar_gutter_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarGutterStyleValue.h:45 Web::CSS::ScrollbarGutterStyleValue::ScrollbarGutterStyleValue.
pub func css_scrollbar_gutter_style_value_construct(this: CssScrollbarGutterStyleValue*, value: css_data.ScrollbarGutter):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.scrollbar_gutter)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_scrollbar_gutter_style_value_vtable, &css_scrollbar_gutter_style_value_class)
    this.m_value = value
