## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.cpp:15 Web::CSS::GridTemplateAreaStyleValue::create.
pub func css_grid_template_area_style_value_create(grid_areas: ak.HashMap[ak.String, CssGridArea, ak.StringTraits], row_count: usize, column_count: usize) -> CssGridTemplateAreaStyleValue*:
    let this = &(new CssGridTemplateAreaStyleValue[1] --- else trap("out of memory"))[0]
    css_grid_template_area_style_value_construct(this, grid_areas, row_count, column_count)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:39 Web::CSS::GridTemplateAreaStyleValue::GridTemplateAreaStyleValue.
pub func css_grid_template_area_style_value_construct(this: CssGridTemplateAreaStyleValue*, grid_areas: ak.HashMap[ak.String, CssGridArea, ak.StringTraits], row_count: usize, column_count: usize):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.grid_template_area)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_grid_template_area_style_value_vtable, &css_grid_template_area_style_value_class)
    this.m_grid_areas = grid_areas
    this.m_row_count = row_count
    this.m_column_count = column_count

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:23 Web::CSS::GridTemplateAreaStyleValue::grid_areas.
pub func css_grid_template_area_style_value_grid_areas(this: CssGridTemplateAreaStyleValue*) -> ak.HashMap[ak.String, CssGridArea, ak.StringTraits]:
    return this.m_grid_areas

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:24 Web::CSS::GridTemplateAreaStyleValue::row_count.
pub func css_grid_template_area_style_value_row_count(this: CssGridTemplateAreaStyleValue*) -> usize:
    return this.m_row_count

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:25 Web::CSS::GridTemplateAreaStyleValue::column_count.
pub func css_grid_template_area_style_value_column_count(this: CssGridTemplateAreaStyleValue*) -> usize:
    return this.m_column_count

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.cpp:20 Web::CSS::GridTemplateAreaStyleValue::cell_name_at.
pub func css_grid_template_area_style_value_cell_name_at(this: CssGridTemplateAreaStyleValue*, row: usize, column: usize) -> ak.String:
    for entry in ak.hash_map_begin_const(&this.m_grid_areas):
        let area = entry.value
        if row >= area.row_start and row < area.row_end and column >= area.column_start and column < area.column_end:
            return entry.key
    return ak.string_from_str(".")

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.cpp:29 Web::CSS::GridTemplateAreaStyleValue::serialize (override).
pub func css_grid_template_area_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    _ = arg1
    let this = (CssGridTemplateAreaStyleValue*)base
    if this.m_row_count == 0:
        ak.string_builder_append(builder, "none")
        return

    for y in 0..<this.m_row_count:
        if y != 0:
            ak.string_builder_append_u8(builder, ' ')
        var row_builder = ak.string_builder_new()
        for x in 0..<this.m_column_count:
            if x != 0:
                ak.string_builder_append_u8(&row_builder, ' ')
            let cell_name = css_grid_template_area_style_value_cell_name_at(this, y, x)
            ak.string_builder_append_string_view(&row_builder, ak.string_bytes_as_string_view(&cell_name))
        css_syntax.serialize_a_string_string_builder(builder, ak.string_builder_string_view(&row_builder))

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:29 Web::CSS::GridTemplateAreaStyleValue::properties_equal.
pub func css_grid_template_area_style_value_properties_equal(this: CssGridTemplateAreaStyleValue*, other: CssGridTemplateAreaStyleValue*) -> bool:
    return (this.m_row_count == other.m_row_count and this.m_column_count == other.m_column_count and ak.hash_map_eq(&this.m_grid_areas, &other.m_grid_areas))

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTemplateAreaStyleValue.h:36 Web::CSS::GridTemplateAreaStyleValue::is_computationally_independent (override).
pub func css_grid_template_area_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::GridTemplateAreaStyleValue (CRTP helper) (override).
pub func css_grid_template_area_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_grid_template_area_style_value_properties_equal((CssGridTemplateAreaStyleValue*)base, (CssGridTemplateAreaStyleValue*)other)
