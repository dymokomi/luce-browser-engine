## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.cpp:11 Web::CSS::ColorInterpolationMethodStyleValue::create.
pub func css_color_interpolation_method_style_value_create(color_space: display_list.ColorInterpolationMethod) -> CssColorInterpolationMethodStyleValue*:
    let this = &(alloc CssColorInterpolationMethodStyleValue[1] else trap("out of memory"))[0]
    css_color_interpolation_method_style_value_construct(this, color_space)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.cpp:16 Web::CSS::ColorInterpolationMethodStyleValue::default_color_interpolation_method.
pub func css_color_interpolation_method_style_value_default_color_interpolation_method(color_syntax: CssColorSyntax) -> display_list.ColorInterpolationMethod:
    if color_syntax == CssColorSyntax.legacy:
        return .rectangular_color_space(css_data.RectangularColorSpace.srgb)
    return .rectangular_color_space(css_data.RectangularColorSpace.oklab)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.cpp:21 Web::CSS::ColorInterpolationMethodStyleValue::serialize (override).
pub func css_color_interpolation_method_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssColorInterpolationMethodStyleValue*)base
    ak.string_builder_append(builder, "in ")
    match this.m_color_interpolation_method:
        .rectangular_color_space(color_space):
            ak.string_builder_append_string_view(builder, css_data.to_string_rectangular_color_space(color_space))
        .polar_color_interpolation_method(color_space):
            ak.string_builder_append_string_view(builder, css_data.to_string_polar_color_space(color_space.color_space))
            if color_space.hue_interpolation_method != css_data.HueInterpolationMethod.shorter:
                css_appendff(builder, " {} hue", [ak.arg_string_view(css_data.to_string_hue_interpolation_method(color_space.hue_interpolation_method))])

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.h:31 Web::CSS::ColorInterpolationMethodStyleValue::color_interpolation_method.
pub func css_color_interpolation_method_style_value_color_interpolation_method(this: CssColorInterpolationMethodStyleValue*) -> display_list.ColorInterpolationMethod:
    return this.m_color_interpolation_method

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.h:35 Web::CSS::ColorInterpolationMethodStyleValue::properties_equal.
pub func css_color_interpolation_method_style_value_properties_equal(this: CssColorInterpolationMethodStyleValue*, other: CssColorInterpolationMethodStyleValue*) -> bool:
    return this.m_color_interpolation_method == other.m_color_interpolation_method

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::ColorInterpolationMethodStyleValue (CRTP helper) (override).
pub func css_color_interpolation_method_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_color_interpolation_method_style_value_properties_equal((CssColorInterpolationMethodStyleValue*)base, (CssColorInterpolationMethodStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.h:37 Web::CSS::ColorInterpolationMethodStyleValue::is_computationally_independent (override).
pub func css_color_interpolation_method_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    # FIXME: Consider sub-values once we support <custom-color-space> values
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorInterpolationMethodStyleValue.h:44 Web::CSS::ColorInterpolationMethodStyleValue::ColorInterpolationMethodStyleValue.
pub func css_color_interpolation_method_style_value_construct(this: CssColorInterpolationMethodStyleValue*, color_space: display_list.ColorInterpolationMethod):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.color_interpolation_method)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_color_interpolation_method_style_value_vtable, &css_color_interpolation_method_style_value_class)
    this.m_color_interpolation_method = color_space
