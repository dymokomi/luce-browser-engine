## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.h:16 Web::CSS::UnicodeRangeStyleValue::create.
pub func css_unicode_range_style_value_create(unicode_range: web_fonts.UnicodeRange) -> CssUnicodeRangeStyleValue*:
    let this = &(alloc CssUnicodeRangeStyleValue[1] else trap("out of memory"))[0]
    css_unicode_range_style_value_construct(this, unicode_range)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.cpp:11 Web::CSS::UnicodeRangeStyleValue::UnicodeRangeStyleValue.
pub func css_unicode_range_style_value_construct(this: CssUnicodeRangeStyleValue*, unicode_range: web_fonts.UnicodeRange):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.unicode_range)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_unicode_range_style_value_vtable, &css_unicode_range_style_value_class)
    this.m_unicode_range = unicode_range

## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.h:22 Web::CSS::UnicodeRangeStyleValue::unicode_range.
pub func css_unicode_range_style_value_unicode_range(this: CssUnicodeRangeStyleValue*) -> web_fonts.UnicodeRange:
    return this.m_unicode_range

## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.cpp:19 Web::CSS::UnicodeRangeStyleValue::serialize (override).
pub func css_unicode_range_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssUnicodeRangeStyleValue*)base
    let string = web_fonts.unicode_range_to_string(&this.m_unicode_range)
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&string))

## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.cpp:24 Web::CSS::UnicodeRangeStyleValue::properties_equal.
pub func css_unicode_range_style_value_properties_equal(this: CssUnicodeRangeStyleValue*, other: CssUnicodeRangeStyleValue*) -> bool:
    return web_fonts.unicode_range_eq(&this.m_unicode_range, other.m_unicode_range)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::UnicodeRangeStyleValue (CRTP helper) (override).
pub func css_unicode_range_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_unicode_range_style_value_properties_equal((CssUnicodeRangeStyleValue*)base, (CssUnicodeRangeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/UnicodeRangeStyleValue.h:28 Web::CSS::UnicodeRangeStyleValue::is_computationally_independent (override).
pub func css_unicode_range_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    trap("VERIFY_NOT_REACHED")
