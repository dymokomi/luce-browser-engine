## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.cpp:11 Web::CSS::ScrollbarColorStyleValue::create.
pub func css_scrollbar_color_style_value_create(thumb_color: CssStyleValue*, track_color: CssStyleValue*) -> CssScrollbarColorStyleValue*:
    let this = &(new CssScrollbarColorStyleValue[1] --- else trap("out of memory"))[0]
    css_scrollbar_color_style_value_construct(this, thumb_color, track_color)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.cpp:16 Web::CSS::ScrollbarColorStyleValue::absolutized (override).
pub func css_scrollbar_color_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssScrollbarColorStyleValue*)base
    let absolutized_thumb_color = css_style_value_absolutized(this.m_thumb_color, computation_context)
    let absolutized_track_color = css_style_value_absolutized(this.m_track_color, computation_context)
    return css_scrollbar_color_style_value_create(absolutized_thumb_color, absolutized_track_color).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.cpp:23 Web::CSS::ScrollbarColorStyleValue::serialize (override).
pub func css_scrollbar_color_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssScrollbarColorStyleValue*)base
    css_style_value_serialize(this.m_thumb_color, builder, mode)
    ak.string_builder_append_u8(builder, ' ')
    css_style_value_serialize(this.m_track_color, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.h:21 Web::CSS::ScrollbarColorStyleValue::properties_equal.
pub func css_scrollbar_color_style_value_properties_equal(this: CssScrollbarColorStyleValue*, other: CssScrollbarColorStyleValue*) -> bool:
    return css_style_values_equal(this.m_thumb_color, other.m_thumb_color) and css_style_values_equal(this.m_track_color, other.m_track_color)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::ScrollbarColorStyleValue (CRTP helper) (override).
pub func css_scrollbar_color_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_scrollbar_color_style_value_properties_equal((CssScrollbarColorStyleValue*)base, (CssScrollbarColorStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.h:23 Web::CSS::ScrollbarColorStyleValue::is_computationally_independent (override).
pub func css_scrollbar_color_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssScrollbarColorStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_thumb_color) and css_style_value_is_computationally_independent(this.m_track_color)

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.h:25 Web::CSS::ScrollbarColorStyleValue::thumb_color.
pub func css_scrollbar_color_style_value_thumb_color(this: CssScrollbarColorStyleValue*) -> CssStyleValue*:
    return this.m_thumb_color

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.h:26 Web::CSS::ScrollbarColorStyleValue::track_color.
pub func css_scrollbar_color_style_value_track_color(this: CssScrollbarColorStyleValue*) -> CssStyleValue*:
    return this.m_track_color

## Ported from Libraries/LibWeb/CSS/StyleValues/ScrollbarColorStyleValue.h:30 Web::CSS::ScrollbarColorStyleValue::ScrollbarColorStyleValue.
pub func css_scrollbar_color_style_value_construct(this: CssScrollbarColorStyleValue*, thumb_color: CssStyleValue*, track_color: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.scrollbar_color)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_scrollbar_color_style_value_vtable, &css_scrollbar_color_style_value_class)
    this.m_thumb_color = thumb_color
    this.m_track_color = track_color
