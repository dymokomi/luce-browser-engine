# mark: RadialSizeStyleValue ====================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.h:16 Web::CSS::RadialSizeStyleValue::create.
pub func css_radial_size_style_value_create(components: ak.Vector[CssRadialSizeStyleValueComponent]) -> CssRadialSizeStyleValue*:
    assert(ak.vector_size(&components) == 1 or ak.vector_size(&components) == 2)
    let this = &(new CssRadialSizeStyleValue[1] --- else trap("out of memory"))[0]
    css_radial_size_style_value_construct(this, components)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.h:45 Web::CSS::RadialSizeStyleValue::RadialSizeStyleValue.
pub func css_radial_size_style_value_construct(this: CssRadialSizeStyleValue*, components: ak.Vector[CssRadialSizeStyleValueComponent]):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.radial_size)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_radial_size_style_value_vtable, &css_radial_size_style_value_class)
    this.m_components = components

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:13 Web::CSS::RadialSizeStyleValue::absolutized (override).
pub func css_radial_size_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssRadialSizeStyleValue*)base
    var any_component_required_absolutization = false
    var absolutized_components = ak.Vector[CssRadialSizeStyleValueComponent]()

    for component in ak.vector_span_const(&this.m_components):
        match component:
            .radial_extent(_):
                ak.vector_append_t(&absolutized_components, component)
            .css_style_value(value):
                let absolutized_length_percentage = css_style_value_absolutized(value, computation_context)

                if not css_style_value_equals(absolutized_length_percentage, value):
                    any_component_required_absolutization = true

                ak.vector_append_t(&absolutized_components, CssRadialSizeStyleValueComponent.css_style_value(absolutized_length_percentage))

    if not any_component_required_absolutization:
        return base

    return css_radial_size_style_value_create(absolutized_components).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:37 Web::CSS::RadialSizeStyleValue::serialize (override).
pub func css_radial_size_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, serialization_mode: css_syntax.SerializationMode):
    let this = (CssRadialSizeStyleValue*)base
    var first = true
    for component in ak.vector_span_const(&this.m_components):
        if not first:
            ak.string_builder_append_u8(builder, ' ')
        first = false

        match component:
            .radial_extent(extent):
                ak.string_builder_append_string_view(builder, css_data.to_string_radial_extent(extent))
            .css_style_value(length_percentage):
                css_style_value_serialize(length_percentage, builder, serialization_mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.h:28 Web::CSS::RadialSizeStyleValue::components.
pub func css_radial_size_style_value_components(this: CssRadialSizeStyleValue*) -> ak.Vector[CssRadialSizeStyleValueComponent]:
    return ak.vector_clone(&this.m_components)

# mark: Shapes and distances ====================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:53 Web::CSS::side_shape.
func css_side_shape(center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, distance_function: ak.Function2[gfx.CssPixels, gfx.CssPixels, gfx.CssPixels]) -> gfx.CssPixelSize:
    let x_dist = ak.function2_call(&distance_function, gfx.css_pixel_rect_left(&reference_box).sub(gfx.css_pixel_point_x(&center)).abs(), gfx.css_pixel_rect_right(&reference_box).sub(gfx.css_pixel_point_x(&center)).abs())
    let y_dist = ak.function2_call(&distance_function, gfx.css_pixel_rect_top(&reference_box).sub(gfx.css_pixel_point_y(&center)).abs(), gfx.css_pixel_rect_bottom(&reference_box).sub(gfx.css_pixel_point_y(&center)).abs())

    return gfx.CssPixelSize(m_width = x_dist, m_height = y_dist)

## AK::min<CSSPixels> as a distance function.
func css_min_css_pixels(context: void*?, a: gfx.CssPixels, b: gfx.CssPixels) -> gfx.CssPixels:
    _ = context
    return b if b.lt(a) else a

## AK::max<CSSPixels> as a distance function.
func css_max_css_pixels(context: void*?, a: gfx.CssPixels, b: gfx.CssPixels) -> gfx.CssPixels:
    _ = context
    return b if a.lt(b) else a

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:61 Web::CSS::closest_side_shape.
func css_closest_side_shape(center: gfx.CssPixelPoint, size: gfx.CssPixelRect) -> gfx.CssPixelSize:
    return css_side_shape(center, size, ak.Function2[gfx.CssPixels, gfx.CssPixels, gfx.CssPixels](call = css_min_css_pixels, context = none))

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:66 Web::CSS::farthest_side_shape.
func css_farthest_side_shape(center: gfx.CssPixelPoint, size: gfx.CssPixelRect) -> gfx.CssPixelSize:
    return css_side_shape(center, size, ak.Function2[gfx.CssPixels, gfx.CssPixels, gfx.CssPixels](call = css_max_css_pixels, context = none))

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:71 Web::CSS::corner_distance.
func css_corner_distance(center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, distance_compare_function: ak.Function2[gfx.CssPixels, gfx.CssPixels, bool], corner: gfx.CssPixelPoint*) -> gfx.CssPixels:
    let top_left_distance_squared = gfx.square_distance_between(gfx.css_pixel_rect_top_left(&reference_box), center)
    let top_right_distance_squared = gfx.square_distance_between(gfx.css_pixel_rect_top_right(&reference_box), center)
    let bottom_right_distance_squared = gfx.square_distance_between(gfx.css_pixel_rect_bottom_right(&reference_box), center)
    let bottom_left_distance_squared = gfx.square_distance_between(gfx.css_pixel_rect_bottom_left(&reference_box), center)
    var distance_squared = top_left_distance_squared
    *corner = gfx.css_pixel_rect_top_left(&reference_box)
    if ak.function2_call(&distance_compare_function, top_right_distance_squared, distance_squared):
        *corner = gfx.css_pixel_rect_top_right(&reference_box)
        distance_squared = top_right_distance_squared
    if ak.function2_call(&distance_compare_function, bottom_right_distance_squared, distance_squared):
        *corner = gfx.css_pixel_rect_bottom_right(&reference_box)
        distance_squared = bottom_right_distance_squared
    if ak.function2_call(&distance_compare_function, bottom_left_distance_squared, distance_squared):
        *corner = gfx.css_pixel_rect_bottom_left(&reference_box)
        distance_squared = bottom_left_distance_squared
    return gfx.sqrt(distance_squared)

## `[](CSSPixels a, CSSPixels b) { return a < b; }`, the comparison of closest_corner_distance.
func css_css_pixels_less_than(context: void*?, a: gfx.CssPixels, b: gfx.CssPixels) -> bool:
    _ = context
    return a.lt(b)

## `[](CSSPixels a, CSSPixels b) { return a > b; }`, the comparison of farthest_corner_distance.
func css_css_pixels_greater_than(context: void*?, a: gfx.CssPixels, b: gfx.CssPixels) -> bool:
    _ = context
    return b.lt(a)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:93 Web::CSS::closest_corner_distance.
func css_closest_corner_distance(center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, corner: gfx.CssPixelPoint*) -> gfx.CssPixels:
    return css_corner_distance(center, reference_box, ak.Function2[gfx.CssPixels, gfx.CssPixels, bool](call = css_css_pixels_less_than, context = none), corner)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:98 Web::CSS::farthest_corner_distance.
func css_farthest_corner_distance(center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, corner: gfx.CssPixelPoint*) -> gfx.CssPixels:
    return css_corner_distance(center, reference_box, ak.Function2[gfx.CssPixels, gfx.CssPixels, bool](call = css_css_pixels_greater_than, context = none), corner)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:106 Web::CSS::RadialSizeStyleValue::resolve_circle_size.
pub func css_radial_size_style_value_resolve_circle_size(this: CssRadialSizeStyleValue*, center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, node: LayoutNode*) -> gfx.CssPixels:
    assert(ak.vector_size(&this.m_components) == 1)

    var resolved_size: gfx.CssPixels = ---
    match *ak.vector_at_const(&this.m_components, 0):
        .radial_extent(radial_extent):
            match radial_extent:
                .closest_side:
                    let side_distances = css_closest_side_shape(center, reference_box)
                    resolved_size = css_min_css_pixels(none, side_distances.m_width, side_distances.m_height)
                .farthest_side:
                    let side_distances = css_farthest_side_shape(center, reference_box)
                    resolved_size = css_max_css_pixels(none, side_distances.m_width, side_distances.m_height)
                .closest_corner:
                    var corner = gfx.CssPixelPoint()
                    resolved_size = css_closest_corner_distance(center, reference_box, &corner)
                .farthest_corner:
                    var corner = gfx.CssPixelPoint()
                    resolved_size = css_farthest_corner_distance(center, reference_box, &corner)
                _:
                    trap("VERIFY_NOT_REACHED")
        .css_style_value(length_percentage):
            # NB: std::pow(float, int) and the sqrt over it compute in double; AK::Sqrt2<float> is then widened.
            let radius_ref = math.sqrt(math.pow((f64)gfx.css_pixel_rect_width(&reference_box).to_float(), 2.0) + math.pow((f64)gfx.css_pixel_rect_height(&reference_box).to_float(), 2.0)) / (f64)ak.sqrt2_f32
            # FIXME: We don't need to pass `node` here since we know that all relative lengths have already been absolutized
            let resolved = css_length_percentage_from_style_value(length_percentage)
            let pixels = css_percentage_or_to_px(&resolved.percentage_or, node, gfx.css_pixels_nearest_value_for_f64(radius_ref))
            resolved_size = gfx.css_pixels_nearest_value_for_f32(ak.max_f32(0.0f32, pixels.to_float()))

    # https://w3c.github.io/csswg-drafts/css-images/#degenerate-radials
    # If the ending shape is a circle with zero radius:
    if gfx.eq_css_pixels_int(resolved_size, 0):
        # Render as if the ending shape was a circle whose radius was an arbitrary very small number greater than zero.
        # This will make the gradient continue to look like a circle.
        return gfx.css_pixels_smallest_positive_value()

    return resolved_size

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:146 Web::CSS::ellipse_corner_shape.
func css_ellipse_corner_shape(center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, get_corner: ak.Function3[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelPoint*, gfx.CssPixels], get_shape: ak.Function2[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelSize]) -> gfx.CssPixelSize:
    var corner = gfx.CssPixelPoint()
    _ = ak.function3_call(&get_corner, &center, &reference_box, &corner)

    let shape = ak.function2_call(&get_shape, &center, &reference_box)
    let height = shape.m_height
    let width = shape.m_width

    # Prevent division by zero
    # https://w3c.github.io/csswg-drafts/css-images/#degenerate-radials
    if gfx.eq_css_pixels_int(height, 0):
        # Render as if the ending shape was an ellipse whose width was an arbitrary very large number and whose height
        # was an arbitrary very small number greater than zero. This will make the gradient look like a solid-color image equal
        # to the color of the last color-stop, or equal to the average color of the gradient if it’s repeating.
        let arbitrary_small_number = gfx.css_pixels_smallest_positive_value()
        let arbitrary_large_number = gfx.css_pixels_max()
        return gfx.CssPixelSize(m_width = arbitrary_large_number, m_height = arbitrary_small_number)

    let aspect_ratio = width.div(height)

    let p = gfx.css_pixel_point_sub(&corner, center)
    let radius_a = gfx.sqrt(p.m_y.mul(p.m_y).mul_fraction(aspect_ratio).mul_fraction(aspect_ratio).add(p.m_x.mul(p.m_x)))
    let radius_b = radius_a.div_fraction(aspect_ratio)
    return gfx.CssPixelSize(m_width = radius_a, m_height = radius_b)

## closest_corner_distance as ellipse_corner_shape's `get_corner`.
func css_closest_corner_distance_function(context: void*?, center: const gfx.CssPixelPoint*, reference_box: const gfx.CssPixelRect*, corner: gfx.CssPixelPoint*) -> gfx.CssPixels:
    _ = context
    return css_closest_corner_distance(*center, *reference_box, corner)

## farthest_corner_distance as ellipse_corner_shape's `get_corner`.
func css_farthest_corner_distance_function(context: void*?, center: const gfx.CssPixelPoint*, reference_box: const gfx.CssPixelRect*, corner: gfx.CssPixelPoint*) -> gfx.CssPixels:
    _ = context
    return css_farthest_corner_distance(*center, *reference_box, corner)

## closest_side_shape as ellipse_corner_shape's `get_shape`.
func css_closest_side_shape_function(context: void*?, center: const gfx.CssPixelPoint*, reference_box: const gfx.CssPixelRect*) -> gfx.CssPixelSize:
    _ = context
    return css_closest_side_shape(*center, *reference_box)

## farthest_side_shape as ellipse_corner_shape's `get_shape`.
func css_farthest_side_shape_function(context: void*?, center: const gfx.CssPixelPoint*, reference_box: const gfx.CssPixelRect*) -> gfx.CssPixelSize:
    _ = context
    return css_farthest_side_shape(*center, *reference_box)

## The `resolve_component` lambda of RadialSizeStyleValue::resolve_ellipse_size.
func css_radial_size_resolve_component(component: CssRadialSizeStyleValueComponent, reference_size: gfx.CssPixels, center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, node: LayoutNode*) -> gfx.CssPixelSize:
    match component:
        .radial_extent(radial_extent):
            match radial_extent:
                .closest_side:
                    return css_closest_side_shape(center, reference_box)
                .farthest_side:
                    return css_farthest_side_shape(center, reference_box)
                .closest_corner:
                    return css_ellipse_corner_shape(center, reference_box, ak.Function3[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelPoint*, gfx.CssPixels](call = css_closest_corner_distance_function, context = none), ak.Function2[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelSize](call = css_closest_side_shape_function, context = none))
                .farthest_corner:
                    return css_ellipse_corner_shape(center, reference_box, ak.Function3[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelPoint*, gfx.CssPixels](call = css_farthest_corner_distance_function, context = none), ak.Function2[const gfx.CssPixelPoint*, const gfx.CssPixelRect*, gfx.CssPixelSize](call = css_farthest_side_shape_function, context = none))
                _:
                    trap("VERIFY_NOT_REACHED")
        .css_style_value(length_percentage):
            # FIXME: We don't need to pass `node` here since we know that all relative lengths have already been absolutized
            let resolved = css_length_percentage_from_style_value(length_percentage)
            let value = css_percentage_or_to_px(&resolved.percentage_or, node, reference_size)

            return gfx.CssPixelSize(m_width = value, m_height = value)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.cpp:178 Web::CSS::RadialSizeStyleValue::resolve_ellipse_size.
pub func css_radial_size_style_value_resolve_ellipse_size(this: CssRadialSizeStyleValue*, center: gfx.CssPixelPoint, reference_box: gfx.CssPixelRect, node: LayoutNode*) -> gfx.CssPixelSize:
    assert(ak.vector_size(&this.m_components) == 1 or ak.vector_size(&this.m_components) == 2)

    let first_component = *ak.vector_at_const(&this.m_components, 0)
    let second_component = first_component if ak.vector_size(&this.m_components) == 1 else *ak.vector_at_const(&this.m_components, 1)
    let resolved_size = gfx.CssPixelSize(
        m_width = css_radial_size_resolve_component(first_component, gfx.css_pixel_rect_width(&reference_box), center, reference_box, node).m_width,
        m_height = css_radial_size_resolve_component(second_component, gfx.css_pixel_rect_height(&reference_box), center, reference_box, node).m_height,
    )

    # Handle degenerate cases
    # https://w3c.github.io/csswg-drafts/css-images/#degenerate-radials
    let arbitrary_small_number = gfx.css_pixels_smallest_positive_value()
    let arbitrary_large_number = gfx.css_pixels_max()

    # If the ending shape has zero width (regardless of the height):
    if resolved_size.m_width.raw_value() <= 0:
        # Render as if the ending shape was an ellipse whose height was an arbitrary very large number
        # and whose width was an arbitrary very small number greater than zero.
        # This will make the gradient look similar to a horizontal linear gradient that is mirrored across the center of the ellipse.
        # It also means that all color-stop positions specified with a percentage resolve to 0px.
        return gfx.CssPixelSize(m_width = arbitrary_small_number, m_height = arbitrary_large_number)
    # Otherwise, if the ending shape has zero height:
    if resolved_size.m_height.raw_value() <= 0:
        # Render as if the ending shape was an ellipse whose width was an arbitrary very large number and whose height
        # was an arbitrary very small number greater than zero. This will make the gradient look like a solid-color image equal
        # to the color of the last color-stop, or equal to the average color of the gradient if it’s repeating.
        return gfx.CssPixelSize(m_width = arbitrary_large_number, m_height = arbitrary_small_number)

    return resolved_size

# mark: Equality ================================================================================

## `Variant<RadialExtent, NonnullRefPtr<StyleValue const>>`'s `==`: the same alternative, and the same
## extent or the same value pointer (NonnullRefPtr compares pointers).
func css_radial_size_components_equal(a: CssRadialSizeStyleValueComponent, b: CssRadialSizeStyleValueComponent) -> bool:
    match a:
        .radial_extent(left):
            match b:
                .radial_extent(right):
                    return left == right
                _:
                    return false
        .css_style_value(left):
            match b:
                .css_style_value(right):
                    return left == right
                _:
                    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.h:33 Web::CSS::RadialSizeStyleValue::properties_equal.
pub func css_radial_size_style_value_properties_equal(this: CssRadialSizeStyleValue*, other: CssRadialSizeStyleValue*) -> bool:
    if ak.vector_size(&this.m_components) != ak.vector_size(&other.m_components):
        return false
    for i in 0..<ak.vector_size(&this.m_components):
        if not css_radial_size_components_equal(*ak.vector_at_const(&this.m_components, i), *ak.vector_at_const(&other.m_components, i)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::RadialSizeStyleValue (CRTP helper) (override).
pub func css_radial_size_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_radial_size_style_value_properties_equal((CssRadialSizeStyleValue*)base, (CssRadialSizeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/RadialSizeStyleValue.h:35 Web::CSS::RadialSizeStyleValue::is_computationally_independent (override).
pub func css_radial_size_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssRadialSizeStyleValue*)base
    for component in ak.vector_span_const(&this.m_components):
        match component:
            .radial_extent(_):
                continue
            .css_style_value(value):
                if not css_style_value_is_computationally_independent(value):
                    return false
    return true
