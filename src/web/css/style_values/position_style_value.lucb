## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:15 Web::CSS::PositionStyleValue::create.
pub func css_position_style_value_create(edge_x: CssEdgeStyleValue*, edge_y: CssEdgeStyleValue*) -> CssPositionStyleValue*:
    let this = &(alloc CssPositionStyleValue[1] else trap("out of memory"))[0]
    css_position_style_value_construct(this, edge_x, edge_y)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:20 Web::CSS::PositionStyleValue::create_center.
pub func css_position_style_value_create_center() -> CssPositionStyleValue*:
    let this = &(alloc CssPositionStyleValue[1] else trap("out of memory"))[0]
    css_position_style_value_construct(this, css_edge_style_value_create(css_data.PositionEdge.center, none), css_edge_style_value_create(css_data.PositionEdge.center, none))
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:27 Web::CSS::PositionStyleValue::create_computed_center.
pub func css_position_style_value_create_computed_center() -> CssPositionStyleValue*:
    let this = &(alloc CssPositionStyleValue[1] else trap("out of memory"))[0]
    css_position_style_value_construct(this, css_edge_style_value_create(none, css_percentage_style_value_create(css_percentage_new(50.0)).css_style_value()), css_edge_style_value_create(none, css_percentage_style_value_create(css_percentage_new(50.0)).css_style_value()))
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.h:25 Web::CSS::PositionStyleValue::edge_x.
pub func css_position_style_value_edge_x(this: CssPositionStyleValue*) -> CssEdgeStyleValue*:
    return this.m_properties.edge_x

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.h:26 Web::CSS::PositionStyleValue::edge_y.
pub func css_position_style_value_edge_y(this: CssPositionStyleValue*) -> CssEdgeStyleValue*:
    return this.m_properties.edge_y

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:34 Web::CSS::PositionStyleValue::is_center.
pub func css_position_style_value_is_center(this: CssPositionStyleValue*, mode: css_syntax.SerializationMode) -> bool:
    return css_edge_style_value_is_center(css_position_style_value_edge_x(this), mode) and css_edge_style_value_is_center(css_position_style_value_edge_y(this), mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:39 Web::CSS::PositionStyleValue::resolved.
pub func css_position_style_value_resolved(this: CssPositionStyleValue*, node: LayoutNode*, rect: gfx.CssPixelRect) -> gfx.CssPixelPoint:
    # Note: A preset + a none default x/y_relative_to is impossible in the syntax (and makes little sense)
    let x_length_percentage = css_length_percentage_from_style_value(css_edge_style_value_offset(this.m_properties.edge_x))
    let x = css_percentage_or_to_px(&x_length_percentage.percentage_or, node, gfx.css_pixel_rect_width(&rect))
    let y_length_percentage = css_length_percentage_from_style_value(css_edge_style_value_offset(this.m_properties.edge_y))
    let y = css_percentage_or_to_px(&y_length_percentage.percentage_or, node, gfx.css_pixel_rect_height(&rect))
    return gfx.CssPixelPoint(m_x = gfx.css_pixel_rect_x(&rect).add(x), m_y = gfx.css_pixel_rect_y(&rect).add(y))

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:47 Web::CSS::PositionStyleValue::absolutized (override).
pub func css_position_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssPositionStyleValue*)base
    return css_position_style_value_create(
        css_style_value_as_edge(css_style_value_absolutized(css_position_style_value_edge_x(this).css_style_value(), computation_context)),
        css_style_value_as_edge(css_style_value_absolutized(css_position_style_value_edge_y(this).css_style_value(), computation_context)),
    ).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.cpp:54 Web::CSS::PositionStyleValue::serialize (override).
pub func css_position_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssPositionStyleValue*)base
    css_style_value_serialize(this.m_properties.edge_x.css_style_value(), builder, mode)
    ak.string_builder_append_u8(builder, ' ')
    css_style_value_serialize(this.m_properties.edge_y.css_style_value(), builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.h:33 Web::CSS::PositionStyleValue::properties_equal.
pub func css_position_style_value_properties_equal(this: CssPositionStyleValue*, other: CssPositionStyleValue*) -> bool:
    return css_style_values_equal(this.m_properties.edge_x.css_style_value(), other.m_properties.edge_x.css_style_value()) and css_style_values_equal(this.m_properties.edge_y.css_style_value(), other.m_properties.edge_y.css_style_value())

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::PositionStyleValue (CRTP helper) (override).
pub func css_position_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_position_style_value_properties_equal((CssPositionStyleValue*)base, (CssPositionStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.h:35 Web::CSS::PositionStyleValue::is_computationally_independent (override).
pub func css_position_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssPositionStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_properties.edge_x.css_style_value()) and css_style_value_is_computationally_independent(this.m_properties.edge_y.css_style_value())

## Ported from Libraries/LibWeb/CSS/StyleValues/PositionStyleValue.h:38 Web::CSS::PositionStyleValue::PositionStyleValue.
pub func css_position_style_value_construct(this: CssPositionStyleValue*, edge_x: CssEdgeStyleValue*, edge_y: CssEdgeStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.position)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_position_style_value_vtable, &css_position_style_value_class)
    this.m_properties = CssPositionStyleValueProperties(edge_x = edge_x, edge_y = edge_y)
