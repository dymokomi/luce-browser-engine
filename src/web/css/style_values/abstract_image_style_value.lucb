# mark: AbstractImageStyleValue ================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/AbstractImageStyleValue.h:22 Web::CSS::AbstractImageStyleValue::natural_width (virtual).
pub func css_abstract_image_style_value_natural_width_impl(this: CssAbstractImageStyleValue*) -> gfx.CssPixels?:
    _ = this
    return none

## Ported from Libraries/LibWeb/CSS/StyleValues/AbstractImageStyleValue.h:23 Web::CSS::AbstractImageStyleValue::natural_height (virtual).
pub func css_abstract_image_style_value_natural_height_impl(this: CssAbstractImageStyleValue*) -> gfx.CssPixels?:
    _ = this
    return none

## Ported from Libraries/LibWeb/CSS/StyleValues/AbstractImageStyleValue.h:25 Web::CSS::AbstractImageStyleValue::natural_aspect_ratio (virtual).
pub func css_abstract_image_style_value_natural_aspect_ratio_impl(this: CssAbstractImageStyleValue*) -> gfx.CssPixelFraction?:
    let width = css_abstract_image_style_value_natural_width(this)
    let height = css_abstract_image_style_value_natural_height(this)
    if let w = width:
        if let h = height:
            if not gfx.eq_css_pixels_int(h, 0):
                return w.div(h)
    return none

