# mark: FilterOperation =========================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:18 Web::CSS::FilterOperation::Blur::resolved_radius.
pub func css_blur_resolved_radius(this: const CssBlur*) -> f32:
    let length = css_length_from_style_value(this.radius, none)
    return (f32)css_length_absolute_length_to_px_without_rounding(&length)

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:24 Web::CSS::FilterOperation::Blur::is_computationally_independent.
pub func css_blur_is_computationally_independent(this: const CssBlur*) -> bool:
    return css_style_value_is_computationally_independent(this.radius)

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:34 Web::CSS::FilterOperation::DropShadow::is_computationally_independent.
pub func css_drop_shadow_is_computationally_independent(this: const CssDropShadow*) -> bool:
    if not (css_style_value_is_computationally_independent(this.offset_x) and css_style_value_is_computationally_independent(this.offset_y)):
        return false
    if let radius = this.radius:
        if not css_style_value_is_computationally_independent(radius):
            return false
    if let color = this.color:
        if not css_style_value_is_computationally_independent(color):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:23 Web::CSS::FilterOperation::HueRotate::angle_degrees.
pub func css_hue_rotate_angle_degrees(this: const CssHueRotate*) -> f32:
    let angle = css_angle_from_style_value(this.angle, none)
    return (f32)css_angle_to_degrees(&angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:47 Web::CSS::FilterOperation::HueRotate::is_computationally_independent.
pub func css_hue_rotate_is_computationally_independent(this: const CssHueRotate*) -> bool:
    return css_style_value_is_computationally_independent(this.angle)

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:28 Web::CSS::FilterOperation::Color::resolved_amount.
pub func css_color_resolved_amount(this: const CssColor*) -> f32:
    return (f32)css_number_from_style_value(this.amount, 1.0)

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:55 Web::CSS::FilterOperation::Color::is_computationally_independent.
pub func css_color_is_computationally_independent(this: const CssColor*) -> bool:
    return css_style_value_is_computationally_independent(this.amount)

## FilterValue's operator== (Variant: the same alternative, and that struct's defaulted operator==).
func css_filter_values_equal(a: const CssFilterValue*, b: const CssFilterValue*) -> bool:
    match *a:
        .css_blur(left):
            match *b:
                .css_blur(right): return css_style_values_equal(left.radius, right.radius)
                _: return false
        .css_drop_shadow(left):
            match *b:
                .css_drop_shadow(right):
                    return (css_style_values_equal(left.offset_x, right.offset_x) and css_style_values_equal(left.offset_y, right.offset_y) and css_optional_style_values_equal(left.radius, right.radius) and css_optional_style_values_equal(left.color, right.color))
                _: return false
        .css_hue_rotate(left):
            match *b:
                .css_hue_rotate(right): return css_style_values_equal(left.angle, right.angle)
                _: return false
        .css_color(left):
            match *b:
                .css_color(right): return left.operation == right.operation and css_style_values_equal(left.amount, right.amount)
                _: return false
        .css_url(left):
            match *b:
                .css_url(right): return css_url_eq(&left, right)
                _: return false

# mark: FilterValueListStyleValue ===============================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:62 Web::CSS::FilterValueListStyleValue::create.
pub func css_filter_value_list_style_value_create(filter_value_list: ak.Vector[CssFilterValue]) -> CssFilterValueListStyleValue*:
    assert(ak.vector_size(&filter_value_list) >= 1)
    let this = &(new CssFilterValueListStyleValue[1] --- else trap("out of memory"))[0]
    css_filter_value_list_style_value_construct(this, filter_value_list)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:94 Web::CSS::FilterValueListStyleValue::FilterValueListStyleValue.
pub func css_filter_value_list_style_value_construct(this: CssFilterValueListStyleValue*, filter_value_list: ak.Vector[CssFilterValue]):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.filter_value_list)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_filter_value_list_style_value_vtable, &css_filter_value_list_style_value_class)
    # FIXME: No support for SVG filters yet
    this.m_filter_value_list = filter_value_list

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:69 Web::CSS::FilterValueListStyleValue::filter_value_list.
pub func css_filter_value_list_style_value_filter_value_list(this: CssFilterValueListStyleValue*) -> ak.Vector[CssFilterValue]:
    return this.m_filter_value_list

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:70 Web::CSS::FilterValueListStyleValue::size.
pub func css_filter_value_list_style_value_size(this: CssFilterValueListStyleValue*) -> usize:
    return ak.vector_size(&this.m_filter_value_list)

## The name of a color filter function (serialize's lambda).
func css_color_filter_function_name(operation: gfx.ColorFilterType) -> ak.StringView:
    match operation:
        .brightness: return ak.sv("brightness")
        .contrast: return ak.sv("contrast")
        .grayscale: return ak.sv("grayscale")
        .invert: return ak.sv("invert")
        .opacity: return ak.sv("opacity")
        .saturate: return ak.sv("saturate")
        .sepia: return ak.sv("sepia")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:33 Web::CSS::FilterValueListStyleValue::serialize (override).
pub func css_filter_value_list_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssFilterValueListStyleValue*)base
    var first = true
    for filter_function in ak.vector_span_const(&this.m_filter_value_list):
        if not first:
            ak.string_builder_append_u8(builder, ' ')
        match filter_function:
            .css_blur(blur):
                ak.string_builder_append(builder, "blur(")
                css_style_value_serialize(blur.radius, builder, mode)
                ak.string_builder_append_u8(builder, ')')
            .css_drop_shadow(drop_shadow):
                ak.string_builder_append(builder, "drop-shadow(")
                if let color = drop_shadow.color:
                    css_style_value_serialize(color, builder, mode)
                    ak.string_builder_append_u8(builder, ' ')
                css_style_value_serialize(drop_shadow.offset_x, builder, mode)
                ak.string_builder_append_u8(builder, ' ')
                css_style_value_serialize(drop_shadow.offset_y, builder, mode)
                if let radius = drop_shadow.radius:
                    ak.string_builder_append_u8(builder, ' ')
                    css_style_value_serialize(radius, builder, mode)
                ak.string_builder_append_u8(builder, ')')
            .css_hue_rotate(hue_rotate):
                ak.string_builder_append(builder, "hue-rotate(")
                css_style_value_serialize(hue_rotate.angle, builder, mode)
                ak.string_builder_append_u8(builder, ')')
            .css_color(color):
                css_appendff(builder, "{}(", [ak.arg_string_view(css_color_filter_function_name(color.operation))])
                css_style_value_serialize(color.amount, builder, mode)
                ak.string_builder_append_u8(builder, ')')
            .css_url(url):
                let url_text = css_url_to_string(&url)
                ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&url_text))
        first = false

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:98 Web::CSS::FilterValueListStyleValue::contains_url.
pub func css_filter_value_list_style_value_contains_url(this: CssFilterValueListStyleValue*) -> bool:
    for filter_value in ak.vector_span_const(&this.m_filter_value_list):
        match filter_value:
            .css_url(_): return true
            _: _ = 0
    return false

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.cpp:107 Web::CSS::FilterValueListStyleValue::absolutized (override).
pub func css_filter_value_list_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssFilterValueListStyleValue*)base
    var absolutized_filter_values = ak.Vector[CssFilterValue]()
    ak.vector_ensure_capacity(&absolutized_filter_values, ak.vector_size(&this.m_filter_value_list))

    for filter_value in ak.vector_span_const(&this.m_filter_value_list):
        match filter_value:
            .css_blur(blur):
                ak.vector_append_t(&absolutized_filter_values, CssFilterValue.css_blur(CssBlur(
                    radius = css_style_value_absolutized(blur.radius, computation_context),
                )))
            .css_drop_shadow(drop_shadow):
                var radius: CssStyleValue*? = none
                if let present = drop_shadow.radius:
                    radius = css_style_value_absolutized(present, computation_context)
                var color: CssStyleValue*? = none
                if let present = drop_shadow.color:
                    color = css_style_value_absolutized(present, computation_context)
                ak.vector_append_t(&absolutized_filter_values, CssFilterValue.css_drop_shadow(CssDropShadow(
                    offset_x = css_style_value_absolutized(drop_shadow.offset_x, computation_context),
                    offset_y = css_style_value_absolutized(drop_shadow.offset_y, computation_context),
                    radius = radius,
                    color = color,
                )))
            .css_hue_rotate(hue_rotate):
                ak.vector_append_t(&absolutized_filter_values, CssFilterValue.css_hue_rotate(CssHueRotate(
                    angle = css_style_value_absolutized(hue_rotate.angle, computation_context),
                )))
            .css_color(color):
                var absolutized_amount = css_number_from_style_value(css_style_value_absolutized(color.amount, computation_context), 1.0)
                let operation = color.operation
                if operation == gfx.ColorFilterType.grayscale or operation == gfx.ColorFilterType.invert or operation == gfx.ColorFilterType.opacity or operation == gfx.ColorFilterType.sepia:
                    absolutized_amount = ak.clamp_f64(absolutized_amount, 0.0, 1.0)
                ak.vector_append_t(&absolutized_filter_values, CssFilterValue.css_color(CssColor(
                    operation = color.operation,
                    amount = css_number_style_value_create(absolutized_amount).css_style_value(),
                )))
            .css_url(url):
                ak.vector_append_t(&absolutized_filter_values, CssFilterValue.css_url(url))

    return css_filter_value_list_style_value_create(absolutized_filter_values).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:80 Web::CSS::FilterValueListStyleValue::is_computationally_independent (override).
pub func css_filter_value_list_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssFilterValueListStyleValue*)base
    for filter_value in ak.vector_span_const(&this.m_filter_value_list):
        var independent = true
        match filter_value:
            .css_url(_): independent = true
            .css_blur(value): independent = css_blur_is_computationally_independent(&value)
            .css_drop_shadow(value): independent = css_drop_shadow_is_computationally_independent(&value)
            .css_hue_rotate(value): independent = css_hue_rotate_is_computationally_independent(&value)
            .css_color(value): independent = css_color_is_computationally_independent(&value)
        if not independent:
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/FilterValueListStyleValue.h:91 Web::CSS::FilterValueListStyleValue::properties_equal.
pub func css_filter_value_list_style_value_properties_equal(this: CssFilterValueListStyleValue*, other: CssFilterValueListStyleValue*) -> bool:
    if ak.vector_size(&this.m_filter_value_list) != ak.vector_size(&other.m_filter_value_list):
        return false
    for i in 0..<ak.vector_size(&this.m_filter_value_list):
        if not css_filter_values_equal(ak.vector_at_const(&this.m_filter_value_list, i), ak.vector_at_const(&other.m_filter_value_list, i)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::FilterValueListStyleValue (CRTP helper) (override).
pub func css_filter_value_list_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_filter_value_list_style_value_properties_equal((CssFilterValueListStyleValue*)base, (CssFilterValueListStyleValue*)other)
