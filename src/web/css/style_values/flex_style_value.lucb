## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:16 Web::CSS::FlexStyleValue::create.
pub func css_flex_style_value_create(flex: CssFlex) -> CssFlexStyleValue*:
    let this = &(alloc CssFlexStyleValue[1] else trap("out of memory"))[0]
    css_flex_style_value_construct(this, flex)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:22 Web::CSS::FlexStyleValue::flex.
pub func css_flex_style_value_flex(this: CssFlexStyleValue*) -> CssFlex:
    return this.m_flex

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:23 Web::CSS::FlexStyleValue::raw_value (override).
pub func css_flex_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssFlexStyleValue*)base
    return css_flex_raw_value(&this.m_flex)

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:24 Web::CSS::FlexStyleValue::unit_name (override).
pub func css_flex_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssFlexStyleValue*)base
    return css_flex_unit_name(&this.m_flex)

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:26 Web::CSS::FlexStyleValue::serialize (override).
pub func css_flex_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssFlexStyleValue*)base
    css_flex_serialize(&this.m_flex, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:28 Web::CSS::FlexStyleValue::equals (override).
pub func css_flex_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssFlexStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_flex = css_style_value_as_flex(other)
    return css_flex_eq(&this.m_flex, other_flex.m_flex)

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:36 Web::CSS::FlexStyleValue::is_computationally_independent (override).
pub func css_flex_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/FlexStyleValue.h:39 Web::CSS::FlexStyleValue::FlexStyleValue.
pub func css_flex_style_value_construct(this: CssFlexStyleValue*, flex: CssFlex):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.flex)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_flex_style_value_vtable, &css_flex_style_value_class)
    this.m_flex = flex
