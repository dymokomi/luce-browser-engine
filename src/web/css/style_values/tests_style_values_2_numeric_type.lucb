#==============================================================================================
#
#   tests_style_values_2_numeric_type - the oracle's NumericType cases (mode `ntype`)
#
#   DESCRIPTION:
#       The port of the style_values_2 oracle's numeric_type_case: NumericTypes written as
#       "length=1 percent=-1 hint=length" (empty: the number type) are added, multiplied,
#       inverted, made consistent and matched against every <type> in five percentage contexts;
#       types are created from units and unit maps. tests_style_values_2 runs the cases.
#
#==============================================================================================

## The base type with this name (the oracle's `base_type_named`).
func test_sv2_base_type_named(name: ak.StringView) -> CssNumericTypeBaseType:
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        if ak.string_view_text(name) == ak.string_view_text(css_numeric_type_base_type_name(base_type)):
            return base_type
    trap("unknown base type")

## The oracle's `numeric_type_from`.
func test_sv2_numeric_type_from(text: ak.StringView) -> CssNumericType:
    var type_ = CssNumericType()
    let parts = ak.string_view_split_view_u8(&text, ' ')
    for part in ak.vector_span_const(&parts):
        let eq = ak.string_view_find_u8(&part, '=') else trap("no '='")
        let key = ak.string_view_substring_view_usize(&part, 0, eq)
        let value = ak.string_view_substring_view(&part, eq + 1)
        if ak.string_view_text(key) == "hint":
            css_numeric_type_set_percent_hint(&type_, test_sv2_base_type_named(value))
        else:
            css_numeric_type_set_exponent(&type_, test_sv2_base_type_named(key), ak.string_view_to_number_i32(&value) else trap("not a number"))
    return type_

## The oracle's `optional_type`: "<label>: <dump>" or "<label>: failure".
func test_sv2_optional_type(out: ak.StringBuilder*, label: str, type_: CssNumericType?):
    var text = ak.string_from_str("failure")
    if let present = type_:
        text = css_numeric_type_dump(&present)
    test_css_line(out, 1, css_string_formatted("{}: {}", [ak.arg_str(label), css_arg_string(&text)]))

## The oracle's `numeric_type_case`: `operation` on the types of `input` ("a|b").
func test_sv2_numeric_type_case(out: ak.StringBuilder*, operation: str, input: str) -> unit:
    let input_view = ak.sv(input)
    let bar = ak.string_view_find_u8(&input_view, '|')
    let typed = operation != "unit" and operation != "unitmap"
    var a = CssNumericType()
    var b = CssNumericType()
    if typed:
        let a_text = ak.string_view_substring_view_usize(&input_view, 0, bar else input_view.m_length)
        a = test_sv2_numeric_type_from(ak.string_view_trim_whitespace(&a_text))
        if let index = bar:
            let b_text = ak.string_view_substring_view(&input_view, index + 1)
            b = test_sv2_numeric_type_from(ak.string_view_trim_whitespace(&b_text))

    if operation == "add":
        test_sv2_optional_type(out, "added", css_numeric_type_added_to(&a, b))
        test_css_line(out, 1, css_string_formatted("consistent: {}", [ak.arg_str(test_sv2_flag(css_numeric_type_has_consistent_type_with(&a, b)))]))
    elif operation == "multiply":
        test_sv2_optional_type(out, "multiplied", css_numeric_type_multiplied_by(&a, b))
    elif operation == "invert":
        test_sv2_optional_type(out, "inverted", css_numeric_type_inverted(&a))
    elif operation == "consistent":
        test_sv2_optional_type(out, "made consistent", css_numeric_type_made_consistent_with(&a, b))
    elif operation == "matches":
        let resolve_as_values: (CssValueType?)[5] = [none, CssValueType.length, CssValueType.number, CssValueType.angle, CssValueType.percentage]
        for resolve_as in resolve_as_values:
            var text = ak.string_builder_new()
            if let value_type = resolve_as:
                ak.string_builder_append_string_view(&text, css_value_type_to_string(value_type))
            else:
                ak.string_builder_append(&text, "none")
            ak.string_builder_append(&text, ": angle=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_angle(&a, resolve_as)))
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_angle_percentage(&a, resolve_as)))
            ak.string_builder_append(&text, " flex=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_flex(&a, resolve_as)))
            ak.string_builder_append(&text, " frequency=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_frequency(&a, resolve_as)))
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_frequency_percentage(&a, resolve_as)))
            ak.string_builder_append(&text, " length=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_length(&a, resolve_as)))
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_length_percentage(&a, resolve_as)))
            ak.string_builder_append(&text, " number=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_number(&a, resolve_as)))
            ak.string_builder_append(&text, " percentage=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_percentage(&a)))
            ak.string_builder_append(&text, " resolution=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_resolution(&a, resolve_as)))
            ak.string_builder_append(&text, " time=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_time(&a, resolve_as)))
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_time_percentage(&a, resolve_as)))
            ak.string_builder_append(&text, " dimension=")
            ak.string_builder_append(&text, test_sv2_flag(css_numeric_type_matches_dimension(&a)))
            ak.string_builder_append(&text, " entry=")
            if let entry = css_numeric_type_entry_with_value_1_while_all_others_are_0(&a):
                ak.string_builder_append_string_view(&text, css_numeric_type_base_type_name(entry))
            else:
                ak.string_builder_append(&text, "None")
            test_css_line(out, 1, ak.string_builder_to_string_without_validation(&text))
    elif operation == "unit":
        test_sv2_optional_type(out, "from unit", css_numeric_type_create_from_unit(ak.fly_string_from_str(input)))
    elif operation == "unitmap":
        var map = ak.HashMap[ak.FlyString, i32, ak.FlyStringTraits]()
        let parts = ak.string_view_split_view_u8(&input_view, ' ')
        for part in ak.vector_span_const(&parts):
            let eq = ak.string_view_find_u8(&part, '=') else trap("no '='")
            let unit_view = ak.string_view_substring_view_usize(&part, 0, eq)
            let power_view = ak.string_view_substring_view(&part, eq + 1)
            let unit_name = ak.fly_string_from_utf8(unit_view) else trap("not UTF-8")
            discard(ak.hash_map_set(&map, unit_name, ak.string_view_to_number_i32(&power_view) else trap("not a number")))
        test_sv2_optional_type(out, "from unit map", css_numeric_type_create_from_unit_map(map))
    else:
        test_css_line(out, 1, ak.string_from_str("unknown operation"))
