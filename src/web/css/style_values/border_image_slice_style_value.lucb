## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:15 Web::CSS::BorderImageSliceStyleValue::create.
pub func css_border_image_slice_style_value_create(top: CssStyleValue*, right: CssStyleValue*, bottom: CssStyleValue*, left: CssStyleValue*, fill: bool) -> CssBorderImageSliceStyleValue*:
    let this = &(alloc CssBorderImageSliceStyleValue[1] else trap("out of memory"))[0]
    css_border_image_slice_style_value_construct(this, top, right, bottom, left, fill)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:22 Web::CSS::BorderImageSliceStyleValue::top.
pub func css_border_image_slice_style_value_top(this: CssBorderImageSliceStyleValue*) -> CssStyleValue*:
    return this.m_properties.top

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:23 Web::CSS::BorderImageSliceStyleValue::left.
pub func css_border_image_slice_style_value_left(this: CssBorderImageSliceStyleValue*) -> CssStyleValue*:
    return this.m_properties.left

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:24 Web::CSS::BorderImageSliceStyleValue::bottom.
pub func css_border_image_slice_style_value_bottom(this: CssBorderImageSliceStyleValue*) -> CssStyleValue*:
    return this.m_properties.bottom

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:25 Web::CSS::BorderImageSliceStyleValue::right.
pub func css_border_image_slice_style_value_right(this: CssBorderImageSliceStyleValue*) -> CssStyleValue*:
    return this.m_properties.right

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:27 Web::CSS::BorderImageSliceStyleValue::fill.
pub func css_border_image_slice_style_value_fill(this: CssBorderImageSliceStyleValue*) -> bool:
    return this.m_properties.fill

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.cpp:12 Web::CSS::BorderImageSliceStyleValue::serialize (override).
pub func css_border_image_slice_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssBorderImageSliceStyleValue*)base
    let top = css_border_image_slice_style_value_top(this)
    let right = css_border_image_slice_style_value_right(this)
    let bottom = css_border_image_slice_style_value_bottom(this)
    let left = css_border_image_slice_style_value_left(this)
    css_style_value_serialize(top, builder, mode)
    # NB: The sides are ValueComparingNonnullRefPtrs, so these comparisons compare values.
    if not (css_style_values_equal(top, right) and css_style_values_equal(top, bottom) and css_style_values_equal(top, left)):
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(right, builder, mode)
        if not css_style_values_equal(top, bottom) or not css_style_values_equal(right, left):
            ak.string_builder_append_u8(builder, ' ')
            css_style_value_serialize(bottom, builder, mode)
            if not css_style_values_equal(left, right):
                ak.string_builder_append_u8(builder, ' ')
                css_style_value_serialize(left, builder, mode)

    if css_border_image_slice_style_value_fill(this):
        ak.string_builder_append(builder, " fill")

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:31 Web::CSS::BorderImageSliceStyleValue::properties_equal.
pub func css_border_image_slice_style_value_properties_equal(this: CssBorderImageSliceStyleValue*, other: CssBorderImageSliceStyleValue*) -> bool:
    return css_style_values_equal(this.m_properties.top, other.m_properties.top) and css_style_values_equal(this.m_properties.right, other.m_properties.right) and css_style_values_equal(this.m_properties.bottom, other.m_properties.bottom) and css_style_values_equal(this.m_properties.left, other.m_properties.left) and this.m_properties.fill == other.m_properties.fill

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::BorderImageSliceStyleValue (CRTP helper) (override).
pub func css_border_image_slice_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_border_image_slice_style_value_properties_equal((CssBorderImageSliceStyleValue*)base, (CssBorderImageSliceStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:33 Web::CSS::BorderImageSliceStyleValue::is_computationally_independent (override).
pub func css_border_image_slice_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssBorderImageSliceStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_properties.top) and css_style_value_is_computationally_independent(this.m_properties.right) and css_style_value_is_computationally_independent(this.m_properties.bottom) and css_style_value_is_computationally_independent(this.m_properties.left)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderImageSliceStyleValue.h:42 Web::CSS::BorderImageSliceStyleValue::BorderImageSliceStyleValue.
pub func css_border_image_slice_style_value_construct(this: CssBorderImageSliceStyleValue*, top: CssStyleValue*, right: CssStyleValue*, bottom: CssStyleValue*, left: CssStyleValue*, fill: bool):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.border_image_slice)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_border_image_slice_style_value_vtable, &css_border_image_slice_style_value_class)
    this.m_properties = CssBorderImageSliceStyleValueProperties(top = top, right = right, bottom = bottom, left = left, fill = fill)
