## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.cpp:11 Web::CSS::TextIndentStyleValue::create.
pub func css_text_indent_style_value_create(length_percentage: CssStyleValue*, hanging: CssTextIndentStyleValueHanging, each_line: CssTextIndentStyleValueEachLine) -> CssTextIndentStyleValue*:
    let this = &(alloc CssTextIndentStyleValue[1] else trap("out of memory"))[0]
    css_text_indent_style_value_construct(this, length_percentage, hanging, each_line)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.cpp:16 Web::CSS::TextIndentStyleValue::TextIndentStyleValue.
pub func css_text_indent_style_value_construct(this: CssTextIndentStyleValue*, length_percentage: CssStyleValue*, hanging: CssTextIndentStyleValueHanging, each_line: CssTextIndentStyleValueEachLine):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.text_indent)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_text_indent_style_value_vtable, &css_text_indent_style_value_class)
    this.m_length_percentage = length_percentage
    this.m_hanging = hanging == CssTextIndentStyleValueHanging.yes
    this.m_each_line = each_line == CssTextIndentStyleValueEachLine.yes

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.h:27 Web::CSS::TextIndentStyleValue::length_percentage.
pub func css_text_indent_style_value_length_percentage(this: CssTextIndentStyleValue*) -> CssStyleValue*:
    return this.m_length_percentage

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.h:28 Web::CSS::TextIndentStyleValue::hanging.
pub func css_text_indent_style_value_hanging(this: CssTextIndentStyleValue*) -> bool:
    return this.m_hanging

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.h:29 Web::CSS::TextIndentStyleValue::each_line.
pub func css_text_indent_style_value_each_line(this: CssTextIndentStyleValue*) -> bool:
    return this.m_each_line

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.cpp:26 Web::CSS::TextIndentStyleValue::serialize (override).
pub func css_text_indent_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssTextIndentStyleValue*)base
    css_style_value_serialize(this.m_length_percentage, builder, mode)
    if this.m_each_line:
        ak.string_builder_append(builder, " each-line")
    if this.m_hanging:
        ak.string_builder_append(builder, " hanging")

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.cpp:35 Web::CSS::TextIndentStyleValue::absolutized (override).
pub func css_text_indent_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssTextIndentStyleValue*)base
    let new_length_percentage = css_style_value_absolutized(this.m_length_percentage, context)
    if css_style_value_equals(new_length_percentage, this.m_length_percentage):
        return base
    return css_text_indent_style_value_create(new_length_percentage, CssTextIndentStyleValueHanging.yes if this.m_hanging else CssTextIndentStyleValueHanging.no, CssTextIndentStyleValueEachLine.yes if this.m_each_line else CssTextIndentStyleValueEachLine.no).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.cpp:45 Web::CSS::TextIndentStyleValue::properties_equal.
pub func css_text_indent_style_value_properties_equal(this: CssTextIndentStyleValue*, other: CssTextIndentStyleValue*) -> bool:
    return css_style_values_equal(this.m_length_percentage, other.m_length_percentage) and this.m_each_line == other.m_each_line and this.m_hanging == other.m_hanging

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::TextIndentStyleValue (CRTP helper) (override).
pub func css_text_indent_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_text_indent_style_value_properties_equal((CssTextIndentStyleValue*)base, (CssTextIndentStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/TextIndentStyleValue.h:35 Web::CSS::TextIndentStyleValue::is_computationally_independent (override).
pub func css_text_indent_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssTextIndentStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_length_percentage)
