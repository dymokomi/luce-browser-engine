# NOTE: This is not used for identifier sizes, like `cover` and `contain`.

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.h:21 Web::CSS::BackgroundSizeStyleValue::create.
pub func css_background_size_style_value_create(size_x: CssStyleValue*, size_y: CssStyleValue*) -> CssBackgroundSizeStyleValue*:
    let this = &(alloc CssBackgroundSizeStyleValue[1] else trap("out of memory"))[0]
    css_background_size_style_value_construct(this, size_x, size_y)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.cpp:14 Web::CSS::BackgroundSizeStyleValue::BackgroundSizeStyleValue.
pub func css_background_size_style_value_construct(this: CssBackgroundSizeStyleValue*, size_x: CssStyleValue*, size_y: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.background_size)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_background_size_style_value_vtable, &css_background_size_style_value_class)
    this.m_properties = CssBackgroundSizeStyleValueProperties(size_x = size_x, size_y = size_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.h:27 Web::CSS::BackgroundSizeStyleValue::size_x.
pub func css_background_size_style_value_size_x(this: CssBackgroundSizeStyleValue*) -> CssStyleValue*:
    return this.m_properties.size_x

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.h:28 Web::CSS::BackgroundSizeStyleValue::size_y.
pub func css_background_size_style_value_size_y(this: CssBackgroundSizeStyleValue*) -> CssStyleValue*:
    return this.m_properties.size_y

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.cpp:22 Web::CSS::BackgroundSizeStyleValue::serialize (override).
pub func css_background_size_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssBackgroundSizeStyleValue*)base
    if css_style_value_has_auto(this.m_properties.size_x) and css_style_value_has_auto(this.m_properties.size_y):
        ak.string_builder_append(builder, "auto")
        return
    css_style_value_serialize(this.m_properties.size_x, builder, mode)
    ak.string_builder_append_u8(builder, ' ')
    css_style_value_serialize(this.m_properties.size_y, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.cpp:33 Web::CSS::BackgroundSizeStyleValue::absolutized (override).
pub func css_background_size_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssBackgroundSizeStyleValue*)base
    let absolutized_size_x = css_style_value_absolutized(this.m_properties.size_x, computation_context)
    let absolutized_size_y = css_style_value_absolutized(this.m_properties.size_y, computation_context)
    if css_style_values_equal(absolutized_size_x, this.m_properties.size_x) and css_style_values_equal(absolutized_size_y, this.m_properties.size_y):
        return base
    return css_background_size_style_value_create(absolutized_size_x, absolutized_size_y).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.h:33 Web::CSS::BackgroundSizeStyleValue::properties_equal.
pub func css_background_size_style_value_properties_equal(this: CssBackgroundSizeStyleValue*, other: CssBackgroundSizeStyleValue*) -> bool:
    return css_style_values_equal(this.m_properties.size_x, other.m_properties.size_x) and css_style_values_equal(this.m_properties.size_y, other.m_properties.size_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::BackgroundSizeStyleValue (CRTP helper) (override).
pub func css_background_size_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_background_size_style_value_properties_equal((CssBackgroundSizeStyleValue*)base, (CssBackgroundSizeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/BackgroundSizeStyleValue.h:35 Web::CSS::BackgroundSizeStyleValue::is_computationally_independent (override).
pub func css_background_size_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssBackgroundSizeStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_properties.size_x) and css_style_value_is_computationally_independent(this.m_properties.size_y)
