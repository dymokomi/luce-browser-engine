## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.h:15 Web::CSS::RatioStyleValue::create.
pub func css_ratio_style_value_create(numerator: CssStyleValue*, denominator: CssStyleValue*) -> CssRatioStyleValue*:
    let this = &(new CssRatioStyleValue[1] --- else trap("out of memory"))[0]
    css_ratio_style_value_construct(this, numerator, denominator)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.cpp:15 Web::CSS::RatioStyleValue::resolved.
pub func css_ratio_style_value_resolved(this: CssRatioStyleValue*) -> CssRatio:
    return css_ratio_new(css_number_from_style_value(this.m_numerator, none), css_number_from_style_value(this.m_denominator, none))

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.cpp:20 Web::CSS::RatioStyleValue::absolutized (override).
pub func css_ratio_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssRatioStyleValue*)base
    let absolutized_numerator = css_style_value_absolutized(this.m_numerator, computation_context)
    let absolutized_denominator = css_style_value_absolutized(this.m_denominator, computation_context)

    if css_style_values_equal(absolutized_numerator, this.m_numerator) and css_style_values_equal(absolutized_denominator, this.m_denominator):
        return base

    return css_ratio_style_value_create(absolutized_numerator, absolutized_denominator).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.cpp:31 Web::CSS::RatioStyleValue::serialize (override).
pub func css_ratio_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssRatioStyleValue*)base
    css_style_value_serialize(this.m_numerator, builder, mode)
    ak.string_builder_append(builder, " / ")
    css_style_value_serialize(this.m_denominator, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.cpp:38 Web::CSS::RatioStyleValue::tokenize (override).
pub func css_ratio_style_value_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    let this = (CssRatioStyleValue*)base
    var component_values = ak.Vector[css_syntax.ComponentValue]()
    var numerator_values = css_style_value_tokenize(this.m_numerator)
    ak.vector_extend(&component_values, &numerator_values)
    ak.vector_append_t(&component_values, css_syntax.component_value_from_token(css_syntax.token_create_whitespace(ak.string_from_str(" "))))
    ak.vector_append_t(&component_values, css_syntax.component_value_from_token(css_syntax.token_create_delim((u32)'/', ak.String())))
    ak.vector_append_t(&component_values, css_syntax.component_value_from_token(css_syntax.token_create_whitespace(ak.string_from_str(" "))))
    var denominator_values = css_style_value_tokenize(this.m_denominator)
    ak.vector_extend(&component_values, &denominator_values)
    return component_values

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.h:28 Web::CSS::RatioStyleValue::properties_equal.
pub func css_ratio_style_value_properties_equal(this: CssRatioStyleValue*, other: CssRatioStyleValue*) -> bool:
    return css_style_values_equal(this.m_numerator, other.m_numerator) and css_style_values_equal(this.m_denominator, other.m_denominator)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::RatioStyleValue (CRTP helper) (override).
pub func css_ratio_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_ratio_style_value_properties_equal((CssRatioStyleValue*)base, (CssRatioStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.h:34 Web::CSS::RatioStyleValue::is_computationally_independent (override).
pub func css_ratio_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssRatioStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_numerator) and css_style_value_is_computationally_independent(this.m_denominator)

## Ported from Libraries/LibWeb/CSS/StyleValues/RatioStyleValue.h:37 Web::CSS::RatioStyleValue::RatioStyleValue.
pub func css_ratio_style_value_construct(this: CssRatioStyleValue*, numerator: CssStyleValue*, denominator: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.ratio)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_ratio_style_value_vtable, &css_ratio_style_value_class)
    this.m_numerator = numerator
    this.m_denominator = denominator
