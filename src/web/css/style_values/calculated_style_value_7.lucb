## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2857 Web::CSS::RemCalculationNode::equals (override).
pub func css_rem_calculation_node_equals_impl(base: CssCalculationNode*, other: CssCalculationNode*) -> bool:
    let this = (CssRemCalculationNode*)base
    if base == other:
        return true
    if css_calculation_node_type(base) != css_calculation_node_type(other):
        return false
    return css_calculation_node_equals(this.m_x, ((CssRemCalculationNode*)other).m_x) and css_calculation_node_equals(this.m_y, ((CssRemCalculationNode*)other).m_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.cpp:2867 Web::CSS::RemCalculationNode::is_computationally_independent (override).
pub func css_rem_calculation_node_is_computationally_independent_impl(base: CssCalculationNode*) -> bool:
    let this = (CssRemCalculationNode*)base
    return css_calculation_node_is_computationally_independent(this.m_x) and css_calculation_node_is_computationally_independent(this.m_y)

## Ported from Libraries/LibWeb/CSS/StyleValues/CalculatedStyleValue.h:808 Web::CSS::RemCalculationNode::children (override).
pub func css_rem_calculation_node_children_impl(base: CssCalculationNode*) -> ak.Vector[CssCalculationNode*]:
    let this = (CssRemCalculationNode*)base
    var children = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&children, this.m_x)
    ak.vector_append_t(&children, this.m_y)
    return children

