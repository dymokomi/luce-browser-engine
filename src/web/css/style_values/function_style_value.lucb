## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:15 Web::CSS::FunctionStyleValue::create.
pub func css_function_style_value_create(name: ak.FlyString, value: CssStyleValue*) -> CssFunctionStyleValue*:
    let this = &(new CssFunctionStyleValue[1] --- else trap("out of memory"))[0]
    css_function_style_value_construct(this, name, value)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:20 Web::CSS::FunctionStyleValue::name.
pub func css_function_style_value_name(this: CssFunctionStyleValue*) -> ak.FlyString:
    return this.m_name

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:21 Web::CSS::FunctionStyleValue::value.
pub func css_function_style_value_value(this: CssFunctionStyleValue*) -> CssStyleValue*:
    return this.m_value

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.cpp:11 Web::CSS::FunctionStyleValue::absolutized (override).
pub func css_function_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssFunctionStyleValue*)base
    let absolutized_value = css_style_value_absolutized(this.m_value, context)
    if css_style_values_equal(absolutized_value, this.m_value):
        return base
    return css_function_style_value_create(this.m_name, absolutized_value).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.cpp:21 Web::CSS::FunctionStyleValue::serialize (override).
pub func css_function_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssFunctionStyleValue*)base
    ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&this.m_name))
    ak.string_builder_append_u8(builder, '(')
    css_style_value_serialize(this.m_value, builder, mode)
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:26 Web::CSS::FunctionStyleValue::properties_equal.
pub func css_function_style_value_properties_equal(this: CssFunctionStyleValue*, other: CssFunctionStyleValue*) -> bool:
    return ak.fly_string_eq_fly_string(&this.m_name, &other.m_name) and css_style_values_equal(this.m_value, other.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::FunctionStyleValue (CRTP helper) (override).
pub func css_function_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_function_style_value_properties_equal((CssFunctionStyleValue*)base, (CssFunctionStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:28 Web::CSS::FunctionStyleValue::is_computationally_independent (override).
pub func css_function_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssFunctionStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/FunctionStyleValue.h:31 Web::CSS::FunctionStyleValue::FunctionStyleValue.
pub func css_function_style_value_construct(this: CssFunctionStyleValue*, name: ak.FlyString, value: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.function)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_function_style_value_vtable, &css_function_style_value_class)
    this.m_name = name
    this.m_value = value
