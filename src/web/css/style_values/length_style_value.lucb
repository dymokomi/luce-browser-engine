#       Copyright (c) 2022-2023, MacDue <macdue@dueutil.tech>
#       Copyright (c) 2021-2024, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# The static `value`s of LengthStyleValue::create: 0px and 1px, made on first use.
var css_length_style_value_zero_px: CssLengthStyleValue*?
var css_length_style_value_one_px: CssLengthStyleValue*?

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.cpp:14 Web::CSS::LengthStyleValue::create.
pub func css_length_style_value_create(length: CssLength) -> CssLengthStyleValue*:
    if css_length_is_px(&length):
        if css_length_raw_value(&length) == 0.0:
            if let value = css_length_style_value_zero_px:
                return value
            with memory.heap:
                let value = &(alloc CssLengthStyleValue[1] else trap("out of memory"))[0]
                css_length_style_value_construct(value, css_length_make_px_css_pixels(gfx.CssPixels.from_int(0)))
                css_length_style_value_zero_px = value
                return value
        if css_length_raw_value(&length) == 1.0:
            if let value = css_length_style_value_one_px:
                return value
            with memory.heap:
                let value = &(alloc CssLengthStyleValue[1] else trap("out of memory"))[0]
                css_length_style_value_construct(value, css_length_make_px_css_pixels(gfx.CssPixels.from_int(1)))
                css_length_style_value_one_px = value
                return value
    let this = &(alloc CssLengthStyleValue[1] else trap("out of memory"))[0]
    css_length_style_value_construct(this, length)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.cpp:29 Web::CSS::LengthStyleValue::absolutized (override).
pub func css_length_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssLengthStyleValue*)base
    if let length = css_length_absolutize(&this.m_length, computation_context.length_resolution_context):
        return css_length_style_value_create(length).css_style_value()
    return base

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.cpp:36 Web::CSS::LengthStyleValue::equals (override).
pub func css_length_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssLengthStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_length = css_style_value_as_length(other)
    return css_length_eq(&this.m_length, other_length.m_length)

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:23 Web::CSS::LengthStyleValue::length.
pub func css_length_style_value_length(this: CssLengthStyleValue*) -> CssLength:
    return this.m_length

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:24 Web::CSS::LengthStyleValue::raw_value (override).
pub func css_length_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssLengthStyleValue*)base
    return css_length_raw_value(&this.m_length)

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:25 Web::CSS::LengthStyleValue::unit_name (override).
pub func css_length_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssLengthStyleValue*)base
    return css_length_unit_name(&this.m_length)

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:27 Web::CSS::LengthStyleValue::serialize (override).
pub func css_length_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssLengthStyleValue*)base
    css_length_serialize(&this.m_length, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:30 Web::CSS::LengthStyleValue::is_computationally_independent (override).
pub func css_length_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssLengthStyleValue*)base
    return not css_length_is_font_relative(&this.m_length)

## Ported from Libraries/LibWeb/CSS/StyleValues/LengthStyleValue.h:35 Web::CSS::LengthStyleValue::LengthStyleValue.
pub func css_length_style_value_construct(this: CssLengthStyleValue*, length: CssLength):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.length)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_length_style_value_vtable, &css_length_style_value_class)
    this.m_length = length
