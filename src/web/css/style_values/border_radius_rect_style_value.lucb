## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.h:37 Web::CSS::BorderRadiusRectStyleValue::properties_equal.
pub func css_border_radius_rect_style_value_properties_equal(this: CssBorderRadiusRectStyleValue*, other: CssBorderRadiusRectStyleValue*) -> bool:
    return css_style_values_equal(this.m_top_left, other.m_top_left) and css_style_values_equal(this.m_top_right, other.m_top_right) and css_style_values_equal(this.m_bottom_right, other.m_bottom_right) and css_style_values_equal(this.m_bottom_left, other.m_bottom_left)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::BorderRadiusRectStyleValue (CRTP helper) (override).
pub func css_border_radius_rect_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_border_radius_rect_style_value_properties_equal((CssBorderRadiusRectStyleValue*)base, (CssBorderRadiusRectStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.h:45 Web::CSS::BorderRadiusRectStyleValue::is_computationally_independent (override).
pub func css_border_radius_rect_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssBorderRadiusRectStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_top_left) and css_style_value_is_computationally_independent(this.m_top_right) and css_style_value_is_computationally_independent(this.m_bottom_right) and css_style_value_is_computationally_independent(this.m_bottom_left)

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.h:54 Web::CSS::BorderRadiusRectStyleValue::BorderRadiusRectStyleValue.
pub func css_border_radius_rect_style_value_construct(this: CssBorderRadiusRectStyleValue*, top_left: CssStyleValue*, top_right: CssStyleValue*, bottom_right: CssStyleValue*, bottom_left: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.border_radius_rect)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_border_radius_rect_style_value_vtable, &css_border_radius_rect_style_value_class)
    this.m_top_left = top_left
    this.m_top_right = top_right
    this.m_bottom_right = bottom_right
    this.m_bottom_left = bottom_left
