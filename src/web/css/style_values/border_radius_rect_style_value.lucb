## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.h:17 Web::CSS::BorderRadiusRectStyleValue::create_zero.
pub func css_border_radius_rect_style_value_create_zero() -> CssBorderRadiusRectStyleValue*:
    return css_border_radius_rect_style_value_create(css_border_radius_style_value_create_zero().css_style_value(), css_border_radius_style_value_create_zero().css_style_value(), css_border_radius_style_value_create_zero().css_style_value(), css_border_radius_style_value_create_zero().css_style_value())

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.h:22 Web::CSS::BorderRadiusRectStyleValue::create.
pub func css_border_radius_rect_style_value_create(top_left: CssStyleValue*, top_right: CssStyleValue*, bottom_right: CssStyleValue*, bottom_left: CssStyleValue*) -> CssBorderRadiusRectStyleValue*:
    let this = &(new CssBorderRadiusRectStyleValue[1] --- else trap("out of memory"))[0]
    css_border_radius_rect_style_value_construct(this, top_left, top_right, bottom_right, bottom_left)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.cpp:13 Web::CSS::BorderRadiusRectStyleValue::serialize (override).
pub func css_border_radius_rect_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssBorderRadiusRectStyleValue*)base
    var horizontal_radii = ak.Vector[CssStyleValue*]()
    ak.vector_append_t(&horizontal_radii, css_border_radius_style_value_horizontal_radius(css_style_value_as_border_radius(this.m_top_left)))
    ak.vector_append_t(&horizontal_radii, css_border_radius_style_value_horizontal_radius(css_style_value_as_border_radius(this.m_top_right)))
    ak.vector_append_t(&horizontal_radii, css_border_radius_style_value_horizontal_radius(css_style_value_as_border_radius(this.m_bottom_right)))
    ak.vector_append_t(&horizontal_radii, css_border_radius_style_value_horizontal_radius(css_style_value_as_border_radius(this.m_bottom_left)))
    let horizontal_radii_serialized = css_serialize_a_positional_value_list(&horizontal_radii, mode)
    var vertical_radii = ak.Vector[CssStyleValue*]()
    ak.vector_append_t(&vertical_radii, css_border_radius_style_value_vertical_radius(css_style_value_as_border_radius(this.m_top_left)))
    ak.vector_append_t(&vertical_radii, css_border_radius_style_value_vertical_radius(css_style_value_as_border_radius(this.m_top_right)))
    ak.vector_append_t(&vertical_radii, css_border_radius_style_value_vertical_radius(css_style_value_as_border_radius(this.m_bottom_right)))
    ak.vector_append_t(&vertical_radii, css_border_radius_style_value_vertical_radius(css_style_value_as_border_radius(this.m_bottom_left)))
    let vertical_radii_serialized = css_serialize_a_positional_value_list(&vertical_radii, mode)

    if ak.string_equals(&horizontal_radii_serialized, &vertical_radii_serialized):
        ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&horizontal_radii_serialized))
        return

    css_appendff(builder, "{} / {}", [css_arg_string(&horizontal_radii_serialized), css_arg_string(&vertical_radii_serialized)])

## Ported from Libraries/LibWeb/CSS/StyleValues/BorderRadiusRectStyleValue.cpp:31 Web::CSS::BorderRadiusRectStyleValue::absolutized (override).
pub func css_border_radius_rect_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssBorderRadiusRectStyleValue*)base
    let top_left_absolutized = css_style_value_absolutized(this.m_top_left, computation_context)
    let top_right_absolutized = css_style_value_absolutized(this.m_top_right, computation_context)
    let bottom_right_absolutized = css_style_value_absolutized(this.m_bottom_right, computation_context)
    let bottom_left_absolutized = css_style_value_absolutized(this.m_bottom_left, computation_context)
    return css_border_radius_rect_style_value_create(top_left_absolutized, top_right_absolutized, bottom_right_absolutized, bottom_left_absolutized).css_style_value()

