## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:16 Web::CSS::ResolutionStyleValue::create.
pub func css_resolution_style_value_create(resolution: CssResolution) -> CssResolutionStyleValue*:
    let this = &(new CssResolutionStyleValue[1] --- else trap("out of memory"))[0]
    css_resolution_style_value_construct(this, resolution)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:22 Web::CSS::ResolutionStyleValue::resolution.
pub func css_resolution_style_value_resolution(this: CssResolutionStyleValue*) -> CssResolution:
    return this.m_resolution

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:23 Web::CSS::ResolutionStyleValue::raw_value (override).
pub func css_resolution_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssResolutionStyleValue*)base
    return css_resolution_raw_value(&this.m_resolution)

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:24 Web::CSS::ResolutionStyleValue::unit_name (override).
pub func css_resolution_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    let this = (CssResolutionStyleValue*)base
    return css_resolution_unit_name(&this.m_resolution)

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:26 Web::CSS::ResolutionStyleValue::serialize (override).
pub func css_resolution_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssResolutionStyleValue*)base
    css_resolution_serialize(&this.m_resolution, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:28 Web::CSS::ResolutionStyleValue::is_computationally_independent (override).
pub func css_resolution_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:30 Web::CSS::ResolutionStyleValue::equals (override).
pub func css_resolution_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssResolutionStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_resolution = css_style_value_as_resolution(other)
    return css_resolution_eq(&this.m_resolution, other_resolution.m_resolution)

## Ported from Libraries/LibWeb/CSS/StyleValues/ResolutionStyleValue.h:39 Web::CSS::ResolutionStyleValue::ResolutionStyleValue.
pub func css_resolution_style_value_construct(this: CssResolutionStyleValue*, resolution: CssResolution):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.resolution)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_resolution_style_value_vtable, &css_resolution_style_value_class)
    this.m_resolution = resolution
