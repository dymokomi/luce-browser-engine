## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:19 Web::CSS::PercentageStyleValue::create.
pub func css_percentage_style_value_create(percentage: CssPercentage) -> CssPercentageStyleValue*:
    let this = &(new CssPercentageStyleValue[1] --- else trap("out of memory"))[0]
    css_percentage_style_value_construct(this, percentage)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:25 Web::CSS::PercentageStyleValue::percentage.
pub func css_percentage_style_value_percentage(this: CssPercentageStyleValue*) -> CssPercentage:
    return this.m_percentage

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:26 Web::CSS::PercentageStyleValue::raw_value (override).
pub func css_percentage_style_value_raw_value_impl(base: CssDimensionStyleValue*) -> f64:
    let this = (CssPercentageStyleValue*)base
    return css_percentage_value(&this.m_percentage)

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:27 Web::CSS::PercentageStyleValue::unit_name (override).
pub func css_percentage_style_value_unit_name_impl(base: CssDimensionStyleValue*) -> ak.FlyString:
    _ = base
    return ak.fly_string_from_str("percent")

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:29 Web::CSS::PercentageStyleValue::serialize (override).
pub func css_percentage_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    _ = arg1
    let this = (CssPercentageStyleValue*)base
    let string = css_percentage_to_string(&this.m_percentage)
    ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&string))

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:31 Web::CSS::PercentageStyleValue::equals (override).
pub func css_percentage_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssPercentageStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_percentage = css_style_value_as_percentage(other)
    return css_percentage_eq(&this.m_percentage, other_percentage.m_percentage)

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:39 Web::CSS::PercentageStyleValue::is_computationally_independent (override).
pub func css_percentage_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/PercentageStyleValue.h:42 Web::CSS::PercentageStyleValue::PercentageStyleValue.
pub func css_percentage_style_value_construct(this: CssPercentageStyleValue*, percentage: CssPercentage):
    css_dimension_style_value_construct(this.css_dimension_style_value(), CssStyleValueType.percentage)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_percentage_style_value_vtable, &css_percentage_style_value_class)
    this.m_percentage = percentage
