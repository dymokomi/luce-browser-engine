## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.cpp:14 Web::CSS::GridTrackSizeListStyleValue::serialize (override).
pub func css_grid_track_size_list_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssGridTrackSizeListStyleValue*)base
    css_grid_track_size_list_serialize(&this.m_grid_track_size_list, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.cpp:19 Web::CSS::GridTrackSizeListStyleValue::create.
pub func css_grid_track_size_list_style_value_create(grid_track_size_list: CssGridTrackSizeList) -> CssGridTrackSizeListStyleValue*:
    let this = &(alloc CssGridTrackSizeListStyleValue[1] else trap("out of memory"))[0]
    css_grid_track_size_list_style_value_construct(this, grid_track_size_list)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.cpp:24 Web::CSS::GridTrackSizeListStyleValue::make_auto.
pub func css_grid_track_size_list_style_value_make_auto() -> CssGridTrackSizeListStyleValue*:
    return css_grid_track_size_list_style_value_create(CssGridTrackSizeList())

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.cpp:29 Web::CSS::GridTrackSizeListStyleValue::make_none.
pub func css_grid_track_size_list_style_value_make_none() -> CssGridTrackSizeListStyleValue*:
    return css_grid_track_size_list_style_value_create(CssGridTrackSizeList())

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.cpp:34 Web::CSS::GridTrackSizeListStyleValue::absolutized (override).
pub func css_grid_track_size_list_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssGridTrackSizeListStyleValue*)base
    let absolutized = css_grid_track_size_list_absolutized(&this.m_grid_track_size_list, context)
    if css_grid_track_size_list_eq(&absolutized, this.m_grid_track_size_list):
        return base
    return css_grid_track_size_list_style_value_create(absolutized).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.h:36 Web::CSS::GridTrackSizeListStyleValue::GridTrackSizeListStyleValue.
pub func css_grid_track_size_list_style_value_construct(this: CssGridTrackSizeListStyleValue*, grid_track_size_list: CssGridTrackSizeList):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.grid_track_size_list)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_grid_track_size_list_style_value_vtable, &css_grid_track_size_list_style_value_class)
    this.m_grid_track_size_list = grid_track_size_list

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.h:25 Web::CSS::GridTrackSizeListStyleValue::grid_track_size_list.
pub func css_grid_track_size_list_style_value_grid_track_size_list(this: CssGridTrackSizeListStyleValue*) -> CssGridTrackSizeList:
    return this.m_grid_track_size_list

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.h:31 Web::CSS::GridTrackSizeListStyleValue::properties_equal.
pub func css_grid_track_size_list_style_value_properties_equal(this: CssGridTrackSizeListStyleValue*, other: CssGridTrackSizeListStyleValue*) -> bool:
    return css_grid_track_size_list_eq(&this.m_grid_track_size_list, other.m_grid_track_size_list)

## Ported from Libraries/LibWeb/CSS/StyleValues/GridTrackSizeListStyleValue.h:33 Web::CSS::GridTrackSizeListStyleValue::is_computationally_independent (override).
pub func css_grid_track_size_list_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssGridTrackSizeListStyleValue*)base
    return css_grid_track_size_list_is_computationally_independent(&this.m_grid_track_size_list)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::GridTrackSizeListStyleValue (CRTP helper) (override).
pub func css_grid_track_size_list_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_grid_track_size_list_style_value_properties_equal((CssGridTrackSizeListStyleValue*)base, (CssGridTrackSizeListStyleValue*)other)
