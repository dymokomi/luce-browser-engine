# mark: Creation and accessors ==================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:20 Web::CSS::ColorFunctionStyleValue::create.
pub func css_color_function_style_value_create(color_type: CssColorStyleValueColorType, c1: CssStyleValue*, c2: CssStyleValue*, c3: CssStyleValue*, alpha: CssStyleValue*? = none, color_syntax: CssColorSyntax = CssColorSyntax.modern, name: ak.FlyString? = none) -> CssColorFunctionStyleValue*:
    let descriptor = css_color_function_descriptor_for(color_type)
    assert(descriptor.serialization_behavior == CssSerializationBehavior.srgb_legacy or color_syntax == CssColorSyntax.modern)

    var nonnull_alpha = alpha else css_number_style_value_create(1.0).css_style_value()

    let this = &(new CssColorFunctionStyleValue[1] --- else trap("out of memory"))[0]
    css_color_function_style_value_construct(this, color_type, c1, c2, c3, nonnull_alpha, color_syntax, name)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.h:59 Web::CSS::ColorFunctionStyleValue::ColorFunctionStyleValue.
pub func css_color_function_style_value_construct(this: CssColorFunctionStyleValue*, color_type: CssColorStyleValueColorType, c1: CssStyleValue*, c2: CssStyleValue*, c3: CssStyleValue*, alpha: CssStyleValue*, color_syntax: CssColorSyntax, name: ak.FlyString?):
    css_color_style_value_construct(this.css_color_style_value(), color_type, color_syntax)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_color_function_style_value_vtable, &css_color_function_style_value_class)
    this.m_channels = [c1, c2, c3]
    this.m_alpha = alpha
    this.m_name = name

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.h:32 Web::CSS::ColorFunctionStyleValue::channel.
pub func css_color_function_style_value_channel(this: CssColorFunctionStyleValue*, index: usize) -> CssStyleValue*:
    return this.m_channels[index]

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.h:33 Web::CSS::ColorFunctionStyleValue::alpha.
pub func css_color_function_style_value_alpha(this: CssColorFunctionStyleValue*) -> CssStyleValue*:
    return this.m_alpha

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.h:34 Web::CSS::ColorFunctionStyleValue::name.
pub func css_color_function_style_value_name(this: CssColorFunctionStyleValue*) -> ak.FlyString?:
    return this.m_name

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.h:36 Web::CSS::ColorFunctionStyleValue::descriptor.
pub func css_color_function_style_value_descriptor(this: CssColorFunctionStyleValue*) -> CssColorFunctionDescriptor:
    return css_color_function_descriptor_for(css_color_style_value_color_type(this.css_color_style_value()) else trap("VERIFY: a color type"))

# mark: Resolving to a color ====================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:48 Web::CSS::(anonymous)::resolve_channels_for.
func css_resolve_channels_for(descriptor: CssColorFunctionDescriptor, channels: CssStyleValue*[3], alpha_style_value: CssStyleValue*, calculation_resolution_context: CssCalculationResolutionContext) -> CssResolvedChannels?:
    var resolved_channels: (f64?)[3]
    for i in 0..<3:
        let channel_descriptor = descriptor.channels[i]
        if channel_descriptor.kind == CssChannelKind.hue:
            resolved_channels[i] = css_color_style_value_resolve_hue(channels[i], calculation_resolution_context)
        else:
            resolved_channels[i] = css_color_style_value_resolve_with_reference_value(channels[i], channel_descriptor.percent_reference, calculation_resolution_context)
    let resolved_alpha = css_color_style_value_resolve_alpha(alpha_style_value, calculation_resolution_context)

    let c1 = resolved_channels[0] else return none
    let c2 = resolved_channels[1] else return none
    let c3 = resolved_channels[2] else return none
    let alpha = resolved_alpha else return none

    return CssResolvedChannels(c1 = c1, c2 = c2, c3 = c3, alpha = alpha)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:66 Web::CSS::(anonymous)::clamp_to_byte.
func css_clamp_to_byte(value: f64) -> u8:
    var number = value
    if math.is_nan(number):
        number = 0.0
    return (u8)(i64)math.round(ak.clamp_f64(number, 0.0, 255.0))

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:73 Web::CSS::(anonymous)::fraction_to_byte.
func css_fraction_to_byte(fraction_0_1: f64) -> u8:
    # Match CSS Color 4 "resolve to sRGB" rounding: round half away from zero,
    # not the default round-half-to-even that cvtsd2si uses.
    return (u8)(i64)math.round(ak.clamp_f64(fraction_0_1 * 255.0, 0.0, 255.0))

## `round_to<u8>(clamp(255.0 * v, 0.0, 255.0))`, the `to_u8` lambda of ColorFunctionStyleValue::to_color
## for sRGB: round half to even.
func css_srgb_channel_to_u8(v: f64) -> u8:
    return (u8)ak.rounding_round_to_f64_u32(ak.clamp_f64(255.0 * v, 0.0, 255.0))

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:82 Web::CSS::ColorFunctionStyleValue::to_color (override).
pub func css_color_function_style_value_to_color_impl(base: CssStyleValue*, color_resolution_context: CssColorResolutionContext) -> gfx.Color?:
    let this = (CssColorFunctionStyleValue*)base
    let resolved = css_resolve_channels_for(css_color_function_style_value_descriptor(this), this.m_channels, this.m_alpha, color_resolution_context.calculation_resolution_context) else return none

    let c1 = resolved.c1
    let c2 = resolved.c2
    let c3 = resolved.c3
    let alpha = resolved.alpha

    match css_color_style_value_color_type(this.css_color_style_value()) else trap("VERIFY: a color type"):
        .rgb:
            return gfx.color_new_u8_u8_u8_u8(css_clamp_to_byte(c1), css_clamp_to_byte(c2), css_clamp_to_byte(c3), css_fraction_to_byte(alpha))
        .hsl:
            return gfx.color_from_hsla((f32)c1, (f32)(c2 / 100.0), (f32)(c3 / 100.0), (f32)alpha)
        .hwb:
            let whiteness = (f32)(ak.clamp_f64(c2, 0.0, 100.0) / 100.0)
            let blackness = (f32)(ak.clamp_f64(c3, 0.0, 100.0) / 100.0)
            if whiteness + blackness >= 1.0f32:
                let gray = css_fraction_to_byte((f64)(whiteness / (whiteness + blackness)))
                return gfx.color_new_u8_u8_u8_u8(gray, gray, gray, css_fraction_to_byte(alpha))
            let value = 1.0f32 - blackness
            let saturation = 1.0f32 - (whiteness / value)
            let color = gfx.color_from_hsv_f64(c1, (f64)saturation, (f64)value)
            return gfx.color_with_opacity(&color, (f32)alpha)
        .lab:
            return gfx.color_from_lab((f32)ak.clamp_f64(c1, 0.0, 100.0), (f32)c2, (f32)c3, (f32)alpha)
        .ok_lab:
            return gfx.color_from_oklab((f32)ak.clamp_f64(c1, 0.0, 1.0), (f32)c2, (f32)c3, (f32)alpha)
        .lch:
            let l = ak.clamp_f64(c1, 0.0, 100.0)
            let hue_radians = ak.to_radians_f64(c3)
            return gfx.color_from_lab((f32)l, (f32)(c2 * math.cos(hue_radians)), (f32)(c2 * math.sin(hue_radians)), (f32)alpha)
        .oklch:
            let l = ak.clamp_f64(c1, 0.0, 1.0)
            let chroma = ak.max_f64(c2, 0.0)
            let hue_radians = ak.to_radians_f64(c3)
            return gfx.color_from_oklab((f32)l, (f32)(chroma * math.cos(hue_radians)), (f32)(chroma * math.sin(hue_radians)), (f32)alpha)
        .a98_rgb:
            return gfx.color_from_a98rgb((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .display_p3:
            return gfx.color_from_display_p3((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .display_p3_linear:
            return gfx.color_from_linear_display_p3((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .s_rgb:
            return gfx.color_new_u8_u8_u8_u8(css_srgb_channel_to_u8(c1), css_srgb_channel_to_u8(c2), css_srgb_channel_to_u8(c3), css_srgb_channel_to_u8(alpha))
        .s_rgb_linear:
            return gfx.color_from_linear_srgb_2((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .pro_photo_rgb:
            return gfx.color_from_pro_photo_rgb((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .rec2020:
            return gfx.color_from_rec2020((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .xyzd50:
            return gfx.color_from_xyz50((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        .xyzd65:
            return gfx.color_from_xyz65((f32)c1, (f32)c2, (f32)c3, (f32)alpha)
        _:
            trap("VERIFY_NOT_REACHED")

# mark: Absolutization ==========================================================================

## The `to_rgb` lambda of hsl_to_absolutized_rgb.
func css_hsl_channel_to_rgb(h: f64, s: f64, l: f64, offset: f64) -> f64:
    let k = math.mod(offset + h / 30.0, 12.0)
    let a = s * ak.min_f64(l, 1.0 - l)
    return l - a * ak.max_f64(-1.0, ak.min_f64(ak.min_f64(k - 3.0, 9.0 - k), 1.0))

# https://drafts.csswg.org/css-color-4/#hsl-to-rgb
## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:148 Web::CSS::(anonymous)::hsl_to_absolutized_rgb.
func css_hsl_to_absolutized_rgb(hue_degrees: f64, saturation_0_100: f64, lightness_0_100: f64, alpha_0_1: f64) -> CssStyleValue*:
    var hue = math.mod(hue_degrees, 360.0)
    if hue < 0.0:
        hue += 360.0
    let saturation = ak.clamp_f64(saturation_0_100 / 100.0, 0.0, 1.0)
    let lightness = ak.clamp_f64(lightness_0_100 / 100.0, 0.0, 1.0)

    let r = css_hsl_channel_to_rgb(hue, saturation, lightness, 0.0)
    let g = css_hsl_channel_to_rgb(hue, saturation, lightness, 8.0)
    let b = css_hsl_channel_to_rgb(hue, saturation, lightness, 4.0)

    return css_color_function_style_value_create(
        CssColorStyleValueColorType.rgb,
        css_number_style_value_create(ak.clamp_f64(r * 255.0, 0.0, 255.0)).css_style_value(),
        css_number_style_value_create(ak.clamp_f64(g * 255.0, 0.0, 255.0)).css_style_value(),
        css_number_style_value_create(ak.clamp_f64(b * 255.0, 0.0, 255.0)).css_style_value(),
        css_number_style_value_create(ak.clamp_f64(alpha_0_1, 0.0, 1.0)).css_style_value(),
        CssColorSyntax.legacy,
    ).css_style_value()

## The `hue_to_rgb` lambda of hwb_to_absolutized_rgb (float arithmetic, fmodf).
func css_hwb_hue_to_rgb(h: f32, offset: f32) -> f32:
    let k = (f32)math.mod((f64)(offset + h / 30.0f32), 12.0)
    return 0.5f32 - 0.5f32 * ak.max_f32(-1.0f32, ak.min_f32(ak.min_f32(k - 3.0f32, 9.0f32 - k), 1.0f32))

# https://drafts.csswg.org/css-color-4/#hwb-to-rgb
## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:176 Web::CSS::(anonymous)::hwb_to_absolutized_rgb.
func css_hwb_to_absolutized_rgb(hue_degrees: f64, whiteness_0_100: f64, blackness_0_100: f64, alpha_0_1: f64) -> CssStyleValue*:
    # NB: `whiteness_0_100 / 100.0f` is a double, so AK::clamp clamps in double; the result becomes a float.
    let whiteness = (f32)ak.clamp_f64(whiteness_0_100 / 100.0, 0.0, 1.0)
    let blackness = (f32)ak.clamp_f64(blackness_0_100 / 100.0, 0.0, 1.0)

    if whiteness + blackness >= 1.0f32:
        let gray = css_number_style_value_create((f64)ak.clamp_f32(whiteness / (whiteness + blackness) * 255.0f32, 0.0f32, 255.0f32)).css_style_value()
        return css_color_function_style_value_create(
            CssColorStyleValueColorType.rgb,
            gray,
            gray,
            gray,
            css_number_style_value_create(ak.clamp_f64(alpha_0_1, 0.0, 1.0)).css_style_value(),
            CssColorSyntax.legacy,
        ).css_style_value()

    var hue = (f32)math.mod((f64)(f32)hue_degrees, 360.0)
    if hue < 0.0f32:
        hue += 360.0f32

    let scale = 1.0f32 - whiteness - blackness
    let r = css_hwb_hue_to_rgb(hue, 0.0f32) * scale + whiteness
    let g = css_hwb_hue_to_rgb(hue, 8.0f32) * scale + whiteness
    let b = css_hwb_hue_to_rgb(hue, 4.0f32) * scale + whiteness

    return css_color_function_style_value_create(
        CssColorStyleValueColorType.rgb,
        css_number_style_value_create((f64)ak.clamp_f32(r * 255.0f32, 0.0f32, 255.0f32)).css_style_value(),
        css_number_style_value_create((f64)ak.clamp_f32(g * 255.0f32, 0.0f32, 255.0f32)).css_style_value(),
        css_number_style_value_create((f64)ak.clamp_f32(b * 255.0f32, 0.0f32, 255.0f32)).css_style_value(),
        css_number_style_value_create(ak.clamp_f64(alpha_0_1, 0.0, 1.0)).css_style_value(),
        CssColorSyntax.legacy,
    ).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:215 Web::CSS::ColorFunctionStyleValue::absolutized (override).
pub func css_color_function_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssColorFunctionStyleValue*)base
    let absolutized_c1 = css_style_value_absolutized(this.m_channels[0], context)
    let absolutized_c2 = css_style_value_absolutized(this.m_channels[1], context)
    let absolutized_c3 = css_style_value_absolutized(this.m_channels[2], context)
    let absolutized_alpha = css_style_value_absolutized(this.m_alpha, context)

    let descriptor = css_color_function_style_value_descriptor(this)
    if descriptor.absolutizes_to_rgb == CssAbsolutizesToRgb.yes:
        # https://drafts.csswg.org/css-color-4/#resolving-sRGB-values
        var c1: f64? = none
        if descriptor.channels[0].kind == CssChannelKind.hue:
            c1 = css_color_style_value_resolve_hue(absolutized_c1, CssCalculationResolutionContext())
        else:
            c1 = css_color_style_value_resolve_with_reference_value(absolutized_c1, descriptor.channels[0].percent_reference, CssCalculationResolutionContext())
        let c2 = css_color_style_value_resolve_with_reference_value(absolutized_c2, descriptor.channels[1].percent_reference, CssCalculationResolutionContext())
        let c3 = css_color_style_value_resolve_with_reference_value(absolutized_c3, descriptor.channels[2].percent_reference, CssCalculationResolutionContext())
        let alpha = css_color_style_value_resolve_alpha(absolutized_alpha, CssCalculationResolutionContext())

        let resolved_c1 = c1 else trap("VERIFY_NOT_REACHED")
        let resolved_c2 = c2 else trap("VERIFY_NOT_REACHED")
        let resolved_c3 = c3 else trap("VERIFY_NOT_REACHED")
        let resolved_alpha = alpha else trap("VERIFY_NOT_REACHED")

        if (css_color_style_value_color_type(this.css_color_style_value()) else trap("VERIFY: a color type")) == CssColorStyleValueColorType.hsl:
            return css_hsl_to_absolutized_rgb(resolved_c1, resolved_c2, resolved_c3, resolved_alpha)
        return css_hwb_to_absolutized_rgb(resolved_c1, resolved_c2, resolved_c3, resolved_alpha)

    if css_style_values_equal(absolutized_c1, this.m_channels[0]) and css_style_values_equal(absolutized_c2, this.m_channels[1]) and css_style_values_equal(absolutized_c3, this.m_channels[2]) and css_style_values_equal(absolutized_alpha, this.m_alpha):
        return base
    return css_color_function_style_value_create(css_color_style_value_color_type(this.css_color_style_value()) else trap("VERIFY: a color type"), absolutized_c1, absolutized_c2, absolutized_c3, absolutized_alpha, css_color_style_value_color_syntax(this.css_color_style_value()), this.m_name).css_style_value()

# mark: Equality and serialization ==============================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:245 Web::CSS::ColorFunctionStyleValue::equals (override).
pub func css_color_function_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssColorFunctionStyleValue*)base
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    let other_color = css_style_value_as_color(other)
    if css_color_style_value_color_type(this.css_color_style_value()) != css_color_style_value_color_type(other_color):
        return false
    let other_color_function = as_css_color_function_style_value(other_color)
    if not css_style_values_equal(this.m_channels[0], other_color_function.m_channels[0]) or not css_style_values_equal(this.m_channels[1], other_color_function.m_channels[1]) or not css_style_values_equal(this.m_channels[2], other_color_function.m_channels[2]):
        return false
    if not css_style_values_equal(this.m_alpha, other_color_function.m_alpha):
        return false
    return css_optional_fly_strings_equal(this.m_name, other_color_function.m_name)

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:264 Web::CSS::(anonymous)::alpha_should_be_serialized.
func css_alpha_should_be_serialized(alpha: CssStyleValue*) -> bool:
    if css_style_value_is_number(alpha) and css_number_style_value_number(css_style_value_as_number(alpha)) >= 1.0:
        return false
    if css_style_value_is_percentage(alpha):
        let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(alpha))
        if css_percentage_as_fraction(&percentage) >= 1.0:
            return false
    return true

## The `convert_percentage` lambda of ColorFunctionStyleValue::serialize.
func css_color_function_convert_percentage(value: CssStyleValue*, mode: css_syntax.SerializationMode) -> CssStyleValue*:
    if css_style_value_is_percentage(value):
        return css_number_style_value_create(css_dimension_style_value_raw_value(css_style_value_as_percentage(value).css_dimension_style_value()) / 100.0).css_style_value()
    if mode == css_syntax.SerializationMode.resolved_value and css_style_value_is_calculated(value):
        # FIXME: Figure out how to get the proper calculation resolution context here.
        let calculation_resolution_context = CssCalculationResolutionContext()
        let calculated = css_style_value_as_calculated(value)
        if css_calculated_style_value_resolves_to_percentage(calculated):
            if let resolved_percentage = css_calculated_style_value_resolve_percentage(calculated, calculation_resolution_context):
                var resolved_number = css_percentage_value(&resolved_percentage) / 100.0
                if not math.is_finite(resolved_number):
                    resolved_number = 0.0
                return css_number_style_value_create(resolved_number).css_style_value()
        elif css_calculated_style_value_resolves_to_number(calculated):
            if let resolved_number = css_calculated_style_value_resolve_number(calculated, calculation_resolution_context):
                return css_number_style_value_create(resolved_number).css_style_value()
    return value

## Ported from Libraries/LibWeb/CSS/StyleValues/ColorFunctionStyleValue.cpp:275 Web::CSS::ColorFunctionStyleValue::serialize (override).
pub func css_color_function_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssColorFunctionStyleValue*)base
    let descriptor = css_color_function_style_value_descriptor(this)

    if descriptor.serialization_behavior == CssSerializationBehavior.srgb_legacy or descriptor.serialization_behavior == CssSerializationBehavior.srgb_modern:
        if mode != css_syntax.SerializationMode.resolved_value:
            if let name = this.m_name:
                for c in ak.fly_string_bytes(&name):
                    ak.string_builder_append_u8(builder, (u8)ak.to_ascii_lowercase((u32)c))
                return
        # sRGB-equivalent shortcut: serialize via Color::serialize_a_srgb_value when the color resolves cleanly.
        if let color = css_style_value_to_color(base, CssColorResolutionContext()):
            let serialized = gfx.color_serialize_a_srgb_value(&color)
            ak.string_builder_append_string_view(builder, ak.string_bytes_as_string_view(&serialized))
            return

    # https://drafts.csswg.org/css-color-4/#serializing-color-function-values
    if descriptor.serialization_behavior == CssSerializationBehavior.color_function:
        var alpha = css_color_function_convert_percentage(this.m_alpha, mode)

        var is_alpha_required = true
        if css_style_value_is_number(alpha):
            is_alpha_required = css_number_style_value_number(css_style_value_as_number(alpha)) < 1.0

        if css_style_value_is_number(alpha) and css_number_style_value_number(css_style_value_as_number(alpha)) < 0.0:
            alpha = css_number_style_value_create(0.0).css_style_value()

        css_appendff(builder, "color({} ", [ak.arg_string_view(descriptor.function_name)])
        css_style_value_serialize(css_color_function_convert_percentage(this.m_channels[0], mode), builder, mode)
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(css_color_function_convert_percentage(this.m_channels[1], mode), builder, mode)
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(css_color_function_convert_percentage(this.m_channels[2], mode), builder, mode)
        if is_alpha_required:
            ak.string_builder_append(builder, " / ")
            css_style_value_serialize(alpha, builder, mode)
        ak.string_builder_append_u8(builder, ')')
        return

    ak.string_builder_append_string_view(builder, descriptor.function_name)
    ak.string_builder_append_u8(builder, '(')
    for i in 0..<3:
        if i > 0:
            ak.string_builder_append_u8(builder, ' ')
        let channel_descriptor = descriptor.channels[i]
        if channel_descriptor.kind == CssChannelKind.hue:
            css_color_style_value_serialize_hue_component(this.css_color_style_value(), builder, mode, this.m_channels[i])
        else:
            css_color_style_value_serialize_color_component(this.css_color_style_value(), builder, mode, this.m_channels[i], channel_descriptor.percent_reference, channel_descriptor.serialize_clamp_min, channel_descriptor.serialize_clamp_max)
    if css_alpha_should_be_serialized(this.m_alpha):
        ak.string_builder_append(builder, " / ")
        css_color_style_value_serialize_alpha_component(this.css_color_style_value(), builder, mode, this.m_alpha)
