## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.h:16 Web::CSS::OpacityValueStyleValue::create.
pub func css_opacity_value_style_value_create(value: CssStyleValue*) -> CssOpacityValueStyleValue*:
    let this = &(new CssOpacityValueStyleValue[1] --- else trap("out of memory"))[0]
    css_opacity_value_style_value_construct(this, value)
    return this

# https://drafts.csswg.org/css-color-4/#serializing-opacity-values
## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.cpp:13 Web::CSS::OpacityValueStyleValue::serialize (override).
pub func css_opacity_value_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssOpacityValueStyleValue*)base
    # If the specified value for an opacity value matches a literal <percentage-token> (i.e. does not use calc()) it
    # should be serialized as the equivalent <number> (0% maps to 0, 100% maps to 1) value. value.
    # NB: We resolve percentages to numbers at computed value time so this will only ever the the specified value.
    if css_style_value_is_percentage(this.m_value):
        let percentage = css_percentage_style_value_percentage(css_style_value_as_percentage(this.m_value))
        css_syntax.serialize_a_number_string_builder(builder, css_percentage_as_fraction(&percentage))
        return

    # Otherwise, the specified value for an opacity value should serialize using the standard serialization for the grammar.
    css_style_value_serialize(this.m_value, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.cpp:28 Web::CSS::OpacityValueStyleValue::absolutized (override).
pub func css_opacity_value_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssOpacityValueStyleValue*)base
    if css_style_value_is_number(this.m_value) and css_number_style_value_number(css_style_value_as_number(this.m_value)) > 0.0 and css_number_style_value_number(css_style_value_as_number(this.m_value)) < 1.0:
        return base

    let clamped_number_value = ak.clamp_f64(css_number_from_style_value(css_style_value_absolutized(this.m_value, computation_context), 1.0), 0.0, 1.0)
    return css_opacity_value_style_value_create(css_number_style_value_create(clamped_number_value).css_style_value()).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.h:27 Web::CSS::OpacityValueStyleValue::resolved.
pub func css_opacity_value_style_value_resolved(this: CssOpacityValueStyleValue*) -> f64:
    return css_number_style_value_number(css_style_value_as_number(this.m_value))

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.cpp:38 Web::CSS::OpacityValueStyleValue::reify (override).
pub func css_opacity_value_style_value_reify_impl(base: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    let this = (CssOpacityValueStyleValue*)base
    return css_style_value_reify(this.m_value, realm, associated_property)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.h:31 Web::CSS::OpacityValueStyleValue::properties_equal.
pub func css_opacity_value_style_value_properties_equal(this: CssOpacityValueStyleValue*, other: CssOpacityValueStyleValue*) -> bool:
    return css_style_values_equal(this.m_value, other.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::OpacityValueStyleValue (CRTP helper) (override).
pub func css_opacity_value_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_opacity_value_style_value_properties_equal((CssOpacityValueStyleValue*)base, (CssOpacityValueStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.h:33 Web::CSS::OpacityValueStyleValue::is_computationally_independent (override).
pub func css_opacity_value_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssOpacityValueStyleValue*)base
    return css_style_value_is_computationally_independent(this.m_value)

## Ported from Libraries/LibWeb/CSS/StyleValues/OpacityValueStyleValue.h:36 Web::CSS::OpacityValueStyleValue::OpacityValueStyleValue.
pub func css_opacity_value_style_value_construct(this: CssOpacityValueStyleValue*, value: CssStyleValue*):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.opacity_value)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_opacity_value_style_value_vtable, &css_opacity_value_style_value_class)
    this.m_value = value
