## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.h:26 Web::CSS::CounterDefinitionsStyleValue::create.
pub func css_counter_definitions_style_value_create(counter_definitions: ak.Vector[CssCounterDefinition]) -> CssCounterDefinitionsStyleValue*:
    let this = &(new CssCounterDefinitionsStyleValue[1] --- else trap("out of memory"))[0]
    css_counter_definitions_style_value_construct(this, counter_definitions)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.h:44 Web::CSS::CounterDefinitionsStyleValue::CounterDefinitionsStyleValue.
pub func css_counter_definitions_style_value_construct(this: CssCounterDefinitionsStyleValue*, counter_definitions: ak.Vector[CssCounterDefinition]):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.counter_definitions)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_counter_definitions_style_value_vtable, &css_counter_definitions_style_value_class)
    this.m_counter_definitions = counter_definitions

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.h:32 Web::CSS::CounterDefinitionsStyleValue::counter_definitions.
pub func css_counter_definitions_style_value_counter_definitions(this: CssCounterDefinitionsStyleValue*) -> ak.Vector[CssCounterDefinition]:
    return this.m_counter_definitions

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.cpp:12 Web::CSS::CounterDefinitionsStyleValue::serialize (override).
pub func css_counter_definitions_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssCounterDefinitionsStyleValue*)base
    var first = true
    for counter_definition in ak.vector_span_const(&this.m_counter_definitions):
        if first:
            first = false
        else:
            ak.string_builder_append_u8(builder, ' ')

        if counter_definition.is_reversed:
            css_appendff(builder, "reversed({})", [ak.arg_string_view(ak.fly_string_bytes_as_string_view(&counter_definition.name))])
        else:
            ak.string_builder_append_string_view(builder, ak.fly_string_bytes_as_string_view(&counter_definition.name))

        if let value = counter_definition.value:
            ak.string_builder_append_u8(builder, ' ')
            css_style_value_serialize(value, builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.cpp:33 Web::CSS::CounterDefinitionsStyleValue::absolutized (override).
pub func css_counter_definitions_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssCounterDefinitionsStyleValue*)base
    var computed_definitions = ak.Vector[CssCounterDefinition]()

    for specified_definition in ak.vector_span_const(&this.m_counter_definitions):
        var computed_definition = CssCounterDefinition(
            name = specified_definition.name,
            is_reversed = specified_definition.is_reversed,
            value = none,
        )

        if let value = specified_definition.value:
            computed_definition.value = css_style_value_absolutized(value, computation_context)

        ak.vector_append_t(&computed_definitions, computed_definition)

    return css_counter_definitions_style_value_create(computed_definitions).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.cpp:53 Web::CSS::CounterDefinitionsStyleValue::properties_equal.
pub func css_counter_definitions_style_value_properties_equal(this: CssCounterDefinitionsStyleValue*, other: CssCounterDefinitionsStyleValue*) -> bool:
    if ak.vector_size(&this.m_counter_definitions) != ak.vector_size(&other.m_counter_definitions):
        return false

    for i in 0..<ak.vector_size(&this.m_counter_definitions):
        let ours = ak.vector_at_const(&this.m_counter_definitions, i)
        let theirs = ak.vector_at_const(&other.m_counter_definitions, i)
        if not ak.fly_string_eq_fly_string(&ours.name, &theirs.name) or ours.is_reversed != theirs.is_reversed or not css_optional_style_values_equal(ours.value, theirs.value):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/CounterDefinitionsStyleValue.h:38 Web::CSS::CounterDefinitionsStyleValue::is_computationally_independent (override).
pub func css_counter_definitions_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssCounterDefinitionsStyleValue*)base
    for definition in ak.vector_span_const(&this.m_counter_definitions):
        if let value = definition.value:
            if not css_style_value_is_computationally_independent(value):
                return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::CounterDefinitionsStyleValue (CRTP helper) (override).
pub func css_counter_definitions_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_counter_definitions_style_value_properties_equal((CssCounterDefinitionsStyleValue*)base, (CssCounterDefinitionsStyleValue*)other)
