# https://drafts.csswg.org/css-color-5/#funcdef-light-dark

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.h:18 Web::CSS::LightDarkStyleValue::create.
pub func css_light_dark_style_value_create(light: CssStyleValue*, dark: CssStyleValue*) -> CssLightDarkStyleValue*:
    let this = &(new CssLightDarkStyleValue[1] --- else trap("out of memory"))[0]
    css_light_dark_style_value_construct(this, light, dark)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.h:30 Web::CSS::LightDarkStyleValue::LightDarkStyleValue.
pub func css_light_dark_style_value_construct(this: CssLightDarkStyleValue*, light: CssStyleValue*, dark: CssStyleValue*):
    css_color_style_value_construct(this.css_color_style_value(), none, CssColorSyntax.modern)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_light_dark_style_value_vtable, &css_light_dark_style_value_class)
    this.m_properties = CssLightDarkStyleValueProperties(light = light, dark = dark)

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.cpp:12 Web::CSS::LightDarkStyleValue::to_color (override).
pub func css_light_dark_style_value_to_color_impl(base: CssStyleValue*, color_resolution_context: CssColorResolutionContext) -> gfx.Color?:
    let this = (CssLightDarkStyleValue*)base
    if color_resolution_context.color_scheme == CssPreferredColorScheme.dark:
        return css_style_value_to_color(this.m_properties.dark, color_resolution_context)

    return css_style_value_to_color(this.m_properties.light, color_resolution_context)

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.cpp:20 Web::CSS::LightDarkStyleValue::absolutized (override).
pub func css_light_dark_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssLightDarkStyleValue*)base
    if context.color_scheme == none:
        return base

    if context.color_scheme == CssPreferredColorScheme.dark:
        return css_style_value_absolutized(this.m_properties.dark, context)

    return css_style_value_absolutized(this.m_properties.light, context)

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.cpp:31 Web::CSS::LightDarkStyleValue::equals (override).
pub func css_light_dark_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    let this = (CssLightDarkStyleValue*)base
    let other_light_dark = as_if_css_light_dark_style_value(other) else return false
    return css_style_values_equal(this.m_properties.light, other_light_dark.m_properties.light) and css_style_values_equal(this.m_properties.dark, other_light_dark.m_properties.dark)

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.cpp:39 Web::CSS::LightDarkStyleValue::serialize (override).
pub func css_light_dark_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssLightDarkStyleValue*)base
    # FIXME: We don't have enough information to determine the computed value here.
    ak.string_builder_append(builder, "light-dark(")
    css_style_value_serialize(this.m_properties.light, builder, mode)
    ak.string_builder_append(builder, ", ")
    css_style_value_serialize(this.m_properties.dark, builder, mode)
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/LightDarkStyleValue.h:27 Web::CSS::LightDarkStyleValue::is_computationally_independent (override).
pub func css_light_dark_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    _ = base
    return false
