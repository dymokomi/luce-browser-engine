## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.h:18 Web::CSS::ContentStyleValue::create.
pub func css_content_style_value_create(content: CssStyleValueList*, alt_text: CssStyleValueList*?) -> CssContentStyleValue*:
    let this = &(new CssContentStyleValue[1] --- else trap("out of memory"))[0]
    css_content_style_value_construct(this, content, alt_text)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.h:24 Web::CSS::ContentStyleValue::content.
pub func css_content_style_value_content(this: CssContentStyleValue*) -> CssStyleValueList*:
    return this.m_properties.content

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.h:25 Web::CSS::ContentStyleValue::alt_text.
pub func css_content_style_value_alt_text(this: CssContentStyleValue*) -> CssStyleValueList*?:
    return this.m_properties.alt_text

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.cpp:15 Web::CSS::ContentStyleValue::serialize (override).
pub func css_content_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssContentStyleValue*)base
    css_style_value_serialize(this.m_properties.content.css_style_value(), builder, mode)
    if let alt_text = this.m_properties.alt_text:
        ak.string_builder_append(builder, " / ")
        css_style_value_serialize(alt_text.css_style_value(), builder, mode)

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.h:29 Web::CSS::ContentStyleValue::properties_equal.
pub func css_content_style_value_properties_equal(this: CssContentStyleValue*, other: CssContentStyleValue*) -> bool:
    return css_style_values_equal(this.m_properties.content.css_style_value(), other.m_properties.content.css_style_value()) and css_optional_style_values_equal((CssStyleValue*?)this.m_properties.alt_text, (CssStyleValue*?)other.m_properties.alt_text)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::ContentStyleValue (CRTP helper) (override).
pub func css_content_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_content_style_value_properties_equal((CssContentStyleValue*)base, (CssContentStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.cpp:24 Web::CSS::ContentStyleValue::is_computationally_independent (override).
pub func css_content_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssContentStyleValue*)base
    if not css_style_value_is_computationally_independent(this.m_properties.content.css_style_value()):
        return false
    let alt_text = this.m_properties.alt_text else return true
    return css_style_value_is_computationally_independent(alt_text.css_style_value())

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.cpp:29 Web::CSS::ContentStyleValue::set_style_sheet (override).
pub func css_content_style_value_set_style_sheet_impl(base: CssStyleValue*, style_sheet: CssCssStyleSheet*?):
    let this = (CssContentStyleValue*)base
    css_style_value_set_style_sheet_impl(base, style_sheet)
    css_style_value_set_style_sheet(this.m_properties.content.css_style_value(), style_sheet)
    if let alt_text = this.m_properties.alt_text:
        css_style_value_set_style_sheet(alt_text.css_style_value(), style_sheet)

## Ported from Libraries/LibWeb/CSS/StyleValues/ContentStyleValue.h:36 Web::CSS::ContentStyleValue::ContentStyleValue.
pub func css_content_style_value_construct(this: CssContentStyleValue*, content: CssStyleValueList*, alt_text: CssStyleValueList*?):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.content)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_content_style_value_vtable, &css_content_style_value_class)
    this.m_properties = CssContentStyleValueProperties(content = content, alt_text = alt_text)
