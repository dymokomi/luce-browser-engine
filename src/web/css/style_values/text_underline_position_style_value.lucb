## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:15 Web::CSS::TextUnderlinePositionStyleValue::create.
pub func css_text_underline_position_style_value_create(horizontal: css_data.TextUnderlinePositionHorizontal, vertical: css_data.TextUnderlinePositionVertical) -> CssTextUnderlinePositionStyleValue*:
    let this = &(alloc CssTextUnderlinePositionStyleValue[1] else trap("out of memory"))[0]
    css_text_underline_position_style_value_construct(this, horizontal, vertical)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:21 Web::CSS::TextUnderlinePositionStyleValue::horizontal.
pub func css_text_underline_position_style_value_horizontal(this: CssTextUnderlinePositionStyleValue*) -> css_data.TextUnderlinePositionHorizontal:
    return this.m_horizontal

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:22 Web::CSS::TextUnderlinePositionStyleValue::vertical.
pub func css_text_underline_position_style_value_vertical(this: CssTextUnderlinePositionStyleValue*) -> css_data.TextUnderlinePositionVertical:
    return this.m_vertical

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.cpp:12 Web::CSS::TextUnderlinePositionStyleValue::serialize (override).
pub func css_text_underline_position_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, arg1: css_syntax.SerializationMode):
    discard(arg1)
    let this = (CssTextUnderlinePositionStyleValue*)base
    if this.m_horizontal == css_data.TextUnderlinePositionHorizontal.auto and this.m_vertical == css_data.TextUnderlinePositionVertical.auto:
        ak.string_builder_append(builder, "auto")
        return

    if this.m_vertical == css_data.TextUnderlinePositionVertical.auto:
        ak.string_builder_append_string_view(builder, css_data.to_string_text_underline_position_horizo(this.m_horizontal))
        return

    if this.m_horizontal == css_data.TextUnderlinePositionHorizontal.auto:
        ak.string_builder_append_string_view(builder, css_data.to_string_text_underline_position_vertic(this.m_vertical))
        return

    css_appendff(builder, "{} {}", [ak.arg_string_view(css_data.to_string_text_underline_position_horizo(this.m_horizontal)), ak.arg_string_view(css_data.to_string_text_underline_position_vertic(this.m_vertical))])

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:26 Web::CSS::TextUnderlinePositionStyleValue::properties_equal.
pub func css_text_underline_position_style_value_properties_equal(this: CssTextUnderlinePositionStyleValue*, other: CssTextUnderlinePositionStyleValue*) -> bool:
    return this.m_horizontal == other.m_horizontal and this.m_vertical == other.m_vertical

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::TextUnderlinePositionStyleValue (CRTP helper) (override).
pub func css_text_underline_position_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_text_underline_position_style_value_properties_equal((CssTextUnderlinePositionStyleValue*)base, (CssTextUnderlinePositionStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:28 Web::CSS::TextUnderlinePositionStyleValue::is_computationally_independent (override).
pub func css_text_underline_position_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/TextUnderlinePositionStyleValue.h:31 Web::CSS::TextUnderlinePositionStyleValue::TextUnderlinePositionStyleValue.
pub func css_text_underline_position_style_value_construct(this: CssTextUnderlinePositionStyleValue*, horizontal: css_data.TextUnderlinePositionHorizontal, vertical: css_data.TextUnderlinePositionVertical):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.text_underline_position)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_text_underline_position_style_value_vtable, &css_text_underline_position_style_value_class)
    this.m_horizontal = horizontal
    this.m_vertical = vertical
