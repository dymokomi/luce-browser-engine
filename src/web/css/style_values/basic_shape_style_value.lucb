        return css_style_value_is_computationally_independent(position)
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:258 Web::CSS::Polygon::to_path.
pub func css_polygon_to_path(this: const CssPolygon*, reference_box: gfx.CssPixelRect, node: LayoutNode*) -> gfx.Path:
    var path = gfx.Path()
    gfx.path_set_fill_type(&path, this.fill_rule)
    var first = true
    for point in ak.vector_span_const(&this.points):
        let x = css_length_percentage_from_style_value(point.x)
        let y = css_length_percentage_from_style_value(point.y)
        let resolved_point = gfx.FloatPoint(
            m_x = css_percentage_or_to_px(&x.percentage_or, node, gfx.css_pixel_rect_width(&reference_box)).to_float(),
            m_y = css_percentage_or_to_px(&y.percentage_or, node, gfx.css_pixel_rect_height(&reference_box)).to_float(),
        )
        if first:
            gfx.path_move_to(&path, resolved_point)
        else:
            gfx.path_line_to(&path, resolved_point)
        first = false
    gfx.path_close(&path)
    return path

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:278 Web::CSS::Polygon::serialize.
pub func css_polygon_serialize(this: const CssPolygon*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    ak.string_builder_append(builder, "polygon(")
    var first = true
    match this.fill_rule:
        .nonzero: discard(0)
        .even_odd:
            first = false
            ak.string_builder_append(builder, "evenodd")
        _: discard(0)
    for point in ak.vector_span_const(&this.points):
        if not first:
            ak.string_builder_append(builder, ", ")
        first = false
        css_style_value_serialize(point.x, builder, mode)
        ak.string_builder_append_u8(builder, ' ')
        css_style_value_serialize(point.y, builder, mode)
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:129 Web::CSS::Polygon::is_computationally_independent.
pub func css_polygon_is_computationally_independent(this: const CssPolygon*) -> bool:
    for point in ak.vector_span_const(&this.points):
        if not (css_style_value_is_computationally_independent(point.x) and css_style_value_is_computationally_independent(point.y)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:300 Web::CSS::Path::to_path.
pub func css_path_to_path(this: const CssPath*, reference_box: gfx.CssPixelRect, arg1: LayoutNode*) -> gfx.Path:
    discard(reference_box)
    discard(arg1)
    var result = svg_path_to_gfx_path(&this.path_instructions)
    gfx.path_set_fill_type(&result, this.fill_rule)
    return result

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:308 Web::CSS::Path::serialize.
# https://drafts.csswg.org/css-shapes/#basic-shape-serialization
pub func css_path_serialize(this: const CssPath*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    ak.string_builder_append(builder, "path(")

    # For serializing computed values, component values are computed, and omitted when possible without changing the meaning.
    # NB: So, we don't include `nonzero` in that case.
    if not (mode == css_syntax.SerializationMode.resolved_value and this.fill_rule == gfx.WindingRule.nonzero):
        match this.fill_rule:
            .nonzero: ak.string_builder_append(builder, "nonzero, ")
            .even_odd: ak.string_builder_append(builder, "evenodd, ")
            _: discard(0)

    let serialized = svg_path_serialize(&this.path_instructions)
    css_syntax.serialize_a_string_string_builder(builder, ak.string_bytes_as_string_view(&serialized))
    ak.string_builder_append_u8(builder, ')')

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:145 Web::CSS::Path::is_computationally_independent.
pub func css_path_is_computationally_independent(this: const CssPath*) -> bool:
    discard(this)
    return true

