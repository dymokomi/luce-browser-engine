## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:156 Web::CSS::BasicShapeStyleValue::create.
pub func css_basic_shape_style_value_create(basic_shape: CssBasicShape) -> CssBasicShapeStyleValue*:
    let this = &(alloc CssBasicShapeStyleValue[1] else trap("out of memory"))[0]
    css_basic_shape_style_value_construct(this, basic_shape)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:177 Web::CSS::BasicShapeStyleValue::BasicShapeStyleValue.
pub func css_basic_shape_style_value_construct(this: CssBasicShapeStyleValue*, basic_shape: CssBasicShape):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.basic_shape)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_basic_shape_style_value_vtable, &css_basic_shape_style_value_class)
    this.m_basic_shape = basic_shape

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:162 Web::CSS::BasicShapeStyleValue::basic_shape.
pub func css_basic_shape_style_value_basic_shape(this: CssBasicShapeStyleValue*) -> CssBasicShape:
    return this.m_basic_shape

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:331 Web::CSS::BasicShapeStyleValue::to_path.
pub func css_basic_shape_style_value_to_path(this: CssBasicShapeStyleValue*, reference_box: gfx.CssPixelRect, node: LayoutNode*) -> gfx.Path:
    match this.m_basic_shape:
        .css_inset(shape): return css_inset_to_path(&shape, reference_box, node)
        .css_circle(shape): return css_circle_to_path(&shape, reference_box, node)
        .css_ellipse(shape): return css_ellipse_to_path(&shape, reference_box, node)
        .css_polygon(shape): return css_polygon_to_path(&shape, reference_box, node)
        .css_path(shape): return css_path_to_path(&shape, reference_box, node)
        # NB: Xywh and Rect don't require to_path functions as we should have already converted them to their
        #     respective Inset equivalents during absolutization
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:344 Web::CSS::BasicShapeStyleValue::serialize (override).
pub func css_basic_shape_style_value_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssBasicShapeStyleValue*)base
    match this.m_basic_shape:
        .css_inset(shape): css_inset_serialize(&shape, builder, mode)
        .css_xywh(shape): css_xywh_serialize(&shape, builder, mode)
        .css_rect(shape): css_rect_serialize(&shape, builder, mode)
        .css_circle(shape): css_circle_serialize(&shape, builder, mode)
        .css_ellipse(shape): css_ellipse_serialize(&shape, builder, mode)
        .css_polygon(shape): css_polygon_serialize(&shape, builder, mode)
        .css_path(shape): css_path_serialize(&shape, builder, mode)

## absolutized's `one_hundred_percent_minus` lambda: calc(100% - values...).
func css_one_hundred_percent_minus(values: const (CssStyleValue*)[], calculation_context: CssCalculationContext) -> CssCalculatedStyleValue*:
    var sum_components = ak.Vector[CssCalculationNode*]()
    ak.vector_append_t(&sum_components, css_numeric_calculation_node_create(CssCalculationNodeNumericValue.css_percentage(css_percentage_new(100.0)), calculation_context).css_calculation_node())
    for value in values:
        ak.vector_append_t(&sum_components, css_negate_calculation_node_create(css_calculation_node_from_style_value((CssStyleValue*)value, calculation_context)).css_calculation_node())
    return css_calculated_style_value_create(css_sum_calculation_node_create(sum_components).css_calculation_node(), css_numeric_type_new(.length, 1), calculation_context)

## absolutized's `absolutize_if_nonnull` lambda.
func css_absolutize_if_nonnull(value: CssStyleValue*?, computation_context: CssComputationContext) -> CssStyleValue*?:
    let present = value else return none
    return css_style_value_absolutized(present, computation_context)

## The Rect alternative's `resolve_auto` lambda.
func css_rect_resolve_auto(style_value: CssStyleValue*, value_of_auto: CssPercentage) -> CssStyleValue*:
    # An auto value makes the edge of the box coincide with the corresponding edge of the reference box:
    # it’s equivalent to 0% as the first (top) or fourth (left) value, and equivalent to 100% as the second
    # (right) or third (bottom) value.
    if css_style_value_is_keyword(style_value):
        assert(css_style_value_to_keyword(style_value) == css_data.Keyword.auto)
        return css_percentage_style_value_create(value_of_auto).css_style_value()
    return style_value

## The `visit` of absolutized: the absolutized shape.
func css_basic_shape_absolutized(shape_value: const CssBasicShape*, computation_context: CssComputationContext) -> CssBasicShape:
    let calculation_context = CssCalculationContext(percentages_resolve_as = CssValueType.length)
    match *shape_value:
        .css_inset(shape):
            let absolutized_top = css_style_value_absolutized(shape.top, computation_context)
            let absolutized_right = css_style_value_absolutized(shape.right, computation_context)
            let absolutized_bottom = css_style_value_absolutized(shape.bottom, computation_context)
            let absolutized_left = css_style_value_absolutized(shape.left, computation_context)
            let absolutized_border_radius = css_style_value_absolutized(shape.border_radius, computation_context)
            if (css_style_values_equal(absolutized_top, shape.top) and css_style_values_equal(absolutized_right, shape.right) and css_style_values_equal(absolutized_bottom, shape.bottom) and css_style_values_equal(absolutized_left, shape.left) and css_style_values_equal(absolutized_border_radius, shape.border_radius)):
                return *shape_value
            return CssBasicShape.css_inset(CssInset(top = absolutized_top, right = absolutized_right, bottom = absolutized_bottom, left = absolutized_left, border_radius = absolutized_border_radius))
        .css_xywh(shape):
            # Note: Given xywh(x y w h), the equivalent function is inset(y calc(100% - x - w) calc(100% - y - h) x).
            let absolutized_top = css_style_value_absolutized(shape.y, computation_context)
            let right_terms: CssStyleValue*[2] = [shape.x, shape.width]
            let absolutized_right = css_style_value_absolutized(css_one_hundred_percent_minus(right_terms, calculation_context).css_style_value(), computation_context)
            let bottom_terms: CssStyleValue*[2] = [shape.y, shape.height]
            let absolutized_bottom = css_style_value_absolutized(css_one_hundred_percent_minus(bottom_terms, calculation_context).css_style_value(), computation_context)
            let absolutized_left = css_style_value_absolutized(shape.x, computation_context)
            let absolutized_border_radius = css_style_value_absolutized(shape.border_radius, computation_context)
            return CssBasicShape.css_inset(CssInset(top = absolutized_top, right = absolutized_right, bottom = absolutized_bottom, left = absolutized_left, border_radius = absolutized_border_radius))
        .css_rect(shape):
            # Note: Given rect(t r b l), the equivalent function is inset(t calc(100% - r) calc(100% - b) l).
            let absolutized_top = css_style_value_absolutized(css_rect_resolve_auto(shape.top, css_percentage_new(0.0)), computation_context)
            let right_terms: CssStyleValue*[1] = [css_rect_resolve_auto(shape.right, css_percentage_new(100.0))]
            let absolutized_right = css_style_value_absolutized(css_one_hundred_percent_minus(right_terms, calculation_context).css_style_value(), computation_context)
            let bottom_terms: CssStyleValue*[1] = [css_rect_resolve_auto(shape.bottom, css_percentage_new(100.0))]
            let absolutized_bottom = css_style_value_absolutized(css_one_hundred_percent_minus(bottom_terms, calculation_context).css_style_value(), computation_context)
            let absolutized_left = css_style_value_absolutized(css_rect_resolve_auto(shape.left, css_percentage_new(0.0)), computation_context)
            let absolutized_border_radius = css_style_value_absolutized(shape.border_radius, computation_context)
            return CssBasicShape.css_inset(CssInset(top = absolutized_top, right = absolutized_right, bottom = absolutized_bottom, left = absolutized_left, border_radius = absolutized_border_radius))
        .css_circle(shape):
            let absolutized_radius = css_style_value_absolutized(shape.radius, computation_context)
            let absolutized_position = css_absolutize_if_nonnull(shape.position, computation_context)
            if css_style_values_equal(absolutized_radius, shape.radius) and css_optional_style_values_equal(absolutized_position, shape.position):
                return *shape_value
            return CssBasicShape.css_circle(CssCircle(radius = absolutized_radius, position = absolutized_position))
        .css_ellipse(shape):
            let absolutized_radius = css_style_value_absolutized(shape.radius, computation_context)
            let absolutized_position = css_absolutize_if_nonnull(shape.position, computation_context)
            if css_style_values_equal(absolutized_radius, shape.radius) and css_optional_style_values_equal(absolutized_position, shape.position):
                return *shape_value
            return CssBasicShape.css_ellipse(CssEllipse(radius = absolutized_radius, position = absolutized_position))
        .css_polygon(shape):
            var absolutized_points = ak.Vector[CssPolygonPoint]()
            ak.vector_ensure_capacity(&absolutized_points, ak.vector_size(&shape.points))
            var any_point_required_absolutization = false
            for point in ak.vector_span_const(&shape.points):
                let absolutized_x = css_style_value_absolutized(point.x, computation_context)
                let absolutized_y = css_style_value_absolutized(point.y, computation_context)
                if css_style_values_equal(absolutized_x, point.x) and css_style_values_equal(absolutized_y, point.y):
                    ak.vector_append_t(&absolutized_points, point)
                    continue
                any_point_required_absolutization = true
                ak.vector_append_t(&absolutized_points, CssPolygonPoint(x = absolutized_x, y = absolutized_y))
            if not any_point_required_absolutization:
                return *shape_value
            return CssBasicShape.css_polygon(CssPolygon(fill_rule = shape.fill_rule, points = absolutized_points))
        .css_path(_):
            return *shape_value

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.cpp:352 Web::CSS::BasicShapeStyleValue::absolutized (override).
# https://www.w3.org/TR/css-shapes-1/#basic-shape-computed-values
pub func css_basic_shape_style_value_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssBasicShapeStyleValue*)base
    # The values in a <basic-shape> function are computed as specified, with these exceptions:
    # - Omitted values are included and compute to their defaults.
    # FIXME: - A <position> value in circle() or ellipse() is computed as a pair of offsets (horizontal then vertical) from the top left origin, each given as a <length-percentage>.
    # FIXME: - A <'border-radius'> value in a <basic-shape-rect> function is computed as an expanded list of all eight <length-percentage> values.
    # - All <basic-shape-rect> functions compute to the equivalent inset() function.
    let absolutized_shape = css_basic_shape_absolutized(&this.m_basic_shape, computation_context)

    if css_basic_shapes_equal(&absolutized_shape, &this.m_basic_shape):
        return base

    return css_basic_shape_style_value_create(absolutized_shape).css_style_value()

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:167 Web::CSS::BasicShapeStyleValue::properties_equal.
pub func css_basic_shape_style_value_properties_equal(this: CssBasicShapeStyleValue*, other: CssBasicShapeStyleValue*) -> bool:
    return css_basic_shapes_equal(&this.m_basic_shape, &other.m_basic_shape)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::BasicShapeStyleValue (CRTP helper) (override).
pub func css_basic_shape_style_value_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_basic_shape_style_value_properties_equal((CssBasicShapeStyleValue*)base, (CssBasicShapeStyleValue*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/BasicShapeStyleValue.h:169 Web::CSS::BasicShapeStyleValue::is_computationally_independent (override).
pub func css_basic_shape_style_value_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssBasicShapeStyleValue*)base
    match this.m_basic_shape:
        .css_inset(shape): return css_inset_is_computationally_independent(&shape)
        .css_xywh(shape): return css_xywh_is_computationally_independent(&shape)
        .css_rect(shape): return css_rect_is_computationally_independent(&shape)
        .css_circle(shape): return css_circle_is_computationally_independent(&shape)
        .css_ellipse(shape): return css_ellipse_is_computationally_independent(&shape)
        .css_polygon(shape): return css_polygon_is_computationally_independent(&shape)
        .css_path(shape): return css_path_is_computationally_independent(&shape)
