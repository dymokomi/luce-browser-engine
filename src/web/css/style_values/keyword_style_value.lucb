## Ported from Libraries/LibWeb/CSS/StyleValues/KeywordStyleValue.cpp:363 Web::CSS::KeywordStyleValue::absolutized (override).
pub func css_keyword_style_value_absolutized_impl(base: CssStyleValue*, context: CssComputationContext) -> CssStyleValue*:
    let this = (CssKeywordStyleValue*)base
    if not css_style_value_has_color(base):
        return base

    # The currentcolor keyword computes to itself.
    # https://drafts.csswg.org/css-color-4/#resolving-other-colors
    if css_keyword_style_value_keyword(this) == css_data.Keyword.currentcolor:
        return base

    var color_resolution_context = CssColorResolutionContext()
    if let abstract_element = context.abstract_element:
        color_resolution_context.document = dom_abstract_element_document(&abstract_element)
        color_resolution_context.calculation_resolution_context = css_calculation_resolution_context_from_computation_context(context)
        color_resolution_context.color_scheme = context.color_scheme

    let resolved_color = css_style_value_to_color(base, color_resolution_context) else return base

    return css_color_function_style_value_create(
        CssColorStyleValueColorType.rgb,
        css_number_style_value_create((f64)gfx.color_red(&resolved_color)).css_style_value(),
        css_number_style_value_create((f64)gfx.color_green(&resolved_color)).css_style_value(),
        css_number_style_value_create((f64)gfx.color_blue(&resolved_color)).css_style_value(),
        css_number_style_value_create((f64)((f32)gfx.color_alpha(&resolved_color) / 255.0f32)).css_style_value(),
        CssColorSyntax.legacy,
    ).css_style_value()
