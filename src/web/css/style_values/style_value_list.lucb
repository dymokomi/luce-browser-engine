# mark: StyleValueList ==========================================================================

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:26 Web::CSS::StyleValueList::create.
pub func css_style_value_list_create(values: ak.Vector[CssStyleValue*], separator: CssStyleValueListSeparator, collapsible: CssStyleValueListCollapsible = CssStyleValueListCollapsible.yes) -> CssStyleValueList*:
    let this = &(new CssStyleValueList[1] --- else trap("out of memory"))[0]
    css_style_value_list_construct(this, values, separator, collapsible)
    return this

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:59 Web::CSS::StyleValueList::StyleValueList.
pub func css_style_value_list_construct(this: CssStyleValueList*, values: ak.Vector[CssStyleValue*], separator: CssStyleValueListSeparator, collapsible: CssStyleValueListCollapsible = CssStyleValueListCollapsible.yes):
    css_style_value_construct(this.css_style_value(), CssStyleValueType.value_list)
    css_style_value_set_class(this.css_style_value(), (const CssStyleValueVTable*)&css_style_value_list_vtable, &css_style_value_list_class)
    this.m_properties = CssStyleValueListProperties(separator = separator, collapsible = collapsible, values = values)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:31 Web::CSS::StyleValueList::size.
pub func css_style_value_list_size(this: CssStyleValueList*) -> usize:
    return ak.vector_size(&this.m_properties.values)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:32 Web::CSS::StyleValueList::values.
pub func css_style_value_list_values(this: CssStyleValueList*) -> ak.Vector[CssStyleValue*]:
    return this.m_properties.values

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:33 Web::CSS::StyleValueList::value_at.
pub func css_style_value_list_value_at(this: CssStyleValueList*, i: usize, allow_loop: bool) -> CssStyleValue*:
    if allow_loop:
        return *ak.vector_at_const(&this.m_properties.values, i % css_style_value_list_size(this))
    return *ak.vector_at_const(&this.m_properties.values, i)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:47 Web::CSS::StyleValueList::properties_equal.
pub func css_style_value_list_properties_equal(this: CssStyleValueList*, other: CssStyleValueList*) -> bool:
    return css_style_value_list_properties_eq(&this.m_properties, other.m_properties)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValue.h:202 Web::CSS::StyleValueWithDefaultOperators::equals for Web::CSS::StyleValueList (CRTP helper) (override).
pub func css_style_value_list_equals_impl(base: CssStyleValue*, other: CssStyleValue*) -> bool:
    if css_style_value_type(base) != css_style_value_type(other):
        return false
    return css_style_value_list_properties_equal((CssStyleValueList*)base, (CssStyleValueList*)other)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:49 Web::CSS::StyleValueList::is_computationally_independent (override).
pub func css_style_value_list_is_computationally_independent_impl(base: CssStyleValue*) -> bool:
    let this = (CssStyleValueList*)base
    for value in ak.vector_span_const(&this.m_properties.values):
        if not css_style_value_is_computationally_independent(value):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.h:54 Web::CSS::StyleValueList::separator.
pub func css_style_value_list_separator(this: CssStyleValueList*) -> CssStyleValueListSeparator:
    return this.m_properties.separator

## `Vector<ValueComparingNonnullRefPtr<StyleValue const>>`'s `==` (also its span's): the same size and
## values that compare as ValueComparingNonnullRefPtrs.
pub func css_style_value_vectors_equal(a: const ak.Vector[CssStyleValue*]*, b: const ak.Vector[CssStyleValue*]*) -> bool:
    if ak.vector_size(a) != ak.vector_size(b):
        return false
    for i in 0..<ak.vector_size(a):
        if not css_style_values_equal(*ak.vector_at_const(a, i), *ak.vector_at_const(b, i)):
            return false
    return true

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:21 Web::CSS::StyleValueList::Properties::operator==.
pub func css_style_value_list_properties_eq(this: const CssStyleValueListProperties*, other: CssStyleValueListProperties) -> bool:
    return this.separator == other.separator and css_style_value_vectors_equal(&this.values, &other.values)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:26 Web::CSS::StyleValueList::absolutized (override).
pub func css_style_value_list_absolutized_impl(base: CssStyleValue*, computation_context: CssComputationContext) -> CssStyleValue*:
    let this = (CssStyleValueList*)base
    let values = &this.m_properties.values
    for i in 0..<ak.vector_size(values):
        let absolutized_value = css_style_value_absolutized(*ak.vector_at_const(values, i), computation_context)
        if not css_style_values_equal(absolutized_value, *ak.vector_at_const(values, i)):
            var result = ak.Vector[CssStyleValue*]()
            ak.vector_ensure_capacity(&result, ak.vector_size(values))
            for j in 0..<i:
                ak.vector_append_t(&result, *ak.vector_at_const(values, j))
            ak.vector_append_t(&result, absolutized_value)
            for j in i + 1..<ak.vector_size(values):
                ak.vector_append_t(&result, css_style_value_absolutized(*ak.vector_at_const(values, j), computation_context))
            return css_style_value_list_create(result, this.m_properties.separator).css_style_value()
    return base

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:44 Web::CSS::StyleValueList::serialize (override).
pub func css_style_value_list_serialize_impl(base: CssStyleValue*, builder: ak.StringBuilder*, mode: css_syntax.SerializationMode):
    let this = (CssStyleValueList*)base
    if ak.vector_is_empty(&this.m_properties.values):
        return

    var separator = ""
    match this.m_properties.separator:
        .space:
            separator = " "
        .comma:
            separator = ", "
        _:
            trap("VERIFY_NOT_REACHED")

    let first_value = *ak.vector_first_const(&this.m_properties.values)
    var all_same = true
    for property in ak.vector_span_const(&this.m_properties.values):
        if not css_style_values_equal(property, first_value):
            all_same = false
            break
    if all_same and this.m_properties.separator != CssStyleValueListSeparator.comma and this.m_properties.collapsible == CssStyleValueListCollapsible.yes:
        css_style_value_serialize(first_value, builder, mode)
        return

    for i in 0..<ak.vector_size(&this.m_properties.values):
        css_style_value_serialize(*ak.vector_at_const(&this.m_properties.values, i), builder, mode)
        if i != ak.vector_size(&this.m_properties.values) - 1:
            ak.string_builder_append(builder, separator)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:74 Web::CSS::StyleValueList::set_style_sheet (override).
pub func css_style_value_list_set_style_sheet_impl(base: CssStyleValue*, style_sheet: CssCssStyleSheet*?):
    let this = (CssStyleValueList*)base
    css_style_value_set_style_sheet_impl(base, style_sheet)
    for value in ak.vector_span_const(&this.m_properties.values):
        css_style_value_set_style_sheet(value, style_sheet)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:81 Web::CSS::StyleValueList::tokenize (override).
pub func css_style_value_list_tokenize_impl(base: CssStyleValue*) -> ak.Vector[css_syntax.ComponentValue]:
    let this = (CssStyleValueList*)base
    var component_values = ak.Vector[css_syntax.ComponentValue]()
    var first = true
    for value in ak.vector_span_const(&this.m_properties.values):
        if first:
            first = false
        else:
            if this.m_properties.separator == CssStyleValueListSeparator.comma:
                ak.vector_append_t(&component_values, css_syntax.component_value_from_token(css_syntax.token_create(css_syntax.TokenType.comma, ak.String())))
            ak.vector_append_t(&component_values, css_syntax.component_value_from_token(css_syntax.token_create_whitespace(ak.string_from_str(" "))))
        var value_tokens = css_style_value_tokenize(value)
        ak.vector_extend(&component_values, &value_tokens)

    return component_values

# mark: Reification =============================================================================

# https://drafts.css-houdini.org/css-typed-om-1/#reify-a-transform-list
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:98 Web::CSS::reify_a_transform_list.
func css_reify_a_transform_list(realm: Realm*, values: ak.Vector[CssStyleValue*]) -> CssCssStyleValue*!:
    var transform_components = ak.Vector[CssTransformComponent*]()
    for transform in ak.vector_span_const(&values):
        # NB: Not all transform functions are reifiable, in which case we give up reifying as a transform list.
        ak.vector_append_t(&transform_components, try css_transformation_style_value_reify_a_transform_function(css_style_value_as_transformation(transform), realm))
    return (CssCssStyleValue*)css_transform_value_create(realm, transform_components)

## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:110 Web::CSS::StyleValueList::reify (override).
pub func css_style_value_list_reify_impl(base: CssStyleValue*, realm: Realm*, associated_property: ak.FlyString) -> CssCssStyleValue*:
    let this = (CssStyleValueList*)base
    # NB: <transform-list> is a StyleValueList that contains TransformStyleValues. If that's what we are, follow the
    #     steps for reifying that.
    var all_transformations = true
    for value in ak.vector_span_const(&this.m_properties.values):
        if not css_style_value_is_transformation(value):
            all_transformations = false
            break
    if all_transformations:
        let transform_list: CssCssStyleValue*? = css_reify_a_transform_list(realm, this.m_properties.values) catch:
            recover none
        if let list = transform_list:
            return list

    # NB: Otherwise, there isn't an equivalent CSSStyleValue for StyleValueList, so just use the default.
    return css_style_value_reify_impl(base, realm, associated_property)

# https://drafts.css-houdini.org/css-typed-om-1/#subdivide-into-iterations
## Ported from Libraries/LibWeb/CSS/StyleValues/StyleValueList.cpp:124 Web::CSS::StyleValueList::subdivide_into_iterations (override).
pub func css_style_value_list_subdivide_into_iterations_impl(base: CssStyleValue*, property: CssPropertyNameAndId) -> ak.Vector[CssStyleValue*]:
    let this = (CssStyleValueList*)base
    # To subdivide into iterations a CSS value whole value for a property property, execute the following steps:
    # 1. If property is a single-valued property, return a list containing whole value.
    if css_property_name_and_id_is_custom_property(&property) or not css_data.property_is_list_valued(css_property_name_and_id_id(&property)):
        var values = ak.Vector[CssStyleValue*]()
        ak.vector_append_t(&values, base)
        return values

    # 2. Otherwise, divide whole value into individual iterations, as appropriate for property, and return a list
    #    containing the iterations in order.
    return css_style_value_list_values(this)
