func css_matches(base_type: CssNumericTypeBaseType, value_type: CssValueType) -> bool:
    match base_type:
        .length: return value_type == CssValueType.length
        .angle: return value_type == CssValueType.angle
        .time: return value_type == CssValueType.time
        .frequency: return value_type == CssValueType.frequency
        .resolution: return value_type == CssValueType.resolution
        .flex: return value_type == CssValueType.flex
        .percent: return value_type == CssValueType.percentage
        _: return false

