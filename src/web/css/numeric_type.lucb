# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-match
func css_numeric_type_matches_dimension_percentage(this: const CssNumericType*, type_: CssNumericTypeBaseType, percentages_resolve_as: CssValueType?) -> bool:
    # A type matches <length-percentage> if it matches <length> or matches <percentage>.
