# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-match
func css_numeric_type_matches_dimension_css_numeric_type_base_type(this: const CssNumericType*, type_: CssNumericTypeBaseType, percentages_resolve_as: CssValueType?) -> bool:
    # A type matches <length> if its only non-zero entry is «[ "length" → 1 ]».
