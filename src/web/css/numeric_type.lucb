## Ported from Libraries/LibWeb/CSS/NumericType.cpp:487 Web::CSS::NumericType::matches_number.
# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-match
pub func css_numeric_type_matches_number(this: const CssNumericType*, percentages_resolve_as: CssValueType?) -> bool:
    # A type matches <number> if it has no non-zero entries.
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        let type_exponent = css_numeric_type_exponent(this, base_type)
        if type_exponent != none and type_exponent != 0:
            return false

    # If the context in which the value is used allows <percentage> values, and those percentages are resolved
    # against a type other than <number>, then for the type to be considered matching the percent hint must
    # either be null or match the other type.
    if let resolve_as = percentages_resolve_as:
        if resolve_as != CssValueType.number:
            let hint = css_numeric_type_percent_hint(this) else return true
            return css_matches(hint, resolve_as)

    # If the context allows <percentage> values, but either doesn’t resolve them against another type or resolves
    # them against a <number>, then for the type to be considered matching the percent hint must either be null
    # or "percent".
    if percentages_resolve_as == CssValueType.number:
        return css_numeric_type_percent_hint(this) == none or css_numeric_type_percent_hint(this) == CssNumericTypeBaseType.percent

    # If the context does not allow <percentage> values, then for the type to be considered matching the percent
    # hint must be null.
    return css_numeric_type_percent_hint(this) == none

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:514 Web::CSS::NumericType::matches_dimension.
pub func css_numeric_type_matches_dimension(this: const CssNumericType*) -> bool:
    # This isn't a spec algorithm.
    # A type should match `<dimension>` if there are no non-zero entries,
    # or it has a single non-zero entry (other than percent) which is equal to 1.

    var number_of_one_exponents = 0

    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        let type_exponent = css_numeric_type_exponent(this, base_type) else continue

        if type_exponent == 1:
            if base_type == CssNumericTypeBaseType.percent:
                return false
            number_of_one_exponents += 1
        elif type_exponent != 0:
            return false

    return number_of_one_exponents == 0 or number_of_one_exponents == 1
