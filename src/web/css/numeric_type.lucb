# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-match
pub func css_numeric_type_matches_percentage(this: const CssNumericType*) -> bool:
    # A type matches <percentage> if its only non-zero entry is «[ "percent" → 1 ]», and its percent hint is either
    # null or "percent".
    if css_numeric_type_percent_hint(this) != none and css_numeric_type_percent_hint(this) != CssNumericTypeBaseType.percent:
