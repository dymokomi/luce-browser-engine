#==============================================================================================
#
#   numeric_type - NumericType: the type of a calculation (css-typed-om-1)
#
#   DESCRIPTION:
#       Port of LibWeb/CSS/NumericType.cpp (lines 1-557) and the inline members of
#       NumericType.h: unit maps, creating types from units, adding, multiplying and inverting
#       types, percent hints, the "matches <type>" tests and the debug dump.
#       `NumericType { type, power }` is css_numeric_type_new (the constructor as a value), and
#       for_each_type_and_exponent takes its callback as an ak.Function2.
#
#       Copyright (c) 2023-2025, Sam Atkins <sam@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Unit maps ===============================================================================

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:20 Web::CSS::product_of_two_unit_maps.
# https://drafts.css-houdini.org/css-typed-om-1/#product-of-two-unit-maps
pub func css_product_of_two_unit_maps(units1: ak.HashMap[ak.FlyString, i32, ak.FlyStringTraits], units2: ak.HashMap[ak.FlyString, i32, ak.FlyStringTraits]) -> ak.HashMap[ak.FlyString, i32, ak.FlyStringTraits]:
    # 1. Let result be a copy of units1.
    var result = ak.hash_map_clone(&units1) else trap("out of memory")

    # 2. For each unit → power in units2:
    for entry in ak.hash_map_begin_const(&units2):
        # 1. If result[unit] exists, increment result[unit] by power.
        # 2. Otherwise, set result[unit] to power.
        let slot = ak.hash_map_ensure(&result, entry.key)
        *slot += entry.value

    # 3. Return result.
    return result

# mark: Creating types ==========================================================================

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:36 Web::CSS::NumericType::base_type_from_value_type.
pub func css_numeric_type_base_type_from_value_type(value_type: CssValueType) -> CssNumericTypeBaseType?:
    match value_type:
        .angle: return CssNumericTypeBaseType.angle
        .flex: return CssNumericTypeBaseType.flex
        .frequency: return CssNumericTypeBaseType.frequency
        .length: return CssNumericTypeBaseType.length
        .percentage: return CssNumericTypeBaseType.percent
        .resolution: return CssNumericTypeBaseType.resolution
        .time: return CssNumericTypeBaseType.time
        _: return none

## Ported from Libraries/LibWeb/CSS/NumericType.h:34 Web::CSS::NumericType::base_type_name.
pub func css_numeric_type_base_type_name(base_type: CssNumericTypeBaseType) -> ak.StringView:
    match base_type:
        .length: return ak.sv("length")
        .angle: return ak.sv("angle")
        .time: return ak.sv("time")
        .frequency: return ak.sv("frequency")
        .resolution: return ak.sv("resolution")
        .flex: return ak.sv("flex")
        .percent: return ak.sv("percent")
        _: trap("VERIFY_NOT_REACHED")

## `NumericType { type, power }`: the constructor as a value.
pub func css_numeric_type_new(type_: CssNumericTypeBaseType, power: i32) -> CssNumericType:
    var result = CssNumericType()
    css_numeric_type_construct(&result, type_, power)
    return result

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:60 Web::CSS::NumericType::create_from_unit.
# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-create-a-type
pub func css_numeric_type_create_from_unit(unit_: ak.FlyString) -> CssNumericType?:
    # To create a type from a string unit, follow the appropriate branch of the following:

    # unit is "number"
    if ak.fly_string_eq_string_view(&unit_, ak.sv("number")):
        # Return «[ ]» (empty map)
        return CssNumericType()

    # unit is "percent"
    if ak.fly_string_eq_string_view(&unit_, ak.sv("percent")):
        # Return «[ "percent" → 1 ]»
        return css_numeric_type_new(.percent, 1)

    if let dimension = css_data.dimension_for_unit(ak.fly_string_bytes_as_string_view(&unit_)):
        match dimension:
            # unit is a <length> unit
            .length:
                # Return «[ "length" → 1 ]»
                return css_numeric_type_new(.length, 1)

            # unit is an <angle> unit
            .angle:
                # Return «[ "angle" → 1 ]»
                return css_numeric_type_new(.angle, 1)

            # unit is a <time> unit
            .time:
                # Return «[ "time" → 1 ]»
                return css_numeric_type_new(.time, 1)

            # unit is a <frequency> unit
            .frequency:
                # Return «[ "frequency" → 1 ]»
                return css_numeric_type_new(.frequency, 1)

            # unit is a <resolution> unit
            .resolution:
                # Return «[ "resolution" → 1 ]»
                return css_numeric_type_new(.resolution, 1)

            # unit is a <flex> unit
            .flex:
                # Return «[ "flex" → 1 ]»
                return css_numeric_type_new(.flex, 1)
            _: trap("VERIFY_NOT_REACHED")

    # anything else
    #    Return failure.
    return none

    # In all cases, the associated percent hint is null.

## The sole base type of `type_` (create_from_unit_map's `sole_type` lambda).
func css_numeric_type_sole_type(type_: const CssNumericType*) -> CssNumericTypeBaseType:
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        if css_numeric_type_exponent(type_, base_type) != none:
            return base_type
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:118 Web::CSS::NumericType::create_from_unit_map.
# https://drafts.css-houdini.org/css-typed-om-1/#create-a-type-from-a-unit-map
pub func css_numeric_type_create_from_unit_map(unit_map: ak.HashMap[ak.FlyString, i32, ak.FlyStringTraits]) -> CssNumericType?:
    # To create a type from a unit map unit map:

    # 1. Let types be an initially empty list.
    var types = ak.Vector[CssNumericType]()

    # 2. For each unit → power in unit map:
    for entry in ak.hash_map_begin_const(&unit_map):
        # 1. Let type be the result of creating a type from unit.
        var type_ = css_numeric_type_create_from_unit(entry.key) else trap("release_value: not a unit")

        # 2. Set type’s sole value to power.
        let sole_type = css_numeric_type_sole_type(&type_)
        css_numeric_type_set_exponent(&type_, sole_type, entry.value)

        # 3. Append type to types.
        ak.vector_append_t(&types, type_)

    # 3. Return the result of multiplying all the items of types.
    if ak.vector_is_empty(&types):
        return none
    var result = *ak.vector_first(&types)
    var first = true
    for type_ in ak.vector_span_const(&types):
        if first:
            first = false
            continue
        if let multiplied_type = css_numeric_type_multiplied_by(&result, type_):
            result = multiplied_type
        else:
            return none
    return result

## Ported from Libraries/LibWeb/CSS/NumericType.h:60 Web::CSS::NumericType::NumericType.
pub func css_numeric_type_construct(this: CssNumericType*, type_: CssNumericTypeBaseType, power: i32):
    css_numeric_type_set_exponent(this, type_, power)

# mark: Adding, multiplying and inverting types =================================================

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:165 Web::CSS::NumericType::added_to.
# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-add-two-types
pub func css_numeric_type_added_to(this: const CssNumericType*, other: CssNumericType) -> CssNumericType?:
    # To add two types type1 and type2, perform the following steps:

    # 1. Replace type1 with a fresh copy of type1, and type2 with a fresh copy of type2.
    #    Let finalType be a new type with an initially empty ordered map and an initially null percent hint.
    var type1 = *this
    var type2 = other
    var final_type = CssNumericType()

    # 2. If both type1 and type2 have non-null percent hints with different values
    if css_numeric_type_percent_hint(&type1) != none and css_numeric_type_percent_hint(&type2) != none and css_numeric_type_percent_hint(&type1) != css_numeric_type_percent_hint(&type2):
        # The types can’t be added. Return failure.
        return none
    #    If type1 has a non-null percent hint hint and type2 doesn’t
    if let hint = css_numeric_type_percent_hint(&type1):
        if css_numeric_type_percent_hint(&type2) == none:
            # Apply the percent hint hint to type2.
            css_numeric_type_apply_percent_hint(&type2, hint)
    #    Vice versa if type2 has a non-null percent hint and type1 doesn’t.
    elif let hint = css_numeric_type_percent_hint(&type2):
        css_numeric_type_apply_percent_hint(&type1, hint)
    # Otherwise
    #     Continue to the next step.

    # 3. If all the entries of type1 with non-zero values are contained in type2 with the same value, and vice-versa
    if (css_numeric_type_contains_all_the_non_zero_entries_of_other_with_the_same_value(&type2, type1) and css_numeric_type_contains_all_the_non_zero_entries_of_other_with_the_same_value(&type1, type2)):
        # Copy all of type1’s entries to finalType, and then copy all of type2’s entries to finalType that
        # finalType doesn’t already contain. Set finalType’s percent hint to type1’s percent hint. Return finalType.
        css_numeric_type_copy_all_entries_from(&final_type, type1, .no)
        css_numeric_type_copy_all_entries_from(&final_type, type2, .yes)
        css_numeric_type_set_percent_hint(&final_type, css_numeric_type_percent_hint(&type1))
        return final_type
    #    If type1 and/or type2 contain "percent" with a non-zero value,
    #    and type1 and/or type2 contain a key other than "percent" with a non-zero value
    let type1_percent = css_numeric_type_exponent(&type1, .percent)
    let type2_percent = css_numeric_type_exponent(&type2, .percent)
    if (((type1_percent != none and type1_percent != 0) or (type2_percent != none and type2_percent != 0)) and (css_numeric_type_contains_a_key_other_than_percent_with_a_non_zero_value(&type1) or css_numeric_type_contains_a_key_other_than_percent_with_a_non_zero_value(&type2))):
        # For each base type other than "percent" hint:
        for hint_int in 0..<(i32)CssNumericTypeBaseType.count:
            let hint = (CssNumericTypeBaseType)hint_int
            if hint == CssNumericTypeBaseType.percent:
                continue

            # 1. Provisionally apply the percent hint hint to both type1 and type2.
            var provisional_type1 = type1
            css_numeric_type_apply_percent_hint(&provisional_type1, hint)
            var provisional_type2 = type2
            css_numeric_type_apply_percent_hint(&provisional_type2, hint)

            # 2. If, afterwards, all the entries of type1 with non-zero values are contained in type2
            #    with the same value, and vice versa, then copy all of type1’s entries to finalType,
            #    and then copy all of type2’s entries to finalType that finalType doesn’t already contain.
            #    Set finalType’s percent hint to hint. Return finalType.
            if (css_numeric_type_contains_all_the_non_zero_entries_of_other_with_the_same_value(&provisional_type2, provisional_type1) and css_numeric_type_contains_all_the_non_zero_entries_of_other_with_the_same_value(&provisional_type1, provisional_type2)):
                css_numeric_type_copy_all_entries_from(&final_type, provisional_type1, .no)
                css_numeric_type_copy_all_entries_from(&final_type, provisional_type2, .yes)
                css_numeric_type_set_percent_hint(&final_type, hint)
                return final_type

            # 3. Otherwise, revert type1 and type2 to their state at the start of this loop.
            # NOTE: We did the modifications to provisional_type1/2 so this is a no-op.

        # If the loop finishes without returning finalType, then the types can’t be added. Return failure.
        return none
    # Otherwise
    #     The types can’t be added. Return failure.
    return none

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:244 Web::CSS::NumericType::multiplied_by.
# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-multiply-two-types
pub func css_numeric_type_multiplied_by(this: const CssNumericType*, other: CssNumericType) -> CssNumericType?:
    # To multiply two types type1 and type2, perform the following steps:

    # 1. Replace type1 with a fresh copy of type1, and type2 with a fresh copy of type2.
    #    Let finalType be a new type with an initially empty ordered map and an initially null percent hint.
    var type1 = *this
    var type2 = other
    var final_type = CssNumericType()

    # 2. If both type1 and type2 have non-null percent hints with different values,
    #    the types can’t be multiplied. Return failure.
    if css_numeric_type_percent_hint(&type1) != none and css_numeric_type_percent_hint(&type2) != none and css_numeric_type_percent_hint(&type1) != css_numeric_type_percent_hint(&type2):
        return none

    # 3. If type1 has a non-null percent hint hint and type2 doesn’t, apply the percent hint hint to type2.
    if let hint = css_numeric_type_percent_hint(&type1):
        if css_numeric_type_percent_hint(&type2) == none:
            css_numeric_type_apply_percent_hint(&type2, hint)
    #    Vice versa if type2 has a non-null percent hint and type1 doesn’t.
    elif let hint = css_numeric_type_percent_hint(&type2):
        css_numeric_type_apply_percent_hint(&type1, hint)

    # 4. Copy all of type1’s entries to finalType, then for each baseType → power of type2:
    css_numeric_type_copy_all_entries_from(&final_type, type1, .no)
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        let power = css_numeric_type_exponent(&type2, base_type) else continue

        # 1. If finalType[baseType] exists, increment its value by power.
        if let exponent = css_numeric_type_exponent(&final_type, base_type):
            css_numeric_type_set_exponent(&final_type, base_type, exponent + power)
        # 2. Otherwise, set finalType[baseType] to power.
        else:
            css_numeric_type_set_exponent(&final_type, base_type, power)
    #    Set finalType’s percent hint to type1’s percent hint.
    css_numeric_type_set_percent_hint(&final_type, css_numeric_type_percent_hint(&type1))

    # 5. Return finalType.
    return final_type

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:293 Web::CSS::NumericType::inverted.
# https://drafts.css-houdini.org/css-typed-om-1/#cssnumericvalue-invert-a-type
pub func css_numeric_type_inverted(this: const CssNumericType*) -> CssNumericType:
    # To invert a type type, perform the following steps:

    # 1. Let result be a new type with an initially empty ordered map and a percent hint matching that of type.
    var result = CssNumericType()
    css_numeric_type_set_percent_hint(&result, css_numeric_type_percent_hint(this))

    # 2. For each unit → exponent of type, set result[unit] to (-1 * exponent).
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        let power = css_numeric_type_exponent(this, base_type) else continue
        css_numeric_type_set_exponent(&result, base_type, -1 * power)

    # 3. Return result.
    return result

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:315 Web::CSS::NumericType::has_consistent_type_with.
# https://drafts.csswg.org/css-values-4/#css-consistent-typec
pub func css_numeric_type_has_consistent_type_with(this: const CssNumericType*, other: CssNumericType) -> bool:
    # Two or more calculations have a consistent type if adding the types doesn’t result in failure.
    return css_numeric_type_added_to(this, other) != none

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:322 Web::CSS::NumericType::consistent_type.
# https://drafts.csswg.org/css-values-4/#css-consistent-typec
pub func css_numeric_type_consistent_type(this: const CssNumericType*, other: CssNumericType) -> CssNumericType?:
    # The consistent type is the result of the type addition.
    return css_numeric_type_added_to(this, other)

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:329 Web::CSS::NumericType::made_consistent_with.
# https://drafts.csswg.org/css-values-4/#css-make-a-type-consistent
pub func css_numeric_type_made_consistent_with(this: const CssNumericType*, input: CssNumericType) -> CssNumericType?:
    var base = *this

    # 1. If both base and input have different non-null percent hints, they can’t be made consistent. Return failure.
    let base_percent_hint = css_numeric_type_percent_hint(&base)
    let input_percent_hint = css_numeric_type_percent_hint(&input)
    if base_percent_hint != none and input_percent_hint != none and base_percent_hint != input_percent_hint:
        return none

    # 2. If base has a null percent hint set base’s percent hint to input’s percent hint.
    if base_percent_hint == none:
        css_numeric_type_set_percent_hint(&base, input_percent_hint)

    # 3. Return base.
    return base

