## Ported from Libraries/LibWeb/CSS/NumericType.h:88 Web::CSS::NumericType::exponent.
pub func css_numeric_type_exponent(this: const CssNumericType*, type_: CssNumericTypeBaseType) -> i32?:
    return this.m_type_exponents[usize((i32)type_)]

## Ported from Libraries/LibWeb/CSS/NumericType.h:89 Web::CSS::NumericType::set_exponent.
pub func css_numeric_type_set_exponent(this: CssNumericType*, type_: CssNumericTypeBaseType, exponent: i32):
    this.m_type_exponents[usize((i32)type_)] = exponent

## Ported from Libraries/LibWeb/CSS/NumericType.h:92 Web::CSS::NumericType::for_each_type_and_exponent.
pub func css_numeric_type_for_each_type_and_exponent(this: const CssNumericType*, callback: ak.Function2[CssNumericTypeBaseType, i32, unit]):
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let exponent = this.m_type_exponents[usize(i)] else continue
        let base_type = (CssNumericTypeBaseType)i
        ak.function2_call(&callback, base_type, exponent)

## Ported from Libraries/LibWeb/CSS/NumericType.h:102 Web::CSS::NumericType::percent_hint.
pub func css_numeric_type_percent_hint(this: const CssNumericType*) -> CssNumericTypeBaseType?:
