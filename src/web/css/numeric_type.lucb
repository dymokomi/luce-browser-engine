## Ported from Libraries/LibWeb/CSS/NumericType.cpp:348 Web::CSS::NumericType::apply_percent_hint.
# https://drafts.css-houdini.org/css-typed-om-1/#apply-the-percent-hint
pub func css_numeric_type_apply_percent_hint(this: CssNumericType*, hint: CssNumericTypeBaseType):
    # To apply the percent hint hint to a type without a percent hint, perform the following steps:
    assert(css_numeric_type_percent_hint(this) == none)

    # 1. Set type’s percent hint to hint.
    css_numeric_type_set_percent_hint(this, hint)

    # 2. If type doesn’t contain hint, set type[hint] to 0.
    if css_numeric_type_exponent(this, hint) == none:
        css_numeric_type_set_exponent(this, hint, 0)

    # 3. If hint is anything other than "percent", and type contains "percent",
    #    add type["percent"] to type[hint], then set type["percent"] to 0.
    if hint != CssNumericTypeBaseType.percent:
        if let percent = css_numeric_type_exponent(this, .percent):
            css_numeric_type_set_exponent(this, hint, percent + (css_numeric_type_exponent(this, hint) else trap("VERIFY: has_value")))
            css_numeric_type_set_exponent(this, .percent, 0)

    # 4. Return type.
    # FIXME: Is this needed? Nothing uses the value. https://github.com/w3c/css-houdini-drafts/issues/1135

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:540 Web::CSS::NumericType::dump.
pub func css_numeric_type_dump(this: const CssNumericType*) -> ak.String:
    var builder = ak.StringBuilder()
    ak.string_builder_construct(&builder)
    ak.string_builder_append(&builder, "{ hint: ")
    if let hint = this.m_percent_hint:
        ak.string_builder_append_string_view(&builder, css_numeric_type_base_type_name(hint))
    else:
        ak.string_builder_append(&builder, "None")

    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        if let type_exponent = css_numeric_type_exponent(this, base_type):
            css_appendff(&builder, ", \"{}\" → {}", [ak.arg_string_view(css_numeric_type_base_type_name(base_type)), ak.arg_i64((i64)type_exponent)])

    ak.string_builder_append(&builder, " }")
    return ak.string_builder_to_string_without_validation(&builder)

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:407 Web::CSS::NumericType::entry_with_value_1_while_all_others_are_0.
pub func css_numeric_type_entry_with_value_1_while_all_others_are_0(this: const CssNumericType*) -> CssNumericTypeBaseType?:
    var result: CssNumericTypeBaseType? = none
    for i in 0..<(i32)CssNumericTypeBaseType.count:
        let base_type = (CssNumericTypeBaseType)i
        let type_exponent = css_numeric_type_exponent(this, base_type)
        if type_exponent == 1:
            if result != none:
                return none
            result = base_type
        elif type_exponent != none and type_exponent != 0:
            return none
    return result

## Ported from Libraries/LibWeb/CSS/NumericType.cpp:371 Web::CSS::NumericType::contains_all_the_non_zero_entries_of_other_with_the_same_value.
