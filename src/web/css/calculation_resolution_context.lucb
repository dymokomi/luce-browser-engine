## Ported from Libraries/LibWeb/CSS/CalculationResolutionContext.h:24 Web::CSS::CalculationResolutionContext::from_computation_context.
pub func css_calculation_resolution_context_from_computation_context(computation_context: CssComputationContext, percentage_basis: CssCalculationResolutionContextPercentageBasis = CssCalculationResolutionContextPercentageBasis.empty) -> CssCalculationResolutionContext:
    return CssCalculationResolutionContext(
        percentage_basis = percentage_basis,
        length_resolution_context = computation_context.length_resolution_context,
        abstract_element = computation_context.abstract_element,
    )
