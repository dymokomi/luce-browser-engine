## Ported from Libraries/LibWeb/CSS/FontFace.cpp:341 Web::CSS::FontFace::FontFace.
pub func css_font_face_construct(this: CssFontFace*, realm: Realm*, font_status_promise: JsPromiseCapability*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    css_font_face_init_fields(this)
    this.m_font_status_promise = font_status_promise

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:349 Web::CSS::FontFace::initialize (override).
pub func css_font_face_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.font_face)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:355 Web::CSS::FontFace::visit_edges (override).
pub func css_font_face_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (CssFontFace*)base
    bind_platform_object_visit_edges_impl(base, visitor)

    # visitor.visit(m_font_status_promise): WebIDL::Promise is opaque until phase 3 (a cell in the donor).
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_font_status_promise)
    gc.cell_visitor_visit_t(visitor, this.m_css_font_face_rule)
    gc.cell_visitor_visit_t(visitor, this.m_font_loader)
    for entry in ak.hash_table_begin(&this.m_containing_sets):
        gc.cell_visitor_visit_t_2(visitor, *entry)

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:366 Web::CSS::FontFace::loaded.
pub func css_font_face_loaded(this: CssFontFace*) -> JsPromiseCapability*:
    return this.m_font_status_promise

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:371 Web::CSS::FontFace::reject_status_promise.
func css_font_face_reject_status_promise(this: CssFontFace*, reason: JsValue):
    if this.m_status != BindFontFaceLoadStatus.error_:
        idl_reject_promise(bind_platform_object_realm(this.bind_platform_object()), this.m_font_status_promise, reason)
        idl_mark_promise_as_handled(this.m_font_status_promise)
        this.m_status = BindFontFaceLoadStatus.error_

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:380 Web::CSS::FontFace::font_computer.
func css_font_face_font_computer(this: CssFontFace*) -> CssFontComputer*?:
    for entry in ak.hash_table_begin(&this.m_containing_sets):
        let global = html_relevant_global_object((JsObject*)*entry)
        if let window = as_if_html_window((gc.Cell*)global):
            return dom_document_font_computer(html_window_associated_document(window))
    return none

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:390 Web::CSS::FontFace::disconnect_from_css_rule.
pub func css_font_face_disconnect_from_css_rule(this: CssFontFace*):
    this.m_css_font_face_rule = none

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:395 Web::CSS::FontFace::font_with_point_size.
pub func css_font_face_font_with_point_size(this: CssFontFace*, point_size: f32, variations: web_fonts.FontVariationSettings, shape_features: ak.Vector[web_fonts.ShapeFeature]) -> const web_fonts.FontCascadeList*?:
    let font_list = web_fonts.font_cascade_list_create()
    if let font_loader = this.m_font_loader:
        if let font = css_font_loader_font_with_point_size(font_loader, point_size, variations, shape_features):
            web_fonts.font_cascade_list_add_vector(font_list, font, css_font_loader_unicode_ranges(font_loader))
    elif let parsed_font = this.m_parsed_font:
        web_fonts.font_cascade_list_add_vector(font_list, web_fonts.typeface_font(parsed_font, point_size, variations, shape_features), this.m_unicode_ranges)
    if web_fonts.font_cascade_list_is_empty(font_list):
        return none
    return font_list
