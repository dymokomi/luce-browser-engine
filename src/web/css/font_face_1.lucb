## Ported from Libraries/LibWeb/CSS/FontFace.h:104 Web::CSS::FontFace::has_urls.
pub func css_font_face_has_urls(this: CssFontFace*) -> bool:
    return not ak.vector_is_empty(&this.m_urls)

## Ported from Libraries/LibWeb/CSS/FontFace.h:106 Web::CSS::FontFace::has_non_default_unicode_range.
pub func css_font_face_has_non_default_unicode_range(this: CssFontFace*) -> bool:
    if ak.vector_size(&this.m_unicode_ranges) != 1:
        return true
    let range = ak.vector_first_const(&this.m_unicode_ranges)
    return web_fonts.unicode_range_min_code_point(range) != 0 or web_fonts.unicode_range_max_code_point(range) != 0x10FFFF

