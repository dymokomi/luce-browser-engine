## Ported from Libraries/LibWeb/CSS/FontFace.cpp:275 Web::CSS::FontFace::create_css_connected.
# https://drafts.csswg.org/css-font-loading/#font-face-css-connection
pub func css_font_face_create_css_connected(realm: Realm*, rule: CssFontFaceRule*) -> CssFontFace*:
    var execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&execution_context, realm)
    defer html_temporary_execution_context_destruct(&execution_context)

    let font_face = realm_create_css_font_face(realm, realm, idl_create_promise(realm))

    font_face.m_css_font_face_rule = rule
    css_font_face_reparse_connected_css_font_face_rule_descriptors(font_face)

    if let src_value = css_descriptors_descriptor(css_font_face_rule_descriptors(rule).css_descriptors(), css_descriptor_name_and_id_from_id(css_data.DescriptorId.src)):
        font_face.m_urls = css_parsed_font_face_sources_from_style_value(src_value)
        discard(ak.vector_remove_all_matching(&font_face.m_urls, ak.Function1[const CssParsedFontFaceSource*, bool](call = css_is_unsupported_source_predicate, context = none)))

    css_font_face_rule_set_css_connected_font_face(rule, font_face)

    return font_face

## `descriptors->descriptor_or_initial_value(DescriptorNameAndID::from_id(id))`, which the
## connected rule's descriptors always have.
func css_font_face_rule_descriptor_or_initial_value(descriptors: CssCssFontFaceDescriptors*, id: css_data.DescriptorId) -> CssStyleValue*:
    return css_descriptors_descriptor_or_initial_value(descriptors.css_descriptors(), css_descriptor_name_and_id_from_id(id)) else trap("VERIFY: RefPtr::operator*() on a missing descriptor")

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:294 Web::CSS::FontFace::reparse_connected_css_font_face_rule_descriptors.
pub func css_font_face_reparse_connected_css_font_face_rule_descriptors(this: CssFontFace*):
    let descriptors = css_font_face_rule_descriptors(this.m_css_font_face_rule else trap("VERIFY: m_css_font_face_rule"))

    let parent_rule = css_style_declaration_parent_rule(descriptors.css_style_declaration()) else trap("VERIFY: descriptors->parent_rule()")
    let parent_style_sheet = css_rule_parent_style_sheet(parent_rule) else trap("VERIFY: parent_rule()->parent_style_sheet()")
    let owning_document = css_css_style_sheet_owning_document(parent_style_sheet) else trap("VERIFY: parent_style_sheet()->owning_document()")
    let computation_context = CssComputationContext(length_resolution_context = css_length_resolution_context_for_document(owning_document))

    css_font_face_set_family_impl(this, css_descriptors_descriptor(descriptors.css_descriptors(), css_descriptor_name_and_id_from_id(css_data.DescriptorId.font_family)) else trap("VERIFY: RefPtr::operator*() on a missing font-family"))
    css_font_face_set_style_impl(this, css_style_value_absolutized(css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_style), computation_context))
    css_font_face_set_weight_impl(this, css_style_value_absolutized(css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_weight), computation_context))
    css_font_face_set_stretch_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_width))
    css_font_face_set_unicode_range_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.unicode_range))
    css_font_face_set_feature_settings_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_feature_settings))
    css_font_face_set_variation_settings_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_variation_settings))
    css_font_face_set_display_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.font_display))
    css_font_face_set_ascent_override_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.ascent_override))
    css_font_face_set_descent_override_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.descent_override))
    css_font_face_set_line_gap_override_impl(this, css_font_face_rule_descriptor_or_initial_value(descriptors, css_data.DescriptorId.line_gap_override))

## Ported from Libraries/LibWeb/CSS/FontFace.cpp:315 Web::CSS::FontFace::parsed_font_face.
pub func css_font_face_parsed_font_face(this: CssFontFace*) -> CssParsedFontFace:
    if let rule = this.m_css_font_face_rule:
        return css_font_face_rule_font_face(rule)

    # FIXME: The ParsedFontFace is kind of expensive to create. We should be using a shared sub-object for the data
    let realm = bind_platform_object_realm(this.bind_platform_object())
    # Create a dummy CSSFontFaceRule so that we load relative to the document's base URL
    let dummy_rule = css_font_face_rule_create(realm, css_css_font_face_descriptors_create(realm, ak.Vector[CssDescriptor]()))
    let ascent_override: CssPercentage? = none  # FIXME: ascent_override
    let descent_override: CssPercentage? = none  # FIXME: descent_override
    let line_gap_override: CssPercentage? = none  # FIXME: line_gap_override
    let font_display = css_data.FontDisplay.auto  # FIXME: font_display
    let font_named_instance: ak.FlyString? = none  # font-named-instance doesn't exist in FontFace
    let font_language_override: ak.FlyString? = none  # font-language-override doesn't exist in FontFace
    let feature_settings: ak.OrderedHashMap[ak.FlyString, i32, ak.FlyStringTraits]? = none  # FIXME: feature_settings
    let variation_settings: ak.OrderedHashMap[ak.FlyString, f64, ak.FlyStringTraits]? = none  # FIXME: variation_settings
    var parsed_font_face: CssParsedFontFace = ---
    css_parsed_font_face_construct(&parsed_font_face, dummy_rule.css_rule(), ak.fly_string_from_string(this.m_family), this.m_cached_weight_range, this.m_cached_slope, this.m_cached_width, this.m_urls, this.m_unicode_ranges, ascent_override, descent_override, line_gap_override, font_display, font_named_instance, font_language_override, feature_settings, variation_settings)
    return parsed_font_face

