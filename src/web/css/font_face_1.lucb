pub func css_font_face_should_be_registered_with_font_computer(this: CssFontFace*) -> bool:
    return css_font_face_is_css_connected(this) or css_font_face_status(this) == BindFontFaceLoadStatus.loaded

## Ported from Libraries/LibWeb/CSS/FontFace.h:103 Web::CSS::FontFace::unicode_ranges.
