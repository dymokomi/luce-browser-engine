#==============================================================================================
#
#   types_css_transition - declarations of Libraries/LibWeb/CSS/CSSTransition.h
#
#   DESCRIPTION:
#       CSSTransition was opaque in the skeleton's closures (outside phase 1); declared here
#       by hand by region p4a in the generator's shape: Animation's class id (EventTarget's
#       first), recognized by its ClassInfo.
#
#==============================================================================================

## Web::CSS::CSSTransition::Phase (Libraries/LibWeb/CSS/CSSTransition.h:51). This is designed to be created from
## AnimationEffect::Phase.
pub enum CssTransitionPhase as u8:
    before = 0
    active = 1
    after = 2
    idle = 3
    pending = 4

## Web::CSS::CSSTransition (Libraries/LibWeb/CSS/CSSTransition.h:17).
pub struct CssTransition: IsAnimationsAnimation, IsDomEventTarget, IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var animation: AnimationsAnimation  # primary base
    pub var m_transition_property: css_data.PropertyId
    # https://drafts.csswg.org/css-transitions-2/#transition-generation
    pub var m_transition_generation: usize
    # https://drafts.csswg.org/css-transitions/#transition-start-time
    pub var m_start_time: f64
    # https://drafts.csswg.org/css-transitions/#transition-end-time
    pub var m_end_time: f64
    # https://drafts.csswg.org/css-transitions/#transition-start-value
    pub var m_start_value: CssStyleValue*
    # https://drafts.csswg.org/css-transitions/#transition-end-value
    pub var m_end_value: CssStyleValue*
    # https://drafts.csswg.org/css-transitions/#transition-reversing-adjusted-start-value
    pub var m_reversing_adjusted_start_value: CssStyleValue*
    # https://drafts.csswg.org/css-transitions/#transition-reversing-shortening-factor
    pub var m_reversing_shortening_factor: f64
    pub var m_keyframe_effect: AnimationsKeyframeEffect*
    pub var m_cached_declaration: CssStyleDeclaration*?
    pub var m_previous_phase: CssTransitionPhase  # C++ default: { Phase::Idle }

    func animations_animation() -> AnimationsAnimation*: return (AnimationsAnimation*)&self

    func dom_event_target() -> DomEventTarget*: return (DomEventTarget*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of Web::CSS::CSSTransition.
pub let css_transition_vtable: AnimationsAnimationVTable = AnimationsAnimationVTable(event_target_vtable = DomEventTargetVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &css_transition_class, visit_edges = css_transition_visit_edges_impl, finalize = animations_animation_finalize_impl), initialize = css_transition_initialize_impl))), is_css_transition = css_transition_is_css_transition_impl, animation_class = css_transition_animation_class_impl, class_specific_composite_order = css_transition_class_specific_composite_order_impl)

## Class information of Web::CSS::CSSTransition: EventTarget's first class id, recognized by its ClassInfo.
pub let css_transition_class: ak.ClassInfo = ak.ClassInfo(name = "CSSTransition", first_id = 49, last_id = 49, size = memory.size_of(CssTransition), vtable = (const void*)&css_transition_vtable)

## is<Web::CSS::CSSTransition>: the cell's ClassInfo.
pub func is_css_transition[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &css_transition_class

## as_if<Web::CSS::CSSTransition>.
pub func as_if_css_transition[P: gc.IsCell](p: P*) -> CssTransition*?:
    if is_css_transition(p): return (CssTransition*)p
    return none

## as<Web::CSS::CSSTransition> (verify_cast).
pub func as_css_transition[P: gc.IsCell](p: P*) -> CssTransition*:
    return as_if_css_transition(p) else trap("as<Web::CSS::CSSTransition> failed")

## realm.create<Web::CSS::CSSTransition>(realm, ...): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_css_transition(realm: Realm*, realm_: Realm*, abstract_element: DomAbstractElement, property_id: css_data.PropertyId, transition_generation: usize, delay: f64, start_time: f64, end_time: f64, start_value: CssStyleValue*, end_value: CssStyleValue*, reversing_adjusted_start_value: CssStyleValue*, reversing_shortening_factor: f64) -> CssTransition*:
    let this = (CssTransition*)web_allocate_cell(realm, &css_transition_class)
    css_transition_construct(this, realm_, abstract_element, property_id, transition_generation, delay, start_time, end_time, start_value, end_value, reversing_adjusted_start_value, reversing_shortening_factor)
    web_initialize_cell(this.cell(), realm)
    return this
