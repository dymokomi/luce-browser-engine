## Ported from Libraries/LibWeb/ReferrerPolicy/ReferrerPolicy.cpp:11 Web::ReferrerPolicy::to_string.
pub func referrer_policy_to_string(referrer_policy: ReferrerPolicyReferrerPolicy) -> ak.StringView:
    match referrer_policy:
        .empty_string: return ak.sv("")
        .no_referrer: return ak.sv("no-referrer")
        .no_referrer_when_downgrade: return ak.sv("no-referrer-when-downgrade")
        .same_origin: return ak.sv("same-origin")
        .origin: return ak.sv("origin")
        .strict_origin: return ak.sv("strict-origin")
        .origin_when_cross_origin: return ak.sv("origin-when-cross-origin")
        .strict_origin_when_cross_origin: return ak.sv("strict-origin-when-cross-origin")
        .unsafe_url: return ak.sv("unsafe-url")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/ReferrerPolicy/ReferrerPolicy.cpp:36 Web::ReferrerPolicy::from_string.
pub func referrer_policy_from_string(string: ak.StringView) -> ReferrerPolicyReferrerPolicy?:
    if ak.string_view_is_empty(&string):
        return ReferrerPolicyReferrerPolicy.empty_string
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("no-referrer")):
        return ReferrerPolicyReferrerPolicy.no_referrer
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("no-referrer-when-downgrade")):
        return ReferrerPolicyReferrerPolicy.no_referrer_when_downgrade
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("same-origin")):
        return ReferrerPolicyReferrerPolicy.same_origin
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("origin")):
        return ReferrerPolicyReferrerPolicy.origin
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("strict-origin")):
        return ReferrerPolicyReferrerPolicy.strict_origin
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("origin-when-cross-origin")):
        return ReferrerPolicyReferrerPolicy.origin_when_cross_origin
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("strict-origin-when-cross-origin")):
        return ReferrerPolicyReferrerPolicy.strict_origin_when_cross_origin
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("unsafe-url")):
        return ReferrerPolicyReferrerPolicy.unsafe_url
    return none
