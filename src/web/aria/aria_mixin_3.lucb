## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:185 Web::ARIA::ARIAMixin::has_global_aria_attribute.
# https://www.w3.org/TR/wai-aria-1.2/#global_states
pub func aria_mixin_has_global_aria_attribute(this: AriaMixin*) -> bool:
    # aria_atomic().has_value() || aria_braille_label().has_value() || ...: the first present attribute answers.
    if aria_mixin_aria_atomic(this) != none:
        return true
    if aria_mixin_aria_braille_label(this) != none:
        return true
    if aria_mixin_aria_braille_role_description(this) != none:
        return true
    if aria_mixin_aria_busy(this) != none:
        return true
    if aria_mixin_aria_controls(this) != none:
        return true
    if aria_mixin_aria_current(this) != none:
        return true
    if aria_mixin_aria_described_by(this) != none:
        return true
    if aria_mixin_aria_description(this) != none:
        return true
    if aria_mixin_aria_details(this) != none:
        return true
    if aria_mixin_aria_disabled(this) != none:
        return true
    if aria_mixin_aria_drop_effect(this) != none:
        return true
    if aria_mixin_aria_error_message(this) != none:
        return true
    if aria_mixin_aria_flow_to(this) != none:
        return true
    if aria_mixin_aria_grabbed(this) != none:
        return true
    if aria_mixin_aria_has_popup(this) != none:
        return true
    if aria_mixin_aria_hidden(this) != none:
        return true
    if aria_mixin_aria_invalid(this) != none:
        return true
    if aria_mixin_aria_key_shortcuts(this) != none:
        return true
    if aria_mixin_aria_label(this) != none:
        return true
    if aria_mixin_aria_labelled_by(this) != none:
        return true
    if aria_mixin_aria_live(this) != none:
        return true
    if aria_mixin_aria_owns(this) != none:
        return true
    if aria_mixin_aria_relevant(this) != none:
        return true
    return aria_mixin_aria_role_description(this) != none

# mark: ID references ===========================================================================

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:213 Web::ARIA::ARIAMixin::parse_id_reference.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_idref
pub func aria_mixin_parse_id_reference(this: AriaMixin*, id_reference: ak.String?) -> ak.String?:
    let reference = id_reference else return none

    if aria_mixin_id_reference_exists(this, reference):
        return reference

    return none

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:224 Web::ARIA::ARIAMixin::parse_id_reference_list.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_idref_list
pub func aria_mixin_parse_id_reference_list(this: AriaMixin*, id_list: ak.String?) -> ak.Vector[ak.String]:
    var result: ak.Vector[ak.String]
    let list = id_list else return result

    let list_view = ak.string_bytes_as_string_view(&list)
    let is_ascii_whitespace = AriaIsAsciiWhitespace(unused = 0)
    let id_references = ak.string_view_split_view_if(&list_view, &is_ascii_whitespace)
    for id_reference_view in ak.vector_span_const(&id_references):
        let id_reference = ak.string_from_utf8(id_reference_view) else trap("MUST: String::from_utf8")
        if aria_mixin_id_reference_exists(this, id_reference):
            ak.vector_append_t(&result, id_reference)
    return result

