# mark: Roles ===================================================================================

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.h:42 Web::ARIA::ARIAMixin::default_role (virtual).
# https://www.w3.org/TR/html-aria/#docconformance
pub func aria_mixin_default_role_impl(this: AriaMixin*) -> AriaRole?:
    return none

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.h:44 Web::ARIA::ARIAMixin::to_element (virtual).
pub func aria_mixin_to_element_impl(this: AriaMixin*) -> DomElement*:
    trap("pure virtual: Web::ARIA::ARIAMixin::to_element")

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.h:45 Web::ARIA::ARIAMixin::to_element (virtual).
pub func aria_mixin_to_element_const_impl(this: AriaMixin*) -> DomElement*:
    trap("pure virtual: Web::ARIA::ARIAMixin::to_element")

## The ASCII whitespace predicate (Infra::is_ascii_whitespace) the token lists split on.
struct AriaIsAsciiWhitespace: ak.CharPredicate:
    var unused: u8

    func matches(ch: u8) -> bool:
        return web_infra.is_ascii_whitespace((u32)ch)

## The loop role_from_role_attribute_value runs for each role that needs a context:
## `for (auto ancestor = to_element().parent_element(); ancestor; ancestor = ancestor->parent_element())`
## with `first_is_one_of(ancestor->role_or_default(), roles...)` as its test.
func aria_mixin_has_ancestor_with_role(this: AriaMixin*, roles: const AriaRole[]) -> bool:
    var ancestor = dom_node_parent_element(aria_mixin_to_element(this).dom_node())
    while let element = ancestor:
        let ancestor_role = aria_mixin_role_or_default(&element.aria_mixin)
        for role in roles:
            if ancestor_role == role:
                return true
        ancestor = dom_node_parent_element(element.dom_node())
    return false

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:29 Web::ARIA::ARIAMixin::role_from_role_attribute_value.
# https://www.w3.org/TR/wai-aria-1.2/#introroles
pub func aria_mixin_role_from_role_attribute_value(this: AriaMixin*) -> AriaRole?:
    # 1. Use the rules of the host language to detect that an element has a role attribute and to identify the attribute value string for it.
    let maybe_role_string = aria_mixin_role(this)
    let role_string = maybe_role_string else return none

    # 2. Separate the attribute value string for that attribute into a sequence of whitespace-free substrings by separating on whitespace.
    let role_view = ak.string_bytes_as_string_view(&role_string)
    let is_ascii_whitespace = AriaIsAsciiWhitespace(unused = 0)
    let role_list = ak.string_view_split_view_if(&role_view, &is_ascii_whitespace)

    # 3. Compare the substrings to all the names of the non-abstract WAI-ARIA roles. Case-sensitivity of the comparison inherits from the case-sensitivity of the host language.
    for role_name in ak.vector_span_const(&role_list):
        let role = aria_role_from_string(role_name) else continue
        # NOTE: Per https://w3c.github.io/aria/#directory, "Authors are advised to treat directory as deprecated and to
        # use 'list'." Further, the "directory role == computedrole list" and "div w/directory role == computedrole
        # list" tests in https://wpt.fyi/results/wai-aria/role/synonym-roles.html expect "list", not "directory".
        if role == AriaRole.directory:
            return AriaRole.list
        # NOTE: The "image" role value is a synonym for the older "img" role value; however, the "synonym img role ==
        # computedrole image" test in https://wpt.fyi/results/wai-aria/role/synonym-roles.html expects "image", not "img".
        if role == AriaRole.img:
            return AriaRole.image
        # https://w3c.github.io/core-aam/#roleMappingComputedRole
        # When an element has a role but is not contained in the required context (for example, an orphaned listitem
        # without the required accessible parent of role list), User Agents MUST ignore the role token, and return the
        # computedrole as if the ignored role token had not been included.
        if role == AriaRole.columnheader:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.row]):
                return AriaRole.columnheader
            continue
        if role == AriaRole.gridcell:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.row]):
                return AriaRole.gridcell
            continue
        if role == AriaRole.listitem:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.directory, AriaRole.list]):
                return AriaRole.listitem
            continue
        if role == AriaRole.menuitem:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.menu, AriaRole.menubar]):
                return AriaRole.menuitem
            continue
        if role == AriaRole.menuitemcheckbox:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.menu, AriaRole.menubar]):
                return AriaRole.menuitemcheckbox
            continue
        if role == AriaRole.menuitemradio:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.menu, AriaRole.menubar]):
                return AriaRole.menuitemradio
            continue
        if role == AriaRole.option:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.listbox]):
                return AriaRole.option
            continue
        if role == AriaRole.row:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.table, AriaRole.grid, AriaRole.treegrid]):
                return AriaRole.row
            continue
        if role == AriaRole.rowgroup:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.table, AriaRole.grid, AriaRole.treegrid]):
                return AriaRole.rowgroup
            continue
        if role == AriaRole.rowheader:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.row]):
                return AriaRole.rowheader
            continue
        if role == AriaRole.tab:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.tablist]):
                return AriaRole.tab
            continue
        if role == AriaRole.treeitem:
            if aria_mixin_has_ancestor_with_role(this, [AriaRole.tree]):
                return AriaRole.treeitem
            continue
        # https://w3c.github.io/aria/#document-handling_author-errors_roles
        # Certain landmark roles require names from authors. In situations where an author has not specified names for
        # these landmarks, it is considered an authoring error. The user agent MUST treat such elements as if no role
        # had been provided. If a valid fallback role had been specified, or if the element had an implicit ARIA role,
        # then user agents would continue to expose that role, instead.
        if role == AriaRole.form or role == AriaRole.region:
            let element = aria_mixin_to_element(this)
            let name = dom_node_accessible_name(element.dom_node(), dom_node_document(element.dom_node()), DomShouldComputeRole.no) else trap("MUST: accessible_name")
            if ak.string_is_empty(&name):
                continue
        if role == AriaRole.none_ or role == AriaRole.presentation:
            # https://w3c.github.io/aria/#conflict_resolution_presentation_none
            # If an element is focusable, user agents MUST ignore the none/presentation
            # role and expose the element with its implicit role.
            if dom_event_target_is_focusable(aria_mixin_to_element(this).dom_event_target()):
                continue
            # If an element has global WAI-ARIA states or properties, user agents MUST
            # ignore the none/presentation role and instead expose the element's implicit role.
            if aria_mixin_has_global_aria_attribute(this):
                continue
            # NOTE: Per https://w3c.github.io/aria/#presentation, "the working group introduced 'none' as the preferred
            # synonym to the presentation role"; further, https://wpt.fyi/results/wai-aria/role/synonym-roles.html has
            # a "synonym presentation role == computedrole none" test that expects "none", not "presentation".
            if role == AriaRole.presentation:
                return AriaRole.none_
        # 4. Use the first such substring in textual order that matches the name of a non-abstract WAI-ARIA role.
        if not aria_is_abstract_role(role):
            return role

    # https://www.w3.org/TR/wai-aria-1.2/#document-handling_author-errors_roles
    # If the role attribute contains no tokens matching the name of a non-abstract WAI-ARIA role, the user agent MUST treat the element as if no role had been provided.
    # https://www.w3.org/TR/wai-aria-1.2/#implicit_semantics
    return none

## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:177 Web::ARIA::ARIAMixin::role_or_default.
pub func aria_mixin_role_or_default(this: AriaMixin*) -> AriaRole?:
    if let role = aria_mixin_role_from_role_attribute_value(this):
        return role
    return aria_mixin_default_role(this)

