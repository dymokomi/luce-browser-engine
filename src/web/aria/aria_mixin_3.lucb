## Ported from Libraries/LibWeb/ARIA/ARIAMixin.cpp:278 Web::ARIA::ARIAMixin::set_aria_controls_elements
## (ENUMERATE_ARIA_ELEMENT_LIST_REFERENCING_ATTRIBUTES).
pub func aria_mixin_set_aria_controls_elements(this: AriaMixin*, value: ak.Vector[gc.Weak[DomElement]]?):
    if let elements = value:
        let storage = new ak.Vector[gc.Weak[DomElement]]() else trap("out of memory")
        *storage = elements
        this.m_aria_controls_elements = storage
    else:
        this.m_aria_controls_elements = none

