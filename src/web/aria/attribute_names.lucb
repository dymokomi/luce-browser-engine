#==============================================================================================
#
#   attribute_names - ARIA::AttributeNames: the names of the role and aria-* attributes
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ARIA/AttributeNames.cpp (lines 1-16) with AttributeNames.h's
#       ENUMERATE_ARIA_ATTRIBUTES. C++ initializes the FlyStrings statically; here
#       aria_attribute_names_initialize_strings interns them at run time and
#       web_initialize_strings runs it at startup (DESIGN.md §2.6).
#
#       Copyright (c) 2024, Tim Flynn <trflynn89@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Whether aria_attribute_names_initialize_strings has run.
var aria_attribute_names_strings_initialized: bool

## Ported from Libraries/LibWeb/ARIA/AttributeNames.cpp:12 the definitions of Web::ARIA::AttributeNames's FlyStrings
## (`FlyString name = attribute##_fly_string;` for each ENUMERATE_ARIA_ATTRIBUTES entry).
pub func aria_attribute_names_initialize_strings():
    if aria_attribute_names_strings_initialized:
        return
    aria_attribute_names_role = ak.fly_string_from_str("role")
    aria_attribute_names_aria_active_descendant = ak.fly_string_from_str("aria-activedescendant")
    aria_attribute_names_aria_atomic = ak.fly_string_from_str("aria-atomic")
    aria_attribute_names_aria_auto_complete = ak.fly_string_from_str("aria-autocomplete")
    aria_attribute_names_aria_braille_label = ak.fly_string_from_str("aria-braillelabel")
    aria_attribute_names_aria_braille_role_description = ak.fly_string_from_str("aria-brailleroledescription")
    aria_attribute_names_aria_busy = ak.fly_string_from_str("aria-busy")
    aria_attribute_names_aria_checked = ak.fly_string_from_str("aria-checked")
    aria_attribute_names_aria_col_count = ak.fly_string_from_str("aria-colcount")
    aria_attribute_names_aria_col_index = ak.fly_string_from_str("aria-colindex")
    aria_attribute_names_aria_col_index_text = ak.fly_string_from_str("aria-colindextext")
    aria_attribute_names_aria_col_span = ak.fly_string_from_str("aria-colspan")
    aria_attribute_names_aria_controls = ak.fly_string_from_str("aria-controls")
    aria_attribute_names_aria_current = ak.fly_string_from_str("aria-current")
    aria_attribute_names_aria_described_by = ak.fly_string_from_str("aria-describedby")
    aria_attribute_names_aria_description = ak.fly_string_from_str("aria-description")
    aria_attribute_names_aria_details = ak.fly_string_from_str("aria-details")
    aria_attribute_names_aria_drop_effect = ak.fly_string_from_str("aria-dropeffect")
    aria_attribute_names_aria_error_message = ak.fly_string_from_str("aria-errormessage")
    aria_attribute_names_aria_disabled = ak.fly_string_from_str("aria-disabled")
    aria_attribute_names_aria_expanded = ak.fly_string_from_str("aria-expanded")
    aria_attribute_names_aria_flow_to = ak.fly_string_from_str("aria-flowto")
    aria_attribute_names_aria_grabbed = ak.fly_string_from_str("aria-grabbed")
    aria_attribute_names_aria_has_popup = ak.fly_string_from_str("aria-haspopup")
    aria_attribute_names_aria_hidden = ak.fly_string_from_str("aria-hidden")
    aria_attribute_names_aria_invalid = ak.fly_string_from_str("aria-invalid")
    aria_attribute_names_aria_key_shortcuts = ak.fly_string_from_str("aria-keyshortcuts")
    aria_attribute_names_aria_label = ak.fly_string_from_str("aria-label")
    aria_attribute_names_aria_labelled_by = ak.fly_string_from_str("aria-labelledby")
    aria_attribute_names_aria_level = ak.fly_string_from_str("aria-level")
    aria_attribute_names_aria_live = ak.fly_string_from_str("aria-live")
    aria_attribute_names_aria_modal = ak.fly_string_from_str("aria-modal")
    aria_attribute_names_aria_multi_line = ak.fly_string_from_str("aria-multiline")
    aria_attribute_names_aria_multi_selectable = ak.fly_string_from_str("aria-multiselectable")
    aria_attribute_names_aria_orientation = ak.fly_string_from_str("aria-orientation")
    aria_attribute_names_aria_owns = ak.fly_string_from_str("aria-owns")
    aria_attribute_names_aria_placeholder = ak.fly_string_from_str("aria-placeholder")
    aria_attribute_names_aria_pos_in_set = ak.fly_string_from_str("aria-posinset")
