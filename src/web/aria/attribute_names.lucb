    aria_attribute_names_aria_read_only = ak.fly_string_from_str("aria-readonly")
    aria_attribute_names_aria_relevant = ak.fly_string_from_str("aria-relevant")
    aria_attribute_names_aria_required = ak.fly_string_from_str("aria-required")
    aria_attribute_names_aria_role_description = ak.fly_string_from_str("aria-roledescription")
    aria_attribute_names_aria_row_count = ak.fly_string_from_str("aria-rowcount")
    aria_attribute_names_aria_row_index = ak.fly_string_from_str("aria-rowindex")
    aria_attribute_names_aria_row_index_text = ak.fly_string_from_str("aria-rowindextext")
    aria_attribute_names_aria_row_span = ak.fly_string_from_str("aria-rowspan")
    aria_attribute_names_aria_selected = ak.fly_string_from_str("aria-selected")
    aria_attribute_names_aria_set_size = ak.fly_string_from_str("aria-setsize")
