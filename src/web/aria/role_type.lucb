## Ported from Libraries/LibWeb/ARIA/RoleType.h:55 Web::ARIA::RoleType::RoleType.
## `RoleType() { }`: the data is default-constructed.
pub func aria_role_type_construct(this: AriaRoleType*):
    aria_data_construct(&this.m_data)
