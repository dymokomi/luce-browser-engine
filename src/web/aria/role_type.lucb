    return AriaDefaultValueType.empty

## One `"<key>": { "<name>": "<value>", ... }` member of serialize_as_json: each state or
## property of `table` with its string value under the role's implicit value.
func aria_role_type_serialize_table(this: AriaRoleType*, object: ak.JsonObjectSerializer[ak.StringBuilder]*, key: str,
                                    table: ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]) -> !:
    var table_object = try ak.json_object_serializer_add_object(object, ak.sv(key))
    for state in ak.hash_table_begin_const(&table):
        let value = try aria_state_or_property_to_string_value(*state, this.m_data, aria_role_type_default_value_for_property_or_state(this, *state))
        try ak.json_object_serializer_add_string(&table_object, aria_state_or_property_to_string(*state), value)
    try ak.json_object_serializer_finish(&table_object)

## Ported from Libraries/LibWeb/ARIA/RoleType.cpp:100 Web::ARIA::RoleType::serialize_as_json.
pub func aria_role_type_serialize_as_json(this: AriaRoleType*, object: ak.JsonObjectSerializer[ak.StringBuilder]*) -> !:
    try aria_role_type_serialize_table(this, object, "state", aria_role_type_supported_states(this))
    try aria_role_type_serialize_table(this, object, "properties", aria_role_type_supported_properties(this))
    try aria_role_type_serialize_table(this, object, "required_state", aria_role_type_required_states(this))
    try aria_role_type_serialize_table(this, object, "required_properties", aria_role_type_required_properties(this))
    try aria_role_type_serialize_table(this, object, "prohibited_state", aria_role_type_prohibited_states(this))
    # Donor quirk kept: "prohibited_properties" lists required_properties(), as the C++ does.
    try aria_role_type_serialize_table(this, object, "prohibited_properties", aria_role_type_required_properties(this))

# mark: The role object of a role ===============================================================

## `adopt_nonnull_own_or_enomem(new (nothrow) T(data))`: a role object of class T made by its
## constructor `construct`, as the RoleType of its first-base chain (the C++ static_casts pick
## that RoleType too).
func aria_role_type_new[T: IsAriaRoleType](construct: func(T*, AriaData) -> unit, data: AriaData) -> AriaRoleType*:
    let role_object = &(new T[1] --- else trap("out of memory"))[0]
    construct(role_object, data)
    return role_object.aria_role_type()

## Ported from Libraries/LibWeb/ARIA/RoleType.cpp:147 Web::ARIA::RoleType::build_role_object.
pub func aria_role_type_build_role_object(role: AriaRole, focusable: bool, data: AriaData) -> AriaRoleType*!:
    if aria_is_abstract_role(role):
        error(ak.ak_error, "Cannot construct a role object for an abstract role.")

    match role:
        .alert:
            return aria_role_type_new(aria_alert_construct_aria_data, data)
        .alertdialog:
            return aria_role_type_new(aria_alert_dialog_construct_aria_data, data)  # static_cast<Alert*>
        .application:
            return aria_role_type_new(aria_application_construct_aria_data, data)
        .article:
            return aria_role_type_new(aria_article_construct_aria_data, data)
        .banner:
            return aria_role_type_new(aria_banner_construct_aria_data, data)
        .blockquote:
            return aria_role_type_new(aria_block_quote_construct_aria_data, data)
        .button:
            return aria_role_type_new(aria_button_construct_aria_data, data)
        .caption:
            return aria_role_type_new(aria_caption_construct_aria_data, data)
        .cell:
            return aria_role_type_new(aria_cell_construct_aria_data, data)
        .checkbox:
            return aria_role_type_new(aria_check_box_construct_aria_data, data)
        .code:
            return aria_role_type_new(aria_code_construct_aria_data, data)
        .columnheader:
            return aria_role_type_new(aria_column_header_construct_aria_data, data)  # static_cast<Cell*>
        .combobox:
            return aria_role_type_new(aria_combo_box_construct_aria_data, data)
        .complementary:
            return aria_role_type_new(aria_complementary_construct_aria_data, data)
        .composite:
            return aria_role_type_new(aria_composite_construct_aria_data, data)
        .contentinfo:
            return aria_role_type_new(aria_content_info_construct_aria_data, data)
        .definition:
            return aria_role_type_new(aria_definition_construct_aria_data, data)
        .deletion:
            return aria_role_type_new(aria_deletion_construct_aria_data, data)
        .dialog:
            return aria_role_type_new(aria_dialog_construct_aria_data, data)
        .directory:
            return aria_role_type_new(aria_directory_construct_aria_data, data)
        .document:
            return aria_role_type_new(aria_document_construct_aria_data, data)
        .emphasis:
            return aria_role_type_new(aria_emphasis_construct_aria_data, data)
        .feed:
            return aria_role_type_new(aria_feed_construct_aria_data, data)
        .figure:
