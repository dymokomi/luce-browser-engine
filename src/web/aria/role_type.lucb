# mark: Helpers of the role classes =============================================================

## Installs the vtable and class id of the most-derived role class in one of its RoleType
## subobjects (the C++ vptr, set by each constructor after its bases').
pub func aria_role_type_set_class(this: AriaRoleType*, vtable: const AriaRoleTypeVTable*, info: const ak.ClassInfo*):
    this.vtable = vtable
    this.class_id = info.first_id

## Fills a role's function-local `static HashTable<T>` on its first use: `set_from(array)`, or
## the generated `ensure_capacity(n)` followed by `set` of each value. The table outlives every
## VM, so it is made in the C heap with the atomic allocator unset (DESIGN.md §3.3 rule 7).
func aria_role_type_fill_static_table[T, TT: ak.Traits[T]](table: ak.HashTable[T, TT]*, values: const T[], ensure_capacity: bool):
    let saved_atomic_allocator = ak.atomic_allocator
    ak.atomic_allocator = none
    defer ak.atomic_allocator = saved_atomic_allocator
    with memory.heap:
        if ensure_capacity:
            ak.hash_table_ensure_capacity(table, values.length)
        for value in values:
            _ = ak.hash_table_set(table, value)

# mark: RoleType ================================================================================

## Ported from Libraries/LibWeb/ARIA/RoleType.cpp:13 Web::ARIA::RoleType::RoleType.
pub func aria_role_type_construct_aria_data(this: AriaRoleType*, data: AriaData):
    this.m_data = data

# static HashTable<StateAndProperties> states; of RoleType::supported_states.
var aria_role_type_supported_states_table: ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]

## Ported from Libraries/LibWeb/ARIA/RoleType.cpp:48 Web::ARIA::RoleType::supported_states (virtual).
# https://www.w3.org/TR/wai-aria-1.2/#supportedState
pub func aria_role_type_supported_states_impl(this: AriaRoleType*) -> ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]:
    let states = &aria_role_type_supported_states_table
    if ak.hash_table_is_empty(states):
        aria_role_type_fill_static_table(states, aria_supported_state_array, ensure_capacity = false)
    return *states

# static HashTable<StateAndProperties> properties; of RoleType::supported_properties.
var aria_role_type_supported_properties_table: ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]

## Ported from Libraries/LibWeb/ARIA/RoleType.cpp:56 Web::ARIA::RoleType::supported_properties (virtual).
pub func aria_role_type_supported_properties_impl(this: AriaRoleType*) -> ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]:
    let properties = &aria_role_type_supported_properties_table
    if ak.hash_table_is_empty(properties):
        aria_role_type_fill_static_table(properties, aria_supported_properties_array, ensure_capacity = false)
    return *properties

