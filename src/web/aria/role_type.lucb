        .gridcell:
            return aria_role_type_new(aria_grid_cell_construct_aria_data, data)  # static_cast<Cell*>
        .group:
            return aria_role_type_new(aria_group_construct_aria_data, data)
        .heading:
            return aria_role_type_new(aria_heading_construct_aria_data, data)
        .image:
