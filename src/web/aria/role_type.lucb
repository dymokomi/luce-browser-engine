var aria_role_type_required_properties_table: ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]
var aria_role_type_prohibited_properties_table: ak.HashTable[AriaStateAndProperties, AriaStateAndPropertiesTraits]
