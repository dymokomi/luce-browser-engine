# mark: Categories ==============================================================================

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:36 Web::ARIA::is_abstract_role.
# https://www.w3.org/TR/wai-aria-1.2/#abstract_roles
pub func aria_is_abstract_role(role: AriaRole) -> bool:
    match role:
        .command, .composite, .input, .landmark, .range, .roletype, .section, .sectionhead, .select, .structure, .widget, .window: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:54 Web::ARIA::is_widget_role.
# https://www.w3.org/TR/wai-aria-1.2/#widget_roles
pub func aria_is_widget_role(role: AriaRole) -> bool:
    match role:
        # separator: TODO: Only when focusable
        .button, .checkbox, .gridcell, .link, .menuitem, .menuitemcheckbox, .menuitemradio, .option, .progressbar, .radio, .scrollbar, .searchbox, .separator, .slider, .spinbutton, .switch, .tab, .tabpanel, .textbox, .treeitem, .combobox, .grid, .listbox, .menu, .menubar, .radiogroup, .tablist, .tree, .treegrid: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:89 Web::ARIA::is_document_structure_role.
# https://www.w3.org/TR/wai-aria-1.2/#document_structure_roles
pub func aria_is_document_structure_role(role: AriaRole) -> bool:
    match role:
        # separator: TODO: Only when not focusable
        .application, .article, .blockquote, .caption, .cell, .code, .columnheader, .definition, .deletion, .directory, .document, .emphasis, .feed, .figure, .generic, .group, .heading, .img, .insertion, .list, .listitem, .math, .meter, .none_, .note, .paragraph, .presentation, .row, .rowgroup, .rowheader, .separator, .strong, .subscript, .suggestion, .superscript, .table, .term, .time, .toolbar, .tooltip: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:135 Web::ARIA::is_landmark_role.
# https://www.w3.org/TR/wai-aria-1.2/#landmark_roles
pub func aria_is_landmark_role(role: AriaRole) -> bool:
    match role:
        .banner, .complementary, .contentinfo, .form, .main, .navigation, .region, .search: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:149 Web::ARIA::is_live_region_role.
# https://www.w3.org/TR/wai-aria-1.2/#live_region_roles
pub func aria_is_live_region_role(role: AriaRole) -> bool:
    match role:
        .alert, .log, .marquee, .status, .timer: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:160 Web::ARIA::is_windows_role.
# https://www.w3.org/TR/wai-aria-1.2/#window_roles
pub func aria_is_windows_role(role: AriaRole) -> bool:
    match role:
        .alertdialog, .dialog: return true
        _: return false

## Ported from Libraries/LibWeb/ARIA/Roles.cpp:168 Web::ARIA::allows_name_from_content.
# https://www.w3.org/TR/wai-aria-1.2/#namefromcontent
pub func aria_allows_name_from_content(role: AriaRole) -> bool:
    match role:
        .button, .cell, .checkbox, .columnheader, .gridcell, .heading, .link, .menuitem, .menuitemcheckbox, .menuitemradio, .option, .radio, .row, .rowheader, .sectionhead, .switch, .tab, .tooltip, .treeitem: return true
        _: return false
