## Ported from Libraries/LibWeb/ARIA/Roles.cpp:25 Web::ARIA::role_from_string.
pub func aria_role_from_string(role_name: ak.StringView) -> AriaRole?:
    if ak.string_view_equals_ignoring_ascii_case(&role_name, ak.sv("alert")):
        return AriaRole.alert
    if ak.string_view_equals_ignoring_ascii_case(&role_name, ak.sv("alertdialog")):
        return AriaRole.alertdialog
    if ak.string_view_equals_ignoring_ascii_case(&role_name, ak.sv("application")):
