#==============================================================================================
#
#   aria_data - ARIA::AriaData: an element's ARIA states and properties, parsed
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ARIA/AriaData.cpp (lines 1-570) with AriaData.h's inline
#       constructor and build_data. AriaData reads each attribute through the ARIAMixin
#       getters once and keeps the parsed value; the `_or_default` accessors answer it (with the
#       role's implicit value where the caller gives one).
#
#       Copyright (c) 2023, Jonah Shafran <jonahshafran@gmail.com>
#       Copyright (c) 2023, Shannon Booth <shannon@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/ARIA/AriaData.h:150 Web::ARIA::AriaData::AriaData.
## `AriaData() { }`: the String members are default-constructed (empty); the Optionals and
## Vectors start empty as the zeroed memory is, and C++ leaves the enum and bool members
## uninitialized (they stay zero).
pub func aria_data_construct(this: AriaData*):
    this.m_aria_braille_label = ak.string_new()
    this.m_aria_braille_role_description = ak.string_new()
    this.m_aria_col_index_text = ak.string_new()
    this.m_aria_description = ak.string_new()
    this.m_aria_key_shortcuts = ak.string_new()
    this.m_aria_label = ak.string_new()
    this.m_aria_placeholder = ak.string_new()
    this.m_aria_role_description = ak.string_new()
    this.m_aria_row_index_text = ak.string_new()
    this.m_aria_value_text = ak.string_new()

## Ported from Libraries/LibWeb/ARIA/AriaData.h:152 Web::ARIA::AriaData::build_data.
pub func aria_data_build_data(mixin: AriaMixin*) -> AriaData*!:
    let data = &(alloc AriaData[1] else trap("out of memory"))[0]
    aria_data_construct_aria_mixin(data, mixin)
    return data

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:13 Web::ARIA::AriaData::AriaData.
pub func aria_data_construct_aria_mixin(this: AriaData*, source: AriaMixin*):
    this.m_aria_active_descendant = aria_mixin_aria_active_descendant(source)
    this.m_aria_atomic = aria_data_parse_optional_true_false(aria_mixin_aria_atomic(source))
    this.m_aria_auto_complete = aria_data_parse_aria_autocomplete(aria_mixin_aria_auto_complete(source))
    this.m_aria_braille_label = aria_mixin_aria_braille_label(source) else ak.string_new()
    this.m_aria_braille_role_description = aria_mixin_aria_braille_role_description(source) else ak.string_new()
    this.m_aria_busy = aria_data_parse_true_false(aria_mixin_aria_busy(source))
    this.m_aria_checked = aria_data_parse_tristate(aria_mixin_aria_checked(source))
    this.m_aria_col_count = aria_data_parse_integer(aria_mixin_aria_col_count(source))
    this.m_aria_col_index = aria_data_parse_integer(aria_mixin_aria_col_index(source))
    this.m_aria_col_index_text = aria_mixin_aria_col_index_text(source) else ak.string_new()
    this.m_aria_col_span = aria_data_parse_integer(aria_mixin_aria_col_span(source))
    this.m_aria_controls = aria_mixin_parse_id_reference_list(source, aria_mixin_aria_controls(source))
    this.m_aria_current = aria_data_parse_aria_current(aria_mixin_aria_current(source))
    this.m_aria_described_by = aria_mixin_parse_id_reference_list(source, aria_mixin_aria_described_by(source))
    this.m_aria_description = aria_mixin_aria_description(source) else ak.string_new()
    this.m_aria_details = aria_mixin_parse_id_reference(source, aria_mixin_aria_details(source))
    this.m_aria_disabled = aria_data_parse_true_false(aria_mixin_aria_disabled(source))
    this.m_aria_drop_effect = aria_data_parse_aria_drop_effect(aria_mixin_aria_drop_effect(source))
    this.m_aria_error_message = aria_mixin_parse_id_reference(source, aria_mixin_aria_error_message(source))
    this.m_aria_expanded = aria_data_parse_true_false_undefined(aria_mixin_aria_expanded(source))
    this.m_aria_flow_to = aria_mixin_parse_id_reference_list(source, aria_mixin_aria_flow_to(source))
    this.m_aria_grabbed = aria_data_parse_true_false_undefined(aria_mixin_aria_grabbed(source))
    this.m_aria_has_popup = aria_data_parse_aria_has_popup(aria_mixin_aria_has_popup(source))
    this.m_aria_hidden = aria_data_parse_true_false_undefined(aria_mixin_aria_hidden(source))
    this.m_aria_invalid = aria_data_parse_aria_invalid(aria_mixin_aria_invalid(source))
    this.m_aria_key_shortcuts = aria_mixin_aria_key_shortcuts(source) else ak.string_new()
    this.m_aria_label = aria_mixin_aria_label(source) else ak.string_new()
    this.m_aria_labelled_by = aria_mixin_parse_id_reference_list(source, aria_mixin_aria_labelled_by(source))
    this.m_aria_level = aria_data_parse_integer(aria_mixin_aria_level(source))
    this.m_aria_live = aria_data_parse_aria_live(aria_mixin_aria_live(source))
    this.m_aria_modal = aria_data_parse_true_false(aria_mixin_aria_modal(source))
    this.m_aria_multi_line = aria_data_parse_true_false(aria_mixin_aria_multi_line(source))
    this.m_aria_multi_selectable = aria_data_parse_true_false(aria_mixin_aria_multi_selectable(source))
    this.m_aria_orientation = aria_data_parse_aria_orientation(aria_mixin_aria_orientation(source))
    this.m_aria_owns = aria_mixin_parse_id_reference_list(source, aria_mixin_aria_owns(source))
    this.m_aria_placeholder = aria_mixin_aria_placeholder(source) else ak.string_new()
    this.m_aria_pos_in_set = aria_data_parse_integer(aria_mixin_aria_pos_in_set(source))
    this.m_aria_pressed = aria_data_parse_tristate(aria_mixin_aria_pressed(source))
    this.m_aria_read_only = aria_data_parse_true_false(aria_mixin_aria_read_only(source))
    this.m_aria_relevant = aria_data_parse_aria_relevant(aria_mixin_aria_relevant(source))
    this.m_aria_required = aria_data_parse_true_false(aria_mixin_aria_required(source))
    this.m_aria_role_description = aria_mixin_aria_role_description(source) else ak.string_new()
    this.m_aria_row_count = aria_data_parse_integer(aria_mixin_aria_row_count(source))
    this.m_aria_row_index = aria_data_parse_integer(aria_mixin_aria_row_index(source))
    this.m_aria_row_index_text = aria_mixin_aria_row_index_text(source) else ak.string_new()
    this.m_aria_row_span = aria_data_parse_integer(aria_mixin_aria_row_span(source))
    this.m_aria_selected = aria_data_parse_true_false_undefined(aria_mixin_aria_selected(source))
    this.m_aria_set_size = aria_data_parse_integer(aria_mixin_aria_set_size(source))
    this.m_aria_sort = aria_data_parse_aria_sort(aria_mixin_aria_sort(source))
    this.m_aria_value_max = aria_data_parse_number(aria_mixin_aria_value_max(source))
    this.m_aria_value_min = aria_data_parse_number(aria_mixin_aria_value_min(source))
    this.m_aria_value_now = aria_data_parse_number(aria_mixin_aria_value_now(source))
    this.m_aria_value_text = aria_mixin_aria_value_text(source) else ak.string_new()

# mark: Value types =============================================================================

## `value == "<text>"sv` on an Optional<String>: present and equal.
func aria_data_value_is(value: ak.String?, text: str) -> bool:
    let present = value else return false
    return ak.string_eq_string_view(&present, ak.sv(text))

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:70 Web::ARIA::AriaData::parse_true_false.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_true-false
# The default value for this value type is false unless otherwise specified.
pub func aria_data_parse_true_false(value: ak.String?) -> bool:
    if aria_data_value_is(value, "true"):
        return true
    if aria_data_value_is(value, "false"):
        return false
    return false

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:79 Web::ARIA::AriaData::parse_tristate.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_tristate
# The default value for this value type is undefined unless otherwise specified.
pub func aria_data_parse_tristate(value: ak.String?) -> AriaTristate:
    if aria_data_value_is(value, "true"):
        return AriaTristate.true_
    if aria_data_value_is(value, "false"):
        return AriaTristate.false_
    if aria_data_value_is(value, "mixed"):
        return AriaTristate.mixed
    if aria_data_value_is(value, "undefined"):
        return AriaTristate.undefined
    return AriaTristate.undefined

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:92 Web::ARIA::AriaData::parse_true_false_undefined.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_true-false-undefined
# The default value for this value type is undefined unless otherwise specified.
pub func aria_data_parse_true_false_undefined(value: ak.String?) -> bool?:
    if aria_data_value_is(value, "true"):
        return true
    if aria_data_value_is(value, "false"):
        return false
    if aria_data_value_is(value, "undefined"):
        return none
    return none

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:103 Web::ARIA::AriaData::parse_integer.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_integer
pub func aria_data_parse_integer(value: ak.String?) -> i32?:
    let present = value else return none
    let view = ak.string_bytes_as_string_view(&present)
    return ak.string_view_to_number_i32(&view)

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:110 Web::ARIA::AriaData::parse_number.
# https://www.w3.org/TR/wai-aria-1.2/#valuetype_number
pub func aria_data_parse_number(value: ak.String?) -> f64?:
    let present = value else return none
    return ak.string_to_number_f64(&present, ak.TrimWhitespace.yes)

