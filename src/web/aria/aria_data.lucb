## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:512 Web::ARIA::AriaData::parse_aria_relevant.
pub func aria_data_parse_aria_relevant(value: ak.String?) -> ak.Vector[AriaRelevant]:
    let present = value else return ak.Vector[AriaRelevant]()

    var result: ak.Vector[AriaRelevant]
    let view = ak.string_bytes_as_string_view(&present)
    let is_ascii_whitespace = AriaIsAsciiWhitespace(unused = 0)
    var tokens = ak.string_view_split_view_if(&view, &is_ascii_whitespace)
    let size = ak.vector_size(&tokens)
    # for (size_t i = 0; i < tokens.size(); i++)
    var i: usize = 0
    while i < size:
        if ak.string_view_eq_string_view(ak.vector_at(&tokens, i), ak.sv("additions")):
            if i + 1 < size:
                if ak.string_view_eq_string_view(ak.vector_at(&tokens, i + 1), ak.sv("text")):
                    ak.vector_append_t(&result, AriaRelevant.additions_text)
                    i += 1
                    # `continue` runs the for loop's `i++`.
                    i += 1
                    continue
                if ak.string_view_eq_string_view(ak.vector_at(&tokens, i + 1), ak.sv("removals")) and i + 2 < size and ak.string_view_eq_string_view(ak.vector_at(&tokens, i + 2), ak.sv("text")):
                    ak.vector_append_t(&result, AriaRelevant.all)
                    i += 2
                    # `continue` runs the for loop's `i++`.
                    i += 1
                    continue
            ak.vector_append_t(&result, AriaRelevant.additions)
        elif ak.string_view_eq_string_view(ak.vector_at(&tokens, i), ak.sv("all")):
            ak.vector_append_t(&result, AriaRelevant.all)
        elif ak.string_view_eq_string_view(ak.vector_at(&tokens, i), ak.sv("removals")):
            ak.vector_append_t(&result, AriaRelevant.removals)
        elif ak.string_view_eq_string_view(ak.vector_at(&tokens, i), ak.sv("text")):
            ak.vector_append_t(&result, AriaRelevant.text)
        i += 1

    if ak.vector_is_empty(&result):
        ak.vector_append_t(&result, AriaRelevant.additions_text)

    return result

