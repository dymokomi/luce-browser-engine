# mark: Token values ============================================================================

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:399 Web::ARIA::AriaData::parse_aria_autocomplete.
pub func aria_data_parse_aria_autocomplete(value: ak.String?) -> AriaAutocomplete:
    if aria_data_value_is(value, "inline"):
        return AriaAutocomplete.inline
    if aria_data_value_is(value, "list"):
        return AriaAutocomplete.list
    if aria_data_value_is(value, "both"):
        return AriaAutocomplete.both
    if aria_data_value_is(value, "none"):
        return AriaAutocomplete.none_
    return AriaAutocomplete.none_

## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:412 Web::ARIA::AriaData::parse_aria_current.
pub func aria_data_parse_aria_current(value: ak.String?) -> AriaCurrent:
    if aria_data_value_is(value, "page"):
        return AriaCurrent.page
    if aria_data_value_is(value, "step"):
