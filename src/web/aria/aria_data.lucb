## Ported from Libraries/LibWeb/ARIA/AriaData.cpp:431 Web::ARIA::AriaData::parse_aria_drop_effect.
pub func aria_data_parse_aria_drop_effect(value: ak.String?) -> ak.Vector[AriaDropEffect]:
    let present = value else return ak.Vector[AriaDropEffect]()

    var result: ak.Vector[AriaDropEffect]

    let view = ak.string_bytes_as_string_view(&present)
    let is_ascii_whitespace = AriaIsAsciiWhitespace(unused = 0)
    let tokens = ak.string_view_split_view_if(&view, &is_ascii_whitespace)
    for token in ak.vector_span_const(&tokens):
        if ak.string_view_eq_string_view(&token, ak.sv("copy")):
            ak.vector_append_t(&result, AriaDropEffect.copy)
        elif ak.string_view_eq_string_view(&token, ak.sv("execute")):
            ak.vector_append_t(&result, AriaDropEffect.execute)
        elif ak.string_view_eq_string_view(&token, ak.sv("link")):
            ak.vector_append_t(&result, AriaDropEffect.link)
        elif ak.string_view_eq_string_view(&token, ak.sv("move")):
            ak.vector_append_t(&result, AriaDropEffect.move)
        elif ak.string_view_eq_string_view(&token, ak.sv("popup")):
            ak.vector_append_t(&result, AriaDropEffect.popup)

    # None combined with any other token value is ignored
    if ak.vector_is_empty(&result):
        ak.vector_append_t(&result, AriaDropEffect.none_)

    return result

