# mark: The client and the focused navigable ====================================================

## Ported from Page.h:70 Web::Page::client.
pub func page_client(this: Page*) -> PageClient*:
    return this.m_client

## Ported from Page.h:71 Web::Page::client.
pub func page_client_const(this: Page*) -> PageClient*:
    return this.m_client

## Ported from Page.cpp:69 Web::Page::focused_navigable.
pub func page_focused_navigable(this: Page*) -> HtmlNavigable*:
    if let navigable = gc.weak_ptr(&this.m_focused_navigable):
        return navigable
    return page_top_level_traversable(this).html_navigable()

## Ported from Page.h:84 Web::Page::focused_navigable.
pub func page_focused_navigable_const(this: Page*) -> HtmlNavigable*:
    return page_focused_navigable(this)

## Ported from Page.cpp:76 Web::Page::set_focused_navigable.
pub func page_set_focused_navigable(this: Page*, navigable: HtmlNavigable*):
    this.m_focused_navigable = gc.make_weak(navigable)

## Ported from Page.cpp:81 Web::Page::navigable_document_destroyed.
pub func page_navigable_document_destroyed(this: Page*, navigable: HtmlNavigable*):
    if (HtmlNavigable*?)navigable == gc.weak_ptr(&this.m_focused_navigable):
        this.m_focused_navigable = gc.make_weak[HtmlNavigable](none)

# mark: Loading =================================================================================

## Ported from Page.cpp:87 Web::Page::load.
pub func page_load(this: Page*, url: web_url.Url):
    let traversable = page_top_level_traversable(this).html_navigable()
    html_navigable_navigate(traversable, HtmlNavigableNavigateParams(url = url, source_document = html_navigable_active_document(traversable) else trap("no active document"), user_involvement = HtmlUserNavigationInvolvement.browser_ui)) catch:
        # (void): the C++ drops the result.
        discard(idl_take_pending_exception())
        recover ()

## Ported from Page.cpp:92 Web::Page::load_html.
pub func page_load_html(this: Page*, html: ak.StringView):
    # FIXME: #23909 Figure out why GC threshold does not stay low when repeatedly loading html from the WebView
    gc.heap_collect_garbage(gc.cell_heap(this.cell()))

    let traversable = page_top_level_traversable(this).html_navigable()
    let document_resource = ak.string_from_utf8(html) else trap("String::from_utf8: release_value_but_fixme_should_propagate_errors")
    html_navigable_navigate(traversable, HtmlNavigableNavigateParams(url = web_url.about_srcdoc(), source_document = html_navigable_active_document(traversable) else trap("no active document"), document_resource = EmptyOrStringOrHtmlPostResource.string(document_resource), user_involvement = HtmlUserNavigationInvolvement.browser_ui)) catch:
        # (void): the C++ drops the result.
        discard(idl_take_pending_exception())
        recover ()

## Ported from Page.cpp:103 Web::Page::reload.
pub func page_reload(this: Page*):
    html_navigable_reload(page_top_level_traversable(this).html_navigable())

## Ported from Page.cpp:108 Web::Page::traverse_the_history_by_delta.
pub func page_traverse_the_history_by_delta(this: Page*, delta: i32):
    html_traversable_navigable_traverse_the_history_by_delta(page_top_level_traversable(this), delta)

# mark: The client's palette and screen =========================================================

## Ported from Page.cpp:113 Web::Page::palette.
pub func page_palette(this: Page*) -> gfx.Palette:
    return page_client_palette(this.m_client)

## `{ x, y, width, height }` of a device pixel rect as a CSS pixel rect (each an int).
func page_device_rect_as_css_rect(device_pixel_rect: gfx.DevicePixelRect) -> gfx.CssPixelRect:
    var rect: gfx.CssPixelRect = ---
    gfx.css_pixel_rect_construct_int(&rect, (i64)gfx.device_pixel_rect_x(&device_pixel_rect), (i64)gfx.device_pixel_rect_y(&device_pixel_rect), (i64)gfx.device_pixel_rect_width(&device_pixel_rect), (i64)gfx.device_pixel_rect_height(&device_pixel_rect))
    return rect

## Ported from Page.cpp:119 Web::Page::web_exposed_screen_area.
# https://drafts.csswg.org/cssom-view-1/#web-exposed-screen-area
pub func page_web_exposed_screen_area(this: Page*) -> gfx.CssPixelRect:
    # FIXME: 1. Let target be this’s relevant global object’s browsing context.
    # FIXME: 2. Let emulated screen area be the WebDriver BiDi emulated total screen area of target.
    # FIXME: 3. If emulated screen area is not null, return emulated screen area.

    # 4. Otherwise, return one of the following:
    #    - The area of the output device, in CSS pixels.
    #    - The area of the viewport, in CSS pixels.
    # NB: This is the area of the output device, but in device pixels.
    # See: https://github.com/LadybirdBrowser/ladybird/pull/4084
    return page_device_rect_as_css_rect(page_client_screen_rect(this.m_client))

## Ported from Page.cpp:140 Web::Page::web_exposed_available_screen_area.
# https://drafts.csswg.org/cssom-view-1/#web-exposed-available-screen-area
pub func page_web_exposed_available_screen_area(this: Page*) -> gfx.CssPixelRect:
    # FIXME: 1. Let target be this’s relevant global object’s browsing context.
    # FIXME: 2. Let emulated screen area be the WebDriver BiDi emulated total screen area of target.
    # FIXME: 3. If emulated screen area is not null, return emulated screen area.

    # 4. Otherwise, return one of the following:
    #    - The available area of the rendering surface of the output device, in CSS pixels.
    #    - The area of the output device, in CSS pixels.
    #    - The area of the viewport, in CSS pixels.
    # NB: This is the area of the output device, but in device pixels. See note in web_exposed_screen_area()
    return page_device_rect_as_css_rect(page_client_screen_rect(this.m_client))

