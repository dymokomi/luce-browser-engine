# mark: The top-level traversable ===============================================================

## Ported from Page.cpp:300 Web::Page::set_top_level_traversable.
pub func page_set_top_level_traversable(this: Page*, navigable: HtmlTraversableNavigable*):
    assert(this.m_top_level_traversable == none)  # Replacement is not allowed!
    assert(html_navigable_page(navigable.html_navigable()) == this)
    this.m_top_level_traversable = navigable

## Ported from Page.cpp:307 Web::Page::top_level_traversable_is_initialized.
pub func page_top_level_traversable_is_initialized(this: Page*) -> bool:
    return this.m_top_level_traversable != none

## Ported from Page.cpp:312 Web::Page::top_level_browsing_context.
pub func page_top_level_browsing_context(this: Page*) -> HtmlBrowsingContext*:
    let traversable = this.m_top_level_traversable else trap("no top-level traversable")
    return html_navigable_active_browsing_context(traversable.html_navigable()) else trap("no active browsing context")

## Ported from Page.cpp:317 Web::Page::top_level_browsing_context.
pub func page_top_level_browsing_context_const(this: Page*) -> HtmlBrowsingContext*:
    return page_top_level_browsing_context(this)

## Ported from Page.cpp:322 Web::Page::top_level_traversable.
pub func page_top_level_traversable(this: Page*) -> HtmlTraversableNavigable*:
    return this.m_top_level_traversable else trap("no top-level traversable")

## Ported from Page.cpp:327 Web::Page::did_update_window_rect.
pub func page_did_update_window_rect(this: Page*):
    if let observer = this.m_window_rect_observer:
        var rect: gfx.DevicePixelRect = ---
        gfx.device_pixel_rect_construct_int_point(&rect, page_window_position(this), page_window_size(this))
        ak.function1_call(&observer.function, rect)

# mark: Blocking dialogs ========================================================================

## The goal of spin_event_loop_until_dialog_closed's spin_until (`[&]() { return
## response.has_value() || !client.is_connection_open(); }`).
struct PageDialogClosedGoal:
    var client: PageClient*
    var has_response: func(void*?) -> bool
    var response: void*?

## The spin_until goal.
func page_dialog_closed_goal(context: void*?) -> bool:
    let goal = (PageDialogClosedGoal*)(context else trap("no goal"))
    return goal.has_response(goal.response) or not page_client_is_connection_open(goal.client)

## Ported from Page.cpp:334 Web::spin_event_loop_until_dialog_closed, without the response:
## the event loop spins until `has_response(response)` (C++'s `response.has_value()`) or the
## client disconnects; each caller then takes its response.
func page_spin_event_loop_until_dialog_closed(client: PageClient*, has_response: func(void*?) -> bool, response: void*?):
    let event_loop = html_environment_settings_object_responsible_event_loop(html_current_settings_object())
    let this_heap_cell = event_loop.cell()
    var pause_handle = html_event_loop_pause(event_loop)
    defer html_event_loop_pause_handle_destruct(&pause_handle)

    let goal = new PageDialogClosedGoal(client = client, has_response = has_response, response = response) else trap("out of memory")
    platform_event_loop_plugin_spin_until(platform_event_loop_plugin_the(), gc.create_function0(gc.cell_heap(this_heap_cell), ak.Function0[bool](call = page_dialog_closed_goal, context = goal)))

    if not page_client_is_connection_open(client):
        ak.dbgln("WebContent client disconnected during spin_event_loop_until_dialog_closed. Exiting peacefully.")
        os.exit(0)

## Whether the alert response (Optional<Empty>) has a value.
func page_has_alert_response(response: void*?) -> bool:
    return *(const (ak.Empty?)*)(response else trap("no response")) != none

## Whether the confirm response (Optional<bool>) has a value.
func page_has_confirm_response(response: void*?) -> bool:
    return *(const (bool?)*)(response else trap("no response")) != none

## Whether the prompt response (Optional<Optional<String>>) has a value: here the prompt is
## answered once prompt_closed runs (m_pending_dialog leaves Prompt).
func page_has_prompt_response(response: void*?) -> bool:
    let this = (Page*)(response else trap("no page"))
    return this.m_pending_prompt_response_set

## Ported from Page.cpp:351 Web::Page::did_request_alert.
pub func page_did_request_alert(this: Page*, message: ak.String):
    this.m_pending_dialog = PagePendingDialog.alert
    page_client_page_did_request_alert(this.m_client, message)

    if not ak.string_is_empty(&message):
        this.m_pending_dialog_text = message

    page_spin_event_loop_until_dialog_closed(this.m_client, page_has_alert_response, &this.m_pending_alert_response)
    this.m_pending_alert_response = none

## Ported from Page.cpp:362 Web::Page::alert_closed.
pub func page_alert_closed(this: Page*):
    if this.m_pending_dialog == PagePendingDialog.alert:
        this.m_pending_alert_response = ak.Empty()
        page_on_pending_dialog_closed(this)

## Ported from Page.cpp:370 Web::Page::did_request_confirm.
pub func page_did_request_confirm(this: Page*, message: ak.String) -> bool:
    this.m_pending_dialog = PagePendingDialog.confirm
    page_client_page_did_request_confirm(this.m_client, message)

    if not ak.string_is_empty(&message):
        this.m_pending_dialog_text = message

    page_spin_event_loop_until_dialog_closed(this.m_client, page_has_confirm_response, &this.m_pending_confirm_response)
    let response = this.m_pending_confirm_response else trap("Optional::release_value() on an empty optional")
    this.m_pending_confirm_response = none
    return response

## Ported from Page.cpp:381 Web::Page::confirm_closed.
pub func page_confirm_closed(this: Page*, accepted: bool):
    if this.m_pending_dialog == PagePendingDialog.confirm:
        this.m_pending_confirm_response = accepted
        page_on_pending_dialog_closed(this)

## Ported from Page.cpp:389 Web::Page::did_request_prompt.
pub func page_did_request_prompt(this: Page*, message: ak.String, default_: ak.String) -> ak.String?:
    this.m_pending_dialog = PagePendingDialog.prompt
    page_client_page_did_request_prompt(this.m_client, message, default_)

    if not ak.string_is_empty(&message):
        this.m_pending_dialog_text = message

    page_spin_event_loop_until_dialog_closed(this.m_client, page_has_prompt_response, this)
    let response = this.m_pending_prompt_response
    this.m_pending_prompt_response = none
    this.m_pending_prompt_response_set = false
    return response

## Ported from Page.cpp:400 Web::Page::prompt_closed.
pub func page_prompt_closed(this: Page*, response: ak.String?):
    if this.m_pending_dialog == PagePendingDialog.prompt:
        this.m_pending_prompt_response = response
        this.m_pending_prompt_response_set = true
        page_on_pending_dialog_closed(this)

## Ported from Page.cpp:408 Web::Page::dismiss_dialog.
pub func page_dismiss_dialog(this: Page*, on_dialog_closed: gc.Function0[unit]*):
    this.m_on_pending_dialog_closed = on_dialog_closed

    match this.m_pending_dialog:
        .none_:
            discard(0)
        .alert:
            page_client_page_did_request_accept_dialog(this.m_client)
        .confirm, .prompt:
            page_client_page_did_request_dismiss_dialog(this.m_client)
        _:
            discard(0)

## Ported from Page.cpp:425 Web::Page::accept_dialog.
pub func page_accept_dialog(this: Page*, on_dialog_closed: gc.Function0[unit]*):
    this.m_on_pending_dialog_closed = on_dialog_closed

    match this.m_pending_dialog:
        .none_:
            discard(0)
        .alert, .confirm, .prompt:
            page_client_page_did_request_accept_dialog(this.m_client)
        _:
            discard(0)

## Ported from Page.cpp:440 Web::Page::on_pending_dialog_closed.
func page_on_pending_dialog_closed(this: Page*):
    this.m_pending_dialog = PagePendingDialog.none_
    this.m_pending_dialog_text = none

    if let on_closed = this.m_on_pending_dialog_closed:
        ak.function0_call(&on_closed.function)
        this.m_on_pending_dialog_closed = none

