# mark: Pixel conversions =======================================================================

## Ported from Page.cpp:180 Web::Page::device_to_css_point.
pub func page_device_to_css_point(this: Page*, point: gfx.IntPoint) -> gfx.CssPixelPoint:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    return gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64((f64)point.m_x / scale), m_y = gfx.CssPixels.from_f64((f64)point.m_y / scale))

## `CSSPixels * double` (CSSPixels(right) times left, PixelUnits.h:296) as DevicePixels: the
## product's value, truncated to an int.
func page_css_pixels_times_scale_as_device_pixels(value: gfx.CssPixels, scale: f64) -> i32:
    return (i32)value.mul(gfx.CssPixels.from_f64(scale)).to_double()

## Ported from Page.cpp:188 Web::Page::css_to_device_point.
pub func page_css_to_device_point(this: Page*, point: gfx.CssPixelPoint) -> gfx.IntPoint:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    return gfx.IntPoint(m_x = page_css_pixels_times_scale_as_device_pixels(point.m_x, scale), m_y = page_css_pixels_times_scale_as_device_pixels(point.m_y, scale))

## Ported from Page.cpp:196 Web::Page::css_to_device_rect.
pub func page_css_to_device_rect(this: Page*, rect: gfx.CssPixelRect) -> gfx.DevicePixelRect:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    # rect.location().to_type<double>() * scale and rect.size().to_type<double>() * scale, made
    # DevicePixels (ints) by truncation.
    var result: gfx.DevicePixelRect = ---
    gfx.device_pixel_rect_construct_i32(&result, (i32)(rect.m_location.m_x.to_double() * scale), (i32)(rect.m_location.m_y.to_double() * scale), (i32)(rect.m_size.m_width.to_double() * scale), (i32)(rect.m_size.m_height.to_double() * scale))
    return result

## Ported from Page.cpp:204 Web::Page::device_to_css_rect.
pub func page_device_to_css_rect(this: Page*, rect: gfx.DevicePixelRect) -> gfx.CssPixelRect:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    var result: gfx.CssPixelRect = ---
    gfx.css_pixel_rect_construct_css_pixels(&result, gfx.css_pixels_nearest_value_for_f64((f64)gfx.device_pixel_rect_x(&rect) / scale), gfx.css_pixels_nearest_value_for_f64((f64)gfx.device_pixel_rect_y(&rect) / scale), gfx.css_pixels_floored_value_for_f64((f64)gfx.device_pixel_rect_width(&rect) / scale), gfx.css_pixels_floored_value_for_f64((f64)gfx.device_pixel_rect_height(&rect) / scale))
    return result

## Ported from Page.cpp:215 Web::Page::device_to_css_size.
pub func page_device_to_css_size(this: Page*, size: gfx.IntSize) -> gfx.CssPixelSize:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    return gfx.CssPixelSize(m_width = gfx.css_pixels_floored_value_for_f64((f64)size.m_width / scale), m_height = gfx.css_pixels_floored_value_for_f64((f64)size.m_height / scale))

## Ported from Page.cpp:224 Web::Page::enclosing_device_rect.
pub func page_enclosing_device_rect(this: Page*, rect: gfx.CssPixelRect) -> gfx.DevicePixelRect:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    var result: gfx.DevicePixelRect = ---
    gfx.device_pixel_rect_construct_i32(&result, (i32)math.floor(rect.m_location.m_x.to_double() * scale), (i32)math.floor(rect.m_location.m_y.to_double() * scale), (i32)math.ceil(rect.m_size.m_width.to_double() * scale), (i32)math.ceil(rect.m_size.m_height.to_double() * scale))
    return result

## Ported from Page.cpp:234 Web::Page::rounded_device_rect.
pub func page_rounded_device_rect(this: Page*, rect: gfx.CssPixelRect) -> gfx.DevicePixelRect:
    let scale = page_client_device_pixels_per_css_pixel(page_client_const(this))
    # roundf: each product is made a float and rounded half away from zero.
    var result: gfx.DevicePixelRect = ---
    gfx.device_pixel_rect_construct_i32(&result, (i32)math.round((f64)(f32)(rect.m_location.m_x.to_double() * scale)), (i32)math.round((f64)(f32)(rect.m_location.m_y.to_double() * scale)), (i32)math.round((f64)(f32)(rect.m_size.m_width.to_double() * scale)), (i32)math.round((f64)(f32)(rect.m_size.m_height.to_double() * scale)))
    return result

## Ported from Page.cpp:245 Web::Page::chrome_metrics.
pub func page_chrome_metrics(this: Page*) -> ChromeMetrics:
    var metrics: ChromeMetrics = ---
    chrome_metrics_construct(&metrics, page_client_zoom_level(this.m_client))
    return metrics

