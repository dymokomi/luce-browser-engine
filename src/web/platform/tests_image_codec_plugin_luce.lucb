#==============================================================================================
#
#   tests_image_codec_plugin_luce - the ImageCodecPlugin over luce-gif, luce-bmp and luce-ico:
#   fixtures, animated GIFs streamed to AnimatedDecodedImageData, icon entries, errors
#
#   DESCRIPTION:
#       Ladybird's Tests/LibGfx/TestImageDecoder.cpp cases for BMP, ICO, CUR and GIF, run
#       through the plugin on LibGfx's test inputs (tests/libgfx, without the 590 KB
#       top-down.bmp, for which a small top-down bitmap stands in), and synthetic images
#       written by the local oracle's gen_cases.py (luce-browser-tools/oracles/
#       luce-browser-engine/image_codecs): a six-frame GIF on a 2x1 canvas exercising every
#       disposal, a transparent index and browser delays; icons with a PNG and a BMP entry and
#       with three BMP entries; a BMP holding a PNG. Every frame's pixels are checked as an
#       FNV-1a hash of its premultiplied BGRA8888 pixels against what Ladybird's ImageDecoder
#       makes of the same file (the oracle's expected.txt), except where we differ on
#       purpose: the loop count is the plays browsers make (Ladybird answers the count
#       written), an icon's largest entry is chosen even when it has no more bits than a
#       smaller one, and a BMP holding a PNG decodes.
#
#==============================================================================================

# mark: Helpers =================================================================================

## The bytes of a LibGfx test input (tests/libgfx/test-inputs).
func image_codec_test_input(path: str) -> ak.ByteBuffer:
    var full = ak.string_builder_new()
    ak.string_builder_append(&full, "tests/libgfx/test-inputs/")
    ak.string_builder_append(&full, path)
    return core_mapped_file_map(ak.string_builder_string_view(&full)) else trap("the test input reads")

## The FNV-1a hash of a bitmap's pixels, each premultiplied BGRA8888 pixel's bytes from the lowest (the oracle's hash).
func image_codec_test_hash(bitmap: const gfx.Bitmap*) -> u32:
    var hash: u32 = 2166136261
    for y: i32 in 0..<gfx.bitmap_height(bitmap):
        let row = gfx.bitmap_scanline_const(bitmap, y) else trap("a row")
        for x in 0..<(usize)gfx.bitmap_width(bitmap):
            for byte: u32 in 0..<4:
                hash ^= (row[x] >> (8 * byte)) & 0xff
                hash = hash *% 16777619
    return hash

## The pixel at (x, y) of a bitmap (premultiplied BGRA8888, as a u32).
func image_codec_test_pixel(bitmap: const gfx.Bitmap*, x: i32, y: i32) -> u32:
    let row = gfx.bitmap_scanline_const(bitmap, y) else trap("a row")
    return row[(usize)x]

## Frame `index` of a decoded image.
func image_codec_test_frame(image: const PlatformDecodedImage*, index: usize) -> gfx.Bitmap*:
    return ak.vector_at_const(&image.frames, index).bitmap else trap("a decoded frame has a bitmap")

## Whether frame `index` of a decoded image is `width` x `height` with the pixel hash `hash`.
func image_codec_test_frame_is(image: const PlatformDecodedImage*, index: usize, width: i32, height: i32, hash: u32) -> bool:
    let bitmap = image_codec_test_frame(image, index)
    return gfx.bitmap_width(bitmap) == width and gfx.bitmap_height(bitmap) == height and image_codec_test_hash(bitmap) == hash

## Decodes a still LibGfx test input: one frame, not animated, shown for `duration` ms, played `loop_count` times.
func image_codec_test_still(path: str, duration: u32, loop_count: u32) -> PlatformDecodedImage:
    let bytes = image_codec_test_input(path)
    let image = luce_image_codec_plugin_decode(ak.byte_buffer_bytes_const(&bytes)) else trap("the test input decodes")
    assert(image.frame_count == 1 and not image.is_animated and image.session_id == 0 and image.loop_count == loop_count)
    assert(ak.vector_size(&image.frames) == 1 and ak.vector_at_const(&image.frames, 0).duration == (usize)duration)
    assert(gfx.bitmap_format(image_codec_test_frame(&image, 0)) == gfx.BitmapFormat.bgra8888)
    assert(gfx.bitmap_alpha_type(image_codec_test_frame(&image, 0)) == gfx.AlphaType.premultiplied)
    return image

## Whether decoding `bytes` fails with `code`.
func image_codec_test_fails(bytes: const u8[], code: ErrorCode) -> bool:
    let image = luce_image_codec_plugin_decode(bytes) catch failure:
        return failure.code == code
    _ = image
    return false

# mark: Synthetic images (the oracle's gen_cases.py) ============================================

## A 2x1 GIF of six 1x1 frames over a palette of black, red, green and blue, looping twice
## (NETSCAPE2.0, its count at bytes 41 and 42): red at (0, 0) kept for 5 hundredths; green at
## (1, 0) cleared after, delay 0; blue at (0, 0) restored after, delay 1; blue at (1, 0), delay
## 20; green at (0, 0), delay 3; the transparent index at (1, 0), delay 7.
