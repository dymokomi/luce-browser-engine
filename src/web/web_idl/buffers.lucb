#       Copyright (c) 2023, Matthew Olsson <mattco@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: BufferableObjectBase ====================================================================

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:18 Web::WebIDL::BufferableObjectBase::byte_length.
pub func idl_bufferable_object_base_byte_length(this: IdlBufferableObjectBase*) -> u32:
    trap("unported (P3): Web::WebIDL::BufferableObjectBase::byte_length (JS buffer objects)")

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:32 Web::WebIDL::BufferableObjectBase::byte_offset.
pub func idl_bufferable_object_base_byte_offset(this: IdlBufferableObjectBase*) -> u32:
    match this.m_bufferable_object:
        .js_array_buffer(_):
            return 0
        _:
            trap("unported (P3): Web::WebIDL::BufferableObjectBase::byte_offset of a view (JS buffer objects)")

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:39 Web::WebIDL::BufferableObjectBase::element_size.
pub func idl_bufferable_object_base_element_size(this: IdlBufferableObjectBase*) -> u32:
    match this.m_bufferable_object:
        .js_typed_array_base(_):
            trap("unported (P3): Web::WebIDL::BufferableObjectBase::element_size of a TypedArray (JS buffer objects)")
        .js_data_view(_):
            return 1
        .js_array_buffer(_):
            return 1

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:54 Web::WebIDL::BufferableObjectBase::raw_object.
pub func idl_bufferable_object_base_raw_object(this: IdlBufferableObjectBase*) -> JsObject*:
    match this.m_bufferable_object:
        .js_typed_array_base(object):
            return (JsObject*)object
        .js_data_view(object):
            return (JsObject*)object
        .js_array_buffer(object):
            return (JsObject*)object

## Ported from Libraries/LibWeb/WebIDL/Buffers.h:36 Web::WebIDL::BufferableObjectBase::raw_object (const).
pub func idl_bufferable_object_base_raw_object_const(this: IdlBufferableObjectBase*) -> JsObject*:
    return idl_bufferable_object_base_raw_object(this)

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:59 Web::WebIDL::BufferableObjectBase::viewed_array_buffer.
pub func idl_bufferable_object_base_viewed_array_buffer(this: IdlBufferableObjectBase*) -> JsArrayBuffer*?:
    match this.m_bufferable_object:
        .js_array_buffer(array_buffer):
            return array_buffer
        _:
            trap("unported (P3): Web::WebIDL::BufferableObjectBase::viewed_array_buffer of a view (JS buffer objects)")

## Ported from Libraries/LibWeb/WebIDL/Buffers.h:40 Web::WebIDL::BufferableObjectBase::bufferable_object (const).
pub func idl_bufferable_object_base_bufferable_object_const(this: IdlBufferableObjectBase*) -> IdlBufferableObject:
    return this.m_bufferable_object

## Ported from Libraries/LibWeb/WebIDL/Buffers.h:41 Web::WebIDL::BufferableObjectBase::bufferable_object.
pub func idl_bufferable_object_base_bufferable_object(this: IdlBufferableObjectBase*) -> IdlBufferableObject*:
    return &this.m_bufferable_object

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:66 Web::WebIDL::BufferableObjectBase::bufferable_object_from_raw_object:
## which of the three kinds of buffer object `object` is (is<JS::TypedArrayBase>, ...: phase 3).
pub func idl_bufferable_object_base_bufferable_object_from_raw_object(object: JsObject*) -> IdlBufferableObject:
    trap("unported (P3): Web::WebIDL::BufferableObjectBase::bufferable_object_from_raw_object (JS buffer objects)")

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:80 Web::WebIDL::BufferableObjectBase::BufferableObjectBase.
pub func idl_bufferable_object_base_construct(this: IdlBufferableObjectBase*, object: JsObject*):
    this.m_bufferable_object = idl_bufferable_object_base_bufferable_object_from_raw_object(object)

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:85 Web::WebIDL::BufferableObjectBase::is_typed_array_base.
pub func idl_bufferable_object_base_is_typed_array_base(this: IdlBufferableObjectBase*) -> bool:
    match this.m_bufferable_object:
        .js_typed_array_base(_):
            return true
        _:
            return false

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:90 Web::WebIDL::BufferableObjectBase::is_data_view.
pub func idl_bufferable_object_base_is_data_view(this: IdlBufferableObjectBase*) -> bool:
    match this.m_bufferable_object:
        .js_data_view(_):
            return true
        _:
            return false

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:95 Web::WebIDL::BufferableObjectBase::is_array_buffer.
pub func idl_bufferable_object_base_is_array_buffer(this: IdlBufferableObjectBase*) -> bool:
    match this.m_bufferable_object:
        .js_array_buffer(_):
            return true
        _:
            return false

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:100 Web::WebIDL::BufferableObjectBase::visit_edges (override).
pub func idl_bufferable_object_base_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (IdlBufferableObjectBase*)base
    gc.cell_visit_edges_impl(base, visitor)
    js_visit_object(visitor, idl_bufferable_object_base_raw_object(this))

# mark: ArrayBufferView and BufferSource ========================================================

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:109 Web::WebIDL::ArrayBufferView::write.
## https://webidl.spec.whatwg.org/#arraybufferview-write
pub func idl_array_buffer_view_write(this: IdlArrayBufferView*, bytes: const u8[], starting_offset: u32 = 0):
    # 1. Let jsView be the result of converting view to a JavaScript value.
    # 2. Assert: bytes’s length ≤ jsView.[[ByteLength]] − startingOffset.
    # 3. Assert: if view is not a DataView, then bytes’s length modulo the element size of view’s type is 0.
    # 4. Let arrayBuffer be the result of converting jsView.[[ViewedArrayBuffer]] to an IDL value of type ArrayBuffer.
    # 5. Write bytes into arrayBuffer with startingOffset set to jsView.[[ByteOffset]] + startingOffset.
    trap("unported (P3): Web::WebIDL::ArrayBufferView::write (JS buffer objects)")

## Ported from Libraries/LibWeb/WebIDL/Buffers.cpp:131 Web::WebIDL::is_buffer_source_detached.
## https://webidl.spec.whatwg.org/#buffersource-detached
pub func idl_is_buffer_source_detached(buffer_source: JsValue) -> bool:
    # A buffer source type instance bufferSource is detached if the following steps return true:
    # 1. Let jsArrayBuffer be the result of converting bufferSource to a JavaScript value.
    # 2. If jsArrayBuffer has a [[ViewedArrayBuffer]] internal slot, then set jsArrayBuffer to jsArrayBuffer.[[ViewedArrayBuffer]].
    if not js_value_is_object(buffer_source):
        return false

    # The ArrayBuffer, TypedArray or DataView and IsDetachedBuffer: JS buffer objects (phase 3).
    # 3. Return IsDetachedBuffer(jsArrayBuffer).
    trap("unported (P3): Web::WebIDL::is_buffer_source_detached of a JS object")
