## Ported from Libraries/LibWeb/WebIDL/QuotaExceededError.cpp:37 Web::WebIDL::QuotaExceededError::create.
pub func idl_quota_exceeded_error_create_utf16_string(realm: Realm*, message: ak.Utf16String) -> IdlQuotaExceededError*:
