## Ported from Libraries/LibWeb/WebIDL/QuotaExceededError.cpp:43 Web::WebIDL::QuotaExceededError::construct_impl.
## https://webidl.spec.whatwg.org/#dom-quotaexceedederror-quotaexceedederror
pub func idl_quota_exceeded_error_construct_impl(realm: Realm*, message: ak.Utf16String, options: IdlQuotaExceededErrorOptions) -> IdlQuotaExceededError*!:
    let vm = realm_vm(realm)

    # 1. Set this’s name to "QuotaExceededError".
    # 2. Set this’s message to message.
    # NB: Done in constructor.
    let error_ = realm_create_idl_quota_exceeded_error_utf16_string(realm, realm, message)

    # 3. If options["quota"] is present:
    if let quota = options.quota:
        # 1. If options["quota"] is less than 0, then throw a RangeError.
        if quota < 0.0:
            return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Quota cannot be less than 0")))

        # 2. Set this’s quota to options["quota"].
        error_.m_quota = options.quota

    # 4. If options["requested"] is present:
    if let requested = options.requested:
        # 1. If options["requested"] is less than 0, then throw a RangeError.
        if requested < 0.0:
            return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Requested cannot be less than 0")))

        # 2. Set this’s requested to options["requested"].
        error_.m_requested = options.requested

    # 5. If this’s quota is not null, this’s requested is not null, and this’s requested is less than this’s quota, then throw a RangeError.
    if let quota = error_.m_quota:
        if let requested = error_.m_requested:
            if requested < quota:
                return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Requested cannot be less than quota")))

    return error_

