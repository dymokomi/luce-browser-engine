## Ported from Libraries/LibWeb/WebIDL/QuotaExceededError.cpp:16 Web::WebIDL::QuotaExceededError::QuotaExceededError.
pub func idl_quota_exceeded_error_construct(this: IdlQuotaExceededError*, realm: Realm*):
    idl_dom_exception_construct(this.idl_dom_exception(), realm)
    this.dom_exception.serializable.vtable = &idl_quota_exceeded_error_serializable_vtable

## Ported from Libraries/LibWeb/WebIDL/QuotaExceededError.cpp:21 Web::WebIDL::QuotaExceededError::QuotaExceededError.
pub func idl_quota_exceeded_error_construct_utf16_string(this: IdlQuotaExceededError*, realm: Realm*, message: ak.Utf16String):
    idl_dom_exception_construct_fly_string(this.idl_dom_exception(), realm, ak.fly_string_from_str("QuotaExceededError"), message)
    this.dom_exception.serializable.vtable = &idl_quota_exceeded_error_serializable_vtable

## Ported from Libraries/LibWeb/WebIDL/QuotaExceededError.cpp:26 Web::WebIDL::QuotaExceededError::initialize (override).
pub func idl_quota_exceeded_error_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.quota_exceeded_error)
