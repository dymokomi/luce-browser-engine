#==============================================================================================
#
#   tests_convert_to_int_vectors - expected results of WebIDL::convert_to_int (region r14)
#
#   DESCRIPTION:
#       Test vectors for tests_web_idl: every integer type, each input with no attribute,
#       [Clamp] and [EnforceRange], as Ladybird's WebIDL::convert_to_int<T> answers them
#       (recorded from the reference build, 47c82b38d0, through a local driver: the result as a
#       double, or the TypeError's message). Generated; exempt from the fragment size rule.
#
#       Donor quirk: on AArch64, AK::round_to<U>(double) for an unsigned U converts with the
#       signed fcvtns, so [Clamp] unsigned long saturates at 2^31 - 1 in the reference build
#       (2147483648 clamps to 2147483647). ak's round_to (luce-browser-foundation) converts as
#       x86-64 Ladybird and the specification do; the 9 rows this affects expect that value and
#       say so.
#
#==============================================================================================

## One call of convert_to_int and its answer.
struct ConvertToIntCase:
    var type_: IdlIntegerType
    var input: f64
    var enforce_range: bool
    var clamp: bool
    var expected: f64  # the result as a double, when error_ is empty
    var error_: str  # the TypeError's message, or empty

## The recorded calls.
let convert_to_int_cases: ConvertToIntCase[744] = [
    ConvertToIntCase(type_ = IdlIntegerType.byte, input = 0.0, enforce_range = false, clamp = false, expected = 0.0, error_ = ""),
    ConvertToIntCase(type_ = IdlIntegerType.octet, input = 0.0, enforce_range = false, clamp = false, expected = 0.0, error_ = ""),
