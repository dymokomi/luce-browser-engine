#       rules 4 and 7).
#
#==============================================================================================

# mark: FileApiBlobUrlEntry =====================================================================

## Variant<GC::Root<Blob>, GC::Root<MediaSourceExtensions::MediaSource>> (FileAPI::BlobURLEntry::Object).
pub enum FileApiBlobUrlEntryObject:
    blob(value: gc.Root[FileApiBlob])
    media_source(value: gc.Root[MediaSourceExtensionsMediaSource])

## Web::FileAPI::BlobURLEntry (Libraries/LibWeb/FileAPI/BlobURLStore.h:18).
# https://w3c.github.io/FileAPI/#blob-url-entry
pub struct FileApiBlobUrlEntry:
    pub var object: FileApiBlobUrlEntryObject
    pub var environment: gc.Root[HtmlEnvironmentSettingsObject]

## Web::FileAPI::BlobURLStore (Libraries/LibWeb/FileAPI/BlobURLStore.h:27).
# https://w3c.github.io/FileAPI/#BlobURLStore
pub type FileApiBlobUrlStore = ak.HashMap[ak.String, FileApiBlobUrlEntry, ak.StringTraits]
