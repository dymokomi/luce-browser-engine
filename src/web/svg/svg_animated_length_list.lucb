## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.cpp:15 Web::SVG::SVGAnimatedLengthList::create.
pub func svg_animated_length_list_create(realm: Realm*, base_val: SvgLengthList*) -> SvgAnimatedLengthList*:
    return realm_create_svg_animated_length_list(realm, realm, base_val)

## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.cpp:20 Web::SVG::SVGAnimatedLengthList::SVGAnimatedLengthList.
pub func svg_animated_length_list_construct(this: SvgAnimatedLengthList*, realm: Realm*, base_val: SvgLengthList*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_base_val = base_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.h:24 Web::SVG::SVGAnimatedLengthList::base_val.
pub func svg_animated_length_list_base_val(this: SvgAnimatedLengthList*) -> SvgLengthList*:
    return this.m_base_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.h:27 Web::SVG::SVGAnimatedLengthList::anim_val.
pub func svg_animated_length_list_anim_val(this: SvgAnimatedLengthList*) -> SvgLengthList*:
    # The donor answers the base value for animVal too.
    return this.m_base_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.cpp:26 Web::SVG::SVGAnimatedLengthList::initialize (override).
pub func svg_animated_length_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_animated_length_list)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGAnimatedLengthList.cpp:32 Web::SVG::SVGAnimatedLengthList::visit_edges (override).
pub func svg_animated_length_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgAnimatedLengthList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_base_val)
