#==============================================================================================
#
#   svg_mask_element - SVG::SVGMaskElement: <mask>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGMaskElement.cpp (lines 1-73) with the inline members of
#       SVGMaskElement.h: the maskUnits and maskContentUnits attributes, the viewBox trick for
#       objectBoundingBox content units, and the masking area. Masks have no layout node of
#       their own; the TreeBuilder handles them as a special case.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:17 Web::SVG::SVGMaskElement::SVGMaskElement.
pub func svg_mask_element_construct(this: SvgMaskElement*, document: DomDocument*, tag_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, tag_name)
    # The vptrs of the mixin bases move to SVGMaskElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_mask_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_mask_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_mask_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_mask_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:24 Web::SVG::SVGMaskElement::initialize (override).
pub func svg_mask_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_mask_element)
    svg_graphics_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:30 Web::SVG::SVGMaskElement::create_layout_node (override).
pub func svg_mask_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    # Masks are handled as a special case in the TreeBuilder.
    return none

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:36 Web::SVG::SVGMaskElement::attribute_changed (override).
pub func svg_mask_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgMaskElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    let value_text = value else ak.String()  # value.value_or(String {})
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_mask_units):
        this.m_mask_units = svg_attribute_parser_parse_units(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_mask_content_units):
        this.m_mask_content_units = svg_attribute_parser_parse_units(ak.string_bytes_as_string_view(&value_text))

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:47 Web::SVG::SVGMaskElement::mask_content_units.
pub func svg_mask_element_mask_content_units(this: SvgMaskElement*) -> SvgUnits:
    return this.m_mask_content_units else SvgUnits.user_space_on_use

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:52 Web::SVG::SVGMaskElement::mask_units.
pub func svg_mask_element_mask_units(this: SvgMaskElement*) -> SvgUnits:
    return this.m_mask_units else SvgUnits.object_bounding_box

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.cpp:57 Web::SVG::SVGMaskElement::resolve_masking_area.
pub func svg_mask_element_resolve_masking_area(this: SvgMaskElement*, mask_target: gfx.CssPixelRect) -> gfx.CssPixelRect:
    # TODO: Resolve this based on the x, y, width, and height of the mask.
    # CSSPixels(2) / 10 is a CSSPixelFraction, which Size<CSSPixels>::scaled takes as CSSPixels.
    let fraction = gfx.css_pixels_from_int(2).div(gfx.css_pixels_from_int(10))
    let size = gfx.css_pixel_rect_size(&mask_target)
    let scaled = gfx.css_pixel_size_scaled_css_pixels(&size, gfx.css_pixel_fraction_to_css_pixels(&fraction))
    return gfx.css_pixel_rect_inflated_css_pixel_size(&mask_target, scaled)

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.h:22 Web::SVG::SVGMaskElement::is_svg_mask_element (override).
pub func svg_mask_element_is_svg_mask_element_impl(base: DomNode*) -> bool:
    return true

## Ported from Libraries/LibWeb/SVG/SVGMaskElement.h:24 Web::SVG::SVGMaskElement::active_view_box (override).
pub func svg_mask_element_active_view_box_impl(base: SvgGraphicsElement*) -> SvgViewBox?:
    let this = (SvgMaskElement*)base
    # maskContentUnits = objectBoundingBox acts like the mask is sized to the bounding box
    # of the target element, with a viewBox of "0 0 1 1".
    if svg_mask_element_mask_content_units(this) == SvgUnits.object_bounding_box:
        return SvgViewBox(min_x = 0.0, min_y = 0.0, width = 1.0, height = 1.0)
    return none
