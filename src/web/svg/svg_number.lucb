#==============================================================================================
#
#   svg_number - SVG::SVGNumber: a number value of the SVG DOM
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGNumber.cpp (lines 1-49) with the inline members of SVGNumber.h
#       (https://www.w3.org/TR/SVG2/types.html#InterfaceSVGNumber).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGNumber.cpp:15 Web::SVG::SVGNumber::create.
pub func svg_number_create(realm: Realm*, value: f32, read_only: SvgNumberReadOnly) -> SvgNumber*:
    return realm_create_svg_number(realm, realm, value, read_only)

## Ported from Libraries/LibWeb/SVG/SVGNumber.cpp:20 Web::SVG::SVGNumber::SVGNumber.
pub func svg_number_construct(this: SvgNumber*, realm: Realm*, value: f32, read_only: SvgNumberReadOnly):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_value = value
    this.m_read_only = read_only

## Ported from Libraries/LibWeb/SVG/SVGNumber.cpp:27 Web::SVG::SVGNumber::initialize (override).
pub func svg_number_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_number)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGNumber.h:28 Web::SVG::SVGNumber::value.
pub func svg_number_value(this: SvgNumber*) -> f32:
    return this.m_value

## Ported from Libraries/LibWeb/SVG/SVGNumber.cpp:34 Web::SVG::SVGNumber::set_value.
# https://www.w3.org/TR/SVG2/types.html#__svg__SVGNumber__value
pub func svg_number_set_value(this: SvgNumber*, value: f32) -> !:
    # 1. If the SVGNumber is read only, then throw a NoModificationAllowedError.
    if this.m_read_only == SvgNumberReadOnly.yes:
        return try idl_throw(.idl_dom_exception(idl_no_modification_allowed_error_create(bind_platform_object_realm(this.bind_platform_object()),
                                                                                         ak.utf16_string_from_str("Cannot modify value of read-only SVGNumber"))))

    # 2. Set the SVGNumber's value to the value being assigned to the value member.
    this.m_value = value

    # FIXME: 3. If the SVGNumber reflects an element of the base value of a reflected attribute, then reserialize the
    #    reflected attribute.

    return

## Ported from Libraries/LibWeb/SVG/SVGNumber.h:31 Web::SVG::SVGNumber::read_only.
pub func svg_number_read_only(this: SvgNumber*) -> SvgNumberReadOnly:
    return this.m_read_only
