## Ported from Libraries/LibWeb/SVG/SVGDecodedImageData.cpp:223 Web::SVG::SVGDecodedImageData::surface.
## (Private in the donor and called by nothing there; public here so that an unused private function does not
## fail `check -W`.)
pub func svg_decoded_image_data_surface(this: SvgDecodedImageData*, frame_index: usize, size: gfx.IntSize) -> gfx.PaintingSurface*?:
    return svg_decoded_image_data_render_to_surface(this, size)

## Ported from Libraries/LibWeb/SVG/SVGDecodedImageData.cpp:228 Web::SVG::SVGDecodedImageData::paint (override).
pub func svg_decoded_image_data_paint_impl(base: HtmlDecodedImageData*, context: DisplayListRecordingContext*, frame_index: usize, dst_rect: gfx.DevicePixelRect, clip_rect: gfx.DevicePixelRect, scaling_mode: gfx.ScalingMode):
    let this = (SvgDecodedImageData*)base
    let recorded_display_list = svg_decoded_image_data_record_display_list(this, gfx.device_pixel_rect_size(&dst_rect)) else return

    let recorder = display_list_recording_context_display_list_recorder(context)
    display_list.display_list_recorder_save(recorder)
    display_list.display_list_recorder_add_clip_rect(recorder, clip_rect)
    display_list.display_list_recorder_paint_nested_display_list(recorder, recorded_display_list, dst_rect)
    display_list.display_list_recorder_restore(recorder)

