## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:15 Web::SVG::SVGLengthList::create.
pub func svg_length_list_create_vector(realm: Realm*, items: ak.Vector[SvgLength*], read_only: SvgReadOnlyList) -> SvgLengthList*:
    return realm_create_svg_length_list_vector(realm, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:20 Web::SVG::SVGLengthList::create.
pub func svg_length_list_create_svg_read_only_list(realm: Realm*, read_only: SvgReadOnlyList) -> SvgLengthList*:
    return realm_create_svg_length_list_svg_read_only_list(realm, realm, read_only)

## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:25 Web::SVG::SVGLengthList::SVGLengthList.
pub func svg_length_list_construct_vector(this: SvgLengthList*, realm: Realm*, items: ak.Vector[SvgLength*], read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    svg_list_construct_vector(&this.svg_list, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:31 Web::SVG::SVGLengthList::SVGLengthList.
pub func svg_length_list_construct_svg_read_only_list(this: SvgLengthList*, realm: Realm*, read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    svg_list_construct_svg_read_only_list(&this.svg_list, realm, read_only)

## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:37 Web::SVG::SVGLengthList::initialize (override).
pub func svg_length_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_length_list)
    js_cell_initialize_impl(base, realm)

## visitor.visit(GC::Ref<SvgLength>): one item of the list.
func svg_length_list_visit_item(visitor: gc.CellVisitor*, item: SvgLength*):
    gc.cell_visitor_visit_t_2(visitor, item)

## Ported from Libraries/LibWeb/SVG/SVGLengthList.cpp:43 Web::SVG::SVGLengthList::visit_edges (override).
pub func svg_length_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgLengthList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    svg_list_visit_edges(&this.svg_list, visitor, svg_length_list_visit_item)
