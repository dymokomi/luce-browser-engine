## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:164 Web::SVG::SVGRadialGradientElement::to_gfx_paint_style (override).
pub func svg_radial_gradient_element_to_gfx_paint_style_impl(base: SvgGradientElement*, paint_context: SvgPaintContext) -> display_list.SvgPaintServerPaintStyle*?:
    let this = (SvgRadialGradientElement*)base
    let units = svg_gradient_element_gradient_units(base)
    var start_center: gfx.FloatPoint
    var start_radius: f32 = 0.0
    var end_center: gfx.FloatPoint
    var end_radius: f32 = 0.0

    # FIXME: Where in the spec does it say what axis the radius is relative to?
    if units == SvgUnits.object_bounding_box:
        # If gradientUnits="objectBoundingBox", the user coordinate system for attributes ‘cx’, ‘cy’, ‘r’, ‘fx’, ‘fy’, and ‘fr’
        # is established using the bounding box of the element to which the gradient is applied (see Object bounding box units)
        # and then applying the transform specified by attribute ‘gradientTransform’. Percentages represent values relative
        # to the bounding box for the object.
        let bounding_box = &paint_context.path_bounding_box
        let location = gfx.float_rect_location(bounding_box)
        let start_x = svg_radial_gradient_element_start_circle_x(this)
        let start_y = svg_radial_gradient_element_start_circle_y(this)
        start_center = gfx.FloatPoint(
            m_x = location.m_x + svg_number_percentage_value(&start_x) * gfx.float_rect_width(bounding_box),
            m_y = location.m_y + svg_number_percentage_value(&start_y) * gfx.float_rect_height(bounding_box),
        )
        let start_r = svg_radial_gradient_element_start_circle_radius(this)
        start_radius = svg_number_percentage_value(&start_r) * gfx.float_rect_width(bounding_box)
        let end_x = svg_radial_gradient_element_end_circle_x(this)
        let end_y = svg_radial_gradient_element_end_circle_y(this)
        end_center = gfx.FloatPoint(
            m_x = location.m_x + svg_number_percentage_value(&end_x) * gfx.float_rect_width(bounding_box),
            m_y = location.m_y + svg_number_percentage_value(&end_y) * gfx.float_rect_height(bounding_box),
        )
        let end_r = svg_radial_gradient_element_end_circle_radius(this)
        end_radius = svg_number_percentage_value(&end_r) * gfx.float_rect_width(bounding_box)
    else:
        # GradientUnits::UserSpaceOnUse
        # If gradientUnits="userSpaceOnUse", ‘cx’, ‘cy’, ‘r’, ‘fx’, ‘fy’, and ‘fr’ represent values in the coordinate system
        # that results from taking the current user coordinate system in place at the time when the gradient element is
        # referenced (i.e., the user coordinate system for the element referencing the gradient element via a fill or stroke property)
        # and then applying the transform specified by attribute ‘gradientTransform’.
        # Percentages represent values relative to the current SVG viewport.
        # Note: The start/end centers will be in relative units here.
        # They will be resolved at paint time using the gradient paint transform.
        let viewport = &paint_context.viewport
        let start_x = svg_radial_gradient_element_start_circle_x(this)
        let start_y = svg_radial_gradient_element_start_circle_y(this)
        start_center = gfx.FloatPoint(
            m_x = svg_number_percentage_resolve_relative_to(&start_x, gfx.float_rect_width(viewport)),
            m_y = svg_number_percentage_resolve_relative_to(&start_y, gfx.float_rect_height(viewport)),
        )
        let start_r = svg_radial_gradient_element_start_circle_radius(this)
        start_radius = svg_number_percentage_resolve_relative_to(&start_r, gfx.float_rect_width(viewport))
        let end_x = svg_radial_gradient_element_end_circle_x(this)
        let end_y = svg_radial_gradient_element_end_circle_y(this)
        end_center = gfx.FloatPoint(
            m_x = svg_number_percentage_resolve_relative_to(&end_x, gfx.float_rect_width(viewport)),
            m_y = svg_number_percentage_resolve_relative_to(&end_y, gfx.float_rect_height(viewport)),
        )
        let end_r = svg_radial_gradient_element_end_circle_radius(this)
        end_radius = svg_number_percentage_resolve_relative_to(&end_r, gfx.float_rect_width(viewport))

    if this.m_paint_style == none:
        let created = display_list.svg_radial_gradient_paint_style_create(start_center, start_radius, end_center, end_radius)
        this.m_paint_style = created
        # FIXME: Update stops in DOM changes:
        svg_gradient_element_add_color_stops(base, (display_list.SvgGradientPaintStyle*)created)
    else:
        let existing = this.m_paint_style else trap("VERIFY: m_paint_style")
        display_list.svg_radial_gradient_paint_style_set_start_center(existing, start_center)
        display_list.svg_radial_gradient_paint_style_set_start_radius(existing, start_radius)
        display_list.svg_radial_gradient_paint_style_set_end_center(existing, end_center)
        display_list.svg_radial_gradient_paint_style_set_end_radius(existing, end_radius)
    # (the display list's upcasts are private to it: an embedded base is first, so a cast is the upcast)
    let paint_style = this.m_paint_style else trap("VERIFY: m_paint_style")
    display_list.svg_gradient_paint_style_set_gradient_transform((display_list.SvgGradientPaintStyle*)paint_style, svg_gradient_element_gradient_paint_transform(base, paint_context))
    display_list.svg_gradient_paint_style_set_spread_method((display_list.SvgGradientPaintStyle*)paint_style, svg_to_painting_spread_method(svg_gradient_element_spread_method(base)))
    display_list.svg_gradient_paint_style_set_color_space((display_list.SvgGradientPaintStyle*)paint_style, svg_gradient_element_color_space(base))
    return (display_list.SvgPaintServerPaintStyle*)paint_style

