## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.h:39 Web::SVG::SVGRadialGradientElement::linked_radial_gradient.
func svg_radial_gradient_element_linked_radial_gradient(this: SvgRadialGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgRadialGradientElement*?:
    if let gradient = svg_gradient_element_linked_gradient(this.svg_gradient_element(), seen_gradients):
        if is_svg_radial_gradient_element(gradient):
            return as_svg_radial_gradient_element(gradient)
    return none
