func svg_radial_gradient_element_start_circle_y_impl(this: SvgRadialGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    if let value = this.m_fy:
        return value
    # If the element references an element that specifies a value for 'fy', then the value of 'fy' is
    # inherited from the referenced element.
    if let gradient = svg_radial_gradient_element_linked_radial_gradient(this, seen_gradients):
        return svg_radial_gradient_element_start_circle_y_impl(gradient, seen_gradients)
    # If attribute ‘fy’ is not specified, ‘fy’ will coincide with the presentational value of ‘cy’ for
    # the element whether the value for 'cy' was inherited or not.
    return svg_radial_gradient_element_end_circle_y(this)

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:96 Web::SVG::SVGRadialGradientElement::start_circle_radius.
# https://svgwg.org/svg2-draft/pservers.html#RadialGradientElementFRAttribute
pub func svg_radial_gradient_element_start_circle_radius(this: SvgRadialGradientElement*) -> SvgNumberPercentage:
    var seen_gradients: SvgGradientElementSet
    return svg_radial_gradient_element_start_circle_radius_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:102 Web::SVG::SVGRadialGradientElement::start_circle_radius_impl.
func svg_radial_gradient_element_start_circle_radius_impl(this: SvgRadialGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    # Note: A negative value is an error.
    if let value = this.m_fr:
        if svg_number_percentage_value(&value) >= 0.0:
            return value
    # if the element references an element that specifies a value for 'fr', then the value of
    # 'fr' is inherited from the referenced element.
    if let gradient = svg_radial_gradient_element_linked_radial_gradient(this, seen_gradients):
        return svg_radial_gradient_element_start_circle_radius_impl(gradient, seen_gradients)
    # If the attribute is not specified, the effect is as if a value of '0%' were specified.
    return svg_number_percentage_create_percentage(0.0)

