func svg_radial_gradient_element_end_circle_x_impl(this: SvgRadialGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    if let value = this.m_cx:
        return value
    if let gradient = svg_radial_gradient_element_linked_radial_gradient(this, seen_gradients):
        return svg_radial_gradient_element_end_circle_x_impl(gradient, seen_gradients)
