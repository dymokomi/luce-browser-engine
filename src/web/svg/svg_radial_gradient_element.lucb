#==============================================================================================
#
#   svg_radial_gradient_element - SVG::SVGRadialGradientElement: <radialGradient>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGRadialGradientElement.cpp (lines 1-256) with the inline members
#       of SVGRadialGradientElement.h: cx, cy, r, fx, fy and fr (number-percentages, inherited
#       through the href chain of linked radial gradients; a dropped paint style on change) and
#       the radial gradient paint style (https://svgwg.org/svg2-draft/pservers.html#RadialGradients).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:17 Web::SVG::SVGRadialGradientElement::SVGRadialGradientElement.
pub func svg_radial_gradient_element_construct(this: SvgRadialGradientElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_gradient_element_construct(this.svg_gradient_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGRadialGradientElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_radial_gradient_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_radial_gradient_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_radial_gradient_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_radial_gradient_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:22 Web::SVG::SVGRadialGradientElement::initialize (override).
pub func svg_radial_gradient_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_radial_gradient_element)
    svg_gradient_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:28 Web::SVG::SVGRadialGradientElement::attribute_changed (override).
pub func svg_radial_gradient_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgRadialGradientElement*)base
    svg_gradient_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    # FIXME: These are <length> or <coordinate> in the spec, but all examples seem to allow percentages
    # and unitless values.
    let value_text = value else ak.String()  # value.value_or(String {})
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_cx):
        this.m_cx = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_cy):
        this.m_cy = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_fx):
        this.m_fx = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_fy):
        this.m_fy = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_fr):
        this.m_fr = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_r):
        this.m_r = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
        this.m_paint_style = none

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:56 Web::SVG::SVGRadialGradientElement::start_circle_x.
# https://svgwg.org/svg2-draft/pservers.html#RadialGradientElementFXAttribute
pub func svg_radial_gradient_element_start_circle_x(this: SvgRadialGradientElement*) -> SvgNumberPercentage:
    var seen_gradients: SvgGradientElementSet
    return svg_radial_gradient_element_start_circle_x_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGRadialGradientElement.cpp:62 Web::SVG::SVGRadialGradientElement::start_circle_x_impl.
func svg_radial_gradient_element_start_circle_x_impl(this: SvgRadialGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    if let value = this.m_fx:
        return value
    # If the element references an element that specifies a value for 'fx', then the value of 'fx' is
    # inherited from the referenced element.
    if let gradient = svg_radial_gradient_element_linked_radial_gradient(this, seen_gradients):
        return svg_radial_gradient_element_start_circle_x_impl(gradient, seen_gradients)
    # If attribute ‘fx’ is not specified, ‘fx’ will coincide with the presentational value of ‘cx’ for
    # the element whether the value for 'cx' was inherited or not.
    return svg_radial_gradient_element_end_circle_x(this)

