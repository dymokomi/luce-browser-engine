#==============================================================================================
#
#   svg_graphics_element - SVG::SVGGraphicsElement: transforms, paint and the bounding box
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGGraphicsElement.cpp (lines 1-406) with the inline members of
#       SVGGraphicsElement.h: the `transform` attribute, the painting properties read from
#       the layout node's computed values (fill and stroke colors, paint servers, opacity,
#       dashes, widths, line caps and joins, fill and clip rules), resolving url() references
#       to masks, clip paths and patterns, getBBox(), and transform_from_transform_list.
#
#       The template try_resolve_url_to<T> is resolve_url_to_element followed by the matching
#       as_if_<T> at each call site (a generic body cannot ask T for its class).
#
#==============================================================================================

# mark: Construction =============================================================================

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:34 Web::SVG::SVGGraphicsElement::SVGGraphicsElement.
pub func svg_graphics_element_construct(this: SvgGraphicsElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # Gfx::AffineTransform m_transform = {}: the identity.
    gfx.affine_transform_construct(&this.m_transform)

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:39 Web::SVG::SVGGraphicsElement::initialize (override).
pub func svg_graphics_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_graphics_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:45 Web::SVG::SVGGraphicsElement::attribute_changed (override).
pub func svg_graphics_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgGraphicsElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_string_view(&name, ak.sv("transform")):
        let text = value else ak.String()
        if let transform_list = svg_attribute_parser_parse_transform_string_view(ak.string_bytes_as_string_view(&text)):
            this.m_transform = svg_transform_from_transform_list(ak.vector_span_const(&transform_list))
        dom_node_set_needs_layout_update(base.dom_node(), DomSetNeedsLayoutReason.svg_graphics_element_transform_change)

# mark: Paint servers and references =============================================================

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:57 Web::SVG::SVGGraphicsElement::svg_paint_computed_value_to_gfx_paint_style.
func svg_graphics_element_svg_paint_computed_value_to_gfx_paint_style(this: SvgGraphicsElement*, paint_context: SvgPaintContext, paint_value: CssSvgPaint?,
                                                                      recording_context: DisplayListRecordingContext*? = none) -> display_list.SvgPaintServerPaintStyle*?:
    # FIXME: This entire function is an ad-hoc hack:
    let paint = paint_value else return none
    if not css_svg_paint_is_url(&paint):
        return none
    let url = css_svg_paint_as_url(&paint)
    if let element = svg_graphics_element_resolve_url_to_element(this, url):
        if let gradient = as_if_svg_gradient_element(element):
            return svg_gradient_element_to_gfx_paint_style(gradient, paint_context)
    if let element = svg_graphics_element_resolve_url_to_element(this, url):
        if let pattern = as_if_svg_pattern_element(element):
            if let context = recording_context:
                if let layout_node = dom_node_layout_node(this.dom_node()):
                    return svg_pattern_element_to_gfx_paint_style(pattern, paint_context, context, layout_node)
    return none

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:72 Web::SVG::SVGGraphicsElement::fill_paint_style.
# NB: SVG property accessors below are called during painting.
pub func svg_graphics_element_fill_paint_style(this: SvgGraphicsElement*, paint_context: SvgPaintContext, recording_context: DisplayListRecordingContext*? = none) -> display_list.SvgPaintServerPaintStyle*?:
    let node = dom_node_unsafe_layout_node(this.dom_node()) else return none
    let computed_values = layout_node_computed_values(node)
    return svg_graphics_element_svg_paint_computed_value_to_gfx_paint_style(this, paint_context, css_computed_values_fill(&computed_values.computed_values), recording_context)

