## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:284 Web::SVG::SVGGraphicsElement::resolve_relative_to_viewport_size.
func svg_graphics_element_resolve_relative_to_viewport_size(this: SvgGraphicsElement*, length_percentage: CssLengthPercentage) -> f32:
    # FIXME: Converting to pixels isn't really correct - values should be in "user units"
    #        https://svgwg.org/svg2-draft/coords.html#TermUserUnits
    # Resolved relative to the "Scaled viewport size": https://www.w3.org/TR/2017/WD-fill-stroke-3-20170413/#scaled-viewport-size
    # FIXME: This isn't right, but it's something.
    var viewport_width = gfx.CssPixels.from_int(0)
    var viewport_height = gfx.CssPixels.from_int(0)
    if let svg_svg_element = dom_node_first_flat_tree_ancestor_of_type(this.dom_node(), &svg_svgsvg_element_class):
        if let svg_svg_layout_node = dom_node_unsafe_layout_node(svg_svg_element):
            let computed_values = layout_node_computed_values(svg_svg_layout_node)
            let width = css_computed_values_width(&computed_values.computed_values)
            let height = css_computed_values_height(&computed_values.computed_values)
            viewport_width = css_size_to_px(&width, svg_svg_layout_node, gfx.CssPixels.from_int(0))
            viewport_height = css_size_to_px(&height, svg_svg_layout_node, gfx.CssPixels.from_int(0))
    let scaled_viewport_size = viewport_width.add(viewport_height).mul(gfx.CssPixels.from_f64(0.5))
    let node = dom_node_unsafe_layout_node(this.dom_node()) else trap("VERIFY: unsafe_layout_node()")
    return (f32)css_percentage_or_to_px(&length_percentage.percentage_or, node, scaled_viewport_size).to_double()

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:302 Web::SVG::SVGGraphicsElement::stroke_dasharray.
pub func svg_graphics_element_stroke_dasharray(this: SvgGraphicsElement*) -> ak.Vector[f32]:
    let node = dom_node_unsafe_layout_node(this.dom_node()) else return ak.Vector[f32]()

    var dasharray = ak.Vector[f32]()
    let computed_values = layout_node_computed_values(node)
    let values = css_computed_values_stroke_dasharray(&computed_values.computed_values)
    for value in ak.vector_span_const(&values):
        match value:
            .css_length_percentage(length_percentage):
                ak.vector_append_t(&dasharray, svg_graphics_element_resolve_relative_to_viewport_size(this, length_percentage))
            .f32_(number):
                ak.vector_append_t(&dasharray, number)

    # https://svgwg.org/svg2-draft/painting.html#StrokeDashing
    # If the list has an odd number of values, then it is repeated to yield an even number of values.
    if ak.vector_size(&dasharray) % 2 == 1:
        let copy = ak.vector_clone(&dasharray)
        ak.vector_extend_2(&dasharray, &copy)

    # If any value in the list is negative, the <dasharray> value is invalid. If all of the values in the list are zero, then the stroke is rendered as a solid line without any dashing.
    var all_zero = true
    for value in ak.vector_span_const(&dasharray):
        if value < 0.0:
            return ak.Vector[f32]()
        if value != 0.0:
            all_zero = false
    if all_zero:
        return ak.Vector[f32]()

    return dasharray

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:337 Web::SVG::SVGGraphicsElement::stroke_dashoffset.
