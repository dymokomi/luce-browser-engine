# mark: Transforms ===============================================================================

## `Gfx::AffineTransform {}`: the identity.
func svg_identity_transform() -> gfx.AffineTransform:
    var transform: gfx.AffineTransform
    gfx.affine_transform_construct(&transform)
    return transform

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:145 Web::SVG::transform_from_transform_list.
pub func svg_transform_from_transform_list(transform_list: const SvgTransform[]) -> gfx.AffineTransform:
    var affine_transform = svg_identity_transform()
    for transform in transform_list:
        match transform.operation:
            .svg_transform_translate(translate):
                var operation = svg_identity_transform()
                _ = gfx.affine_transform_translate_float_point(&operation, gfx.FloatPoint(m_x = translate.x, m_y = translate.y))
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
            .svg_transform_scale(scale):
                var operation = svg_identity_transform()
                _ = gfx.affine_transform_scale_float_point(&operation, gfx.FloatPoint(m_x = scale.x, m_y = scale.y))
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
            .svg_transform_rotate(rotate):
                var operation = svg_identity_transform()
                _ = gfx.affine_transform_translate_float_point(&operation, gfx.FloatPoint(m_x = rotate.x, m_y = rotate.y))
                _ = gfx.affine_transform_rotate_radians(&operation, ak.to_radians_f32(rotate.a))
                _ = gfx.affine_transform_translate_float_point(&operation, gfx.FloatPoint(m_x = -rotate.x, m_y = -rotate.y))
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
            .svg_transform_skew_x(skew_x):
                var operation = svg_identity_transform()
                _ = gfx.affine_transform_skew_radians(&operation, ak.to_radians_f32(skew_x.a), 0.0)
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
            .svg_transform_skew_y(skew_y):
                var operation = svg_identity_transform()
                _ = gfx.affine_transform_skew_radians(&operation, 0.0, ak.to_radians_f32(skew_y.a))
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
            .svg_transform_matrix(matrix):
                var operation: gfx.AffineTransform
                gfx.affine_transform_construct_f32(&operation, matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f)
                _ = gfx.affine_transform_multiply(&affine_transform, operation)
    return affine_transform

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:178 Web::SVG::to_svg_fill_rule (static).
func svg_to_svg_fill_rule(fill_rule: css_data.FillRule) -> SvgFillRule:
    match fill_rule:
        .nonzero: return SvgFillRule.nonzero
        .evenodd: return SvgFillRule.evenodd
        _: trap("VERIFY_NOT_REACHED")

