## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:204 Web::SVG::SVGGraphicsElement::fill_color.
pub func svg_graphics_element_fill_color(this: SvgGraphicsElement*) -> gfx.Color?:
    let node = dom_node_unsafe_layout_node(this.dom_node()) else return none

    let computed_values = layout_node_computed_values(node)
    let paint = css_computed_values_fill(&computed_values.computed_values) else return none

    if css_svg_paint_is_url(&paint):
        if let element = svg_graphics_element_resolve_url_to_element(this, css_svg_paint_as_url(&paint)):
            if let referenced_element = as_if_svg_graphics_element(element):
                return svg_graphics_element_fill_color(referenced_element)

        return css_svg_paint_fallback_color(&paint)

    return css_svg_paint_as_color(&paint)

