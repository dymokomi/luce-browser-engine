# mark: SVG DOM ==================================================================================

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:352 Web::SVG::SVGGraphicsElement::get_b_box.
# https://svgwg.org/svg2-draft/types.html#__svg__SVGGraphicsElement__getBBox
pub func svg_graphics_element_get_b_box(this: SvgGraphicsElement*, arg0: SvgBoundingBoxOptions?) -> GeometryDomRect*!:
    let realm = dom_element_realm(this.dom_element())
    # FIXME: It should be possible to compute this without layout updates. The bounding box is within the
    # SVG coordinate space (before any viewbox or other transformations), so it should be possible to
    # calculate this from SVG geometry without a full layout tree (at least for simple cases).
    # See: https://svgwg.org/svg2-draft/coords.html#BoundingBoxes
    dom_document_update_layout_if_needed_for_node(dom_node_document(this.dom_node()), this.dom_node(), DomUpdateLayoutReason.svg_graphics_element_get_b_box)
    if dom_node_layout_node(this.dom_node()) == none:
        return geometry_dom_rect_create_realm(realm)
    # Invert the SVG -> screen space transform.
    let owner_svg_element = svg_element_owner_svg_element(this.svg_element()) else return geometry_dom_rect_create_realm(realm)

    let owner_paintable = dom_node_paintable_box(owner_svg_element.dom_node())
    let self_paintable = dom_node_paintable_box(this.dom_node())
    if owner_paintable == none or self_paintable == none:
        # Throw only for non-rendered *graphics* elements where geometry isn't computable
        # (e.g. elements inside <marker>, <pattern>, etc.).
        if is_svg_svgsvg_element(this):
            return geometry_dom_rect_create_realm(realm)
        return try idl_throw(.idl_dom_exception(idl_invalid_state_error_create(realm, ak.utf16_string_from_str("Element is not rendered and geometry is not computable"))))
    let owner = owner_paintable else trap("VERIFY: owner_paintable")
    let self_box = self_paintable else trap("VERIFY: self_paintable")

    let svg_rect = paint_paintable_box_absolute_rect(owner)
    let transforms = paint_svg_graphics_paintable_computed_transforms(as_paint_svg_graphics_paintable(self_box))
    let svg_to_css = paint_svg_graphics_paintable_computed_transforms_svg_to_css_pixels_transform(&transforms)
    let inv = gfx.affine_transform_inverse(&svg_to_css)
    let self_rect = paint_paintable_box_absolute_rect(self_box)
    let float_rect = gfx.css_pixel_rect_to_type_f32(&self_rect)
    let svg_location = gfx.css_pixel_rect_location(&svg_rect)
    let svg_float_location = gfx.css_pixel_point_to_type_f32(&svg_location)
    var rect = gfx.float_rect_translated_float_point(&float_rect, gfx.float_point_neg(&svg_float_location))
    if let inverse = inv:
        rect = gfx.affine_transform_map_f32_float_rect(&inverse, rect)
    return geometry_dom_rect_create(realm, rect)

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:386 Web::SVG::SVGGraphicsElement::transform.
pub func svg_graphics_element_transform(this: SvgGraphicsElement*) -> SvgAnimatedTransformList*:
    let realm = dom_element_realm(this.dom_element())
    svg_graphics_element_dbgln_stubbed(this, "SVGGraphicsElement::transform()")
    let base_val = svg_transform_list_create_svg_read_only_list(realm, SvgReadOnlyList.yes)
    let anim_val = svg_transform_list_create_svg_read_only_list(realm, SvgReadOnlyList.yes)
    return svg_animated_transform_list_create(realm, base_val, anim_val)

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:394 Web::SVG::SVGGraphicsElement::get_screen_ctm.
