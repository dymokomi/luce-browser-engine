## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:86 Web::SVG::SVGGraphicsElement::resolve_url_to_element.
func svg_graphics_element_resolve_url_to_element(this: SvgGraphicsElement*, url: CssUrl) -> DomElement*?:
    # FIXME: Complete and use the entire URL, not just the fragment.
    var fragment: ak.FlyString? = none
    let url_string = css_url_url(&url)
    if let fragment_offset = ak.string_find_byte_offset_u32(&url_string, (u32)'#'):
        let substring = ak.string_substring_from_byte_offset_with_shared_superstring(&url_string, fragment_offset + 1) else trap("MUST: String::substring_from_byte_offset_with_shared_superstring")
        fragment = ak.fly_string_from_string(substring)
    let id = fragment else return none
    let document = dom_node_document(this.dom_node())
    if let element = dom_parent_node_get_element_by_id(document.dom_parent_node(), id):
        return element

    if let containing_shadow = dom_node_containing_shadow_root(this.dom_node()):
        if let element = dom_parent_node_get_element_by_id(containing_shadow.dom_parent_node(), id):
            return element

    return none

## Ported from Libraries/LibWeb/SVG/SVGGraphicsElement.cpp:107 Web::SVG::SVGGraphicsElement::mask.
pub func svg_graphics_element_mask(this: SvgGraphicsElement*) -> SvgMaskElement*?:
    # NB: unsafe_layout_node() because this is called during painting to resolve SVG references.
    let node = dom_node_unsafe_layout_node(this.dom_node()) else trap("VERIFY: unsafe_layout_node()")
    let computed_values = layout_node_computed_values(node)
    let mask_reference = css_computed_values_mask(&computed_values.computed_values) else return none
    let element = svg_graphics_element_resolve_url_to_element(this, css_mask_reference_url(&mask_reference)) else return none
    return as_if_svg_mask_element(element)

