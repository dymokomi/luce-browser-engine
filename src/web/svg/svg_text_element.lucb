#==============================================================================================
#
#   svg_text_element - SVG::SVGTextElement: <text>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGTextElement.cpp (lines 1-31): an SVGTextPositioningElement laid
#       out by an SVGTextBox.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGTextElement.cpp:15 Web::SVG::SVGTextElement::SVGTextElement.
pub func svg_text_element_construct(this: SvgTextElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_text_positioning_element_construct(this.svg_text_positioning_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGTextElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_text_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_text_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_text_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_text_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGTextElement.cpp:20 Web::SVG::SVGTextElement::initialize (override).
pub func svg_text_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_text_element)
    svg_text_positioning_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGTextElement.cpp:26 Web::SVG::SVGTextElement::create_layout_node (override).
pub func svg_text_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgTextElement*)base
    # heap().allocate<Layout::SVGTextBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_svg_text_box(dom_element_realm(base), dom_node_document(base.dom_node()), this.svg_text_positioning_element(), style).layout_node()
