#==============================================================================================
#
#   svgfe_morphology_element - SVG::SVGFEMorphologyElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEMorphologyElement.cpp (lines 1-84) with the inline members of SVGFEMorphologyElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feMorphologyElement): in, the operator
#       (erode or dilate) and the two radius components.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:15 Web::SVG::SVGFEMorphologyElement::SVGFEMorphologyElement.
pub func svg_svgfe_morphology_element_construct(this: SvgSvgfeMorphologyElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEMorphologyElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_morphology_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_morphology_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_morphology_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_morphology_element_global_event_handlers_vtable
    # Gfx::MorphologyOperator m_morphology_operator { Gfx::MorphologyOperator::Erode }
    this.m_morphology_operator = gfx.MorphologyOperator.erode

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:20 Web::SVG::SVGFEMorphologyElement::initialize (override).
pub func svg_svgfe_morphology_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_morphology_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:26 Web::SVG::SVGFEMorphologyElement::visit_edges (override).
pub func svg_svgfe_morphology_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeMorphologyElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)
    gc.cell_visitor_visit_t(visitor, this.m_radius_x)
    gc.cell_visitor_visit_t(visitor, this.m_radius_y)

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:35 Web::SVG::SVGFEMorphologyElement::attribute_changed (override).
pub func svg_svgfe_morphology_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, new_value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgSvgfeMorphologyElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, new_value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_operator):
        if new_value == none:
            this.m_morphology_operator = gfx.MorphologyOperator.dilate
            return

        let value = new_value else trap("VERIFY: new_value")
        if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("erode")):
            this.m_morphology_operator = gfx.MorphologyOperator.erode
        elif ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("dilate")):
            this.m_morphology_operator = gfx.MorphologyOperator.dilate
        else:
            this.m_morphology_operator = gfx.MorphologyOperator.dilate

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:54 Web::SVG::SVGFEMorphologyElement::in1.
pub func svg_svgfe_morphology_element_in1(this: SvgSvgfeMorphologyElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:62 Web::SVG::SVGFEMorphologyElement::operator_for_bindings.
pub func svg_svgfe_morphology_element_to_for_bindings(this: SvgSvgfeMorphologyElement*) -> SvgAnimatedEnumeration*:
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)this.m_morphology_operator)

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:67 Web::SVG::SVGFEMorphologyElement::radius_x.
pub func svg_svgfe_morphology_element_radius_x(this: SvgSvgfeMorphologyElement*) -> SvgAnimatedNumber*:
    if this.m_radius_x == none:
        this.m_radius_x = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_radius, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.first)

    return this.m_radius_x else trap("VERIFY: m_radius_x")

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.cpp:76 Web::SVG::SVGFEMorphologyElement::radius_y.
pub func svg_svgfe_morphology_element_radius_y(this: SvgSvgfeMorphologyElement*) -> SvgAnimatedNumber*:
    if this.m_radius_y == none:
        this.m_radius_y = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_radius, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.second)

    return this.m_radius_y else trap("VERIFY: m_radius_y")

## Ported from Libraries/LibWeb/SVG/SVGFEMorphologyElement.h:31 Web::SVG::SVGFEMorphologyElement::morphology_operator.
pub func svg_svgfe_morphology_element_morphology_operator(this: SvgSvgfeMorphologyElement*) -> gfx.MorphologyOperator:
    return this.m_morphology_operator
