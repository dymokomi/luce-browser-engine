## Ported from Libraries/LibWeb/SVG/SVGDefsElement.cpp:16 Web::SVG::SVGDefsElement::SVGDefsElement.
pub func svg_defs_element_construct(this: SvgDefsElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGDefsElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_defs_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_defs_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_defs_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_defs_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGDefsElement.cpp:25 Web::SVG::SVGDefsElement::initialize (override).
pub func svg_defs_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_defs_element)
    svg_graphics_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGDefsElement.h:20 Web::SVG::SVGDefsElement::create_layout_node (override).
pub func svg_defs_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    return none
