#==============================================================================================
#
#   svg_animation_element - SVG::SVGAnimationElement: the base of the animation elements
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGAnimationElement.cpp (lines 1-30): construction and
#       initialize. Animation itself is not implemented in the donor.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGAnimationElement.cpp:17 Web::SVG::SVGAnimationElement::SVGAnimationElement.
pub func svg_animation_element_construct(this: SvgAnimationElement*, document: DomDocument*, name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, name)
    # The vptrs of the mixin bases move to SVGAnimationElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_animation_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_animation_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_animation_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_animation_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGAnimationElement.cpp:22 Web::SVG::SVGAnimationElement::initialize (override).
pub func svg_animation_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_animation_element)
    svg_element_initialize_impl(base, realm)
