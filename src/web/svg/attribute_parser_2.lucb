## Ported from Libraries/LibWeb/SVG/AttributeParser.cpp:823 Web::SVG::AttributeParser::match_length.
func svg_attribute_parser_match_length(this: const SvgAttributeParser*, allow_dot: SvgAttributeParserAllowDot) -> bool:
    if svg_attribute_parser_done(this):
        return false

    var offset: usize = 0
    if svg_attribute_parser_ch(this) == '-' or svg_attribute_parser_ch(this) == '+':
        offset += 1

    if allow_dot == SvgAttributeParserAllowDot.yes and svg_attribute_parser_ch(this, offset) == '.':
        offset += 1

    return not svg_attribute_parser_done(this) and ak.is_ascii_digit(svg_attribute_parser_ch(this, offset))
