## Ported from Libraries/LibWeb/SVG/AttributeParser.cpp:795 Web::SVG::AttributeParser::match_whitespace.
func svg_attribute_parser_match_whitespace(this: const SvgAttributeParser*) -> bool:
    if svg_attribute_parser_done(this):
        return false
    let c_ = svg_attribute_parser_ch(this)
    return c_ == 0x9 or c_ == 0x20 or c_ == 0xa or c_ == 0xc or c_ == 0xd

