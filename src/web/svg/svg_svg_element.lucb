# mark: Natural metrics ==========================================================================

## negotiate_natural_metrics' aspect_ratio lambda.
func svg_svgsvg_element_natural_aspect_ratio(svg_root: SvgSvgsvgElement*, natural_metrics: const CssSizeWithAspectRatio*) -> gfx.CssPixelFraction?:
    # 1. If the width and height sizing properties on the ‘svg’ element are both absolute values:
    if let width = natural_metrics.width:
        if let height = natural_metrics.height:
            if width.m_value != 0 and height.m_value != 0:
                # 1. return width / height
                return width.div(height)
            return none

    # 2. If an SVG View is active:
    if let active_view_element = svg_svgsvg_element_active_view_element(svg_root):
        if let view_box = svg_fit_to_view_box_view_box(&active_view_element.svg_fit_to_view_box):
            # 1. let viewbox be the viewbox defined by the active SVG View

            # 2. return viewbox.width / viewbox.height
            if view_box.width != 0.0 or view_box.height != 0.0:
                var fraction: gfx.CssPixelFraction = ---
                gfx.css_pixel_fraction_construct_f64(&fraction, view_box.width / view_box.height)
                return fraction

            return none

    # 3. If the ‘viewBox’ on the ‘svg’ element is correctly specified:
    if let viewbox = svg_fit_to_view_box_view_box(&svg_root.svg_fit_to_view_box):
        # 1. let viewbox be the viewbox defined by the ‘viewBox’ attribute on the ‘svg’ element

        # 2. return viewbox.width / viewbox.height
        let viewbox_width = gfx.css_pixels_nearest_value_for_f64(viewbox.width)
        let viewbox_height = gfx.css_pixels_nearest_value_for_f64(viewbox.height)
        if viewbox_width.m_value != 0 and viewbox_height.m_value != 0:
            return viewbox_width.div(viewbox_height)

        return none

    # 4. return null
    return none

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:273 Web::SVG::SVGSVGElement::negotiate_natural_metrics.
pub func svg_svgsvg_element_negotiate_natural_metrics(svg_root: SvgSvgsvgElement*) -> CssSizeWithAspectRatio:
    # https://www.w3.org/TR/SVG2/coords.html#SizingSVGInCSS

    var natural_metrics = CssSizeWithAspectRatio()

    # The intrinsic dimensions must also be determined from the width and height sizing properties.
    # If either width or height are not specified, the used value is the initial value 'auto'.
    # 'auto' and percentage lengths must not be used to determine an intrinsic width or intrinsic height.

    if let width = svg_svgsvg_element_width_style_value_from_attribute(svg_root):
        if css_style_value_is_length(width):
            let length = css_length_style_value_length(css_style_value_as_length(width))
            if css_length_is_absolute(&length):
                natural_metrics.width = css_length_absolute_length_to_px(&length)

    if let height = svg_svgsvg_element_height_style_value_from_attribute(svg_root):
        if css_style_value_is_length(height):
            let length = css_length_style_value_length(css_style_value_as_length(height))
            if css_length_is_absolute(&length):
                natural_metrics.height = css_length_absolute_length_to_px(&length)

    # The intrinsic aspect ratio must be calculated using the following algorithm. If the algorithm returns null, then there is no intrinsic aspect ratio.
    natural_metrics.aspect_ratio = svg_svgsvg_element_natural_aspect_ratio(svg_root, &natural_metrics)

    return natural_metrics

