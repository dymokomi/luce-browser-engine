## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:237 Web::SVG::SVGSVGElement::deselect_all.
pub func svg_svgsvg_element_deselect_all(this: SvgSvgsvgElement*):
    # This is equivalent to calling document.getSelection().removeAllRanges() on the document that this ‘svg’ element is in.
    if let selection = dom_document_get_selection(dom_node_document(this.dom_node())):
        selection_selection_remove_all_ranges(selection)

