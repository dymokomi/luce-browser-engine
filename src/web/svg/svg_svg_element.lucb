#==============================================================================================
#
#   svg_svg_element - SVG::SVGSVGElement: <svg>, an SVG viewport
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGSVGElement.cpp (lines 1-335) with the inline members of
#       SVGSVGElement.h: construction (an SVGGraphicsElement with the SVGFitToViewBox
#       mixin), its layout box, the width and height presentation attributes as style values
#       (cached), the active viewBox (a <view> element, the viewBox attribute, or for SVG
#       used as an image a fallback from width and height), the stubbed SVG DOM members, and
#       the natural metrics of an SVG root (https://www.w3.org/TR/SVG2/coords.html#SizingSVGInCSS).
#
#       The caches `mutable Optional<RefPtr<StyleValue const>>` are a value and a `_set` flag
#       each (types_svgsvg_element).
#
#==============================================================================================

# mark: Construction =============================================================================

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:29 Web::SVG::SVGSVGElement::SVGSVGElement.
pub func svg_svgsvg_element_construct(this: SvgSvgsvgElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGSVGElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgsvg_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgsvg_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgsvg_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgsvg_element_global_event_handlers_vtable
    this.svg_fit_to_view_box.vtable = &svg_svgsvg_element_svg_fit_to_view_box_vtable
    this.svg_fit_to_view_box.class_id = this.cell().class_id

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:34 Web::SVG::SVGSVGElement::initialize (override).
pub func svg_svgsvg_element_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (SvgSvgsvgElement*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgsvg_element)
    svg_graphics_element_initialize_impl(base, realm)
    svg_fit_to_view_box_initialize(&this.svg_fit_to_view_box, realm)

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:41 Web::SVG::SVGSVGElement::visit_edges (override).
pub func svg_svgsvg_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgsvgElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_fit_to_view_box_visit_edges(&this.svg_fit_to_view_box, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_active_view_element)

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:48 Web::SVG::SVGSVGElement::create_layout_node (override).
pub func svg_svgsvg_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgSvgsvgElement*)base
    # heap().allocate<Layout::SVGSVGBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_svgsvg_box(dom_element_realm(base), dom_node_document(base.dom_node()), this, style).layout_node()

# mark: width and height =========================================================================

## `parse_css_value(SVGPresentationAttribute context, attribute.value_or(String {}), property_id)`, or, for an
## empty attribute, 100% (width_style_value_from_attribute and height_style_value_from_attribute).
func svg_svgsvg_element_dimension_style_value_from_attribute(this: SvgSvgsvgElement*, attribute_name: ak.FlyString, property_id: css_data.PropertyId) -> CssStyleValue*?:
    var parsing_context: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&parsing_context, dom_node_document(this.dom_node()), CssParsingMode.svg_presentation_attribute)
    let attribute = dom_element_attribute(this.dom_element(), attribute_name)

    var result: CssStyleValue*? = none
    let text = attribute else ak.String()
    if let value = parse_css_value(parsing_context, ak.string_bytes_as_string_view(&text), property_id):
        result = value
    elif attribute != none and ak.string_is_empty(&text):
        # If the `width` attribute is an empty string, it defaults to 100%.
        # This matches WebKit and Blink, but not Firefox. The spec is unclear.
        # FIXME: Figure out what to do here.
        result = css_percentage_style_value_create(css_percentage_new(100.0)).css_style_value()
    return result

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:53 Web::SVG::SVGSVGElement::width_style_value_from_attribute.
pub func svg_svgsvg_element_width_style_value_from_attribute(this: SvgSvgsvgElement*) -> CssStyleValue*?:
    if this.m_cached_width_style_value_set:
        return this.m_cached_width_style_value

    let result = svg_svgsvg_element_dimension_style_value_from_attribute(this, svg_attribute_names_width, css_data.PropertyId.width)

    this.m_cached_width_style_value = result
    this.m_cached_width_style_value_set = true
    return result

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:75 Web::SVG::SVGSVGElement::height_style_value_from_attribute.
pub func svg_svgsvg_element_height_style_value_from_attribute(this: SvgSvgsvgElement*) -> CssStyleValue*?:
    if this.m_cached_height_style_value_set:
        return this.m_cached_height_style_value

    let result = svg_svgsvg_element_dimension_style_value_from_attribute(this, svg_attribute_names_height, css_data.PropertyId.height)

    this.m_cached_height_style_value = result
    this.m_cached_height_style_value_set = true
    return result

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:97 Web::SVG::SVGSVGElement::attribute_changed (override).
pub func svg_svgsvg_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgSvgsvgElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    svg_fit_to_view_box_attribute_changed(&this.svg_fit_to_view_box, base, name, value)

    if ak.fly_string_equals_ignoring_ascii_case_fly_string(&name, &svg_attribute_names_width):
        this.m_cached_width_style_value = none
        this.m_cached_width_style_value_set = false
        svg_svgsvg_element_update_fallback_view_box_for_svg_as_image(this)
    if ak.fly_string_equals_ignoring_ascii_case_fly_string(&name, &svg_attribute_names_height):
        this.m_cached_height_style_value = none
        this.m_cached_height_style_value_set = false
        svg_svgsvg_element_update_fallback_view_box_for_svg_as_image(this)

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:112 Web::SVG::SVGSVGElement::children_changed (override).
pub func svg_svgsvg_element_children_changed_impl(base: DomNode*, arg0: DomNodeChildrenChangedMetadata):
    let this = (SvgSvgsvgElement*)base
    # FIXME: Add support for all types of SVG fragment identifier.
    #        See: https://svgwg.org/svg2-draft/linking.html#LinksIntoSVG
    let url = dom_document_url(dom_node_document(base))
    if let fragment = web_url.url_fragment(&url):
        if let referenced_element = dom_parent_node_get_element_by_id(this.dom_parent_node(), ak.fly_string_from_string(fragment)):
            if let view_element = as_if_svg_view_element(referenced_element):
                svg_svgsvg_element_set_active_view_element(this, view_element)
                return
        svg_svgsvg_element_set_active_view_element(this, none)

## The absolute length in pixels of a width or height attribute's value, if it is one.
func svg_absolute_length_in_px(value: CssStyleValue*?) -> f64?:
    let style_value = value else return none
    if not css_style_value_is_length(style_value):
        return none
    let length = css_length_style_value_length(css_style_value_as_length(style_value))
    if not css_length_is_absolute(&length):
        return none
    return css_length_absolute_length_to_px(&length).to_double()

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:127 Web::SVG::SVGSVGElement::update_fallback_view_box_for_svg_as_image.
func svg_svgsvg_element_update_fallback_view_box_for_svg_as_image(this: SvgSvgsvgElement*):
    # AD-HOC: This creates a fallback viewBox for SVGs used as images.
    #         If the <svg> element has width and height, but no viewBox,
    #         we fall back to a synthetic viewBox="0 0 width height".

    let width_attribute = dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_width)
    var parsing_context: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&parsing_context, dom_node_document(this.dom_node()), CssParsingMode.svg_presentation_attribute)
    let width = svg_absolute_length_in_px(parse_css_value(parsing_context, ak.string_bytes_as_string_view(&width_attribute), css_data.PropertyId.width))

    let height_attribute = dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_height)
    let height = svg_absolute_length_in_px(parse_css_value(parsing_context, ak.string_bytes_as_string_view(&height_attribute), css_data.PropertyId.height))

    this.m_fallback_view_box_for_svg_as_image = none
    if let used_width = width:
        if let used_height = height:
            if used_width > 0.0 and used_height > 0.0:
                this.m_fallback_view_box_for_svg_as_image = SvgViewBox(min_x = 0.0, min_y = 0.0, width = used_width, height = used_height)

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:156 Web::SVG::SVGSVGElement::set_fallback_view_box_for_svg_as_image.
pub func svg_svgsvg_element_set_fallback_view_box_for_svg_as_image(this: SvgSvgsvgElement*, view_box: SvgViewBox?):
    this.m_fallback_view_box_for_svg_as_image = view_box

## Ported from Libraries/LibWeb/SVG/SVGSVGElement.cpp:161 Web::SVG::SVGSVGElement::active_view_box (override).
pub func svg_svgsvg_element_active_view_box_impl(base: SvgGraphicsElement*) -> SvgViewBox?:
    let this = (SvgSvgsvgElement*)base
    if let active_view_element = this.m_active_view_element:
        if let view_box = svg_fit_to_view_box_view_box(&active_view_element.svg_fit_to_view_box):
            return view_box

    if let view_box = svg_fit_to_view_box_view_box(&this.svg_fit_to_view_box):
        return view_box

    # NOTE: If the parent is a document, we're an <svg> element used as an image.
    if let parent = tree_node_parent(this.dom_node()):
        if dom_node_is_document(parent) and this.m_fallback_view_box_for_svg_as_image != none:
            return this.m_fallback_view_box_for_svg_as_image

    return none

