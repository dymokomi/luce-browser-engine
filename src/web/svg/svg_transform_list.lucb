## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:16 Web::SVG::SVGTransformList::create.
pub func svg_transform_list_create_vector(realm: Realm*, items: ak.Vector[SvgSvgTransform*], read_only: SvgReadOnlyList) -> SvgTransformList*:
    return realm_create_svg_transform_list_vector(realm, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:21 Web::SVG::SVGTransformList::create.
pub func svg_transform_list_create_svg_read_only_list(realm: Realm*, read_only: SvgReadOnlyList) -> SvgTransformList*:
