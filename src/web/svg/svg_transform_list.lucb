## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:38 Web::SVG::SVGTransformList::initialize (override).
pub func svg_transform_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_transform_list)
    js_cell_initialize_impl(base, realm)

## visitor.visit(GC::Ref<SvgSvgTransform>): one item of the list.
func svg_transform_list_visit_item(visitor: gc.CellVisitor*, item: SvgSvgTransform*):
    gc.cell_visitor_visit_t_2(visitor, item)

## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:44 Web::SVG::SVGTransformList::visit_edges (override).
pub func svg_transform_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgTransformList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    svg_list_visit_edges(&this.svg_list, visitor, svg_transform_list_visit_item)
