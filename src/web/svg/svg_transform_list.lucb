## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:26 Web::SVG::SVGTransformList::SVGTransformList.
pub func svg_transform_list_construct_vector(this: SvgTransformList*, realm: Realm*, items: ak.Vector[SvgSvgTransform*], read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    svg_list_construct_vector(&this.svg_list, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGTransformList.cpp:32 Web::SVG::SVGTransformList::SVGTransformList.
pub func svg_transform_list_construct_svg_read_only_list(this: SvgTransformList*, realm: Realm*, read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
