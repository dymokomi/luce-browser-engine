#==============================================================================================
#
#   svg_line_element - SVG::SVGLineElement: <line>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGLineElement.cpp (lines 1-108): the x1, y1, x2 and y2 attributes
#       (number-percentages), the line's path (https://svgwg.org/svg2-draft/shapes.html#LineElement)
#       and the SVGAnimatedLength accessors.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGLineElement.cpp:19 Web::SVG::SVGLineElement::SVGLineElement.
pub func svg_line_element_construct(this: SvgLineElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_geometry_element_construct(this.svg_geometry_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGLineElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_line_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_line_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_line_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_line_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGLineElement.cpp:24 Web::SVG::SVGLineElement::initialize (override).
pub func svg_line_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_line_element)
    svg_geometry_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGLineElement.cpp:30 Web::SVG::SVGLineElement::attribute_changed (override).
pub func svg_line_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgLineElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    let value_text = value else ak.String()  # value.value_or(String {})

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x1):
        this.m_x1 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y1):
        this.m_y1 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x2):
        this.m_x2 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y2):
        this.m_y2 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))

    if (ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x1) or ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y1) or ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x2) or ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y2)):
        dom_node_set_needs_layout_update(base.dom_node(), DomSetNeedsLayoutReason.style_change)

## Ported from Libraries/LibWeb/SVG/SVGLineElement.cpp:48 Web::SVG::SVGLineElement::get_path (override).
pub func svg_line_element_get_path_impl(base: SvgGeometryElement*, viewport_size: gfx.CssPixelSize) -> gfx.Path:
    let this = (SvgLineElement*)base
    let viewport_width = viewport_size.m_width.to_float()
    let viewport_height = viewport_size.m_height.to_float()

    var path: gfx.Path
    let x1 = svg_number_percentage_or_zero_resolved(this.m_x1, viewport_width)
    let y1 = svg_number_percentage_or_zero_resolved(this.m_y1, viewport_height)
    let x2 = svg_number_percentage_or_zero_resolved(this.m_x2, viewport_width)
    let y2 = svg_number_percentage_or_zero_resolved(this.m_y2, viewport_height)

    # 1. perform an absolute moveto operation to absolute location (x1,y1)
    gfx.path_move_to(&path, gfx.FloatPoint(m_x = x1, m_y = y1))

    # 2. perform an absolute lineto operation to absolute location (x2,y2)
    gfx.path_line_to(&path, gfx.FloatPoint(m_x = x2, m_y = y2))

    return path

## Ported from Libraries/LibWeb/SVG/SVGLineElement.cpp:100 Web::SVG::SVGLineElement::x1.
# https://www.w3.org/TR/SVG11/shapes.html#LineElementX1Attribute
pub func svg_line_element_x1(this: SvgLineElement*) -> SvgAnimatedLength*:
    let realm = dom_element_realm(this.dom_element())
    # FIXME: Populate the unit type when it is parsed (0 here is "unknown").
    # FIXME: Create a proper animated value when animations are supported.
    let base_length = svg_length_create(realm, 0, svg_number_percentage_or_zero_value(this.m_x1), SvgLengthReadOnly.no)
    let anim_length = svg_length_create(realm, 0, svg_number_percentage_or_zero_value(this.m_x1), SvgLengthReadOnly.yes)
    return svg_animated_length_create(realm, base_length, anim_length)

