#==============================================================================================
#
#   svgfe_offset_element - SVG::SVGFEOffsetElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEOffsetElement.cpp (lines 1-63) with the inline members of SVGFEOffsetElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feOffsetElement): in, dx and dy.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:14 Web::SVG::SVGFEOffsetElement::SVGFEOffsetElement.
pub func svg_svgfe_offset_element_construct(this: SvgSvgfeOffsetElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEOffsetElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_offset_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_offset_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_offset_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_offset_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:19 Web::SVG::SVGFEOffsetElement::initialize (override).
pub func svg_svgfe_offset_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_offset_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:25 Web::SVG::SVGFEOffsetElement::visit_edges (override).
pub func svg_svgfe_offset_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeOffsetElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)
    gc.cell_visitor_visit_t(visitor, this.m_dx)
    gc.cell_visitor_visit_t(visitor, this.m_dy)

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:35 Web::SVG::SVGFEOffsetElement::in1.
# https://www.w3.org/TR/filter-effects-1/#dom-svgfeoffsetelement-in1
pub func svg_svgfe_offset_element_in1(this: SvgSvgfeOffsetElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:44 Web::SVG::SVGFEOffsetElement::dx.
# https://www.w3.org/TR/filter-effects-1/#dom-svgfeoffsetelement-dx
pub func svg_svgfe_offset_element_dx(this: SvgSvgfeOffsetElement*) -> SvgAnimatedNumber*:
    if this.m_dx == none:
        this.m_dx = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_dx, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.first)

    return this.m_dx else trap("VERIFY: m_dx")

## Ported from Libraries/LibWeb/SVG/SVGFEOffsetElement.cpp:54 Web::SVG::SVGFEOffsetElement::dy.
# https://www.w3.org/TR/filter-effects-1/#dom-svgfeoffsetelement-dy
pub func svg_svgfe_offset_element_dy(this: SvgSvgfeOffsetElement*) -> SvgAnimatedNumber*:
    if this.m_dy == none:
        this.m_dy = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_dy, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.second)

    return this.m_dy else trap("VERIFY: m_dy")
