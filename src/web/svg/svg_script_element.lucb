#==============================================================================================
#
#   svg_script_element - SVG::SVGScriptElement: <script> in SVG
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGScriptElement.cpp (lines 1-205) with the inline members of
#       SVGScriptElement.h: an SVGElement with the SVGURIReferenceMixin (xlink:href
#       supported) that processes inline and external classic scripts
#       (https://www.w3.org/TR/SVGMobile12/script.html#ScriptContentProcessing). With
#       scripting disabled (phase 1) processing stops at the scripting check; running a
#       ClassicScript is phase 3.
#
#==============================================================================================

# mark: Construction =============================================================================

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:25 Web::SVG::SVGScriptElement::SVGScriptElement.
pub func svg_script_element_construct(this: SvgScriptElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGScriptElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_script_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_script_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_script_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_script_element_global_event_handlers_vtable
    svg_script_element_init_fields(this)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:30 Web::SVG::SVGScriptElement::initialize (override).
pub func svg_script_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_script_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:36 Web::SVG::SVGScriptElement::visit_edges (override).
pub func svg_script_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgScriptElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_svguri_reference_mixin_visit_edges(&this.svguri_reference_mixin, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_script)  # opaque in phase 1

# mark: DOM steps ===============================================================================

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:43 Web::SVG::SVGScriptElement::attribute_changed (override).
pub func svg_script_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgScriptElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_href) or ak.fly_string_eq_fly_string(&name, &svg_attribute_names_type):
        svg_script_element_process_the_script_element(this)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:51 Web::SVG::SVGScriptElement::inserted (override).
pub func svg_script_element_inserted_impl(base: DomNode*):
    let this = (SvgScriptElement*)base
    svg_element_inserted_impl(base)
    if this.m_parser_inserted:
        return

    svg_script_element_process_the_script_element(this)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:60 Web::SVG::SVGScriptElement::children_changed (override).
pub func svg_script_element_children_changed_impl(base: DomNode*, metadata: DomNodeChildrenChangedMetadata):
    let this = (SvgScriptElement*)base
    svg_element_children_changed_impl(base, metadata)
    if this.m_parser_inserted:
        return

    svg_script_element_process_the_script_element(this)

# mark: Processing ===============================================================================

## The captures of the external script fetch's process_response_consume_body: `[self, script_url]`.
struct SvgScriptElementProcessResponse:
    var this: SvgScriptElement*
    var script_url: web_url.Url

## process_the_script_element's process_response_consume_body lambda.
func svg_script_element_process_response_consume_body(context: void*?, response: FetchResponse*, body_bytes: FetchAlgorithmsBodyBytes):
    let captures = (SvgScriptElementProcessResponse*)(context else trap("SVG script fetch: no captures"))
    var body = ak.ByteBuffer()
    if not fetch_response_is_network_error(response):
        match body_bytes:
            .byte_buffer(bytes): body = bytes
            _: body = ak.ByteBuffer()
    svg_script_element_finish_external_script_fetch(captures.this, captures.script_url, body)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:70 Web::SVG::SVGScriptElement::process_the_script_element.
# https://www.w3.org/TR/SVGMobile12/script.html#ScriptContentProcessing
pub func svg_script_element_process_the_script_element(this: SvgScriptElement*):
    let node = this.dom_node()
    # 1. If the 'script' element's "already processed" flag is true or if the element is not in the
    #    document tree, then no action is performed and these steps are ended.
    if this.m_already_processed or not dom_node_in_a_document_tree(node):
        return

    # https://html.spec.whatwg.org/multipage/webappapis.html#enabling-and-disabling-scripting
    if dom_node_is_scripting_disabled(node):
        return

    # https://svgwg.org/svg2-draft/interact.html#ScriptElement
    # Before attempting to execute the ‘script’ element the resolved media type value for ‘type’ must be inspected.
    # If the SVG user agent does not support the scripting language then the ‘script’ element must not be executed.
    # FIXME: Support type="module" scripts
    let maybe_script_type = dom_element_attribute(this.dom_element(), svg_attribute_names_type)
    if let type_attribute = maybe_script_type:
        if not ak.string_is_empty(&type_attribute):
            let lowercase = ak.string_to_ascii_lowercase(&type_attribute)
            let script_type = ak.string_trim_ascii_whitespace(&lowercase) else trap("MUST: String::trim_ascii_whitespace")
            if not mime_is_javascript_mime_type_essence_match(ak.string_bytes_as_string_view(&script_type)):
                ak.dbgln(f"SVGScriptElement: Unsupported script type: {ak.string_view_text(ak.string_bytes_as_string_view(&type_attribute))}")
                return

    let document = dom_node_document(node)

    # 2. If the 'script' element references external script content, then the external script content
    #    using the current value of the 'xlink:href' attribute is fetched. Further processing of the
    #    'script' element is dependent on the external script content, and will block here until the
    #    resource has been fetched or is determined to be an invalid IRI reference.
    if dom_element_has_attribute(this.dom_element(), svg_attribute_names_href) or dom_element_has_attribute_ns(this.dom_element(), namespace_x_link, svg_attribute_names_href):
        let href = svg_svguri_reference_mixin_href(&this.svguri_reference_mixin, this.svg_element(), SvgSupportsXLinkHref.yes)
        let href_value = svg_animated_string_base_val(href)
        let maybe_script_url = dom_document_encoding_parse_url(document, ak.string_bytes_as_string_view(&href_value))
        if maybe_script_url == none:
            ak.dbgln(f"Invalid script URL: {ak.string_view_text(ak.string_bytes_as_string_view(&href_value))}")
            return
        let script_url = maybe_script_url else trap("VERIFY: maybe_script_url.has_value()")

        let realm = dom_element_realm(this.dom_element())
        let vm = realm_vm(realm)
        let request = fetch_request_create(vm)
        fetch_request_set_url(request, script_url)
        fetch_request_set_destination(request, FetchRequestDestination.script)
        # FIXME: Use CORS state specified by the ‘crossorigin’ attribute.
        fetch_request_set_mode(request, FetchRequestMode.no_cors)
        fetch_request_set_credentials_mode(request, FetchRequestCredentialsMode.same_origin)
        fetch_request_set_client(request, dom_document_relevant_settings_object(document))

        # 3. The 'script' element's "already processed" flag is set to true.
        # We set this before dispatching the fetch so that re-entrant calls (e.g. from attribute_changed
        # while the fetch is in flight) early-return at step 1, matching Chromium's `already_started_`
        # semantics. The in-flight fetch is allowed to finish.
        this.m_already_processed = true

        svg_script_element_clear_load_event_delayer(this)
        var delayer: DomDocumentLoadEventDelayer = ---
        dom_document_load_event_delayer_construct(&delayer, document)
        this.m_document_load_event_delayer = delayer
        if this.m_parser_inserted:
            dom_document_set_pending_parsing_blocking_svg_script(document, this)

        let captures = (new SvgScriptElementProcessResponse(this = this, script_url = script_url)) else trap("out of memory")
        let algorithms = fetch_algorithms_create(vm, FetchAlgorithmsInput(process_response_consume_body = ak.Function2[FetchResponse*, FetchAlgorithmsBodyBytes, unit](call = svg_script_element_process_response_consume_body, context = captures)))
        discard(fetch_fetching_fetch(realm, request, algorithms))
        return

    let script_content_utf16 = dom_node_child_text_content(node)
    let script_content = ak.utf16_string_base_to_utf8_but_should_be_ported_to_utf16(&script_content_utf16.utf16_string_base)
    if ak.string_is_empty(&script_content):
        return

    # 3. The 'script' element's "already processed" flag is set to true.
    this.m_already_processed = true

    let document_url = dom_document_url(document)
    let basename = web_url.url_basename(&document_url)
    this.m_script = html_classic_script_create(ak.byte_string_view(&basename), ak.string_bytes_as_string_view(&script_content), html_relevant_settings_object_dom_node(node),
                                               dom_document_base_url(document))

    svg_script_element_execute_script(this)

## `m_document_load_event_delayer.clear()`.
func svg_script_element_clear_load_event_delayer(this: SvgScriptElement*):
    if let delayer = this.m_document_load_event_delayer:
        var released = delayer
        dom_document_load_event_delayer_destruct(&released)
    this.m_document_load_event_delayer = none

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:154 Web::SVG::SVGScriptElement::finish_external_script_fetch.
func svg_script_element_finish_external_script_fetch(this: SvgScriptElement*, script_url: web_url.Url, body: ak.ByteBuffer):
    let node = this.dom_node()
    let document = dom_node_document(node)
    if not ak.byte_buffer_is_empty(&body) and dom_node_in_a_document_tree(node) and not dom_node_is_scripting_disabled(node):
        var bytes = body
        let data = ak.byte_buffer_bytes(&bytes)
        let script_content: ak.String? = ak.string_from_utf8(ak.StringView(m_characters = data.data, m_length = data.length)) catch:
            recover none
        if let content = script_content:
            let basename = web_url.url_basename(&script_url)
            this.m_script = html_classic_script_create(ak.byte_string_view(&basename), ak.string_bytes_as_string_view(&content), html_relevant_settings_object_dom_node(node),
                                                       dom_document_base_url(document))
        else:
            ak.dbgln("Failed to decode SVG external script as UTF-8")

    if this.m_parser_inserted:
        this.m_ready_to_be_parser_executed = true
        dom_document_schedule_html_parser_end_check(document)
        return

    defer svg_script_element_clear_load_event_delayer(this)
    svg_script_element_execute_script(this)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:175 Web::SVG::SVGScriptElement::execute_pending_parser_blocking_script.
pub func svg_script_element_execute_pending_parser_blocking_script(this: SvgScriptElement*):
    assert(this.m_ready_to_be_parser_executed)
    this.m_ready_to_be_parser_executed = false
    defer svg_script_element_clear_load_event_delayer(this)
    svg_script_element_execute_script(this)

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.cpp:183 Web::SVG::SVGScriptElement::execute_script.
func svg_script_element_execute_script(this: SvgScriptElement*):
    # 4. If the script content is inline, or if it is external and was fetched successfully, then the
    #    script is executed. Note that at this point, these steps may be re-entrant if the execution
    #    of the script results in further 'script' elements being inserted into the document.
    # m_script is null when the external fetch failed; the parser-blocking slot still needs to be drained
    # so the parser can resume, but there's no script to run.
    let script = this.m_script else return

    # https://html.spec.whatwg.org/multipage/document-lifecycle.html#read-html
    # Before any script execution occurs, the user agent must wait for scripts may run for the newly-created document to be true for document.
    if not dom_document_ready_to_run_scripts(dom_node_document(this.dom_node())):
        return

    # FIXME: Note that a load event is dispatched on a 'script' element once it has been processed,
    # unless it referenced external script content with an invalid IRI reference and 'externalResourcesRequired' was set to 'true'.
    html_classic_script_run(script)

# mark: SVGScriptElement.h =======================================================================

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.h:26 Web::SVG::SVGScriptElement::is_parser_inserted.
pub func svg_script_element_is_parser_inserted(this: SvgScriptElement*) -> bool:
    return this.m_parser_inserted

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.h:27 Web::SVG::SVGScriptElement::set_parser_inserted.
pub func svg_script_element_set_parser_inserted(this: SvgScriptElement*):
    this.m_parser_inserted = true

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.h:29 Web::SVG::SVGScriptElement::is_ready_to_be_parser_executed.
pub func svg_script_element_is_ready_to_be_parser_executed(this: SvgScriptElement*) -> bool:
    return this.m_ready_to_be_parser_executed

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.h:32 Web::SVG::SVGScriptElement::set_source_line_number.
pub func svg_script_element_set_source_line_number(this: SvgScriptElement*, source_line_number: usize):
    this.m_source_line_number = source_line_number

## Ported from Libraries/LibWeb/SVG/SVGScriptElement.h:44 Web::SVG::SVGScriptElement::is_svg_script_element (override).
pub func svg_script_element_is_svg_script_element_impl(base: DomNode*) -> bool:
    return true
