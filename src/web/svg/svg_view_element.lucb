#==============================================================================================
#
#   svg_view_element - SVG::SVGViewElement: <view>, a named view of an <svg>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGViewElement.cpp (lines 1-42) with the inline members of
#       SVGViewElement.h: an SVGGraphicsElement with the SVGFitToViewBox mixin.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGViewElement.cpp:18 Web::SVG::SVGViewElement::SVGViewElement.
pub func svg_view_element_construct(this: SvgViewElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGViewElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_view_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_view_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_view_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_view_element_global_event_handlers_vtable
    this.svg_fit_to_view_box.vtable = &svg_view_element_svg_fit_to_view_box_vtable
    this.svg_fit_to_view_box.class_id = this.cell().class_id

## Ported from Libraries/LibWeb/SVG/SVGViewElement.cpp:23 Web::SVG::SVGViewElement::initialize (override).
pub func svg_view_element_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (SvgViewElement*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_view_element)
    svg_graphics_element_initialize_impl(base, realm)
    svg_fit_to_view_box_initialize(&this.svg_fit_to_view_box, realm)

## Ported from Libraries/LibWeb/SVG/SVGViewElement.cpp:30 Web::SVG::SVGViewElement::visit_edges (override).
pub func svg_view_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgViewElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_fit_to_view_box_visit_edges(&this.svg_fit_to_view_box, visitor)

## Ported from Libraries/LibWeb/SVG/SVGViewElement.cpp:36 Web::SVG::SVGViewElement::attribute_changed (override).
pub func svg_view_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgViewElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    svg_fit_to_view_box_attribute_changed(&this.svg_fit_to_view_box, base, name, value)

## Ported from Libraries/LibWeb/SVG/SVGViewElement.h:25 Web::SVG::SVGViewElement::is_svg_view_element (override).
pub func svg_view_element_is_svg_view_element_impl(base: DomNode*) -> bool:
    return true
