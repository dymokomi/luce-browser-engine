#==============================================================================================
#
#   tag_names - SVG::TagNames: the local names of the SVG elements
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/SVG/TagNames.cpp (lines 1-16) with TagNames.h's
#       ENUMERATE_SVG_TAGS. C++ initializes the FlyStrings statically; here
#       svg_tag_names_initialize_strings interns them at run time and web_initialize_strings
#       runs it at startup (DESIGN.md §2.6). Ported with region r21 because the HTML parser
#       compares tag and attribute names against them; the owning region keeps the rest of its
#       file.
#
#==============================================================================================

## Whether svg_tag_names_initialize_strings has run.
var svg_tag_names_strings_initialized: bool

## Ported from Libraries/LibWeb/SVG/TagNames.cpp:11 the definitions of Web::SVG::TagNames's FlyStrings
## (`FlyString name = #name##_fly_string;` for each ENUMERATE_SVG_TAGS entry).
pub func svg_tag_names_initialize_strings():
    if svg_tag_names_strings_initialized:
        return
    svg_tag_names_a = ak.fly_string_from_str("a")
    svg_tag_names_circle = ak.fly_string_from_str("circle")
    svg_tag_names_clip_path = ak.fly_string_from_str("clipPath")
    svg_tag_names_defs = ak.fly_string_from_str("defs")
    svg_tag_names_desc = ak.fly_string_from_str("desc")
    svg_tag_names_ellipse = ak.fly_string_from_str("ellipse")
    svg_tag_names_fe_blend = ak.fly_string_from_str("feBlend")
    svg_tag_names_fe_color_matrix = ak.fly_string_from_str("feColorMatrix")
    svg_tag_names_fe_component_transfer = ak.fly_string_from_str("feComponentTransfer")
    svg_tag_names_fe_composite = ak.fly_string_from_str("feComposite")
    svg_tag_names_fe_displacement_map = ak.fly_string_from_str("feDisplacementMap")
    svg_tag_names_fe_drop_shadow = ak.fly_string_from_str("feDropShadow")
    svg_tag_names_fe_flood = ak.fly_string_from_str("feFlood")
    svg_tag_names_fe_func_a = ak.fly_string_from_str("feFuncA")
    svg_tag_names_fe_func_b = ak.fly_string_from_str("feFuncB")
    svg_tag_names_fe_func_g = ak.fly_string_from_str("feFuncG")
    svg_tag_names_fe_func_r = ak.fly_string_from_str("feFuncR")
    svg_tag_names_fe_gaussian_blur = ak.fly_string_from_str("feGaussianBlur")
    svg_tag_names_fe_image = ak.fly_string_from_str("feImage")
    svg_tag_names_fe_merge = ak.fly_string_from_str("feMerge")
    svg_tag_names_fe_merge_node = ak.fly_string_from_str("feMergeNode")
    svg_tag_names_fe_morphology = ak.fly_string_from_str("feMorphology")
    svg_tag_names_fe_offset = ak.fly_string_from_str("feOffset")
    svg_tag_names_fe_turbulence = ak.fly_string_from_str("feTurbulence")
    svg_tag_names_filter = ak.fly_string_from_str("filter")
    svg_tag_names_foreign_object = ak.fly_string_from_str("foreignObject")
    svg_tag_names_g = ak.fly_string_from_str("g")
    svg_tag_names_image = ak.fly_string_from_str("image")
    svg_tag_names_line = ak.fly_string_from_str("line")
    svg_tag_names_linear_gradient = ak.fly_string_from_str("linearGradient")
    svg_tag_names_mask = ak.fly_string_from_str("mask")
    svg_tag_names_metadata = ak.fly_string_from_str("metadata")
    svg_tag_names_path = ak.fly_string_from_str("path")
    svg_tag_names_pattern = ak.fly_string_from_str("pattern")
    svg_tag_names_polygon = ak.fly_string_from_str("polygon")
    svg_tag_names_polyline = ak.fly_string_from_str("polyline")
    svg_tag_names_radial_gradient = ak.fly_string_from_str("radialGradient")
    svg_tag_names_rect = ak.fly_string_from_str("rect")
    svg_tag_names_script = ak.fly_string_from_str("script")
    svg_tag_names_stop = ak.fly_string_from_str("stop")
    svg_tag_names_style = ak.fly_string_from_str("style")
    svg_tag_names_svg = ak.fly_string_from_str("svg")
    svg_tag_names_symbol = ak.fly_string_from_str("symbol")
    svg_tag_names_text = ak.fly_string_from_str("text")
    svg_tag_names_text_path = ak.fly_string_from_str("textPath")
    svg_tag_names_title = ak.fly_string_from_str("title")
    svg_tag_names_tspan = ak.fly_string_from_str("tspan")
    svg_tag_names_use = ak.fly_string_from_str("use")
    svg_tag_names_view = ak.fly_string_from_str("view")
    svg_tag_names_strings_initialized = true
