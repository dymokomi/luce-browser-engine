#==============================================================================================
#
#   svgt_span_element - SVG::SVGTSpanElement: <tspan>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGTSpanElement.cpp (lines 1-35): an SVGTextPositioningElement laid
#       out by an SVGTextBox when it is inside a <text> element.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGTSpanElement.cpp:16 Web::SVG::SVGTSpanElement::SVGTSpanElement.
pub func svg_svgt_span_element_construct(this: SvgSvgtSpanElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_text_positioning_element_construct(this.svg_text_positioning_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGTSpanElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgt_span_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgt_span_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgt_span_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgt_span_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGTSpanElement.cpp:21 Web::SVG::SVGTSpanElement::initialize (override).
pub func svg_svgt_span_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgt_span_element)
    svg_text_positioning_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGTSpanElement.cpp:27 Web::SVG::SVGTSpanElement::create_layout_node (override).
pub func svg_svgt_span_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgSvgtSpanElement*)base
    # Text must be within an SVG <text> element.
    if dom_node_first_flat_tree_ancestor_of_type(this.dom_node(), &svg_text_element_class) != none:
        # heap().allocate<Layout::SVGTextBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
        return realm_create_layout_svg_text_box(dom_element_realm(base), dom_node_document(base.dom_node()), this.svg_text_positioning_element(), style).layout_node()
    return none
