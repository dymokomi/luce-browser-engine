#==============================================================================================
#
#   svgfe_image_element - SVG::SVGFEImageElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEImageElement.cpp (lines 1-120) with the inline members of SVGFEImageElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feImageElement): the href (SVGURIReferenceMixin;
#       the XLink-namespaced href is used only without a plain one) fetched through a
#       SharedResourceRequest (P2), its bitmap and its content rectangle.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:22 Web::SVG::SVGFEImageElement::SVGFEImageElement.
pub func svg_svgfe_image_element_construct(this: SvgSvgfeImageElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEImageElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_image_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_image_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_image_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_image_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:27 Web::SVG::SVGFEImageElement::initialize (override).
pub func svg_svgfe_image_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_image_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:33 Web::SVG::SVGFEImageElement::visit_edges (override).
pub func svg_svgfe_image_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeImageElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    svg_svguri_reference_mixin_visit_edges(&this.svguri_reference_mixin, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_resource_request)

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:41 Web::SVG::SVGFEImageElement::attribute_changed (override).
pub func svg_svgfe_image_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgSvgfeImageElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_href):
        if let attribute_namespace = namespace_:
            if ak.fly_string_eq_fly_string(&attribute_namespace, &namespace_x_link) and dom_element_has_attribute_ns(base, none, name):
                return

        var href = value
        if namespace_ == none and href == none:
            href = dom_element_get_attribute_ns(base, svg_attribute_names_href, namespace_x_link)

        svg_svgfe_image_element_process_href(this, href)

## process_href's on-finish callback: `[this, resource_request = GC::Root { m_resource_request }] { ... }` (the
## request is kept by the element; the callback needs only `this`).
func svg_svgfe_image_element_fetch_on_finish(context: void*?):
    let this = (SvgSvgfeImageElement*)(context else trap("process href: no feImage element"))
    dom_node_set_needs_style_update(this.dom_node(), true)
    dom_node_set_needs_layout_update(this.dom_node(), DomSetNeedsLayoutReason.svg_image_filter_fetch)

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:57 Web::SVG::SVGFEImageElement::process_href.
func svg_svgfe_image_element_process_href(this: SvgSvgfeImageElement*, href: ak.String?):
    if href == none:
        this.m_href = none
        return
    let href_text = href else trap("VERIFY: href")

    let document = dom_node_document(this.dom_node())
    let realm = dom_element_realm(this.dom_element())
    this.m_href = dom_document_encoding_parse_url(document, ak.string_bytes_as_string_view(&href_text))
    let url = this.m_href else return

    let resource_request = html_shared_resource_request_get_or_create(realm, dom_document_page(document), url)
    this.m_resource_request = resource_request
    html_shared_resource_request_add_callbacks(resource_request, ak.Function0[unit](call = svg_svgfe_image_element_fetch_on_finish, context = this), ak.Function0[unit](call = none, context = none))

    if html_shared_resource_request_needs_fetching(resource_request):
        let request = html_create_potential_cors_request(realm_vm(realm), url, FetchRequestDestination.image, HtmlCorsSettingAttribute.no_cors)
        fetch_request_set_client(request, dom_document_relevant_settings_object(document))
        html_shared_resource_request_fetch_resource(resource_request, realm, request)

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:83 Web::SVG::SVGFEImageElement::current_image_bitmap.
pub func svg_svgfe_image_element_current_image_bitmap(this: SvgSvgfeImageElement*, size: gfx.IntSize = gfx.IntSize()) -> gfx.ImmutableBitmap*?:
    let resource_request = this.m_resource_request else return none
    if let data = html_shared_resource_request_image_data(resource_request):
        return html_decoded_image_data_bitmap(data, 0, size)
    return none

## Ported from Libraries/LibWeb/SVG/SVGFEImageElement.cpp:92 Web::SVG::SVGFEImageElement::content_rect.
pub func svg_svgfe_image_element_content_rect(this: SvgSvgfeImageElement*) -> gfx.DevicePixelRect?:
    let bitmap = svg_svgfe_image_element_current_image_bitmap(this) else return none
    # NB: Called during painting.
    let layout_node = dom_node_unsafe_layout_node(this.dom_node()) else return none
    let computed_values = &layout_node_computed_values(layout_node).computed_values
    let zero = gfx.css_pixels_from_int(0)
    let computed_width = css_computed_values_width(computed_values)
    var width = css_size_to_px(&computed_width, layout_node, zero)
    if width.raw_value() == 0:
        width = gfx.css_pixels_from_int((i64)gfx.immutable_bitmap_width(bitmap))
    let computed_height = css_computed_values_height(computed_values)
    var height = css_size_to_px(&computed_height, layout_node, zero)
    if height.raw_value() == 0:
        height = gfx.css_pixels_from_int((i64)gfx.immutable_bitmap_height(bitmap))
    let computed_x = css_computed_values_x(computed_values)
    let x = css_percentage_or_to_px(&computed_x.percentage_or, layout_node, zero)
    let computed_y = css_computed_values_y(computed_values)
    let y = css_percentage_or_to_px(&computed_y.percentage_or, layout_node, zero)
    return gfx.enclosing_int_rect(gfx.FloatRect(m_location = gfx.FloatPoint(m_x = x.to_float(), m_y = y.to_float()), m_size = gfx.FloatSize(m_width = width.to_float(), m_height = height.to_float())))
