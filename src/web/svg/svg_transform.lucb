## Ported from Libraries/LibWeb/SVG/SVGTransform.cpp:16 Web::SVG::SVGTransform::create.
pub func svg_svg_transform_create(realm: Realm*) -> SvgSvgTransform*:
    return realm_create_svg_svg_transform(realm, realm)

## Ported from Libraries/LibWeb/SVG/SVGTransform.cpp:21 Web::SVG::SVGTransform::SVGTransform.
pub func svg_svg_transform_construct(this: SvgSvgTransform*, realm: Realm*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)

## Ported from Libraries/LibWeb/SVG/SVGTransform.cpp:28 Web::SVG::SVGTransform::initialize (override).
pub func svg_svg_transform_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_transform)
    js_cell_initialize_impl(base, realm)

