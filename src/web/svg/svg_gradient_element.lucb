#==============================================================================================
#
#   svg_gradient_element - SVG::SVGGradientElement: the base of the gradient paint servers
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGGradientElement.cpp (lines 1-171) with the inline members of
#       SVGGradientElement.h: gradientUnits, spreadMethod and gradientTransform (each inherited
#       through the href chain of linked gradients, ad hoc as in the donor), the color space,
#       the gradient's paint transform, and the color stops (the stops of the first gradient in
#       the chain that has any) added to a paint style.
#
#       `HashTable<SVGGradientElement const*>` of seen gradients is SvgGradientElementSet, and the
#       template for_each_color_stop takes a function pointer beside its capture context.
#
#==============================================================================================

## `HashTable<SVGGradientElement const*>`: the gradients an href chain has visited.
type SvgGradientElementSet = ak.HashTable[SvgGradientElement*, ak.PtrTraits[SvgGradientElement]]

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.h:24 Web::SVG::to_painting_spread_method.
pub func svg_to_painting_spread_method(spread_method: SvgSpreadMethod) -> display_list.SvgGradientPaintStyleSpreadMethod:
    match spread_method:
        .pad_: return display_list.SvgGradientPaintStyleSpreadMethod.pad_
        .reflect: return display_list.SvgGradientPaintStyleSpreadMethod.reflect
        .repeat: return display_list.SvgGradientPaintStyleSpreadMethod.repeat
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:19 Web::SVG::SVGGradientElement::SVGGradientElement.
pub func svg_gradient_element_construct(this: SvgGradientElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGGradientElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_gradient_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_gradient_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_gradient_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_gradient_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:24 Web::SVG::SVGGradientElement::attribute_changed (override).
pub func svg_gradient_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgGradientElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    let value_text = value else ak.String()  # value.value_or(String {})
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_gradient_units):
        this.m_gradient_units = svg_attribute_parser_parse_units(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_spread_method):
        this.m_spread_method = svg_attribute_parser_parse_spread_method(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_gradient_transform):
        if let transform_list = svg_attribute_parser_parse_transform_string_view(ak.string_bytes_as_string_view(&value_text)):
            this.m_gradient_transform = svg_transform_from_transform_list(ak.vector_span_const(&transform_list))
        else:
            this.m_gradient_transform = none

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:41 Web::SVG::SVGGradientElement::gradient_units.
pub func svg_gradient_element_gradient_units(this: SvgGradientElement*) -> SvgUnits:
    var seen_gradients: SvgGradientElementSet
    return svg_gradient_element_gradient_units_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:47 Web::SVG::SVGGradientElement::gradient_units_impl.
func svg_gradient_element_gradient_units_impl(this: SvgGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgUnits:
    if let gradient_units = this.m_gradient_units:
        return gradient_units
    if let gradient = svg_gradient_element_linked_gradient(this, seen_gradients):
        return svg_gradient_element_gradient_units_impl(gradient, seen_gradients)
    return SvgUnits.object_bounding_box

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:56 Web::SVG::SVGGradientElement::spread_method.
pub func svg_gradient_element_spread_method(this: SvgGradientElement*) -> SvgSpreadMethod:
    var seen_gradients: SvgGradientElementSet
    return svg_gradient_element_spread_method_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:62 Web::SVG::SVGGradientElement::spread_method_impl.
func svg_gradient_element_spread_method_impl(this: SvgGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgSpreadMethod:
    if let spread_method = this.m_spread_method:
        return spread_method
    if let gradient = svg_gradient_element_linked_gradient(this, seen_gradients):
        return svg_gradient_element_spread_method_impl(gradient, seen_gradients)
    return SvgSpreadMethod.pad_

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:71 Web::SVG::SVGGradientElement::color_space.
pub func svg_gradient_element_color_space(this: SvgGradientElement*) -> gfx.InterpolationColorSpace:
    let computed_properties = dom_element_computed_properties(this.dom_element()) else trap("VERIFY: computed_properties()")
    match css_computed_properties_color_interpolation(computed_properties):
        .linearrgb: return gfx.InterpolationColorSpace.linear_rgb
        .auto, .srgb: return gfx.InterpolationColorSpace.srgb
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:84 Web::SVG::SVGGradientElement::gradient_transform.
pub func svg_gradient_element_gradient_transform(this: SvgGradientElement*) -> gfx.AffineTransform?:
    var seen_gradients: SvgGradientElementSet
    return svg_gradient_element_gradient_transform_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:90 Web::SVG::SVGGradientElement::gradient_transform_impl.
func svg_gradient_element_gradient_transform_impl(this: SvgGradientElement*, seen_gradients: SvgGradientElementSet*) -> gfx.AffineTransform?:
    if this.m_gradient_transform != none:
        return this.m_gradient_transform
    if let gradient = svg_gradient_element_linked_gradient(this, seen_gradients):
        return svg_gradient_element_gradient_transform_impl(gradient, seen_gradients)
    return none

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:100 Web::SVG::SVGGradientElement::gradient_paint_transform.
# The gradient transform, appropriately scaled and combined with the paint transform.
pub func svg_gradient_element_gradient_paint_transform(this: SvgGradientElement*, paint_context: SvgPaintContext) -> gfx.AffineTransform:
    var gradient_paint_transform = layout_identity_affine_transform()  # Gfx::AffineTransform {}
    let mapped_bounding_box = gfx.affine_transform_map_f32_float_rect(&paint_context.paint_transform, paint_context.path_bounding_box)
    let location = gfx.float_rect_location(&mapped_bounding_box)
    gfx.affine_transform_set_translation_float_point(&gradient_paint_transform, gfx.float_point_neg(&location))
    gfx.affine_transform_multiply(&gradient_paint_transform, paint_context.paint_transform)

    if let transform = svg_gradient_element_gradient_transform(this):
        gfx.affine_transform_multiply(&gradient_paint_transform, transform)

    return gradient_paint_transform

## add_color_stops' lambda captures: the paint style and the largest offset so far.
struct SvgGradientElementAddColorStopsCaptures:
    var paint_style: display_list.SvgGradientPaintStyle*
    var largest_offset: f32

## add_color_stops' lambda, called for each color stop.
func svg_gradient_element_add_color_stop(context: void*, stop: SvgStopElement*):
    let captures = (SvgGradientElementAddColorStopsCaptures*)context
    # https://svgwg.org/svg2-draft/pservers.html#StopNotes
    # Gradient offset values less than 0 (or less than 0%) are rounded up to 0%.
    # Gradient offset values greater than 1 (or greater than 100%) are rounded down to 100%.
    var stop_offset = ak.clamp_f32(svg_stop_element_stop_offset(stop), 0.0, 1.0)

    # Each gradient offset value is required to be equal to or greater than the previous gradient
    # stop's offset value. If a given gradient stop's offset value is not equal to or greater than all
    # previous offset values, then the offset value is adjusted to be equal to the largest of all previous
    # offset values.
    stop_offset = ak.max_f32(stop_offset, captures.largest_offset)
    captures.largest_offset = stop_offset

    let stop_color = svg_stop_element_stop_color(stop)
    display_list.svg_gradient_paint_style_add_color_stop_f32(captures.paint_style, stop_offset, gfx.color_with_opacity(&stop_color, svg_stop_element_stop_opacity(stop)))

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:112 Web::SVG::SVGGradientElement::add_color_stops.
pub func svg_gradient_element_add_color_stops(this: SvgGradientElement*, paint_style: display_list.SvgGradientPaintStyle*):
    var captures = SvgGradientElementAddColorStopsCaptures(paint_style = paint_style, largest_offset = 0.0)
    svg_gradient_element_for_each_color_stop(this, svg_gradient_element_add_color_stop, &captures)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:132 Web::SVG::SVGGradientElement::linked_gradient.
pub func svg_gradient_element_linked_gradient(this: SvgGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgGradientElement*?:
    # FIXME: This entire function is an ad-hoc hack!
    # It can only resolve #<ids> in the same document.

    let element_this = this.dom_element()
    let link = dom_element_get_attribute(element_this, svg_attribute_names_href) if dom_element_has_attribute(element_this, svg_attribute_names_href) else dom_element_get_attribute(element_this, ak.fly_string_from_str("xlink:href"))
    if let href = link:
        if ak.string_is_empty(&href):
            return none
        let document = dom_node_document(this.dom_node())
        let url = dom_document_encoding_parse_url(document, ak.string_bytes_as_string_view(&href)) else return none
        let id = web_url.url_fragment(&url) else return none
        if ak.string_is_empty(&id):
            return none
        let element = dom_parent_node_get_element_by_id(document.dom_parent_node(), ak.fly_string_from_string(id)) else return none
        if element.dom_node() == this.dom_node():
            return none
        let gradient = as_if_svg_gradient_element(element) else return none
        if ak.hash_table_set(seen_gradients, gradient) != ak.HashSetResult.inserted_new_entry:
            return none
        return gradient
    return none

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:159 Web::SVG::SVGGradientElement::initialize (override).
pub func svg_gradient_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_gradient_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.cpp:165 Web::SVG::SVGGradientElement::visit_edges (override).
pub func svg_gradient_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgGradientElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_svguri_reference_mixin_visit_edges(&this.svguri_reference_mixin, visitor)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.h:48 Web::SVG::SVGGradientElement::to_gfx_paint_style (pure virtual).
pub func svg_gradient_element_to_gfx_paint_style_impl(this: SvgGradientElement*, arg0: SvgPaintContext) -> display_list.SvgPaintServerPaintStyle*?:
    trap("pure virtual: Web::SVG::SVGGradientElement::to_gfx_paint_style")

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.h:69 Web::SVG::SVGGradientElement::for_each_color_stop.
pub func svg_gradient_element_for_each_color_stop(this: SvgGradientElement*, callback: func(void*, SvgStopElement*) -> unit, context: void*):
    var seen_gradients: SvgGradientElementSet
    svg_gradient_element_for_each_color_stop_impl(this, callback, context, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGGradientElement.h:79 Web::SVG::SVGGradientElement::for_each_color_stop_impl.
func svg_gradient_element_for_each_color_stop_impl(this: SvgGradientElement*, callback: func(void*, SvgStopElement*) -> unit, context: void*, seen_gradients: SvgGradientElementSet*):
    var color_stops_found = false
    # for_each_child_of_type<SVG::SVGStopElement>(...)
    for child in dom_node_children(this.dom_node()):
        if let stop = as_if_svg_stop_element(child):
            color_stops_found = true
            callback(context, stop)
    if not color_stops_found:
        if let gradient = svg_gradient_element_linked_gradient(this, seen_gradients):
            svg_gradient_element_for_each_color_stop_impl(gradient, callback, context, seen_gradients)
