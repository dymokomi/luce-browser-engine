#==============================================================================================
#
#   svg_filter_primitive_standard_attributes - SVG::SVGFilterPrimitiveStandardAttributes
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp (lines 1-62) with its
#       header's inline members (https://drafts.fxtf.org/filter-effects/#InterfaceSVGFilterPrimitiveStandardAttributes):
#       the x, y, width, height and result attributes every filter primitive (feBlend, ...)
#       shares. The CRTP mixin's `this_svg_element()` (the `static_cast<IncludingClass*>(this)`
#       pointer adjustment) is the element the caller passes, as for SVGURIReferenceMixin: a
#       generic body cannot ask TIncludingClass for the mixin's offset.
#
#       The filter primitive elements' `SVGAnimatedString::create(realm(), *this,
#       DOM::QualifiedName { name, {}, {} })` and the matching SVGAnimatedNumber creation are
#       spelled with the two helpers at the top.
#
#==============================================================================================

## `SVGAnimatedString::create(realm(), *this, DOM::QualifiedName { attribute, OptionalNone {}, OptionalNone {} })`.
func svg_animated_string_for_attribute(element: SvgElement*, attribute: ak.FlyString) -> SvgAnimatedString*:
    var reflected_attribute: DomQualifiedName = ---
    dom_qualified_name_construct(&reflected_attribute, attribute, none, none)
    return svg_animated_string_create(dom_element_realm(element.dom_element()), element, reflected_attribute)

## `SVGAnimatedNumber::create(realm(), *this, DOM::QualifiedName { attribute, OptionalNone {}, OptionalNone {} }, initial_value, ...)`.
func svg_animated_number_for_attribute(element: SvgElement*, attribute: ak.FlyString, initial_value: f32, supports_second_value: SvgAnimatedNumberSupportsSecondValue = SvgAnimatedNumberSupportsSecondValue.no, value_represented: SvgAnimatedNumberValueRepresented = SvgAnimatedNumberValueRepresented.first) -> SvgAnimatedNumber*:
    var reflected_attribute: DomQualifiedName = ---
    dom_qualified_name_construct(&reflected_attribute, attribute, none, none)
    return svg_animated_number_create(dom_element_realm(element.dom_element()), element, reflected_attribute, initial_value, supports_second_value, value_represented)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp:27 Web::SVG::SVGFilterPrimitiveStandardAttributes::x.
pub func svg_filter_primitive_standard_attributes_x[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgAnimatedLength*:
    return svg_element_svg_animated_length_for_property(svg_filter_primitive_standard_attributes_this_svg_element(this, element), css_data.PropertyId.x)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp:33 Web::SVG::SVGFilterPrimitiveStandardAttributes::y.
pub func svg_filter_primitive_standard_attributes_y[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgAnimatedLength*:
    return svg_element_svg_animated_length_for_property(svg_filter_primitive_standard_attributes_this_svg_element(this, element), css_data.PropertyId.y)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp:39 Web::SVG::SVGFilterPrimitiveStandardAttributes::width.
pub func svg_filter_primitive_standard_attributes_width[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgAnimatedLength*:
    return svg_element_svg_animated_length_for_property(svg_filter_primitive_standard_attributes_this_svg_element(this, element), css_data.PropertyId.width)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp:45 Web::SVG::SVGFilterPrimitiveStandardAttributes::height.
pub func svg_filter_primitive_standard_attributes_height[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgAnimatedLength*:
    return svg_element_svg_animated_length_for_property(svg_filter_primitive_standard_attributes_this_svg_element(this, element), css_data.PropertyId.height)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.cpp:51 Web::SVG::SVGFilterPrimitiveStandardAttributes::result.
pub func svg_filter_primitive_standard_attributes_result[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgAnimatedString*:
    if this.m_result_animated_string == none:
        this.m_result_animated_string = svg_animated_string_for_attribute(svg_filter_primitive_standard_attributes_this_svg_element(this, element), svg_attribute_names_result)

    return this.m_result_animated_string else trap("VERIFY: m_result_animated_string")

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.h:26 Web::SVG::SVGFilterPrimitiveStandardAttributes::visit_edges.
pub func svg_filter_primitive_standard_attributes_visit_edges[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_t(visitor, this.m_result_animated_string)

## Ported from Libraries/LibWeb/SVG/SVGFilterPrimitiveStandardAttributes.h:32 Web::SVG::SVGFilterPrimitiveStandardAttributes::this_svg_element.
func svg_filter_primitive_standard_attributes_this_svg_element[TIncludingClass](this: SvgFilterPrimitiveStandardAttributes[TIncludingClass]*, element: SvgElement*) -> SvgElement*:
    # static_cast<IncludingClass*>(this): the element that includes this mixin, which the caller passes.
    return element
