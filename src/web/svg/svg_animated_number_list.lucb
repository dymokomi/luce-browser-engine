## Ported from Libraries/LibWeb/SVG/SVGAnimatedNumberList.h:27 Web::SVG::SVGAnimatedNumberList::anim_val.
pub func svg_animated_number_list_anim_val(this: SvgAnimatedNumberList*) -> SvgNumberList*:
