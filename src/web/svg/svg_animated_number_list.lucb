## Ported from Libraries/LibWeb/SVG/SVGAnimatedNumberList.cpp:15 Web::SVG::SVGAnimatedNumberList::create.
pub func svg_animated_number_list_create(realm: Realm*, base_val: SvgNumberList*) -> SvgAnimatedNumberList*:
    return realm_create_svg_animated_number_list(realm, realm, base_val)

## Ported from Libraries/LibWeb/SVG/SVGAnimatedNumberList.cpp:20 Web::SVG::SVGAnimatedNumberList::SVGAnimatedNumberList.
pub func svg_animated_number_list_construct(this: SvgAnimatedNumberList*, realm: Realm*, base_val: SvgNumberList*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_base_val = base_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedNumberList.h:24 Web::SVG::SVGAnimatedNumberList::base_val.
pub func svg_animated_number_list_base_val(this: SvgAnimatedNumberList*) -> SvgNumberList*:
