#==============================================================================================
#
#   svgfe_gaussian_blur_element - SVG::SVGFEGaussianBlurElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEGaussianBlurElement.cpp (lines 1-71) with the inline members of SVGFEGaussianBlurElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feGaussianBlurElement): in, the two
#       stdDeviation components and edgeMode (FIXME: unresolved in the donor).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:17 Web::SVG::SVGFEGaussianBlurElement::SVGFEGaussianBlurElement.
pub func svg_svgfe_gaussian_blur_element_construct(this: SvgSvgfeGaussianBlurElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEGaussianBlurElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_gaussian_blur_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_gaussian_blur_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_gaussian_blur_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_gaussian_blur_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:22 Web::SVG::SVGFEGaussianBlurElement::initialize (override).
pub func svg_svgfe_gaussian_blur_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_gaussian_blur_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:28 Web::SVG::SVGFEGaussianBlurElement::visit_edges (override).
pub func svg_svgfe_gaussian_blur_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeGaussianBlurElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)
    gc.cell_visitor_visit_t(visitor, this.m_std_deviation_x)
    gc.cell_visitor_visit_t(visitor, this.m_std_deviation_y)

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:37 Web::SVG::SVGFEGaussianBlurElement::in1.
pub func svg_svgfe_gaussian_blur_element_in1(this: SvgSvgfeGaussianBlurElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:46 Web::SVG::SVGFEGaussianBlurElement::std_deviation_x.
# https://drafts.fxtf.org/filter-effects/#element-attrdef-fegaussianblur-stddeviation
pub func svg_svgfe_gaussian_blur_element_std_deviation_x(this: SvgSvgfeGaussianBlurElement*) -> SvgAnimatedNumber*:
    if this.m_std_deviation_x == none:
        this.m_std_deviation_x = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_std_deviation, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.first)

    return this.m_std_deviation_x else trap("VERIFY: m_std_deviation_x")

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:56 Web::SVG::SVGFEGaussianBlurElement::std_deviation_y.
# https://drafts.fxtf.org/filter-effects/#element-attrdef-fegaussianblur-stddeviation
pub func svg_svgfe_gaussian_blur_element_std_deviation_y(this: SvgSvgfeGaussianBlurElement*) -> SvgAnimatedNumber*:
    if this.m_std_deviation_y == none:
        this.m_std_deviation_y = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_std_deviation, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.second)

    return this.m_std_deviation_y else trap("VERIFY: m_std_deviation_y")

## Ported from Libraries/LibWeb/SVG/SVGFEGaussianBlurElement.cpp:65 Web::SVG::SVGFEGaussianBlurElement::edge_mode.
pub func svg_svgfe_gaussian_blur_element_edge_mode(this: SvgSvgfeGaussianBlurElement*) -> SvgAnimatedEnumeration*:
    # FIXME: Resolve the actual value from AttributeNames::edgeMode.
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), 0)
