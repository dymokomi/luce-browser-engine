## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:140 Web::SVG::SVGTextPositioningElement::rotate.
# https://svgwg.org/svg2-draft/text.html#__svg__SVGTextPositioningElement__rotate
pub func svg_text_positioning_element_rotate(this: SvgTextPositioningElement*) -> SvgAnimatedNumberList*:
    if this.m_rotate == none:
        # FIXME: This only handles single values, not lists.
        var value: f32 = 0.0
        let attribute_value = dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_rotate)
        if let number_percentage = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&attribute_value)):
            if not svg_number_percentage_is_percentage(&number_percentage):
                value = svg_number_percentage_value(&number_percentage)

        let realm = dom_element_realm(this.dom_element())
        let number = svg_number_create(realm, value, SvgNumberReadOnly.yes)
        var items: ak.Vector[SvgNumber*]
        ak.vector_append_t(&items, number)
        let number_list = svg_number_list_create_vector(realm, items, SvgReadOnlyList.yes)
        this.m_rotate = svg_animated_number_list_create(realm, number_list)
    return this.m_rotate else trap("VERIFY: m_rotate")
