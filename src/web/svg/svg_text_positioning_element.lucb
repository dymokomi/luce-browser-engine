#==============================================================================================
#
#   svg_text_positioning_element - SVG::SVGTextPositioningElement: x, y, dx, dy and rotate
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGTextPositioningElement.cpp (lines 1-157) with the inline
#       TextPositioning::apply_to_text_position of SVGTextPositioningElement.h
#       (https://svgwg.org/svg2-draft/text.html#TSpanAttributes): the positioning attributes
#       resolved as CSS lengths, percentages or numbers (single values only, as the donor), and
#       the SVGAnimatedLengthList / SVGAnimatedNumberList reflections, made on first use and
#       dropped when their attribute changes.
#
#==============================================================================================

# mark: TextPositioning ==========================================================================

## apply_to_text_position's `value_for_character` lambda: the value for the character at
## `character_index` (the last value past the end), a length-percentage resolved against the
## viewport's width for x and dx (`&values == &x || &values == &dx`) and its height otherwise.
func svg_text_positioning_value_for_character(this: const SvgTextPositioning*, values: const ak.Vector[SvgTextPositioningPosition]*, node: LayoutNode*, viewport: gfx.CssPixelSize, character_index: usize) -> f32:
    if ak.vector_is_empty(values):
        return 0.0

    let position = *ak.vector_at_const(values, character_index) if character_index < ak.vector_size(values) else *ak.vector_last_const(values)
    match position:
        .number(number):
            return (f32)css_syntax.number_value(&number)
        .css_length_percentage(length_percentage):
            let reference = viewport.m_width if (values == &this.x or values == &this.dx) else viewport.m_height
            return css_percentage_or_to_px(&length_percentage.percentage_or, node, reference).to_float()

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.h:26 Web::SVG::TextPositioning::apply_to_text_position.
pub func svg_text_positioning_apply_to_text_position(this: const SvgTextPositioning*, node: LayoutNode*, viewport: gfx.CssPixelSize, current_text_position: gfx.FloatPoint*, character_index: usize):
    if not ak.vector_is_empty(&this.x):
        gfx.float_point_set_x(current_text_position, svg_text_positioning_value_for_character(this, &this.x, node, viewport, character_index))
    if not ak.vector_is_empty(&this.y):
        gfx.float_point_set_y(current_text_position, svg_text_positioning_value_for_character(this, &this.y, node, viewport, character_index))

    let dx = svg_text_positioning_value_for_character(this, &this.dx, node, viewport, character_index)
    let dy = svg_text_positioning_value_for_character(this, &this.dy, node, viewport, character_index)
    gfx.float_point_translate_by_f32_f32(current_text_position, dx, dy)

# mark: SVGTextPositioningElement ================================================================

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:28 Web::SVG::SVGTextPositioningElement::SVGTextPositioningElement.
pub func svg_text_positioning_element_construct(this: SvgTextPositioningElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_text_content_element_construct(this.svg_text_content_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGTextPositioningElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_text_positioning_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_text_positioning_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_text_positioning_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_text_positioning_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:33 Web::SVG::SVGTextPositioningElement::initialize (override).
pub func svg_text_positioning_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_text_positioning_element)
    svg_text_content_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:39 Web::SVG::SVGTextPositioningElement::visit_edges (override).
pub func svg_text_positioning_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgTextPositioningElement*)base
    svg_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_x)
    gc.cell_visitor_visit_t(visitor, this.m_y)
    gc.cell_visitor_visit_t(visitor, this.m_dx)
    gc.cell_visitor_visit_t(visitor, this.m_dy)
    gc.cell_visitor_visit_t(visitor, this.m_rotate)

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:49 Web::SVG::SVGTextPositioningElement::attribute_changed (override).
pub func svg_text_positioning_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgTextPositioningElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x):
        this.m_x = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y):
        this.m_y = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_dx):
        this.m_dx = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_dy):
        this.m_dy = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_rotate):
        this.m_rotate = none

## text_positioning's `resolve_value` lambda.
# FIXME: This only handles single values, not lists.
func svg_text_positioning_element_resolve_value(this: SvgTextPositioningElement*, parsing_params: CssParsingParams, attribute: ak.FlyString) -> ak.Vector[SvgTextPositioningPosition]:
    var result: ak.Vector[SvgTextPositioningPosition]
    let raw_value = dom_element_get_attribute_value(this.dom_element(), attribute)

    var style_value = parse_css_type(parsing_params, ak.string_bytes_as_string_view(&raw_value), CssValueType.length_percentage)
    if let length_style_value = style_value:
        if is_css_length_style_value(length_style_value):
            ak.vector_append_t(&result, SvgTextPositioningPosition.css_length_percentage(css_length_percentage_from_style_value(length_style_value)))
            return result

    if let percentage_style_value = style_value:
        if is_css_percentage_style_value(percentage_style_value):
            ak.vector_append_t(&result, SvgTextPositioningPosition.css_length_percentage(css_length_percentage_from_style_value(percentage_style_value)))
            return result

    style_value = parse_css_type(parsing_params, ak.string_bytes_as_string_view(&raw_value), CssValueType.number)
    if let number_style_value = style_value:
        if let number = as_if_css_number_style_value(number_style_value):
            ak.vector_append_t(&result, SvgTextPositioningPosition.number(css_syntax.number_create(css_syntax.NumberType.number, css_number_style_value_number(number))))
            return result

    return result

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:65 Web::SVG::SVGTextPositioningElement::text_positioning.
pub func svg_text_positioning_element_text_positioning(this: SvgTextPositioningElement*) -> SvgTextPositioning:
    var parsing_params: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&parsing_params, dom_node_document(this.dom_node()))

    # https://svgwg.org/svg2-draft/text.html#TSpanAttributes
    # FIXME: This only handles single values, not lists.

    # FIXME: Implement support for the rotate attribute.
    return SvgTextPositioning(
        x = svg_text_positioning_element_resolve_value(this, parsing_params, svg_attribute_names_x),
        y = svg_text_positioning_element_resolve_value(this, parsing_params, svg_attribute_names_y),
        dx = svg_text_positioning_element_resolve_value(this, parsing_params, svg_attribute_names_dx),
        dy = svg_text_positioning_element_resolve_value(this, parsing_params, svg_attribute_names_dy),
        rotate = ak.Vector[f32](),
    )

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:98 Web::SVG::SVGTextPositioningElement::ensure_length_list.
func svg_text_positioning_element_ensure_length_list(this: SvgTextPositioningElement*, list: (SvgAnimatedLengthList*?)*, attribute_name: ak.FlyString) -> SvgAnimatedLengthList*:
    if *list == none:
        # FIXME: This only handles single values, not lists.
        var value: f32 = 0.0
        let attribute_value = dom_element_get_attribute_value(this.dom_element(), attribute_name)
        if let number_percentage = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&attribute_value)):
            value = svg_number_percentage_value(&number_percentage)

        let realm = dom_element_realm(this.dom_element())
        let length = svg_length_create(realm, (u8)svg_length_svg_lengthtype_number, value, SvgLengthReadOnly.yes)
        var items: ak.Vector[SvgLength*]
        ak.vector_append_t(&items, length)
        let length_list = svg_length_list_create_vector(realm, items, SvgReadOnlyList.yes)
        *list = svg_animated_length_list_create(realm, length_list)
    return *list else trap("VERIFY: list")

## Ported from Libraries/LibWeb/SVG/SVGTextPositioningElement.cpp:116 Web::SVG::SVGTextPositioningElement::x.
# https://svgwg.org/svg2-draft/text.html#__svg__SVGTextPositioningElement__x
pub func svg_text_positioning_element_x(this: SvgTextPositioningElement*) -> SvgAnimatedLengthList*:
    return svg_text_positioning_element_ensure_length_list(this, &this.m_x, svg_attribute_names_x)

