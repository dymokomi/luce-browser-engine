#==============================================================================================
#
#   attribute_names - SVG::AttributeNames: the names of the SVG attributes
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/SVG/AttributeNames.cpp (lines 1-16) with AttributeNames.h's
#       ENUMERATE_SVG_ATTRIBUTES. C++ initializes the FlyStrings statically; here
#       svg_attribute_names_initialize_strings interns them at run time and
#       web_initialize_strings runs it at startup (DESIGN.md §2.6).
#
#==============================================================================================

## Whether svg_attribute_names_initialize_strings has run.
var svg_attribute_names_strings_initialized: bool

## Ported from Libraries/LibWeb/SVG/AttributeNames.cpp:11 the definitions of Web::SVG::AttributeNames's FlyStrings
## (`FlyString name = attribute##_fly_string;` for each ENUMERATE_SVG_ATTRIBUTES entry).
pub func svg_attribute_names_initialize_strings():
    if svg_attribute_names_strings_initialized:
        return
    svg_attribute_names_amplitude = ak.fly_string_from_str("amplitude")
    svg_attribute_names_attribute_name = ak.fly_string_from_str("attributeName")
    svg_attribute_names_attribute_type = ak.fly_string_from_str("attributeType")
