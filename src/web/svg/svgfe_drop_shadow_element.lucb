# https://drafts.csswg.org/filter-effects-1/#dom-svgfedropshadowelement-dy
# https://drafts.csswg.org/filter-effects-1/#element-attrdef-fedropshadow-dy
pub func svg_svgfe_drop_shadow_element_dy(this: SvgSvgfeDropShadowElement*) -> SvgAnimatedNumber*:
    # Corresponds to attribute dy on the given feDropShadow element.
    # The initial value for dy is 2.
    if this.m_dy == none:
        this.m_dy = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_dy, 2.0)

    return this.m_dy else trap("VERIFY: m_dy")

## Ported from Libraries/LibWeb/SVG/SVGFEDropShadowElement.cpp:84 Web::SVG::SVGFEDropShadowElement::std_deviation_x.
# https://drafts.csswg.org/filter-effects-1/#dom-svgfedropshadowelement-stddeviationx
# https://drafts.csswg.org/filter-effects-1/#element-attrdef-fedropshadow-stddeviation
pub func svg_svgfe_drop_shadow_element_std_deviation_x(this: SvgSvgfeDropShadowElement*) -> SvgAnimatedNumber*:
    # Corresponds to attribute stdDeviation on the given feDropShadow element. Contains the X component of attribute stdDeviation.
    # The initial value for stdDeviation is 2.
    if this.m_std_deviation_x == none:
        this.m_std_deviation_x = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_std_deviation, 2.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.first)

    return this.m_std_deviation_x else trap("VERIFY: m_std_deviation_x")

## Ported from Libraries/LibWeb/SVG/SVGFEDropShadowElement.cpp:97 Web::SVG::SVGFEDropShadowElement::std_deviation_y.
# https://drafts.csswg.org/filter-effects-1/#dom-svgfedropshadowelement-stddeviationy
# https://drafts.csswg.org/filter-effects-1/#element-attrdef-fedropshadow-stddeviation
pub func svg_svgfe_drop_shadow_element_std_deviation_y(this: SvgSvgfeDropShadowElement*) -> SvgAnimatedNumber*:
    # Corresponds to attribute stdDeviation on the given feDropShadow element. Contains the Y component of attribute stdDeviation.
    # The initial value for stdDeviation is 2.
    if this.m_std_deviation_y == none:
        this.m_std_deviation_y = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_std_deviation, 2.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.second)

    return this.m_std_deviation_y else trap("VERIFY: m_std_deviation_y")

## Ported from Libraries/LibWeb/SVG/SVGFEDropShadowElement.cpp:108 Web::SVG::SVGFEDropShadowElement::set_std_deviation.
# https://drafts.csswg.org/filter-effects-1/#dom-svgfedropshadowelement-setstddeviation
pub func svg_svgfe_drop_shadow_element_set_std_deviation(this: SvgSvgfeDropShadowElement*, std_deviation_x: f32, std_deviation_y: f32):
    # Sets the values for attribute stdDeviation.
    #
    # stdDeviationX
    #     The X component of attribute stdDeviation.
    #
    # stdDeviationY
    #     The Y component of attribute stdDeviation.
    # MUST(String::formatted("{} {}", std_deviation_x, std_deviation_y)): AK's float formatting.
    var builder = ak.string_builder_new()
    ak.format_f32(&builder, std_deviation_x)
    ak.string_builder_append(&builder, " ")
    ak.format_f32(&builder, std_deviation_y)
    let value = ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")
    dom_element_set_attribute_value(this.dom_element(), svg_attribute_names_std_deviation, value)
