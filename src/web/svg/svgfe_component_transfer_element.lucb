#==============================================================================================
#
#   svgfe_component_transfer_element - SVG::SVGFEComponentTransferElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEComponentTransferElement.cpp (lines 1-38) with the inline members of SVGFEComponentTransferElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feComponentTransferElement): in (the transfer
#       functions are its feFuncR/G/B/A children).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEComponentTransferElement.cpp:14 Web::SVG::SVGFEComponentTransferElement::SVGFEComponentTransferElement.
pub func svg_svgfe_component_transfer_element_construct(this: SvgSvgfeComponentTransferElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEComponentTransferElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_component_transfer_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_component_transfer_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_component_transfer_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_component_transfer_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEComponentTransferElement.cpp:19 Web::SVG::SVGFEComponentTransferElement::initialize (override).
pub func svg_svgfe_component_transfer_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_component_transfer_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEComponentTransferElement.cpp:25 Web::SVG::SVGFEComponentTransferElement::visit_edges (override).
pub func svg_svgfe_component_transfer_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeComponentTransferElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)

## Ported from Libraries/LibWeb/SVG/SVGFEComponentTransferElement.cpp:32 Web::SVG::SVGFEComponentTransferElement::in1.
pub func svg_svgfe_component_transfer_element_in1(this: SvgSvgfeComponentTransferElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")
