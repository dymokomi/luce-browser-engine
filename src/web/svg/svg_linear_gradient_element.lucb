## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:115 Web::SVG::SVGLinearGradientElement::to_gfx_paint_style (override).
pub func svg_linear_gradient_element_to_gfx_paint_style_impl(base: SvgGradientElement*, paint_context: SvgPaintContext) -> display_list.SvgPaintServerPaintStyle*?:
    let this = (SvgLinearGradientElement*)base
    var start_point: gfx.FloatPoint
    var end_point: gfx.FloatPoint

    # https://svgwg.org/svg2-draft/pservers.html#LinearGradientElementGradientUnitsAttribute
    if svg_gradient_element_gradient_units(base) == SvgUnits.object_bounding_box:
        # If gradientUnits="objectBoundingBox", the user coordinate system for attributes ‘x1’, ‘y1’, ‘x2’ and ‘y2’
        # is established using the bounding box of the element to which the gradient is applied (see Object bounding
        # box units) and then applying the transform specified by attribute ‘gradientTransform’. Percentages represent
        # values relative to the bounding box for the object.
        # Note: For gradientUnits="objectBoundingBox" both "100%" and "1" are treated the same.
        let bounding_box = &paint_context.path_bounding_box
        let location = gfx.float_rect_location(bounding_box)
        let start_x = svg_linear_gradient_element_start_x(this)
        let start_y = svg_linear_gradient_element_start_y(this)
        start_point = gfx.FloatPoint(
            m_x = location.m_x + svg_number_percentage_value(&start_x) * gfx.float_rect_width(bounding_box),
            m_y = location.m_y + svg_number_percentage_value(&start_y) * gfx.float_rect_height(bounding_box),
        )
        let end_x = svg_linear_gradient_element_end_x(this)
        let end_y = svg_linear_gradient_element_end_y(this)
        end_point = gfx.FloatPoint(
            m_x = location.m_x + svg_number_percentage_value(&end_x) * gfx.float_rect_width(bounding_box),
            m_y = location.m_y + svg_number_percentage_value(&end_y) * gfx.float_rect_height(bounding_box),
        )
    else:
        # GradientUnits::UserSpaceOnUse
        # If gradientUnits="userSpaceOnUse", ‘x1’, ‘y1’, ‘x2’, and ‘y2’ represent values in the coordinate system
        # that results from taking the current user coordinate system in place at the time when the gradient element
        # is referenced (i.e., the user coordinate system for the element referencing the gradient element via a
        # fill or stroke property) and then applying the transform specified by attribute ‘gradientTransform’.
        # Percentages represent values relative to the current SVG viewport.
        let start_x = svg_linear_gradient_element_start_x(this)
        let start_y = svg_linear_gradient_element_start_y(this)
        start_point = gfx.FloatPoint(
            m_x = svg_number_percentage_resolve_relative_to(&start_x, gfx.float_rect_width(&paint_context.viewport)),
            m_y = svg_number_percentage_resolve_relative_to(&start_y, gfx.float_rect_height(&paint_context.viewport)),
        )
        let end_x = svg_linear_gradient_element_end_x(this)
        let end_y = svg_linear_gradient_element_end_y(this)
        end_point = gfx.FloatPoint(
            m_x = svg_number_percentage_resolve_relative_to(&end_x, gfx.float_rect_width(&paint_context.viewport)),
            m_y = svg_number_percentage_resolve_relative_to(&end_y, gfx.float_rect_height(&paint_context.viewport)),
        )

    if this.m_paint_style == none:
        let created = display_list.svg_linear_gradient_paint_style_create(start_point, end_point)
        this.m_paint_style = created
        # FIXME: Update stops in DOM changes:
        svg_gradient_element_add_color_stops(base, (display_list.SvgGradientPaintStyle*)created)
    else:
        let existing = this.m_paint_style else trap("VERIFY: m_paint_style")
        display_list.svg_linear_gradient_paint_style_set_start_point(existing, start_point)
        display_list.svg_linear_gradient_paint_style_set_end_point(existing, end_point)

    # (the display list's upcasts are private to it: an embedded base is first, so a cast is the upcast)
    let paint_style = this.m_paint_style else trap("VERIFY: m_paint_style")
    display_list.svg_gradient_paint_style_set_gradient_transform((display_list.SvgGradientPaintStyle*)paint_style, svg_gradient_element_gradient_paint_transform(base, paint_context))
    display_list.svg_gradient_paint_style_set_spread_method((display_list.SvgGradientPaintStyle*)paint_style, svg_to_painting_spread_method(svg_gradient_element_spread_method(base)))
    display_list.svg_gradient_paint_style_set_color_space((display_list.SvgGradientPaintStyle*)paint_style, svg_gradient_element_color_space(base))
    return (display_list.SvgPaintServerPaintStyle*)paint_style

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:168 Web::SVG::SVGLinearGradientElement::x1.
pub func svg_linear_gradient_element_x1(this: SvgLinearGradientElement*) -> SvgAnimatedLength*:
    return svg_element_fake_animated_length_fixme(this.svg_element())

