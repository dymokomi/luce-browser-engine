## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.h:37 Web::SVG::SVGLinearGradientElement::linked_linear_gradient.
func svg_linear_gradient_element_linked_linear_gradient(this: SvgLinearGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgLinearGradientElement*?:
    if let gradient = svg_gradient_element_linked_gradient(this.svg_gradient_element(), seen_gradients):
        if is_svg_linear_gradient_element(gradient):
            return as_svg_linear_gradient_element(gradient)
    return none
