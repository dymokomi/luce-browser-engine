## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:88 Web::SVG::SVGLinearGradientElement::end_x_impl.
func svg_linear_gradient_element_end_x_impl(this: SvgLinearGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    if let x2 = this.m_x2:
        return x2
    if let gradient = svg_linear_gradient_element_linked_linear_gradient(this, seen_gradients):
        return svg_linear_gradient_element_end_x_impl(gradient, seen_gradients)
    # If the attribute is not specified, the effect is as if a value of '100%' were specified.
    return svg_number_percentage_create_percentage(100.0)

