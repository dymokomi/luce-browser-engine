#==============================================================================================
#
#   svg_linear_gradient_element - SVG::SVGLinearGradientElement: <linearGradient>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGLinearGradientElement.cpp (lines 1-188) with the inline members
#       of SVGLinearGradientElement.h: x1, y1, x2 and y2 (number-percentages, inherited through
#       the href chain of linked linear gradients) and the linear gradient paint style
#       (https://svgwg.org/svg2-draft/pservers.html#LinearGradients).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:20 Web::SVG::SVGLinearGradientElement::SVGLinearGradientElement.
pub func svg_linear_gradient_element_construct(this: SvgLinearGradientElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_gradient_element_construct(this.svg_gradient_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGLinearGradientElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_linear_gradient_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_linear_gradient_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_linear_gradient_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_linear_gradient_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:25 Web::SVG::SVGLinearGradientElement::initialize (override).
pub func svg_linear_gradient_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_linear_gradient_element)
    svg_gradient_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:31 Web::SVG::SVGLinearGradientElement::attribute_changed (override).
pub func svg_linear_gradient_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgLinearGradientElement*)base
    svg_gradient_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    # FIXME: Should allow for `<number-percentage> | <length>` for x1, x2, y1, y2
    let value_text = value else ak.String()  # value.value_or(String {})
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x1):
        this.m_x1 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y1):
        this.m_y1 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x2):
        this.m_x2 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y2):
        this.m_y2 = svg_attribute_parser_parse_number_percentage(ak.string_bytes_as_string_view(&value_text))

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:48 Web::SVG::SVGLinearGradientElement::start_x.
# https://www.w3.org/TR/SVG11/pservers.html#LinearGradientElementX1Attribute
pub func svg_linear_gradient_element_start_x(this: SvgLinearGradientElement*) -> SvgNumberPercentage:
    var seen_gradients: SvgGradientElementSet
    return svg_linear_gradient_element_start_x_impl(this, &seen_gradients)

## Ported from Libraries/LibWeb/SVG/SVGLinearGradientElement.cpp:54 Web::SVG::SVGLinearGradientElement::start_x_impl.
func svg_linear_gradient_element_start_x_impl(this: SvgLinearGradientElement*, seen_gradients: SvgGradientElementSet*) -> SvgNumberPercentage:
    if let x1 = this.m_x1:
        return x1
    if let gradient = svg_linear_gradient_element_linked_linear_gradient(this, seen_gradients):
        return svg_linear_gradient_element_start_x_impl(gradient, seen_gradients)
    # If the attribute is not specified, the effect is as if a value of '0%' were specified.
    return svg_number_percentage_create_percentage(0.0)

