#==============================================================================================
#
#   svg_g_element - SVG::SVGGElement: <g>, a group of graphics
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGGElement.cpp with the inline members of SVGGElement.h: its layout box is an SVGGraphicsBox.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGGElement.cpp:18 Web::SVG::SVGGElement::SVGGElement.
pub func svg_svgg_element_construct(this: SvgSvggElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGGElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgg_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgg_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgg_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgg_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGGElement.cpp:23 Web::SVG::SVGGElement::initialize (override).
pub func svg_svgg_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgg_element)
    svg_graphics_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGGElement.cpp:29 Web::SVG::SVGGElement::create_layout_node (override).
pub func svg_svgg_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgSvggElement*)base
    # heap().allocate<Layout::SVGGraphicsBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_svg_graphics_box(dom_element_realm(base), dom_node_document(base.dom_node()), this.svg_graphics_element(), style).layout_node()

## Ported from Libraries/LibWeb/SVG/SVGGElement.h:23 Web::SVG::SVGGElement::is_svg_g_element (override).
pub func svg_svgg_element_is_svg_g_element_impl(base: DomNode*) -> bool:
    return true
