#==============================================================================================
#
#   svgfe_displacement_map_element - SVG::SVGFEDisplacementMapElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEDisplacementMapElement.cpp (lines 1-101) with the inline members of SVGFEDisplacementMapElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feDisplacementMapElement): in, in2, scale
#       and the x/y channel selectors.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:17 Web::SVG::SVGFEDisplacementMapElement::SVGFEDisplacementMapElement.
pub func svg_svgfe_displacement_map_element_construct(this: SvgSvgfeDisplacementMapElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEDisplacementMapElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_displacement_map_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_displacement_map_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_displacement_map_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_displacement_map_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:22 Web::SVG::SVGFEDisplacementMapElement::initialize (override).
pub func svg_svgfe_displacement_map_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_displacement_map_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:28 Web::SVG::SVGFEDisplacementMapElement::visit_edges (override).
pub func svg_svgfe_displacement_map_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeDisplacementMapElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)
    gc.cell_visitor_visit_t(visitor, this.m_in2)
    gc.cell_visitor_visit_t(visitor, this.m_scale)
    gc.cell_visitor_visit_t(visitor, this.m_x_channel_selector)
    gc.cell_visitor_visit_t(visitor, this.m_y_channel_selector)

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:40 Web::SVG::SVGFEDisplacementMapElement::in1.
# https://drafts.csswg.org/filter-effects/#dom-svgfedisplacementmapelement-in1
pub func svg_svgfe_displacement_map_element_in1(this: SvgSvgfeDisplacementMapElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:49 Web::SVG::SVGFEDisplacementMapElement::in2.
# https://drafts.csswg.org/filter-effects/#dom-svgfedisplacementmapelement-in2
pub func svg_svgfe_displacement_map_element_in2(this: SvgSvgfeDisplacementMapElement*) -> SvgAnimatedString*:
    if this.m_in2 == none:
        this.m_in2 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in2)

    return this.m_in2 else trap("VERIFY: m_in2")

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:58 Web::SVG::SVGFEDisplacementMapElement::scale.
# https://drafts.csswg.org/filter-effects/#dom-svgfedisplacementmapelement-scale
pub func svg_svgfe_displacement_map_element_scale(this: SvgSvgfeDisplacementMapElement*) -> SvgAnimatedNumber*:
    if this.m_scale == none:
        this.m_scale = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_scale, 0.0)

    return this.m_scale else trap("VERIFY: m_scale")

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:67 Web::SVG::parse_channel_selector.
# https://drafts.csswg.org/filter-effects/#element-attrdef-fedisplacementmap-xchannelselector
func svg_parse_channel_selector(value: ak.String) -> SvgSvgfeDisplacementMapElementChannelSelector:
    let view = ak.string_bytes_as_string_view(&value)
    if ak.string_view_equals(&view, "R"):
        return SvgSvgfeDisplacementMapElementChannelSelector.red

    if ak.string_view_equals(&view, "G"):
        return SvgSvgfeDisplacementMapElementChannelSelector.green

    if ak.string_view_equals(&view, "B"):
        return SvgSvgfeDisplacementMapElementChannelSelector.blue

    if ak.string_view_equals(&view, "A"):
        return SvgSvgfeDisplacementMapElementChannelSelector.alpha

    return SvgSvgfeDisplacementMapElementChannelSelector.alpha

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:85 Web::SVG::SVGFEDisplacementMapElement::x_channel_selector.
# https://drafts.csswg.org/filter-effects/#dom-svgfedisplacementmapelement-xchannelselector
pub func svg_svgfe_displacement_map_element_x_channel_selector(this: SvgSvgfeDisplacementMapElement*) -> SvgAnimatedEnumeration*:
    # FIXME: Support reflection, don't return a new object every time.
    let x_channel_selector = svg_parse_channel_selector(dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_x_channel_selector))
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)x_channel_selector)

## Ported from Libraries/LibWeb/SVG/SVGFEDisplacementMapElement.cpp:93 Web::SVG::SVGFEDisplacementMapElement::y_channel_selector.
# https://drafts.csswg.org/filter-effects/#dom-svgfedisplacementmapelement-ychannelselector
pub func svg_svgfe_displacement_map_element_y_channel_selector(this: SvgSvgfeDisplacementMapElement*) -> SvgAnimatedEnumeration*:
    # FIXME: Support reflection, don't return a new object every time.
    let y_channel_selector = svg_parse_channel_selector(dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_y_channel_selector))
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)y_channel_selector)
