#==============================================================================================
#
#   svgfe_color_matrix_element - SVG::SVGFEColorMatrixElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEColorMatrixElement.cpp (lines 1-69) with the inline members of SVGFEColorMatrixElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feColorMatrixElement): in, type (as the IDL
#       enumeration) and values.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:16 Web::SVG::SVGFEColorMatrixElement::SVGFEColorMatrixElement.
pub func svg_svgfe_color_matrix_element_construct(this: SvgSvgfeColorMatrixElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEColorMatrixElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_color_matrix_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_color_matrix_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_color_matrix_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_color_matrix_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:21 Web::SVG::SVGFEColorMatrixElement::initialize (override).
pub func svg_svgfe_color_matrix_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_color_matrix_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:27 Web::SVG::SVGFEColorMatrixElement::visit_edges (override).
pub func svg_svgfe_color_matrix_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeColorMatrixElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)
    gc.cell_visitor_visit_t(visitor, this.m_values)

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:35 Web::SVG::SVGFEColorMatrixElement::in1.
pub func svg_svgfe_color_matrix_element_in1(this: SvgSvgfeColorMatrixElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:42 Web::SVG::SVGFEColorMatrixElement::type.
pub func svg_svgfe_color_matrix_element_type(this: SvgSvgfeColorMatrixElement*) -> SvgAnimatedEnumeration*:
    # https://www.w3.org/TR/filter-effects-1/#InterfaceSVGFEColorMatrixElement
    # Map the 'type' attribute to the IDL enumeration values.
    # Defaults to MATRIX when omitted.
    let type_attribute = dom_element_attribute(this.dom_element(), svg_attribute_names_type) else ak.String()

    var enum_value = svg_svgfe_color_matrix_element_svg_fecolormatrix_type_unknown
    if ak.string_is_empty(&type_attribute) or ak.string_equals_ignoring_ascii_case_string_view(&type_attribute, ak.sv("matrix")):
        enum_value = svg_svgfe_color_matrix_element_svg_fecolormatrix_type_matrix
    elif ak.string_equals_ignoring_ascii_case_string_view(&type_attribute, ak.sv("saturate")):
        enum_value = svg_svgfe_color_matrix_element_svg_fecolormatrix_type_saturate
    elif ak.string_equals_ignoring_ascii_case_string_view(&type_attribute, ak.sv("hueRotate")):
        enum_value = svg_svgfe_color_matrix_element_svg_fecolormatrix_type_huerotate
    elif ak.string_equals_ignoring_ascii_case_string_view(&type_attribute, ak.sv("luminanceToAlpha")):
        enum_value = svg_svgfe_color_matrix_element_svg_fecolormatrix_type_luminancetoalpha

    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), enum_value)

## Ported from Libraries/LibWeb/SVG/SVGFEColorMatrixElement.cpp:62 Web::SVG::SVGFEColorMatrixElement::values.
pub func svg_svgfe_color_matrix_element_values(this: SvgSvgfeColorMatrixElement*) -> SvgAnimatedString*:
    if this.m_values == none:
        this.m_values = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_values)

    return this.m_values else trap("VERIFY: m_values")
