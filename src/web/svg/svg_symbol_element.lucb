#==============================================================================================
#
#   svg_symbol_element - SVG::SVGSymbolElement: <symbol>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGSymbolElement.cpp (lines 1-75) with the inline members of
#       SVGSymbolElement.h: an SVGGraphicsElement with the SVGFitToViewBox mixin, rendered only
#       as the instance root of a <use> element's shadow tree (where it is display: inline).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:20 Web::SVG::SVGSymbolElement::SVGSymbolElement.
pub func svg_symbol_element_construct(this: SvgSymbolElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGSymbolElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_symbol_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_symbol_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_symbol_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_symbol_element_global_event_handlers_vtable
    this.svg_fit_to_view_box.vtable = &svg_symbol_element_svg_fit_to_view_box_vtable
    this.svg_fit_to_view_box.class_id = this.cell().class_id

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:25 Web::SVG::SVGSymbolElement::initialize (override).
pub func svg_symbol_element_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (SvgSymbolElement*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_symbol_element)
    svg_graphics_element_initialize_impl(base, realm)
    svg_fit_to_view_box_initialize(&this.svg_fit_to_view_box, realm)

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:32 Web::SVG::SVGSymbolElement::visit_edges (override).
pub func svg_symbol_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSymbolElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_fit_to_view_box_visit_edges(&this.svg_fit_to_view_box, visitor)

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:38 Web::SVG::SVGSymbolElement::adjust_computed_style (override).
pub func svg_symbol_element_adjust_computed_style_impl(base: DomElement*, computed_properties: CssComputedProperties*):
    let this = (SvgSymbolElement*)base
    svg_element_adjust_computed_style_impl(base, computed_properties)

    if svg_symbol_element_is_direct_child_of_use_shadow_tree(this):
        # The generated instance of a ‘symbol’ that is the direct referenced element of a ‘use’ element must always have a computed value of inline for the display property.
        css_computed_properties_set_property(computed_properties, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.inline)).css_style_value())

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:48 Web::SVG::SVGSymbolElement::attribute_changed (override).
pub func svg_symbol_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgSymbolElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    svg_fit_to_view_box_attribute_changed(&this.svg_fit_to_view_box, base, name, value)

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:54 Web::SVG::SVGSymbolElement::is_direct_child_of_use_shadow_tree.
func svg_symbol_element_is_direct_child_of_use_shadow_tree(this: SvgSymbolElement*) -> bool:
    let maybe_shadow_root = tree_node_parent(this.dom_node()) else return false
    if not is_dom_shadow_root(maybe_shadow_root):
        return false

    let host = dom_document_fragment_host(as_dom_shadow_root(maybe_shadow_root).dom_document_fragment()) else return false
    return is_svg_use_element(host)

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.cpp:65 Web::SVG::SVGSymbolElement::create_layout_node (override).
pub func svg_symbol_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgSymbolElement*)base
    # https://svgwg.org/svg2-draft/render.html#TermNeverRenderedElement
    # [..] it also includes a ‘symbol’ element that is not the instance root of a use-element shadow tree.
    if not svg_symbol_element_is_direct_child_of_use_shadow_tree(this):
        return none

    # heap().allocate<Layout::SVGGraphicsBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_svg_graphics_box(dom_element_realm(base), dom_node_document(base.dom_node()), this.svg_graphics_element(), style).layout_node()

## Ported from Libraries/LibWeb/SVG/SVGSymbolElement.h:25 Web::SVG::SVGSymbolElement::is_svg_symbol_element (override).
pub func svg_symbol_element_is_svg_symbol_element_impl(base: DomNode*) -> bool:
    return true
