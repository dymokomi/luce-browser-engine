#==============================================================================================
#
#   svg_path_element - SVG::SVGPathElement: <path>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGPathElement.cpp (lines 1-50): the `d` attribute parsed as path
#       data (https://svgwg.org/svg2-draft/paths.html#PathElement) and its path.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGPathElement.cpp:19 Web::SVG::SVGPathElement::SVGPathElement.
pub func svg_path_element_construct(this: SvgPathElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_geometry_element_construct(this.svg_geometry_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGPathElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_path_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_path_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_path_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_path_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGPathElement.cpp:24 Web::SVG::SVGPathElement::initialize (override).
pub func svg_path_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_path_element)
    svg_geometry_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGPathElement.cpp:30 Web::SVG::SVGPathElement::attribute_changed (override).
pub func svg_path_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgPathElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    let value_text = value else ak.String()  # value.value_or(String {})

    if ak.fly_string_eq_string_view(&name, ak.sv("d")):
        this.m_path = svg_attribute_parser_parse_path_data(ak.string_bytes_as_string_view(&value_text))
        dom_node_set_needs_layout_update(base.dom_node(), DomSetNeedsLayoutReason.style_change)

## Ported from Libraries/LibWeb/SVG/SVGPathElement.cpp:40 Web::SVG::SVGPathElement::get_path (override).
pub func svg_path_element_get_path_impl(base: SvgGeometryElement*, viewport_size: gfx.CssPixelSize) -> gfx.Path:
    let this = (SvgPathElement*)base
    return svg_path_to_gfx_path(&this.m_path)
