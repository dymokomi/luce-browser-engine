#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEFuncRElement.cpp (lines 1-25) with the inline members of SVGFEFuncRElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feFuncRElement): a transfer function (its
#       behaviour is SVGComponentTransferFunctionElement's).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEFuncRElement.cpp:14 Web::SVG::SVGFEFuncRElement::SVGFEFuncRElement.
pub func svg_svgfe_func_r_element_construct(this: SvgSvgfeFuncRElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_component_transfer_function_element_construct(this.svg_component_transfer_function_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEFuncRElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_func_r_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_func_r_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_func_r_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_func_r_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEFuncRElement.cpp:19 Web::SVG::SVGFEFuncRElement::initialize (override).
pub func svg_svgfe_func_r_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_func_r_element)
    svg_component_transfer_function_element_initialize_impl(base, realm)
