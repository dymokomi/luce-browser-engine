#==============================================================================================
#
#   svg_geometry_element - SVG::SVGGeometryElement: the base of the shape elements
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGGeometryElement.cpp (lines 1-54) with the inline members of
#       SVGGeometryElement.h (https://svgwg.org/svg2-draft/types.html#InterfaceSVGGeometryElement):
#       its layout box (an SVGGeometryBox), the pure virtual get_path, and the stubbed
#       getTotalLength/getPointAtLength and pathLength.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:14 Web::SVG::SVGGeometryElement::SVGGeometryElement.
pub func svg_geometry_element_construct(this: SvgGeometryElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:19 Web::SVG::SVGGeometryElement::initialize (override).
pub func svg_geometry_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_geometry_element)
    svg_graphics_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:25 Web::SVG::SVGGeometryElement::visit_edges (override).
pub func svg_geometry_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgGeometryElement*)base
    svg_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_path_length)

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:31 Web::SVG::SVGGeometryElement::create_layout_node (override).
pub func svg_geometry_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let this = (SvgGeometryElement*)base
    # heap().allocate<Layout::SVGGeometryBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_svg_geometry_box(dom_element_realm(base), dom_node_document(base.dom_node()), this, style).layout_node()

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:36 Web::SVG::SVGGeometryElement::get_total_length.
pub func svg_geometry_element_get_total_length(this: SvgGeometryElement*) -> f32:
    return 0.0

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:41 Web::SVG::SVGGeometryElement::get_point_at_length.
pub func svg_geometry_element_get_point_at_length(this: SvgGeometryElement*, distance: f32) -> GeometryDomPoint*:
    return geometry_dom_point_construct_impl(dom_element_realm(this.dom_element()), 0.0, 0.0, 0.0, 0.0)

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.cpp:47 Web::SVG::SVGGeometryElement::path_length.
pub func svg_geometry_element_path_length(this: SvgGeometryElement*) -> SvgAnimatedNumber*:
    if this.m_path_length == none:
        var qualified_name: DomQualifiedName = ---
        dom_qualified_name_construct(&qualified_name, svg_attribute_names_path_length, none, none)
        this.m_path_length = svg_animated_number_create(dom_element_realm(this.dom_element()), this.svg_element(), qualified_name, 0.0)
    return this.m_path_length else trap("VERIFY: m_path_length")

## Ported from Libraries/LibWeb/SVG/SVGGeometryElement.h:21 Web::SVG::SVGGeometryElement::get_path (pure virtual).
pub func svg_geometry_element_get_path_impl(this: SvgGeometryElement*, viewport_size: gfx.CssPixelSize) -> gfx.Path:
    trap("pure virtual: Web::SVG::SVGGeometryElement::get_path")
