## Ported from Libraries/LibWeb/SVG/SVGDescElement.cpp:17 Web::SVG::SVGDescElement::SVGDescElement.
pub func svg_desc_element_construct(this: SvgDescElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGDescElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_desc_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_desc_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_desc_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_desc_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGDescElement.cpp:22 Web::SVG::SVGDescElement::initialize (override).
pub func svg_desc_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_desc_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGDescElement.cpp:28 Web::SVG::SVGDescElement::create_layout_node (override).
pub func svg_desc_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    return none
