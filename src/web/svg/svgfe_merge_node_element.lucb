## Ported from Libraries/LibWeb/SVG/SVGFEMergeNodeElement.cpp:15 Web::SVG::SVGFEMergeNodeElement::SVGFEMergeNodeElement.
pub func svg_svgfe_merge_node_element_construct(this: SvgSvgfeMergeNodeElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEMergeNodeElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_merge_node_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_merge_node_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_merge_node_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_merge_node_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEMergeNodeElement.cpp:20 Web::SVG::SVGFEMergeNodeElement::initialize (override).
pub func svg_svgfe_merge_node_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_merge_node_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEMergeNodeElement.cpp:26 Web::SVG::SVGFEMergeNodeElement::visit_edges (override).
pub func svg_svgfe_merge_node_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeMergeNodeElement*)base
    svg_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_in1)

## Ported from Libraries/LibWeb/SVG/SVGFEMergeNodeElement.cpp:32 Web::SVG::SVGFEMergeNodeElement::in1.
pub func svg_svgfe_merge_node_element_in1(this: SvgSvgfeMergeNodeElement*) -> SvgAnimatedString*:
    if this.m_in1 == none:
        this.m_in1 = svg_animated_string_for_attribute(this.svg_element(), svg_attribute_names_in)

    return this.m_in1 else trap("VERIFY: m_in1")
