## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:232 Web::SVG::SVGElement::update_use_elements_that_reference_this.
func svg_element_update_use_elements_that_reference_this(this: SvgElement*):
    let node = this.dom_node()
    let document = dom_node_document(node)
    if (is_svg_use_element(node) or is_dom_shadow_root(tree_node_root(node)) or dom_element_id(this.dom_element()) == none or not dom_node_is_connected(node) or not dom_document_is_completely_loaded(document)):
        # If this element is in a shadow root, it already represents a clone and is not itself referenced.
        # If this does not have an id it cannot be referenced, no point in searching the entire DOM tree.
        # An unconnected node cannot have valid references.
        # This also prevents searches for elements that are in the process of being constructed - as clones.
        # Each use element already listens for the completely_loaded event and then clones its reference,
        # we do not have to also clone it in the process of initial DOM building.
        return

    # document().for_each_in_subtree_of_type<SVGUseElement>(...)
    for descendant in dom_node_subtree(document.dom_node()):
        if let use_element = as_if_svg_use_element(descendant):
            svg_use_element_svg_element_changed(use_element, this)

## removed_from's is_use_element_shadow_root lambda.
func svg_is_use_element_shadow_root(node: DomNode*) -> bool:
    let shadow_root = as_if_dom_shadow_root(node) else return false
    let host = dom_document_fragment_host(shadow_root.dom_document_fragment()) else return false
    return is_svg_use_element(host)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:255 Web::SVG::SVGElement::removed_from (override).
pub func svg_element_removed_from_impl(base: DomNode*, is_subtree_root: DomNodeIsSubtreeRoot, old_ancestor: DomNode*?, old_root: DomNode*):
    let this = (SvgElement*)base
    dom_element_removed_from_impl(base, is_subtree_root, old_ancestor, old_root)

    # If this element is in a shadow root hosted by a use element,
    # it already represents a clone and is not itself referenced.
    # NB: We check both old_root (for when the element is removed from the shadow tree directly)
    #     and root() (for when the use element host is removed from the document).
    if svg_is_use_element_shadow_root(old_root) or svg_is_use_element_shadow_root(tree_node_root(base)):
        return

    svg_element_remove_from_use_element_that_reference_this(this)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:274 Web::SVG::SVGElement::remove_from_use_element_that_reference_this.
func svg_element_remove_from_use_element_that_reference_this(this: SvgElement*):
    if is_svg_use_element(this) or dom_element_id(this.dom_element()) == none:
        return

    let document = dom_node_document(this.dom_node())
    # document().for_each_in_subtree_of_type<SVGUseElement>(...)
    for descendant in dom_node_subtree(document.dom_node()):
        if let use_element = as_if_svg_use_element(descendant):
            svg_use_element_svg_element_removed(use_element, this)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:286 Web::SVG::SVGElement::adjust_computed_style (override).
pub func svg_element_adjust_computed_style_impl(base: DomElement*, computed_properties: CssComputedProperties*):
    let this = (SvgElement*)base
    dom_element_adjust_computed_style_impl(base, computed_properties)

    # The outermost <svg> element (no ancestor <svg>) participates in CSS box layout
    # and may be positioned. All other SVG elements, including nested <svg> elements,
    # use SVG's coordinate system and must be forced to position:static.
    if is_svg_svgsvg_element(this) and svg_element_owner_svg_element(this) == none:
        return

    css_computed_properties_set_property(computed_properties, css_data.PropertyId.position, css_keyword_style_value_create(css_data.Keyword.static_).css_style_value())

# mark: IDL attributes ===========================================================================

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:300 Web::SVG::SVGElement::class_name.
# https://svgwg.org/svg2-draft/types.html#__svg__SVGElement__classNames
pub func svg_element_class_name(this: SvgElement*) -> SvgAnimatedString*:
    # The className IDL attribute reflects the ‘class’ attribute.
    if this.m_class_name_animated_string == none:
        var qualified_name: DomQualifiedName = ---
        dom_qualified_name_construct(&qualified_name, svg_attribute_names_class, none, none)
        this.m_class_name_animated_string = svg_animated_string_create(dom_element_realm(this.dom_element()), this, qualified_name)

    return this.m_class_name_animated_string else trap("VERIFY: m_class_name_animated_string")

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:310 Web::SVG::SVGElement::owner_svg_element.
# https://svgwg.org/svg2-draft/types.html#__svg__SVGElement__ownerSVGElement
pub func svg_element_owner_svg_element(this: SvgElement*) -> SvgSvgsvgElement*?:
    # The ownerSVGElement IDL attribute represents the nearest ancestor ‘svg’ element.
    # On getting ownerSVGElement, the nearest ancestor ‘svg’ element is returned;
    # if the current element is the outermost svg element, then null is returned.
    let ancestor = dom_node_first_flat_tree_ancestor_of_type(this.dom_node(), &svg_svgsvg_element_class) else return none
    return (SvgSvgsvgElement*)ancestor

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:319 Web::SVG::SVGElement::viewport_element.
# https://svgwg.org/svg2-draft/types.html#__svg__SVGElement__viewportElement
pub func svg_element_viewport_element(this: SvgElement*) -> SvgElement*?:
    var node = tree_node_parent(this.dom_node())
    while let current = node:
        # https://svgwg.org/svg2-draft/coords.html#EstablishingANewSVGViewport
        # The following elements establish new SVG viewports:
        # - The ‘svg’ element
        # - A ‘symbol’ element that is instanced by a ‘use’ element.
        if is_svg_svgsvg_element(current) or is_svg_symbol_element(current):
            return (SvgElement*)current
        node = dom_node_parent_or_shadow_host_node(current)
    return none

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:333 Web::SVG::SVGElement::fake_animated_length_fixme.
pub func svg_element_fake_animated_length_fixme(this: SvgElement*) -> SvgAnimatedLength*:
    let realm = dom_element_realm(this.dom_element())
    # FIXME: All callers of this method must implement their animated length correctly.
    let base_length = svg_length_create(realm, 0, 0.0, SvgLengthReadOnly.no)
    let anim_length = svg_length_create(realm, 0, 0.0, SvgLengthReadOnly.yes)
    return svg_animated_length_create(realm, base_length, anim_length)

## svg_animated_length_for_property's make_length lambda.
func svg_element_make_length(this: SvgElement*, property: css_data.PropertyId, read_only: SvgLengthReadOnly) -> SvgLength*:
    let realm = dom_element_realm(this.dom_element())
    if let computed_properties = dom_element_computed_properties(this.dom_element()):
        let style_value = css_computed_properties_property(computed_properties, property)

        if not css_style_value_has_auto(style_value):
            return svg_length_from_length_percentage(realm, css_length_percentage_from_style_value(style_value), read_only)
    return svg_length_create(realm, 0, 0.0, read_only)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:341 Web::SVG::SVGElement::svg_animated_length_for_property.
pub func svg_element_svg_animated_length_for_property(this: SvgElement*, property: css_data.PropertyId) -> SvgAnimatedLength*:
    # FIXME: Create a proper animated value when animations are supported.
    return svg_animated_length_create(dom_element_realm(this.dom_element()), svg_element_make_length(this, property, SvgLengthReadOnly.no),
                                      svg_element_make_length(this, property, SvgLengthReadOnly.yes))

