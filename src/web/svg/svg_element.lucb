#==============================================================================================
#
#   svg_element - SVG::SVGElement: the base of every SVG element
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGElement.cpp (lines 1-359) with the inline members of
#       SVGElement.h: construction (which moves the mixin tables to SVGElement's, as C++'s
#       vptrs move), the presentation attributes
#       (https://svgwg.org/svg2-draft/styling.html#PresentationAttributes), the accessibility
#       rules of SVG-AAM, the DOM steps shared with HTMLOrSVGElement, the <use> element
#       bookkeeping, forcing position:static, and className, ownerSVGElement and
#       viewportElement.
#
#       attribute_style_properties' static Array is a module global made once in the C heap
#       (DESIGN.md §3.3 rule 7).
#
#==============================================================================================

# mark: Construction =============================================================================

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:29 Web::SVG::SVGElement::SVGElement.
pub func svg_element_construct(this: SvgElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    dom_element_construct(this.dom_element(), document, qualified_name)
    # The bases after Element: GlobalEventHandlers (no state) and HTMLOrSVGElement<SVGElement>
    # (its two fields start null and empty). The vptrs of every mixin base are SVGElement's (a
    # subclass moves them on, DESIGN.md §2.5).
    this.element.slottable_mixin.vtable = &svg_element_slottable_mixin_vtable
    this.element.aria_mixin.vtable = &svg_element_aria_mixin_vtable
    this.element.animatable.vtable = &svg_element_animatable_vtable
    this.global_event_handlers.vtable = &svg_element_global_event_handlers_vtable
    this.global_event_handlers.class_id = this.cell().class_id

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:34 Web::SVG::SVGElement::initialize (override).
pub func svg_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_element)
    dom_element_initialize_impl(base, realm)

# mark: Presentation attributes ==================================================================

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:41 Web::SVG::NamedPropertyID::NamedPropertyID.
pub func svg_named_property_id_construct_fly_string(this: SvgNamedPropertyId*, property_id: css_data.PropertyId, name: ak.FlyString, supported_elements: ak.Vector[ak.FlyString]):
    *this = SvgNamedPropertyId(id = property_id, name = name, supported_elements = supported_elements)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:47 Web::SVG::NamedPropertyID::NamedPropertyID.
pub func svg_named_property_id_construct_vector(this: SvgNamedPropertyId*, property_id: css_data.PropertyId, supported_elements: ak.Vector[ak.FlyString]):
    svg_named_property_id_construct_fly_string(this, property_id, css_data.string_from_property_id(property_id), supported_elements)

## The `static Array const properties` of attribute_style_properties, made on first use.
var svg_attribute_style_properties_storage: ak.Vector[SvgNamedPropertyId]
var svg_attribute_style_properties_initialized: bool

## `{ SVG::TagNames::... }`: the supported elements of a presentation attribute.
func svg_tag_list(names: (const ak.FlyString[])?) -> ak.Vector[ak.FlyString]:
    var list = ak.Vector[ak.FlyString]()
    if let given = names:
        for name in given:
            ak.vector_append_t(&list, name)
    return list

## `NamedPropertyID(property_id, supported_elements)` appended to the table.
func svg_add_property(properties: ak.Vector[SvgNamedPropertyId]*, property_id: css_data.PropertyId, supported_elements: (const ak.FlyString[])? = none):
    var property: SvgNamedPropertyId = ---
    svg_named_property_id_construct_vector(&property, property_id, svg_tag_list(supported_elements))
    ak.vector_append_t(properties, property)

## `NamedPropertyID(property_id, name, supported_elements)` appended to the table.
func svg_add_named_property(properties: ak.Vector[SvgNamedPropertyId]*, property_id: css_data.PropertyId, name: ak.FlyString,
                            supported_elements: (const ak.FlyString[])? = none):
    var property: SvgNamedPropertyId = ---
    svg_named_property_id_construct_fly_string(&property, property_id, name, svg_tag_list(supported_elements))
    ak.vector_append_t(properties, property)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:57 Web::SVG::attribute_style_properties (static).
func svg_attribute_style_properties() -> const SvgNamedPropertyId[]:
    if svg_attribute_style_properties_initialized:
        return ak.vector_span_const(&svg_attribute_style_properties_storage)

    # The table outlives every VM: it is made in the C heap (DESIGN.md §3.3 rule 7).
    let saved_atomic_allocator = ak.atomic_allocator
    ak.atomic_allocator = none
    defer ak.atomic_allocator = saved_atomic_allocator
    with memory.heap:
        let p = &svg_attribute_style_properties_storage
        let dimensioned: ak.FlyString[6] = [svg_tag_names_foreign_object, svg_tag_names_image, svg_tag_names_rect, svg_tag_names_svg, svg_tag_names_symbol,
                                            svg_tag_names_use]
        # https://svgwg.org/svg2-draft/styling.html#PresentationAttributes
        # FIXME: The `fill` attribute and CSS `fill` property are not the same! But our support is limited enough that they are equivalent for now.
        svg_add_property(p, css_data.PropertyId.fill)
        # FIXME: The `stroke` attribute and CSS `stroke` property are not the same! But our support is limited enough that they are equivalent for now.
        svg_add_property(p, css_data.PropertyId.clip_path)
        svg_add_property(p, css_data.PropertyId.clip_rule)
        svg_add_property(p, css_data.PropertyId.color)
        svg_add_property(p, css_data.PropertyId.color_interpolation)
        svg_add_property(p, css_data.PropertyId.cursor)
        svg_add_property(p, css_data.PropertyId.cx, [svg_tag_names_circle, svg_tag_names_ellipse])
        svg_add_property(p, css_data.PropertyId.cy, [svg_tag_names_circle, svg_tag_names_ellipse])
        svg_add_property(p, css_data.PropertyId.direction)
        svg_add_property(p, css_data.PropertyId.display)
        svg_add_property(p, css_data.PropertyId.dominant_baseline)
        svg_add_property(p, css_data.PropertyId.fill_opacity)
        svg_add_property(p, css_data.PropertyId.fill_rule)
        svg_add_property(p, css_data.PropertyId.filter)
        svg_add_property(p, css_data.PropertyId.flood_color)
        svg_add_property(p, css_data.PropertyId.flood_opacity)
        svg_add_property(p, css_data.PropertyId.font_family)
        svg_add_property(p, css_data.PropertyId.font_size)
        svg_add_property(p, css_data.PropertyId.font_style)
        svg_add_property(p, css_data.PropertyId.font_variant)
        svg_add_property(p, css_data.PropertyId.font_weight)
        svg_add_named_property(p, css_data.PropertyId.font_width, ak.fly_string_from_str("font-stretch"))
        svg_add_property(p, css_data.PropertyId.height, dimensioned)
        svg_add_property(p, css_data.PropertyId.image_rendering)
        svg_add_property(p, css_data.PropertyId.letter_spacing)
        svg_add_property(p, css_data.PropertyId.mask)
        svg_add_property(p, css_data.PropertyId.mask_type)
        svg_add_property(p, css_data.PropertyId.opacity)
        svg_add_property(p, css_data.PropertyId.overflow)
        svg_add_property(p, css_data.PropertyId.paint_order)
        svg_add_property(p, css_data.PropertyId.pointer_events)
        # donor quirk: `NamedPropertyID(CSS::PropertyID::R, { SVG::TagNames::circle })` picks the (id, name)
        # constructor (a one-element braced list converts to a FlyString): the attribute named "circle" maps to
        # `r` on every element, and the `r` attribute is left to SVGCircleElement's own hints.
        svg_add_named_property(p, css_data.PropertyId.r, svg_tag_names_circle)
        svg_add_property(p, css_data.PropertyId.rx, [svg_tag_names_ellipse, svg_tag_names_rect])
        svg_add_property(p, css_data.PropertyId.ry, [svg_tag_names_ellipse, svg_tag_names_rect])
        svg_add_property(p, css_data.PropertyId.shape_rendering)
        svg_add_property(p, css_data.PropertyId.stop_color)
        svg_add_property(p, css_data.PropertyId.stop_opacity)
        svg_add_property(p, css_data.PropertyId.stroke)
        svg_add_property(p, css_data.PropertyId.stroke_dasharray)
        svg_add_property(p, css_data.PropertyId.stroke_dashoffset)
        svg_add_property(p, css_data.PropertyId.stroke_linecap)
        svg_add_property(p, css_data.PropertyId.stroke_linejoin)
        svg_add_property(p, css_data.PropertyId.stroke_miterlimit)
        svg_add_property(p, css_data.PropertyId.stroke_opacity)
        svg_add_property(p, css_data.PropertyId.stroke_width)
        svg_add_property(p, css_data.PropertyId.text_anchor)
        svg_add_property(p, css_data.PropertyId.text_decoration)
        svg_add_property(p, css_data.PropertyId.text_rendering)
        svg_add_property(p, css_data.PropertyId.text_overflow)
        svg_add_named_property(p, css_data.PropertyId.transform, svg_attribute_names_gradient_transform, [svg_tag_names_linear_gradient, svg_tag_names_radial_gradient])
        svg_add_named_property(p, css_data.PropertyId.transform, svg_attribute_names_pattern_transform, [svg_tag_names_pattern])
        svg_add_property(p, css_data.PropertyId.transform_origin)
        svg_add_property(p, css_data.PropertyId.unicode_bidi)
        svg_add_property(p, css_data.PropertyId.visibility)
        svg_add_property(p, css_data.PropertyId.white_space)
        svg_add_property(p, css_data.PropertyId.width, dimensioned)
        svg_add_property(p, css_data.PropertyId.word_spacing)
        svg_add_property(p, css_data.PropertyId.writing_mode)
        svg_add_property(p, css_data.PropertyId.x, dimensioned)
        svg_add_property(p, css_data.PropertyId.y, dimensioned)
    svg_attribute_style_properties_initialized = true
    return ak.vector_span_const(&svg_attribute_style_properties_storage)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:127 Web::SVG::SVGElement::is_presentational_hint (override).
pub func svg_element_is_presentational_hint_impl(base: DomElement*, name: ak.FlyString) -> bool:
    if dom_element_is_presentational_hint_impl(base, name):
        return true

    for property in svg_attribute_style_properties():
        if ak.fly_string_equals_ignoring_ascii_case_fly_string(&name, &property.name):
            return true
    return false

## `property.supported_elements.contains_slow(name)` of FlyStrings.
func svg_fly_strings_contain(names: const ak.Vector[ak.FlyString]*, name: ak.FlyString) -> bool:
    for candidate in ak.vector_span_const(names):
        if ak.fly_string_eq_fly_string(&candidate, &name):
            return true
    return false

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:135 Web::SVG::SVGElement::apply_presentational_hints (override).
pub func svg_element_apply_presentational_hints_impl(base: DomElement*, properties: ak.Vector[CssStyleProperty]*):
    dom_element_apply_presentational_hints_impl(base, properties)
    var parsing_context: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&parsing_context, dom_node_document(base.dom_node()), CssParsingMode.svg_presentation_attribute)
    # for_each_attribute([&](auto& name, auto& value) { ... })
    let attributes = base.m_attributes else return
    for i in 0..<dom_named_node_map_length(attributes):
        let attribute = dom_named_node_map_item(attributes, (u32)i) else trap("NamedNodeMap::item in range")
        let name = dom_attr_name(attribute)
        let value = dom_attr_value(attribute)
        for property in svg_attribute_style_properties():
            if not ak.fly_string_equals_ignoring_ascii_case_fly_string(&name, &property.name):
                continue
            if not ak.vector_is_empty(&property.supported_elements) and not svg_fly_strings_contain(&property.supported_elements, dom_element_local_name(base)):
                continue
            if property.id == css_data.PropertyId.mask:
                if let style_value = parse_css_value(parsing_context, ak.string_bytes_as_string_view(&value), css_data.PropertyId.mask):
                    html_append_presentational_hint(properties, css_data.PropertyId.mask, style_value)
            else:
                if let style_value = parse_css_value(parsing_context, ak.string_bytes_as_string_view(&value), property.id):
                    html_append_presentational_hint(properties, property.id, style_value)
            break

# mark: Accessibility ============================================================================

## Whether a child's text content, trimmed of ASCII whitespace, is not empty.
func svg_element_has_text_content(node: DomNode*) -> bool:
    let text = dom_node_text_content(node) else trap("VERIFY: text_content() of an element")
    let view = ak.utf16_string_base_utf16_view(&text.utf16_string_base)
    let trimmed = ak.utf16_view_trim_ascii_whitespace(&view)
    return not ak.utf16_view_is_empty(&trimmed)

## Whether an optional ARIA string attribute is present and not only whitespace.
func svg_aria_string_is_not_blank(value: ak.String?) -> bool:
    let string = value else return false
    let view = ak.string_bytes_as_string_view(&string)
    let trimmed = ak.string_view_trim_whitespace(&view)
    return not ak.string_view_is_empty(&trimmed)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:157 Web::SVG::SVGElement::should_include_in_accessibility_tree.
pub func svg_element_should_include_in_accessibility_tree(this: SvgElement*) -> bool:
    var has_title_or_desc = false
    let role = aria_mixin_role_from_role_attribute_value(&this.element.aria_mixin)
    # for_each_child_of_type<SVGElement>(...)
    for child in dom_node_children(this.dom_node()):
        if not is_svg_element(child):
            continue
        if (is_svg_title_element(child) or is_svg_desc_element(child)) and svg_element_has_text_content(child):
            has_title_or_desc = true
            break
    # https://w3c.github.io/svg-aam/#include_elements
    # TODO: Add support for the SVG tabindex attribute, and include a check for it here.
    let aria = &this.element.aria_mixin
    if has_title_or_desc:
        return true
    if svg_aria_string_is_not_blank(aria_mixin_aria_label(aria)):
        return true
    if svg_aria_string_is_not_blank(aria_mixin_aria_labelled_by(aria)):
        return true
    if svg_aria_string_is_not_blank(aria_mixin_aria_described_by(aria)):
        return true
    if let used_role = role:
        return aria_is_abstract_role(used_role) and used_role != AriaRole.none_ and used_role != AriaRole.presentation
    return false

## `local_name() == name` of an element.
func svg_element_local_name_is(this: SvgElement*, name: ak.FlyString) -> bool:
    let local_name = dom_element_local_name(this.dom_element())
    return ak.fly_string_eq_fly_string(&local_name, &name)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:177 Web::SVG::SVGElement::default_role (override).
pub func svg_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    let this = (SvgElement*)dom_element_from_aria_mixin(base)
    let element = this.dom_element()
    # https://w3c.github.io/svg-aam/#mapping_role_table
    if svg_element_local_name_is(this, svg_tag_names_a) and (dom_element_has_attribute(element, svg_attribute_names_href) or dom_element_has_attribute(element, svg_attribute_names_xlink_href)):
        return AriaRole.link
    if (svg_element_local_name_is(this, svg_tag_names_foreign_object) or svg_element_local_name_is(this, svg_tag_names_g)) and svg_element_should_include_in_accessibility_tree(this):
        return AriaRole.group
    if svg_element_local_name_is(this, svg_tag_names_image) and svg_element_should_include_in_accessibility_tree(this):
        return AriaRole.image
    if svg_element_local_name_is(this, svg_tag_names_circle) and svg_element_should_include_in_accessibility_tree(this):
        return AriaRole.graphicssymbol
    if (svg_element_local_name_is(this, svg_tag_names_ellipse) or svg_element_local_name_is(this, svg_tag_names_path) or svg_element_local_name_is(this, svg_tag_names_polygon) or svg_element_local_name_is(this, svg_tag_names_polyline)) and svg_element_should_include_in_accessibility_tree(this):
        return AriaRole.graphicssymbol
    return AriaRole.generic

