## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:195 Web::SVG::SVGElement::visit_edges (override).
pub func svg_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgElement*)base
    dom_element_visit_edges_impl(base, visitor)
    html_or_svg_element_visit_edges(&this.html_or_svg_element, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_class_name_animated_string)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:202 Web::SVG::SVGElement::attribute_changed (override).
pub func svg_element_attribute_changed_impl(base: DomElement*, local_name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgElement*)base
    dom_element_attribute_changed_impl(base, local_name, old_value, value, namespace_)
    html_or_svg_element_attribute_changed(&this.html_or_svg_element, local_name, old_value, value, namespace_)

    svg_element_update_use_elements_that_reference_this(this)

## Ported from Libraries/LibWeb/SVG/SVGElement.cpp:210 Web::SVG::SVGElement::cloned (override).
pub func svg_element_cloned_impl(base: DomNode*, copy: DomNode*, clone_children: bool) -> !:
    let this = (SvgElement*)base
    try dom_node_cloned_impl(base, copy, clone_children)
    try html_or_svg_element_cloned(&this.html_or_svg_element, copy, clone_children)
    return

