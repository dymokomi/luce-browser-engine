## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.cpp:15 Web::SVG::SVGAnimatedTransformList::create.
pub func svg_animated_transform_list_create(realm: Realm*, base_val: SvgTransformList*, anim_val: SvgTransformList*) -> SvgAnimatedTransformList*:
    return realm_create_svg_animated_transform_list(realm, realm, base_val, anim_val)

## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.cpp:20 Web::SVG::SVGAnimatedTransformList::SVGAnimatedTransformList.
pub func svg_animated_transform_list_construct(this: SvgAnimatedTransformList*, realm: Realm*, base_val: SvgTransformList*, anim_val: SvgTransformList*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_base_val = base_val
    this.m_anim_val = anim_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.h:23 Web::SVG::SVGAnimatedTransformList::base_val.
pub func svg_animated_transform_list_base_val(this: SvgAnimatedTransformList*) -> SvgTransformList*:
    # donor quirk: baseVal answers the animated value.
    return this.m_anim_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.h:28 Web::SVG::SVGAnimatedTransformList::anim_val.
pub func svg_animated_transform_list_anim_val(this: SvgAnimatedTransformList*) -> SvgTransformList*:
    return this.m_anim_val

## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.cpp:29 Web::SVG::SVGAnimatedTransformList::initialize (override).
pub func svg_animated_transform_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_animated_transform_list)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGAnimatedTransformList.cpp:35 Web::SVG::SVGAnimatedTransformList::visit_edges (override).
pub func svg_animated_transform_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgAnimatedTransformList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_base_val)
    gc.cell_visitor_visit_t_2(visitor, this.m_anim_val)
