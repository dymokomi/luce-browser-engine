#==============================================================================================
#
#   svgfe_turbulence_element - SVG::SVGFETurbulenceElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFETurbulenceElement.cpp (lines 1-116) with the inline members of SVGFETurbulenceElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feTurbulenceElement): baseFrequency (two
#       components), numOctaves, seed, stitchTiles and type.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:15 Web::SVG::SVGFETurbulenceElement::SVGFETurbulenceElement.
pub func svg_svgfe_turbulence_element_construct(this: SvgSvgfeTurbulenceElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFETurbulenceElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_turbulence_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_turbulence_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_turbulence_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_turbulence_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:20 Web::SVG::SVGFETurbulenceElement::initialize (override).
pub func svg_svgfe_turbulence_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_turbulence_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:26 Web::SVG::SVGFETurbulenceElement::visit_edges (override).
pub func svg_svgfe_turbulence_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeTurbulenceElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_base_frequency_x)
    gc.cell_visitor_visit_t(visitor, this.m_base_frequency_y)
    gc.cell_visitor_visit_t(visitor, this.m_num_octaves)
    gc.cell_visitor_visit_t(visitor, this.m_seed)
    gc.cell_visitor_visit_t(visitor, this.m_stitch_tiles)
    gc.cell_visitor_visit_t(visitor, this.m_type)

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:39 Web::SVG::SVGFETurbulenceElement::base_frequency_x.
# https://drafts.csswg.org/filter-effects/#dom-svgfeturbulenceelement-basefrequencyx
pub func svg_svgfe_turbulence_element_base_frequency_x(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedNumber*:
    if this.m_base_frequency_x == none:
        this.m_base_frequency_x = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_base_frequency, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.first)

    return this.m_base_frequency_x else trap("VERIFY: m_base_frequency_x")

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:49 Web::SVG::SVGFETurbulenceElement::base_frequency_y.
# https://drafts.csswg.org/filter-effects/#dom-svgfeturbulenceelement-basefrequencyy
pub func svg_svgfe_turbulence_element_base_frequency_y(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedNumber*:
    if this.m_base_frequency_y == none:
        this.m_base_frequency_y = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_base_frequency, 0.0, SvgAnimatedNumberSupportsSecondValue.yes, SvgAnimatedNumberValueRepresented.second)

    return this.m_base_frequency_y else trap("VERIFY: m_base_frequency_y")

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:59 Web::SVG::SVGFETurbulenceElement::num_octaves.
# https://drafts.csswg.org/filter-effects/#dom-svgfeturbulenceelement-numoctaves
pub func svg_svgfe_turbulence_element_num_octaves(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedInteger*:
    if this.m_num_octaves == none:
        var reflected_attribute: DomQualifiedName = ---
        dom_qualified_name_construct(&reflected_attribute, svg_attribute_names_num_octaves, none, none)
        this.m_num_octaves = svg_animated_integer_create(dom_element_realm(this.dom_element()), this.svg_element(), reflected_attribute, 1)

    return this.m_num_octaves else trap("VERIFY: m_num_octaves")

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:68 Web::SVG::SVGFETurbulenceElement::seed.
# https://drafts.csswg.org/filter-effects/#dom-svgfeturbulenceelement-seed
pub func svg_svgfe_turbulence_element_seed(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedNumber*:
    if this.m_seed == none:
        this.m_seed = svg_animated_number_for_attribute(this.svg_element(), svg_attribute_names_seed, 0.0)

    return this.m_seed else trap("VERIFY: m_seed")

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:77 Web::SVG::parse_stitch_tiles.
# https://drafts.csswg.org/filter-effects/#element-attrdef-feturbulence-stitchtiles
func svg_parse_stitch_tiles(value: ak.String) -> SvgSvgfeTurbulenceElementStitchType:
    let view = ak.string_bytes_as_string_view(&value)
    if ak.string_view_equals(&view, "stitch"):
        return SvgSvgfeTurbulenceElementStitchType.stitch
    if ak.string_view_equals(&view, "noStitch"):
        return SvgSvgfeTurbulenceElementStitchType.no_stitch
    return SvgSvgfeTurbulenceElementStitchType.no_stitch

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:89 Web::SVG::SVGFETurbulenceElement::stitch_tiles.
# https://drafts.csswg.org/filter-effects/#element-attrdef-feturbulence-stitchtiles
pub func svg_svgfe_turbulence_element_stitch_tiles(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedEnumeration*:
    # FIXME: Support reflection, don't return a new object every time.
    let stitch_tiles = svg_parse_stitch_tiles(dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_stitch_tiles))
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)stitch_tiles)

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:97 Web::SVG::parse_turbulence_type.
# https://drafts.csswg.org/filter-effects/#element-attrdef-feturbulence-type
func svg_parse_turbulence_type(value: ak.String) -> SvgSvgfeTurbulenceElementTurbulenceType:
    let view = ak.string_bytes_as_string_view(&value)
    if ak.string_view_equals(&view, "turbulence"):
        return SvgSvgfeTurbulenceElementTurbulenceType.turbulence
    if ak.string_view_equals(&view, "fractalNoise"):
        return SvgSvgfeTurbulenceElementTurbulenceType.fractal_noise
    return SvgSvgfeTurbulenceElementTurbulenceType.turbulence

## Ported from Libraries/LibWeb/SVG/SVGFETurbulenceElement.cpp:109 Web::SVG::SVGFETurbulenceElement::type.
# https://drafts.csswg.org/filter-effects/#dom-svgfeturbulenceelement-type
pub func svg_svgfe_turbulence_element_type(this: SvgSvgfeTurbulenceElement*) -> SvgAnimatedEnumeration*:
    # FIXME: Support reflection, don't return a new object every time.
    let turbulence_type = svg_parse_turbulence_type(dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_type))
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)turbulence_type)
