#==============================================================================================
#
#   svg_metadata_element - SVG::SVGMetadataElement: <metadata>, metadata that is not rendered
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGMetadataElement.cpp with the inline members of SVGMetadataElement.h: it has no layout box.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGMetadataElement.cpp:17 Web::SVG::SVGMetadataElement::SVGMetadataElement.
pub func svg_metadata_element_construct(this: SvgMetadataElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGMetadataElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_metadata_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_metadata_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_metadata_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_metadata_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGMetadataElement.cpp:22 Web::SVG::SVGMetadataElement::initialize (override).
pub func svg_metadata_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_metadata_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGMetadataElement.cpp:28 Web::SVG::SVGMetadataElement::create_layout_node (override).
pub func svg_metadata_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    return none
