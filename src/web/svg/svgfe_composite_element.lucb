## Ported from Libraries/LibWeb/SVG/SVGFECompositeElement.cpp:122 Web::SVG::SVGFECompositeElement::operator_.
pub func svg_svgfe_composite_element_to(this: SvgSvgfeCompositeElement*) -> SvgSvgfeCompositeElementCompositingOperator:
    return this.m_operator else SvgSvgfeCompositeElementCompositingOperator.over

## Ported from Libraries/LibWeb/SVG/SVGFECompositeElement.cpp:128 Web::SVG::SVGFECompositeElement::operator_for_bindings.
# https://drafts.fxtf.org/filter-effects/#element-attrdef-fecomposite-operator
pub func svg_svgfe_composite_element_to_for_bindings(this: SvgSvgfeCompositeElement*) -> SvgAnimatedEnumeration*:
    return svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)(this.m_operator else SvgSvgfeCompositeElementCompositingOperator.over))
