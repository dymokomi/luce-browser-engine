## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:264 Web::SVG::SVGImageElement::animate.
func svg_image_element_animate(this: SvgImageElement*):
    let resource_request = this.m_resource_request else trap("VERIFY: m_resource_request")
    let image_data = html_shared_resource_request_image_data(resource_request) else return

    this.m_current_frame_index = (this.m_current_frame_index + 1) % html_decoded_image_data_frame_count(image_data)
    let current_frame_duration = html_decoded_image_data_frame_duration(image_data, this.m_current_frame_index)

    let animation_timer = this.m_animation_timer else trap("the animation timer")
    if current_frame_duration != core_timer_interval(animation_timer):
        core_timer_restart_i32(animation_timer, current_frame_duration)

    if this.m_current_frame_index == html_decoded_image_data_frame_count(image_data) -% 1:
        this.m_loops_completed += 1
        if this.m_loops_completed > 0 and this.m_loops_completed == html_decoded_image_data_loop_count(image_data):
            core_timer_stop(animation_timer)

    if let paintable = dom_node_paintable(this.dom_node()):
        paint_paintable_set_needs_repaint(paintable, InvalidateDisplayList.yes)

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:289 Web::SVG::SVGImageElement::decoded_image_data (override).
pub func svg_image_element_decoded_image_data_impl(base: LayoutImageProvider*) -> HtmlDecodedImageData*?:
    let this = svg_image_element_from_image_provider(base)
    let resource_request = this.m_resource_request else return none
    return html_shared_resource_request_image_data(resource_request)

