## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:87 Web::SVG::SVGImageElement::x.
# https://svgwg.org/svg2-draft/embedded.html#__svg__SVGImageElement__x
pub func svg_image_element_x(this: SvgImageElement*) -> SvgAnimatedLength*:
    if this.m_x == none:
        this.m_x = svg_element_fake_animated_length_fixme(this.svg_element())

    return this.m_x else trap("VERIFY: m_x")

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:96 Web::SVG::SVGImageElement::y.
# https://svgwg.org/svg2-draft/embedded.html#__svg__SVGImageElement__y
