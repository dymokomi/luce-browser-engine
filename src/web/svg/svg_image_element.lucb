#==============================================================================================
#
#   svg_image_element - SVG::SVGImageElement: <image>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGImageElement.cpp (lines 1-297) with the inline members of
#       SVGImageElement.h (https://svgwg.org/svg2-draft/embedded.html#ImageElement): x, y,
#       width and height, the href (SVGURIReferenceMixin; the XLink-namespaced href is used only
#       without a plain one), the fetch of the image through a SharedResourceRequest (P2), the
#       frame animation timer, the bounding box, and the Layout::ImageProvider overrides the
#       SVGImageBox reads.
#
#==============================================================================================

# mark: Construction =============================================================================

## The SVGImageElement an ImageProvider base belongs to (the C++ `this` adjustment).
func svg_image_element_from_image_provider(base: LayoutImageProvider*) -> SvgImageElement*:
    return (SvgImageElement*)((u8*)base - memory.offset_of(SvgImageElement, image_provider))

## The animation timer's handler: `[this] { animate(); }`.
func svg_image_element_on_animation_timer(context: void*?):
    svg_image_element_animate((SvgImageElement*)(context else trap("no image element")))

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:26 Web::SVG::SVGImageElement::SVGImageElement.
pub func svg_image_element_construct(this: SvgImageElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_graphics_element_construct(this.svg_graphics_element(), document, qualified_name)
    # The Layout::ImageProvider base (no state) gets its table, then the vptrs of the mixin bases move to
    # SVGImageElement's tables.
    this.image_provider.vtable = &svg_image_element_image_provider_vtable
    this.image_provider.class_id = this.cell().class_id
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_image_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_image_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_image_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_image_element_global_event_handlers_vtable

    let timer = core_timer_create()
    this.m_animation_timer = timer
    timer.on_timeout = ak.Function0[unit](call = svg_image_element_on_animation_timer, context = this)

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:35 Web::SVG::SVGImageElement::initialize (override).
pub func svg_image_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_image_element)
    svg_graphics_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:41 Web::SVG::SVGImageElement::visit_edges (override).
pub func svg_image_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgImageElement*)base
    svg_element_visit_edges_impl(base, visitor)
    layout_image_provider_image_provider_visit_edges(&this.image_provider, visitor)
    svg_svguri_reference_mixin_visit_edges(&this.svguri_reference_mixin, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_x)
    gc.cell_visitor_visit_t(visitor, this.m_y)
    gc.cell_visitor_visit_t(visitor, this.m_width)
    gc.cell_visitor_visit_t(visitor, this.m_height)
    gc.cell_visitor_visit_t(visitor, this.m_resource_request)

## `MUST(length()->base_val()->set_value(parse_coordinate(value.value_or(String {})).value_or(0)))`.
func svg_image_element_set_length_from_attribute(length: SvgAnimatedLength*, value: ak.String?):
    let value_text = value else ak.String()
    let parsed_value = svg_attribute_parser_parse_coordinate_string_view(ak.string_bytes_as_string_view(&value_text))
    svg_length_set_value(svg_animated_length_base_val(length), parsed_value else 0.0) else trap("MUST: SVGLength::set_value")

## Ported from Libraries/LibWeb/SVG/SVGImageElement.cpp:53 Web::SVG::SVGImageElement::attribute_changed (override).
pub func svg_image_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgImageElement*)base
    svg_graphics_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x):
        svg_image_element_set_length_from_attribute(svg_image_element_x(this), value)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y):
        svg_image_element_set_length_from_attribute(svg_image_element_y(this), value)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_width):
        svg_image_element_set_length_from_attribute(svg_image_element_width(this), value)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_height):
        svg_image_element_set_length_from_attribute(svg_image_element_height(this), value)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_href):
        # https://svgwg.org/svg2-draft/linking.html#XLinkRefAttrs
        # For backwards compatibility, elements with an ‘href’ attribute also recognize an ‘href’ attribute in the
        # XLink namespace. If the element is in the XLink namespace, it does not recognize an ‘href’ attribute in the
        # SVG namespace. When the ‘href’ attribute is present in both the XLink namespace and without a namespace, the
        # value of the attribute without a namespace shall be used. The attribute in the XLink namespace shall be ignored.
        if let attribute_namespace = namespace_:
            if ak.fly_string_eq_fly_string(&attribute_namespace, &namespace_x_link) and dom_element_has_attribute_ns(base, none, name):
                return

        var href = value
        if namespace_ == none and href == none:
            href = dom_element_get_attribute_ns(base, svg_attribute_names_href, namespace_x_link)

        svg_image_element_process_the_url(this, href)

