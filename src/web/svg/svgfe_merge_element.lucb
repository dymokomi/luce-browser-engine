#==============================================================================================
#
#   svgfe_merge_element - SVG::SVGFEMergeElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEMergeElement.cpp (lines 1-30) with the inline members of SVGFEMergeElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feMergeElement): its inputs are its
#       feMergeNode children.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEMergeElement.cpp:14 Web::SVG::SVGFEMergeElement::SVGFEMergeElement.
pub func svg_svgfe_merge_element_construct(this: SvgSvgfeMergeElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEMergeElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_merge_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_merge_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_merge_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_merge_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEMergeElement.cpp:19 Web::SVG::SVGFEMergeElement::initialize (override).
pub func svg_svgfe_merge_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_merge_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGFEMergeElement.cpp:25 Web::SVG::SVGFEMergeElement::visit_edges (override).
pub func svg_svgfe_merge_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgSvgfeMergeElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_filter_primitive_standard_attributes_visit_edges(&this.svg_filter_primitive_standard_attributes, visitor)
