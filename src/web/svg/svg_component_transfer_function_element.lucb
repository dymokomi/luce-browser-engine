## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:150 Web::SVG::SVGComponentTransferFunctionElement::table_float_values.
pub func svg_component_transfer_function_element_table_float_values(this: SvgComponentTransferFunctionElement*) -> ak.Vector[f32]:
    var values = ak.Vector[f32]()
    let base_val = svg_animated_number_list_base_val(svg_component_transfer_function_element_table_values(this))
    let table_numbers = svg_list_items(&base_val.svg_list)
    ak.vector_ensure_capacity(&values, table_numbers.length)
    for svg_number in table_numbers:
        ak.vector_append_t(&values, svg_number_value(svg_number))
    return values

## color_table's to_u8 lambda: `AK::clamp_to<u8>(value * 255.f)`.
func svg_component_transfer_to_u8(value: f32) -> u8:
    let scaled = value * 255.0
    if scaled >= 255.0:
        return 255
    if scaled <= 0.0:
        return 0
    return (u8)ak.rounding_round_to_f32_i32(scaled)

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:161 Web::SVG::SVGComponentTransferFunctionElement::color_table.
# https://drafts.fxtf.org/filter-effects/#element-attrdef-fecomponenttransfer-type
pub func svg_component_transfer_function_element_color_table(this: SvgComponentTransferFunctionElement*) -> const u8[]:
    if let cached = this.m_cached_color_table:
        return ak.byte_buffer_bytes_const(&cached)

    var result = ak.ByteBuffer()
    ak.byte_buffer_resize(&result, 256)
    let data = ak.byte_buffer_span(&result)

    match svg_component_transfer_function_element_type_from_attribute(this):
        # https://drafts.fxtf.org/filter-effects/#attr-valuedef-type-identity
        .unknown, .identity:
            for i in 0..<256:
                data[i] = (u8)i
        # https://drafts.fxtf.org/filter-effects/#attr-valuedef-type-table
        .table:
            let table_values = svg_component_transfer_function_element_table_float_values(this)

            # An empty list results in an identity transfer function.
            if ak.vector_is_empty(&table_values):
                for i in 0..<256:
                    data[i] = (u8)i
            else:
                # For a value C < 1 find k such that: k/n <= C < (k+1)/n
                # The result C' is given by: C' = vk + (C - k/n)*n * (vk+1 - vk)
                let segments = f32(ak.vector_size(&table_values)) - 1.0
                for i in 0..<256:
                    # If C = 1 then: C' = vn.
                    if i == 255 or segments == 0.0:
                        data[i] = svg_component_transfer_to_u8(*ak.vector_last_const(&table_values))
                        continue
                    let offset = f32(i) / 255.0
                    let segment_index = (usize)(offset * segments)
                    let segment_start = f32(segment_index) / segments
                    let offset_in_segment = offset - segment_start
                    let segment_length = 1.0 / segments
                    let progress_in_segment = offset_in_segment / segment_length
                    let segment_value = ak.mix_f32(*ak.vector_at_const(&table_values, segment_index), *ak.vector_at_const(&table_values, segment_index + 1), progress_in_segment)
                    data[i] = svg_component_transfer_to_u8(segment_value)
        # https://drafts.fxtf.org/filter-effects/#attr-valuedef-type-discrete
        .discrete:
            let table_values = svg_component_transfer_function_element_table_float_values(this)

            # An empty list results in an identity transfer function.
            if ak.vector_is_empty(&table_values):
                for i in 0..<256:
                    data[i] = (u8)i
            else:
                # For a value C < 1 find k such that: k/n <= C < (k+1)/n
                # The result C' is given by: C' = vk + (C - k/n)*n * (vk+1 - vk)
                for i in 0..<255:
                    let index = (usize)(f32(i) / 255.0 * f32(ak.vector_size(&table_values)))
                    data[i] = svg_component_transfer_to_u8(*ak.vector_at_const(&table_values, index))

                # If C = 1 then: C' = vn.
                data[255] = svg_component_transfer_to_u8(*ak.vector_last_const(&table_values))
        # https://drafts.fxtf.org/filter-effects/#attr-valuedef-type-linear
        .linear:
            let slope = svg_animated_number_base_val(svg_component_transfer_function_element_slope(this))
            let intercept = svg_animated_number_base_val(svg_component_transfer_function_element_intercept(this))
            for i in 0..<256:
                data[i] = svg_component_transfer_to_u8(slope * f32(i) / 255.0 + intercept)
        # https://drafts.fxtf.org/filter-effects/#attr-valuedef-type-gamma
        .gamma:
            let amplitude = svg_animated_number_base_val(svg_component_transfer_function_element_amplitude(this))
            let exponent = svg_animated_number_base_val(svg_component_transfer_function_element_exponent(this))
            let offset = svg_animated_number_base_val(svg_component_transfer_function_element_offset(this))
            for i in 0..<256:
                data[i] = svg_component_transfer_to_u8(amplitude * ak.pow_f32(f32(i) / 255.0, exponent) + offset)
        _: trap("VERIFY_NOT_REACHED")

    this.m_cached_color_table = result
    return ak.byte_buffer_bytes_const(&result)
