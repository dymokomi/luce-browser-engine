#==============================================================================================
#
#   svg_component_transfer_function_element - SVG::SVGComponentTransferFunctionElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGComponentTransferFunctionElement.cpp (lines 1-263): the base of
#       <feFuncR>, <feFuncG>, <feFuncB> and <feFuncA>
#       (https://www.w3.org/TR/filter-effects-1/#InterfaceSVGComponentTransferFunctionElement):
#       the type, tableValues, slope, intercept, amplitude, exponent and offset attributes and
#       the 256-entry color table of the transfer function.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:16 Web::SVG::SVGComponentTransferFunctionElement::SVGComponentTransferFunctionElement.
pub func svg_component_transfer_function_element_construct(this: SvgComponentTransferFunctionElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGComponentTransferFunctionElement's tables (a subclass moves them on).
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_component_transfer_function_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_component_transfer_function_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_component_transfer_function_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_component_transfer_function_element_global_event_handlers_vtable

## `value == "text"sv` of an optional attribute value.
func svg_optional_string_is(value: ak.String?, text: str) -> bool:
    let string = value else return false
    let view = ak.string_bytes_as_string_view(&string)
    return ak.string_view_equals(&view, text)

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:22 Web::SVG::parse_type (static).
# https://drafts.fxtf.org/filter-effects-1/#element-attrdef-fecomponenttransfer-type
func svg_parse_type(value: ak.String?) -> SvgComponentTransferFunctionElementType:
    if svg_optional_string_is(value, "identity"):
        return SvgComponentTransferFunctionElementType.identity
    if svg_optional_string_is(value, "table"):
        return SvgComponentTransferFunctionElementType.table
    if svg_optional_string_is(value, "discrete"):
        return SvgComponentTransferFunctionElementType.discrete
    if svg_optional_string_is(value, "linear"):
        return SvgComponentTransferFunctionElementType.linear
    if svg_optional_string_is(value, "gamma"):
        return SvgComponentTransferFunctionElementType.gamma
    return SvgComponentTransferFunctionElementType.unknown

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:38 Web::SVG::SVGComponentTransferFunctionElement::attribute_changed (override).
pub func svg_component_transfer_function_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgComponentTransferFunctionElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    # FIXME: Support reflection instead of invalidating the enumeration.
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_type):
        this.m_type = none

    # FIXME: Support reflection instead of invalidating the list.
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_table_values):
        this.m_table_values = none

    # Clear our cached color table on any attribute change.
    this.m_cached_color_table = none

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:55 Web::SVG::SVGComponentTransferFunctionElement::initialize (override).
pub func svg_component_transfer_function_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_component_transfer_function_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:61 Web::SVG::SVGComponentTransferFunctionElement::visit_edges (override).
pub func svg_component_transfer_function_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgComponentTransferFunctionElement*)base
    svg_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_type)
    gc.cell_visitor_visit_t(visitor, this.m_table_values)
    gc.cell_visitor_visit_t(visitor, this.m_slope)
    gc.cell_visitor_visit_t(visitor, this.m_intercept)
    gc.cell_visitor_visit_t(visitor, this.m_amplitude)
    gc.cell_visitor_visit_t(visitor, this.m_exponent)
    gc.cell_visitor_visit_t(visitor, this.m_offset)

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:75 Web::SVG::SVGComponentTransferFunctionElement::type.
# https://www.w3.org/TR/filter-effects-1/#dom-svgcomponenttransferfunctionelement-type
# https://drafts.fxtf.org/filter-effects-1/#element-attrdef-fecomponenttransfer-type
pub func svg_component_transfer_function_element_type(this: SvgComponentTransferFunctionElement*) -> SvgAnimatedEnumeration*:
    if this.m_type == none:
        this.m_type = svg_animated_enumeration_create(dom_element_realm(this.dom_element()), (u16)svg_component_transfer_function_element_type_from_attribute(this))
    return this.m_type else trap("VERIFY: m_type")

## Ported from Libraries/LibWeb/SVG/SVGComponentTransferFunctionElement.cpp:84 Web::SVG::SVGComponentTransferFunctionElement::table_values.
# https://www.w3.org/TR/filter-effects-1/#dom-svgcomponenttransferfunctionelement-tablevalues
# https://drafts.fxtf.org/filter-effects-1/#element-attrdef-fecomponenttransfer-tablevalues
pub func svg_component_transfer_function_element_table_values(this: SvgComponentTransferFunctionElement*) -> SvgAnimatedNumberList*:
    if this.m_table_values == none:
        let realm = dom_element_realm(this.dom_element())
        let attribute = dom_element_get_attribute_value(this.dom_element(), svg_attribute_names_table_values)
        let numbers = svg_attribute_parser_parse_table_values(ak.string_bytes_as_string_view(&attribute))
        var items = ak.Vector[SvgNumber*]()
        ak.vector_ensure_capacity(&items, ak.vector_size(&numbers))
        for number in ak.vector_span_const(&numbers):
            ak.vector_append_t(&items, svg_number_create(realm, number, SvgNumberReadOnly.yes))
        let number_list = svg_number_list_create_vector(realm, items, SvgReadOnlyList.yes)
        this.m_table_values = svg_animated_number_list_create(realm, number_list)
    return this.m_table_values else trap("VERIFY: m_table_values")

## A lazily created SVGAnimatedNumber reflecting `name` with the initial value `initial_value`.
func svg_component_transfer_function_element_animated_number(this: SvgComponentTransferFunctionElement*, name: ak.FlyString, initial_value: f32) -> SvgAnimatedNumber*:
    var qualified_name: DomQualifiedName = ---
    dom_qualified_name_construct(&qualified_name, name, none, none)
    return svg_animated_number_create(dom_element_realm(this.dom_element()), this.svg_element(), qualified_name, initial_value)

