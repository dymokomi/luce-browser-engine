#==============================================================================================
#
#   svg_title_element - SVG::SVGTitleElement: <title>, the title of an SVG document or element
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGTitleElement.cpp with the inline members of SVGTitleElement.h: it has no layout box.
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGTitleElement.cpp:17 Web::SVG::SVGTitleElement::SVGTitleElement.
pub func svg_title_element_construct(this: SvgTitleElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGTitleElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_title_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_title_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_title_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_title_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGTitleElement.cpp:22 Web::SVG::SVGTitleElement::initialize (override).
pub func svg_title_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_title_element)
    svg_element_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/SVG/SVGTitleElement.cpp:28 Web::SVG::SVGTitleElement::create_layout_node (override).
pub func svg_title_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    return none

## Ported from Libraries/LibWeb/SVG/SVGTitleElement.cpp:33 Web::SVG::SVGTitleElement::children_changed (override).
pub func svg_title_element_children_changed_impl(base: DomNode*, metadata: DomNodeChildrenChangedMetadata):
    svg_element_children_changed_impl(base, metadata)

    let document = dom_node_document(base)
    let page = dom_document_page(document)
    if dom_document_browsing_context(document) != page_top_level_browsing_context(page):
        return

    let document_element = dom_document_document_element(document)
    if let element = document_element:
        if element.dom_node() == tree_node_parent(base) and is_svg_element(element):
            page_client_page_did_change_title(page_client(page), dom_document_title(document))
