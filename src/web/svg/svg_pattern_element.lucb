#==============================================================================================
#
#   svg_pattern_element - SVG::SVGPatternElement: <pattern>
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGPatternElement.cpp (lines 1-387) with the inline members of
#       SVGPatternElement.h (https://svgwg.org/svg2-draft/pservers.html#Patterns): the
#       patternUnits, patternContentUnits, patternTransform, x, y, width and height attributes
#       (each inherited through the href chain of linked patterns, as is the element whose
#       children are the content), and the pattern paint style: the pattern box's content
#       recorded into a tile display list.
#
#       `HashTable<SVGPatternElement const*>` of seen patterns is SvgPatternElementSet.
#
#==============================================================================================

## `HashTable<SVGPatternElement const*>`: the patterns an href chain has visited.
type SvgPatternElementSet = ak.HashTable[SvgPatternElement*, ak.PtrTraits[SvgPatternElement]]

# mark: Construction and attributes ==============================================================

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:29 Web::SVG::SVGPatternElement::SVGPatternElement.
pub func svg_pattern_element_construct(this: SvgPatternElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_element_construct(this.svg_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGPatternElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_pattern_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_pattern_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_pattern_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_pattern_element_global_event_handlers_vtable
    this.svg_fit_to_view_box.vtable = &svg_pattern_element_svg_fit_to_view_box_vtable
    this.svg_fit_to_view_box.class_id = this.cell().class_id

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:34 Web::SVG::SVGPatternElement::initialize (override).
pub func svg_pattern_element_initialize_impl(base: JsCell*, realm: Realm*):
    let this = (SvgPatternElement*)base
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_pattern_element)
    svg_element_initialize_impl(base, realm)
    svg_fit_to_view_box_initialize(&this.svg_fit_to_view_box, realm)

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:41 Web::SVG::SVGPatternElement::visit_edges (override).
pub func svg_pattern_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgPatternElement*)base
    svg_element_visit_edges_impl(base, visitor)
    svg_svguri_reference_mixin_visit_edges(&this.svguri_reference_mixin, visitor)
    svg_fit_to_view_box_visit_edges(&this.svg_fit_to_view_box, visitor)

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:48 Web::SVG::SVGPatternElement::attribute_changed (override).
pub func svg_pattern_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (SvgPatternElement*)base
    svg_element_attribute_changed_impl(base, name, old_value, value, namespace_)
    svg_fit_to_view_box_attribute_changed(&this.svg_fit_to_view_box, base, name, value)

    let value_text = value else ak.String()  # value.value_or(String {})
    let value_view = ak.string_bytes_as_string_view(&value_text)
    if ak.fly_string_eq_fly_string(&name, &svg_attribute_names_pattern_units):
        this.m_pattern_units = svg_attribute_parser_parse_units(value_view)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_pattern_content_units):
        this.m_pattern_content_units = svg_attribute_parser_parse_units(value_view)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_pattern_transform):
        if let transform_list = svg_attribute_parser_parse_transform_string_view(value_view):
            this.m_pattern_transform = svg_transform_from_transform_list(ak.vector_span_const(&transform_list))
        else:
            this.m_pattern_transform = none
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_x):
        this.m_x = svg_attribute_parser_parse_number_percentage(value_view)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_y):
        this.m_y = svg_attribute_parser_parse_number_percentage(value_view)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_width):
        this.m_width = svg_attribute_parser_parse_number_percentage(value_view)
    elif ak.fly_string_eq_fly_string(&name, &svg_attribute_names_height):
        this.m_height = svg_attribute_parser_parse_number_percentage(value_view)

# mark: The href chain ===========================================================================

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:74 Web::SVG::SVGPatternElement::linked_pattern.
func svg_pattern_element_linked_pattern(this: SvgPatternElement*, seen_patterns: SvgPatternElementSet*) -> SvgPatternElement*?:
    # FIXME: This can only resolve same-document references. The spec allows cross-document references.
    let element_this = this.dom_element()
    let link = dom_element_get_attribute(element_this, svg_attribute_names_href) if dom_element_has_attribute(element_this, svg_attribute_names_href) else dom_element_get_attribute(element_this, ak.fly_string_from_str("xlink:href"))
    let href = link else return none
    if ak.string_is_empty(&href):
        return none

    let document = dom_node_document(this.dom_node())
    let url = dom_document_encoding_parse_url(document, ak.string_bytes_as_string_view(&href)) else return none

    let id = web_url.url_fragment(&url) else return none
    if ak.string_is_empty(&id):
        return none

    let element = dom_parent_node_get_element_by_id(document.dom_parent_node(), ak.fly_string_from_string(id)) else return none

    if element.dom_node() == this.dom_node():
        return none
    let pattern = as_if_svg_pattern_element(element) else return none

    # Detect circular references in the template chain.
    if ak.hash_table_set(seen_patterns, pattern) != ak.HashSetResult.inserted_new_entry:
        return none

    return pattern

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:106 Web::SVG::SVGPatternElement::pattern_content_element.
pub func svg_pattern_element_pattern_content_element(this: SvgPatternElement*) -> SvgPatternElement*?:
    var seen_patterns: SvgPatternElementSet
    return svg_pattern_element_pattern_content_element_impl(this, &seen_patterns)

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:112 Web::SVG::SVGPatternElement::pattern_content_element_impl.
func svg_pattern_element_pattern_content_element_impl(this: SvgPatternElement*, seen_patterns: SvgPatternElementSet*) -> SvgPatternElement*?:
    if dom_parent_node_child_element_count(this.dom_parent_node()) > 0:
        return this
    if let pattern = svg_pattern_element_linked_pattern(this, seen_patterns):
        return svg_pattern_element_pattern_content_element_impl(pattern, seen_patterns)
    return none

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:122 Web::SVG::SVGPatternElement::pattern_units.
# https://svgwg.org/svg2-draft/pservers.html#PatternElementPatternUnitsAttribute
pub func svg_pattern_element_pattern_units(this: SvgPatternElement*) -> SvgUnits:
    var seen_patterns: SvgPatternElementSet
    return svg_pattern_element_pattern_units_impl(this, &seen_patterns)

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:128 Web::SVG::SVGPatternElement::pattern_units_impl.
func svg_pattern_element_pattern_units_impl(this: SvgPatternElement*, seen_patterns: SvgPatternElementSet*) -> SvgUnits:
    if let value = this.m_pattern_units:
        return value
    if let pattern = svg_pattern_element_linked_pattern(this, seen_patterns):
        return svg_pattern_element_pattern_units_impl(pattern, seen_patterns)
    # Initial value: objectBoundingBox
    return SvgUnits.object_bounding_box

