# mark: The paint style ==========================================================================

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:235 Web::SVG::SVGPatternElement::to_gfx_paint_style.
pub func svg_pattern_element_to_gfx_paint_style(this: SvgPatternElement*, paint_context: SvgPaintContext, recording_context: DisplayListRecordingContext*, target_layout_node: LayoutNode*) -> display_list.SvgPaintServerPaintStyle*?:
    let content_element = svg_pattern_element_pattern_content_element(this) else return none

    var pattern_box: LayoutSvgPatternBox*? = none
    # target_layout_node.for_each_child_of_type<Layout::SVGPatternBox>(...)
    for child in layout_node_children(target_layout_node):
        if let candidate = as_if_layout_svg_pattern_box(child):
            if layout_svg_pattern_box_dom_node(candidate).dom_node() == content_element.dom_node():
                pattern_box = candidate
                break
    let found_pattern_box = pattern_box else return none

    let pattern_paintable = layout_box_paintable_box(found_pattern_box.layout_box()) else return none

    var tile_x: f32 = 0.0
    var tile_y: f32 = 0.0
    var tile_width: f32 = 0.0
    var tile_height: f32 = 0.0
    if svg_pattern_element_pattern_units(this) == SvgUnits.object_bounding_box:
        # For objectBoundingBox, values are fractions of the bounding box.
        # NumberPercentage::value() already normalizes percentages to 0-1 range.
        let bbox = &paint_context.path_bounding_box
        let pattern_x = svg_pattern_element_pattern_x(this)
        let pattern_y = svg_pattern_element_pattern_y(this)
        let pattern_width = svg_pattern_element_pattern_width(this)
        let pattern_height = svg_pattern_element_pattern_height(this)
        tile_x = svg_number_percentage_value(&pattern_x) * gfx.float_rect_width(bbox) + gfx.float_rect_x(bbox)
        tile_y = svg_number_percentage_value(&pattern_y) * gfx.float_rect_height(bbox) + gfx.float_rect_y(bbox)
        tile_width = svg_number_percentage_value(&pattern_width) * gfx.float_rect_width(bbox)
        tile_height = svg_number_percentage_value(&pattern_height) * gfx.float_rect_height(bbox)
    else:
        # For userSpaceOnUse, resolve percentages relative to the viewport.
        let viewport = &paint_context.viewport
        let pattern_x = svg_pattern_element_pattern_x(this)
        let pattern_y = svg_pattern_element_pattern_y(this)
        let pattern_width = svg_pattern_element_pattern_width(this)
        let pattern_height = svg_pattern_element_pattern_height(this)
        tile_x = svg_number_percentage_resolve_relative_to(&pattern_x, gfx.float_rect_width(viewport))
        tile_y = svg_number_percentage_resolve_relative_to(&pattern_y, gfx.float_rect_height(viewport))
        tile_width = svg_number_percentage_resolve_relative_to(&pattern_width, gfx.float_rect_width(viewport))
        tile_height = svg_number_percentage_resolve_relative_to(&pattern_height, gfx.float_rect_height(viewport))

    if tile_width <= 0.0 or tile_height <= 0.0:
        return none

    let unmapped_tile_rect = gfx.FloatRect(m_location = gfx.FloatPoint(m_x = tile_x, m_y = tile_y), m_size = gfx.FloatSize(m_width = tile_width, m_height = tile_height))
    var tile_rect = gfx.affine_transform_map_f32_float_rect(&paint_context.paint_transform, unmapped_tile_rect)

    if gfx.float_rect_is_empty(&tile_rect):
        return none

    let svg_node = (LayoutSvgsvgBox*?)tree_node_first_ancestor_of_type(target_layout_node, &layout_svgsvg_box_class) else return none
    let svg_paintable_box = layout_box_paintable_box(svg_node.layout_box()) else return none
    let svg_element_rect = paint_paintable_box_absolute_rect(svg_paintable_box)
    let rounded_svg_offset = display_list_recording_context_rounded_device_point(recording_context, svg_element_rect.m_location)
    let svg_offset = gfx.int_point_to_type_f32(&rounded_svg_offset)
    gfx.float_rect_translate_by_float_point(&tile_rect, svg_offset)

    let tile_display_list = display_list.display_list_create(display_list.accumulated_visual_context_tree_create())
    var display_list_recorder = display_list.display_list_recorder_new(tile_display_list)
    let mapped_origin = gfx.affine_transform_map_f32_float_point(&paint_context.paint_transform, gfx.FloatPoint(m_x = 0.0, m_y = 0.0))
    let content_origin = gfx.float_point_add(&mapped_origin, svg_offset)
    let content_origin_int = gfx.float_point_to_type_i32(&content_origin)
    display_list.display_list_recorder_translate(&display_list_recorder, gfx.int_point_neg(&content_origin_int))
    var paint_context_copy = display_list_recording_context_clone(recording_context, &display_list_recorder)

    var target_svg_transform = layout_identity_affine_transform()  # Gfx::AffineTransform target_svg_transform;
    let first_paintable = layout_node_first_paintable(target_layout_node) else trap("VERIFY: target_layout_node.first_paintable()")
    if let svg_graphics_paintable = as_if_paint_svg_graphics_paintable(first_paintable):
        let computed_transforms = paint_svg_graphics_paintable_computed_transforms(svg_graphics_paintable)
        target_svg_transform = paint_svg_graphics_paintable_computed_transforms_svg_transform(&computed_transforms)
    display_list_recording_context_set_svg_transform(&paint_context_copy, target_svg_transform)

    paint_stacking_context_paint_svg(&paint_context_copy, pattern_paintable, PaintPhase.foreground)

    var user_space_pattern_transform: gfx.AffineTransform? = none
    let computed_properties = dom_element_computed_properties(this.dom_element()) else trap("VERIFY: computed_properties()")
    var css_transformations = css_computed_properties_transformations(computed_properties)
    if not ak.vector_is_empty(&css_transformations):
        var matrix = gfx.float_matrix4_x4_identity()
        var transform_valid = true
        for css_transform in ak.vector_span(&css_transformations):
            let result = css_transformation_style_value_to_matrix(css_transform, pattern_paintable) catch:
                transform_valid = false
                break
            matrix = gfx.float_matrix4_x4_mul(&matrix, result)
        if transform_valid:
            user_space_pattern_transform = gfx.extract_2d_affine_transform(&matrix)
    else:
        user_space_pattern_transform = svg_pattern_element_pattern_transform(this)

    var device_pattern_transform: gfx.AffineTransform? = none
    if let user_space_transform = user_space_pattern_transform:
        if gfx.affine_transform_inverse(&user_space_transform) == none:
            return none
        # patternTransform is defined in user space, but the tile rect and shader operate in device pixel space.
        # Convert by conjugating with paint_transform.
        if let inv = gfx.affine_transform_inverse(&paint_context.paint_transform):
            var transform = paint_context.paint_transform
            gfx.affine_transform_multiply(&transform, user_space_transform)
            gfx.affine_transform_multiply(&transform, inv)
            device_pattern_transform = transform

    # (the display list's upcasts are private to it: an embedded base is first, so a cast is the upcast)
    return (display_list.SvgPaintServerPaintStyle*)display_list.svg_pattern_paint_style_create(tile_display_list, tile_rect, device_pattern_transform)

# mark: The SVG DOM ==============================================================================

## Ported from Libraries/LibWeb/SVG/SVGPatternElement.cpp:340 Web::SVG::SVGPatternElement::x.
# https://svgwg.org/svg2-draft/pservers.html#PatternElementXAttribute
pub func svg_pattern_element_x(this: SvgPatternElement*) -> SvgAnimatedLength*:
    # FIXME: Populate the unit type when it is parsed (0 here is "unknown").
    # FIXME: Create a proper animated value when animations are supported.
    let realm = dom_element_realm(this.dom_element())
    let base_length = svg_length_create(realm, 0, svg_number_percentage_or_zero_value(this.m_x), SvgLengthReadOnly.no)
    let anim_length = svg_length_create(realm, 0, svg_number_percentage_or_zero_value(this.m_x), SvgLengthReadOnly.yes)
    return svg_animated_length_create(realm, base_length, anim_length)

