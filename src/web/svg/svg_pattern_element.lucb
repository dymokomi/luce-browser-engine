## Ported from Libraries/LibWeb/SVG/SVGPatternElement.h:48 Web::SVG::SVGPatternElement::create_layout_node (override).
pub func svg_pattern_element_create_layout_node_impl(base: DomElement*, arg0: CssComputedProperties*) -> LayoutNode*?:
    return none
