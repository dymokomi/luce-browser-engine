## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:15 Web::SVG::SVGNumberList::create.
pub func svg_number_list_create_vector(realm: Realm*, items: ak.Vector[SvgNumber*], read_only: SvgReadOnlyList) -> SvgNumberList*:
    return realm_create_svg_number_list_vector(realm, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:20 Web::SVG::SVGNumberList::create.
pub func svg_number_list_create_svg_read_only_list(realm: Realm*, read_only: SvgReadOnlyList) -> SvgNumberList*:
    return realm_create_svg_number_list_svg_read_only_list(realm, realm, read_only)

## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:25 Web::SVG::SVGNumberList::SVGNumberList.
pub func svg_number_list_construct_vector(this: SvgNumberList*, realm: Realm*, items: ak.Vector[SvgNumber*], read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    svg_list_construct_vector(&this.svg_list, realm, items, read_only)

## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:31 Web::SVG::SVGNumberList::SVGNumberList.
pub func svg_number_list_construct_svg_read_only_list(this: SvgNumberList*, realm: Realm*, read_only: SvgReadOnlyList):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    svg_list_construct_svg_read_only_list(&this.svg_list, realm, read_only)

## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:37 Web::SVG::SVGNumberList::initialize (override).
pub func svg_number_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svg_number_list)
    js_cell_initialize_impl(base, realm)

## visitor.visit(GC::Ref<SvgNumber>): one item of the list.
func svg_number_list_visit_item(visitor: gc.CellVisitor*, item: SvgNumber*):
    gc.cell_visitor_visit_t_2(visitor, item)

## Ported from Libraries/LibWeb/SVG/SVGNumberList.cpp:43 Web::SVG::SVGNumberList::visit_edges (override).
pub func svg_number_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (SvgNumberList*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    svg_list_visit_edges(&this.svg_list, visitor, svg_number_list_visit_item)
