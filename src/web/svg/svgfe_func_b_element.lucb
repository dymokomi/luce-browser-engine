#   svgfe_func_b_element - SVG::SVGFEFuncBElement
#
#   DESCRIPTION:
#       Port of LibWeb/SVG/SVGFEFuncBElement.cpp (lines 1-25) with the inline members of SVGFEFuncBElement.h.
#       (https://drafts.fxtf.org/filter-effects/#feFuncBElement): a transfer function (its
#       behaviour is SVGComponentTransferFunctionElement's).
#
#==============================================================================================

## Ported from Libraries/LibWeb/SVG/SVGFEFuncBElement.cpp:14 Web::SVG::SVGFEFuncBElement::SVGFEFuncBElement.
pub func svg_svgfe_func_b_element_construct(this: SvgSvgfeFuncBElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    svg_component_transfer_function_element_construct(this.svg_component_transfer_function_element(), document, qualified_name)
    # The vptrs of the mixin bases move to SVGFEFuncBElement's tables.
    let element = this.svg_element()
    element.element.slottable_mixin.vtable = &svg_svgfe_func_b_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &svg_svgfe_func_b_element_aria_mixin_vtable
    element.element.animatable.vtable = &svg_svgfe_func_b_element_animatable_vtable
    element.global_event_handlers.vtable = &svg_svgfe_func_b_element_global_event_handlers_vtable

## Ported from Libraries/LibWeb/SVG/SVGFEFuncBElement.cpp:19 Web::SVG::SVGFEFuncBElement::initialize (override).
pub func svg_svgfe_func_b_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.svgfe_func_b_element)
    svg_component_transfer_function_element_initialize_impl(base, realm)
