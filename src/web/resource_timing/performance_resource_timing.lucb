## Ported from PerformanceResourceTiming.h:32 Web::ResourceTiming::PerformanceResourceTiming::available_from_timeline.
pub func resource_timing_performance_resource_timing_available_from_timeline() -> PerformanceTimelineAvailableFromTimeline:
    return PerformanceTimelineAvailableFromTimeline.yes

## Ported from PerformanceResourceTiming.h:35 Web::ResourceTiming::PerformanceResourceTiming::max_buffer_size.
## https://w3c.github.io/timing-entrytypes-registry/#dfn-maxbuffersize
pub func resource_timing_performance_resource_timing_max_buffer_size() -> u64?:
    return 250

## Ported from PerformanceResourceTiming.h:38 Web::ResourceTiming::PerformanceResourceTiming::should_add_entry (override).
## https://w3c.github.io/timing-entrytypes-registry/#dfn-should-add-entry
pub func resource_timing_performance_resource_timing_should_add_entry_impl(this: PerformanceTimelinePerformanceEntry*) -> PerformanceTimelineShouldAddEntry:
    return PerformanceTimelineShouldAddEntry.yes

## Ported from PerformanceResourceTiming.cpp:16 Web::ResourceTiming::PerformanceResourceTiming::PerformanceResourceTiming.
pub func resource_timing_performance_resource_timing_construct(this: ResourceTimingPerformanceResourceTiming*, realm: Realm*, name: ak.String, start_time: f64, duration: f64, timing_info: FetchTimingInfo*):
    performance_timeline_performance_entry_construct(&this.entry, realm, name, start_time, duration)
    this.m_timing_info = timing_info

## Ported from PerformanceResourceTiming.cpp:25 Web::ResourceTiming::PerformanceResourceTiming::entry_type (override).
