## AK::Traits<LayoutTableGridGridPosition>: AK's hash and equality for the key type.
pub struct LayoutTableGridGridPositionTraits: ak.Traits[LayoutTableGridGridPosition]:
    var empty_: u8

    # Ported from Libraries/LibWeb/Layout/TableGrid.h:104 AK::Traits<Web::Layout::TableGrid::GridPosition>::hash (pair_int_hash
    # takes the coordinates as unsigned ints).
    func hash_of(key: const LayoutTableGridGridPosition*) -> u32: return ak.pair_int_hash((u32)key.x, (u32)key.y)

    # `bool operator==(GridPosition const&) const = default;` (TableGrid.h:19).
    func equals(a: const LayoutTableGridGridPosition*, b: const LayoutTableGridGridPosition*) -> bool: return *a == *b

## AK::Traits<PlatformGenericFontKey>: AK's hash and equality for the key type.
pub struct PlatformGenericFontKeyTraits: ak.Traits[PlatformGenericFontKey]:
    var empty_: u8

    # Ported from Libraries/LibWeb/Platform/FontPlugin.h:73 AK::Traits<Web::Platform::GenericFontKey>::hash.
    func hash_of(key: const PlatformGenericFontKey*) -> u32:
        return ak.pair_int_hash(ak.pair_int_hash((u32)key.generic_font, (u32)key.weight), (u32)key.slope)

    # `bool operator==(GenericFontKey const&) const = default;` (FontPlugin.h:38).
    func equals(a: const PlatformGenericFontKey*, b: const PlatformGenericFontKey*) -> bool: return *a == *b

