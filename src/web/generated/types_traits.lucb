#==============================================================================================
#
#   types_traits - hash traits of the key types of HashMap/HashTable instantiations
#
#   DESCRIPTION:
#       Generated by the skeleton generator (DESIGN.md §2.6): one declaration per distinct
#       instantiation the phase-1 declarations use, at donor commit 47c82b38d0.
#
#==============================================================================================

## AK::Traits<AriaRole>: AK's hash and equality for the key type (filled by hand, r13b: Traits<Enum>
## hashes the underlying int with u32_hash, AK's int_hash).
pub struct AriaRoleTraits: ak.Traits[AriaRole]:
    var empty_: u8

    func hash_of(key: const AriaRole*) -> u32: return ak.u32_hash((u32)(i32)*key)

    func equals(a: const AriaRole*, b: const AriaRole*) -> bool: return *a == *b

