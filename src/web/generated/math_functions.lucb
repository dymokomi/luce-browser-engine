# mark: parse_rounding_strategy =================================================================

## Ported from Build/Libraries/LibWeb/CSS/MathFunctions.cpp Web::CSS::Parser::parse_rounding_strategy.
func css_parse_rounding_strategy(stream: css_syntax.TokenStream[css_syntax.ComponentValue]*) -> css_data.RoundingStrategy?:
    css_syntax.token_stream_discard_whitespace(stream)
    if not css_syntax.token_stream_has_next_token(stream):
        return none

    let ident = css_syntax.token_stream_consume_a_token(stream)
    if not css_syntax.component_value_is(&ident, .ident):
        return none

    css_syntax.token_stream_discard_whitespace(stream)
    if css_syntax.token_stream_has_next_token(stream):
        return none

    let name = css_component_value_ident(&ident)
    let maybe_keyword = css_data.keyword_from_string(ak.fly_string_bytes_as_string_view(&name)) else return none

    return css_data.keyword_to_rounding_strategy(maybe_keyword)

## `ErrorReporter::the().report(InvalidValueError { .value_type = "<name>()"_fly_string,
## .value_string = stream.dump_string(), .description })`, which every branch makes.
func css_math_function_report_invalid_value(value_type: str, stream: css_syntax.TokenStream[css_syntax.ComponentValue]*, description: ak.String):
    css_error_reporter_report(css_error_reporter_the(), CssParsingError.css_invalid_value_error(CssInvalidValueError(
        value_type = ak.fly_string_from_str(value_type),
        value_string = css_syntax.token_stream_dump_string(stream),
        description = description,
    )))

