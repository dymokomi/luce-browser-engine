## Ported from Build/Libraries/LibWeb/CSS/EnvironmentVariable.cpp Web::CSS::environment_variable_type.
pub func css_environment_variable_type(environment_variable: css_data.EnvironmentVariable) -> CssValueType:
    match environment_variable:
        .preferred_text_scale:
            return CssValueType.number
        .safe_area_inset_bottom:
            return CssValueType.length
        .safe_area_inset_left:
            return CssValueType.length
        .safe_area_inset_right:
            return CssValueType.length
        .safe_area_inset_top:
            return CssValueType.length
        .safe_area_max_inset_bottom:
            return CssValueType.length
        .safe_area_max_inset_left:
            return CssValueType.length
        .safe_area_max_inset_right:
            return CssValueType.length
        .safe_area_max_inset_top:
            return CssValueType.length
        .viewport_segment_bottom:
            return CssValueType.length
        .viewport_segment_height:
            return CssValueType.length
        .viewport_segment_left:
            return CssValueType.length
        .viewport_segment_right:
            return CssValueType.length
        .viewport_segment_top:
            return CssValueType.length
        .viewport_segment_width:
            return CssValueType.length
        _:
            trap("VERIFY_NOT_REACHED")
