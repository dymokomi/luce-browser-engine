# mark: property_initial_value ==================================================================

# The `static Array<RefPtr<StyleValue const>, to_underlying(last_property_id) + 1> initial_values` of
# property_initial_value.
var css_property_initial_values: (CssStyleValue*?)[386]

## One case of property_initial_value: `parse_css_value(parsing_params, text, property_id)`, which must
## succeed, kept in the static array. Everything the parse allocates is made in the C heap.
func css_parse_property_initial_value(property_id: css_data.PropertyId, text: str) -> CssStyleValue*:
    let saved_atomic_allocator = ak.atomic_allocator
    ak.atomic_allocator = none
    defer ak.atomic_allocator = saved_atomic_allocator
    with memory.heap:
        var parsing_params: CssParsingParams = ---
        css_parsing_params_construct_css_parsing_mode(&parsing_params)
        let parsed_value = parse_css_value(parsing_params, ak.sv(text), property_id)
        let initial_value = parsed_value else trap("VERIFY: !parsed_value.is_null()")
        css_property_initial_values[(usize)property_id] = initial_value
        return initial_value

## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::property_initial_value.
pub func css_property_initial_value(property_id: css_data.PropertyId) -> CssStyleValue*:
    if let initial_value = css_property_initial_values[(usize)property_id]:
        return initial_value

    # Lazily parse initial values as needed.
    # This ensures the shorthands will always be able to get the initial values of their longhands.
    # This also now allows a longhand have its own longhand (like background-position-x).

    match property_id:
        .webkit_text_fill_color:
            return css_parse_property_initial_value(css_data.PropertyId.webkit_text_fill_color, "currentColor")
        .accent_color:
            return css_parse_property_initial_value(css_data.PropertyId.accent_color, "auto")
