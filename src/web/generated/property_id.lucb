# mark: property_accepts_type ===================================================================

## Ported from Build/Libraries/LibWeb/CSS/PropertyID.cpp Web::CSS::property_accepts_type.
pub func css_property_accepts_type(property_id: css_data.PropertyId, value_type: CssValueType) -> bool:
    match property_id:
        .webkit_text_fill_color:
            match value_type:
                .color:
                    return true
                _:
                    return false
        .accent_color:
            match value_type:
                .color:
                    return true
                _:
                    return false
        .align_content:
            return false
        .align_items:
            return false
        .align_self:
            return false
        .anchor_name:
            match value_type:
                .dashed_ident:
                    return true
                _:
                    return false
        .anchor_scope:
            match value_type:
                .dashed_ident:
                    return true
                _:
                    return false
        .animation_composition:
            return false
        .animation_delay:
            match value_type:
                .time:
                    return true
                _:
                    return false
        .animation_duration:
            match value_type:
                .time:
                    return true
                _:
                    return false
        .animation_iteration_count:
            match value_type:
                .number:
                    return true
                _:
                    return false
        .animation_name:
            match value_type:
                .string, .custom_ident:
                    return true
                _:
                    return false
        .animation_timeline:
            match value_type:
                .dashed_ident, .scroll_function, .view_function:
                    return true
                _:
                    return false
        .animation_timing_function:
            match value_type:
                .easing_function:
                    return true
                _:
                    return false
        .appearance:
            return false
        .aspect_ratio:
            match value_type:
                .ratio:
                    return true
                _:
                    return false
        .background_attachment:
            return false
        .background_blend_mode:
            return false
        .background_clip:
            return false
        .background_color:
            match value_type:
                .color:
                    return true
                _:
                    return false
        .background_image:
            match value_type:
                .image:
                    return true
                _:
                    return false
        .background_origin:
            return false
        .background_position:
            match value_type:
                .background_position:
