pub func aria_status_default_value_for_property_or_state_impl(base: AriaRoleType*, state_or_property: AriaStateAndProperties) -> AriaDefaultValueType:
    match state_or_property:
        .aria_live:
            return AriaDefaultValueType.aria_live(AriaLive.polite)
        .aria_atomic:
            return AriaDefaultValueType.bool_(true)
        _:
            return AriaDefaultValueType.empty

