# The `static Array<Array<RefPtr<StyleValue const>, 37>, 5> initial_values` of descriptor_initial_value.
var css_descriptor_initial_values: ((CssStyleValue*?)[37])[5]

## One case of descriptor_initial_value: `parse_css_descriptor(parsing_params, at_rule_id,
## DescriptorNameAndID::from_id(descriptor_id), text)`, which must succeed, kept in the static array.
## Everything the parse allocates is made in the C heap.
func css_parse_descriptor_initial_value(at_rule_id: css_data.AtRuleId, descriptor_id: css_data.DescriptorId, text: str) -> CssStyleValue*:
    let saved_atomic_allocator = ak.atomic_allocator
    ak.atomic_allocator = none
    defer ak.atomic_allocator = saved_atomic_allocator
    with memory.heap:
        var parsing_params: CssParsingParams = ---
        css_parsing_params_construct_css_parsing_mode(&parsing_params)
        let parsed_value = parse_css_descriptor(parsing_params, at_rule_id, css_descriptor_name_and_id_from_id(descriptor_id), ak.sv(text))
        let initial_value = parsed_value else trap("VERIFY: !parsed_value.is_null()")
        css_descriptor_initial_values[(usize)at_rule_id][(usize)descriptor_id] = initial_value
        return initial_value

## Ported from Build/Libraries/LibWeb/CSS/DescriptorID.cpp Web::CSS::descriptor_initial_value.
pub func css_descriptor_initial_value(at_rule_id: css_data.AtRuleId, descriptor_id: css_data.DescriptorId) -> CssStyleValue*?:
    if not css_data.at_rule_supports_descriptor(at_rule_id, descriptor_id):
        return none

    if let initial_value = css_descriptor_initial_values[(usize)at_rule_id][(usize)descriptor_id]:
        return initial_value

    # Lazily parse initial values as needed.

    match at_rule_id:
        .font_face:
            match descriptor_id:
                .ascent_override:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.ascent_override, "normal")
                .descent_override:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.descent_override, "normal")
                .font_display:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_display, "auto")
                .font_family:
                    return none
                .font_feature_settings:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_feature_settings, "normal")
                .font_language_override:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_language_override, "normal")
                .font_named_instance:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_named_instance, "auto")
                .font_style:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_style, "auto")
                .font_variation_settings:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_variation_settings, "normal")
                .font_weight:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_weight, "auto")
                .font_width:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.font_width, "auto")
                .line_gap_override:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.line_gap_override, "normal")
                .src:
                    return none
                .unicode_range:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.font_face, css_data.DescriptorId.unicode_range, "U+0-10FFFF")
                _:
                    trap("VERIFY_NOT_REACHED")
        .page:
            match descriptor_id:
                .bleed:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.bleed, "auto")
                .margin:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.margin, "0")
                .margin_bottom:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.margin_bottom, "0")
                .margin_left:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.margin_left, "0")
                .margin_right:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.margin_right, "0")
                .margin_top:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.margin_top, "0")
                .marks:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.marks, "none")
                .page_orientation:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.page_orientation, "upright")
                .size:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.page, css_data.DescriptorId.size, "auto")
                _:
                    trap("VERIFY_NOT_REACHED")
        .property:
            match descriptor_id:
                .inherits:
                    return none
                .initial_value:
                    return none
                .syntax:
                    return none
                _:
                    trap("VERIFY_NOT_REACHED")
        .counter_style:
            match descriptor_id:
                .system:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.system, "symbolic")
                .negative:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.negative, "-")
                .prefix:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.prefix, "")
                .suffix:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.suffix, ". ")
                .range:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.range, "auto")
                .pad_:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.pad_, "0 \"\"")
                .fallback:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.fallback, "decimal")
                .symbols:
                    return none
                .additive_symbols:
                    return none
                .speak_as:
                    return css_parse_descriptor_initial_value(css_data.AtRuleId.counter_style, css_data.DescriptorId.speak_as, "auto")
                _:
                    trap("VERIFY_NOT_REACHED")
        .function:
            match descriptor_id:
                .result:
                    return none
                _:
                    trap("VERIFY_NOT_REACHED")
        _:
            trap("VERIFY_NOT_REACHED")
