#==============================================================================================
#
#   element_8 - DOM::Element: the reflected ARIA attributes
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Element.cpp (lines 2965-2979): the getter and setter Element
#       defines for every attribute of ENUMERATE_ARIA_ATTRIBUTES (ARIA/AttributeNames.h), in
#       the macro's order. Each overrides an ARIA::ARIAMixin virtual and reaches the element
#       from its embedded mixin.
#
#==============================================================================================

# mark: The element of a mixin ==================================================================

## The Element whose ARIAMixin base `base` is (C++'s implicit `this` adjustment, DESIGN.md §2.5): the
## mixin sits at the same offset in every subclass, since each embeds Element first.
pub func dom_element_from_aria_mixin(base: AriaMixin*) -> DomElement*:
    return (DomElement*)((u8*)base - memory.offset_of(DomElement, aria_mixin))

# mark: ENUMERATE_ARIA_ATTRIBUTES ===============================================================

## Ported from Element.cpp:2978 Web::DOM::Element::role (override; ENUMERATE_ARIA_ATTRIBUTES).
pub func dom_element_role_impl(base: AriaMixin*) -> ak.String?:
    return dom_element_get_attribute(dom_element_from_aria_mixin(base), aria_attribute_names_role)

## Ported from Element.cpp:2978 Web::DOM::Element::set_role (override; ENUMERATE_ARIA_ATTRIBUTES).
pub func dom_element_set_role_impl(base: AriaMixin*, value: ak.String?):
    let this = dom_element_from_aria_mixin(base)
    if let present = value:
        dom_element_set_attribute_value(this, aria_attribute_names_role, present)
    else:
        dom_element_remove_attribute(this, aria_attribute_names_role)

