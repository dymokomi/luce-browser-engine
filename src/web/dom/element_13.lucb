#==============================================================================================
#
#   element_13 - DOM::Element: the inline functions of Element.h
#
#   DESCRIPTION:
#       Port of the inline member functions of LibWeb/DOM/Element.h (lines 122-616 and
#       776-811), in the header's order: names and the qualified name, the trivial virtuals,
#       the style and invalidation flags, the shadow root, custom element state, top layer,
#       counters, structural pseudo-class flags, Node::parent_element, has_class and
#       has_pseudo_element.
#
#==============================================================================================

# mark: Names ===================================================================================

## Ported from Element.h:122 Web::DOM::Element::is_dom_element (virtual).
pub func dom_element_is_dom_element_impl(this: DomElement*) -> bool:
    return true

## The Element whose SlottableMixin base `base` is (C++'s implicit `this` adjustment, DESIGN.md §2.5).
func dom_element_from_slottable_mixin(base: DomSlottableMixin*) -> DomElement*:
    return (DomElement*)((u8*)base - offsetof(DomElement, slottable_mixin))

## Ported from Element.h:124 Web::DOM::Element::slottable_as_node (override).
pub func dom_element_slottable_as_node_impl(base: DomSlottableMixin*) -> DomNode*:
    return dom_element_from_slottable_mixin(base).dom_node()

