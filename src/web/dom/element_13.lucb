## Ported from Element.h:779 Web::DOM::Node::parent_element.
pub func dom_node_parent_element(this: DomNode*) -> DomElement*?:
    let parent = tree_node_parent(this) else return none
    return as_if_dom_element(parent)

## Ported from Element.h:784 Web::DOM::Node::parent_element.
pub func dom_node_parent_element_const(this: DomNode*) -> DomElement*?:
    let parent = tree_node_parent(this) else return none
    return as_if_dom_element(parent)

## Ported from Element.h:789 Web::DOM::Element::has_class.
pub func dom_element_has_class(this: DomElement*, class_name: ak.FlyString, case_sensitivity: ak.CaseSensitivity = ak.CaseSensitivity.case_sensitive) -> bool:
    if case_sensitivity == ak.CaseSensitivity.case_sensitive:
        # any_of(m_classes, [&](auto& it) { return it == class_name; })
        for it in ak.vector_span(&this.m_classes):
            if ak.fly_string_eq_fly_string(&it, &class_name):
                return true
        return false
    # any_of(m_classes, [&](auto& it) { return it.equals_ignoring_ascii_case(class_name); })
    for it in ak.vector_span(&this.m_classes):
        if ak.fly_string_equals_ignoring_ascii_case_fly_string(&it, &class_name):
            return true
    return false

## Ported from Element.h:801 Web::DOM::Element::has_pseudo_element.
pub func dom_element_has_pseudo_element(this: DomElement*, type_: css_data.PseudoElement) -> bool:
    let pseudo_element_data = this.m_pseudo_element_data else return false
    if not css_selector_pseudo_element_selector_is_known_pseudo_element_type(type_):
        return false
    let pseudo_element = ak.hash_map_get_k(pseudo_element_data, type_) else return false
    return dom_pseudo_element_layout_node(*pseudo_element) != none
