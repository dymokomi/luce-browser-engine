## Ported from Element.h:313 Web::DOM::Element::set_style_uses_tree_counting_function.
pub func dom_element_set_style_uses_tree_counting_function(this: DomElement*):
    if let parent = dom_node_parent_element(this.dom_node()):
        dom_element_set_child_style_uses_tree_counting_function(parent)

    this.m_style_uses_tree_counting_function = true

