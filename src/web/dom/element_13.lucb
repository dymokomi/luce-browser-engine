## `Vector<FlyString>::contains_slow(name)`.
func dom_element_fly_strings_contain(names: const ak.Vector[ak.FlyString]*, name: ak.FlyString) -> bool:
    for i in 0..<ak.vector_size(names):
        if ak.fly_string_eq_fly_string(ak.vector_at_const(names, i), &name):
            return true
    return false

## Ported from Element.h:352 Web::DOM::Element::has_removed_attribute_for_style_invalidation.
pub func dom_element_has_removed_attribute_for_style_invalidation(this: DomElement*, attribute_name: ak.FlyString) -> bool:
    return dom_element_fly_strings_contain(&this.m_removed_attributes_for_style_invalidation, attribute_name)

## Ported from Element.h:356 Web::DOM::Element::remember_removed_attribute_for_style_invalidation.
pub func dom_element_remember_removed_attribute_for_style_invalidation(this: DomElement*, attribute_name: ak.FlyString):
    if not dom_element_fly_strings_contain(&this.m_removed_attributes_for_style_invalidation, attribute_name):
        ak.vector_append_t(&this.m_removed_attributes_for_style_invalidation, attribute_name)

