## Ported from Element.h:564 Web::DOM::Element::affected_by_forward_structural_changes.
pub func dom_element_affected_by_forward_structural_changes(this: DomElement*) -> bool:
    return dom_element_affected_by_direct_sibling_combinator(this) or dom_element_affected_by_indirect_sibling_combinator(this) or dom_element_affected_by_first_child_pseudo_class(this) or dom_element_affected_by_forward_positional_pseudo_class(this)

## Ported from Element.h:569 Web::DOM::Element::affected_by_backward_structural_changes.
pub func dom_element_affected_by_backward_structural_changes(this: DomElement*) -> bool:
    return dom_element_affected_by_last_child_pseudo_class(this) or dom_element_affected_by_backward_positional_pseudo_class(this)

