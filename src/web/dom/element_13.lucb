## Ported from Element.h:523 Web::DOM::Element::in_subtree_of_has_pseudo_class_relative_selector_with_sibling_combinator.
# Set on any element reached by stepping through a + or ~ combinator while
# matching a :has() argument. Lets generic invalidation defer ancestor
# sibling scans until it reaches the sibling subtree root. Write-once,
# intentionally never cleared.
pub func dom_element_in_subtree_of_has_pseudo_class_relative_selector_with_sibling_combinator(this: DomElement*) -> bool:
    return this.m_in_subtree_of_has_pseudo_class_relative_selector_with_sibling_combinator

