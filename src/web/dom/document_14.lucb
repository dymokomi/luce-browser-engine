#==============================================================================================
#
#   document_14 - DOM::Document: beforeunload, CSP, view transitions, registries, dumps
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Document.cpp (lines 7609-8066): the steps to fire beforeunload, CSP
#       initialization, flattening element creation options, event handler attributes, view
#       transitions and their page-visibility change steps, custom element registries and
#       upgrading particular elements, element_by_id, the display list and stacking context
#       tree dumps, and the CSS environment variables.
#
#==============================================================================================

# mark: beforeunload and CSP ====================================================================

## Ported from Document.cpp:7609 Web::DOM::Document::steps_to_fire_beforeunload.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#steps-to-fire-beforeunload
pub func dom_document_steps_to_fire_beforeunload(this: DomDocument*, unload_prompt_shown: bool) -> DomDocumentStepsToFireBeforeunloadResult:
    # 1. Let unloadPromptCanceled be false.
    let unload_prompt_canceled = false

    # 2. Increase the document's unload counter by 1.
    this.m_unload_counter += 1

    # 3. Increase document's relevant agent's event loop's termination nesting level by 1.
    let event_loop = html_relevant_agent((JsObject*)this).event_loop else trap("the relevant agent has no event loop")
    html_event_loop_increment_termination_nesting_level(event_loop)

    # 4. Let eventFiringResult be the result of firing an event named beforeunload at document's relevant global object,
    #    using BeforeUnloadEvent, with the cancelable attribute initialized to true.
    let global_object = html_relevant_global_object((JsObject*)this)
    let window = as_html_window((gc.Cell*)global_object)
    let beforeunload_event = html_before_unload_event_create(dom_document_realm(this), html_event_names_beforeunload)
    dom_event_set_cancelable(beforeunload_event, true)
    _ = dom_event_target_dispatch_event(window.dom_event_target(), beforeunload_event)

    # 5. Decrease document's relevant agent's event loop's termination nesting level by 1.
    html_event_loop_decrement_termination_nesting_level(event_loop)

    # FIXME: 6. If all of the following are true:
    #    - unloadPromptShown is false;
    #    - document's active sandboxing flag set does not have its sandboxed modals flag set;
    #    - document's relevant global object has sticky activation;
    #    - eventFiringResult is false, or the returnValue attribute of event is not the empty string; and
    #    - FIXME: showing an unload prompt is unlikely to be annoying, deceptive, or pointless
    #    (C++ guards the condition with `if (false && ...)`, so it is never evaluated.)
    #     FIXME: 1. Set unloadPromptShown to true.
    #     FIXME: 2. Invoke WebDriver BiDi user prompt opened with document's relevant global object, "beforeunload", and "".
    #     FIXME: 3. Ask the user to confirm that they wish to unload the document, and pause while waiting for the user's response.
    #     FIXME: 4. If the user did not confirm the page navigation, set unloadPromptCanceled to true.
    #     FIXME: 5. Invoke WebDriver BiDi user prompt closed with document's relevant global object and true if unloadPromptCanceled is false or false otherwise.

    # 7. Decrease document's unload counter by 1.
    this.m_unload_counter -= 1

    # 8. Return (unloadPromptShown, unloadPromptCanceled).
    return DomDocumentStepsToFireBeforeunloadResult(unload_prompt_shown = unload_prompt_shown, unload_prompt_canceled = unload_prompt_canceled)

## Ported from Document.cpp:7659 Web::DOM::Document::run_csp_initialization.
# https://w3c.github.io/webappsec-csp/#run-document-csp-initialization
func dom_document_run_csp_initialization(this: DomDocument*):
    # 1. For each policy of document’s policy container's CSP list:
    var policies = content_security_policy_policy_list_policies(dom_document_policy_container(this).csp_list)
    for policy in ak.vector_span(&policies):
        # 1. For each directive of policy:
        var directives = content_security_policy_policy_directives(policy)
        for directive in ak.vector_span(&directives):
            # 1. Execute directive’s initialization algorithm on document, and assert: its returned value is "Allowed".
            let result = content_security_policy_directive_initialization(directive, DomDocumentOrHtmlWorkerGlobalScope.dom_document(this), policy)
            assert(result == ContentSecurityPolicyResult.allowed)

## Ported from Document.cpp:7673 Web::DOM::Document::flatten_element_creation_options.
# https://dom.spec.whatwg.org/#flatten-element-creation-options
func dom_document_flatten_element_creation_options(this: DomDocument*, options: StringOrDomElementCreationOptions) -> DomDocumentRegistryAndIs!:
    # 1. Let registry be the result of looking up a custom element registry given document.
    var registry = html_look_up_a_custom_element_registry(this.dom_node())

    # 2. Let is be null.
    var is_value: ak.String? = none

    # 3. If options is a dictionary:
    match options:
        .dom_element_creation_options(dictionary):
            # 1. If options["is"] exists, then set is to it.
            if dictionary.is != none:
                is_value = dictionary.is

            # 2. If options["customElementRegistry"] exists:
            # (C++'s Optional<GC::Ptr<CustomElementRegistry>> is a nullable pointer here: a null registry is
            # "does not exist".)
            if dictionary.custom_element_registry != none:
                # 1. If is is non-null, then throw a "NotSupportedError" DOMException.
                if is_value != none:
                    return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("Cannot specify both 'is' and 'customElementRegistry' in ElementCreationOptions.")))

                # 2. Set registry to options["customElementRegistry"].
                registry = dictionary.custom_element_registry

            # 3. If registry is non-null, registry’s is scoped is false, and registry is not document’s custom element
            #    registry, then throw a "NotSupportedError" DOMException.
            if let given_registry = registry:
                if not html_custom_element_registry_is_scoped(given_registry) and registry != dom_document_custom_element_registry(this):
                    return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("'customElementRegistry' in ElementCreationOptions must either be scoped or the document's custom element registry.")))
        .string(_): _ = options

    # 4. Return registry and is.
    return DomDocumentRegistryAndIs(registry = registry, is = is_value)

