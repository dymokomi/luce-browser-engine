#==============================================================================================
#
#   document_observer - DOM::DocumentObserver: callbacks on a document's lifecycle
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/DocumentObserver.cpp (lines 1-96) and the inline functions of
#       DocumentObserver.h. Each setter wraps the AK::Function in a GC::Function cell.
#
#==============================================================================================

## Ported from DocumentObserver.cpp:15 Web::DOM::DocumentObserver::DocumentObserver.
pub func dom_document_observer_construct(this: DomDocumentObserver*, realm: Realm*, document: DomDocument*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_document = document
    dom_document_register_document_observer(this.m_document, this)

## Ported from DocumentObserver.cpp:22 Web::DOM::DocumentObserver::visit_edges (override).
pub func dom_document_observer_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomDocumentObserver*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_document)
    gc.cell_visitor_visit_t(visitor, this.m_document_became_active)
    gc.cell_visitor_visit_t(visitor, this.m_document_became_inactive)
    gc.cell_visitor_visit_t(visitor, this.m_document_completely_loaded)
    gc.cell_visitor_visit_t(visitor, this.m_document_readiness_observer)
    gc.cell_visitor_visit_t(visitor, this.m_document_visibility_state_observer)
    gc.cell_visitor_visit_t(visitor, this.m_document_page_showing_observer)

## Ported from DocumentObserver.cpp:34 Web::DOM::DocumentObserver::finalize (override).
pub func dom_document_observer_finalize_impl(base: gc.Cell*):
    let this = (DomDocumentObserver*)base
    # Base::finalize(): PlatformObject inherits GC::Cell's, which does nothing.
    dom_document_unregister_document_observer(this.m_document, this)

## Ported from DocumentObserver.cpp:40 Web::DOM::DocumentObserver::set_document.
pub func dom_document_observer_set_document(this: DomDocumentObserver*, document: DomDocument*):
    assert(document != this.m_document)
    dom_document_unregister_document_observer(this.m_document, this)
    this.m_document = document
    dom_document_register_document_observer(document, this)

## `vm().heap()`.
func dom_document_observer_heap(this: DomDocumentObserver*) -> gc.Heap*:
    return vm_heap(js_cell_vm(this.js_cell()))

## Ported from DocumentObserver.cpp:48 Web::DOM::DocumentObserver::set_document_became_active.
pub func dom_document_observer_set_document_became_active(this: DomDocumentObserver*, callback: ak.Function0[unit]):
    if callback.call != none:
        this.m_document_became_active = gc.create_function0(dom_document_observer_heap(this), callback)
    else:
        this.m_document_became_active = none

