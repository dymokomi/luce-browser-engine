## Ported from EditingHostManager.cpp:163 Web::DOM::EditingHostManager::increment_cursor_position_to_next_line (override).
pub func dom_editing_host_manager_increment_cursor_position_to_next_line_impl(base: InputEventsTarget*, collapse: InputEventsTargetCollapseSelection):
