        selection_selection_move_offset_to_previous_line(selection, collapse == InputEventsTargetCollapseSelection.yes)

# mark: Deleting and line breaks ================================================================

## Ported from EditingHostManager.cpp:175 Web::DOM::EditingHostManager::handle_delete (override).
pub func dom_editing_host_manager_handle_delete_impl(base: InputEventsTarget*, input_type: ak.FlyString):
    let this = dom_editing_host_manager_from_input_events_target(base)

    # https://w3c.github.io/editing/docs/execCommand/#additional-requirements
    # When the user instructs the user agent to delete the previous character inside an editing host, such as by
    # pressing the Backspace key while the cursor is in an editable node, the user agent must call
    # execCommand("delete") on the relevant document.
    # When the user instructs the user agent to delete the next character inside an editing host, such as by pressing
    # the Delete key while the cursor is in an editable node, the user agent must call execCommand("forwarddelete") on
    # the relevant document.
    let command = editing_command_names_delete if ak.fly_string_eq_fly_string(&input_type, &ui_events_input_types_delete_content_backward) else editing_command_names_forward_delete
    _ = dom_document_exec_command(this.m_document, command, false, ak.utf16_string_new()) catch:
        dom_editing_host_manager_log_exception("handle_delete")
        recover false

## Ported from EditingHostManager.cpp:190 Web::DOM::EditingHostManager::handle_return_key (override).
pub func dom_editing_host_manager_handle_return_key_impl(base: InputEventsTarget*, ui_input_type: ak.FlyString) -> EventResult:
    let this = dom_editing_host_manager_from_input_events_target(base)
    assert(ak.fly_string_eq_fly_string(&ui_input_type, &ui_events_input_types_insert_paragraph) or ak.fly_string_eq_fly_string(&ui_input_type, &ui_events_input_types_insert_line_break))

    # https://w3c.github.io/editing/docs/execCommand/#additional-requirements
    # When the user instructs the user agent to insert a line break inside an editing host, such as by pressing the
    # Enter key while the cursor is in an editable node, the user agent must call execCommand("insertparagraph") on the
    # relevant document.
    # When the user instructs the user agent to insert a line break inside an editing host without breaking out of the
    # current block, such as by pressing Shift-Enter or Option-Enter while the cursor is in an editable node, the user
    # agent must call execCommand("insertlinebreak") on the relevant document.
    let command = editing_command_names_insert_paragraph if ak.fly_string_eq_fly_string(&ui_input_type, &ui_events_input_types_insert_paragraph) else editing_command_names_insert_line_break
    let editing_result = dom_document_exec_command(this.m_document, command, false, ak.utf16_string_new()) catch:
        dom_editing_host_manager_log_exception("handle_return_key")
        return EventResult.dropped
    return EventResult.handled if editing_result else EventResult.dropped

## The predicate of is_within_active_contenteditable: `&it == active`.
func dom_editing_host_manager_is_active(context: void*?, it: DomNode*) -> bool:
    let active = (DomNode*)(context else trap("no node"))
    return it == active

## Ported from EditingHostManager.cpp:212 Web::DOM::EditingHostManager::is_within_active_contenteditable.
pub func dom_editing_host_manager_is_within_active_contenteditable(this: DomEditingHostManager*, node: DomNode*) -> bool:
    let active = this.m_active_contenteditable_element else return false
    return dom_node_find_in_shadow_including_ancestry(node, ak.Function1[DomNode*, bool](call = dom_editing_host_manager_is_active, context = active)) != none

# mark: EditingHostManager.h ====================================================================

## Ported from EditingHostManager.h:42 Web::DOM::EditingHostManager::set_active_contenteditable_element.
pub func dom_editing_host_manager_set_active_contenteditable_element(this: DomEditingHostManager*, element: DomNode*?):
    this.m_active_contenteditable_element = element

## Ported from EditingHostManager.h:50 Web::DOM::EditingHostManager::as_cell (override).
pub func dom_editing_host_manager_as_cell_impl(base: InputEventsTarget*) -> JsCell*:
    return dom_editing_host_manager_from_input_events_target(base).js_cell()
