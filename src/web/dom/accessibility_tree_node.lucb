#
#   accessibility_tree_node - DOM::AccessibilityTreeNode: the accessibility tree and its JSON form
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/AccessibilityTreeNode.cpp (lines 1-83) and the inline functions of
#       AccessibilityTreeNode.h.
#
#==============================================================================================

## Ported from AccessibilityTreeNode.cpp:17 Web::DOM::AccessibilityTreeNode::create.
pub func dom_accessibility_tree_node_create(document: DomDocument*?, value: DomNode*?) -> DomAccessibilityTreeNode*:
    let owner = document else trap("VERIFY: document")
    return realm_create_dom_accessibility_tree_node(bind_platform_object_realm(owner.bind_platform_object()), value)

## Ported from AccessibilityTreeNode.cpp:22 Web::DOM::AccessibilityTreeNode::AccessibilityTreeNode.
pub func dom_accessibility_tree_node_construct(this: DomAccessibilityTreeNode*, value: DomNode*?):
    this.m_value = value
    ak.vector_clear(&this.m_children)

## Ported from AccessibilityTreeNode.cpp:28 Web::DOM::AccessibilityTreeNode::serialize_tree_as_json.
pub func dom_accessibility_tree_node_serialize_tree_as_json(this: DomAccessibilityTreeNode*, object: ak.JsonObjectSerializer[ak.StringBuilder]*, document: DomDocument*):
    let value = dom_accessibility_tree_node_value(this) else trap("VERIFY: accessibility tree node value")
    if dom_node_is_document(value):
        trap("VERIFY_NOT_REACHED")
    elif dom_node_is_element(value):
        let element = (DomElement*)value
        if aria_mixin_include_in_accessibility_tree(&element.aria_mixin):
            ak.json_object_serializer_add_string_view(object, ak.sv("type"), ak.sv("element")) else trap("MUST: add")
            let role = aria_mixin_role_or_default(&element.aria_mixin)
            var has_role = false
            if let role_value = role:
                has_role = not aria_is_abstract_role(role_value)
            let name = dom_node_accessible_name(element.dom_node(), document) else trap("MUST: accessible_name")
            ak.json_object_serializer_add_string(object, ak.sv("name"), name) else trap("MUST: add")
            let description = dom_node_accessible_description(element.dom_node(), document) else trap("MUST: accessible_description")
            ak.json_object_serializer_add_string(object, ak.sv("description"), description) else trap("MUST: add")
            if has_role:
                ak.json_object_serializer_add_string_view(object, ak.sv("role"), aria_role_name(role else trap("unreachable"))) else trap("MUST: add")
            else:
                ak.json_object_serializer_add_string_view(object, ak.sv("role"), ak.sv("")) else trap("MUST: add")
        else:
            trap("VERIFY_NOT_REACHED")
    elif dom_node_is_text(value):
        ak.json_object_serializer_add_string_view(object, ak.sv("type"), ak.sv("text")) else trap("MUST: add")
        let text_node = (DomText*)value
        let data = dom_character_data_data(text_node.dom_character_data())
        ak.json_object_serializer_add_string(object, ak.sv("name"), ak.utf16_string_base_to_utf8(&data.utf16_string_base)) else trap("MUST: add")
        ak.json_object_serializer_add_string_view(object, ak.sv("role"), ak.sv("text leaf")) else trap("MUST: add")

    ak.json_object_serializer_add_i64(object, ak.sv("id"), dom_node_unique_id(value)) else trap("MUST: add")

    if dom_node_has_child_nodes(value):
        var node_children = ak.json_object_serializer_add_array(object, ak.sv("children")) else trap("MUST: add_array")
        for child_node in ak.vector_span(&this.m_children):
            let child = child_node else trap("VERIFY: accessibility tree child")
            let child_value = dom_accessibility_tree_node_value(child) else trap("VERIFY: accessibility tree node value")
            if dom_node_is_uninteresting_whitespace_node(child_value):
                continue
            var child_object = ak.json_array_serializer_add_object(&node_children) else trap("MUST: add_object")
            dom_accessibility_tree_node_serialize_tree_as_json(child, &child_object, document)
            ak.json_object_serializer_finish(&child_object) else trap("MUST: finish")
        ak.json_array_serializer_finish(&node_children) else trap("MUST: finish")

## Ported from AccessibilityTreeNode.cpp:76 Web::DOM::AccessibilityTreeNode::visit_edges (override).
pub func dom_accessibility_tree_node_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomAccessibilityTreeNode*)base
    # Base::visit_edges(visitor): JS::Cell's visits nothing.
    gc.cell_visitor_visit_t(visitor, this.m_value)
    gc.cell_visitor_visit_vector_nullable(visitor, &this.m_children)

# mark: AccessibilityTreeNode.h =================================================================

## Ported from AccessibilityTreeNode.h:25 Web::DOM::AccessibilityTreeNode::value.
pub func dom_accessibility_tree_node_value(this: DomAccessibilityTreeNode*) -> DomNode*?:
    return this.m_value

## Ported from AccessibilityTreeNode.h:26 Web::DOM::AccessibilityTreeNode::set_value.
pub func dom_accessibility_tree_node_set_value(this: DomAccessibilityTreeNode*, value: DomNode*?):
    this.m_value = value

## Ported from AccessibilityTreeNode.h:27 Web::DOM::AccessibilityTreeNode::children.
pub func dom_accessibility_tree_node_children_2(this: DomAccessibilityTreeNode*) -> ak.Vector[DomAccessibilityTreeNode*?]:
    # C++ returns a copy of the vector.
    return ak.vector_clone(&this.m_children)

## Ported from AccessibilityTreeNode.h:28 Web::DOM::AccessibilityTreeNode::append_child.
pub func dom_accessibility_tree_node_append_child(this: DomAccessibilityTreeNode*, child: DomAccessibilityTreeNode*?):
    ak.vector_append_t(&this.m_children, child)
