# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:21 Web::DOM::AbortSignal::construct_impl.
pub func dom_abort_signal_construct_impl(realm: Realm*) -> DomAbortSignal*!:
    return realm_create_dom_abort_signal(realm, realm)

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:26 Web::DOM::AbortSignal::AbortSignal.
pub func dom_abort_signal_construct(this: DomAbortSignal*, realm: Realm*):
    dom_event_target_construct(this.dom_event_target(), realm)
    dom_abort_signal_init_fields(this)

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:31 Web::DOM::AbortSignal::initialize (override).
pub func dom_abort_signal_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.abort_signal)
    dom_event_target_initialize_impl(base, realm)

# mark: Abort algorithms ========================================================================

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:38 Web::DOM::AbortSignal::add_abort_algorithm.
## https://dom.spec.whatwg.org/#abortsignal-add
pub func dom_abort_signal_add_abort_algorithm(this: DomAbortSignal*, abort_algorithm: ak.Function0[unit]) -> u64?:
    # 1. If signal is aborted, then return.
    if dom_abort_signal_aborted(this):
        return none

    # 2. Append algorithm to signal’s abort algorithms.
    this.m_next_abort_algorithm_id += 1
    let function = gc.create_function0(vm_heap(js_cell_vm(this.js_cell())), abort_algorithm)
    discard(ak.ordered_hash_map_set(&this.m_abort_algorithms, this.m_next_abort_algorithm_id, function))
    return this.m_next_abort_algorithm_id

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:50 Web::DOM::AbortSignal::remove_abort_algorithm.
## https://dom.spec.whatwg.org/#abortsignal-remove
pub func dom_abort_signal_remove_abort_algorithm(this: DomAbortSignal*, id: u64):
    # To remove an algorithm algorithm from an AbortSignal signal, remove algorithm from signal’s abort algorithms.
    discard(ak.ordered_hash_map_remove_k(&this.m_abort_algorithms, id))

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:36 Web::DOM::AbortSignal::aborted.
## https://dom.spec.whatwg.org/#dom-abortsignal-aborted
## An AbortSignal object is aborted when its abort reason is not undefined.
pub func dom_abort_signal_aborted(this: DomAbortSignal*) -> bool:
    return not js_value_is_undefined(this.m_abort_reason)

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:57 Web::DOM::AbortSignal::signal_abort.
## https://dom.spec.whatwg.org/#abortsignal-signal-abort
pub func dom_abort_signal_signal_abort(this: DomAbortSignal*, reason: JsValue):
    # 1. If signal is aborted, then return.
    if dom_abort_signal_aborted(this):
        return

    # 2. Set signal’s abort reason to reason if it is given; otherwise to a new "AbortError" DOMException.
    if not js_value_is_undefined(reason):
        this.m_abort_reason = reason
    else:
        let realm = bind_platform_object_realm(this.bind_platform_object())
        this.m_abort_reason = js_value_from_object((JsObject*)idl_abort_error_create(realm, ak.utf16_string_from_str("Aborted without reason")))

    # 3. Let dependentSignalsToAbort be a new list.
    var dependent_signals_to_abort: ak.Vector[DomAbortSignal*?]

    # 4. For each dependentSignal of signal’s dependent signals:
    for entry in ak.vector_span(&this.m_dependent_signals):
        let dependent_signal = entry else trap("AbortSignal: a null dependent signal")
        # 1. If dependentSignal is not aborted, then:
        if not dom_abort_signal_aborted(dependent_signal):
            # 1. Set dependentSignal’s abort reason to signal’s abort reason.
            dom_abort_signal_set_reason(dependent_signal, this.m_abort_reason)

            # 2. Append dependentSignal to dependentSignalsToAbort.
            ak.vector_append_t(&dependent_signals_to_abort, dependent_signal)

    # 5. Run the abort steps for signal.
    dom_abort_signal_run_the_abort_steps(this)

    # 6. For each dependentSignal of dependentSignalsToAbort, run the abort steps for dependentSignal.
    for entry in ak.vector_span(&dependent_signals_to_abort):
        dom_abort_signal_run_the_abort_steps(entry else trap("AbortSignal: a null dependent signal"))

## The `run_the_abort_steps` lambda of AbortSignal::signal_abort (AbortSignal.cpp:85).
## https://dom.spec.whatwg.org/#run-the-abort-steps
func dom_abort_signal_run_the_abort_steps(signal: DomAbortSignal*):
    # 1. For each algorithm in signal’s abort algorithms: run algorithm.
    for algorithm in ak.ordered_hash_map_begin(&signal.m_abort_algorithms):
        ak.function0_call(&algorithm.value.function)

    # 2. Empty signal’s abort algorithms.
    ak.ordered_hash_map_clear(&signal.m_abort_algorithms)

    # 3. Fire an event named abort at signal.
    let abort_event = dom_event_create(bind_platform_object_realm(signal.bind_platform_object()), html_event_names_abort)
    dom_event_set_is_trusted(abort_event, true)
    discard(dom_event_target_dispatch_event(signal.dom_event_target(), abort_event))

