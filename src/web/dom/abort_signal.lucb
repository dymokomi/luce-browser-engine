pub func dom_abort_signal_set_onabort(this: DomAbortSignal*, event_handler: IdlCallbackType*?):
    dom_event_target_set_event_handler_attribute(this.dom_event_target(), html_event_names_abort, event_handler)

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:112 Web::DOM::AbortSignal::onabort.
pub func dom_abort_signal_onabort(this: DomAbortSignal*) -> IdlCallbackType*?:
