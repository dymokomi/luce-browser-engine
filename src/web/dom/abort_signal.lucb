## Ported from Libraries/LibWeb/DOM/AbortSignal.h:44 Web::DOM::AbortSignal::reason.
## https://dom.spec.whatwg.org/#dom-abortsignal-reason
pub func dom_abort_signal_reason(this: DomAbortSignal*) -> JsValue:
    return this.m_abort_reason

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:45 Web::DOM::AbortSignal::set_reason.
pub func dom_abort_signal_set_reason(this: DomAbortSignal*, reason: JsValue):
    this.m_abort_reason = reason

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:118 Web::DOM::AbortSignal::throw_if_aborted.
## https://dom.spec.whatwg.org/#dom-abortsignal-throwifaborted
pub func dom_abort_signal_throw_if_aborted(this: DomAbortSignal*) -> !:
    # The throwIfAborted() method steps are to throw this’s abort reason, if this is aborted.
    if not dom_abort_signal_aborted(this):
        return

    # return JS::throw_completion(m_abort_reason); (DESIGN.md §2.10: the completion is the VM's.)
    vm_set_pending_exception(js_cell_vm(this.js_cell()), .js_completion(js_throw_completion(this.m_abort_reason)))
    error(js_exception, "")

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:127 Web::DOM::AbortSignal::visit_edges (override).
pub func dom_abort_signal_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomAbortSignal*)base
    dom_event_target_visit_edges_impl(base, visitor)
    js_visit_value(visitor, this.m_abort_reason)
    gc.cell_visitor_visit_opaque_3(visitor, &this.m_abort_algorithms)
    gc.cell_visitor_visit_vector_nullable(visitor, &this.m_source_signals)
    gc.cell_visitor_visit_vector_nullable(visitor, &this.m_dependent_signals)

# mark: Static methods ==========================================================================

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:137 Web::DOM::AbortSignal::abort.
## https://dom.spec.whatwg.org/#dom-abortsignal-abort
pub func dom_abort_signal_abort(vm: Vm*, reason: JsValue) -> DomAbortSignal*!:
    let realm = vm_current_realm(vm) else trap("AbortSignal::abort: no current realm")

    # 1. Let signal be a new AbortSignal object.
    let signal = try dom_abort_signal_construct_impl(realm)

    # 2. Set signal’s abort reason to reason if it is given; otherwise to a new "AbortError" DOMException.
    var abort_reason = reason
    if js_value_is_undefined(abort_reason):
        abort_reason = js_value_from_object((JsObject*)idl_abort_error_create(realm, ak.utf16_string_from_str("Aborted without reason")))

    dom_abort_signal_set_reason(signal, abort_reason)

    # 3. Return signal.
    return signal

## The captures of AbortSignal::timeout's queued task (AbortSignal.cpp:166).
struct DomAbortSignalTimeoutTask:
    var realm: Realm*
    var signal: DomAbortSignal*

    ## 1. Queue a global task on the timer task source given global to signal abort given signal and a new "TimeoutError" DOMException.
    static func call(context: void*?):
        let captures = (DomAbortSignalTimeoutTask*)(context else trap("AbortSignal::timeout: no captures"))
        let reason = idl_timeout_error_create(captures.realm, ak.utf16_string_from_str("Signal timed out"))
        dom_abort_signal_signal_abort(captures.signal, js_value_from_object((JsObject*)reason))

## The captures of AbortSignal::timeout's completion step (AbortSignal.cpp:164).
struct DomAbortSignalTimeoutStep:
    var realm: Realm*
    var global: JsObject*
    var signal: DomAbortSignal*

    static func call(context: void*?):
        let captures = (DomAbortSignalTimeoutStep*)(context else trap("AbortSignal::timeout: no captures"))
        # 1. Queue a global task on the timer task source given global to signal abort given signal and a new "TimeoutError" DOMException.
        let task = new DomAbortSignalTimeoutTask(realm = captures.realm, signal = captures.signal) else trap("out of memory")
        let steps = gc.create_function0(realm_heap(captures.realm), ak.Function0[unit](call = DomAbortSignalTimeoutTask.call, context = task))
        discard(html_queue_global_task(HtmlTaskSource.timer_task, captures.global, steps))

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:153 Web::DOM::AbortSignal::timeout.
## https://dom.spec.whatwg.org/#dom-abortsignal-timeout
pub func dom_abort_signal_timeout(vm: Vm*, milliseconds: u64) -> DomAbortSignal*!:
    let realm = vm_current_realm(vm) else trap("AbortSignal::timeout: no current realm")

    # 1. Let signal be a new AbortSignal object.
    let signal = try dom_abort_signal_construct_impl(realm)

    # 2. Let global be signal’s relevant global object.
    let global = html_relevant_global_object((JsObject*)signal)
    let window_or_worker = as_if_window_or_worker_global_scope_mixin((gc.Cell*)global) else trap("as<HTML::WindowOrWorkerGlobalScopeMixin> failed")

    # 3. Run steps after a timeout given global, "AbortSignal-timeout", milliseconds, and the following step:
    # (C++ passes the u64 to an i32 parameter, which truncates.)
    let step = new DomAbortSignalTimeoutStep(realm = realm, global = global, signal = signal) else trap("out of memory")
    html_window_or_worker_global_scope_mixin_run_steps_after_a_timeout(window_or_worker, (i32)milliseconds, ak.Function0[unit](call = DomAbortSignalTimeoutStep.call, context = step))

    # 4. Return signal.
    return signal

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:178 Web::DOM::AbortSignal::any.
## https://dom.spec.whatwg.org/#dom-abortsignal-any
pub func dom_abort_signal_any(vm: Vm*, signals: ak.Vector[DomAbortSignal*?]) -> DomAbortSignal*!:
    # The static any(signals) method steps are to return the result of creating a dependent abort signal from signals using AbortSignal and the current realm.
    let realm = vm_current_realm(vm) else trap("AbortSignal::any: no current realm")
    return try dom_abort_signal_create_dependent_abort_signal(realm, signals)

## Ported from Libraries/LibWeb/DOM/AbortSignal.cpp:185 Web::DOM::AbortSignal::create_dependent_abort_signal.
## https://dom.spec.whatwg.org/#create-a-dependent-abort-signal
pub func dom_abort_signal_create_dependent_abort_signal(realm: Realm*, signals: ak.Vector[DomAbortSignal*?]) -> DomAbortSignal*!:
    # 1. Let resultSignal be a new object implementing signalInterface using realm.
    let result_signal = try dom_abort_signal_construct_impl(realm)

    # 2. For each signal of signals: if signal is aborted, then set resultSignal’s abort reason to signal’s abort reason and return resultSignal.
    for entry in ak.vector_span_const(&signals):
        let signal = entry else trap("AbortSignal: a null signal")
        if dom_abort_signal_aborted(signal):
            dom_abort_signal_set_reason(result_signal, dom_abort_signal_reason(signal))
            return result_signal

    # 3. Set resultSignal’s dependent to true.
    dom_abort_signal_set_dependent(result_signal, true)

    # 4. For each signal of signals:
    for entry in ak.vector_span_const(&signals):
        let signal = entry else trap("AbortSignal: a null signal")
        # 1. If signal’s dependent is false, then:
        if not dom_abort_signal_dependent(signal):
            # 1. Append signal to resultSignal’s source signals.
            dom_abort_signal_append_source_signal(result_signal, signal)

            # 2. Append resultSignal to signal’s dependent signals.
            dom_abort_signal_append_dependent_signal(signal, result_signal)
        # 2. Otherwise, for each sourceSignal of signal’s source signals:
        else:
            var source_signals = dom_abort_signal_source_signals(signal)
            for source_entry in ak.vector_span(&source_signals):
                # 1. Assert: sourceSignal is not aborted and not dependent.
                let source_signal = source_entry else trap("VERIFY: source_signal")
                assert(not dom_abort_signal_aborted(source_signal))
                assert(not dom_abort_signal_dependent(source_signal))

                # 2. Append sourceSignal to resultSignal’s source signals.
                dom_abort_signal_append_source_signal(result_signal, source_signal)

                # 3. Append resultSignal to sourceSignal’s dependent signals.
                dom_abort_signal_append_dependent_signal(source_signal, result_signal)

    # 5. Return resultSignal
    return result_signal

# mark: Dependent signals (AbortSignal.h) =======================================================

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:61 Web::DOM::AbortSignal::dependent.
pub func dom_abort_signal_dependent(this: DomAbortSignal*) -> bool:
    return this.m_dependent

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:62 Web::DOM::AbortSignal::set_dependent.
pub func dom_abort_signal_set_dependent(this: DomAbortSignal*, dependent: bool):
    this.m_dependent = dependent

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:64 Web::DOM::AbortSignal::source_signals: a copy.
pub func dom_abort_signal_source_signals(this: DomAbortSignal*) -> ak.Vector[DomAbortSignal*?]:
    return ak.vector_clone(&this.m_source_signals)

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:66 Web::DOM::AbortSignal::append_source_signal.
pub func dom_abort_signal_append_source_signal(this: DomAbortSignal*, source_signal: DomAbortSignal*?):
    ak.vector_append_t(&this.m_source_signals, source_signal)

## Ported from Libraries/LibWeb/DOM/AbortSignal.h:67 Web::DOM::AbortSignal::append_dependent_signal.
pub func dom_abort_signal_append_dependent_signal(this: DomAbortSignal*, dependent_signal: DomAbortSignal*?):
    ak.vector_append_t(&this.m_dependent_signals, dependent_signal)
