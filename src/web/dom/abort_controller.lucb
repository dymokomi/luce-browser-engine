## Ported from Libraries/LibWeb/DOM/AbortController.cpp:16 Web::DOM::AbortController::construct_impl.
pub func dom_abort_controller_construct_impl(realm: Realm*) -> DomAbortController*!:
    let signal = try dom_abort_signal_construct_impl(realm)
    return realm_create_dom_abort_controller(realm, realm, signal)

## Ported from Libraries/LibWeb/DOM/AbortController.cpp:23 Web::DOM::AbortController::AbortController.
## https://dom.spec.whatwg.org/#dom-abortcontroller-abortcontroller
pub func dom_abort_controller_construct(this: DomAbortController*, realm: Realm*, signal: DomAbortSignal*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_signal = signal

## Ported from Libraries/LibWeb/DOM/AbortController.cpp:31 Web::DOM::AbortController::initialize (override).
pub func dom_abort_controller_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.abort_controller)
    # Base::initialize(realm): PlatformObject inherits JS::Object's, which is JS::Cell's.
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/DOM/AbortController.cpp:37 Web::DOM::AbortController::visit_edges (override).
pub func dom_abort_controller_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomAbortController*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_signal)

## Ported from Libraries/LibWeb/DOM/AbortController.h:25 Web::DOM::AbortController::signal.
## https://dom.spec.whatwg.org/#dom-abortcontroller-signal
pub func dom_abort_controller_signal(this: DomAbortController*) -> DomAbortSignal*:
    return this.m_signal

## Ported from Libraries/LibWeb/DOM/AbortController.cpp:44 Web::DOM::AbortController::abort.
## https://dom.spec.whatwg.org/#dom-abortcontroller-abort
pub func dom_abort_controller_abort(this: DomAbortController*, reason: JsValue):
    # The abort(reason) method steps are to signal abort on this’s signal with reason if it is given.
    dom_abort_signal_signal_abort(this.m_signal, reason)
