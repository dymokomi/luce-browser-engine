## Ported from Document.cpp:4332 Web::DOM::Document::domain.
# https://html.spec.whatwg.org/multipage/origin.html#dom-document-domain
pub func dom_document_domain(this: DomDocument*) -> ak.String:
    # 1. Let effectiveDomain be this's origin's effective domain.
    let origin = dom_document_origin(this)
    let effective_domain = web_url.origin_effective_domain(&origin)

    # 2. If effectiveDomain is null, then return the empty string.
    let domain = effective_domain else return ak.String()

    # 3. Return effectiveDomain, serialized.
    return web_url.host_serialize(&domain)

# mark: document.domain =========================================================================

## Ported from Document.cpp:4346 Web::DOM::is_a_registrable_domain_suffix_of_or_is_equal_to.
# https://html.spec.whatwg.org/multipage/browsers.html#is-a-registrable-domain-suffix-of-or-is-equal-to
pub func dom_is_a_registrable_domain_suffix_of_or_is_equal_to(host_suffix_string: ak.StringView, original_host: web_url.Host) -> bool:
    # 1. If hostSuffixString is the empty string, then return false.
    if ak.string_view_is_empty(&host_suffix_string):
        return false

    # 2. Let hostSuffix be the result of parsing hostSuffixString.
    let host_suffix = web_url.parser_parse_host(host_suffix_string)

    # 3. If hostSuffix is failure, then return false.
    let host_suffix_value = host_suffix else return false

    # 4. If hostSuffix does not equal originalHost, then:
    if not web_url.host_eq(&host_suffix_value, original_host):
        # 1. If hostSuffix or originalHost is not a domain, then return false.
        # NOTE: This excludes hosts that are IP addresses.
        if not web_url.host_has_string(&host_suffix_value) or not web_url.host_has_string(&original_host):
            return false
        let suffix_domain = web_url.host_get_string(&host_suffix_value)
        let original_host_string = web_url.host_get_string(&original_host)

        # 2. If hostSuffix, prefixed by U+002E (.), does not match the end of originalHost, then return false.
        var prefixed = ak.string_builder_new()
        ak.string_builder_append(&prefixed, ".")
        ak.string_builder_append_string_view(&prefixed, ak.string_bytes_as_string_view(&suffix_domain))
        let prefixed_host_suffix = ak.string_builder_to_string(&prefixed) else trap("MUST: String::formatted")
        if not ak.string_ends_with_bytes(&original_host_string, ak.string_bytes_as_string_view(&prefixed_host_suffix)):
            return false

        # 3. If any of the following are true:
        #     * hostSuffix equals hostSuffix's public suffix; or
        #     * hostSuffix, prefixed by U+002E (.), matches the end of originalHost's public suffix,
        #    then return false. [URL]
        if let host_suffix_public_suffix = web_url.host_public_suffix(&host_suffix_value):
            if ak.string_equals(&suffix_domain, &host_suffix_public_suffix):
                return false

        let original_host_public_suffix = web_url.host_public_suffix(&original_host) else trap("VERIFY: a domain has a public suffix")

        if ak.string_ends_with_bytes(&original_host_public_suffix, ak.string_bytes_as_string_view(&prefixed_host_suffix)):
            return false

        # 4. Assert: originalHost's public suffix, prefixed by U+002E (.), matches the end of hostSuffix.
        var prefixed_public_suffix = ak.string_builder_new()
        ak.string_builder_append(&prefixed_public_suffix, ".")
        ak.string_builder_append_string_view(&prefixed_public_suffix, ak.string_bytes_as_string_view(&original_host_public_suffix))
        assert(ak.string_ends_with_bytes(&suffix_domain, ak.string_builder_string_view(&prefixed_public_suffix)))

    # 5. Return true.
    return true

## Ported from Document.cpp:4395 Web::DOM::Document::set_domain.
# https://html.spec.whatwg.org/multipage/browsers.html#dom-document-domain
pub func dom_document_set_domain(this: DomDocument*, domain: ak.String) -> !:
    let realm = dom_document_realm(this)

    # 1. If this's browsing context is null, then throw a "SecurityError" DOMException.
    if this.m_browsing_context == none:
        return try dom_document_throw(idl_security_error_create(realm, ak.utf16_string_from_str("Document.domain setter requires a browsing context")))

    # 2. If this's active sandboxing flag set has its sandboxed document.domain browsing context flag set, then throw a "SecurityError" DOMException.
    if html_has_flag(dom_document_active_sandboxing_flag_set(this), HtmlSandboxingFlagSet.sandboxed_document_domain):
        return try dom_document_throw(idl_security_error_create(realm, ak.utf16_string_from_str("Document.domain setter is sandboxed")))

    # 3. Let effectiveDomain be this's origin's effective domain.
    let origin = dom_document_origin(this)
    let effective_domain = web_url.origin_effective_domain(&origin)

    # 4. If effectiveDomain is null, then throw a "SecurityError" DOMException.
    let effective_domain_value = effective_domain else return try dom_document_throw(idl_security_error_create(realm, ak.utf16_string_from_str("Document.domain setter called on a Document with a null effective domain")))

    # 5. If the given value is not a registrable domain suffix of and is not equal to effectiveDomain, then throw a "SecurityError" DOMException.
    if not dom_is_a_registrable_domain_suffix_of_or_is_equal_to(ak.string_bytes_as_string_view(&domain), effective_domain_value):
        return try dom_document_throw(idl_security_error_create(realm, ak.utf16_string_from_str("Document.domain setter called for an invalid domain")))

    # FIXME: 6. If the surrounding agent's agent cluster's is origin-keyed is true, then return.

    # FIXME: 7. Set this's origin's domain to the result of parsing the given value.

    ak.dbgln(f"(STUBBED) Document::set_domain(domain='{ak.string_view_text(ak.string_bytes_as_string_view(&domain))}')")

