#==============================================================================================
#
#   document_8 - DOM::Document: favicons, document.domain, policy, navigables, destruction
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Document.cpp (lines 4255-4791): page showing, the stacking context
#       tree, favicons, the window, style sheets, history, registrable domain suffixes and the
#       document.domain setter, the navigation ID, the active sandboxing flag set, the policy
#       container, snapshotting source snapshot params, the descendant, ancestor and document-
#       tree child navigables, the unloading cleanup steps, destroying a document, making it
#       unsalvageable, and the DocumentLifecycleState that counts children during destruction
#       and unloading.
#
#==============================================================================================

# mark: Favicons, window, style sheets, history =================================================

## AK/Debug.h SPAM_DEBUG (0 in the reference build).
let spam_debug: bool = false

## check_favicon_after_loading_link_resource's filter: link elements that loaded an icon.
func dom_document_favicon_link_filter(context: void*?, element: DomElement*) -> bool:
    let link = as_if_html_link_element(element) else return false

    return html_link_element_has_loaded_icon(link)

## Ported from Document.cpp:4255 Web::DOM::Document::check_favicon_after_loading_link_resource.
pub func dom_document_check_favicon_after_loading_link_resource(this: DomDocument*):
    # https://html.spec.whatwg.org/multipage/links.html#rel-icon
    # NOTE: firefox also load favicons outside the head tag, which is against spec (see table 4.6.7)
    let head_element = dom_document_head(this) else return

    let favicon_link_elements = dom_html_collection_create(head_element.dom_parent_node(), DomHtmlCollectionScope.descendants, ak.Function1[DomElement*, bool](call = dom_document_favicon_link_filter, context = none), ak.Function2[DomElement*, DomElement*, bool]())

    if dom_html_collection_length(favicon_link_elements) == 0:
        if spam_debug:
            ak.dbgln("No favicon found to be used")
        return

    # 4.6.7.8 Link type "icon"
    #
    # If there are multiple equally appropriate icons, user agents must use the last one declared
    # in tree order at the time that the user agent collected the list of icons.
    #
    # If multiple icons are provided, the user agent must select the most appropriate icon
    # according to the type, media, and sizes attributes.
    #
    # FIXME: There is no selective behavior yet for favicons.
    var i = dom_html_collection_length(favicon_link_elements)
    while i > 0:
        i -= 1
        let favicon_element = dom_html_collection_item(favicon_link_elements, i)

        if favicon_element == this.m_active_element:
            return

        # If the user agent tries to use an icon but that icon is determined, upon closer examination,
        # to in fact be inappropriate (...), then the user agent must try the next-most-appropriate icon
        # as determined by the attributes.
        let favicon = favicon_element else trap("the collection has an item at every index below its length")
        if html_link_element_load_favicon_and_use_if_window_is_active((HtmlLinkElement*)favicon):
            this.m_active_favicon = favicon.dom_node()
            return

    if spam_debug:
        ak.dbgln("No favicon found to be used")

