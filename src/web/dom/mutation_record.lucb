#==============================================================================================
#
#   mutation_record - DOM::MutationRecord
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/MutationRecord.cpp (lines 1-55) and the inline functions of
#       MutationRecord.h. C++ holds the target and siblings in GC::Roots; here they are cell
#       pointers that visit_edges visits, as it does in C++ (DESIGN.md §2.6).
#
#==============================================================================================

## Ported from MutationRecord.cpp:18 Web::DOM::MutationRecord::create.
pub func dom_mutation_record_create(realm: Realm*, type_: ak.FlyString, target: DomNode*, added_nodes: DomNodeList*, removed_nodes: DomNodeList*, previous_sibling: DomNode*?, next_sibling: DomNode*?, attribute_name: ak.String?, attribute_namespace: ak.String?, old_value: ak.String?) -> DomMutationRecord*:
    return realm_create_dom_mutation_record(realm, realm, type_, target, added_nodes, removed_nodes, previous_sibling, next_sibling, attribute_name, attribute_namespace, old_value)

## Ported from MutationRecord.cpp:23 Web::DOM::MutationRecord::MutationRecord.
pub func dom_mutation_record_construct(this: DomMutationRecord*, realm: Realm*, type_: ak.FlyString, target: DomNode*, added_nodes: DomNodeList*, removed_nodes: DomNodeList*, previous_sibling: DomNode*?, next_sibling: DomNode*?, attribute_name: ak.String?, attribute_namespace: ak.String?, old_value: ak.String?):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_type = type_
    this.m_target = target
    this.m_added_nodes = added_nodes
    this.m_removed_nodes = removed_nodes
    this.m_previous_sibling = previous_sibling
    this.m_next_sibling = next_sibling
    this.m_attribute_name = attribute_name
    this.m_attribute_namespace = attribute_namespace
    this.m_old_value = old_value

## Ported from MutationRecord.cpp:39 Web::DOM::MutationRecord::initialize (override).
pub func dom_mutation_record_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.mutation_record)
    # Base::initialize(realm): PlatformObject inherits JS::Object's.
    js_cell_initialize_impl(base, realm)

## Ported from MutationRecord.cpp:45 Web::DOM::MutationRecord::visit_edges (override).
pub func dom_mutation_record_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomMutationRecord*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_target)
    gc.cell_visitor_visit_t(visitor, this.m_added_nodes)
    gc.cell_visitor_visit_t(visitor, this.m_removed_nodes)
    gc.cell_visitor_visit_t(visitor, this.m_previous_sibling)
    gc.cell_visitor_visit_t(visitor, this.m_next_sibling)

# mark: MutationRecord.h ========================================================================

