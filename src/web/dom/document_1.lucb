## Ported from Document.cpp:759 Web::DOM::Document::get_selection.
# https://w3c.github.io/selection-api/#dom-document-getselection
pub func dom_document_get_selection(this: DomDocument*) -> SelectionSelection*?:
    # The method must return the selection associated with this if this has an associated browsing context,
    # and it must return null otherwise.
    if dom_document_browsing_context(this) == none:
        return none
    return this.m_selection
