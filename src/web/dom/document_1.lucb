pub func dom_document_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomDocument*)base
    dom_parent_node_visit_edges_impl(base, visitor)
    css_style_scope_visit_edges(&this.m_style_scope, visitor)
    gc.cell_visitor_visit_hash_table(visitor, &this.m_pending_css_import_rules)
    gc.cell_visitor_visit_t_2(visitor, this.m_page)
    gc.cell_visitor_visit_t(visitor, this.m_window)
    gc.cell_visitor_visit_t(visitor, this.m_layout_root)
    gc.cell_visitor_visit_t(visitor, this.m_style_sheets)
    gc.cell_visitor_visit_t(visitor, this.m_hovered_node)
    gc.cell_visitor_visit_t(visitor, this.m_inspected_node)
    gc.cell_visitor_visit_t(visitor, this.m_highlighted_node)
    gc.cell_visitor_visit_t(visitor, this.m_active_favicon)
    gc.cell_visitor_visit_t(visitor, this.m_browsing_context)
    gc.cell_visitor_visit_t(visitor, this.m_focused_area)
    gc.cell_visitor_visit_t(visitor, this.m_active_element)
    gc.cell_visitor_visit_t(visitor, this.m_target_element)
    gc.cell_visitor_visit_vector(visitor, &this.m_autofocus_candidates)
    gc.cell_visitor_visit_t(visitor, this.m_implementation)
    gc.cell_visitor_visit_t(visitor, this.m_current_script)
    gc.cell_visitor_visit_t(visitor, this.m_associated_inert_template_document)
    gc.cell_visitor_visit_t(visitor, this.m_appropriate_template_contents_owner_document)
    gc.cell_visitor_visit_t(visitor, this.m_pending_parsing_blocking_script)
    gc.cell_visitor_visit_t(visitor, this.m_pending_parsing_blocking_svg_script)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_history)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_html_parser_end_state)
    gc.cell_visitor_visit_t(visitor, this.m_style_computer)
    gc.cell_visitor_visit_t(visitor, this.m_font_computer)
    gc.cell_visitor_visit_t(visitor, this.m_browsing_context)

    gc.cell_visitor_visit_t(visitor, this.m_applets)
    gc.cell_visitor_visit_t(visitor, this.m_anchors)
    gc.cell_visitor_visit_t(visitor, this.m_images)
    gc.cell_visitor_visit_t(visitor, this.m_embeds)
    gc.cell_visitor_visit_t(visitor, this.m_links)
    gc.cell_visitor_visit_t(visitor, this.m_forms)
    gc.cell_visitor_visit_t(visitor, this.m_scripts)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_all)  # opaque in phase 1
    gc.cell_visitor_visit_t_2(visitor, this.m_fonts)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_selection)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_first_base_element_with_href_in_tree_order)
    gc.cell_visitor_visit_t(visitor, this.m_first_base_element_with_target_in_tree_order)
    gc.cell_visitor_visit_t(visitor, this.m_parser)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_lazy_load_intersection_observer)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_visual_viewport)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_default_timeline)  # opaque in phase 1
    gc.cell_visitor_visit_vector(visitor, &this.m_scripts_to_execute_when_parsing_has_finished)
    gc.cell_visitor_visit_vector(visitor, &this.m_scripts_to_execute_in_order_as_soon_as_possible)
    gc.cell_visitor_visit_vector(visitor, &this.m_scripts_to_execute_as_soon_as_possible)
    gc.cell_visitor_visit_hash_table_nullable(visitor, &this.m_node_iterators)
    gc.cell_visitor_visit_vector(visitor, &this.m_document_observers_being_notified)
    for pending_scroll_event in ak.vector_span(&this.m_pending_scroll_events):
        gc.cell_visitor_visit_t_2(visitor, pending_scroll_event.event_target)
    # for (auto& resize_observer : m_resize_observers) visitor.visit(resize_observer): ResizeObserver
    # is outside the phase-1 closure (its list node is not declared), so the list is always empty.

    gc.cell_visitor_visit_hash_table(visitor, &this.m_svg_roots_needing_relayout)

    for entry in ak.hash_map_begin(&this.m_shared_resource_requests):
        gc.cell_visitor_visit_t(visitor, entry.value)

