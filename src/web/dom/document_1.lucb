        gc.cell_visitor_visit_cell_2(visitor, (gc.Cell*)event.animation)  # opaque in phase 1
        gc.cell_visitor_visit_t_2(visitor, event.target)

    for event in ak.vector_span(&this.m_pending_fullscreen_events):
