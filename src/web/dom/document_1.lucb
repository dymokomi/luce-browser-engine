    gc.cell_visitor_visit_t(visitor, this.m_adopted_style_sheets)
    gc.cell_visitor_visit_hash_table(visitor, &this.m_script_blocking_style_sheet_set)

    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_active_view_transition)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_dynamic_view_transition_style_sheet)

    for view_transition in ak.vector_span(&this.m_update_callback_queue):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)view_transition)  # opaque in phase 1

    gc.cell_visitor_visit_opaque_2(visitor, &this.m_top_layer_elements)
    gc.cell_visitor_visit_opaque_2(visitor, &this.m_top_layer_pending_removals)
    gc.cell_visitor_visit_vector(visitor, &this.m_showing_auto_popover_list)
    gc.cell_visitor_visit_vector(visitor, &this.m_showing_hint_popover_list)
    gc.cell_visitor_visit_t(visitor, this.m_popover_pointerdown_target)
    gc.cell_visitor_visit_vector(visitor, &this.m_open_dialogs_list)
    gc.cell_visitor_visit_t(visitor, this.m_dialog_pointerdown_target)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_console_client)  # opaque in phase 1
    gc.cell_visitor_visit_t_2(visitor, this.m_editing_host_manager)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_local_storage_holder)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_session_storage_holder)  # opaque in phase 1
    gc.cell_visitor_visit_hash_table(visitor, &this.m_render_blocking_elements)
    gc.cell_visitor_visit_t(visitor, this.m_policy_container)
    gc.cell_visitor_visit_t_2(visitor, this.m_style_invalidator)
    gc.cell_visitor_visit_t(visitor, this.m_deferred_parser_start)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_custom_element_registry)  # opaque in phase 1

