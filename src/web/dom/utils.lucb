#==============================================================================================
#
#   utils - DOM::retarget
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Utils.cpp (lines 1-41): retargeting an object against another, used
#       by event dispatch and by the shadow-root-aware accessors (activeElement,
#       fullscreenElement).
#
#==============================================================================================

## Ported from Utils.cpp:16 Web::DOM::retarget.
# https://dom.spec.whatwg.org/#retarget
pub func dom_retarget(a_argument: DomEventTarget*?, b: DomEventTarget*?) -> DomEventTarget*?:
    var a = a_argument

    # To retarget an object A against an object B, repeat these steps until they return an object:
    while true:
        # 1. If one of the following is true then return A.
        # - A is not a node
        let a_target = a else return a
        let a_node = as_if_dom_node(a_target) else return a

        # - A’s root is not a shadow root
        let a_root = tree_node_root(a_node)
        if not is_dom_shadow_root(a_root):
            return a

        # - B is a node and A’s root is a shadow-including inclusive ancestor of B
        if let b_target = b:
            if let b_node = as_if_dom_node(b_target):
                if dom_node_is_shadow_including_inclusive_ancestor_of(a_root, b_node):
                    return a

        # 2. Set A to A’s root’s host.
        let a_shadow_root = as_dom_shadow_root(a_root)
        a = (DomEventTarget*?)dom_document_fragment_host(a_shadow_root.dom_document_fragment())
