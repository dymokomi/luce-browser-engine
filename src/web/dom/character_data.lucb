#==============================================================================================
#
#   character_data - DOM::CharacterData: the data of Text, Comment and ProcessingInstruction
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/CharacterData.cpp (lines 1-210) and the inline functions of
#       CharacterData.h: substring and replace data (with the live-range fix-ups and the
#       mutation record), the appendData/insertData/deleteData shorthands and the lazily
#       cloned grapheme, line and word segmenters.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from CharacterData.cpp:21 Web::DOM::CharacterData::CharacterData.
pub func dom_character_data_construct(this: DomCharacterData*, document: DomDocument*, type_: DomNodeType, data: ak.Utf16String):
    dom_node_construct_dom_document(this.dom_node(), document, type_)
    this.m_data = data

## Ported from CharacterData.cpp:29 Web::DOM::CharacterData::initialize (override).
pub func dom_character_data_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.character_data)
    # Base::initialize(realm): Node inherits EventTarget's.
    dom_event_target_initialize_impl(base, realm)

# mark: Data ====================================================================================

## Ported from CharacterData.h:30 Web::DOM::CharacterData::data.
pub func dom_character_data_data(this: DomCharacterData*) -> ak.Utf16String:
    return this.m_data

## Ported from CharacterData.cpp:36 Web::DOM::CharacterData::set_data.
# https://dom.spec.whatwg.org/#dom-characterdata-data
pub func dom_character_data_set_data(this: DomCharacterData*, data: ak.Utf16String):
    # [The data] setter must replace data with node this, offset 0, count this’s length, and data new value.
    # NOTE: Since the offset is 0, it can never be above data's length, so this can never throw.
    # NOTE: Setting the data to the same value as the current data still causes a mutation observer callback.
    # FIXME: Figure out a way to make this a no-op again if the passed in data is the same as the current data.
    dom_character_data_replace_data(this, 0, (usize)dom_character_data_length_in_utf16_code_units(this), ak.utf16_string_base_utf16_view(&data.utf16_string_base)) else trap("MUST: replace_data")

## Ported from CharacterData.h:33 Web::DOM::CharacterData::length_in_utf16_code_units.
pub func dom_character_data_length_in_utf16_code_units(this: DomCharacterData*) -> u32:
    return (u32)ak.utf16_string_base_length_in_code_units(&this.m_data.utf16_string_base)

## Ported from CharacterData.cpp:46 Web::DOM::CharacterData::substring_data.
# https://dom.spec.whatwg.org/#concept-cd-substring
pub func dom_character_data_substring_data(this: DomCharacterData*, offset: usize, count: usize) -> ak.Utf16String!:
    # 1. Let length be node’s length.
    let length = ak.utf16_string_base_length_in_code_units(&this.m_data.utf16_string_base)

    # 2. If offset is greater than length, then throw an "IndexSizeError" DOMException.
    if offset > length:
        try idl_throw(.idl_dom_exception(idl_index_size_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Substring offset out of range."))))

    # 3. If offset plus count is greater than length, return a string whose value is the code units from the offsetth code unit
    #    to the end of node’s data, and then return.
    if offset +% count > length:
        return ak.utf16_string_from_utf16(ak.utf16_string_base_substring_view(&this.m_data.utf16_string_base, offset))

    # 4. Return a string whose value is the code units from the offsetth code unit to the offset+countth code unit in node’s data.
    return ak.utf16_string_from_utf16(ak.utf16_string_base_substring_view_usize(&this.m_data.utf16_string_base, offset, count))

## Ported from CharacterData.cpp:65 Web::DOM::CharacterData::replace_data.
# https://dom.spec.whatwg.org/#concept-cd-replace
pub func dom_character_data_replace_data(this: DomCharacterData*, offset: usize, count_argument: usize, data: ak.Utf16View) -> !:
    var count = count_argument

    # 1. Let length be node’s length.
    let length = ak.utf16_string_base_length_in_code_units(&this.m_data.utf16_string_base)

    # 2. If offset is greater than length, then throw an "IndexSizeError" DOMException.
    if offset > length:
        try idl_throw(.idl_dom_exception(idl_index_size_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Replacement offset out of range."))))

    # 3. If offset plus count is greater than length, then set count to length minus offset.
    if offset +% count > length:
        count = length - offset

    # 5. Insert data into node’s data after offset code units.
    # 6. Let delete offset be offset + data’s length.
    # 7. Starting from delete offset code units, remove count code units from node’s data.
    let before_data = ak.utf16_string_base_substring_view_usize(&this.m_data.utf16_string_base, 0, offset)
    let after_data = ak.utf16_string_base_substring_view(&this.m_data.utf16_string_base, offset + count)

    var full_data = ak.string_builder_new_mode_usize(ak.StringBuilderMode.utf16, ak.utf16_view_length_in_code_units(&before_data) + ak.utf16_view_length_in_code_units(&data) + ak.utf16_view_length_in_code_units(&after_data))
    ak.string_builder_append_utf16_view(&full_data, before_data)
    ak.string_builder_append_utf16_view(&full_data, data)
    ak.string_builder_append_utf16_view(&full_data, after_data)

    let old_data = this.m_data
    this.m_data = ak.string_builder_to_utf16_string(&full_data)

    # 4. Queue a mutation record of "characterData" for node with null, null, node’s data, « », « », null, and null.
    # NOTE: We do this later so that the mutation observer may notify UI clients of this node's new value.
    var no_nodes: ak.Vector[DomNode*?]
    dom_node_queue_mutation_record(this.dom_node(), dom_mutation_type_character_data, none, none, ak.utf16_string_base_to_utf8_but_should_be_ported_to_utf16(&old_data.utf16_string_base), no_nodes, no_nodes, none, none)

    let this_node = this.dom_node()
    let data_length = ak.utf16_view_length_in_code_units(&data)

    # 8. For each live range whose start node is node and start offset is greater than offset but less than or equal to
    #    offset plus count, set its start offset to offset.
    for entry in ak.hash_table_begin(dom_range_live_ranges()):
        let range = *entry else continue
        let start_offset = (usize)dom_abstract_range_start_offset(range.dom_abstract_range())
        if dom_abstract_range_start_container(range.dom_abstract_range()) == this_node and start_offset > offset and start_offset <= offset + count:
            dom_range_set_start_offset(range, (u32)offset)

    # 9. For each live range whose end node is node and end offset is greater than offset but less than or equal to
    #    offset plus count, set its end offset to offset.
    for entry in ak.hash_table_begin(dom_range_live_ranges()):
        let range = *entry else continue
        let end_offset = (usize)dom_abstract_range_end_offset(range.dom_abstract_range())
        if dom_abstract_range_end_container(range.dom_abstract_range()) == this_node and end_offset > offset and end_offset <= offset + count:
            dom_range_set_end_offset(range, (u32)offset)

    # 10. For each live range whose start node is node and start offset is greater than offset plus count, increase its
    #     start offset by data’s length and decrease it by count.
    for entry in ak.hash_table_begin(dom_range_live_ranges()):
        let range = *entry else continue
        let start_offset = (usize)dom_abstract_range_start_offset(range.dom_abstract_range())
        if dom_abstract_range_start_container(range.dom_abstract_range()) == this_node and start_offset > offset + count:
            dom_range_set_start_offset(range, (u32)(start_offset +% data_length -% count))

    # 11. For each live range whose end node is node and end offset is greater than offset plus count, increase its end
    #     offset by data’s length and decrease it by count.
    for entry in ak.hash_table_begin(dom_range_live_ranges()):
        let range = *entry else continue
        let end_offset = (usize)dom_abstract_range_end_offset(range.dom_abstract_range())
        if dom_abstract_range_end_container(range.dom_abstract_range()) == this_node and end_offset > offset + count:
            dom_range_set_end_offset(range, (u32)(end_offset +% data_length -% count))

    # 12. If node’s parent is non-null, then run the children changed steps for node’s parent.
    if let parent = tree_node_parent(this_node):
        let metadata = DomNodeChildrenChangedMetadata(type_ = DomNodeChildrenChangedMetadataType.mutation, node = this_node)
        dom_node_children_changed(parent, metadata)

    # OPTIMIZATION: If the characters are the same, we can skip the remainder of this function.
    if ak.utf16_string_base_eq_utf16_string_base(&this.m_data.utf16_string_base, &old_data.utf16_string_base):
        return

    # NB: Called during DOM text mutation, layout is stale.
    if let layout_node = dom_node_unsafe_layout_node(this_node):
        if let text_node = as_if_layout_text_node(layout_node):
            # NOTE: Since the text node's data has changed, we need to invalidate the text for rendering.
            #       This ensures that the new text is reflected in layout, even if we don't end up
            #       doing a full layout tree rebuild.
            layout_text_node_invalidate_text_for_rendering(text_node)

            # We also need to relayout.
            layout_node_set_needs_layout_update(text_node.layout_node(), DomSetNeedsLayoutReason.character_data_replace_data)

    dom_document_bump_character_data_version(dom_node_document(this_node))

    let current_data = ak.utf16_string_base_utf16_view(&this.m_data.utf16_string_base)
    if let segmenter = this.m_grapheme_segmenter:
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, current_data)
    if let segmenter = this.m_line_segmenter:
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, current_data)
    if let segmenter = this.m_word_segmenter:
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, current_data)

    css_invalidation_invalidate_style_after_text_directionality_change(this)

## Ported from CharacterData.cpp:160 Web::DOM::CharacterData::append_data.
# https://dom.spec.whatwg.org/#dom-characterdata-appenddata
pub func dom_character_data_append_data(this: DomCharacterData*, data: ak.Utf16View) -> !:
    # The appendData(data) method steps are to replace data with node this, offset this’s length, count 0, and data data.
    try dom_character_data_replace_data(this, (usize)dom_character_data_length_in_utf16_code_units(this), 0, data)

## Ported from CharacterData.cpp:167 Web::DOM::CharacterData::insert_data.
# https://dom.spec.whatwg.org/#dom-characterdata-insertdata
pub func dom_character_data_insert_data(this: DomCharacterData*, offset: usize, data: ak.Utf16View) -> !:
    # The insertData(offset, data) method steps are to replace data with node this, offset offset, count 0, and data data.
    try dom_character_data_replace_data(this, offset, 0, data)

## Ported from CharacterData.cpp:174 Web::DOM::CharacterData::delete_data.
# https://dom.spec.whatwg.org/#dom-characterdata-deletedata
pub func dom_character_data_delete_data(this: DomCharacterData*, offset: usize, count: usize) -> !:
    # The deleteData(offset, count) method steps are to replace data with node this, offset offset, count count, and data the empty string.
    try dom_character_data_replace_data(this, offset, count, ak.utf16_view_new())

# mark: Segmenters ==============================================================================

## Ported from CharacterData.cpp:180 Web::DOM::CharacterData::grapheme_segmenter.
pub func dom_character_data_grapheme_segmenter(this: DomCharacterData*) -> web_unicode.Segmenter*:
    if this.m_grapheme_segmenter == none:
        let segmenter = web_unicode.segmenter_clone(dom_document_grapheme_segmenter(dom_node_document(this.dom_node())))
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, ak.utf16_string_base_utf16_view(&this.m_data.utf16_string_base))
        this.m_grapheme_segmenter = segmenter

    return this.m_grapheme_segmenter else trap("VERIFY: grapheme segmenter")

## Ported from CharacterData.cpp:190 Web::DOM::CharacterData::line_segmenter.
pub func dom_character_data_line_segmenter(this: DomCharacterData*) -> web_unicode.Segmenter*:
    if this.m_line_segmenter == none:
        let segmenter = web_unicode.segmenter_clone(dom_document_line_segmenter(dom_node_document(this.dom_node())))
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, ak.utf16_string_base_utf16_view(&this.m_data.utf16_string_base))
        this.m_line_segmenter = segmenter

    return this.m_line_segmenter else trap("VERIFY: line segmenter")

## Ported from CharacterData.cpp:200 Web::DOM::CharacterData::word_segmenter.
pub func dom_character_data_word_segmenter(this: DomCharacterData*) -> web_unicode.Segmenter*:
    if this.m_word_segmenter == none:
        let segmenter = web_unicode.segmenter_clone(dom_document_word_segmenter(dom_node_document(this.dom_node())))
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, ak.utf16_string_base_utf16_view(&this.m_data.utf16_string_base))
        this.m_word_segmenter = segmenter

    return this.m_word_segmenter else trap("VERIFY: word segmenter")
