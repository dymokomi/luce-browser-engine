## Ported from NodeList.cpp:14 Web::DOM::NodeList::NodeList.
pub func dom_node_list_construct(this: DomNodeList*, realm: Realm*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.platform_object.m_legacy_platform_object_flags = BindPlatformObjectLegacyPlatformObjectFlags(supports_indexed_properties = 1)

## Ported from NodeList.cpp:22 Web::DOM::NodeList::initialize (override).
pub func dom_node_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.node_list)
    # Base::initialize(realm): PlatformObject inherits JS::Object's.
    js_cell_initialize_impl(base, realm)

## Ported from NodeList.cpp:28 Web::DOM::NodeList::item_value (override).
pub func dom_node_list_item_value_impl(base: BindPlatformObject*, index: usize) -> JsValue?:
    let node = dom_node_list_item((DomNodeList*)base, (u32)index) else return none
    return bind_platform_object_wrapper(node.bind_platform_object())

