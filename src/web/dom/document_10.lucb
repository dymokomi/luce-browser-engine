# mark: History =================================================================================

## Ported from Document.cpp:5828 Web::DOM::Document::restore_the_history_object_state.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#restore-the-history-object-state
pub func dom_document_restore_the_history_object_state(this: DomDocument*, entry: HtmlSessionHistoryEntry*):
    # 1. Let targetRealm be document's relevant realm.
    let target_realm = html_relevant_realm((JsObject*)this)

    # 2. Let state be StructuredDeserialize(entry's classic history API state, targetRealm). If this throws an exception, catch it and let state be null.
    # 3. Set document's history object's state to state.
    let history = this.m_history else trap("the document has no history object")
    let state: JsValue? = html_structured_deserialize(realm_vm(target_realm), html_session_history_entry_classic_history_api_state(entry), target_realm) catch: recover none
    if let deserialized = state:
        html_history_set_state(history, deserialized)
    else:
        html_history_set_state(history, js_null())

## The captures of the hashchange task: `[hashchange_event, &relevant_global_object]`.
struct DomDocumentHashChangeTask:
    var hashchange_event: DomEvent*
    var relevant_global_object: HtmlWindow*

## The hashchange task: fire the event at the relevant global object.
func dom_document_hash_change_task(context: void*?):
    let captures = (DomDocumentHashChangeTask*)(context else trap("no captures"))
    discard(dom_event_target_dispatch_event(captures.relevant_global_object.dom_event_target(), captures.hashchange_event))

## `Optional<String> != Optional<String>` (AK's Optional operator!=).
func dom_document_optional_strings_differ(a: ak.String?, b: ak.String?) -> bool:
    let a_value = a else return b != none
    let b_value = b else return true
    return not ak.string_equals(&a_value, &b_value)

## Ported from Document.cpp:5843 Web::DOM::Document::update_for_history_step_application.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#update-document-for-history-step-application
pub func dom_document_update_for_history_step_application(this: DomDocument*, entry: HtmlSessionHistoryEntry*, do_not_reactivate: bool, script_history_length: usize, script_history_index: usize, navigation_type: BindNavigationType?, entries_for_navigation_api: ak.Vector[HtmlSessionHistoryEntry*]?, previous_entry_for_activation: HtmlSessionHistoryEntry*? = none, update_navigation_api: bool = true):
    # (void)previous_entry_for_activation;

    # 1. Let documentIsNew be true if document's latest entry is null; otherwise false.
    let document_is_new = this.m_latest_entry == none

    # 2. Let documentsEntryChanged be true if document's latest entry is not entry; otherwise false.
    let documents_entry_changed = this.m_latest_entry != entry

    # 3. Set document's history object's index to scriptHistoryIndex.
    html_history_set_index(dom_document_history(this), script_history_index)

    # 4. Set document's history object's length to scriptHistoryLength.
    html_history_set_length(dom_document_history(this), script_history_length)

    # 5. Let navigation be history's relevant global object's navigation API.
    let navigation = html_window_navigation(as_html_window((gc.Cell*)html_relevant_global_object((JsObject*)this)))

    # 6. If documentsEntryChanged is true, then:
    # NOTE: documentsEntryChanged can be false for one of two reasons: either we are restoring from bfcache,
    #      or we are asynchronously finishing up a synchronous navigation which already synchronously set document's latest entry.
    #      The doNotReactivate argument distinguishes between these two cases.
    if documents_entry_changed:
        # 1. Let oldURL be document's latest entry's URL.
        var old_url = web_url.url_empty()
        if let latest_entry = this.m_latest_entry:
            old_url = html_session_history_entry_url(latest_entry)

        # 2. Set document's latest entry to entry.
        this.m_latest_entry = entry

        # 3. Restore the history object state given document and entry.
        dom_document_restore_the_history_object_state(this, entry)

        # 4. If documentIsNew is false, then:
        if not document_is_new:
            # NOTE: Not in the spec, but otherwise document's url won't be updated in case of a same-document back/forward navigation.
            dom_document_set_url(this, html_session_history_entry_url(entry))

            # AD HOC: Skip this in situations the spec steps don't account for
            if update_navigation_api:
                # 1. Assert: navigationType is not null.
                let type_ = navigation_type else trap("VERIFY: navigationType is not null")
                # 2. Update the navigation API entries for a same-document navigation given navigation, entry, and navigationType.
                html_navigation_update_the_navigation_api_entries_for_a_same_document_navigation(navigation, entry, type_)

            # 3. Fire an event named popstate at document's relevant global object, using PopStateEvent,
            #    with the state attribute initialized to document's history object's state and hasUAVisualTransition initialized to true
            #    if a visual transition, to display a cached rendered state of the latest entry, was done by the user agent.
            # FIXME: Initialise hasUAVisualTransition
            var popstate_event_init = HtmlPopStateEventInit()
            popstate_event_init.state = html_history_unsafe_state(dom_document_history(this))
            let relevant_global_object = as_html_window((gc.Cell*)html_relevant_global_object((JsObject*)this))
            let pop_state_event = html_pop_state_event_create(dom_document_realm(this), ak.fly_string_from_str("popstate"), popstate_event_init)
            discard(dom_event_target_dispatch_event(relevant_global_object.dom_event_target(), pop_state_event))

            # FIXME: 4. Restore persisted state given entry.

            # 5. If oldURL's fragment is not equal to entry's URL's fragment, then queue a global task on the DOM manipulation task source
            #    given document's relevant global object to fire an event named hashchange at document's relevant global object,
            #    using HashChangeEvent, with the oldURL attribute initialized to the serialization of oldURL and the newURL attribute
            #    initialized to the serialization of entry's URL.
            let entry_url = html_session_history_entry_url(entry)
            if dom_document_optional_strings_differ(web_url.url_fragment(&old_url), web_url.url_fragment(&entry_url)):
                var hashchange_event_init = HtmlHashChangeEventInit()
                hashchange_event_init.old_url = web_url.url_serialize(&old_url)
                hashchange_event_init.new_url = web_url.url_serialize(&entry_url)
                let hashchange_event = html_hash_change_event_create(dom_document_realm(this), ak.fly_string_from_str("hashchange"), hashchange_event_init)
                let captures = new DomDocumentHashChangeTask(hashchange_event = hashchange_event, relevant_global_object = relevant_global_object) else trap("out of memory")
                discard(html_queue_global_task(HtmlTaskSource.dom_manipulation, (JsObject*)relevant_global_object, gc.create_function0[unit](gc.cell_heap(this.cell()), ak.Function0[unit](call = dom_document_hash_change_task, context = captures))))

        # 5. Otherwise:
        else:
            # 1. Assert: entriesForNavigationAPI is given.
            let entries = entries_for_navigation_api else trap("VERIFY: entriesForNavigationAPI is given")

            # FIXME: 2. Restore persisted state given entry.

            # 3. Initialize the navigation API entries for a new document given navigation, entriesForNavigationAPI, and entry.
            html_navigation_initialize_the_navigation_api_entries_for_a_new_document(navigation, entries, entry)

    # FIXME: 7. If all the following are true:
    #    - previousEntryForActivation is given;
    #    - navigationType is non-null; and
    #    - navigationType is "reload" or previousEntryForActivation's document is not document, then:
    #        FIXME: 1. If navigation's activation is null, then set navigation's activation to a new NavigationActivation object in navigation's relevant realm.
