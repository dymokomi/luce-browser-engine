## Ported from Document.cpp:5968 Web::DOM::Document::set_ready_to_run_scripts.
pub func dom_document_set_ready_to_run_scripts(this: DomDocument*):
    this.m_ready_to_run_scripts = true
    if let callback = this.m_deferred_parser_start:
        this.m_deferred_parser_start = none
        ak.function0_call(&callback.function)

