    # 3. Set the end of this to boundary point (parent, node’s index).
    try dom_range_set_start_or_end(this, parent else trap("unreachable"), (u32)tree_node_index(node), DomRangeStartOrEnd.end)

## Ported from Range.cpp:289 Web::DOM::Range::set_end_after.
# https://dom.spec.whatwg.org/#dom-range-setendafter
pub func dom_range_set_end_after(this: DomRange*, node: DomNode*) -> !:
    # 1. Let parent be node’s parent.
    # 2. If parent is null, then throw an "InvalidNodeTypeError" DOMException.
    let parent = tree_node_parent(node)
    if parent == none:
        try idl_throw(.idl_dom_exception(idl_invalid_node_type_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Given node has no parent."))))

