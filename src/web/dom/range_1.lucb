    try dom_range_set_start_or_end(this, parent else trap("unreachable"), (u32)(tree_node_index(node) + 1), DomRangeStartOrEnd.end)

# mark: Comparing ===============================================================================

## Range::HowToCompareBoundaryPoints (an unnamed C++ enum of WebIDL::UnsignedShort constants).
let dom_range_start_to_start: u16 = 0
let dom_range_start_to_end: u16 = 1
let dom_range_end_to_end: u16 = 2
let dom_range_end_to_start: u16 = 3

## Ported from Range.cpp:303 Web::DOM::Range::compare_boundary_points.
# https://dom.spec.whatwg.org/#dom-range-compareboundarypoints
pub func dom_range_compare_boundary_points(this: DomRange*, how: u16, source_range: DomRange*) -> i16!:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # 1. If how is not one of
    #      - START_TO_START,
    #      - START_TO_END,
    #      - END_TO_END, and
    #      - END_TO_START,
    #    then throw a "NotSupportedError" DOMException.
    if how != dom_range_start_to_start and how != dom_range_start_to_end and how != dom_range_end_to_end and how != dom_range_end_to_start:
        var message = ak.string_builder_new_mode(ak.StringBuilderMode.utf16)
        ak.string_builder_append(&message, "Expected 'how' to be one of START_TO_START (0), START_TO_END (1), END_TO_END (2) or END_TO_START (3), got ")
        let number = ak.string_number_u64((u64)how)
        ak.string_builder_append_string_view(&message, ak.string_bytes_as_string_view(&number))
        try idl_throw(.idl_dom_exception(idl_not_supported_error_create(realm, ak.string_builder_to_utf16_string(&message))))

    # 2. If this’s root is not the same as sourceRange’s root, then throw a "WrongDocumentError" DOMException.
    if dom_range_root(this) != dom_range_root(source_range):
        try idl_throw(.idl_dom_exception(idl_wrong_document_error_create(realm, ak.utf16_string_from_str("This range is not in the same tree as the source range."))))

    var this_point_node: DomNode*? = none
    var this_point_offset: u32 = 0

    var other_point_node: DomNode*? = none
    var other_point_offset: u32 = 0

    # 3. If how is:
    match how:
        0:
            # -> START_TO_START:
            #    Let this point be this’s start. Let other point be sourceRange’s start.
            this_point_node = this.abstract_range.m_start_container
            this_point_offset = this.abstract_range.m_start_offset

            other_point_node = source_range.abstract_range.m_start_container
            other_point_offset = source_range.abstract_range.m_start_offset
        1:
            # -> START_TO_END:
            #    Let this point be this’s end. Let other point be sourceRange’s start.
            this_point_node = this.abstract_range.m_end_container
            this_point_offset = this.abstract_range.m_end_offset

            other_point_node = source_range.abstract_range.m_start_container
            other_point_offset = source_range.abstract_range.m_start_offset
        2:
            # -> END_TO_END:
            #    Let this point be this’s end. Let other point be sourceRange’s end.
            this_point_node = this.abstract_range.m_end_container
            this_point_offset = this.abstract_range.m_end_offset

            other_point_node = source_range.abstract_range.m_end_container
            other_point_offset = source_range.abstract_range.m_end_offset
        3:
            # -> END_TO_START:
            #    Let this point be this’s start. Let other point be sourceRange’s end.
            this_point_node = this.abstract_range.m_start_container
            this_point_offset = this.abstract_range.m_start_offset

            other_point_node = source_range.abstract_range.m_end_container
            other_point_offset = source_range.abstract_range.m_end_offset
        _:
            trap("VERIFY_NOT_REACHED")

    let this_point = this_point_node else trap("VERIFY: this point")
    let other_point = other_point_node else trap("VERIFY: other point")

    # 4. If the position of this point relative to other point is
    let relative_position = dom_position_of_boundary_point_relative_to_other_boundary_point(DomBoundaryPoint(node = this_point, offset = this_point_offset), DomBoundaryPoint(node = other_point, offset = other_point_offset))
    match relative_position:
        .before:
            # -> before
            #    Return −1.
            return -1
        .equal:
            # -> equal
            #    Return 0.
            return 0
        .after:
            # -> after
            #    Return 1.
            return 1
        _:
            trap("VERIFY_NOT_REACHED")

# mark: Selecting and collapsing ================================================================

## Ported from Range.cpp:390 Web::DOM::Range::select.
# https://dom.spec.whatwg.org/#concept-range-select
func dom_range_select(this: DomRange*, node: DomNode*) -> !:
    # 1. Let parent be node’s parent.
    # 2. If parent is null, then throw an "InvalidNodeTypeError" DOMException.
    let parent = tree_node_parent(node)
    if parent == none:
        try idl_throw(.idl_dom_exception(idl_invalid_node_type_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Given node has no parent."))))
    let parent_node = parent else trap("unreachable")

    # 3. Let index be node’s index.
    let index = tree_node_index(node)

    # 4. Set range’s start to boundary point (parent, index).
    this.abstract_range.m_start_container = parent_node
    this.abstract_range.m_start_offset = (u32)index

    # 5. Set range’s end to boundary point (parent, index plus 1).
    this.abstract_range.m_end_container = parent_node
    this.abstract_range.m_end_offset = (u32)(index + 1)

    dom_range_update_associated_selection(this)

## Ported from Range.cpp:415 Web::DOM::Range::select_node.
# https://dom.spec.whatwg.org/#dom-range-selectnode
pub func dom_range_select_node(this: DomRange*, node: DomNode*) -> !:
    # The selectNode(node) method steps are to select node within this.
    try dom_range_select(this, node)

## Ported from Range.cpp:422 Web::DOM::Range::collapse.
# https://dom.spec.whatwg.org/#dom-range-collapse
pub func dom_range_collapse(this: DomRange*, to_start: bool):
    # The collapse(toStart) method steps are to, if toStart is true, set end to start; otherwise set start to end.
    if to_start:
        this.abstract_range.m_end_container = this.abstract_range.m_start_container
        this.abstract_range.m_end_offset = this.abstract_range.m_start_offset
    else:
        this.abstract_range.m_start_container = this.abstract_range.m_end_container
        this.abstract_range.m_start_offset = this.abstract_range.m_end_offset
    dom_range_update_associated_selection(this)

## Ported from Range.cpp:436 Web::DOM::Range::select_node_contents.
# https://dom.spec.whatwg.org/#dom-range-selectnodecontents
pub func dom_range_select_node_contents(this: DomRange*, node: DomNode*) -> !:
    # 1. If node is a doctype, throw an "InvalidNodeTypeError" DOMException.
    if is_dom_document_type(node):
        try idl_throw(.idl_dom_exception(idl_invalid_node_type_error_create(bind_platform_object_realm(this.bind_platform_object()), ak.utf16_string_from_str("Node cannot be a DocumentType."))))

    # 2. Let length be the length of node.
    let length = dom_node_length(node)

    # 3. Set start to the boundary point (node, 0).
    this.abstract_range.m_start_container = node
    this.abstract_range.m_start_offset = 0

    # 4. Set end to the boundary point (node, length).
    this.abstract_range.m_end_container = node
    this.abstract_range.m_end_offset = (u32)length

    dom_range_update_associated_selection(this)

## Ported from Range.cpp:457 Web::DOM::Range::clone_range.
pub func dom_range_clone_range(this: DomRange*) -> DomRange*:
    let realm = bind_platform_object_realm(this.bind_platform_object())
    return realm_create_dom_range_dom_node(realm, this.abstract_range.m_start_container, this.abstract_range.m_start_offset, this.abstract_range.m_end_container, this.abstract_range.m_end_offset)

## Ported from Range.cpp:463 Web::DOM::Range::common_ancestor_container.
# https://dom.spec.whatwg.org/#dom-range-commonancestorcontainer
pub func dom_range_common_ancestor_container(this: DomRange*) -> DomNode*:
    # 1. Let container be start node.
    var container = this.abstract_range.m_start_container

    # 2. While container is not an inclusive ancestor of end node, let container be container’s parent.
    while not tree_node_is_inclusive_ancestor_of(container, this.abstract_range.m_end_container):
        container = tree_node_parent(container) else trap("VERIFY: container's parent")

    # 3. Return container.
    return container
