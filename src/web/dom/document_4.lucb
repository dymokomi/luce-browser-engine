## `layout_node && layout_node->first_paintable()`: the highlighted layout node's first paintable.
func dom_document_highlighted_first_paintable(this: DomDocument*) -> PaintPaintable*?:
    let layout_node = dom_document_highlighted_layout_node(this) else return none
    return layout_node_first_paintable(layout_node)

## Ported from Document.cpp:2103 Web::DOM::Document::set_highlighted_node.
pub func dom_document_set_highlighted_node(this: DomDocument*, node: DomNode*?, pseudo_element: css_data.PseudoElement?):
    if this.m_highlighted_node == node and this.m_highlighted_pseudo_element == pseudo_element:
        return

    if let first_paintable = dom_document_highlighted_first_paintable(this):
        paint_paintable_set_needs_repaint(first_paintable, InvalidateDisplayList.yes)

    this.m_highlighted_node = node
    this.m_highlighted_pseudo_element = pseudo_element

    if let first_paintable = dom_document_highlighted_first_paintable(this):
        paint_paintable_set_needs_repaint(first_paintable, InvalidateDisplayList.yes)

## Ported from Document.cpp:2118 Web::DOM::Document::highlighted_layout_node.
pub func dom_document_highlighted_layout_node(this: DomDocument*) -> LayoutNode*?:
    let highlighted_node = this.m_highlighted_node else return none

    # NB: Called during painting inside update_layout().
    let pseudo_element = this.m_highlighted_pseudo_element
    if pseudo_element == none or not dom_node_is_element(highlighted_node):
        return dom_node_unsafe_layout_node(highlighted_node)

    let element = (DomElement*)highlighted_node
    let pseudo = pseudo_element else trap("unreachable: checked above")
    return (LayoutNode*?)dom_element_get_pseudo_element_node(element, pseudo)

# mark: Hovering ================================================================================

## Ported from Document.cpp:2131 Web::DOM::find_common_ancestor.
func dom_find_common_ancestor(a: DomNode*?, b: DomNode*?) -> DomNode*?:
    let node_a = a else return none
    let node_b = b else return none

    if node_a == node_b:
        return node_a

    var ancestors: ak.HashTable[DomNode*, ak.PtrTraits[DomNode]]
    var node: DomNode*? = node_a
    while let current = node:
        _ = ak.hash_table_set(&ancestors, current)
        node = (DomNode*?)dom_node_parent_or_shadow_host(current)

    node = node_b
    while let current = node:
        if ak.hash_table_contains_t(&ancestors, current):
            return current
        node = (DomNode*?)dom_node_parent_or_shadow_host(current)

    return none

## A PointerEventInit for a mouse pointer, as set_hovered_node fills it.
func dom_document_hover_pointer_event_init(this: DomDocument*, related_target: DomNode*?, bubbles_cancelable_composed: bool) -> UiEventsPointerEventInit:
    var pointer_event_init = UiEventsPointerEventInit()
    if bubbles_cancelable_composed:
        pointer_event_init.mouse_event_init.event_modifier_init.ui_event_init.event_init.bubbles = true
        pointer_event_init.mouse_event_init.event_modifier_init.ui_event_init.event_init.cancelable = true
        pointer_event_init.mouse_event_init.event_modifier_init.ui_event_init.event_init.composed = true
    pointer_event_init.mouse_event_init.related_target = (DomEventTarget*?)related_target
    pointer_event_init.is_primary = true
    # UIEvents::PointerTypes::Mouse
    pointer_event_init.pointer_type = ak.string_from_str("mouse")
    if let navigable = dom_document_navigable(this):
        pointer_event_init.mouse_event_init.event_modifier_init.ui_event_init.view = html_navigable_active_window_proxy(navigable)
    return pointer_event_init

## Ported from Document.cpp:2151 Web::DOM::Document::set_hovered_node.
pub func dom_document_set_hovered_node(this: DomDocument*, node: DomNode*?):
    if this.m_hovered_node == node:
        return

    # move(m_hovered_node) leaves the member null until it is set below.
    let old_hovered_node = this.m_hovered_node
    this.m_hovered_node = none
    let common_ancestor = dom_find_common_ancestor(old_hovered_node, node)

    var old_hovered_node_root: DomNode*? = none
    var new_hovered_node_root: DomNode*? = none
    if let old = old_hovered_node:
        old_hovered_node_root = tree_node_root(old)
    if let new_node = node:
        new_hovered_node_root = tree_node_root(new_node)
    if old_hovered_node_root != new_hovered_node_root:
        if let old_root = old_hovered_node_root:
            css_invalidation_invalidate_style_after_pseudo_class_state_change_dom_node(css_data.PseudoClass.hover, this, &this.m_hovered_node, old_root, node)
        if let new_root = new_hovered_node_root:
            css_invalidation_invalidate_style_after_pseudo_class_state_change_dom_node(css_data.PseudoClass.hover, this, &this.m_hovered_node, new_root, node)
    else:
        let invalidation_root = common_ancestor else trap("hovered nodes in one tree have a common ancestor")
        css_invalidation_invalidate_style_after_pseudo_class_state_change_dom_node(css_data.PseudoClass.hover, this, &this.m_hovered_node, invalidation_root, node)

    this.m_hovered_node = node

    # https://w3c.github.io/pointerevents/#the-pointerout-event
    if let old = old_hovered_node:
        if old != this.m_hovered_node:
            let pointer_event_init = dom_document_hover_pointer_event_init(this, this.m_hovered_node, true)
            let event = ui_events_pointer_event_create(dom_document_realm(this), ui_events_event_names_pointerout, pointer_event_init)
            _ = dom_event_target_dispatch_event(old.dom_event_target(), (DomEvent*)event)

    # https://w3c.github.io/uievents/#mouseout
    if let old = old_hovered_node:
        if old != this.m_hovered_node:
            var mouse_event_init = UiEventsMouseEventInit()
            mouse_event_init.event_modifier_init.ui_event_init.event_init.bubbles = true
            mouse_event_init.event_modifier_init.ui_event_init.event_init.cancelable = true
            mouse_event_init.event_modifier_init.ui_event_init.event_init.composed = true
            mouse_event_init.related_target = (DomEventTarget*?)this.m_hovered_node
            if let navigable = dom_document_navigable(this):
                mouse_event_init.event_modifier_init.ui_event_init.view = html_navigable_active_window_proxy(navigable)
            let event = ui_events_mouse_event_create(dom_document_realm(this), ui_events_event_names_mouseout, mouse_event_init)
            _ = dom_event_target_dispatch_event(old.dom_event_target(), (DomEvent*)event)

    # https://w3c.github.io/pointerevents/#the-pointerleave-event
    if let old = old_hovered_node:
        var hovered_is_descendant_of_old = false
        if let hovered = this.m_hovered_node:
            hovered_is_descendant_of_old = tree_node_is_descendant_of(hovered, old)
        if not hovered_is_descendant_of_old:
            var target: DomNode*? = old
            while let current = target:
                if current == common_ancestor:
                    break
                # FIXME: Populate the event with mouse coordinates, etc.
                let pointer_event_init = dom_document_hover_pointer_event_init(this, this.m_hovered_node, false)
                _ = dom_event_target_dispatch_event(current.dom_event_target(), (DomEvent*)ui_events_pointer_event_create(dom_document_realm(this), ui_events_event_names_pointerleave, pointer_event_init))
                target = tree_node_parent(current)

    # https://w3c.github.io/uievents/#mouseleave
    if let old = old_hovered_node:
        var hovered_is_descendant_of_old = false
        if let hovered = this.m_hovered_node:
            hovered_is_descendant_of_old = tree_node_is_descendant_of(hovered, old)
        if not hovered_is_descendant_of_old:
            var target: DomNode*? = old
            while let current = target:
                if current == common_ancestor:
                    break
                # FIXME: Populate the event with mouse coordinates, etc.
                var mouse_event_init = UiEventsMouseEventInit()
                mouse_event_init.related_target = (DomEventTarget*?)this.m_hovered_node
                _ = dom_event_target_dispatch_event(current.dom_event_target(), (DomEvent*)ui_events_mouse_event_create(dom_document_realm(this), ui_events_event_names_mouseleave, mouse_event_init))
                target = (DomNode*?)dom_node_parent_or_shadow_host(current)

    # https://w3c.github.io/pointerevents/#the-pointerover-event
    if let hovered = this.m_hovered_node:
        if hovered != old_hovered_node:
            let pointer_event_init = dom_document_hover_pointer_event_init(this, old_hovered_node, true)
            let event = ui_events_pointer_event_create(dom_document_realm(this), ui_events_event_names_pointerover, pointer_event_init)
            _ = dom_event_target_dispatch_event(hovered.dom_event_target(), (DomEvent*)event)

    # https://w3c.github.io/uievents/#mouseover
    if let hovered = this.m_hovered_node:
        if hovered != old_hovered_node:
            var mouse_event_init = UiEventsMouseEventInit()
            mouse_event_init.event_modifier_init.ui_event_init.event_init.bubbles = true
            mouse_event_init.event_modifier_init.ui_event_init.event_init.cancelable = true
            mouse_event_init.event_modifier_init.ui_event_init.event_init.composed = true
            mouse_event_init.related_target = (DomEventTarget*?)old_hovered_node
            if let navigable = dom_document_navigable(this):
                mouse_event_init.event_modifier_init.ui_event_init.view = html_navigable_active_window_proxy(navigable)
            let event = ui_events_mouse_event_create(dom_document_realm(this), ui_events_event_names_mouseover, mouse_event_init)
            _ = dom_event_target_dispatch_event(hovered.dom_event_target(), (DomEvent*)event)

    # https://w3c.github.io/pointerevents/#the-pointerenter-event
    # https://w3c.github.io/uievents/#mouseenter
    # Enter events are dispatched from ancestor to descendant.
    # Leave events are dispatched in the opposite order.
    if let hovered = this.m_hovered_node:
        var hovered_is_ancestor_of_old = false
        if let old = old_hovered_node:
            hovered_is_ancestor_of_old = tree_node_is_ancestor_of(hovered, old)
        if not hovered_is_ancestor_of_old:
            var entered_ancestors: ak.Vector[DomNode*]
            var target: DomNode*? = hovered
            while let current = target:
                if current == common_ancestor:
                    break
                ak.vector_append_t(&entered_ancestors, current)
                target = (DomNode*?)dom_node_parent_or_shadow_host(current)

            var index = ak.vector_size(&entered_ancestors)
            while index > 0:
                index -= 1
                let entered = *ak.vector_at(&entered_ancestors, index)
                # FIXME: Populate the events with mouse coordinates, etc.
                let pointer_event_init = dom_document_hover_pointer_event_init(this, old_hovered_node, false)
                _ = dom_event_target_dispatch_event(entered.dom_event_target(), (DomEvent*)ui_events_pointer_event_create(dom_document_realm(this), ui_events_event_names_pointerenter, pointer_event_init))
                var mouse_event_init = UiEventsMouseEventInit()
                mouse_event_init.related_target = (DomEventTarget*?)old_hovered_node
                _ = dom_event_target_dispatch_event(entered.dom_event_target(), (DomEvent*)ui_events_mouse_event_create(dom_document_realm(this), ui_events_event_names_mouseenter, mouse_event_init))
