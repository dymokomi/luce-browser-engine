## links()'s filter: a and area elements with an href.
func dom_document_links_filter(context: void*?, element: DomElement*) -> bool:
    return (is_html_anchor_element(element) or is_html_area_element(element)) and dom_element_has_attribute(element, html_attribute_names_href)

