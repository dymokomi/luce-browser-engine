## Ported from Document.cpp:2520 Web::DOM::Document::create_event.
# https://dom.spec.whatwg.org/#dom-document-createevent
pub func dom_document_create_event(this: DomDocument*, interface_: ak.StringView) -> DomEvent*!:
    let realm = dom_document_realm(this)
    let empty = ak.fly_string_new()

    # NOTE: This is named event here, since we do step 5 and 6 as soon as possible for each case.
    # 1. Let constructor be null.
    var event: DomEvent*? = none

    # 2. If interface is an ASCII case-insensitive match for any of the strings in the first column in the following table,
    #      then set constructor to the interface in the second column on the same row as the matching string:
    if ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("beforeunloadevent")):
        event = html_before_unload_event_create(realm, empty).dom_event()
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("compositionevent")):
        event = ui_events_composition_event_create(realm, ak.String())
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("customevent")):
        event = dom_custom_event_create(realm, empty, DomCustomEventInit()).dom_event()
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("devicemotionevent")):
        event = dom_event_create(realm, empty)  # FIXME: Create DeviceMotionEvent
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("deviceorientationevent")):
        event = dom_event_create(realm, empty)  # FIXME: Create DeviceOrientationEvent
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("dragevent")):
        event = html_drag_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("event")) or ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("events")):
        event = dom_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("focusevent")):
        event = ui_events_focus_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("hashchangeevent")):
        event = html_hash_change_event_create(realm, empty, HtmlHashChangeEventInit())
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("htmlevents")):
        event = dom_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("keyboardevent")):
        event = ui_events_keyboard_event_create(realm, ak.String())
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("messageevent")):
        event = html_message_event_create(realm, ak.String())
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("mouseevent")) or ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("mouseevents")):
        event = (DomEvent*)ui_events_mouse_event_create(realm, empty, UiEventsMouseEventInit())
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("storageevent")):
        event = html_storage_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("svgevents")):
        event = dom_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("textevent")):
        event = ui_events_text_event_create(realm, empty)
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("touchevent")):
        event = dom_event_create(realm, empty)  # FIXME: Create TouchEvent
    elif ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("uievent")) or ak.string_view_equals_ignoring_ascii_case(&interface_, ak.sv("uievents")):
        event = ui_events_ui_event_create(realm, empty)

    # 3. If constructor is null, then throw a "NotSupportedError" DOMException.
    let created = event else return try dom_document_throw(idl_not_supported_error_create(realm, ak.utf16_string_from_str("No constructor for interface found")))

    # FIXME: 4. If the interface indicated by constructor is not exposed on the relevant global object of this, then throw a "NotSupportedError" DOMException.

    # NOTE: These are done in the if-chain above
    # 5. Let event be the result of creating an event given constructor.
    # 6. Initialize event’s type attribute to the empty string.
    # 7. Initialize event’s timeStamp attribute to the result of calling current high resolution time with this’s relevant global object.
    # NOTE: This is handled by each constructor.

    # 8. Initialize event’s isTrusted attribute to false.
    dom_event_set_is_trusted(created, false)

    # 9. Unset event’s initialized flag.
    dom_event_set_initialized(created, false)

    # 10. Return event.
    return created

