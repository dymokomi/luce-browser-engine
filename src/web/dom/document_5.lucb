#==============================================================================================
#
#   document_5 - DOM::Document: collections, node factories, scripts, adoption
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Document.cpp (lines 2282-2828): getElementsByName, the document's
#       HTMLCollections and document.all, fonts, the obsolete no-op methods, the relevant
#       settings object, createElement(NS), the node and event factories, the parsing-blocking
#       and deferred script lists, importNode, adopting a node, the doctype and compatMode,
#       and the active element.
#
#==============================================================================================

# mark: Collections =============================================================================

## The captures of getElementsByName()'s filter: `[name]`.
struct DomDocumentGetElementsByNameFilter:
    var name: ak.FlyString

## getElementsByName()'s filter: HTML elements whose name is `name`.
func dom_document_get_elements_by_name_filter(context: void*?, node: DomNode*) -> bool:
    let captures = (DomDocumentGetElementsByNameFilter*)(context else trap("no captures"))
    if not is_html_element(node):
        return false
    let element_name = dom_element_name((DomElement*)node) else return false
    return ak.fly_string_eq_fly_string(&element_name, &captures.name)

## Ported from Document.cpp:2282 Web::DOM::Document::get_elements_by_name.
# https://html.spec.whatwg.org/multipage/dom.html#dom-document-getelementsbyname
pub func dom_document_get_elements_by_name(this: DomDocument*, name: ak.FlyString) -> DomNodeList*:
    let captures = new DomDocumentGetElementsByNameFilter(name = name) else trap("out of memory")
    return dom_live_node_list_create(dom_document_realm(this), this.dom_node(), DomLiveNodeListScope.descendants, ak.Function1[DomNode*, bool](call = dom_document_get_elements_by_name_filter, context = captures))

## A document collection over its descendants with `filter` and no sort.
func dom_document_collection(this: DomDocument*, filter: func(void*?, DomElement*) -> bool) -> DomHtmlCollection*:
    return dom_html_collection_create(this.dom_parent_node(), DomHtmlCollectionScope.descendants, ak.Function1[DomElement*, bool](call = filter, context = none), ak.Function2[DomElement*, DomElement*, bool]())

## applets()'s filter: nothing.
func dom_document_applets_filter(context: void*?, element: DomElement*) -> bool:
    return false

## Ported from Document.cpp:2292 Web::DOM::Document::applets.
# https://html.spec.whatwg.org/multipage/obsolete.html#dom-document-applets
pub func dom_document_applets(this: DomDocument*) -> DomHtmlCollection*:
    if this.m_applets == none:
        this.m_applets = dom_document_collection(this, dom_document_applets_filter)
    return this.m_applets else trap("unreachable: set above")

## anchors()'s filter: a elements with a name.
func dom_document_anchors_filter(context: void*?, element: DomElement*) -> bool:
    return is_html_anchor_element(element) and dom_element_name(element) != none

## Ported from Document.cpp:2300 Web::DOM::Document::anchors.
# https://html.spec.whatwg.org/multipage/obsolete.html#dom-document-anchors
