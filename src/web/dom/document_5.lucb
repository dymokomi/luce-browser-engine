# mark: Importing and adopting nodes ============================================================

## Ported from Document.cpp:2663 Web::DOM::Document::import_node.
# https://dom.spec.whatwg.org/#dom-document-importnode
pub func dom_document_import_node(this: DomDocument*, node: DomNode*, options: BoolOrDomImportNodeOptions) -> DomNode*!:
    # 1. If node is a document or shadow root, then throw a "NotSupportedError" DOMException.
    if is_dom_document(node) or is_dom_shadow_root(node):
        return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("Cannot import a document or shadow root.")))

    # 2. Let subtree be false.
    var subtree = false

    # 3. Let registry be null.
    var registry: HtmlCustomElementRegistry*? = none

    match options:
        # 4. If options is a boolean, then set subtree to options.
        .bool_(value):
            subtree = value
        # 5. Otherwise:
        .dom_import_node_options(import_options):
            # 1. Set subtree to the negation of options["selfOnly"].
            subtree = not import_options.self_only

            # 2. If options["customElementRegistry"] exists, then set registry to it.
            if import_options.custom_element_registry != none:
                registry = import_options.custom_element_registry

            # 3. If registry’s is scoped is false and registry is not this’s custom element registry, then throw a
            #    "NotSupportedError" DOMException.
            if let given_registry = registry:
                if not html_custom_element_registry_is_scoped(given_registry) and registry != dom_document_custom_element_registry(this):
                    return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("'customElementRegistry' in ImportNodeOptions must either be scoped or the document's custom element registry.")))

    # 6. If registry is null, then set registry to the result of looking up a custom element registry given this.
    if registry == none:
        registry = html_look_up_a_custom_element_registry(this.dom_node())

    # 7. Return the result of cloning a node given node with document set to this, subtree set to subtree, and
    #   fallbackRegistry set to registry.
    return try dom_node_clone_node(node, this, subtree, none, registry)

## The captures of adopt_node's walks: the document and the old document.
struct DomDocumentAdoptNodeWalk:
    var this: DomDocument*
    var old_document: DomDocument*

## adopt_node's first walk: set the node document and the custom element registries.
func dom_document_adopt_node_set_document(context: void*?, inclusive_descendant: DomNode*) -> TraversalDecision:
    let captures = (DomDocumentAdoptNodeWalk*)(context else trap("no captures"))
    let this = captures.this

    # 1. Set inclusiveDescendant’s node document to document.
    dom_node_set_document_document(inclusive_descendant, this)

    # 2. If inclusiveDescendant is a shadow root and if any of the following are true:
    #    - inclusiveDescendant’s custom element registry is null and inclusiveDescendant’s keep custom element
    #      registry null is false; or
    #    - inclusiveDescendant’s custom element registry is a global custom element registry,
    #    then set inclusiveDescendant’s custom element registry to document’s effective global custom element
    #    registry.
    var shadow_root_needs_registry = false
    if let shadow_root = as_if_dom_shadow_root(inclusive_descendant):
        let shadow_root_registry = dom_shadow_root_custom_element_registry(shadow_root)
        shadow_root_needs_registry = (shadow_root_registry == none and not dom_shadow_root_keep_custom_element_registry_null(shadow_root)) or html_is_a_global_custom_element_registry(shadow_root_registry)
    if shadow_root_needs_registry:
        let shadow_root = as_dom_shadow_root(inclusive_descendant)
        dom_shadow_root_set_custom_element_registry(shadow_root, dom_document_effective_global_custom_element_registry(this))

    # 3. Otherwise, if inclusiveDescendant is an element:
    elif let element = as_if_dom_element(inclusive_descendant):
        # FIXME: 1. Set the node document of each attribute in inclusiveDescendant’s attribute list to document.

        # 2. If inclusiveDescendant’s custom element registry is null or inclusiveDescendant’s custom element
        #    registry’s is scoped is false, then set inclusiveDescendant’s custom element registry to
        #    document’s effective global custom element registry.
        var registry_is_scoped = false
        if let element_registry = dom_element_custom_element_registry(element):
            registry_is_scoped = html_custom_element_registry_is_scoped(element_registry)
        if not registry_is_scoped:
            dom_element_set_custom_element_registry(element, dom_document_effective_global_custom_element_registry(this))

    return TraversalDecision.continue_

## adopt_node's second walk: enqueue adoptedCallback reactions for custom elements.
func dom_document_adopt_node_enqueue_adopted_callback(context: void*?, inclusive_descendant: DomNode*) -> TraversalDecision:
    let captures = (DomDocumentAdoptNodeWalk*)(context else trap("no captures"))
    if let element = as_if_dom_element(inclusive_descendant):
        if dom_element_is_custom(element):
            var arguments: ak.Vector[JsValue]
            ak.vector_append_t(&arguments, js_value_from_object((JsObject*)captures.old_document))
            ak.vector_append_t(&arguments, js_value_from_object((JsObject*)captures.this))

            dom_element_enqueue_a_custom_element_callback_reaction(element, html_custom_element_reaction_names_adopted_callback, arguments)

    return TraversalDecision.continue_

## adopt_node's third walk: run the adopting steps.
func dom_document_adopt_node_adopted_from(context: void*?, inclusive_descendant: DomNode*) -> TraversalDecision:
    let captures = (DomDocumentAdoptNodeWalk*)(context else trap("no captures"))
    dom_node_adopted_from(inclusive_descendant, captures.old_document)
    return TraversalDecision.continue_

## Ported from Document.cpp:2707 Web::DOM::Document::adopt_node.
# https://dom.spec.whatwg.org/#concept-node-adopt
pub func dom_document_adopt_node(this: DomDocument*, node: DomNode*):
    # 1. Let oldDocument be node’s node document.
    let old_document = dom_node_document(node)

    # 2. If node’s parent is non-null, then remove node.
    if tree_node_parent(node) != none:
        dom_node_remove(node)

    # 3. If document is not oldDocument, then:
    if old_document != this:
        var captures = DomDocumentAdoptNodeWalk(this = this, old_document = old_document)

        # 1. For each inclusiveDescendant in node’s shadow-including inclusive descendants:
        _ = dom_node_for_each_shadow_including_inclusive_descendant(node, ak.Function1[DomNode*, TraversalDecision](call = dom_document_adopt_node_set_document, context = &captures))

        # 2. For each inclusiveDescendant in node’s shadow-including inclusive descendants that is custom, in
        #    shadow-including tree order:
        #    enqueue a custom element callback reaction with inclusiveDescendant, callback name "adoptedCallback", and
        #    « oldDocument, document ».
        _ = dom_node_for_each_shadow_including_inclusive_descendant(node, ak.Function1[DomNode*, TraversalDecision](call = dom_document_adopt_node_enqueue_adopted_callback, context = &captures))

        # 3. For each inclusiveDescendant in node’s shadow-including inclusive descendants, in shadow-including tree
        #     order:
        #    run the adopting steps with inclusiveDescendant and oldDocument.
        _ = dom_node_for_each_shadow_including_inclusive_descendant(node, ak.Function1[DomNode*, TraversalDecision](call = dom_document_adopt_node_adopted_from, context = &captures))

        # AD-HOC: Transfer NodeIterators rooted at `node` from old_document to this document.
        var node_iterators_to_transfer: ak.Vector[DomNodeIterator*]
        for node_iterator in ak.hash_table_begin(&old_document.m_node_iterators):
            let iterator = *node_iterator else continue
            if dom_node_iterator_root(iterator) == node:
                ak.vector_append_t(&node_iterators_to_transfer, iterator)

        for node_iterator in ak.vector_span(&node_iterators_to_transfer):
            _ = ak.hash_table_remove_t(&old_document.m_node_iterators, node_iterator)
            _ = ak.hash_table_set(&this.m_node_iterators, node_iterator)

## Ported from Document.cpp:2792 Web::DOM::Document::adopt_node_binding.
# https://dom.spec.whatwg.org/#dom-document-adoptnode
pub func dom_document_adopt_node_binding(this: DomDocument*, node: DomNode*) -> DomNode*!:
    if is_dom_document(node):
        return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("Cannot adopt a document into a document")))

    if is_dom_shadow_root(node):
        return try dom_document_throw(idl_hierarchy_request_error_create(dom_document_realm(this), ak.utf16_string_from_str("Cannot adopt a shadow root into a document")))

    if let fragment = as_if_dom_document_fragment(node):
        if dom_document_fragment_host(fragment) != none:
            return node

    dom_document_adopt_node(this, node)

    return node

# mark: Doctype, compatMode and the active element ==============================================

## Ported from Document.cpp:2808 Web::DOM::Document::doctype.
pub func dom_document_doctype(this: DomDocument*) -> DomDocumentType*?:
    return (DomDocumentType*?)tree_node_first_child_of_type(this.dom_node(), &dom_document_type_class)

## Ported from Document.cpp:2813 Web::DOM::Document::compat_mode.
pub func dom_document_compat_mode(this: DomDocument*) -> ak.String:
    if this.m_quirks_mode == DomQuirksMode.yes:
        return ak.string_from_str("BackCompat")

    return ak.string_from_str("CSS1Compat")

## Ported from Document.cpp:2824 Web::DOM::Document::update_active_element.
func dom_document_update_active_element(this: DomDocument*):
    dom_document_set_active_element(this, dom_calculate_active_element(this.dom_node()))
