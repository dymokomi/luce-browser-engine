## The scripts of `list` as roots (C++'s Vector<GC::Root<HTMLScriptElement>>), and `list` cleared.
func dom_document_take_scripts(list: ak.Vector[HtmlScriptElement*]*) -> ak.Vector[HtmlScriptElement*?]:
    var handles: ak.Vector[HtmlScriptElement*?]
    for script in ak.vector_span(list):
        ak.vector_append_t(&handles, script)
    ak.vector_clear(list)
    return handles

