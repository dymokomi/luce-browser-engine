# mark: Node factories ==========================================================================

## Ported from Document.cpp:2430 Web::DOM::Document::create_element.
# https://dom.spec.whatwg.org/#dom-document-createelement
pub func dom_document_create_element(this: DomDocument*, local_name: ak.String, options: StringOrDomElementCreationOptions) -> DomElement*!:
    # 1. If localName is not a valid element local name, then throw an "InvalidCharacterError" DOMException.
    if not dom_is_valid_element_local_name(ak.fly_string_from_string(local_name)):
        return try dom_document_throw(idl_invalid_character_error_create(dom_document_realm(this), ak.utf16_string_from_str("Invalid character in tag name.")))

    # 2. If this is an HTML document, then set localName to localName in ASCII lowercase.
    let local_name_lower = ak.string_to_ascii_lowercase(&local_name) if dom_document_document_type(this) == DocumentDomDocumentType.html else local_name

    # 3. Let registry and is be the result of flattening element creation options given options and this.
    let registry_and_is = try dom_document_flatten_element_creation_options(this, options)

    # 4. Let namespace be the HTML namespace, if this is an HTML document or this’s content type is
    #    "application/xhtml+xml"; otherwise null.
    var namespace_: ak.FlyString? = none
    let content_type = dom_document_content_type(this)
    if dom_document_document_type(this) == DocumentDomDocumentType.html or ak.string_eq_string_view(&content_type, ak.sv("application/xhtml+xml")):
        namespace_ = namespace_html

    # 5. Return the result of creating an element given this, localName, namespace, null, is, true, and registry.
    let lower_bytes = ak.string_bytes_as_string_view(&local_name_lower)
    return try dom_create_element(this, ak.fly_string_from_utf8_without_validation(ak.string_view_bytes(&lower_bytes)), namespace_, none, registry_and_is.is, true, .html_custom_element_registry(registry_and_is.registry))

## Ported from Document.cpp:2456 Web::DOM::Document::create_element_ns.
# https://dom.spec.whatwg.org/#dom-document-createelementns
# https://dom.spec.whatwg.org/#internal-createelementns-steps
pub func dom_document_create_element_ns(this: DomDocument*, namespace_: ak.FlyString?, qualified_name: ak.String, options: StringOrDomElementCreationOptions) -> DomElement*!:
    # 1. Let (namespace, prefix, localName) be the result of validating and extracting namespace and qualifiedName
    #    given "element".
    let extracted_qualified_name = try dom_validate_and_extract(dom_document_realm(this), namespace_, ak.fly_string_from_string(qualified_name), DomValidationContext.element)

    # 2. Let registry and is be the result of flattening element creation options given options and this.
    let registry_and_is = try dom_document_flatten_element_creation_options(this, options)

    # 3. Return the result of creating an element given document, localName, namespace, prefix, is, true, and registry.
    return try dom_create_element(this, dom_qualified_name_local_name(&extracted_qualified_name), dom_qualified_name_namespace(&extracted_qualified_name), dom_qualified_name_prefix(&extracted_qualified_name), registry_and_is.is, true, .html_custom_element_registry(registry_and_is.registry))

