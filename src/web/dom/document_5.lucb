## Ported from Document.cpp:2372 Web::DOM::Document::all.
# https://html.spec.whatwg.org/multipage/dom.html#dom-document-all
pub func dom_document_all(this: DomDocument*) -> HtmlAllCollection*:
    if this.m_all == none:
        # The all attribute must return an HTMLAllCollection rooted at the Document node, whose filter matches all elements.
        this.m_all = html_html_all_collection_create(this.dom_parent_node(), HtmlHtmlAllCollectionScope.descendants, ak.Function1[DomElement*, bool](call = dom_document_all_filter, context = none))
    return this.m_all else trap("unreachable: set above")

