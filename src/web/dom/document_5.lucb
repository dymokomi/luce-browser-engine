## Ported from Document.cpp:2480 Web::DOM::Document::create_cdata_section.
# https://dom.spec.whatwg.org/#dom-document-createcdatasection
pub func dom_document_create_cdata_section(this: DomDocument*, data: ak.Utf16String) -> DomCdataSection*!:
    # 1. If this is an HTML document, then throw a "NotSupportedError" DOMException.
    if dom_document_is_html_document(this):
        return try dom_document_throw(idl_not_supported_error_create(dom_document_realm(this), ak.utf16_string_from_str("This operation is not supported for HTML documents")))

    # 2. If data contains the string "]]>", then throw an "InvalidCharacterError" DOMException.
    if ak.utf16_string_base_contains_utf16_view(&data.utf16_string_base, ak.utf16_view_from_ascii(b"]]>")):
        return try dom_document_throw(idl_invalid_character_error_create(dom_document_realm(this), ak.utf16_string_from_str("String may not contain ']]>'")))

    # 3. Return a new CDATASection node with its data set to data and node document set to this.
    return realm_create_dom_cdata_section(dom_document_realm(this), this, data)

## Ported from Document.cpp:2494 Web::DOM::Document::create_comment.
pub func dom_document_create_comment(this: DomDocument*, data: ak.Utf16String) -> DomComment*:
    return realm_create_dom_comment(dom_document_realm(this), this, data)

## Ported from Document.cpp:2500 Web::DOM::Document::create_processing_instruction.
# https://dom.spec.whatwg.org/#dom-document-createprocessinginstruction
pub func dom_document_create_processing_instruction(this: DomDocument*, target: ak.String, data: ak.Utf16String) -> DomProcessingInstruction*!:
    # 1. If target does not match the Name production, then throw an "InvalidCharacterError" DOMException.
    if not dom_document_is_valid_name(target):
        return try dom_document_throw(idl_invalid_character_error_create(dom_document_realm(this), ak.utf16_string_from_str("Invalid character in target name.")))

    # 2. If data contains the string "?>", then throw an "InvalidCharacterError" DOMException.
    if ak.utf16_string_base_contains_utf16_view(&data.utf16_string_base, ak.utf16_view_from_ascii(b"?>")):
        return try dom_document_throw(idl_invalid_character_error_create(dom_document_realm(this), ak.utf16_string_from_str("String may not contain '?>'")))

    # 3. Return a new ProcessingInstruction node, with target set to target, data set to data, and node document set to this.
    return realm_create_dom_processing_instruction(dom_document_realm(this), this, data, target)

