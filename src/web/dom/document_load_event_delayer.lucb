#==============================================================================================
#
#   document_load_event_delayer - DOM::DocumentLoadEventDelayer: an RAII hold on a document's
#                                 load event
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/DocumentLoadEventDelayer.cpp (lines 1-38). The C++ class is a
#       move-only value whose destructor releases the hold. The port has no destructors
#       (DESIGN.md §3.3), so the owner calls dom_document_load_event_delayer_destruct where C++
#       destroys the value (reset of an Optional, end of a scope), and the move constructor and
#       move assignment are explicit functions too.
#
#==============================================================================================

## Ported from DocumentLoadEventDelayer.cpp:12 Web::DOM::DocumentLoadEventDelayer::DocumentLoadEventDelayer.
pub func dom_document_load_event_delayer_construct(this: DomDocumentLoadEventDelayer*, document: DomDocument*):
    gc.weak_construct[DomDocument](&this.m_document, document)
    let delayed = gc.weak_ptr(&this.m_document) else trap("VERIFY: document")
    dom_document_increment_number_of_things_delaying_the_load_event(delayed)

## Ported from DocumentLoadEventDelayer.cpp:18 Web::DOM::DocumentLoadEventDelayer::DocumentLoadEventDelayer
## (the move constructor).
pub func dom_document_load_event_delayer_construct_move(this: DomDocumentLoadEventDelayer*, delayer: DomDocumentLoadEventDelayer*):
    this.m_document = delayer.m_document
    gc.weak_assign[DomDocument](&delayer.m_document, none)

## Ported from DocumentLoadEventDelayer.cpp:24 Web::DOM::DocumentLoadEventDelayer::operator= (the move
## assignment; as in C++, it does not release a hold this one had).
pub func dom_document_load_event_delayer_move_assign(this: DomDocumentLoadEventDelayer*, delayer: DomDocumentLoadEventDelayer*) -> DomDocumentLoadEventDelayer*:
    this.m_document = delayer.m_document
    gc.weak_assign[DomDocument](&delayer.m_document, none)
    return this

## Ported from DocumentLoadEventDelayer.cpp:31 Web::DOM::DocumentLoadEventDelayer::~DocumentLoadEventDelayer.
pub func dom_document_load_event_delayer_destruct(this: DomDocumentLoadEventDelayer*):
    if let document = gc.weak_ptr(&this.m_document):
        dom_document_decrement_number_of_things_delaying_the_load_event(document)
