        .html_video_element_set_video_track: return ak.sv("HTMLVideoElementSetVideoTrack")
        .keyframe_effect: return ak.sv("KeyframeEffect")
        .layout_tree_update: return ak.sv("LayoutTreeUpdate")
        .navigable_set_viewport_size: return ak.sv("NavigableSetViewportSize")
        .svg_graphics_element_transform_change: return ak.sv("SVGGraphicsElementTransformChange")
