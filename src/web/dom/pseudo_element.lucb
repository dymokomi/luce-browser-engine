#==============================================================================================
#
#   pseudo_element - DOM::PseudoElement and PseudoElementTreeNode: the style and layout state of
#                    an element's pseudo-element
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/PseudoElement.cpp (lines 1-47) and the inline functions of
#       PseudoElement.h. Cells are made with heap_allocate_dom_pseudo_element(_tree_node)
#       (types_pseudo_element.lucb).
#
#==============================================================================================

## Ported from PseudoElement.cpp:17 Web::DOM::PseudoElement::visit_edges (override).
pub func dom_pseudo_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomPseudoElement*)base
    # Base::visit_edges(visitor): JS::Cell's visits nothing.
    gc.cell_visitor_visit_t(visitor, this.m_cascaded_properties)
    gc.cell_visitor_visit_t(visitor, this.m_computed_properties)
    gc.cell_visitor_visit_t(visitor, this.m_layout_node)
    if let counters_set = this.m_counters_set:
        css_counters_set_visit_edges(counters_set, visitor)

## Ported from PseudoElement.cpp:28 Web::DOM::PseudoElement::counters_set.
pub func dom_pseudo_element_counters_set(this: DomPseudoElement*) -> const CssCountersSet*?:
    let counters_set = this.m_counters_set else return none
    return counters_set

## Ported from PseudoElement.cpp:35 Web::DOM::PseudoElement::ensure_counters_set.
pub func dom_pseudo_element_ensure_counters_set(this: DomPseudoElement*) -> CssCountersSet*:
    if this.m_counters_set == none:
        this.m_counters_set = new CssCountersSet else trap("out of memory")
    return this.m_counters_set else trap("unreachable")

## Ported from PseudoElement.cpp:42 Web::DOM::PseudoElement::set_counters_set.
pub func dom_pseudo_element_set_counters_set(this: DomPseudoElement*, counters_set: CssCountersSet*?):
    this.m_counters_set = counters_set

# mark: PseudoElement.h =========================================================================

