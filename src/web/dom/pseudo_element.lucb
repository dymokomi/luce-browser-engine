## Ported from PseudoElement.h:64 Web::DOM::PseudoElementTreeNode::visit_edges (override).
pub func dom_pseudo_element_tree_node_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomPseudoElementTreeNode*)base
    dom_pseudo_element_visit_edges_impl(base, visitor)
    tree_node_visit_edges(this, visitor)
