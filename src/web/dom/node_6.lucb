# mark: Mutation records ========================================================================

## Ported from Node.cpp:2719 Web::DOM::Node::queue_mutation_record.
# https://dom.spec.whatwg.org/#queue-a-mutation-record
pub func dom_node_queue_mutation_record(this: DomNode*, type_: ak.FlyString, attribute_name: ak.FlyString?, attribute_namespace: ak.FlyString?, old_value: ak.String?, added_nodes: ak.Vector[DomNode*?], removed_nodes: ak.Vector[DomNode*?], previous_sibling: DomNode*?, next_sibling: DomNode*?):
    let document = dom_node_document(this)
    let page = dom_document_page(document)

    # NOTE: We defer garbage collection until the end of the scope, since we can't safely use MutationObserver* as a hashmap key otherwise.
    # FIXME: This is a total hack.
    let heap = gc.cell_heap(this.cell())
    gc.heap_defer_gc(heap)
    defer gc.heap_undefer_gc(heap)

    # 1. Let interestedObservers be an empty map.
    # mutationObserver -> mappedOldValue
    var interested_observers: ak.OrderedHashMap[DomMutationObserver*, ak.String?, ak.PtrTraits[DomMutationObserver]]

    # 2. Let nodes be the inclusive ancestors of target.
    # 3. For each node of nodes, and then for each registered of node’s registered observer list:
    var inclusive_ancestor: DomNode*? = this
    while let node = inclusive_ancestor:
        inclusive_ancestor = tree_node_parent(node)
        let registered_observer_list = node.m_registered_observer_list else continue
        for registered_observer in ak.vector_span(registered_observer_list):
            # 1. Let options be registered’s options.
            let options = dom_registered_observer_options(registered_observer)

            # 2. If none of the following are true
            #      - node is not target and options["subtree"] is false
            #      - type is "attributes" and options["attributes"] either does not exist or is false
            #      - type is "attributes", options["attributeFilter"] exists, and options["attributeFilter"] does not contain name or namespace is non-null
            #      - type is "characterData" and options["characterData"] either does not exist or is false
            #      - type is "childList" and options["childList"] is false
            #    then:
            let type_is_attributes = ak.fly_string_eq_fly_string(&type_, &dom_mutation_type_attributes)
            let type_is_character_data = ak.fly_string_eq_fly_string(&type_, &dom_mutation_type_character_data)
            let type_is_child_list = ak.fly_string_eq_fly_string(&type_, &dom_mutation_type_child_list)
            var attribute_filter_excludes = false
            if type_is_attributes:
                if let attribute_filter = options.attribute_filter:
                    let name = attribute_name else ak.fly_string_from_string(ak.string_new())
                    attribute_filter_excludes = attribute_namespace != none or not ak.vector_contains_slow[ak.String, ak.StringTraits](&attribute_filter, ak.fly_string_to_string_const(&name))
            if not (node != this and not options.subtree) and not (type_is_attributes and not (options.attributes else false)) and not attribute_filter_excludes and not (type_is_character_data and not (options.character_data else false)) and not (type_is_child_list and not options.child_list):
                # 1. Let mo be registered’s observer.
                let mutation_observer = dom_registered_observer_observer(registered_observer)

                # 2. If interestedObservers[mo] does not exist, then set interestedObservers[mo] to null.
                if not ak.ordered_hash_map_contains_k(&interested_observers, mutation_observer):
                    _ = ak.ordered_hash_map_set(&interested_observers, mutation_observer, none)

                # 3. If either type is "attributes" and options["attributeOldValue"] is true, or type is "characterData" and options["characterDataOldValue"] is true, then set interestedObservers[mo] to oldValue.
                if (type_is_attributes and (options.attribute_old_value else false)) or (type_is_character_data and (options.character_data_old_value else false)):
                    _ = ak.ordered_hash_map_set(&interested_observers, mutation_observer, old_value)

    # OPTIMIZATION: If there are no interested observers, bail without doing any more work.
    if ak.ordered_hash_map_is_empty(&interested_observers) and not page_listen_for_dom_mutations(page):
        return

    # FIXME: The MutationRecord constructor should take an Optional<FlyString> attribute name and namespace
    var string_attribute_name: ak.String? = none
    if let name = attribute_name:
        string_attribute_name = ak.fly_string_to_string_const(&name)
    var string_attribute_namespace: ak.String? = none
    if let namespace_ = attribute_namespace:
        string_attribute_namespace = ak.fly_string_to_string_const(&namespace_)

    let realm = bind_platform_object_realm(this.bind_platform_object())
    let added_nodes_list = dom_static_node_list_create(realm, added_nodes)
    let removed_nodes_list = dom_static_node_list_create(realm, removed_nodes)

    # 4. For each observer → mappedOldValue of interestedObservers:
    for entry in ak.ordered_hash_map_begin(&interested_observers):
        let observer = entry.key
        let mapped_old_value = entry.value
        # 1. Let record be a new MutationRecord object with its type set to type, target set to target, attributeName set to name, attributeNamespace set to namespace, oldValue set to mappedOldValue,
        #    addedNodes set to addedNodes, removedNodes set to removedNodes, previousSibling set to previousSibling, and nextSibling set to nextSibling.
        let record = dom_mutation_record_create(realm, type_, this, added_nodes_list, removed_nodes_list, previous_sibling, next_sibling, string_attribute_name, string_attribute_namespace, mapped_old_value)

        # 2. Enqueue record to observer’s record queue.
        dom_mutation_observer_enqueue_record(observer, record)

        # 3. Append observer to the surrounding agent’s pending mutation observers.
        # (JS::Object& from a platform object: JS::Object is opaque until phase 3, DESIGN.md §3.6.)
        let agent = html_relevant_similar_origin_window_agent((JsObject*)this)
        ak.vector_append_t(&agent.pending_mutation_observers, observer)

    # 5. Queue a mutation observer microtask.
    bind_queue_mutation_observer_microtask()

    # AD-HOC: Notify the UI if it is interested in DOM mutations (i.e. for DevTools).
    if page_listen_for_dom_mutations(page):
        page_client_page_did_mutate_dom(page_client(page), type_, this, added_nodes_list, removed_nodes_list, previous_sibling, next_sibling, string_attribute_name)

## Ported from Node.cpp:2804 Web::DOM::Node::queue_tree_mutation_record.
# https://dom.spec.whatwg.org/#queue-a-tree-mutation-record
pub func dom_node_queue_tree_mutation_record(this: DomNode*, added_nodes: ak.Vector[DomNode*?], removed_nodes: ak.Vector[DomNode*?], previous_sibling: DomNode*?, next_sibling: DomNode*?):
    # 1. Assert: either addedNodes or removedNodes is not empty.
    assert(ak.vector_size(&added_nodes) > 0 or ak.vector_size(&removed_nodes) > 0)

    # 2. Queue a mutation record of "childList" for target with null, null, null, addedNodes, removedNodes, previousSibling, and nextSibling.
    dom_node_queue_mutation_record(this, dom_mutation_type_child_list, none, none, none, added_nodes, removed_nodes, previous_sibling, next_sibling)

# mark: Child-list primitives ===================================================================

## Ported from Node.cpp:2813 Web::DOM::Node::append_child_impl.
pub func dom_node_append_child_impl(this: DomNode*, node: DomNode*):
    assert(tree_node_parent(node) == none)

    if not dom_node_is_child_allowed(this, node):
        return

    tree_node_append_child(this, node)

