#==============================================================================================
#
#   node_6 - DOM::Node: namespaces, root node, length, layout links, mutation records
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/Node.cpp (lines 2350-2833): the in-scope namespace prefixes, locate
#       a namespace, lookupNamespaceURI()/lookupPrefix()/isDefaultNamespace(), inertness,
#       getRootNode(), the debug description, a node's length, the layout-node and paintable
#       accessors, queueing (tree) mutation records and the TreeNode child-list primitives
#       Node wraps.
#
#==============================================================================================

# mark: Helpers =================================================================================

## `Optional<String> == "literal"`: present and equal to the text.
func dom_node_optional_string_is(a: ak.String?, text: str) -> bool:
    let a_value = a else return false
    return ak.string_eq_string_view(&a_value, ak.sv(text))

## `Optional<String> == Optional<String>`: both empty, or both present and equal.
func dom_node_optional_strings_equal(a: ak.String?, b: ak.String?) -> bool:
    let a_value = a else return b == none
    let b_value = b else return false
    return ak.string_equals(&a_value, &b_value)

## `Optional<FlyString> == Optional<String>`: both empty, or both present and equal.
func dom_node_optional_fly_string_equals_optional_string(a: ak.FlyString?, b: ak.String?) -> bool:
    let a_value = a else return b == none
    let b_value = b else return false
    return ak.fly_string_eq_string(&a_value, &b_value)

## `Optional<FlyString> == FlyString`: present and equal.
func dom_node_optional_fly_string_is(a: ak.FlyString?, b: ak.FlyString) -> bool:
    let a_value = a else return false
    return ak.fly_string_eq_fly_string(&a_value, &b)

## The captures of Node::get_in_scope_prefixes's add_prefix lambda.
struct DomNodeGetInScopePrefixesAddPrefix:
    var this: DomNode*
    var prefixes: ak.Vector[ak.FlyString]
    var seen_prefixes: ak.HashTable[ak.FlyString, ak.FlyStringTraits]

## Node::get_in_scope_prefixes's add_prefix lambda.
func dom_node_get_in_scope_prefixes_add_prefix(captures: DomNodeGetInScopePrefixesAddPrefix*, prefix: ak.FlyString):
    if not ak.hash_table_contains_t(&captures.seen_prefixes, prefix):
        ak.vector_append_t(&captures.prefixes, prefix)
        _ = ak.hash_table_set(&captures.seen_prefixes, prefix)
        assert(dom_node_lookup_namespace_uri(captures.this, ak.fly_string_to_string_const(&prefix)) != none)

# mark: Namespaces ==============================================================================

## Ported from Node.cpp:2351 Web::DOM::Node::get_in_scope_prefixes.
pub func dom_node_get_in_scope_prefixes(this: DomNode*) -> ak.Vector[ak.FlyString]:
    # https://html.spec.whatwg.org/multipage/xhtml.html#parsing-xhtml-fragments
    # "A namespace prefix is in scope if the DOM lookupNamespaceURI() method on the element would return a non-null value for that prefix."

    var add_prefix = DomNodeGetInScopePrefixesAddPrefix(this = this)

    dom_node_get_in_scope_prefixes_add_prefix(&add_prefix, ak.fly_string_from_str("xml"))
    dom_node_get_in_scope_prefixes_add_prefix(&add_prefix, ak.fly_string_from_str("xmlns"))

    var current: DomElement*? = none

    if is_dom_element(this):
        current = (DomElement*)this
    elif is_dom_document(this):
        current = dom_document_document_element((DomDocument*)this)
    elif is_dom_attr(this):
        current = dom_attr_owner_element((DomAttr*)this)
    else:
        current = dom_node_parent_element(this)

    while let current_element = current:
        if dom_element_namespace_uri(current_element) != none:
            let prefix = dom_element_prefix(current_element) else ak.fly_string_from_str("")
            dom_node_get_in_scope_prefixes_add_prefix(&add_prefix, prefix)

        if let attributes = dom_element_attributes(current_element):
            for i in 0..<dom_named_node_map_length(attributes):
                let attr = dom_named_node_map_item(attributes, (u32)i) else trap("NamedNodeMap::item out of range")
                if not dom_node_optional_fly_string_is(dom_attr_namespace_uri(attr), namespace_xmlns):
                    continue

                var declared_prefix: ak.FlyString? = none

                let attr_local_name = dom_attr_local_name(attr)
                if dom_attr_prefix(attr) == none and ak.fly_string_eq_string_view(&attr_local_name, ak.sv("xmlns")):
                    declared_prefix = ak.fly_string_from_str("")
                elif dom_node_optional_fly_string_is(dom_attr_prefix(attr), ak.fly_string_from_str("xmlns")):
                    declared_prefix = attr_local_name
                else:
                    continue

                let prefix = declared_prefix else trap("unreachable")
                let value = dom_attr_value(attr)
                if not ak.string_is_empty(&value):
                    dom_node_get_in_scope_prefixes_add_prefix(&add_prefix, prefix)
                _ = ak.hash_table_set(&add_prefix.seen_prefixes, prefix)  # Mark as seen even if the value is empty

        current = dom_node_parent_element(current_element.dom_node())

    return add_prefix.prefixes

## Ported from Node.cpp:2417 Web::DOM::Node::locate_a_namespace.
# https://dom.spec.whatwg.org/#locate-a-namespace
pub func dom_node_locate_a_namespace(this: DomNode*, prefix: ak.String?) -> ak.String?:
    # To locate a namespace for a node using prefix, switch on the interface node implements:

    # Element
    if is_dom_element(this):
        # 1. If prefix is "xml", then return the XML namespace.
        if dom_node_optional_string_is(prefix, "xml"):
            return ak.fly_string_to_string_const(&namespace_xml)

        # 2. If prefix is "xmlns", then return the XMLNS namespace.
        if dom_node_optional_string_is(prefix, "xmlns"):
            return ak.fly_string_to_string_const(&namespace_xmlns)

        # 3. If its namespace is non-null and its namespace prefix is prefix, then return namespace.
        let element = as_dom_element(this)
        if let namespace_uri = dom_element_namespace_uri(element):
            if dom_node_optional_fly_string_equals_optional_string(dom_element_prefix(element), prefix):
                return ak.fly_string_to_string_const(&namespace_uri)

        # 4. If it has an attribute whose namespace is the XMLNS namespace, namespace prefix is "xmlns", and local name is prefix,
        #    or if prefix is null and it has an attribute whose namespace is the XMLNS namespace, namespace prefix is null,
        #    and local name is "xmlns", then return its value if it is not the empty string, and null otherwise.
        if let attributes = dom_element_attributes(element):
            for i in 0..<dom_named_node_map_length(attributes):
                let attr = dom_named_node_map_item(attributes, (u32)i) else trap("NamedNodeMap::item out of range")
                if dom_node_optional_fly_string_is(dom_attr_namespace_uri(attr), namespace_xmlns):
                    let attr_local_name = dom_attr_local_name(attr)
                    if (dom_node_optional_fly_string_is(dom_attr_prefix(attr), ak.fly_string_from_str("xmlns")) and dom_node_optional_fly_string_equals_optional_string(attr_local_name, prefix)) or (prefix == none and dom_attr_prefix(attr) == none and ak.fly_string_eq_string_view(&attr_local_name, ak.sv("xmlns"))):
                        let value = dom_attr_value(attr)
                        if not ak.string_is_empty(&value):
                            return value

                        return none

        # 5. If its parent element is null, then return null.
        # 6. Return the result of running locate a namespace on its parent element using prefix.
        let parent_element = dom_node_parent_element(element.dom_node()) else return none
        return dom_node_locate_a_namespace(parent_element.dom_node(), prefix)

    # Document
    if is_dom_document(this):
        # 1. If its document element is null, then return null.
        let document_element = dom_document_document_element(as_dom_document(this)) else return none

        # 2. Return the result of running locate a namespace on its document element using prefix.
        return dom_node_locate_a_namespace(document_element.dom_node(), prefix)

    # DocumentType
    # DocumentFragment
    if is_dom_document_type(this) or is_dom_document_fragment(this):
        # Return null.
        return none

    # Attr
    if is_dom_attr(this):
        # 1. If its element is null, then return null.
        let element = dom_attr_owner_element(as_dom_attr(this)) else return none

        # 2. Return the result of running locate a namespace on its element using prefix.
        return dom_node_locate_a_namespace(element.dom_node(), prefix)

    # Otherwise
    # 1. If its parent element is null, then return null.
    let parent_element = dom_node_parent_element(this) else return none

    # 2. Return the result of running locate a namespace on its parent element using prefix.
    return dom_node_locate_a_namespace(parent_element.dom_node(), prefix)

## Ported from Node.cpp:2503 Web::DOM::Node::lookup_namespace_uri.
# https://dom.spec.whatwg.org/#dom-node-lookupnamespaceuri
pub func dom_node_lookup_namespace_uri(this: DomNode*, prefix: ak.String?) -> ak.String?:
    # 1. If prefix is the empty string, then set it to null.
    var maybe_prefix = prefix
    if let value = maybe_prefix:
        if ak.string_is_empty(&value):
            maybe_prefix = none

    # 2. Return the result of running locate a namespace for this using prefix.
    return dom_node_locate_a_namespace(this, maybe_prefix)

## Ported from Node.cpp:2514 Web::DOM::Node::lookup_prefix.
# https://dom.spec.whatwg.org/#dom-node-lookupprefix
pub func dom_node_lookup_prefix(this: DomNode*, namespace_: ak.String?) -> ak.String?:
    # 1. If namespace is null or the empty string, then return null.
    let namespace_value = namespace_ else return none
    if ak.string_is_empty(&namespace_value):
        return none

    # 2. Switch on the interface this implements:

    # Element
    if is_dom_element(this):
        # Return the result of locating a namespace prefix for it using namespace.
        let element = as_dom_element(this)
        return dom_element_locate_a_namespace_prefix(element, namespace_)

    # Document
    if is_dom_document(this):
        # Return the result of locating a namespace prefix for its document element, if its document element is non-null; otherwise null.
        let document_element = dom_document_document_element(as_dom_document(this)) else return none

        return dom_element_locate_a_namespace_prefix(document_element, namespace_)

    # DocumentType
    # DocumentFragment
    if is_dom_document_type(this) or is_dom_document_fragment(this):
        # Return null
        return none

    # Attr
    if is_dom_attr(this):
        # Return the result of locating a namespace prefix for its element, if its element is non-null; otherwise null.
        let element = dom_attr_owner_element(as_dom_attr(this)) else return none

        return dom_element_locate_a_namespace_prefix(element, namespace_)

    # Otherwise
    # Return the result of locating a namespace prefix for its parent element, if its parent element is non-null; otherwise null.
    let parent_element = dom_node_parent_element(this) else return none

    return dom_element_locate_a_namespace_prefix(parent_element, namespace_)

## Ported from Node.cpp:2565 Web::DOM::Node::is_default_namespace.
# https://dom.spec.whatwg.org/#dom-node-isdefaultnamespace
pub func dom_node_is_default_namespace(this: DomNode*, namespace_: ak.String?) -> bool:
    # 1. If namespace is the empty string, then set it to null.
    var maybe_namespace = namespace_
    if let value = maybe_namespace:
        if ak.string_is_empty(&value):
            maybe_namespace = none

    # 2. Let defaultNamespace be the result of running locate a namespace for this using null.
    let default_namespace = dom_node_locate_a_namespace(this, none)

    # 3. Return true if defaultNamespace is the same as namespace; otherwise false.
    return dom_node_optional_strings_equal(default_namespace, maybe_namespace)

# mark: Inertness, root node, description and length ============================================

## Ported from Node.cpp:2578 Web::DOM::Node::is_inert.
pub func dom_node_is_inert(this: DomNode*) -> bool:
    if let html_element = as_if_html_element(this):
        return html_element_is_inert(html_element)

    if let enclosing_html_element = dom_node_enclosing_html_element(this):
        return html_element_is_inert(enclosing_html_element)

    return false

## Ported from Node.cpp:2590 Web::DOM::Node::in_a_document_tree.
# https://dom.spec.whatwg.org/#in-a-document-tree
pub func dom_node_in_a_document_tree(this: DomNode*) -> bool:
    # An element is in a document tree if its root is a document.
    return dom_node_is_document(tree_node_root(this))

## Ported from Node.cpp:2597 Web::DOM::Node::get_root_node.
# https://dom.spec.whatwg.org/#dom-node-getrootnode
pub func dom_node_get_root_node(this: DomNode*, options: DomGetRootNodeOptions) -> DomNode*:
    # The getRootNode(options) method steps are to return this’s shadow-including root if options["composed"] is true;
    if options.composed:
        return dom_node_shadow_including_root(this)

    # otherwise this’s root.
    return tree_node_root(this)

## Ported from Node.cpp:2607 Web::DOM::Node::debug_description.
pub func dom_node_debug_description(this: DomNode*) -> ak.String:
    var builder = ak.string_builder_new()
    let name = dom_node_node_name(this)
    let lowercase_name = ak.fly_string_to_ascii_lowercase(&name)
    ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&lowercase_name))
    if dom_node_is_element(this):
        let element = (DomElement*)this
        if let id = dom_element_id(element):
            ak.string_builder_append(&builder, "#")
            ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&id))
        var class_names = dom_element_class_names(element)
        for class_name in ak.vector_span(&class_names):
            ak.string_builder_append(&builder, ".")
            ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&class_name))
    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from Node.cpp:2622 Web::DOM::Node::length.
# https://dom.spec.whatwg.org/#concept-node-length
pub func dom_node_length(this: DomNode*) -> usize:
    # 1. If node is a DocumentType or Attr node, then return 0.
    if dom_node_is_document_type(this) or dom_node_is_attribute(this):
        return 0

    # 2. If node is a CharacterData node, then return node’s data’s length.
    if dom_node_is_character_data(this):
        return dom_character_data_length_in_utf16_code_units(as_dom_character_data(this))

    # 3. Return the number of node’s children.
    return tree_node_child_count(this)

