## Ported from Node.cpp:2650 Web::DOM::Node::set_paintable.
pub func dom_node_set_paintable(this: DomNode*, paintable: PaintPaintable*?):
    this.m_paintable = paintable

## Ported from Node.cpp:2655 Web::DOM::Node::clear_paintable.
pub func dom_node_clear_paintable(this: DomNode*):
    this.m_paintable = none

## Ported from Node.cpp:2660 Web::DOM::Node::set_needs_repaint.
pub func dom_node_set_needs_repaint(this: DomNode*, should_invalidate_display_list: InvalidateDisplayList = InvalidateDisplayList.yes):
    if let layout_node = dom_node_unsafe_layout_node(this):
        for paintable in ak.intrusive_list_begin(layout_node_paintables(layout_node)):
            paint_paintable_set_needs_repaint(paintable, should_invalidate_display_list)

## Ported from Node.cpp:2668 Web::DOM::Node::set_needs_layout_update.
pub func dom_node_set_needs_layout_update(this: DomNode*, reason: DomSetNeedsLayoutReason):
    if let node = dom_node_unsafe_layout_node(this):
        layout_node_set_needs_layout_update(node, reason)
        dom_document_set_needs_repaint_t[DomNode](dom_node_document(this), InvalidateDisplayList.no)

