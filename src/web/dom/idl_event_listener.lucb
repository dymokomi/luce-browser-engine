#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/DOM/IDLEventListener.cpp:15 Web::DOM::IDLEventListener::create.
pub func dom_idl_event_listener_create(realm: Realm*, callback: IdlCallbackType*) -> DomIdlEventListener*:
    return realm_create_dom_idl_event_listener(realm, realm, callback)

## Ported from Libraries/LibWeb/DOM/IDLEventListener.cpp:20 Web::DOM::IDLEventListener::IDLEventListener.
## JS::Object(ConstructWithPrototypeTag::Tag, realm.intrinsics().object_prototype()): the
## prototype is the JS object's (phase 3).
pub func dom_idl_event_listener_construct(this: DomIdlEventListener*, realm: Realm*, callback: IdlCallbackType*):
    this.m_callback = callback

## Ported from Libraries/LibWeb/DOM/IDLEventListener.h:38 Web::DOM::IDLEventListener::callback.
pub func dom_idl_event_listener_callback(this: DomIdlEventListener*) -> IdlCallbackType*:
    return this.m_callback

## Ported from Libraries/LibWeb/DOM/IDLEventListener.cpp:26 Web::DOM::IDLEventListener::visit_edges (override).
pub func dom_idl_event_listener_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (DomIdlEventListener*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_callback)
