#==============================================================================================
#
#   xml_document - DOM::XMLDocument
#
#   DESCRIPTION:
#       Port of LibWeb/DOM/XMLDocument.cpp (lines 1-30). C++'s `url = URL::about_blank()`
#       default argument is not a constant, so callers pass web_url.about_blank().
#
#==============================================================================================

## Ported from XMLDocument.cpp:14 Web::DOM::XMLDocument::create.
pub func dom_xml_document_create(realm: Realm*, url: web_url.Url) -> DomXmlDocument*:
    return realm_create_dom_xml_document(realm, realm, url)

## Ported from XMLDocument.cpp:19 Web::DOM::XMLDocument::XMLDocument.
pub func dom_xml_document_construct(this: DomXmlDocument*, realm: Realm*, url: web_url.Url):
    dom_document_construct(this.dom_document(), realm, url)

## Ported from XMLDocument.cpp:24 Web::DOM::XMLDocument::initialize (override).
pub func dom_xml_document_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.xml_document)
    dom_document_initialize_impl(base, realm)
