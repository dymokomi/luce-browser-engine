# mark: Resource ================================================================================

## Core::Resource (Libraries/LibCore/Resource.h:22): a file or a directory under a file:// or
## resource:// URI, with its bytes. RefCounted in C++, managed memory here.
pub struct CoreResource:
    ## Relative to scheme root. File: abspath, Resource: resource root
    pub var m_path: ak.String
    pub var m_scheme: CoreResourceScheme
    ## Which alternative of m_data's Variant the resource holds.
    pub var m_data: CoreResourceData
    ## The bytes of a mapped file or byte buffer (m_data's payload, kept beside the tag so that
    ## data() can lend them).
    pub var m_bytes: ak.ByteBuffer
    pub var m_modified_time: i64

## Core::Resource::Scheme (Libraries/LibCore/Resource.h:57).
pub enum CoreResourceScheme as i32:
    file = 0
    resource = 1

## The alternatives of Variant<DirectoryTag, NonnullOwnPtr<Core::MappedFile>, ByteBuffer>
## (Libraries/LibCore/Resource.h:66). A mapped file is the file's bytes read into a ByteBuffer
## (CoreResource.m_bytes): the port maps no files.
pub enum CoreResourceData as u8:
    directory_tag = 0
    mapped_file = 1
    byte_buffer = 2

# mark: ResourceImplementation ==================================================================

## Core::ResourceImplementation (Libraries/LibCore/ResourceImplementation.h:16) as its one implementation,
## Core::ResourceImplementationFile (ResourceImplementationFile.h:13): resource:// URIs name files under a
## base directory. Lives in the C heap for the process (DESIGN.md §3.3 rule 7).
pub struct CoreResourceImplementation:
    pub var m_base_directory: ak.String

## Core::s_the (Libraries/LibCore/ResourceImplementation.cpp:14).
pub var core_resource_implementation_s_the: CoreResourceImplementation*?
