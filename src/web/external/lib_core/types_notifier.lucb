#==============================================================================================
#
#   types_notifier - declarations of Libraries/LibCore/Notifier.h
#
#   DESCRIPTION:
#       Core::NotificationType and Core::Notifier (Libraries/LibCore/Notifier.h, Ladybird
#       47c82b38d0), written for region p2/net (the skeleton generator did not declare them:
#       no LibWeb code used a Notifier before the in-process RequestClient watched sockets).
#
#==============================================================================================

## Core::NotificationType (Libraries/LibCore/Notifier.h:17): flags, combined with `|`.
pub enum CoreNotificationType as u8:
    none_ = 0
    read = 1
    write = 2
    hang_up = 4
    error_ = 8

## Core::Notifier (Libraries/LibCore/Notifier.h:28): `on_activation` runs on the event loop when
## the descriptor is ready for what `m_type` names, while the notifier is enabled. The owner
## thread of C++ (one loop per thread) is not kept: the port has one event loop per process.
pub struct CoreNotifier:
    pub var on_activation: ak.Function0[unit]
    pub var m_fd: i32  # C++ default: { -1 }
    pub var m_type: CoreNotificationType  # C++ default: { Type::None }
    pub var m_is_enabled: bool  # C++ default: { false }
