#==============================================================================================
#
#   mime_data - Core::guess_mime_type_based_on_filename: a file's MIME type from its name
#
#   DESCRIPTION:
#       Port of guess_mime_type_based_on_filename (Libraries/LibCore/MimeData.cpp, lines
#       151-161) and the names and common extensions of s_registered_mime_type (lines 50-149),
#       the LibCore seam ResourceLoader's file and resource loads guess their Content-Type
#       with. The table is one row per extension, in the C++ order of types and of their
#       extensions (the first row whose extension ends the path wins, as the C++ loops find
#       it); the descriptions and magic bytes, which only LibCore's sniffing reads, are left
#       out. text/plain's extensions are s_plaintext_suffixes (".c" ... ".shellrc").
#
#       Copyright (c) 2020, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## A common extension of a registered MIME type of MimeData.cpp.
struct CoreMimeTypeExtension:
    var name: str
    var extension: str

# See https://www.iana.org/assignments/media-types/<mime-type> for a list of registered MIME types.
# For example, https://www.iana.org/assignments/media-types/application/gzip
let core_s_registered_mime_type_extensions: CoreMimeTypeExtension[85] = [
    CoreMimeTypeExtension(name = "application/gzip", extension = ".gz"),
    CoreMimeTypeExtension(name = "application/gzip", extension = ".gzip"),
    CoreMimeTypeExtension(name = "application/javascript", extension = ".js"),
    CoreMimeTypeExtension(name = "application/javascript", extension = ".mjs"),
    CoreMimeTypeExtension(name = "application/json", extension = ".json"),
    CoreMimeTypeExtension(name = "application/pdf", extension = ".pdf"),
    CoreMimeTypeExtension(name = "application/rtf", extension = ".rtf"),
    CoreMimeTypeExtension(name = "application/tar", extension = ".tar"),
    CoreMimeTypeExtension(name = "application/vnd.iccprofile", extension = ".icc"),
    CoreMimeTypeExtension(name = "application/vnd.sqlite3", extension = ".sqlite"),
    CoreMimeTypeExtension(name = "application/wasm", extension = ".wasm"),
    CoreMimeTypeExtension(name = "application/x-7z-compressed", extension = "7z"),
    CoreMimeTypeExtension(name = "application/x-blender", extension = ".blend"),
    CoreMimeTypeExtension(name = "application/x-blender", extension = ".blended"),
    CoreMimeTypeExtension(name = "application/x-bzip2", extension = ".bz2"),
    CoreMimeTypeExtension(name = "application/x-sheets+json", extension = ".sheets"),
    CoreMimeTypeExtension(name = "application/xhtml+xml", extension = ".xhtml"),
    CoreMimeTypeExtension(name = "application/xhtml+xml", extension = ".xht"),
    CoreMimeTypeExtension(name = "application/zip", extension = ".zip"),
    CoreMimeTypeExtension(name = "audio/flac", extension = ".flac"),
    CoreMimeTypeExtension(name = "audio/midi", extension = ".mid"),
    CoreMimeTypeExtension(name = "audio/mpeg", extension = ".mp3"),
    CoreMimeTypeExtension(name = "audio/qoa", extension = ".qoa"),
    CoreMimeTypeExtension(name = "audio/wav", extension = ".wav"),
    CoreMimeTypeExtension(name = "extra/elf", extension = ".elf"),
    CoreMimeTypeExtension(name = "extra/iso-9660", extension = ".iso"),
    CoreMimeTypeExtension(name = "extra/iso-9660", extension = ".iso"),
    CoreMimeTypeExtension(name = "extra/iso-9660", extension = ".iso"),
    CoreMimeTypeExtension(name = "extra/isz", extension = ".isz"),
    CoreMimeTypeExtension(name = "extra/nes-rom", extension = ".nes"),
    CoreMimeTypeExtension(name = "extra/qcow", extension = ".qcow"),
    CoreMimeTypeExtension(name = "extra/qcow", extension = ".qcow2"),
    CoreMimeTypeExtension(name = "extra/qcow", extension = ".qcow3"),
    CoreMimeTypeExtension(name = "font/otf", extension = "otf"),
    CoreMimeTypeExtension(name = "font/ttf", extension = "ttf"),
    CoreMimeTypeExtension(name = "font/woff", extension = "woff"),
    CoreMimeTypeExtension(name = "font/woff2", extension = "woff2"),
    CoreMimeTypeExtension(name = "image/avif", extension = ".avif"),
    CoreMimeTypeExtension(name = "image/bmp", extension = ".bmp"),
    CoreMimeTypeExtension(name = "image/gif", extension = ".gif"),
    CoreMimeTypeExtension(name = "image/gif", extension = ".gif"),
    CoreMimeTypeExtension(name = "image/j2c", extension = ".j2c"),
    CoreMimeTypeExtension(name = "image/j2c", extension = ".j2k"),
    CoreMimeTypeExtension(name = "image/jp2", extension = ".jp2"),
    CoreMimeTypeExtension(name = "image/jp2", extension = ".jpf"),
    CoreMimeTypeExtension(name = "image/jp2", extension = ".jpx"),
    CoreMimeTypeExtension(name = "image/jpeg", extension = ".jpg"),
    CoreMimeTypeExtension(name = "image/jpeg", extension = ".jpeg"),
    CoreMimeTypeExtension(name = "image/jxl", extension = ".jxl"),
    CoreMimeTypeExtension(name = "image/png", extension = ".png"),
    CoreMimeTypeExtension(name = "image/svg+xml", extension = ".svg"),
    CoreMimeTypeExtension(name = "image/tiff", extension = ".tiff"),
    CoreMimeTypeExtension(name = "image/tiff", extension = ".tiff"),
    CoreMimeTypeExtension(name = "image/tinyvg", extension = ".tvg"),
    CoreMimeTypeExtension(name = "image/webp", extension = ".webp"),
    CoreMimeTypeExtension(name = "image/x-icon", extension = ".ico"),
    CoreMimeTypeExtension(name = "image/x-ilbm", extension = ".iff"),
    CoreMimeTypeExtension(name = "image/x-ilbm", extension = ".lbm"),
    CoreMimeTypeExtension(name = "image/x-jbig2", extension = ".jbig2"),
    CoreMimeTypeExtension(name = "image/x-jbig2", extension = ".jb2"),
    CoreMimeTypeExtension(name = "image/x-portable-arbitrarymap", extension = ".pam"),
    CoreMimeTypeExtension(name = "image/x-portable-bitmap", extension = ".pbm"),
    CoreMimeTypeExtension(name = "image/x-portable-graymap", extension = ".pgm"),
    CoreMimeTypeExtension(name = "image/x-portable-pixmap", extension = ".ppm"),
    CoreMimeTypeExtension(name = "image/x-targa", extension = ".tga"),
    CoreMimeTypeExtension(name = "text/css", extension = ".css"),
    CoreMimeTypeExtension(name = "text/csv", extension = ".csv"),
    CoreMimeTypeExtension(name = "text/html", extension = ".html"),
    CoreMimeTypeExtension(name = "text/html", extension = ".htm"),
    CoreMimeTypeExtension(name = "text/html", extension = "/"),
    CoreMimeTypeExtension(name = "text/xml", extension = ".xml"),
    CoreMimeTypeExtension(name = "text/markdown", extension = ".md"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".c"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".cpp"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".gml"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".h"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".hpp"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".ini"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".ipc"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".txt"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".history"),
    CoreMimeTypeExtension(name = "text/plain", extension = ".shellrc"),
    CoreMimeTypeExtension(name = "text/x-shellscript", extension = ".sh"),
    CoreMimeTypeExtension(name = "video/matroska", extension = ".mkv"),
    CoreMimeTypeExtension(name = "video/webm", extension = ".webm"),
]

## Ported from Libraries/LibCore/MimeData.cpp:151 Core::guess_mime_type_based_on_filename.
pub func core_guess_mime_type_based_on_filename(path: ak.StringView) -> ak.StringView:
    for mime_type in core_s_registered_mime_type_extensions:
        if ak.string_view_ends_with_string_view(&path, ak.sv(mime_type.extension)):
            return ak.sv(mime_type.name)

    return ak.sv("application/octet-stream")
