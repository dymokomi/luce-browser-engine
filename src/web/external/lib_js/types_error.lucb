#==============================================================================================
#
#   types_error - declarations of the JS::Error stand-in
#
#   DESCRIPTION:
#       Written by hand by region p2c (DESIGN.md §3.6, the phase-1 stand-ins): before luce-js
#       the errors LibWeb makes natively (a TypeError that errors a fetch body's stream) are
#       cells with the parts the engine reads: their realm, their kind (the native error
#       constructor whose prototype C++ gives them) and their message (Error::set_message's
#       `message` property). The classes share JS::Cell's class id and are recognized by their
#       ClassInfo, as the promise stand-in's.
#
#==============================================================================================

# mark: JsError =================================================================================

## JS::Error (Libraries/LibJS/Runtime/Error.h:20) and its native error subclasses (JS_ENUMERATE_NATIVE_ERRORS), as the
## stand-in keeps them; the class (js_error_class, js_type_error_class) is the C++ class.
pub struct JsError: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::Object, JS::Cell)
    pub var m_realm: Realm*  # the realm of the object's shape (Object::shape().realm())
    pub var m_message: ak.Utf16String?  # the own `message` property, when set_message set one

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of JS::Error.
pub let js_error_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_error_class, class_name = js_error_class_name_impl, visit_edges = js_error_visit_edges_impl))

## Class information of JS::Error: name, class id (JS::Cell's, see above), size, vtable.
pub let js_error_class: ak.ClassInfo = ak.ClassInfo(name = "Error", first_id = 1, last_id = 1, size = memory.size_of(JsError), vtable = (const void*)&js_error_vtable)

## The vtable of JS::TypeError.
pub let js_type_error_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_type_error_class, class_name = js_type_error_class_name_impl, visit_edges = js_error_visit_edges_impl))

## Class information of JS::TypeError (JS::Cell's class id).
pub let js_type_error_class: ak.ClassInfo = ak.ClassInfo(name = "TypeError", first_id = 1, last_id = 1, size = memory.size_of(JsError), vtable = (const void*)&js_type_error_vtable)

## is<JS::Error> (Object::is_error_object): an Error or one of its native error subclasses.
pub func is_js_error[P: gc.IsCell](p: P*) -> bool:
    let class_info = p.cell().vtable.class_info
    return class_info == &js_error_class or class_info == &js_type_error_class

## as_if<JS::Error>.
pub func as_if_js_error[P: gc.IsCell](p: P*) -> JsError*?:
    if is_js_error(p): return (JsError*)p
    return none

## is<JS::TypeError>.
pub func is_js_type_error[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_type_error_class
