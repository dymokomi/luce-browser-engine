## The vtable of JS::Array.
pub let js_array_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_array_class, class_name = js_array_class_name_impl, visit_edges = js_array_visit_edges_impl))

## Class information of JS::Array (JS::Cell's class id).
pub let js_array_class: ak.ClassInfo = ak.ClassInfo(name = "Array", first_id = 1, last_id = 1, size = memory.size_of(JsArray), vtable = (const void*)&js_array_vtable)

## is<JS::Array> (Object::is_array_exotic_object): the cell's ClassInfo.
pub func is_js_array[P: gc.IsCell](p: P*) -> bool:
