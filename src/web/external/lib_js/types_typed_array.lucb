# mark: JsTypedArrayBase ========================================================================

## JS::TypedArrayBase::Kind (Libraries/LibJS/Runtime/TypedArray.h:25): the kinds of typed
## arrays (JS_ENUMERATE_TYPED_ARRAYS); the stand-in makes Uint8Arrays only.
pub enum JsTypedArrayBaseKind:
    uint8_array

## JS::TypedArrayBase (Libraries/LibJS/Runtime/TypedArray.h:23): 23.2 TypedArray Objects,
## https://tc39.es/ecma262/#sec-typedarray-objects, over a fixed-length ArrayBuffer.
pub struct JsTypedArrayBase: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::Object, JS::Cell)
    pub var m_realm: Realm*  # the realm of the object's shape (Object::shape().realm())
    pub var m_viewed_array_buffer: JsArrayBuffer*  # [[ViewedArrayBuffer]]
    pub var m_byte_offset: u32  # [[ByteOffset]]
    pub var m_array_length: u32  # [[ArrayLength]] (never auto: the buffers are fixed-length)
    pub var m_byte_length: u32  # [[ByteLength]] (never auto)
    pub var m_kind: JsTypedArrayBaseKind

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of JS::Uint8Array.
pub let js_uint8_array_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_uint8_array_class, class_name = js_uint8_array_class_name_impl, visit_edges = js_typed_array_base_visit_edges_impl))

## A TypedArray With Buffer Witness Record (Libraries/LibJS/Runtime/TypedArray.h:571),
## https://tc39.es/ecma262/#sec-typedarray-with-buffer-witness-records: the cached byte length is
## none when the buffer is detached.
pub struct JsTypedArrayWithBufferWitness:
    pub var object: JsTypedArrayBase*
    pub var cached_buffer_byte_length: usize?

## Class information of JS::Uint8Array (JS::Cell's class id).
pub let js_uint8_array_class: ak.ClassInfo = ak.ClassInfo(name = "Uint8Array", first_id = 1, last_id = 1, size = memory.size_of(JsTypedArrayBase), vtable = (const void*)&js_uint8_array_vtable)

## is<JS::TypedArrayBase> (Object::fast_is<TypedArrayBase>, is_typed_array()): the cell's
## ClassInfo is a typed array's (Uint8Array's, the one kind made before phase 3).
pub func is_js_typed_array_base[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_uint8_array_class

## as_if<JS::TypedArrayBase>.
pub func as_if_js_typed_array_base[P: gc.IsCell](p: P*) -> JsTypedArrayBase*?:
    if is_js_typed_array_base(p): return (JsTypedArrayBase*)p
    return none

## is<JS::Uint8Array>: the cell's ClassInfo.
pub func is_js_uint8_array[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_uint8_array_class

## as_if<JS::Uint8Array>.
pub func as_if_js_uint8_array[P: gc.IsCell](p: P*) -> JsTypedArrayBase*?:
    if is_js_uint8_array(p): return (JsTypedArrayBase*)p
    return none
