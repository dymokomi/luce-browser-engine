## The vtable of JS::Map.
pub let js_map_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_map_class, class_name = js_map_class_name_impl, visit_edges = js_map_visit_edges_impl))

## Class information of JS::Map (JS::Cell's class id).
pub let js_map_class: ak.ClassInfo = ak.ClassInfo(name = "Map", first_id = 1, last_id = 1, size = memory.size_of(JsMap), vtable = (const void*)&js_map_vtable)

## is<JS::Map> (Object::fast_is<Map>, is_map_object()): the cell's ClassInfo.
pub func is_js_map[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_map_class

## JS::ValueTraits (Libraries/LibJS/Runtime/ValueTraits.h:17): the hash and equality of Map keys.
pub struct JsValueTraits: ak.Traits[JsValue]:
    var empty_: u8

    func hash_of(key: const JsValue*) -> u32: return js_value_traits_hash(*key)

    func equals(a: const JsValue*, b: const JsValue*) -> bool: return js_same_value(*a, *b)

