#==============================================================================================
#
#   types_ordinary_object - an ordinary JS::Object (Libraries/LibJS/Runtime/Object.h)
#
#   DESCRIPTION:
#       Written by hand (DESIGN.md §3.6, phase-1 stand-ins): an ordinary object as
#       OrdinaryObjectCreate makes one (Object::create), holding its own data properties in
#       the order they were created (LibJS's Shape keeps that order). It shares JS::Cell's class
#       id and is recognized by its ClassInfo.
#
#==============================================================================================

# mark: JsOrdinaryObject ========================================================================

## One own data property of an ordinary object: its key (a string) and its value. The stand-in's
## properties are writable, enumerable and configurable, as CreateDataProperty makes them.
pub struct JsOrdinaryObjectProperty:
    pub var key: ak.String
    pub var value: JsValue

## JS::Object (Libraries/LibJS/Runtime/Object.h:79) as OrdinaryObjectCreate makes it.
pub struct JsOrdinaryObject: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::Cell)
    pub var m_realm: Realm*  # the realm of the object's shape (Object::shape().realm())
    ## Its own properties in creation order (the Shape's property table).
    pub var m_properties: ak.Vector[JsOrdinaryObjectProperty]

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of an ordinary JS::Object.
pub let js_ordinary_object_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_ordinary_object_class, class_name = js_ordinary_object_class_name_impl, visit_edges = js_ordinary_object_visit_edges_impl))

## Class information of an ordinary JS::Object (JS::Cell's class id).
pub let js_ordinary_object_class: ak.ClassInfo = ak.ClassInfo(name = "Object", first_id = 1, last_id = 1, size = memory.size_of(JsOrdinaryObject), vtable = (const void*)&js_ordinary_object_vtable)
