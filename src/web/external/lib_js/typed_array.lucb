# mark: TypedArrayBase ==========================================================================

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:23 JS::typed_array_from: the typed array a
## value is, failing with a TypeError when it is not one.
pub func js_typed_array_from(vm: Vm*, typed_array_value: JsValue) -> JsTypedArrayBase*!:
    # auto this_object = TRY(typed_array_value.to_object(vm)): primitives are not typed arrays.
    if not js_value_is_object(typed_array_value):
        return try vm_throw_completion(vm, IdlSimpleExceptionType.type_error, .string_view(ak.sv("Not an object of type TypedArray")))
    let this_object = (gc.Cell*)js_value_as_object(typed_array_value)
    let typed_array = as_if_js_typed_array_base(this_object) else return try vm_throw_completion(vm, IdlSimpleExceptionType.type_error, .string_view(ak.sv("Not an object of type TypedArray")))
    return typed_array

## Ported from Libraries/LibJS/Runtime/TypedArray.h:61 JS::TypedArrayBase::viewed_array_buffer.
pub func js_typed_array_base_viewed_array_buffer(this: JsTypedArrayBase*) -> JsArrayBuffer*:
    return this.m_viewed_array_buffer

## Ported from Libraries/LibJS/Runtime/TypedArray.h:60 JS::TypedArrayBase::byte_offset.
pub func js_typed_array_base_byte_offset(this: JsTypedArrayBase*) -> u32:
    return this.m_byte_offset

## Ported from Libraries/LibJS/Runtime/TypedArray.h:58 JS::TypedArrayBase::array_length.
pub func js_typed_array_base_array_length(this: JsTypedArrayBase*) -> u32:
    return this.m_array_length

## Ported from Libraries/LibJS/Runtime/TypedArray.h:59 JS::TypedArrayBase::byte_length.
pub func js_typed_array_base_byte_length(this: JsTypedArrayBase*) -> u32:
    return this.m_byte_length

## Ported from Libraries/LibJS/Runtime/TypedArray.h:66 JS::TypedArrayBase::element_size: a
## Uint8Array's is 1.
pub func js_typed_array_base_element_size(this: JsTypedArrayBase*) -> u32:
    match this.m_kind:
        .uint8_array: return 1

## JS_OBJECT(Uint8Array, TypedArray)'s class_name.
func js_uint8_array_class_name_impl(this: gc.Cell*) -> ak.StringView:
    return ak.sv("Uint8Array")

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp JS::TypedArrayBase::visit_edges (override): the
## shape's realm and the viewed buffer.
pub func js_typed_array_base_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (JsTypedArrayBase*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_realm)
    gc.cell_visitor_visit_t_2(visitor, this.m_viewed_array_buffer)

## Ported from Libraries/LibJS/Runtime/TypedArray.h:512 JS::TypedArray<u8>::data: the viewed bytes,
## none when the array is out of bounds (its buffer detached).
pub func js_typed_array_base_data(this: JsTypedArrayBase*) -> const u8[]:
    let typed_array_record = js_make_typed_array_with_buffer_witness_record(this)

    if js_is_typed_array_out_of_bounds(&typed_array_record):
        # FIXME: Propagate this as an error?
        return b""

    let length = js_typed_array_length(&typed_array_record)
    let bytes = ak.byte_buffer_bytes(js_array_buffer_buffer(this.m_viewed_array_buffer))
    return bytes[(usize)this.m_byte_offset..<(usize)this.m_byte_offset + (usize)length]

# mark: Uint8Array ==============================================================================

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:481 JS::Uint8Array::create(Realm&, u32, ArrayBuffer&):
## a Uint8Array of `length` elements over `array_buffer` from its start.
pub func js_uint8_array_create(realm: Realm*, length: u32, array_buffer: JsArrayBuffer*) -> JsTypedArrayBase*:
    let this = (JsTypedArrayBase*)web_allocate_cell(realm, &js_uint8_array_class)
    js_uint8_array_construct(this, realm, length, array_buffer)
    web_initialize_cell(this.cell(), realm)
    return this

## Ported from Libraries/LibJS/Runtime/TypedArray.h:542 JS::TypedArray<u8>::TypedArray (with
## TypedArrayBase's constructor).
func js_uint8_array_construct(this: JsTypedArrayBase*, realm: Realm*, array_length: u32, array_buffer: JsArrayBuffer*):
    this.m_realm = realm
    this.m_kind = .uint8_array
    this.m_viewed_array_buffer = array_buffer
    this.m_array_length = array_length
    this.m_byte_length = (u32)js_array_buffer_byte_length(array_buffer)

## `Construct(%Uint8Array%, « buffer, byteOffset, length »)`: the %TypedArray% constructor's path for
## an ArrayBuffer argument (TypedArrayConstructor.cpp's construct, then
## InitializeTypedArrayFromArrayBuffer of TypedArray.cpp:42), with byteOffset and length given.
pub func js_construct_uint8_array(vm: Vm*, array_buffer: JsArrayBuffer*, byte_offset: u64, length: u64) -> JsTypedArrayBase*!:
    let realm = vm_current_realm(vm) else trap("VERIFY: a current realm")
    let typed_array = js_uint8_array_create(realm, 0, array_buffer)
    try js_initialize_typed_array_from_array_buffer(vm, typed_array, array_buffer, byte_offset, length)
    return typed_array

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:42 JS::initialize_typed_array_from_array_buffer:
## 22.2.5.1.3 InitializeTypedArrayFromArrayBuffer, https://tc39.es/ecma262/#sec-initializetypedarrayfromarraybuffer
## (byteOffset and length given as indices; the buffer is fixed-length).
func js_initialize_typed_array_from_array_buffer(vm: Vm*, typed_array: JsTypedArrayBase*, array_buffer: JsArrayBuffer*, byte_offset: u64, length: u64) -> !:
    # 1. Let elementSize be TypedArrayElementSize(O).
    let element_size = (u64)js_typed_array_base_element_size(typed_array)

    # 2. Let offset be ? ToIndex(byteOffset).
    let offset = byte_offset

    # 3. If offset modulo elementSize ≠ 0, throw a RangeError exception.
    if offset % element_size != 0:
        return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Invalid byte offset for Uint8Array")))

    # 4. Let bufferIsFixedLength be IsFixedLengthArrayBuffer(buffer). (It is.)

    # 5. If length is not undefined, then
    #    a. Let newLength be ? ToIndex(length).
    let new_length = length

    # 6. If IsDetachedBuffer(buffer) is true, throw a TypeError exception.
    if js_array_buffer_is_detached(array_buffer):
        return try vm_throw_completion(vm, IdlSimpleExceptionType.type_error, .string_view(ak.sv("ArrayBuffer is detached")))

    # 7. Let bufferByteLength be ArrayBufferByteLength(buffer, seq-cst).
    let buffer_byte_length = (u64)js_array_buffer_byte_length(array_buffer)

    # 8. (length is not undefined.)
    # 9. Else,
    #    b. Else,
    #       i. Let newByteLength be newLength × elementSize.
    let new_byte_length = new_length *? element_size else return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Invalid typed array length")))

    #       ii. If offset + newByteLength > bufferByteLength, throw a RangeError exception.
    let new_byte_end = offset +? new_byte_length else return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Invalid typed array length")))
    if new_byte_end > (u64)ak.u32_max:
        return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Invalid typed array length")))
    if new_byte_end > buffer_byte_length:
        return try vm_throw_completion(vm, IdlSimpleExceptionType.range_error, .string_view(ak.sv("Typed array range is out of the buffer")))

    #    c. Set O.[[ByteLength]] to newByteLength.
    typed_array.m_byte_length = (u32)new_byte_length

    #    d. Set O.[[ArrayLength]] to newByteLength / elementSize.
    typed_array.m_array_length = (u32)(new_byte_length // element_size)

    # 10. Set O.[[ViewedArrayBuffer]] to buffer.
    typed_array.m_viewed_array_buffer = array_buffer

    # 11. Set O.[[ByteOffset]] to offset.
    typed_array.m_byte_offset = (u32)offset

# mark: Witness records =========================================================================

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:620 JS::make_typed_array_with_buffer_witness_record:
## 10.4.5.10 MakeTypedArrayWithBufferWitnessRecord ( obj, order ) (seq-cst).
pub func js_make_typed_array_with_buffer_witness_record(typed_array: JsTypedArrayBase*) -> JsTypedArrayWithBufferWitness:
    # 1. Let buffer be obj.[[ViewedArrayBuffer]].
    let buffer = typed_array.m_viewed_array_buffer

    var byte_length: usize? = 0

    # 2. If IsDetachedBuffer(buffer) is true, then
    if js_array_buffer_is_detached(buffer):
        # a. Let byteLength be detached.
        byte_length = none
    # 3. Else,
    else:
        # a. Let byteLength be ArrayBufferByteLength(buffer, order).
        byte_length = js_array_buffer_byte_length(buffer)

    # 4. Return the TypedArray With Buffer Witness Record { [[Object]]: obj, [[CachedBufferByteLength]]: byteLength }.
    return JsTypedArrayWithBufferWitness(object = typed_array, cached_buffer_byte_length = byte_length)

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:643 JS::typed_array_byte_length:
## 10.4.5.12 TypedArrayByteLength ( taRecord ).
pub func js_typed_array_byte_length(typed_array_record: const JsTypedArrayWithBufferWitness*) -> u32:
    # 1. If IsTypedArrayOutOfBounds(taRecord) is true, return 0.
    if js_is_typed_array_out_of_bounds(typed_array_record):
        return 0

    # 2. Let length be TypedArrayLength(taRecord).
    let length = js_typed_array_length(typed_array_record)

    # 3. If length = 0, return 0.
    if length == 0:
        return 0

    # 4. Let O be taRecord.[[Object]].
    let object = typed_array_record.object

    # 5. If O.[[ByteLength]] is not auto, return O.[[ByteLength]]. (It never is auto here.)
    return object.m_byte_length

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:665 JS::typed_array_length:
## 10.4.5.13 TypedArrayLength ( taRecord ).
pub func js_typed_array_length(typed_array_record: const JsTypedArrayWithBufferWitness*) -> u32:
    # 1. Assert: IsTypedArrayOutOfBounds(taRecord) is false.
    assert(not js_is_typed_array_out_of_bounds(typed_array_record))

    # 2. Let O be taRecord.[[Object]].
    # 3. If O.[[ArrayLength]] is not auto, return O.[[ArrayLength]]. (It never is auto here.)
    return typed_array_record.object.m_array_length

## Ported from Libraries/LibJS/Runtime/TypedArray.cpp:695 JS::is_typed_array_out_of_bounds:
## 10.4.5.14 IsTypedArrayOutOfBounds ( taRecord ).
pub func js_is_typed_array_out_of_bounds(typed_array_record: const JsTypedArrayWithBufferWitness*) -> bool:
    # 1. Let O be taRecord.[[Object]].
    let object = typed_array_record.object

    # 2. Let bufferByteLength be taRecord.[[CachedBufferByteLength]].
    # 3. Assert: IsDetachedBuffer(O.[[ViewedArrayBuffer]]) is true if and only if bufferByteLength is detached.
    assert(js_array_buffer_is_detached(object.m_viewed_array_buffer) == (typed_array_record.cached_buffer_byte_length == none))

    # 4. If bufferByteLength is detached, return true.
    let buffer_byte_length = typed_array_record.cached_buffer_byte_length else return true

    # 5. Let byteOffsetStart be O.[[ByteOffset]].
    let byte_offset_start = (usize)object.m_byte_offset

    # 6. (O.[[ArrayLength]] is not auto.)
    # 7. Else,
    #    a. Let elementSize be TypedArrayElementSize(O).
    let element_size = (usize)js_typed_array_base_element_size(object)

    #    b. Let byteOffsetEnd be byteOffsetStart + O.[[ArrayLength]] × elementSize.
    let byte_offset_end = byte_offset_start + (usize)object.m_array_length * element_size

    # 8. If byteOffsetStart > bufferByteLength or byteOffsetEnd > bufferByteLength, return true.
    if byte_offset_start > buffer_byte_length or byte_offset_end > buffer_byte_length:
        return true

    # 9. NOTE: 0-length TypedArrays are not considered out-of-bounds.
    # 10. Return false.
    return false

# mark: Values ==================================================================================

## `chunk.as_if<JS::Uint8Array>()` and the array's `data()`: the bytes of a chunk that is a
## Uint8Array object, or none. (Region p2a's closure stub, ported over the stand-in.)
pub func js_value_as_if_uint8_array_data(chunk: JsValue) -> (const u8[])?:
    if not js_value_is_object(chunk):
        return none
    let array = as_if_js_uint8_array((gc.Cell*)js_value_as_object(chunk)) else return none
    return js_typed_array_base_data(array)
