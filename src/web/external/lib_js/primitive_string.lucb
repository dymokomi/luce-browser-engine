#==============================================================================================
#
#   primitive_string - JS::PrimitiveString and string values before luce-js
#
#   DESIGN.md §3.6's phase-1 stand-ins: LibWeb makes JS strings itself, faithfully to the donor
#   (CSSFontFeatureValuesMap keys its JS::Map by them, MediaList and DOMTokenList answer them
#   from item(), attribute-changed callbacks get them as arguments), so before phase 3 a string
#   is a cell of the engine and a JS::Value holds it under LibJS's STRING_TAG, as LibJS does.
#
#   DESCRIPTION:
#       Port of Libraries/LibJS/Runtime/PrimitiveString.cpp lines 124-172 (create from a
#       String or a FlyString), the string tests of Value.h (is_string, as_string) and
#       PrimitiveString::utf8_string. The UTF-16 form, the rope strings and the cache of
#       single-character and empty strings are phase 3.
#
#       Copyright (c) 2020-2025, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## LibJS's STRING_TAG (Libraries/LibJS/Runtime/Value.h:38).
let js_string_tag: u64 = 0b010 | gc.is_cell_bit

## JS_CELL(PrimitiveString, Cell)'s class_name.
func js_primitive_string_class_name_impl(this: gc.Cell*) -> ak.StringView:
    _ = this
    return ak.sv("PrimitiveString")

## Ported from Libraries/LibJS/Runtime/PrimitiveString.cpp:124 JS::PrimitiveString::create(VM&, String const&),
## as a JS::Value (Value(PrimitiveString*), Value.h:270).
pub func js_primitive_string_create_string(vm: Vm*, string: ak.String) -> JsValue:
    let this = (JsPrimitiveString*)web_heap_allocate_cell(vm_heap(vm), &js_primitive_string_class)
    this.m_utf8_string = string
    return js_value_from_encoded((js_string_tag << gc.tag_shift) | ((u64)(usize)this & 0x0000ffffffffffff))

## Ported from Libraries/LibJS/Runtime/PrimitiveString.cpp:156 JS::PrimitiveString::create(VM&, FlyString const&),
## as a JS::Value.
pub func js_primitive_string_create_fly_string(vm: Vm*, string: ak.FlyString) -> JsValue:
    return js_primitive_string_create_string(vm, ak.fly_string_to_string_const(&string))

## Ported from Libraries/LibJS/Runtime/Value.h:103 JS::Value::is_string.
pub func js_value_is_string(value: JsValue) -> bool:
    return js_value_tag(value) == js_string_tag

## Ported from Libraries/LibJS/Runtime/Value.h:350 JS::Value::as_string.
pub func js_value_as_string(value: JsValue) -> JsPrimitiveString*:
    assert(js_value_is_string(value))
    return (JsPrimitiveString*)gc.nan_boxed_value_as_cell_const(&value.nan_boxed_value)

## `value.as_string().utf8_string()` (PrimitiveString::utf8_string, PrimitiveString.cpp:208).
pub func js_value_as_string_utf8_string(value: JsValue) -> ak.String:
    return js_value_as_string(value).m_utf8_string
