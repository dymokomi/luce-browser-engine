#==============================================================================================
#
#   types_native_function - declarations of Libraries/LibJS/Runtime/NativeFunction.h
#
#   DESCRIPTION:
#       Structs, enums, vtables, class information and cast helpers generated from
#       Libraries/LibJS/Runtime/NativeFunction.h (Ladybird 47c82b38d0) by the skeleton
#       generator (DESIGN.md §4.4). Regenerate rather than edit, except to fill a field the
#       generator could not map.
#
#       Filled by hand in region r19 (DESIGN.md §3.6): a built-in function object whose
#       behaviour is native code. LibWeb wraps such functions in WebIDL callbacks to listen to
#       events itself (event handler attributes, the event listeners of form controls, media
#       controls, ...), so they are called before scripting exists. Before phase 3 the JS
#       objects LibWeb meets are cells, and so is this one; LibJS's CapturingNativeFunction (the
#       subclass NativeFunction::create makes) is folded in: the behaviour and its captures are
#       this cell's. The [[Prototype]] and the `length` and `name` properties are JS properties
#       (phase 3). The class shares JS::Cell's class id, as JS::Realm does, until the generator
#       numbers it; it is recognized by its ClassInfo.
#
#==============================================================================================

# mark: JsNativeFunction ========================================================================

## JS::NativeFunction (Libraries/LibJS/Runtime/NativeFunction.h:19), with
## CapturingNativeFunction's behaviour (NativeFunction.cpp:20).
pub struct JsNativeFunction: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::FunctionObject, JS::Object, JS::Cell)
    pub var m_realm: Realm*  # [[Realm]], which is also the realm of the function's shape
    pub var m_native_function: JsNativeFunctionBehaviour  # CapturingNativeFunction::m_native_function

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## AK::Function<ThrowCompletionOr<Value>(VM&)>, a native function's behaviour: a call pointer and
## its captures (DESIGN.md §2.7; a fallible result cannot be an ak.Function1 type argument).
pub struct JsNativeFunctionBehaviour:
    pub var call: (func(void*?, Vm*) -> JsValue!)?
    pub var context: void*?

## The vtable of JS::NativeFunction.
pub let js_native_function_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_native_function_class, class_name = js_native_function_class_name_impl, visit_edges = js_native_function_visit_edges_impl))

## Class information of JS::NativeFunction: name, class id (JS::Cell's, see above), size, vtable.
pub let js_native_function_class: ak.ClassInfo = ak.ClassInfo(name = "NativeFunction", first_id = 1, last_id = 1, size = sizeof(JsNativeFunction), vtable = (const void*)&js_native_function_vtable)

## is<JS::NativeFunction>: the cell's ClassInfo (the class id is JS::Cell's).
pub func is_js_native_function[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_native_function_class

## as_if<JS::NativeFunction>.
pub func as_if_js_native_function[P: gc.IsCell](p: P*) -> JsNativeFunction*?:
    if is_js_native_function(p): return (JsNativeFunction*)p
    return none
