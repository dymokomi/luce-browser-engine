# mark: JsPromise ===============================================================================

## JS::Promise::State (Libraries/LibJS/Runtime/Promise.h:22): [[PromiseState]].
pub enum JsPromiseState as i32:
    pending = 0
    fulfilled = 1
    rejected = 2

## JS::Promise::RejectionOperation (Libraries/LibJS/Runtime/Promise.h:27): the operation
## HostPromiseRejectionTracker is given.
pub enum JsPromiseRejectionOperation as i32:
    reject = 0
    handle = 1

## JS::Promise (Libraries/LibJS/Runtime/Promise.h:17): 27.2.6 Properties of Promise Instances,
## https://tc39.es/ecma262/#sec-properties-of-promise-instances
pub struct JsPromise: IsJsCell, gc.IsCell:
    pub var cell_base: JsCell  # primary base (JS::Object, JS::Cell)
    pub var m_realm: Realm*  # the realm of the object's shape (Object::shape().realm())
    pub var m_state: JsPromiseState  # [[PromiseState]], C++ default: { State::Pending }
    pub var m_is_handled: bool  # [[PromiseIsHandled]], C++ default: { false }
    pub var m_result: JsValue  # [[PromiseResult]]
    pub var m_fulfill_reactions: ak.Vector[JsPromiseReaction*?]  # [[PromiseFulfillReactions]]
    pub var m_reject_reactions: ak.Vector[JsPromiseReaction*?]  # [[PromiseRejectReactions]]

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## JS::Promise::ResolvingFunctions (Libraries/LibJS/Runtime/Promise.h:38).
pub struct JsPromiseResolvingFunctions:
    pub var resolve: JsFunctionObject*
    pub var reject: JsFunctionObject*

## The vtable of JS::Promise.
pub let js_promise_vtable: JsCellVTable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &js_promise_class, class_name = js_promise_class_name_impl, visit_edges = js_promise_visit_edges_impl))

## Class information of JS::Promise: name, class id (JS::Cell's, see above), size, vtable.
pub let js_promise_class: ak.ClassInfo = ak.ClassInfo(name = "Promise", first_id = 1, last_id = 1, size = memory.size_of(JsPromise), vtable = (const void*)&js_promise_vtable)

## is<JS::Promise> (Object::fast_is<Promise>, is_promise()): the cell's ClassInfo.
pub func is_js_promise[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &js_promise_class

## as_if<JS::Promise>.
pub func as_if_js_promise[P: gc.IsCell](p: P*) -> JsPromise*?:
    if is_js_promise(p): return (JsPromise*)p
    return none

## as<JS::Promise> (verify_cast).
pub func as_js_promise[P: gc.IsCell](p: P*) -> JsPromise*:
    return as_if_js_promise(p) else trap("as<JS::Promise> failed")
