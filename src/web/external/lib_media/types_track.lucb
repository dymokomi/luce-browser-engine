#
#   types_track - declarations of Libraries/LibMedia/Track.h and TrackType.h
#
#   DESCRIPTION:
#       Structs, enums, vtables, class information and cast helpers generated from
#       Libraries/LibMedia/Track.h (Ladybird 47c82b38d0) by the skeleton generator
#       (DESIGN.md §4.4). Regenerate rather than edit, except to fill a field the generator
#       could not map.
#
#       Filled by hand for the LibMedia seam (track.lucb): Track was opaque. VideoData's
#       `cicp` (Gfx::CodingIndependentCodePoints) and AudioData's sample specification are
#       what a decoder fills; no decoder is ported, so they are left out.
#
#==============================================================================================

# mark: MediaTrackType ==========================================================================

## Media::TrackType (Libraries/LibMedia/TrackType.h:13).
pub enum MediaTrackType as u8:
    video = 0
    audio = 1
    subtitles = 2
    unknown = 3

# mark: MediaTrack ==============================================================================

## Media::Track::VideoData (Libraries/LibMedia/Track.h:24).
pub struct MediaVideoData:
    pub var pixel_width: u64
    pub var pixel_height: u64

## Media::Track::AudioData (Libraries/LibMedia/Track.h:30): its sample specification is a
## decoder's (not ported).
pub struct MediaAudioData:
    pub var opaque_: u8

## Media::Track::Kind (Libraries/LibMedia/Track.h:36).
pub enum MediaTrackKind as u8:
    none_ = 0
    alternative = 1
    captions = 2
    descriptions = 3
    main = 4
    main_desc = 5
    metadata = 6
    sign = 7
    subtitles = 8
    translation = 9
    commentary = 10

## Variant<Empty, VideoData, AudioData> (Track::m_track_data).
pub enum MediaTrackData:
    empty
    video_data(value: MediaVideoData)
    audio_data(value: MediaAudioData)

## Media::Track (Libraries/LibMedia/Track.h:22).
pub struct MediaTrack:
    pub var m_type: MediaTrackType  # C++ default: { 0 }
    pub var m_identifier: usize  # C++ default: { 0 }
    pub var m_kind: MediaTrackKind  # C++ default: { Kind::None }
    pub var m_label: ak.Utf16String
    pub var m_language: ak.Utf16String
    pub var m_track_data: MediaTrackData
