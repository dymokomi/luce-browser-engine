#==============================================================================================
#
#   playback_manager - LibMedia's PlaybackManager, a seam without demuxers
#
#   DESCRIPTION:
#       LibMedia plays media through FFmpeg and its own Matroska reader (Containers/,
#       FFmpeg/, the data providers and sinks, the audio output). None of it is ported yet
#       (phase 4), so this port keeps LibMedia as a seam, like a Ladybird built without
#       demuxers: PlaybackManager::create_demuxer_for_stream answers a NotImplemented
#       DecoderError for every stream. Everything else here is
#       Libraries/LibMedia/PlaybackManager.h and .cpp as they run when that happens:
#
#         - add_media_source reports the error through on_unsupported_format_error on the
#           event loop (handle_media_init_error), so HTMLMediaElement takes the "media data
#           ... in an unsupported format" steps: it cancels the fetch and goes back to its
#           resource selection, which tries the next <source> and ends in the dedicated media
#           source failure steps (error event, poster shown, the load event no longer delayed);
#         - the manager stays in the Starting state (StartingStateHandler over
#           ResumingStateHandler): play and pause only flip its playing flag, its state is
#           Starting and no data is available;
#         - its time comes from a GenericTimeProvider and is clamped to the duration (zero);
#         - it has no tracks, so buffered_time_ranges is empty and nothing has a sink.
#
#       The thread pool is not used: the demuxer's verdict is known at once, and the report
#       is deferred to the event loop as handle_media_init_error defers it. What only a demuxer
#       makes reachable (track data, Playing/Paused/Seeking states, sinks) traps.
#
#       The manager is an OwnPtr in HTMLMediaElement; its destructor revokes the weak link
#       (media_playback_manager_destruct), which the element calls where the C++ OwnPtr
#       destroys it.
#
#       Copyright (c) 2022-2026, Gregory Bertilson <gregory@ladybird.org>
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: GenericTimeProvider =====================================================================

## Ported from Libraries/LibMedia/Providers/GenericTimeProvider.cpp:15 Media::GenericTimeProvider::current_time.
func media_generic_time_provider_current_time(this: const MediaGenericTimeProvider*) -> ak.Duration:
    var time = this.m_media_time
    if let resumed = this.m_monotonic_time_on_resume:
        let now = ak.monotonic_time_now()
        _ = ak.duration_add_assign(&time, ak.monotonic_time_sub_monotonic_time(&now, resumed))
    return time

# mark: Creation and destruction ================================================================

## Ported from Libraries/LibMedia/PlaybackManager.cpp:146 Media::PlaybackManager::create, with the
## constructor (PlaybackManager.cpp:154).
pub func media_playback_manager_create() -> MediaPlaybackManager*:
    let link = new MediaWeakPlaybackManagerLink(m_manager = none) else trap("out of memory")
    let time_provider = new MediaGenericTimeProvider(m_monotonic_time_on_resume = none, m_media_time = ak.duration_zero()) else trap("out of memory")
    let playback_manager = new MediaPlaybackManager(m_handler = none, m_weak_link = link, m_time_provider = time_provider, m_preferred_video_track = none,
                                                    m_preferred_audio_track = none, m_duration = ak.duration_zero()) else trap("out of memory")
    link.m_manager = playback_manager
    playback_manager.m_handler = new MediaStartingStateHandler(m_manager = playback_manager) else trap("out of memory")
    # m_handler->on_enter(): ResumingStateHandler's does nothing.
    return playback_manager

## Ported from Libraries/LibMedia/PlaybackManager.cpp:160 Media::PlaybackManager::~PlaybackManager:
## the OwnPtr's destructor (see the header).
pub func media_playback_manager_destruct(this: MediaPlaybackManager*):
    this.m_weak_link.m_manager = none

## Ported from Libraries/LibMedia/PlaybackManager.h:56 Media::PlaybackManager::set_audio_output_disabled.
pub func media_playback_manager_set_audio_output_disabled(this: MediaPlaybackManager*, disabled: bool):
    this.m_audio_output_disabled = disabled

# mark: Media sources ===========================================================================

## Ported from Libraries/LibMedia/PlaybackManager.cpp:25 Media::PlaybackManager::create_demuxer_for_stream:
## the seam (see the header). Ladybird asks its Matroska reader, then FFmpeg.
func media_playback_manager_create_demuxer_for_stream(stream: MediaIncrementallyPopulatedStream*) -> MediaDecoderError:
    _ = stream
    return media_decoder_error_with_description(MediaDecoderErrorCategory.not_implemented, "No demuxer for this media: LibMedia's demuxers are not ported")

## The captures of handle_media_init_error's deferred invocation: `[self = move(self), error = move(error)]`.
struct MediaPlaybackManagerInitError:
    var link: MediaWeakPlaybackManagerLink*
    var error_: MediaDecoderError

    static func invoke(context: void*?):
        let captures = (MediaPlaybackManagerInitError*)(context else trap("media init error: no captures"))
        let self_ = captures.link.m_manager else return
        if ak.function1_is_set(&self_.on_unsupported_format_error):
            ak.function1_call(&self_.on_unsupported_format_error, captures.error_)

## Ported from Libraries/LibMedia/PlaybackManager.cpp:165 Media::handle_media_init_error (static).
func media_playback_manager_handle_media_init_error(link: MediaWeakPlaybackManagerLink*, error_: MediaDecoderError):
    let captures = new MediaPlaybackManagerInitError(link = link, error_ = error_) else trap("out of memory")
    core_deferred_invoke(ak.Function0[unit](call = MediaPlaybackManagerInitError.invoke, context = captures))

## Ported from Libraries/LibMedia/PlaybackManager.cpp:178 Media::PlaybackManager::add_media_source (a stream).
pub func media_playback_manager_add_media_source(this: MediaPlaybackManager*, stream: MediaIncrementallyPopulatedStream*):
    # Threading::ThreadPool::the().submit([...] { auto demuxer_or_error = create_demuxer_for_stream(stream); ... }),
    # run here: the seam's demuxer always fails, so prepare_playback_from_demuxer is never reached.
    let error_ = media_playback_manager_create_demuxer_for_stream(stream)
    media_playback_manager_handle_media_init_error(this.m_weak_link, error_)

