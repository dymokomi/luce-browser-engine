# mark: Playback ================================================================================

## The manager's state handler (always the Starting state here, see the header).
func media_playback_manager_handler(this: MediaPlaybackManager*) -> MediaStartingStateHandler*:
    return this.m_handler else trap("PlaybackManager: no state handler")

## Ported from Libraries/LibMedia/PlaybackStates/ResumingStateHandler.cpp:15 Media::ResumingStateHandler::resume:
## replace_state_handler<PlayingStateHandler> or <PausedStateHandler>, which only a demuxer's tracks reach.
func media_starting_state_handler_resume(this: MediaStartingStateHandler*):
    if this.m_playing:
        trap("unported (P4): Media::PlayingStateHandler (media playback)")
    trap("unported (P4): Media::PausedStateHandler (media playback)")

## Ported from Libraries/LibMedia/PlaybackManager.cpp:387 Media::PlaybackManager::start, with
## StartingStateHandler::start (StartingStateHandler.cpp:13).
pub func media_playback_manager_start(this: MediaPlaybackManager*):
    let handler = media_playback_manager_handler(this)
    handler.m_started = true

    # if (manager().m_tracks_still_buffering.is_empty()) resume(); (no track ever buffers here)
    media_starting_state_handler_resume(handler)

## Ported from Libraries/LibMedia/PlaybackManager.cpp:392 Media::PlaybackManager::play, with
## ResumingStateHandler::play.
pub func media_playback_manager_play(this: MediaPlaybackManager*):
    media_playback_manager_handler(this).m_playing = true

## Ported from Libraries/LibMedia/PlaybackManager.cpp:397 Media::PlaybackManager::pause, with
## ResumingStateHandler::pause.
pub func media_playback_manager_pause(this: MediaPlaybackManager*):
    media_playback_manager_handler(this).m_playing = false

## Ported from Libraries/LibMedia/PlaybackManager.cpp:402 Media::PlaybackManager::seek: the handler's
## seek (PlaybackStateHandler::seek) replaces it with a SeekingStateHandler, which drives the
## data providers.
pub func media_playback_manager_seek(this: MediaPlaybackManager*, timestamp: ak.Duration, seek_mode: MediaSeekMode):
    trap("unported (P4): Media::SeekingStateHandler (media playback)")

## Ported from Libraries/LibMedia/PlaybackManager.cpp:408 Media::PlaybackManager::is_playing.
pub func media_playback_manager_is_playing(this: MediaPlaybackManager*) -> bool:
    return media_playback_manager_handler(this).m_playing

## Ported from Libraries/LibMedia/PlaybackManager.cpp:413 Media::PlaybackManager::state
## (StartingStateHandler::state).
pub func media_playback_manager_state(this: MediaPlaybackManager*) -> MediaPlaybackState:
    _ = media_playback_manager_handler(this)
    return MediaPlaybackState.starting

## Ported from Libraries/LibMedia/PlaybackManager.cpp:418 Media::PlaybackManager::available_data
## (StartingStateHandler::available_data).
pub func media_playback_manager_available_data(this: MediaPlaybackManager*) -> MediaAvailableData:
    _ = media_playback_manager_handler(this)
    return MediaAvailableData.none_

## Ported from Libraries/LibMedia/PlaybackManager.cpp:423 Media::PlaybackManager::buffered_time_ranges:
## the intersection of the enabled tracks' buffered ranges; there are no tracks here.
pub func media_playback_manager_buffered_time_ranges(this: MediaPlaybackManager*) -> MediaTimeRanges:
    _ = this
    return MediaTimeRanges()

## Ported from Libraries/LibMedia/PlaybackManager.cpp:446 Media::PlaybackManager::set_volume: the audio
## sink's volume, when there is a sink (there is none without audio tracks).
pub func media_playback_manager_set_volume(this: MediaPlaybackManager*, volume: f64):
    _ = this
    _ = volume

## Ported from Libraries/LibMedia/PlaybackManager.h:58 Media::PlaybackManager::duration.
pub func media_playback_manager_duration(this: MediaPlaybackManager*) -> ak.Duration:
    return this.m_duration

## Ported from Libraries/LibMedia/PlaybackManager.h:60 Media::PlaybackManager::current_time:
## `min(m_time_provider->current_time(), duration())`.
pub func media_playback_manager_current_time(this: MediaPlaybackManager*) -> ak.Duration:
    let time = media_generic_time_provider_current_time(this.m_time_provider)
    if ak.duration_cmp(&time, this.m_duration) < 0:
        return time
    return this.m_duration

