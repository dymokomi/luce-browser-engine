## AK::Duration::from_milliseconds.
func test_ms(milliseconds: i64) -> ak.Duration:
    return ak.duration_from_milliseconds(milliseconds)

## Whether `ranges` are exactly the ranges `expected` (start and end milliseconds).
func test_ranges_are(ranges: const MediaTimeRanges*, expected: const (i64, i64)[]) -> bool:
    if media_time_ranges_size(ranges) != expected.length:
        return false
    for index in 0..<expected.length:
        let range = ak.vector_at_const(&ranges.ranges, index)
        if not test_range_is(*range, expected[index]):
            return false
    return true

## Whether `range` is `expected` (start and end milliseconds).
func test_range_is(range: MediaTimeRange, expected: (i64, i64)) -> bool:
    return ak.duration_cmp(&range.start, test_ms(expected.0)) == 0 and ak.duration_cmp(&range.end, test_ms(expected.1)) == 0

test "TimeRanges: add_range_to_empty":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(200))
    assert(test_ranges_are(&ranges, [(100, 200)]))

test "TimeRanges: add_range_invalid_is_no_op":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(200), test_ms(100))
    assert(media_time_ranges_is_empty(&ranges))
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(100))
    assert(media_time_ranges_is_empty(&ranges))

test "TimeRanges: add_range_before_existing":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(300))
    assert(test_ranges_are(&ranges, [(100, 300), (500, 1000)]))

test "TimeRanges: add_range_after_existing":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(300))
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(1000))
    assert(test_ranges_are(&ranges, [(100, 300), (500, 1000)]))

test "TimeRanges: add_range_adjacent_extends_end":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(600))
    assert(test_ranges_are(&ranges, [(0, 600)]))

test "TimeRanges: add_range_adjacent_extends_start":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(300), test_ms(500))
    assert(test_ranges_are(&ranges, [(300, 1000)]))

test "TimeRanges: add_range_overlapping_extends_end":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(300), test_ms(700))
    assert(test_ranges_are(&ranges, [(0, 700)]))

test "TimeRanges: add_range_overlapping_extends_start":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(300), test_ms(700))
    assert(test_ranges_are(&ranges, [(300, 1000)]))

test "TimeRanges: add_range_inside_existing_is_no_op":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(300), test_ms(700))
    assert(test_ranges_are(&ranges, [(0, 1000)]))

test "TimeRanges: add_range_enclosing_existing":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(300), test_ms(700))
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(1000))
    assert(test_ranges_are(&ranges, [(0, 1000)]))

test "TimeRanges: add_range_bridges_two_ranges":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(700), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(400), test_ms(800))
    assert(test_ranges_are(&ranges, [(0, 1000)]))

test "TimeRanges: add_range_bridges_three_ranges":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(200))
    media_time_ranges_add_range(&ranges, test_ms(400), test_ms(600))
    media_time_ranges_add_range(&ranges, test_ms(800), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(900))
    assert(test_ranges_are(&ranges, [(0, 1000)]))

test "TimeRanges: add_range_between_existing_no_overlap":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(200))
    media_time_ranges_add_range(&ranges, test_ms(800), test_ms(1000))
    media_time_ranges_add_range(&ranges, test_ms(400), test_ms(600))
    assert(test_ranges_are(&ranges, [(0, 200), (400, 600), (800, 1000)]))

test "TimeRanges: add_range_sequential_frames":
    var ranges = MediaTimeRanges()
    for i in 0..<100:
        media_time_ranges_add_range(&ranges, test_ms(i * 33), test_ms((i + 1) * 33))
    assert(test_ranges_are(&ranges, [(0, 3300)]))

test "TimeRanges: remove_range_from_empty":
    var ranges = MediaTimeRanges()
    media_time_ranges_remove_range(&ranges, test_ms(0), test_ms(100))
    assert(media_time_ranges_is_empty(&ranges))

test "TimeRanges: remove_range_no_overlap":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_remove_range(&ranges, test_ms(600), test_ms(700))
    assert(test_ranges_are(&ranges, [(0, 500)]))

test "TimeRanges: remove_range_entire_range":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_remove_range(&ranges, test_ms(0), test_ms(500))
    assert(media_time_ranges_is_empty(&ranges))

test "TimeRanges: remove_range_splits_range":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(1000))
    media_time_ranges_remove_range(&ranges, test_ms(300), test_ms(700))
    assert(test_ranges_are(&ranges, [(0, 300), (700, 1000)]))

test "TimeRanges: remove_range_trims_start":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(1000))
    media_time_ranges_remove_range(&ranges, test_ms(0), test_ms(500))
    assert(test_ranges_are(&ranges, [(500, 1000)]))

test "TimeRanges: remove_range_trims_end":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(1000))
    media_time_ranges_remove_range(&ranges, test_ms(500), test_ms(1000))
    assert(test_ranges_are(&ranges, [(0, 500)]))

test "TimeRanges: remove_range_across_multiple_ranges":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(200))
    media_time_ranges_add_range(&ranges, test_ms(400), test_ms(600))
    media_time_ranges_add_range(&ranges, test_ms(800), test_ms(1000))
    media_time_ranges_remove_range(&ranges, test_ms(100), test_ms(900))
    assert(test_ranges_are(&ranges, [(0, 100), (900, 1000)]))

test "TimeRanges: highest_end_time_empty":
    var ranges = MediaTimeRanges()
    let highest = media_time_ranges_highest_end_time(&ranges)
    assert(ak.duration_is_zero(&highest))

test "TimeRanges: highest_end_time":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(700), test_ms(1000))
    let highest = media_time_ranges_highest_end_time(&ranges)
    assert(ak.duration_cmp(&highest, test_ms(1000)) == 0)

test "TimeRanges: coalesced_no_change":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(1000), test_ms(1500))
    let coalesced = media_time_ranges_coalesced(&ranges, test_ms(100))
    assert(test_ranges_are(&coalesced, [(0, 500), (1000, 1500)]))

test "TimeRanges: coalesced_merges_small_gap":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(550), test_ms(1000))
    let coalesced = media_time_ranges_coalesced(&ranges, test_ms(100))
    assert(test_ranges_are(&coalesced, [(0, 1000)]))

test "TimeRanges: coalesced_merges_exact_threshold":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(600), test_ms(1000))
    let coalesced = media_time_ranges_coalesced(&ranges, test_ms(100))
    assert(test_ranges_are(&coalesced, [(0, 1000)]))

test "TimeRanges: intersection_no_overlap":
    var a = MediaTimeRanges()
    var b = MediaTimeRanges()
    media_time_ranges_add_range(&a, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&b, test_ms(600), test_ms(1000))
    let intersection = media_time_ranges_intersection(&a, &b)
    assert(media_time_ranges_is_empty(&intersection))

test "TimeRanges: intersection_partial_overlap":
    var a = MediaTimeRanges()
    var b = MediaTimeRanges()
    media_time_ranges_add_range(&a, test_ms(0), test_ms(700))
    media_time_ranges_add_range(&b, test_ms(300), test_ms(1000))
    let intersection = media_time_ranges_intersection(&a, &b)
    assert(test_ranges_are(&intersection, [(300, 700)]))

test "TimeRanges: intersection_one_inside_other":
    var a = MediaTimeRanges()
    var b = MediaTimeRanges()
    media_time_ranges_add_range(&a, test_ms(0), test_ms(1000))
    media_time_ranges_add_range(&b, test_ms(300), test_ms(700))
    let intersection = media_time_ranges_intersection(&a, &b)
    assert(test_ranges_are(&intersection, [(300, 700)]))

test "TimeRanges: intersection_multiple_ranges":
    var a = MediaTimeRanges()
    var b = MediaTimeRanges()
    media_time_ranges_add_range(&a, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&a, test_ms(700), test_ms(1000))
    media_time_ranges_add_range(&b, test_ms(300), test_ms(800))
    let intersection = media_time_ranges_intersection(&a, &b)
    assert(test_ranges_are(&intersection, [(300, 500), (700, 800)]))

test "TimeRanges: intersection_with_empty":
    var a = MediaTimeRanges()
    var b = MediaTimeRanges()
    media_time_ranges_add_range(&a, test_ms(0), test_ms(1000))
    let intersection = media_time_ranges_intersection(&a, &b)
    assert(media_time_ranges_is_empty(&intersection))

test "TimeRanges: range_at_or_after_empty":
    var ranges = MediaTimeRanges()
    assert(media_time_ranges_range_at_or_after(&ranges, test_ms(0)) == none)

test "TimeRanges: range_at_or_after_inside_range":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(500))
    assert(test_range_is(media_time_ranges_range_at_or_after(&ranges, test_ms(300)) else trap("no range"), (100, 500)))

test "TimeRanges: range_at_or_after_before_range":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(500))
    assert(test_range_is(media_time_ranges_range_at_or_after(&ranges, test_ms(0)) else trap("no range"), (100, 500)))

test "TimeRanges: range_at_or_after_after_all_ranges":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(100), test_ms(500))
    assert(media_time_ranges_range_at_or_after(&ranges, test_ms(600)) == none)

test "TimeRanges: range_at_or_after_in_gap_returns_next":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(200))
    media_time_ranges_add_range(&ranges, test_ms(500), test_ms(700))
    assert(test_range_is(media_time_ranges_range_at_or_after(&ranges, test_ms(300)) else trap("no range"), (500, 700)))

test "TimeRanges: range_at_or_after_at_range_boundary":
    var ranges = MediaTimeRanges()
    media_time_ranges_add_range(&ranges, test_ms(0), test_ms(500))
    media_time_ranges_add_range(&ranges, test_ms(700), test_ms(1000))
    assert(test_range_is(media_time_ranges_range_at_or_after(&ranges, test_ms(0)) else trap("no range"), (0, 500)))
    assert(test_range_is(media_time_ranges_range_at_or_after(&ranges, test_ms(500)) else trap("no range"), (700, 1000)))
