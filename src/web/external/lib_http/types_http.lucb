## HTTP::HTTP_TAB_OR_SPACE (Libraries/LibHTTP/HTTP.h:18).
# https://fetch.spec.whatwg.org/#http-tab-or-space
# An HTTP tab or space is U+0009 TAB or U+0020 SPACE.
pub let http_http_tab_or_space: str = "\t "

## HTTP::HTTP_WHITESPACE (Libraries/LibHTTP/HTTP.h:22).
# https://fetch.spec.whatwg.org/#http-whitespace
# HTTP whitespace is U+000A LF, U+000D CR, or an HTTP tab or space.
pub let http_http_whitespace: str = "\n\r\t "

## HTTP::HTTP_NEWLINE_BYTES (Libraries/LibHTTP/HTTP.h:26).
# https://fetch.spec.whatwg.org/#http-newline-byte
# An HTTP newline byte is 0x0A (LF) or 0x0D (CR).
pub let http_http_newline_bytes: u32[2] = [0x0a, 0x0d]

## HTTP::HTTP_TAB_OR_SPACE_BYTES (Libraries/LibHTTP/HTTP.h:30).
# https://fetch.spec.whatwg.org/#http-tab-or-space-byte
# An HTTP tab or space byte is 0x09 (HT) or 0x20 (SP).
pub let http_http_tab_or_space_bytes: u32[2] = [0x09, 0x20]
