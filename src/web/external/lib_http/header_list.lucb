#==============================================================================================
#
#   header_list - HTTP::HeaderList: a response's or request's list of headers
#
#   DESCRIPTION:
#       Port of the parts of Libraries/LibHTTP/HeaderList.cpp phase 1 needs (create, contains,
#       get, append; lines 16-91), taken by region r28: the responses phase 1 makes (a srcdoc
#       iframe's, a test document's) carry headers that Document::create_and_initialize reads.
#       The rest of the list (combining, sorting, extracting values) comes with Fetch (phase 2).
#       HeaderList is reference counted in C++; here it is managed memory its owner refers to.
#
#       Copyright (c) 2022-2023, Linus Groh <linusg@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## HTTP::HeaderList (Libraries/LibHTTP/HeaderList.h). Filled by region r28.
pub struct HttpHeaderList:
    pub var m_headers: ak.Vector[HttpHeader]

## Ported from HeaderList.cpp:16 HTTP::HeaderList::create (with no headers).
pub func http_header_list_create() -> HttpHeaderList*:
    return new HttpHeaderList(m_headers = ak.Vector[HttpHeader]()) else trap("out of memory")

## Ported from HeaderList.cpp:27 HTTP::HeaderList::contains.
# https://fetch.spec.whatwg.org/#header-list-contains
pub func http_header_list_contains(this: HttpHeaderList*, name: ak.StringView) -> bool:
    # A header list list contains a header name name if list contains a header whose name is a byte-case-insensitive
    # match for name.
    for header in &ak.vector_span(&this.m_headers):
        if ak.byte_string_equals_ignoring_ascii_case(&header.name, name):
            return true
    return false

## Ported from HeaderList.cpp:37 HTTP::HeaderList::get.
# https://fetch.spec.whatwg.org/#concept-header-list-get
pub func http_header_list_get(this: HttpHeaderList*, name: ak.StringView) -> ak.ByteString?:
    # 1. If list does not contain name, then return null.
    if not http_header_list_contains(this, name):
        return none

    # 2. Return the values of all headers in list whose name is a byte-case-insensitive match for name, separated from
    #    each other by 0x2C 0x20, in order.
    var builder = ak.string_builder_new()
    var first = true

    for header in &ak.vector_span(&this.m_headers):
        if not ak.byte_string_equals_ignoring_ascii_case(&header.name, name):
            continue

        if not first:
            ak.string_builder_append(&builder, ", ")

        ak.string_builder_append_string_view(&builder, ak.byte_string_view(&header.value))
        first = false

    return ak.string_builder_to_byte_string(&builder)

## Ported from HeaderList.cpp:77 HTTP::HeaderList::append (of a Header made from `name` and
## `value`).
pub func http_header_list_append(this: HttpHeaderList*, name: ak.StringView, value: ak.StringView):
    var header = HttpHeader(name = ak.byte_string_from_string_view(name), value = ak.byte_string_from_string_view(value))

    # 1. If list contains name, then set name to the first such header’s name.
    # NOTE: This reuses the casing of the name of the header already in list, if any. If there are multiple matched
    #       headers their names will all be identical.
    for existing_header in &ak.vector_span(&this.m_headers):
        if ak.byte_string_equals_ignoring_ascii_case(&existing_header.name, name):
            header.name = existing_header.name
            break

    # 2. Append (name, value) to list.
    ak.vector_append_t(&this.m_headers, header)
