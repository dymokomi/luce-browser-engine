## Ported from Libraries/LibRequests/NetworkError.h:29 Requests::network_error_to_string.
pub func requests_network_error_to_string(network_error: RequestsNetworkError) -> ak.StringView:
    match network_error:
        .unable_to_resolve_proxy: return ak.sv("Unable to resolve proxy")
        .unable_to_resolve_host: return ak.sv("Unable to resolve host")
        .unable_to_connect: return ak.sv("Unable to connect")
        .timeout_reached: return ak.sv("Timeout reached")
        .too_many_redirects: return ak.sv("Too many redirects")
        .ssl_handshake_failed: return ak.sv("SSL handshake failed")
        .ssl_verification_failed: return ak.sv("SSL verification failed")
        .malformed_url: return ak.sv("The URL is not formatted properly")
        .incomplete_content: return ak.sv("Connection was closed before entire response was received")
        .invalid_content_encoding: return ak.sv("Response could not be decoded with its Content-Encoding")
        .request_server_died: return ak.sv("RequestServer is currently unavailable")
        .cache_read_failed: return ak.sv("RequestServer encountered an error reading a cached HTTP response")
        .unknown: return ak.sv("An unexpected network error occurred")
        _: trap("VERIFY_NOT_REACHED")
