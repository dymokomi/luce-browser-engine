## Ported from Libraries/LibRequests/ALPNHttpVersion.h:23 Requests::alpn_http_version_to_fly_string.
pub func requests_alpn_http_version_to_fly_string(version: RequestsAlpnHttpVersion) -> ak.FlyString:
    match version:
        .none_: return ak.fly_string_from_str("")
        .http1_0: return ak.fly_string_from_str("http/1.0")
        .http1_1: return ak.fly_string_from_str("http/1.1")
        .http2_tls: return ak.fly_string_from_str("h2")
        .http2_tcp: return ak.fly_string_from_str("h2c")
        .http3: return ak.fly_string_from_str("h3")
        _: trap("VERIFY_NOT_REACHED")
