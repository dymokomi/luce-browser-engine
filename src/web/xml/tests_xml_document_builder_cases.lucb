#==============================================================================================
#
#   tests_xml_document_builder_cases - region p2x's XML documents pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb (XMLDocumentBuilder over LibXML's libxml2 parser) on
#       the same inputs (luce-browser-tools, oracles/luce-browser-engine/xml_documents:
#       cases.txt, oracle.cpp, gen_luce_cases.py, build.sh). tests_xml_document_builder runs each
#       case through the port and compares. Parse error messages are written "*" (libxml2's and
#       luce-xml's words differ).
#
#==============================================================================================

## One oracle case: the mode, its arguments, and the reference build's output.
struct TestXmlDocumentCase:
    let mode: str
    let arguments: str[2]
    let expected: str

## Every oracle case, in cases.txt order (6 more, marked "!" there, deviate on purpose and are
## pinned by tests_xml_document_builder instead).
let test_xml_document_cases: TestXmlDocumentCase[77] = [
    TestXmlDocumentCase(mode = "entity", arguments = ["nbsp", ""], expected = "a0 \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["amp", ""], expected = "26 \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["eacute", ""], expected = "e9 \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["NotEqualTilde", ""], expected = "2242 338 \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["fjlig", ""], expected = "66 6a \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["nosuch", ""], expected = "none\n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["lt;", ""], expected = "none\n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["AMP", ""], expected = "26 \n"),
    TestXmlDocumentCase(mode = "entity", arguments = ["", ""], expected = "none\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<root/>", ""], expected = "has_error false\n| <root> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a><b>text</b></a>", ""], expected = "has_error false\n| <a> Element\n|   <b> Element\n|     \"text\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html SYSTEM \"about:legacy-compat\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n    <meta charset=\"utf-8\" />\n    <title>T</title>\n    <meta name=\"assert\" content=\"green\" />\n</head>\n<body>\n<p>Test passes if there is a <strong>green</strong> square.</p>\n<div></div>\n</body>\n</html>\n", ""], expected = "has_error false\n| <!DOCTYPE html \"\" \"about:legacy-compat\">\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   \"\n\"\n|   <html head> HTMLHeadElement\n|     \"\n    \"\n|     <html meta> HTMLMetaElement\n|       charset=\"utf-8\"\n|     \"\n    \"\n|     <html title> HTMLTitleElement\n|       \"T\"\n|     \"\n    \"\n|     <html meta> HTMLMetaElement\n|       name=\"assert\"\n|       content=\"green\"\n|     \"\n\"\n|   \"\n\"\n|   <html body> HTMLBodyElement\n|     \"\n\"\n|     <html p> HTMLParagraphElement\n|       \"Test passes if there is a \"\n|       <html strong> HTMLElement\n|         \"green\"\n|       \" square.\"\n|     \"\n\"\n|     <html div> HTMLDivElement\n|     \"\n\"\n|   \"\n\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><p>a&nbsp;b&eacute;&NotEqualTilde;</p></html>", ""], expected = "has_error false\n| <!DOCTYPE html \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html p> HTMLParagraphElement\n|     \"a bé≂̸\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.1//EN\" \"http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><p title=\"x\">&copy;&nosuch;</p></html>", ""], expected = "has_error false\n| <!DOCTYPE html \"-//W3C//DTD XHTML 1.1//EN\" \"http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd\">\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html p> HTMLParagraphElement\n|     title=\"x\"\n|     \"©\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<html xmlns=\"http://www.w3.org/1999/xhtml\"><p>a&nbsp;b</p></html>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html><html xmlns=\"http://www.w3.org/1999/xhtml\"><p>a&nbsp;b</p></html>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html SYSTEM \"about:legacy-compat\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><p>a&nbsp;b</p></html>", ""], expected = "has_error false\n| <!DOCTYPE html \"\" \"about:legacy-compat\">\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html p> HTMLParagraphElement\n|     \"ab\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE html PUBLIC \"-//foo//EN\" \"x.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><p>a&nbsp;b</p></html>", ""], expected = "has_error false\n| <!DOCTYPE html \"-//foo//EN\" \"x.dtd\">\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html p> HTMLParagraphElement\n|     \"ab\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE x [<!ENTITY e \"hi\">]><x>&e;</x>", ""], expected = "has_error false\n| <!DOCTYPE x \"\" \"\">\n| <x> Element\n|   \"hi\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE a [<!ENTITY e \"<b>x</b>y\">]><a>&e;</a>", ""], expected = "has_error false\n| <!DOCTYPE a \"\" \"\">\n| <a> Element\n|   <b> Element\n|     \"x\"\n|   \"y\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE a SYSTEM \"a.dtd\"><a>&nbsp;&q;</a>", ""], expected = "has_error false\n| <!DOCTYPE a \"\" \"a.dtd\">\n| <a> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a href=\"x?&lt;&#x41;&gt;&quot;\">t &amp; u &#60; v &gt;</a>", ""], expected = "has_error false\n| <a> Element\n|   href=\"x?<A>\"\"\n|   \"t & u < v >\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE a [<!ATTLIST a d CDATA \"def\" xmlns:p CDATA \"urn:p\">]><a x=\"1\"/>", ""], expected = "has_error false\n| <!DOCTYPE a \"\" \"\">\n| <a> Element\n|   xmlns xmlns:p=\"urn:p\"\n|   x=\"1\"\n|   d=\"def\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!DOCTYPE a [<!ATTLIST a b NMTOKENS #IMPLIED>]><a b=\"  x   y  \"/>", ""], expected = "has_error false\n| <!DOCTYPE a \"\" \"\">\n| <a> Element\n|   b=\"x y\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a b=\"  x\n\ty  \"/>", ""], expected = "has_error false\n| <a> Element\n|   b=\"  x  y  \"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a b='&quot;x&apos;'/>", ""], expected = "has_error false\n| <a> Element\n|   b=\"\"x'\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>  <b/>  </a>", ""], expected = "has_error false\n| <a> Element\n|   \"  \"\n|   <b> Element\n|   \"  \"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!-- before --><?pi data?><a/><!-- after --><?pi2?>", ""], expected = "has_error false\n| <!--  before  -->\n| <?pi data?>\n| <a> Element\n| <!--  after  -->\n| <?pi2 ?>\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<!-- c --><!DOCTYPE a><a/>", ""], expected = "has_error false\n| <!DOCTYPE a \"\" \"\">\n| <!--  c  -->\n| <a> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<?xml-stylesheet href=\"a.css\"?><a/>", ""], expected = "has_error false\n| <?xml-stylesheet href=\"a.css\"?>\n| <a> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a><![CDATA[x<y]]>z</a>", ""], expected = "has_error false\n| <a> Element\n|   <![CDATA[x<yz]]>\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>z<![CDATA[x<y]]></a>", ""], expected = "has_error false\n| <a> Element\n|   \"z\"\n|   <![CDATA[x<y]]>\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>x<!--c-->y<?p d?>z</a>", ""], expected = "has_error false\n| <a> Element\n|   \"x\"\n|   <!-- c -->\n|   \"y\"\n|   <?p d?>\n|   \"z\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<html xmlns=\"http://www.w3.org/1999/xhtml\"><body><template><p>in</p><template><i>deep</i></template></template><p>after</p></body></html>", ""], expected = "has_error false\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html body> HTMLBodyElement\n|     <html template> HTMLTemplateElement\n|       content\n|         <html p> HTMLParagraphElement\n|           \"in\"\n|         <html template> HTMLTemplateElement\n|           content\n|             <html i> HTMLElement\n|               \"deep\"\n|     <html p> HTMLParagraphElement\n|       \"after\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><use xlink:href=\"#a\" xml:space=\"preserve\"/><foreignObject><div xmlns=\"http://www.w3.org/1999/xhtml\">h</div></foreignObject></svg>", ""], expected = "has_error false\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|   xmlns xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n|   <svg use> SVGUseElement\n|     xlink xlink:href=\"#a\"\n|     xml xml:space=\"preserve\"\n|   <svg foreignObject> SVGForeignObjectElement\n|     <html div> HTMLDivElement\n|       xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|       \"h\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<svg viewBox=\"0 0 32 64\" width=\"128\" height=\"256\" xmlns=\"http://www.w3.org/2000/svg\">\n    <desc>white diamond on blue</desc>\n    <rect x=\"0\" y=\"0\" width=\"32\" height=\"64\" fill=\"blue\"/>\n    <g fill=\"white\">\n        <path d=\"M16 0 L32 32 L16 64 L0 32 Z\" />\n    </g>\n</svg>\n", ""], expected = "has_error false\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|   viewBox=\"0 0 32 64\"\n|   width=\"128\"\n|   height=\"256\"\n|   \"\n    \"\n|   <svg desc> SVGDescElement\n|     \"white diamond on blue\"\n|   \"\n    \"\n|   <svg rect> SVGRectElement\n|     x=\"0\"\n|     y=\"0\"\n|     width=\"32\"\n|     height=\"64\"\n|     fill=\"blue\"\n|   \"\n    \"\n|   <svg g> SVGGElement\n|     fill=\"white\"\n|     \"\n        \"\n|     <svg path> SVGPathElement\n|       d=\"M16 0 L32 32 L16 64 L0 32 Z\"\n|     \"\n    \"\n|   \"\n\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"100\" height=\"100\" viewBox=\"0 0 100 100\"><desc><![CDATA[.foo{}]]></desc></svg>", ""], expected = "has_error false\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|   width=\"100\"\n|   height=\"100\"\n|   viewBox=\"0 0 100 100\"\n|   <svg desc> SVGDescElement\n|     <![CDATA[.foo{}]]>\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<html xmlns=\"http://www.w3.org/1999/xhtml\"><body><svg xmlns=\"http://www.w3.org/2000/svg\"><circle r=\"1\"/></svg><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math></body></html>", ""], expected = "has_error false\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html body> HTMLBodyElement\n|     <svg svg> SVGSVGElement\n|       xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|       <svg circle> SVGCircleElement\n|         r=\"1\"\n|     <math math> MathMLElement\n|       xmlns xmlns=\"http://www.w3.org/1998/Math/MathML\"\n|       <math mi> MathMLMiElement\n|         \"x\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<p:a xmlns:p=\"urn:p\" p:x=\"1\" y=\"2\"><p:b/><c/></p:a>", ""], expected = "has_error false\n| <{urn:p} p:a> Element\n|   xmlns xmlns:p=\"urn:p\"\n|   {urn:p} p:x=\"1\"\n|   y=\"2\"\n|   <{urn:p} p:b> Element\n|   <c> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns:p=\"urn:p\"><p:b xmlns:p=\"urn:q\"/><p:c/></a>", ""], expected = "has_error false\n| <a> Element\n|   xmlns xmlns:p=\"urn:p\"\n|   <{urn:q} p:b> Element\n|     xmlns xmlns:p=\"urn:q\"\n|   <{urn:p} p:c> Element\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns=\"urn:x\" xmlns:b=\"urn:b\"><b:c b:d=\"1\"/><e xmlns=\"\"/></a>", ""], expected = "has_error false\n| <{urn:x} a> Element\n|   xmlns xmlns=\"urn:x\"\n|   xmlns xmlns:b=\"urn:b\"\n|   <{urn:b} b:c> Element\n|     {urn:b} b:d=\"1\"\n|   <e> Element\n|     xmlns xmlns=\"\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"h\"/>", ""], expected = "has_error false\n| <a> Element\n|   xmlns xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n|   xlink xlink:href=\"h\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns=\"\">t</a>", ""], expected = "has_error false\n| <a> Element\n|   xmlns xmlns=\"\"\n|   \"t\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xml:lang=\"en\" xmlns:xml=\"http://www.w3.org/XML/1998/namespace\"/>", ""], expected = "has_error false\n| <a> Element\n|   xml xml:lang=\"en\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>", ""], expected = "has_error false\n| <math math> MathMLElement\n|   xmlns xmlns=\"http://www.w3.org/1998/Math/MathML\"\n|   <math mi> MathMLMiElement\n|     \"x\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>T</title><meta name=\"x\" content=\"y\"/></head><body><p>a<br/>b</p></body></html>", ""], expected = "has_error false\n| <html html> HTMLHtmlElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html head> HTMLHeadElement\n|     <html title> HTMLTitleElement\n|       \"T\"\n|     <html meta> HTMLMetaElement\n|       name=\"x\"\n|       content=\"y\"\n|   <html body> HTMLBodyElement\n|     <html p> HTMLParagraphElement\n|       \"a\"\n|       <html br> HTMLBRElement\n|       \"b\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<a>\r\nb\rc</a>", ""], expected = "has_error false\n| <a> Element\n|   \"\nb\nc\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a>é</a>", ""], expected = "has_error false\n| <a> Element\n|   \"é\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<?xml version=\"1.1\"?><a>x</a>", ""], expected = "has_error false\n| <a> Element\n|   \"x\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["\u{feff}<a>bom</a>", ""], expected = "has_error false\n| <a> Element\n|   \"bom\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<HTML xmlns=\"http://www.w3.org/1999/xhtml\"><Body/></HTML>", ""], expected = "has_error false\n| <html HTML> HTMLUnknownElement\n|   xmlns xmlns=\"http://www.w3.org/1999/xhtml\"\n|   <html Body> HTMLUnknownElement\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a><b></a>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a></a>trailing", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a/><b/>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a x=\"1\" x=\"2\"/>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>&undefined;</a>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>&#0;</a>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns:p=\"urn:p\"><b xmlns:p=\"\"/></a>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns:p=\"urn:p\" p:a=\"1\" xmlns:q=\"urn:p\" q:a=\"2\"/>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a>]]></a>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xmlns=\"x\"/>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<a xmlns:a=\"http://www.w3.org/2000/xmlns/\"/>", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "load", arguments = ["<p>unclosed", ""], expected = "has_error false\nerror *\n| <html html> HTMLHtmlElement\n|   <html body> HTMLBodyElement\n|     \"Failed to parse XML document: *\"\n"),
    TestXmlDocumentCase(mode = "build", arguments = ["<!-- c --><a><![CDATA[x]]><!-- d --></a>", ""], expected = "result true\n| <a> Element\n|   <![CDATA[x]]>\n"),
    TestXmlDocumentCase(mode = "build", arguments = ["<a><b></a>", ""], expected = "result false\n| <a> Element\n|   <b> Element\n"),
    TestXmlDocumentCase(mode = "build", arguments = ["<?xml version=\"1.0\"?><a>é</a>", ""], expected = "result true\n| <a> Element\n|   \"é\"\n"),
    TestXmlDocumentCase(mode = "svg", arguments = ["<!-- c --><svg xmlns=\"http://www.w3.org/2000/svg\"><script>x</script><![CDATA[y]]></svg>", ""], expected = "has_error false\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|   <svg script> SVGScriptElement\n|     \"x\"\n|   <![CDATA[y]]>\n"),
    TestXmlDocumentCase(mode = "svg", arguments = ["<svg><b></svg>", ""], expected = "has_error false\nerror *\n| <svg> Element\n|   <b> Element\n"),
    TestXmlDocumentCase(mode = "svg", arguments = ["<svg xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"10\" height=\"10\"/></svg>", ""], expected = "has_error false\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n|   <svg rect> SVGRectElement\n|     width=\"10\"\n|     height=\"10\"\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<a xmlns=\"urn:a\" xmlns:p=\"urn:p\"/>", "<b/><p:c/>text"], expected = "| <{urn:a} b> Element\n| <{urn:p} p:c> Element\n| \"text\"\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<a/>", "<b>"], expected = "exception SyntaxError *\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<a/>", "x<b/>y"], expected = "| \"x\"\n| <b> Element\n| \"y\"\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<html xmlns=\"http://www.w3.org/1999/xhtml\"/>", "<p>para</p><svg xmlns=\"http://www.w3.org/2000/svg\"/>"], expected = "| <html p> HTMLParagraphElement\n|   \"para\"\n| <svg svg> SVGSVGElement\n|   xmlns xmlns=\"http://www.w3.org/2000/svg\"\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<p:a xmlns:p=\"urn:p\" xmlns:q=\"urn:q\"/>", "<q:b p:c=\"1\"/>"], expected = "| <{urn:q} q:b> Element\n|   {urn:p} p:c=\"1\"\n"),
    TestXmlDocumentCase(mode = "frag", arguments = ["<a/>", ""], expected = ""),
    TestXmlDocumentCase(mode = "frag", arguments = ["<a/>", "<!--c--><![CDATA[d]]>"], expected = "| <![CDATA[d]]>\n"),
]
