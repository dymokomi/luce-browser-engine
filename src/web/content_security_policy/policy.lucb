## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.h:45 Web::ContentSecurityPolicy::Policy::directives.
## (A copy of the Vector struct: its buffer is shared, and no caller changes it.)
pub func content_security_policy_policy_directives(this: ContentSecurityPolicyPolicy*) -> ak.Vector[ContentSecurityPolicyDirective*]:
    return this.m_directives

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.h:46 Web::ContentSecurityPolicy::Policy::disposition.
pub func content_security_policy_policy_disposition(this: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyPolicyDisposition:
    return this.m_disposition

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.h:47 Web::ContentSecurityPolicy::Policy::source.
pub func content_security_policy_policy_source(this: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyPolicySource:
    return this.m_source

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.h:48 Web::ContentSecurityPolicy::Policy::self_origin.
pub func content_security_policy_policy_self_origin(this: ContentSecurityPolicyPolicy*) -> web_url.Origin:
    return this.m_self_origin else trap("VERIFY: Optional::value of the policy's self-origin")

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.h:49 Web::ContentSecurityPolicy::Policy::pre_parsed_policy_string.
pub func content_security_policy_policy_pre_parsed_policy_string(this: ContentSecurityPolicyPolicy*) -> ak.String:
    return this.m_pre_parsed_policy_string

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:159 Web::ContentSecurityPolicy::Policy::contains_directive_with_name.
pub func content_security_policy_policy_contains_directive_with_name(this: ContentSecurityPolicyPolicy*, name: ak.StringView) -> bool:
    # m_directives.find_if([name](auto const& directive) { return directive->name() == name; })
    for directive in ak.vector_span(&this.m_directives):
        if ak.string_eq_string_view(&directive.m_name, name):
            return true
    return false

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:167 Web::ContentSecurityPolicy::Policy::get_directive_by_name.
pub func content_security_policy_policy_get_directive_by_name(this: ContentSecurityPolicyPolicy*, name: ak.StringView) -> ContentSecurityPolicyDirective*?:
    # m_directives.find_if([name](auto const& directive) { return directive->name() == name; })
    for directive in ak.vector_span(&this.m_directives):
        if ak.string_eq_string_view(&directive.m_name, name):
            return directive

    return none

# mark: Cloning and serializing =================================================================

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:179 Web::ContentSecurityPolicy::Policy::clone.
pub func content_security_policy_policy_clone(this: ContentSecurityPolicyPolicy*, heap: gc.Heap*) -> ContentSecurityPolicyPolicy*:
    let policy = heap_allocate_content_security_policy_policy(heap)

    for directive in ak.vector_span(&this.m_directives):
        let cloned_directive = content_security_policy_directive_clone(directive, heap)
        ak.vector_append_t(&policy.m_directives, cloned_directive)

    policy.m_disposition = this.m_disposition
    policy.m_source = this.m_source
    policy.m_self_origin = this.m_self_origin
    policy.m_pre_parsed_policy_string = this.m_pre_parsed_policy_string
    return policy

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:194 Web::ContentSecurityPolicy::Policy::serialize.
pub func content_security_policy_policy_serialize(this: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicySerializedPolicy:
    var serialized_directives = ak.Vector[ContentSecurityPolicySerializedDirective]()

    for directive in ak.vector_span(&this.m_directives):
        ak.vector_append_t(&serialized_directives, content_security_policy_directive_serialize(directive))

    return ContentSecurityPolicySerializedPolicy(directives = serialized_directives, disposition = this.m_disposition, source = this.m_source,
                                                 self_origin = this.m_self_origin else trap("VERIFY: Optional::value of the policy's self-origin"), pre_parsed_policy_string = this.m_pre_parsed_policy_string)

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:211 Web::ContentSecurityPolicy::Policy::remove_directive.
pub func content_security_policy_policy_remove_directive(this: ContentSecurityPolicyPolicy*, name: ak.FlyString):
    # m_directives.remove_all_matching([&name](auto const& directive) { return directive->name() == name; })
    var index: usize = 0
    while index < ak.vector_size(&this.m_directives):
        let directive = *ak.vector_at(&this.m_directives, index)
        if ak.string_eq_fly_string(&directive.m_name, &name):
            ak.vector_remove(&this.m_directives, index)
        else:
            index += 1

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:218 Web::ContentSecurityPolicy::Policy::set_self_origin.
pub func content_security_policy_policy_set_self_origin(this: ContentSecurityPolicyPolicy*, origin: web_url.Origin):
    this.m_self_origin = origin

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Policy.cpp:223 Web::ContentSecurityPolicy::Policy::visit_edges (override).
pub func content_security_policy_policy_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (ContentSecurityPolicyPolicy*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_vector(visitor, &this.m_directives)
