#==============================================================================================
#
#   tests_csp_cases - Content Security Policy's and SRI's results pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's ContentSecurityPolicy (policies, directives, source
#       expressions, the blocking algorithms, violations) and SRI on the same inputs
#       (luce-browser-tools, oracles/luce-browser-engine/csp: gen_cases.py, cases.txt,
#       oracle.cpp, gen_luce_cases.py). Each case is an operation, its arguments separated by
#       0x1F, and the oracle's result line; tests_csp_1 runs the operation and prints its result
#       the way the oracle does.
#
#==============================================================================================

## A case of the oracle: an operation, its arguments (separated by 0x1F) and the expected result.
struct CspCase:
    var op: str
    var argument_count: usize
    var arguments: const u8[]
    var expected: const u8[]

## The cases (generated).
let csp_cases: CspCase[3995] = [
