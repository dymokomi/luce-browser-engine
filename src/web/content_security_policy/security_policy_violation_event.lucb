## Ported from Libraries/LibWeb/ContentSecurityPolicy/SecurityPolicyViolationEvent.cpp:25 Web::ContentSecurityPolicy::SecurityPolicyViolationEvent::SecurityPolicyViolationEvent.
func content_security_policy_security_policy_violation_event_construct(this: ContentSecurityPolicySecurityPolicyViolationEvent*, realm: Realm*, event_name: ak.FlyString, event_init: const ContentSecurityPolicySecurityPolicyViolationEventInit*):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_document_uri = event_init.document_uri
    this.m_referrer = event_init.referrer
    this.m_blocked_uri = event_init.blocked_uri
    this.m_violated_directive = event_init.violated_directive
    this.m_effective_directive = event_init.effective_directive
    this.m_original_policy = event_init.original_policy
    this.m_source_file = event_init.source_file
    this.m_sample = event_init.sample
    this.m_disposition = event_init.disposition
    this.m_status_code = event_init.status_code
    this.m_line_number = event_init.line_number
    this.m_column_number = event_init.column_number

