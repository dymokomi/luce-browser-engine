#==============================================================================================
#
#   directive - ContentSecurityPolicy::Directives::Directive: a directive's name and value, its
#   seven checks (all "Allowed" unless a subclass overrides them), clone and serialize
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.cpp (lines 1-35)
#       and the inline functions of Directive.h (lines 50-100). SerializedDirective.cpp holds
#       only the IPC encoder and decoder, which are not ported.
#
#       Copyright (c) 2025, Luke Wilde <luke@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.cpp:16 Web::ContentSecurityPolicy::Directives::Directive::Directive.
pub func content_security_policy_directive_construct(this: ContentSecurityPolicyDirective*, name: ak.String, value: ak.Vector[ak.String]):
    this.m_name = name
    this.m_value = value

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.cpp:22 Web::ContentSecurityPolicy::Directives::Directive::clone.
pub func content_security_policy_directive_clone(this: ContentSecurityPolicyDirective*, heap: gc.Heap*) -> ContentSecurityPolicyDirective*:
    return content_security_policy_directives_create_directive(heap, this.m_name, ak.vector_clone(&this.m_value))

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.cpp:27 Web::ContentSecurityPolicy::Directives::Directive::serialize.
pub func content_security_policy_directive_serialize(this: ContentSecurityPolicyDirective*) -> ContentSecurityPolicySerializedDirective:
    return ContentSecurityPolicySerializedDirective(name = this.m_name, value = ak.vector_clone(&this.m_value))

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:55 Web::ContentSecurityPolicy::Directives::Directive::pre_request_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-pre-request-check
# 1. A pre-request check, which takes a request and a policy as an argument, and is executed during
#    § 4.1.2 Should request be blocked by Content Security Policy?. This algorithm returns "Allowed"
#    unless otherwise specified.
pub func content_security_policy_directive_pre_request_check_impl(this: ContentSecurityPolicyDirective*, heap: gc.Heap*, request: FetchRequest*, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:61 Web::ContentSecurityPolicy::Directives::Directive::post_request_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-post-request-check
# 2. A post-request check, which takes a request, a response, and a policy as arguments, and is executed during
#    § 4.1.3 Should response to request be blocked by Content Security Policy?. This algorithm returns "Allowed"
#    unless otherwise specified.
pub func content_security_policy_directive_post_request_check_impl(this: ContentSecurityPolicyDirective*, heap: gc.Heap*, request: FetchRequest*, response: FetchResponse*, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:68 Web::ContentSecurityPolicy::Directives::Directive::inline_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-inline-check
# 3. An inline check, which takes an Element, a type string, a policy, and a source string as arguments, and is
#    executed during § 4.2.3 Should element’s inline type behavior be blocked by Content Security Policy? and
#    during § 4.2.4 Should navigation request of type be blocked by Content Security Policy? for javascript:
#    requests. This algorithm returns "Allowed" unless otherwise specified.
pub func content_security_policy_directive_inline_check_impl(this: ContentSecurityPolicyDirective*, heap: gc.Heap*, element: DomElement*?, type_: ContentSecurityPolicyInlineType, policy: ContentSecurityPolicyPolicy*, source: ak.String) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:74 Web::ContentSecurityPolicy::Directives::Directive::initialization (virtual).
# https://w3c.github.io/webappsec-csp/#directive-initialization
# 4. An initialization, which takes a Document or global object and a policy as arguments. This algorithm is
#    executed during § 4.2.1 Run CSP initialization for a Document and § 4.2.6 Run CSP initialization for
#    a global object. Unless otherwise specified, it has no effect and it returns "Allowed".
pub func content_security_policy_directive_initialization_impl(this: ContentSecurityPolicyDirective*, context: DomDocumentOrHtmlWorkerGlobalScope, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:80 Web::ContentSecurityPolicy::Directives::Directive::pre_navigation_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-pre-navigation-check
# 5. A pre-navigation check, which takes a request, a navigation type string ("form-submission" or "other")
#    and a policy as arguments, and is executed during § 4.2.4 Should navigation request of type be blocked by
#    Content Security Policy?. It returns "Allowed" unless otherwise specified.
pub func content_security_policy_directive_pre_navigation_check_impl(this: ContentSecurityPolicyDirective*, request: FetchRequest*, navigation_type: ContentSecurityPolicyNavigationType, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:87 Web::ContentSecurityPolicy::Directives::Directive::navigation_response_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-navigation-response-check
# 6. A navigation response check, which takes a request, a navigation type string ("form-submission" or "other"),
#    a response, a navigable, a check type string ("source" or "response"), and a policy as arguments, and is
#    executed during § 4.2.5 Should navigation response to navigation request of type in target be blocked by
#    Content Security Policy?. It returns "Allowed" unless otherwise specified.
pub func content_security_policy_directive_navigation_response_check_impl(this: ContentSecurityPolicyDirective*, arg0: FetchRequest*, arg1: ContentSecurityPolicyNavigationType, arg2: FetchResponse*, arg3: HtmlNavigable*, arg4: ContentSecurityPolicyDirectiveCheckType, arg5: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:92 Web::ContentSecurityPolicy::Directives::Directive::webrtc_pre_connect_check (virtual).
# https://w3c.github.io/webappsec-csp/#directive-webrtc-pre-connect-check
# 7. A webrtc pre-connect check, which takes a policy, and is executed during § 4.3.1 Should RTC connections be
#    blocked for global?. It returns "Allowed" unless otherwise specified.
pub func content_security_policy_directive_webrtc_pre_connect_check_impl(this: ContentSecurityPolicyDirective*, arg0: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    return ContentSecurityPolicyResult.allowed

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:94 Web::ContentSecurityPolicy::Directives::Directive::name.
pub func content_security_policy_directive_name(this: ContentSecurityPolicyDirective*) -> ak.String:
    return this.m_name

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/Directive.h:95 Web::ContentSecurityPolicy::Directives::Directive::value.
## (A copy of the Vector struct: its buffer is shared, and no caller changes it.)
pub func content_security_policy_directive_value(this: ContentSecurityPolicyDirective*) -> ak.Vector[ak.String]:
    return this.m_value
