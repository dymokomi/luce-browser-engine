## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/FormActionDirective.cpp:16 Web::ContentSecurityPolicy::Directives::FormActionDirective::FormActionDirective.
func content_security_policy_form_action_directive_construct(this: ContentSecurityPolicyFormActionDirective*, name: ak.String, value: ak.Vector[ak.String]):
    content_security_policy_directive_construct(this.content_security_policy_directive(), name, value)

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/FormActionDirective.cpp:21 Web::ContentSecurityPolicy::Directives::FormActionDirective::pre_navigation_check (override).
pub func content_security_policy_form_action_directive_pre_navigation_check_impl(base: ContentSecurityPolicyDirective*, request: FetchRequest*, navigation_type: ContentSecurityPolicyNavigationType, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    # 1. Assert: policy is unused in this algorithm.
    # FIXME: File spec issue, because this is not the case. The policy is required to resolve 'self'.

    # 2. If navigation type is "form-submission":
    if navigation_type == ContentSecurityPolicyNavigationType.form_submission:
        # 1. If the result of executing § 6.7.2.5 Does request match source list? on request, this directive’s value,
        #    and a policy, is "Does Not Match", return "Blocked".
        if content_security_policy_directives_does_request_match_source_list(request, &base.m_value, policy) == ContentSecurityPolicyDirectivesMatchResult.does_not_match:
            return ContentSecurityPolicyResult.blocked

    # 3. Return "Allowed".
    return ContentSecurityPolicyResult.allowed
