#==============================================================================================
#
#   keyword_trusted_types - KeywordTrustedTypes: the trusted-types keywords
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ContentSecurityPolicy/Directives/KeywordTrustedTypes.cpp (lines 1-16) with
#       KeywordTrustedTypes.h's ENUMERATE_KEYWORD_TRUSTED_TYPES. C++ initializes the FlyStrings statically; here
#       content_security_policy_directives_keyword_trusted_types_initialize_strings interns them at run time and
#       web_initialize_strings runs it at startup (DESIGN.md §2.6).
#
#       Copyright (c) 2025, Miguel Sacristán Izcue <miguel_tete17@hotmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Whether content_security_policy_directives_keyword_trusted_types_initialize_strings has run.
var content_security_policy_directives_keyword_trusted_types_strings_initialized: bool

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/KeywordTrustedTypes.cpp:11 the definitions of
## Web::ContentSecurityPolicy::Directives::KeywordTrustedTypes's FlyStrings (`FlyString name = value##_fly_string;` for each ENUMERATE_KEYWORD_TRUSTED_TYPES entry).
pub func content_security_policy_directives_keyword_trusted_types_initialize_strings():
    if content_security_policy_directives_keyword_trusted_types_strings_initialized:
        return
    content_security_policy_directives_keyword_trusted_types_allow_duplicates = ak.fly_string_from_str("'allow-duplicates'")
    content_security_policy_directives_keyword_trusted_types_none = ak.fly_string_from_str("'none'")
    content_security_policy_directives_keyword_trusted_types_wild_card = ak.fly_string_from_str("*")
    content_security_policy_directives_keyword_trusted_types_strings_initialized = true
