## Ported from Libraries/LibWeb/ContentSecurityPolicy/Directives/DirectiveFactory.cpp:38 Web::ContentSecurityPolicy::Directives::create_directive.
pub func content_security_policy_directives_create_directive(heap: gc.Heap*, name: ak.String, value: ak.Vector[ak.String]) -> ContentSecurityPolicyDirective*:
    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_base_uri):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_base_uri_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_child_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_child_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_connect_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_connect_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_default_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_default_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_font_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_font_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_form_action):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_form_action_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_frame_ancestors):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_frame_ancestors_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_frame_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_frame_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_img_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_image_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_manifest_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_manifest_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_media_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_media_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_object_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_object_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_report_to):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_report_to_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_report_uri):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_report_uri_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_require_trusted_types_for):
        return (ContentSecurityPolicyDirective*)heap_allocate_trusted_types_require_trusted_types_for_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_sandbox):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_sandbox_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_script_src_attr):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_script_source_attribute_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_script_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_script_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_script_src_elem):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_script_source_element_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_style_src_attr):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_style_source_attribute_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_style_src):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_style_source_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_style_src_elem):
        return (ContentSecurityPolicyDirective*)heap_allocate_content_security_policy_style_source_element_directive(heap, name, value)

    if ak.string_eq_fly_string(&name, &content_security_policy_directives_names_web_rtc):
