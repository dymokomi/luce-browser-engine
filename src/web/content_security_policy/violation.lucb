#==============================================================================================
#
#   violation - ContentSecurityPolicy::Violation: creating a violation for a global object or a
#   request, its URL, the blocked URI, the deprecated serialization and reporting it
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ContentSecurityPolicy/Violation.cpp (lines 1-476) and the
#       inline functions of Violation.h (lines 43-81). Reporting fires a
#       securitypolicyviolation event in a queued task and, for a report-uri directive, fetches
#       the deprecated serialization (Fetch::Fetching::fetch, region p2c).
#
#       Copyright (c) 2025, Luke Wilde <luke@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Violation.cpp:29 Web::ContentSecurityPolicy::Violation::Violation.
func content_security_policy_violation_construct(this: ContentSecurityPolicyViolation*, global_object: JsObject*?, policy: ContentSecurityPolicyPolicy*, directive: ak.String):
    # The default member initializers: no status, resource or referrer yet, line and column 0 (the empty sample is
    # the zeroed cell's).
    this.m_status = 0
    this.m_resource = ContentSecurityPolicyViolationResourceType.empty
    this.m_line_number = 0
    this.m_column_number = 0

    this.m_global_object = global_object
    this.m_policy = policy
    this.m_effective_directive = directive

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Violation.cpp:37 Web::ContentSecurityPolicy::Violation::create_a_violation_object_for_global_policy_and_directive.
# https://w3c.github.io/webappsec-csp/#create-violation-for-global
pub func content_security_policy_violation_create_a_violation_object_for_global_policy_and_directive(realm: Realm*, global_object: JsObject*?, policy: ContentSecurityPolicyPolicy*, directive: ak.String) -> ContentSecurityPolicyViolation*:
    # 1. Let violation be a new violation whose global object is global, policy is policy, effective directive is
    #    directive, and resource is null.
    let violation = realm_create_content_security_policy_violation(realm, global_object, policy, directive)

    # FIXME: 2. If the user agent is currently executing script, and can extract a source file’s URL, line number,
    #           and column number from the global, set violation’s source file, line number, and column number
    #           accordingly.
    # SPEC ISSUE 1:  Is this kind of thing specified anywhere? I didn’t see anything that looked useful in [ECMA262].

    # 3. If global is a Window object, set violation’s referrer to global’s document's referrer.
    if let global = global_object:
        if let window = as_if_html_window((gc.Cell*)global):
            let referrer = dom_document_referrer(html_window_associated_document(window))
            violation.m_referrer = web_url.parser_basic_parse(ak.string_bytes_as_string_view(&referrer))

    # FIXME: 4. Set violation’s status to the HTTP status code for the resource associated with violation’s global object.
    # SPEC ISSUE 2: How, exactly, do we get the status code? We don’t actually store it anywhere.

    # 5. Return violation.
    return violation

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Violation.cpp:62 Web::ContentSecurityPolicy::Violation::create_a_violation_object_for_request_and_policy.
# https://w3c.github.io/webappsec-csp/#create-violation-for-request
pub func content_security_policy_violation_create_a_violation_object_for_request_and_policy(realm: Realm*, request: FetchRequest*, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyViolation*:
    # 1. Let directive be the result of executing § 6.8.1 Get the effective directive for request on request.
    let directive = content_security_policy_directives_get_the_effective_directive_for_request(request)

    # NOTE: The spec assumes that the effective directive of a Violation is a non-empty string.
    #       See the definition of m_effective_directive.
    let directive_name = directive else trap("VERIFY: directive.has_value()")

    # 2. Let violation be the result of executing § 2.4.1 Create a violation object for global, policy, and directive
    #      on request’s client’s global object, policy, and directive.
    let client = fetch_request_client(request) else trap("VERIFY: the request has a client")
    let violation = content_security_policy_violation_create_a_violation_object_for_global_policy_and_directive(realm, html_environment_settings_object_global_object(client), policy, ak.fly_string_to_string_const(&directive_name))

    # 3. Set violation’s resource to request’s url.
    # Spec Note: We use request’s url, and not its current url, as the latter might contain information about redirect
    #            targets to which the page MUST NOT be given access.
    violation.m_resource = ContentSecurityPolicyViolationResourceType.url(fetch_request_url(request))

    # 4. Return violation.
    return violation

## Ported from Libraries/LibWeb/ContentSecurityPolicy/Violation.cpp:84 Web::ContentSecurityPolicy::Violation::visit_edges (override).
pub func content_security_policy_violation_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (ContentSecurityPolicyViolation*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_global_object)
    gc.cell_visitor_visit_cell_2(visitor, this.m_policy.cell())
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_element)

