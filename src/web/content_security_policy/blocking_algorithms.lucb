#==============================================================================================
#
#   blocking_algorithms - ContentSecurityPolicy's checks for inline behavior and <base>
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp lines 398-464
#       (should_elements_inline_type_behavior_be_blocked_by_content_security_policy) and
#       694-738 (is_base_allowed_for_document), taken by region r28: a connected <style>, any
#       element with an event handler content attribute and a <base href> reach them in phase
#       1. Both loop over the global object's CSP list, which is empty until phase 2 parses
#       policies, so they answer "Allowed"; what a Policy, a Directive or a Violation does is a
#       phase-2 closure stub. The request and response checks of the file are phase 2.
#
#       Copyright (c) 2024-2025, Luke Wilde <luke@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp:399 Web::ContentSecurityPolicy::should_elements_inline_type_behavior_be_blocked_by_content_security_policy.
# https://w3c.github.io/webappsec-csp/#should-block-inline
pub func content_security_policy_should_elements_inline_type_behavior_be_blocked_by_content_security_policy(realm: Realm*, element: DomElement*, type_: ContentSecurityPolicyInlineType, source: ak.String) -> ContentSecurityPolicyResult:
    # Spec Note: The valid values for type are "script", "script attribute", "style", and "style attribute".
    assert(type_ == ContentSecurityPolicyInlineType.script or type_ == ContentSecurityPolicyInlineType.script_attribute or type_ == ContentSecurityPolicyInlineType.style or type_ == ContentSecurityPolicyInlineType.style_attribute)

    # 1. Assert: element is not null.
    # NOTE: Already done by only accepting a GC::Ref.

    # 2. Let result be "Allowed".
    var result = ContentSecurityPolicyResult.allowed

    # 3. For each policy of element’s Document's global object’s CSP list:
    let global_object = realm_global_object(bind_platform_object_realm(dom_node_document(element.dom_node()).bind_platform_object()))
    let csp_list = content_security_policy_policy_list_from_object(global_object) else trap("VERIFY: the global object has a CSP list")

    var policies = content_security_policy_policy_list_policies(csp_list)
    for policy in ak.vector_span(&policies):
        # 1. For each directive of policy’s directive set:
        var directives = content_security_policy_policy_directives(policy)
        for directive in ak.vector_span(&directives):
            # 1. If directive’s inline check returns "Allowed" when executed upon element, type, policy and source,
            #    skip to the next directive.
            if content_security_policy_directive_inline_check(directive, realm_heap(realm), element, type_, policy, source) == ContentSecurityPolicyResult.allowed:
                continue

            # 2. Let directive-name be the result of executing § 6.8.2 Get the effective directive for inline checks
            #    on type.
            let directive_name = content_security_policy_directives_get_the_effective_directive_for_inline_checks(type_)

            # 3. Otherwise, let violation be the result of executing § 2.4.1 Create a violation object for global,
            #   policy, and directive on the current settings object’s global object, policy, and directive-name.
            # FIXME: File spec issue about using "current settings object" here, as it can run outside of a script
            #        context (for example, a just parsed inline script being prepared)
            let violation = content_security_policy_violation_create_a_violation_object_for_global_policy_and_directive(realm, global_object, policy, ak.fly_string_to_string_const(&directive_name))

            # 4. Set violation’s resource to "inline".
            content_security_policy_violation_set_resource(violation, ContentSecurityPolicyViolationResourceType.resource(ContentSecurityPolicyViolationResource.inline_))

            # 5. Set violation’s element to element.
            content_security_policy_violation_set_element(violation, element)

            # 6. If directive’s value contains the expression "'report-sample'", then set violation’s sample to the
            #    substring of source containing its first 40 characters.
            # FIXME: Should this be case insensitive?
            var maybe_report_sample = false
            var values = content_security_policy_directive_value(directive)
            for directive_value in ak.vector_span(&values):
                # (Directives::KeywordSources::ReportSample)
                if ak.string_equals_ignoring_ascii_case_string_view(&directive_value, ak.sv("'report-sample'")):
                    maybe_report_sample = true
                    break

            if maybe_report_sample:
                var source_view: ak.Utf8View = ---
                ak.utf8_view_construct_string_view(&source_view, ak.string_bytes_as_string_view(&source))
                let length = ak.utf8_view_length(&source_view)
                let sample = ak.utf8_view_unicode_substring_view_usize(&source_view, 0, length if length < 40 else 40)
                let sample_view = ak.utf8_view_as_string(&sample)
                content_security_policy_violation_set_sample(violation, ak.string_from_utf8_without_validation(ak.string_view_bytes(&sample_view)))

            # 7. Execute § 5.5 Report a violation on violation.
            content_security_policy_violation_report_a_violation(violation, realm)

            # 8. If policy’s disposition is "enforce", then set result to "Blocked".
            if content_security_policy_policy_disposition(policy) == ContentSecurityPolicyPolicyDisposition.enforce:
                result = ContentSecurityPolicyResult.blocked

    # 4. Return result.
    return result

## Ported from Libraries/LibWeb/ContentSecurityPolicy/BlockingAlgorithms.cpp:695 Web::ContentSecurityPolicy::is_base_allowed_for_document.
# https://w3c.github.io/webappsec-csp/#allow-base-for-document
pub func content_security_policy_is_base_allowed_for_document(realm: Realm*, base: web_url.Url, document: DomDocument*) -> ContentSecurityPolicyResult:
    # 1. For each policy of document’s global object’s csp list:
    let csp_list = content_security_policy_policy_list_from_object(realm_global_object(bind_platform_object_realm(document.bind_platform_object()))) else trap("VERIFY: the global object has a CSP list")
    var policies = content_security_policy_policy_list_policies(csp_list)
    for policy in ak.vector_span(&policies):
        # 1. Let source list be null.
        # NOTE: Not necessary.

        # 2. If a directive whose name is "base-uri" is present in policy’s directive set, set source list to that
        #    directive’s value.
        var maybe_base_uri: ContentSecurityPolicyDirective*? = none
        var directives = content_security_policy_policy_directives(policy)
        for directive in ak.vector_span(&directives):
            # (Directives::Names::BaseUri)
            let name = content_security_policy_directive_name(directive)
            if ak.fly_string_eq_string_view(&name, ak.sv("base-uri")):
                maybe_base_uri = directive
                break

        # 3. If source list is null, skip to the next policy.
        let base_uri = maybe_base_uri else continue

        let source_list = content_security_policy_directive_value(base_uri)

        # 4. If the result of executing § 6.7.2.7 Does url match source list in origin with redirect count? on base,
        #    source list, policy’s self-origin, and 0 is "Does Not Match":
        # Spec Note: We compare against the fallback base URL in order to deal correctly with things like an iframe
        #            srcdoc Document which has been sandboxed into an opaque origin.
        if content_security_policy_directives_does_url_match_source_list_in_origin_with_redirect_count(base, &source_list, content_security_policy_policy_self_origin(policy), 0) == ContentSecurityPolicyDirectivesMatchResult.does_not_match:
            # 1. Let violation be the result of executing § 2.4.1 Create a violation object for global, policy, and
            #    directive on document’s global object, policy, and "base-uri".
            let base_uri_string = ak.string_from_str("base-uri")
            let violation = content_security_policy_violation_create_a_violation_object_for_global_policy_and_directive(realm, (JsObject*?)dom_document_window(document), policy, base_uri_string)

            # 2. Set violation’s resource to "inline".
            content_security_policy_violation_set_resource(violation, ContentSecurityPolicyViolationResourceType.resource(ContentSecurityPolicyViolationResource.inline_))

            # 3. Execute § 5.5 Report a violation on violation.
            content_security_policy_violation_report_a_violation(violation, realm)

            # 4. If policy’s disposition is "enforce", return "Blocked".
            if content_security_policy_policy_disposition(policy) == ContentSecurityPolicyPolicyDisposition.enforce:
                return ContentSecurityPolicyResult.blocked

    # 2. Return "Allowed".
    return ContentSecurityPolicyResult.allowed
