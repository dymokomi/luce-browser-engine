#   types_dom_rect_read_only - declarations of Libraries/LibWeb/Geometry/DOMRectReadOnly.h
#
#   DESCRIPTION:
#       Generated opaque by the skeleton generator (Geometry is outside the phase-1 closure);
#       filled by hand by region r55, whose SVGAnimatedRect (an <svg>'s viewBox) creates
#       DOMRects when every SVGSVGElement is initialized. Like the phase-1 stand-ins of LibJS's
#       objects (DESIGN.md §3.6), the class has no class id of its own: it shares
#       PlatformObject's and is recognized by its ClassInfo. The Serializable mixin
#       (structured serialization) is phase 3.
#
#==============================================================================================

