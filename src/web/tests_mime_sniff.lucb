## Ported from TestMimeSniff.cpp:64 set_text_plain_type_mappings.
let mime_test_text_plain_type_mappings: MimeSniffCase[4] = [
    MimeSniffCase(mime_type = "text/plain", header = b"\xFE\xFF\x00\x00"),
    MimeSniffCase(mime_type = "text/plain", header = b"\xFF\xFE\x00\x00"),
    MimeSniffCase(mime_type = "text/plain", header = b"\xEF\xBB\xBF\x00"),
    MimeSniffCase(mime_type = "text/plain", header = b"Hello world!"),
]

## The octet-stream row most tests add.
let mime_test_octet_stream: MimeSniffCase = MimeSniffCase(mime_type = "application/octet-stream", header = b"\x00")

## Checks that sniffing each row's header in `context` gives the row's essence.
func mime_test_expect_essences(cases: const MimeSniffCase[], context: MimeSniffingContext):
    for row in cases:
        let computed_mime_type = mime_resource_sniff(row.header, mime_test_context(context))
        mime_test_expect(row.mime_type, mime_type_essence(&computed_mime_type))

## Checks that sniffing each row's header in `context` serializes as the row's type.
func mime_test_expect_serialized(cases: const MimeSniffCase[], context: MimeSniffingContext):
    for row in cases:
        let computed_mime_type = mime_resource_sniff(row.header, mime_test_context(context))
        mime_test_expect(row.mime_type, mime_type_serialized(&computed_mime_type))

# mark: TestMimeSniff.cpp =======================================================================

test "MimeSniff: determine_computed_mime_type_given_no_sniff_is_set":
    let mime_type = mime_test_create("text", "html")
    var computed_mime_type = mime_resource_sniff(b"\x00", MimeSniffingConfiguration(supplied_type = mime_type, no_sniff = true))

    mime_test_expect("text/html", mime_type_serialized(&computed_mime_type))

    # Cover the edge case in the context-specific sniffing algorithm.
    computed_mime_type = mime_resource_sniff(b"\x00", MimeSniffingConfiguration(
        sniffing_context = MimeSniffingContext.image,
        supplied_type = mime_type,
        no_sniff = true,
    ))

    mime_test_expect("text/html", mime_type_serialized(&computed_mime_type))

test "MimeSniff: determine_computed_mime_type_given_no_sniff_is_unset":
    let supplied_type = mime_test_create("application", "x-this-is-a-test")
    let computed_mime_type = mime_resource_sniff(b"\x00", MimeSniffingConfiguration(supplied_type = supplied_type))

    mime_test_expect("application/x-this-is-a-test", mime_type_serialized(&computed_mime_type))

test "MimeSniff: determine_computed_mime_type_given_xml_mime_type_as_supplied_type":
    let xml_mime_type = "application/rss+xml"
    let supplied_type = mime_test_parse(xml_mime_type)
    let computed_mime_type = mime_resource_sniff(b"\x00", MimeSniffingConfiguration(supplied_type = supplied_type))

    mime_test_expect(xml_mime_type, mime_type_serialized(&computed_mime_type))

test "MimeSniff: determine_computed_mime_type_given_supplied_type_that_is_an_apache_bug_mime_type":
    let apache_bug_mime_types: str[4] = [
        "text/plain",
        "text/plain; charset=ISO-8859-1",
        "text/plain; charset=iso-8859-1",
        "text/plain; charset=UTF-8",
    ]

    # Cover all Apache bug MIME types.
    for apache_bug_mime_type in apache_bug_mime_types:
        let supplied_type = mime_test_parse(apache_bug_mime_type)
        let computed_mime_type = mime_resource_sniff(b"Hello world!",
                                                     MimeSniffingConfiguration(scheme = ak.sv("http"), supplied_type = supplied_type))

        mime_test_expect("text/plain", mime_type_serialized(&computed_mime_type))

    # Cover all code paths in "rules for distinguishing if a resource is text or binary".
    let supplied_type = mime_test_create("text", "plain")
    var cases: MimeSniffCase[5] = ---
    cases[0] = mime_test_octet_stream
    for i in 0..<4:
        cases[i + 1] = mime_test_text_plain_type_mappings[i]
    for row in cases:
        let computed_mime_type = mime_resource_sniff(row.header,
                                                     MimeSniffingConfiguration(scheme = ak.sv("http"), supplied_type = supplied_type))

        mime_test_expect(row.mime_type, mime_type_serialized(&computed_mime_type))

test "MimeSniff: determine_computed_mime_type_given_xml_or_html_supplied_type":
    # With HTML supplied type.
    var config = MimeSniffingConfiguration(supplied_type = mime_test_create("text", "html"))
    var computed_mime_type = mime_resource_sniff(b"", config)
    mime_test_expect("text/html", mime_type_serialized(&computed_mime_type))

    # With XML supplied type.
    config = MimeSniffingConfiguration(supplied_type = mime_test_create("text", "xml"))
    computed_mime_type = mime_resource_sniff(b"", config)
    mime_test_expect("text/xml", mime_type_serialized(&computed_mime_type))

