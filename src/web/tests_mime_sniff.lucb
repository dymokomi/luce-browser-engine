#==============================================================================================
#
#   tests_mime_sniff - MIME type parsing and sniffing
#
#   DESCRIPTION:
#       Port of Tests/LibWeb/TestMimeSniff.cpp (lines 1-499), plus parsing and serialization
#       cases pinned to the donor (MimeType::parse, serialized, the classification predicates).
#       The C++ HashMap<StringView, Vector<StringView>> tables are arrays of (expected type,
#       header) rows; their iteration order does not matter to the checks.
#
#==============================================================================================

# mark: Helpers =================================================================================

## A header and the MIME type sniffing it must give.
struct MimeSniffCase:
    var mime_type: str
    var header: const u8[]

## `MimeType::create(type, subtype)` from two literals.
func mime_test_create(type_: str, subtype: str) -> MimeType:
    return mime_type_create(ak.string_from_str(type_), ak.string_from_str(subtype))

## `MimeType::parse(string).release_value()`.
func mime_test_parse(string: str) -> MimeType:
    return mime_type_parse(ak.sv(string)) else trap("MimeType::parse failed")

## `EXPECT_EQ(expected, string)` for a String.
func mime_test_expect(expected: str, string: ak.String):
    let view = ak.string_bytes_as_string_view(&string)
    if not ak.string_view_equals(&view, expected):
        print(f"expected \"{expected}\", got \"{(str)ak.string_view_bytes(&view)}\"")
        assert(false)

## A configuration with a sniffing context.
func mime_test_context(context: MimeSniffingContext) -> MimeSniffingConfiguration:
    return MimeSniffingConfiguration(sniffing_context = context)

## Ported from TestMimeSniff.cpp:44 set_image_type_mappings.
let mime_test_image_type_mappings: MimeSniffCase[7] = [
    MimeSniffCase(mime_type = "image/x-icon", header = b"\x00\x00\x01\x00"),
    MimeSniffCase(mime_type = "image/x-icon", header = b"\x00\x00\x02\x00"),
    MimeSniffCase(mime_type = "image/bmp", header = b"BM"),
    MimeSniffCase(mime_type = "image/gif", header = b"GIF87a"),
    MimeSniffCase(mime_type = "image/gif", header = b"GIF89a"),
    MimeSniffCase(mime_type = "image/webp", header = b"RIFF\x00\x00\x00\x00WEBPVP"),
    MimeSniffCase(mime_type = "image/png", header = b"\x89PNG\x0D\x0A\x1A\x0A"),
]

## The JPEG row of set_image_type_mappings (kept apart so the table above stays one line a row).
let mime_test_jpeg_mapping: MimeSniffCase = MimeSniffCase(mime_type = "image/jpeg", header = b"\xFF\xD8\xFF")

## Ported from TestMimeSniff.cpp:54 set_audio_or_video_type_mappings.
let mime_test_audio_or_video_type_mappings: MimeSniffCase[6] = [
    MimeSniffCase(mime_type = "audio/aiff", header = b"FORM\x00\x00\x00\x00\x41IFF"),
    MimeSniffCase(mime_type = "audio/mpeg", header = b"ID3"),
    MimeSniffCase(mime_type = "application/ogg", header = b"OggS\x00"),
    MimeSniffCase(mime_type = "audio/midi", header = b"MThd\x00\x00\x00\x06"),
    MimeSniffCase(mime_type = "video/avi", header = b"RIFF\x00\x00\x00\x00\x41\x56\x49\x20"),
