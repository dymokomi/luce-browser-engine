## Ported from MouseEvent.h:60 Web::UIEvents::MouseEvent::platform_ctrl_key: Meta on macOS, Control elsewhere.
pub func ui_events_mouse_event_platform_ctrl_key(this: UiEventsMouseEvent*) -> bool:
    if os.macos:
        return ui_events_mouse_event_meta_key(this)
    return ui_events_mouse_event_ctrl_key(this)

