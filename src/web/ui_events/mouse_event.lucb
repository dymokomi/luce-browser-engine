# mark: Button codes ============================================================================

## Ported from MouseButton.h:27 Web::UIEvents::mouse_button_to_button_code.
## https://w3c.github.io/pointerevents/#the-button-property
pub func ui_events_mouse_button_to_button_code(button: UiEventsMouseButton) -> i16:
    return match button:
        .none_ => -1
        .primary => 0
        .middle => 1
        .secondary => 2
        .backward => 3
        .forward => 4
        _ => trap("VERIFY_NOT_REACHED")

## Ported from MouseButton.h:48 Web::UIEvents::button_code_to_mouse_button.
## https://w3c.github.io/pointerevents/#the-button-property
pub func ui_events_button_code_to_mouse_button(button: i16) -> UiEventsMouseButton:
    if button == 0:
        return UiEventsMouseButton.primary
    if button == 1:
        return UiEventsMouseButton.middle
    if button == 2:
        return UiEventsMouseButton.secondary
    if button == 3:
        return UiEventsMouseButton.backward
    if button == 4:
        return UiEventsMouseButton.forward
    return UiEventsMouseButton.none_

## `modifiers & flag`, as a bool.
func ui_events_has_modifier(modifiers: u32, flag: UiEventsKeyModifier) -> bool:
    return (modifiers & (u32)flag) != 0

# mark: Construction ============================================================================

## Ported from MouseEvent.cpp:24 Web::UIEvents::MouseEvent::MouseEvent.
pub func ui_events_mouse_event_construct(this: UiEventsMouseEvent*, realm: Realm*, event_name: ak.FlyString, event_init: UiEventsMouseEventInit, page_x: f64, page_y: f64, offset_x: f64, offset_y: f64):
    let modifier_init = event_init.event_modifier_init
    ui_events_ui_event_construct_ui_event_init(this.ui_events_ui_event(), realm, event_name, modifier_init.ui_event_init)
    this.m_screen_x = event_init.screen_x
    this.m_screen_y = event_init.screen_y
    this.m_page_x = page_x
    this.m_page_y = page_y
    this.m_client_x = event_init.client_x
    this.m_client_y = event_init.client_y
    this.m_offset_x = offset_x
    this.m_offset_y = offset_y
    this.m_ctrl_key = modifier_init.ctrl_key
    this.m_shift_key = modifier_init.shift_key
    this.m_alt_key = modifier_init.alt_key
    this.m_meta_key = modifier_init.meta_key
    this.m_modifier_alt_graph = modifier_init.modifier_alt_graph
    this.m_modifier_caps_lock = modifier_init.modifier_caps_lock
    this.m_modifier_fn = modifier_init.modifier_fn
    this.m_modifier_fn_lock = modifier_init.modifier_fn_lock
    this.m_modifier_hyper = modifier_init.modifier_hyper
    this.m_modifier_num_lock = modifier_init.modifier_num_lock
    this.m_modifier_scroll_lock = modifier_init.modifier_scroll_lock
    this.m_modifier_super = modifier_init.modifier_super
    this.m_modifier_symbol = modifier_init.modifier_symbol
    this.m_modifier_symbol_lock = modifier_init.modifier_symbol_lock
    this.m_movement_x = event_init.movement_x
    this.m_movement_y = event_init.movement_y
    this.m_button = event_init.button
    this.m_buttons = event_init.buttons
    this.m_related_target = event_init.related_target

## Ported from MouseEvent.cpp:57 Web::UIEvents::MouseEvent::initialize (override).
pub func ui_events_mouse_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.mouse_event)
    ui_events_ui_event_initialize_impl(base, realm)

## Ported from MouseEvent.cpp:63 Web::UIEvents::MouseEvent::visit_edges (override).
pub func ui_events_mouse_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (UiEventsMouseEvent*)base
    ui_events_ui_event_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_related_target)

## Ported from MouseEvent.h:120 Web::UIEvents::MouseEvent::is_mouse_event (override).
pub func ui_events_mouse_event_is_mouse_event_impl(this: DomEvent*) -> bool:
    return true

## Ported from MouseEvent.cpp:146 Web::UIEvents::MouseEvent::create.
pub func ui_events_mouse_event_create(realm: Realm*, event_name: ak.FlyString, event_init: UiEventsMouseEventInit = UiEventsMouseEventInit(), page_x: f64 = 0.0, page_y: f64 = 0.0, offset_x: f64 = 0.0, offset_y: f64 = 0.0) -> UiEventsMouseEvent*:
    return realm_create_ui_events_mouse_event(realm, realm, event_name, event_init, page_x, page_y, offset_x, offset_y)

## Ported from MouseEvent.cpp:151 Web::UIEvents::MouseEvent::construct_impl.
pub func ui_events_mouse_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: UiEventsMouseEventInit) -> UiEventsMouseEvent*!:
    # https://drafts.csswg.org/cssom-view/#dom-mouseevent-pagex
    # For a newly constructed event, pageX/pageY default to clientX/clientY (scrollX/scrollY are 0).
    # https://drafts.csswg.org/cssom-view/#dom-mouseevent-offsetx
    # For a newly constructed event with no target, offsetX/offsetY default to clientX/clientY.
    return ui_events_mouse_event_create(realm, event_name, event_init, event_init.client_x, event_init.client_y, event_init.client_x, event_init.client_y)

## Ported from MouseEvent.cpp:198 Web::UIEvents::MouseEvent::create_from_platform_event.
pub func ui_events_mouse_event_create_from_platform_event(realm: Realm*, window_proxy: HtmlWindowProxy*?, event_name: ak.FlyString, screen: gfx.CssPixelPoint, page: gfx.CssPixelPoint, client: gfx.CssPixelPoint, offset: gfx.CssPixelPoint, movement: gfx.CssPixelPoint?, button: u32, buttons: u32, modifiers: u32, detail: i32 = 0) -> UiEventsMouseEvent*!:
    var event_init = UiEventsMouseEventInit()
    event_init.event_modifier_init.ui_event_init.detail = detail
    event_init.event_modifier_init.ctrl_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_ctrl)
    event_init.event_modifier_init.shift_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_shift)
    event_init.event_modifier_init.alt_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_alt)
    event_init.event_modifier_init.meta_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_super)
    event_init.screen_x = ui_events_css_x(&screen)
    event_init.screen_y = ui_events_css_y(&screen)
    event_init.client_x = ui_events_css_x(&client)
    event_init.client_y = ui_events_css_y(&client)
    event_init.event_modifier_init.ui_event_init.view = window_proxy
    if let moved = movement:
        event_init.movement_x = ui_events_css_x(&moved)
        event_init.movement_y = ui_events_css_y(&moved)
    event_init.button = ui_events_mouse_button_to_button_code((UiEventsMouseButton)(u8)button)
    event_init.buttons = (u16)buttons
    let event = ui_events_mouse_event_create(realm, event_name, event_init, ui_events_css_x(&page), ui_events_css_y(&page), ui_events_css_x(&offset), ui_events_css_y(&offset))
    dom_event_set_is_trusted(event.dom_event(), true)
    dom_event_set_bubbles(event.dom_event(), true)
    dom_event_set_cancelable(event.dom_event(), true)
    dom_event_set_composed(event.dom_event(), true)
    return event

## `point.x().to_double()`.
pub func ui_events_css_x(point: const gfx.CssPixelPoint*) -> f64:
    let x = gfx.css_pixel_point_x(point)
    return gfx.css_pixels_to_double_const(&x)

## `point.y().to_double()`.
pub func ui_events_css_y(point: const gfx.CssPixelPoint*) -> f64:
    let y = gfx.css_pixel_point_y(point)
    return gfx.css_pixels_to_double_const(&y)

# mark: Accessors ===============================================================================

## The coordinate as an untrusted event reports it: `is_trusted() ? value : AK::floor(value)`.
func ui_events_mouse_event_trusted_or_floor(this: UiEventsMouseEvent*, value: f64) -> f64:
    return value if dom_event_is_trusted(this.dom_event()) else math.floor(value)

