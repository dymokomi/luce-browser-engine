## Ported from MouseEvent.cpp:69 Web::UIEvents::MouseEvent::get_modifier_state.
pub func ui_events_mouse_event_get_modifier_state(this: UiEventsMouseEvent*, key_arg: const ak.String*) -> bool:
    if ak.string_eq_string_view(key_arg, ak.sv("Control")): return this.m_ctrl_key
    if ak.string_eq_string_view(key_arg, ak.sv("Shift")): return this.m_shift_key
    if ak.string_eq_string_view(key_arg, ak.sv("Alt")): return this.m_alt_key
    if ak.string_eq_string_view(key_arg, ak.sv("Meta")): return this.m_meta_key
    if ak.string_eq_string_view(key_arg, ak.sv("AltGraph")): return this.m_modifier_alt_graph
    if ak.string_eq_string_view(key_arg, ak.sv("CapsLock")): return this.m_modifier_caps_lock
    if ak.string_eq_string_view(key_arg, ak.sv("Fn")): return this.m_modifier_fn
    if ak.string_eq_string_view(key_arg, ak.sv("FnLock")): return this.m_modifier_fn_lock
    if ak.string_eq_string_view(key_arg, ak.sv("Hyper")): return this.m_modifier_hyper
    if ak.string_eq_string_view(key_arg, ak.sv("NumLock")): return this.m_modifier_num_lock
    if ak.string_eq_string_view(key_arg, ak.sv("ScrollLock")): return this.m_modifier_scroll_lock
    if ak.string_eq_string_view(key_arg, ak.sv("Super")): return this.m_modifier_super
    if ak.string_eq_string_view(key_arg, ak.sv("Symbol")): return this.m_modifier_symbol
    if ak.string_eq_string_view(key_arg, ak.sv("SymbolLock")): return this.m_modifier_symbol_lock
    return false

## Ported from MouseEvent.cpp:105 Web::UIEvents::MouseEvent::init_mouse_event.
## https://w3c.github.io/uievents/#dom-mouseevent-initmouseevent
pub func ui_events_mouse_event_init_mouse_event(this: UiEventsMouseEvent*, type_: ak.String, bubbles: bool, cancelable: bool, view: HtmlWindowProxy*?, detail: i32, screen_x: i32, screen_y: i32, client_x: i32, client_y: i32,
                                                ctrl_key: bool, alt_key: bool, shift_key: bool, meta_key: bool, button: i16, related_target: DomEventTarget*?):
    # Initializes attributes of a MouseEvent object. This method has the same behavior as UIEvent.initUIEvent().

    # 1. If this’s dispatch flag is set, then return.
    if dom_event_dispatched(this.dom_event()):
        return

    # 2. Initialize this with type, bubbles, and cancelable.
    dom_event_initialize_event(this.dom_event(), type_, bubbles, cancelable)

    # Implementation Defined: Initialise other values.
    this.ui_event.m_view = view
    this.ui_event.m_detail = detail
    this.m_screen_x = (f64)screen_x
    this.m_screen_y = (f64)screen_y
    this.m_client_x = (f64)client_x
    this.m_client_y = (f64)client_y
    this.m_ctrl_key = ctrl_key
    this.m_shift_key = shift_key
    this.m_alt_key = alt_key
    this.m_meta_key = meta_key
    this.m_button = button
    this.m_related_target = related_target

## Ported from MouseEvent.cpp:165 Web::UIEvents::MouseEvent::clone (virtual).
pub func ui_events_mouse_event_clone_impl(this: UiEventsMouseEvent*) -> UiEventsMouseEvent*:
    var init = UiEventsMouseEventInit()
    init.screen_x = this.m_screen_x
    init.screen_y = this.m_screen_y
    init.client_x = this.m_client_x
    init.client_y = this.m_client_y
    init.movement_x = this.m_movement_x
    init.movement_y = this.m_movement_y
    init.button = this.m_button
    init.buttons = this.m_buttons
    init.related_target = this.m_related_target
    init.event_modifier_init.ctrl_key = this.m_ctrl_key
    init.event_modifier_init.shift_key = this.m_shift_key
    init.event_modifier_init.alt_key = this.m_alt_key
    init.event_modifier_init.meta_key = this.m_meta_key
    init.event_modifier_init.modifier_alt_graph = this.m_modifier_alt_graph
    init.event_modifier_init.modifier_caps_lock = this.m_modifier_caps_lock
    init.event_modifier_init.modifier_fn = this.m_modifier_fn
    init.event_modifier_init.modifier_fn_lock = this.m_modifier_fn_lock
    init.event_modifier_init.modifier_hyper = this.m_modifier_hyper
    init.event_modifier_init.modifier_num_lock = this.m_modifier_num_lock
    init.event_modifier_init.modifier_scroll_lock = this.m_modifier_scroll_lock
    init.event_modifier_init.modifier_super = this.m_modifier_super
    init.event_modifier_init.modifier_symbol = this.m_modifier_symbol
    init.event_modifier_init.modifier_symbol_lock = this.m_modifier_symbol_lock
    init.event_modifier_init.ui_event_init.view = ui_events_ui_event_view(this.ui_events_ui_event())
    init.event_modifier_init.ui_event_init.detail = ui_events_ui_event_detail(this.ui_events_ui_event())
    return ui_events_mouse_event_create(bind_platform_object_realm(this.bind_platform_object()), dom_event_type(this.dom_event()), init, this.m_page_x, this.m_page_y, this.m_offset_x, this.m_offset_y)
