#
#   mouse_event - UIEvents::MouseEvent, and MouseButton.h's button codes
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/UIEvents/MouseEvent.cpp (lines 1-198) with MouseEvent.h's
#       inline members (the coordinate accessors, which floor the coordinates of untrusted
#       events, and the modifier keys), and of MouseButton.h's mouse_button_to_button_code and
#       button_code_to_mouse_button (lines 26-61).
