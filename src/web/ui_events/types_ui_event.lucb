## Upcast to Web::UIEvents::UIEvent (implemented by every struct in its hierarchy).
pub interface IsUiEventsUiEvent:
    func ui_events_ui_event() -> UiEventsUiEvent*

## Virtual functions introduced by Web::UIEvents::UIEvent.
pub struct UiEventsUiEventVTable:
    pub let event_vtable: DomEventVTable
    pub let which: func(UiEventsUiEvent*) -> u32 = ui_events_ui_event_which_impl

## Virtual: Web::UIEvents::UIEvent::which.
pub func ui_events_ui_event_which(this: UiEventsUiEvent*) -> u32:
    return ((const UiEventsUiEventVTable*)((gc.Cell*)this).vtable).which(this)

## The vtable of Web::UIEvents::UIEvent.
pub let ui_events_ui_event_vtable: UiEventsUiEventVTable = UiEventsUiEventVTable(event_vtable = DomEventVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &ui_events_ui_event_class, visit_edges = ui_events_ui_event_visit_edges_impl), initialize = ui_events_ui_event_initialize_impl))))

## Class information of Web::UIEvents::UIEvent: Event's class id (types_event).
pub let ui_events_ui_event_class: ak.ClassInfo = ak.ClassInfo(name = "UIEvent", first_id = 47, last_id = 47, size = memory.size_of(UiEventsUiEvent), vtable = (const void*)&ui_events_ui_event_vtable)

## is<Web::UIEvents::UIEvent>: a UIEvent or an event of one of its subclasses.
pub func is_ui_events_ui_event(event: DomEvent*) -> bool:
    let class_info = event.cell().vtable.class_info
    return class_info == &ui_events_ui_event_class or class_info == &ui_events_focus_event_class or class_info == &ui_events_keyboard_event_class or dom_event_is_mouse_event(event)

## as_if<Web::UIEvents::UIEvent>.
pub func as_if_ui_events_ui_event(event: DomEvent*) -> UiEventsUiEvent*?:
    if is_ui_events_ui_event(event): return (UiEventsUiEvent*)event
    return none

## realm.create<Web::UIEvents::UIEvent>(realm, event_name).
pub func realm_create_ui_events_ui_event(realm: Realm*, realm_: Realm*, event_name: ak.FlyString) -> UiEventsUiEvent*:
    let this = (UiEventsUiEvent*)web_allocate_cell(realm, &ui_events_ui_event_class)
    ui_events_ui_event_construct(this, realm_, event_name)
    web_initialize_cell(this.cell(), realm)
    return this

## realm.create<Web::UIEvents::UIEvent>(realm, event_name, event_init).
pub func realm_create_ui_events_ui_event_ui_event_init(realm: Realm*, realm_: Realm*, event_name: ak.FlyString, event_init: UiEventsUiEventInit) -> UiEventsUiEvent*:
    let this = (UiEventsUiEvent*)web_allocate_cell(realm, &ui_events_ui_event_class)
    ui_events_ui_event_construct_ui_event_init(this, realm_, event_name, event_init)
    web_initialize_cell(this.cell(), realm)
    return this

