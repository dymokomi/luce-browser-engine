#==============================================================================================
#
#   types_ui_event - declarations of UIEvent.h, EventModifier.h and FocusEvent.h
#
#   DESCRIPTION:
#       UIEvent and its subclasses are outside the skeleton's phase-1 closure (only the
#       dictionaries and stubs of their factories were generated); declared here by hand in the
#       generator's shape (region shell, with the browser's input). Like the other
#       hand-declared events (ToggleEvent, BeforeUnloadEvent) they have Event's class id (47),
#       so is<Event> holds for them; UIEvent and FocusEvent are recognized by their ClassInfo,
#       MouseEvent and PointerEvent by Event's is_mouse_event and is_pointer_event (their
#       fast_is), KeyboardEvent and WheelEvent by their ClassInfo.
#
#==============================================================================================

