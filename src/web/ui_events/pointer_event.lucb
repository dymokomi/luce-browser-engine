## Ported from WheelEvent.cpp:34 Web::UIEvents::WheelEvent::construct_impl.
pub func ui_events_wheel_event_construct_impl(realm: Realm*, event_name: ak.FlyString, wheel_event_init: UiEventsWheelEventInit) -> UiEventsWheelEvent*:
    let client_x = wheel_event_init.mouse_event_init.client_x
    let client_y = wheel_event_init.mouse_event_init.client_y
    return ui_events_wheel_event_create(realm, event_name, wheel_event_init, client_x, client_y, client_x, client_y)

## Ported from WheelEvent.cpp:44 Web::UIEvents::WheelEvent::create_from_platform_event.
pub func ui_events_wheel_event_create_from_platform_event(realm: Realm*, window_proxy: HtmlWindowProxy*?, event_name: ak.FlyString, screen: gfx.CssPixelPoint, page: gfx.CssPixelPoint, client: gfx.CssPixelPoint, offset: gfx.CssPixelPoint, delta_x: f64, delta_y: f64, button: u32, buttons: u32, modifiers: u32) -> UiEventsWheelEvent*!:
    var event_init = UiEventsWheelEventInit()
    event_init.mouse_event_init.event_modifier_init.ctrl_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_ctrl)
    event_init.mouse_event_init.event_modifier_init.shift_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_shift)
    event_init.mouse_event_init.event_modifier_init.alt_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_alt)
    event_init.mouse_event_init.event_modifier_init.meta_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_super)
    event_init.mouse_event_init.screen_x = ui_events_css_x(&screen)
    event_init.mouse_event_init.screen_y = ui_events_css_y(&screen)
    event_init.mouse_event_init.client_x = ui_events_css_x(&client)
    event_init.mouse_event_init.client_y = ui_events_css_y(&client)
    # (`event_init.button = button`: the unsigned platform button as the i16 code, as C++ converts it.)
    event_init.mouse_event_init.button = (i16)button
    event_init.mouse_event_init.buttons = (u16)buttons
    event_init.delta_x = delta_x
    event_init.delta_y = delta_y
    event_init.delta_mode = UiEventsWheelDeltaMode.dom_delta_pixel
    event_init.mouse_event_init.event_modifier_init.ui_event_init.view = window_proxy
    let event = ui_events_wheel_event_create(realm, event_name, event_init, ui_events_css_x(&page), ui_events_css_y(&page), ui_events_css_x(&offset), ui_events_css_y(&offset))
    dom_event_set_is_trusted(event.dom_event(), true)
    dom_event_set_bubbles(event.dom_event(), true)
    dom_event_set_cancelable(event.dom_event(), true)
    dom_event_set_composed(event.dom_event(), true)
    return event
