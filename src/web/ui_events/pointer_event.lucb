## Ported from WheelEvent.cpp:39 Web::UIEvents::WheelEvent::create.
pub func ui_events_wheel_event_create(realm: Realm*, event_name: ak.FlyString, event_init: UiEventsWheelEventInit = UiEventsWheelEventInit(), page_x: f64 = 0.0, page_y: f64 = 0.0, offset_x: f64 = 0.0, offset_y: f64 = 0.0) -> UiEventsWheelEvent*:
