## Ported from PointerEvent.cpp:36 Web::UIEvents::PointerEvent::create_from_platform_event.
pub func ui_events_pointer_event_create_from_platform_event(realm: Realm*, window_proxy: HtmlWindowProxy*?, event_name: ak.FlyString, screen: gfx.CssPixelPoint, page: gfx.CssPixelPoint, client: gfx.CssPixelPoint, offset: gfx.CssPixelPoint, movement: gfx.CssPixelPoint?, button: u32, buttons: u32, modifiers: u32) -> UiEventsPointerEvent*!:
    var event_init = UiEventsPointerEventInit()
    event_init.mouse_event_init.event_modifier_init.ctrl_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_ctrl)
    event_init.mouse_event_init.event_modifier_init.shift_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_shift)
    event_init.mouse_event_init.event_modifier_init.alt_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_alt)
    event_init.mouse_event_init.event_modifier_init.meta_key = ui_events_has_modifier(modifiers, UiEventsKeyModifier.mod_super)
    event_init.mouse_event_init.screen_x = ui_events_css_x(&screen)
    event_init.mouse_event_init.screen_y = ui_events_css_y(&screen)
    event_init.mouse_event_init.client_x = ui_events_css_x(&client)
    event_init.mouse_event_init.client_y = ui_events_css_y(&client)
    event_init.mouse_event_init.event_modifier_init.ui_event_init.view = window_proxy
    if let moved = movement:
        event_init.mouse_event_init.movement_x = ui_events_css_x(&moved)
        event_init.mouse_event_init.movement_y = ui_events_css_y(&moved)
    event_init.mouse_event_init.button = ui_events_mouse_button_to_button_code((UiEventsMouseButton)(u8)button)
    event_init.mouse_event_init.buttons = (u16)buttons
    let event = ui_events_pointer_event_create(realm, event_name, event_init, ui_events_css_x(&page), ui_events_css_y(&page), ui_events_css_x(&offset), ui_events_css_y(&offset))
    dom_event_set_is_trusted(event.dom_event(), true)
    dom_event_set_bubbles(event.dom_event(), true)
    dom_event_set_cancelable(event.dom_event(), true)
    dom_event_set_composed(event.dom_event(), true)
    return event

## Ported from PointerEvent.cpp:65 Web::UIEvents::PointerEvent::PointerEvent.
pub func ui_events_pointer_event_construct(this: UiEventsPointerEvent*, realm: Realm*, type_: ak.FlyString, event_init: UiEventsPointerEventInit, page_x: f64, page_y: f64, offset_x: f64, offset_y: f64):
    ui_events_mouse_event_construct(this.ui_events_mouse_event(), realm, type_, event_init.mouse_event_init, page_x, page_y, offset_x, offset_y)
    this.m_pointer_id = event_init.pointer_id
    this.m_width = event_init.width
    this.m_height = event_init.height
    this.m_pressure = event_init.pressure
    this.m_tangential_pressure = event_init.tangential_pressure
    this.m_tilt_x = event_init.tilt_x else 0
    this.m_tilt_y = event_init.tilt_y else 0
    this.m_twist = event_init.twist
    this.m_altitude_angle = event_init.altitude_angle else ui_events_pointer_event_default_altitude_angle
    this.m_azimuth_angle = event_init.azimuth_angle else 0.0
    this.m_pointer_type = event_init.pointer_type
    this.m_is_primary = event_init.is_primary
    this.m_persistent_device_id = event_init.persistent_device_id
    for coalesced_event in ak.vector_span_const(&event_init.coalesced_events):
        ak.vector_append_t(&this.m_coalesced_events, coalesced_event else trap("a null coalesced event"))
    for predicted_event in ak.vector_span_const(&event_init.predicted_events):
        ak.vector_append_t(&this.m_predicted_events, predicted_event else trap("a null predicted event"))

## Ported from PointerEvent.cpp:91 Web::UIEvents::PointerEvent::initialize (override).
pub func ui_events_pointer_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.pointer_event)
    ui_events_mouse_event_initialize_impl(base, realm)

## Ported from PointerEvent.cpp:97 Web::UIEvents::PointerEvent::visit_edges (override).
pub func ui_events_pointer_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (UiEventsPointerEvent*)base
    ui_events_mouse_event_visit_edges_impl(base, visitor)
    for event in ak.vector_span(&this.m_coalesced_events):
        gc.cell_visitor_visit_t(visitor, event)
    for event in ak.vector_span(&this.m_predicted_events):
        gc.cell_visitor_visit_t(visitor, event)

## Ported from PointerEvent.cpp:104 Web::UIEvents::PointerEvent::clone (override).
pub func ui_events_pointer_event_clone_impl(base: UiEventsMouseEvent*) -> UiEventsMouseEvent*:
    let this = (UiEventsPointerEvent*)base
    var init = UiEventsPointerEventInit()
    init.mouse_event_init.screen_x = ui_events_mouse_event_screen_x(base)
    init.mouse_event_init.screen_y = ui_events_mouse_event_screen_y(base)
    init.mouse_event_init.client_x = ui_events_mouse_event_client_x(base)
    init.mouse_event_init.client_y = ui_events_mouse_event_client_y(base)
    init.mouse_event_init.movement_x = base.m_movement_x
    init.mouse_event_init.movement_y = base.m_movement_y
    init.mouse_event_init.button = base.m_button
    init.mouse_event_init.buttons = base.m_buttons
    init.mouse_event_init.related_target = base.m_related_target
    init.mouse_event_init.event_modifier_init.ctrl_key = base.m_ctrl_key
    init.mouse_event_init.event_modifier_init.shift_key = base.m_shift_key
    init.mouse_event_init.event_modifier_init.alt_key = base.m_alt_key
    init.mouse_event_init.event_modifier_init.meta_key = base.m_meta_key
    init.mouse_event_init.event_modifier_init.ui_event_init.view = ui_events_ui_event_view(base.ui_events_ui_event())
    init.mouse_event_init.event_modifier_init.ui_event_init.detail = ui_events_ui_event_detail(base.ui_events_ui_event())
    init.pointer_id = this.m_pointer_id
    init.width = this.m_width
    init.height = this.m_height
    init.pressure = this.m_pressure
    init.tangential_pressure = this.m_tangential_pressure
    init.tilt_x = this.m_tilt_x
    init.tilt_y = this.m_tilt_y
    init.twist = this.m_twist
    init.altitude_angle = this.m_altitude_angle
    init.azimuth_angle = this.m_azimuth_angle
    init.pointer_type = this.m_pointer_type
    init.is_primary = this.m_is_primary
    init.persistent_device_id = this.m_persistent_device_id
    let realm = bind_platform_object_realm(base.bind_platform_object())
    return (UiEventsMouseEvent*)ui_events_pointer_event_create(realm, dom_event_type(base.dom_event()), init, ui_events_mouse_event_page_x(base), ui_events_mouse_event_page_y(base),
                                                               ui_events_mouse_event_offset_x(base), ui_events_mouse_event_offset_y(base))

## Ported from PointerEvent.cpp:139 Web::UIEvents::PointerEvent::create.
pub func ui_events_pointer_event_create(realm: Realm*, type_: ak.FlyString, event_init: UiEventsPointerEventInit = UiEventsPointerEventInit(), page_x: f64 = 0.0, page_y: f64 = 0.0, offset_x: f64 = 0.0, offset_y: f64 = 0.0) -> UiEventsPointerEvent*:
    return realm_create_ui_events_pointer_event(realm, realm, type_, event_init, page_x, page_y, offset_x, offset_y)

## Ported from PointerEvent.cpp:144 Web::UIEvents::PointerEvent::construct_impl.
pub func ui_events_pointer_event_construct_impl(realm: Realm*, type_: ak.FlyString, event_init: UiEventsPointerEventInit) -> UiEventsPointerEvent*!:
    return ui_events_pointer_event_create(realm, type_, event_init, event_init.mouse_event_init.client_x, event_init.mouse_event_init.client_y, event_init.mouse_event_init.client_x,
                                          event_init.mouse_event_init.client_y)

