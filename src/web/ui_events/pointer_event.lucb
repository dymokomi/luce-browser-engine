# mark: PointerEvent ============================================================================

## PointerEvent::DEFAULT_ALTITUDE_ANGLE (PointerEvent.h:109): π/2.
let ui_events_pointer_event_default_altitude_angle: f64 = math.pi / 2.0

## Ported from PointerEvent.cpp:18 Web::UIEvents::PointerEvent::should_have_fractional_coordinates.
## https://w3c.github.io/pointerevents/#dom-pointerevent-screenx
## For untrusted PointerEvents, coordinates are floored for click, auxclick, and contextmenu events
## (via the MouseEvent base class). For all other pointer event types, fractional coordinates are
## preserved.
func ui_events_pointer_event_should_have_fractional_coordinates(this: UiEventsMouseEvent*) -> bool:
    if dom_event_is_trusted(this.dom_event()):
        return true
    let type_ = dom_event_type(this.dom_event())
    let is_click = ak.fly_string_eq_fly_string(&type_, &html_event_names_click)
    let is_auxclick = ak.fly_string_eq_fly_string(&type_, &ui_events_event_names_auxclick)
    return not is_click and not is_auxclick and not ak.fly_string_eq_fly_string(&type_, &html_event_names_contextmenu)

## Ported from PointerEvent.cpp:27 Web::UIEvents::PointerEvent::screen_x (override).
pub func ui_events_pointer_event_screen_x_impl(this: UiEventsMouseEvent*) -> f64:
    return this.m_screen_x if ui_events_pointer_event_should_have_fractional_coordinates(this) else ui_events_mouse_event_screen_x_impl(this)

