## Ported from WheelEvent.cpp:16 Web::UIEvents::WheelEvent::WheelEvent.
pub func ui_events_wheel_event_construct(this: UiEventsWheelEvent*, realm: Realm*, event_name: ak.FlyString, event_init: UiEventsWheelEventInit, page_x: f64, page_y: f64, offset_x: f64, offset_y: f64):
    ui_events_mouse_event_construct(this.ui_events_mouse_event(), realm, event_name, event_init.mouse_event_init, page_x, page_y, offset_x, offset_y)
    this.m_delta_x = event_init.delta_x
    this.m_delta_y = event_init.delta_y
    this.m_delta_z = event_init.delta_z
    this.m_delta_mode = event_init.delta_mode

