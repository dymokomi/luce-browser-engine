## Web::Selection::Selection::Direction (Libraries/LibWeb/Selection/Selection.h:25).
pub enum SelectionSelectionDirection as u8:
    forwards = 0
    backwards = 1
    directionless = 2

## Web::Selection::Selection (Libraries/LibWeb/Selection/Selection.h:17).
pub struct SelectionSelection: IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var platform_object: BindPlatformObject  # primary base
    # https://w3c.github.io/selection-api/#dfn-empty
    pub var m_range: DomRange*?
    pub var m_document: DomDocument*
    pub var m_direction: SelectionSelectionDirection  # C++ default: { Direction::Directionless }

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of Web::Selection::Selection.
pub let selection_selection_vtable: BindPlatformObjectVTable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &selection_selection_class, visit_edges = selection_selection_visit_edges_impl), initialize = selection_selection_initialize_impl))

## Class information of Web::Selection::Selection: PlatformObject's first class id.
pub let selection_selection_class: ak.ClassInfo = ak.ClassInfo(name = "Selection", first_id = 6, last_id = 6, size = memory.size_of(SelectionSelection), vtable = (const void*)&selection_selection_vtable)

## realm.create<Web::Selection::Selection>(realm, document).
pub func realm_create_selection_selection(realm: Realm*, realm_: Realm*, document: DomDocument*) -> SelectionSelection*:
    let this = (SelectionSelection*)web_allocate_cell(realm, &selection_selection_class)
    selection_selection_construct(this, realm_, document)
    web_initialize_cell(this.cell(), realm)
    return this
