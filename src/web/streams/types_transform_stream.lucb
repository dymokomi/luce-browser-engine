#==============================================================================================
#
#   types_transform_stream - declarations of the TransformStream stand-in
#
#   DESCRIPTION:
#       Written by hand by region p2c, in the shape the skeleton generator gives Streams'
#       classes, for the TransformStream stand-in of DESIGN.md §3.6 (streams/transform_stream):
#       Streams::TransformStream and TransformStreamDefaultController with the members the
#       stand-in uses, and the read request that pipes a readable stream through a transform
#       stream (ReadableStreamPipeTo's role, without a WritableStream).
#
#==============================================================================================

# mark: StreamsTransformStream ==================================================================

## Web::Streams::TransformStream (Libraries/LibWeb/Streams/TransformStream.h:20), as the stand-in keeps it: its
## readable side and its controller (the writable side is the pipe of streams_readable_stream_piped_through).
## https://streams.spec.whatwg.org/#transformstream
pub struct StreamsTransformStream: IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var platform_object: BindPlatformObject  # primary base
    pub var m_controller: StreamsTransformStreamDefaultController*?  # [[controller]]
    pub var m_readable: StreamsReadableStream*?  # [[readable]]

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of Web::Streams::TransformStream.
pub let streams_transform_stream_vtable: BindPlatformObjectVTable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &streams_transform_stream_class, visit_edges = streams_transform_stream_visit_edges_impl), initialize = streams_transform_stream_initialize_impl))

## Class information of Web::Streams::TransformStream: name, the class id of Web::Bindings::PlatformObject (it shares its
## nearest numbered ancestor's id and is recognized by its ClassInfo), size, vtable.
pub let streams_transform_stream_class: ak.ClassInfo = ak.ClassInfo(name = "TransformStream", first_id = 6, last_id = 6, size = memory.size_of(StreamsTransformStream), vtable = (const void*)&streams_transform_stream_vtable)

## realm.create<Web::Streams::TransformStream>(realm): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_streams_transform_stream(realm: Realm*, realm_: Realm*) -> StreamsTransformStream*:
    let this = (StreamsTransformStream*)web_allocate_cell(realm, &streams_transform_stream_class)
    streams_transform_stream_construct(this, realm_)
    web_initialize_cell(this.cell(), realm)
    return this

