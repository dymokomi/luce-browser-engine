# mark: StreamsPipeThroughReadRequest ===========================================================

## The stand-in's pipe: the read request that reads the source stream chunk by chunk into a transform stream.
pub struct StreamsPipeThroughReadRequest: IsStreamsReadRequest, IsJsCell, gc.IsCell:
    pub var read_request: StreamsReadRequest  # primary base
    pub var m_reader: StreamsReadableStreamDefaultReader*
    pub var m_transform: StreamsTransformStream*

    func streams_read_request() -> StreamsReadRequest*: return (StreamsReadRequest*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of the pipe's read request.
pub let streams_pipe_through_read_request_vtable: StreamsReadRequestVTable = StreamsReadRequestVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &streams_pipe_through_read_request_class, visit_edges = streams_pipe_through_read_request_visit_edges_impl)), on_chunk = streams_pipe_through_read_request_on_chunk_impl, on_close = streams_pipe_through_read_request_on_close_impl, on_error = streams_pipe_through_read_request_on_error_impl)

## Class information of the pipe's read request (JS::Cell's class id).
pub let streams_pipe_through_read_request_class: ak.ClassInfo = ak.ClassInfo(name = "PipeThroughReadRequest", first_id = 1, last_id = 1, size = memory.size_of(StreamsPipeThroughReadRequest), vtable = (const void*)&streams_pipe_through_read_request_vtable)
