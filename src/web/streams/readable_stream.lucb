# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/Streams/ReadableStream.cpp:88 Web::Streams::ReadableStream::ReadableStream,
## with the default member initializers (the stored error is undefined; the state "readable" and
## the rest are the zeroed cell's).
pub func streams_readable_stream_construct(this: StreamsReadableStream*, realm: Realm*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_state = StreamsReadableStreamState.readable
    this.m_stored_error = js_undefined()

## Ported from Libraries/LibWeb/Streams/ReadableStream.cpp:95 Web::Streams::ReadableStream::initialize (override).
pub func streams_readable_stream_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.readable_stream)
    js_cell_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/Streams/ReadableStream.cpp:101 Web::Streams::ReadableStream::visit_edges (override).
pub func streams_readable_stream_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (StreamsReadableStream*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    if let controller = this.m_controller:
        streams_visit_readable_stream_controller(visitor, controller)
    js_visit_value(visitor, this.m_stored_error)
    if let reader = this.m_reader:
        streams_visit_readable_stream_reader(visitor, reader)

## `m_controller->visit([&](auto& controller) { visitor.visit(controller); })`.
func streams_visit_readable_stream_controller(visitor: gc.CellVisitor*, controller: StreamsReadableStreamController):
    match controller:
        .streams_readable_stream_default_controller(default_controller):
            gc.cell_visitor_visit_cell(visitor, (gc.Cell*)(void*)default_controller)  # opaque until phase 4
        .streams_readable_byte_stream_controller(byte_controller):
            gc.cell_visitor_visit_t_2(visitor, byte_controller)

## `m_reader->visit([&](auto& reader) { visitor.visit(reader); })`.
pub func streams_visit_readable_stream_reader(visitor: gc.CellVisitor*, reader: StreamsReadableStreamReader):
    match reader:
        .streams_readable_stream_default_reader(default_reader):
            gc.cell_visitor_visit_t_2(visitor, default_reader)
        .streams_readable_stream_byob_reader(byob_reader):
            gc.cell_visitor_visit_cell(visitor, (gc.Cell*)(void*)byob_reader)  # opaque until phase 4

## `stream->realm()` (Bindings::PlatformObject::realm) of a Streams::ReadableStream.
pub func streams_readable_stream_realm(this: StreamsReadableStream*) -> Realm*:
    return bind_platform_object_realm(this.bind_platform_object())

