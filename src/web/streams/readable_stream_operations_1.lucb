        assert(state == StreamsReadableStreamState.errored)

        # 2. Set reader.[[closedPromise]] to a promise rejected with stream.[[storedError]].
        let closed_promise = idl_create_rejected_promise(realm, stream.m_stored_error)
        mixin.m_closed_promise = closed_promise

        # 3. Set reader.[[closedPromise]].[[PromiseIsHandled]] to true.
        idl_mark_promise_as_handled(closed_promise)

