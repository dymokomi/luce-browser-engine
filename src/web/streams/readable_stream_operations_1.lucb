    else:
        reader.m_closed_promise = idl_create_rejected_promise(realm, exception)

    # 6. Set reader.[[closedPromise]].[[PromiseIsHandled]] to true.
    idl_mark_promise_as_handled(reader.m_closed_promise else trap("VERIFY: the reader has a closed promise"))

    # 7. Perform ! stream.[[controller]].[[ReleaseSteps]]().
