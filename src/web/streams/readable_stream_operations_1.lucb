pub func streams_readable_stream_close_2(stream: StreamsReadableStream*):
    let realm = streams_readable_stream_realm(stream)

    # 1. Assert: stream.[[state]] is "readable".
    assert(stream.m_state == StreamsReadableStreamState.readable)

