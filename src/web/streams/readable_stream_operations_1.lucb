            # 2. Set reader.[[readRequests]] to an empty list.
            var read_requests = default_reader.m_read_requests
            default_reader.m_read_requests = ak.SinglyLinkedList[StreamsReadRequest*, ak.DefaultSizeCalculationPolicy[StreamsReadRequest*]]()

            # 3. For each readRequest of readRequests,
            for read_request in ak.singly_linked_list_begin(&read_requests):
