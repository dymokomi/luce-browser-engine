pub func streams_readable_stream_reader_generic_initialize(reader: StreamsReadableStreamReader, stream: StreamsReadableStream*):
    let (mixin, reader_object) = match reader:
        .streams_readable_stream_default_reader(default_reader) => (&default_reader.generic_reader, (JsObject*)default_reader)
