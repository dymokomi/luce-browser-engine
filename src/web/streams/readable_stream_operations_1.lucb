    # 3. If stream.[[state]] is "readable",
    let state = stream.m_state
    if state == StreamsReadableStreamState.readable:
        # 1. Set reader.[[closedPromise]] to a new promise.
        mixin.m_closed_promise = idl_create_promise(realm)
    # 4. Otherwise, if stream.[[state]] is "closed",
