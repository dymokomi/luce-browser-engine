# mark: PullIntoDescriptor ======================================================================

## Ported from Libraries/LibWeb/Streams/ReadableByteStreamController.cpp:24 Web::Streams::PullIntoDescriptor::visit_edges (override).
pub func streams_pull_into_descriptor_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (StreamsPullIntoDescriptor*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.buffer)
    gc.cell_visitor_visit_t_2(visitor, this.view_constructor)

