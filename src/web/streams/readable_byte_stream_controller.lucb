## Ported from Libraries/LibWeb/Streams/ReadableByteStreamController.cpp:46 Web::Streams::ReadableByteStreamController::close.
## https://streams.spec.whatwg.org/#rbs-controller-close
pub func streams_readable_byte_stream_controller_close(this: StreamsReadableByteStreamController*) -> !:
    # 1. If this.[[closeRequested]] is true, throw a TypeError exception.
    if this.m_close_requested:
        return try idl_throw_simple(IdlSimpleExceptionType.type_error, .string_view(ak.sv("Controller is already closed")))

    # 2. If this.[[stream]].[[state]] is not "readable", throw a TypeError exception.
    let stream = this.m_stream else trap("VERIFY: the controller has a stream")
    if stream.m_state != StreamsReadableStreamState.readable:
        let message = ak.sv("Cannot close a closed stream") if stream.m_state == StreamsReadableStreamState.closed else ak.sv("Cannot close an errored stream")
        return try idl_throw_simple(IdlSimpleExceptionType.type_error, .string_view(message))

    # 3. Perform ? ReadableByteStreamControllerClose(this).
    try streams_readable_byte_stream_controller_close_2(this)

## Ported from Libraries/LibWeb/Streams/ReadableByteStreamController.cpp:65 Web::Streams::ReadableByteStreamController::error.
## https://streams.spec.whatwg.org/#rbs-controller-error
pub func streams_readable_byte_stream_controller_error(this: StreamsReadableByteStreamController*, error_: JsValue):
    # 1. Perform ! ReadableByteStreamControllerError(this, e).
    streams_readable_byte_stream_controller_error_2(this, error_)

