## Ported from Libraries/LibWeb/Fetch/Fetching/Fetching.cpp:2415 Web::Fetch::Fetching::set_sec_fetch_dest_header.
# https://w3c.github.io/webappsec-fetch-metadata/#abstract-opdef-set-dest
pub func fetch_fetching_set_sec_fetch_dest_header(request: FetchRequest*):
    # 1. Assert: r’s url is a potentially trustworthy URL.
    assert(secure_contexts_is_url_potentially_trustworthy(fetch_request_url(request)) == SecureContextsTrustworthiness.potentially_trustworthy)

    # 2. Let header be a Structured Header whose value is a token.
    # FIXME: This is handled below, as Serenity doesn't have APIs for RFC 8941.

    # 3. If r’s destination is the empty string, set header’s value to the string "empty". Otherwise, set header’s value to r’s destination.
    var value = ak.sv("empty")
    if let destination = fetch_request_destination(request):
        value = fetch_request_destination_to_string(destination)

    # 4. Set a structured field value `Sec-Fetch-Dest`/header in r’s header list.
    http_header_list_append(fetch_request_header_list(request), http_header_create(ak.sv("Sec-Fetch-Dest"), value))

## Ported from Libraries/LibWeb/Fetch/Fetching/Fetching.cpp:2433 Web::Fetch::Fetching::set_sec_fetch_mode_header.
# https://w3c.github.io/webappsec-fetch-metadata/#abstract-opdef-set-dest
pub func fetch_fetching_set_sec_fetch_mode_header(request: FetchRequest*):
    # 1. Assert: r’s url is a potentially trustworthy URL.
    assert(secure_contexts_is_url_potentially_trustworthy(fetch_request_url(request)) == SecureContextsTrustworthiness.potentially_trustworthy)

    # 2. Let header be a Structured Header whose value is a token.
    # FIXME: This is handled below, as Serenity doesn't have APIs for RFC 8941.

    # 3. Set header’s value to r’s mode.
    let value = fetch_request_mode_to_string(fetch_request_mode(request))

    # 4. Set a structured field value `Sec-Fetch-Mode`/header in r’s header list.
    http_header_list_append(fetch_request_header_list(request), http_header_create(ak.sv("Sec-Fetch-Mode"), value))

## Ported from Libraries/LibWeb/Fetch/Fetching/Fetching.cpp:2449 Web::Fetch::Fetching::set_sec_fetch_site_header.
# https://w3c.github.io/webappsec-fetch-metadata/#abstract-opdef-set-site
pub func fetch_fetching_set_sec_fetch_site_header(request: FetchRequest*):
    # 1. Assert: r’s url is a potentially trustworthy URL.
    assert(secure_contexts_is_url_potentially_trustworthy(fetch_request_url(request)) == SecureContextsTrustworthiness.potentially_trustworthy)

    # 2. Let header be a Structured Header whose value is a token.
    # FIXME: This is handled below, as Serenity doesn't have APIs for RFC 8941.

    # 3. Set header’s value to same-origin.
    var value = ak.sv("same-origin")

    # FIXME: 4. If r is a navigation request that was explicitly caused by a user’s interaction with the user agent (by typing an address
    #           into the user agent directly, for example, or by clicking a bookmark, etc.), then set header’s value to none.

    # 5. If header’s value is not none, then for each url in r’s url list:
    if not ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("none")):
        let request_origin = fetch_fetching_request_origin(request) else trap("VERIFY: request.origin().has<URL::Origin>()")

        for url in ak.vector_span_const(fetch_request_url_list(request)):
            # 1. If url is same origin with r’s origin, continue.
            let url_origin = web_url.url_origin(&url)
            if web_url.origin_is_same_origin(&url_origin, request_origin):
                continue

            # 2. Set header’s value to cross-site.
            value = ak.sv("cross-site")

            # 3. If r’s origin is not same site with url’s origin, then break.
            if not web_url.origin_is_same_site(&request_origin, url_origin):
                break

            # 4. Set header’s value to same-site.
            value = ak.sv("same-site")

    # 6. Set a structured field value `Sec-Fetch-Site`/header in r’s header list.
    http_header_list_append(fetch_request_header_list(request), http_header_create(ak.sv("Sec-Fetch-Site"), value))

## Ported from Libraries/LibWeb/Fetch/Fetching/Fetching.cpp:2490 Web::Fetch::Fetching::set_sec_fetch_user_header.
# https://w3c.github.io/webappsec-fetch-metadata/#abstract-opdef-set-user
pub func fetch_fetching_set_sec_fetch_user_header(request: FetchRequest*):
    # 1. Assert: r’s url is a potentially trustworthy URL.
    assert(secure_contexts_is_url_potentially_trustworthy(fetch_request_url(request)) == SecureContextsTrustworthiness.potentially_trustworthy)

    # 2. If r is not a navigation request, or if r’s user-activation is false, return.
    if not fetch_request_is_navigation_request(request) or not fetch_request_user_activation(request):
        return

    # 3. Let header be a Structured Header whose value is a token.
    # FIXME: This is handled below, as Serenity doesn't have APIs for RFC 8941.

    # 4. Set header’s value to true.
    # NOTE: See https://datatracker.ietf.org/doc/html/rfc8941#name-booleans for boolean format in RFC 8941.
    let value = ak.sv("?1")

    # 5. Set a structured field value `Sec-Fetch-User`/header in r’s header list.
    http_header_list_append(fetch_request_header_list(request), http_header_create(ak.sv("Sec-Fetch-User"), value))

## Ported from Libraries/LibWeb/Fetch/Fetching/Fetching.cpp:2511 Web::Fetch::Fetching::append_fetch_metadata_headers_for_request.
# https://w3c.github.io/webappsec-fetch-metadata/#abstract-opdef-append-the-fetch-metadata-headers-for-a-request
pub func fetch_fetching_append_fetch_metadata_headers_for_request(request: FetchRequest*):
    # 1. If r’s url is not an potentially trustworthy URL, return.
    if secure_contexts_is_url_potentially_trustworthy(fetch_request_url(request)) != SecureContextsTrustworthiness.potentially_trustworthy:
        return

    # 2. Set the Sec-Fetch-Dest header for r.
    fetch_fetching_set_sec_fetch_dest_header(request)

    # 3. Set the Sec-Fetch-Mode header for r.
    fetch_fetching_set_sec_fetch_mode_header(request)

    # 4. Set the Sec-Fetch-Site header for r.
    fetch_fetching_set_sec_fetch_site_header(request)

    # 5. Set the Sec-Fetch-User header for r.
    fetch_fetching_set_sec_fetch_user_header(request)

