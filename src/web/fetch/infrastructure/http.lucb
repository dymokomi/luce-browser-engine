## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP.cpp:13 Web::Fetch::Infrastructure::default_user_agent_value.
# https://fetch.spec.whatwg.org/#default-user-agent-value
pub func fetch_default_user_agent_value() -> ak.ByteString:
    # A default `User-Agent` value is an implementation-defined header value for the `User-Agent` header.
    let user_agent = resource_loader_user_agent()
    return ak.string_to_byte_string(&user_agent)
