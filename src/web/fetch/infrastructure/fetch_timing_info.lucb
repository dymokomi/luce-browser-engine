# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchTimingInfo.cpp:17 Web::Fetch::Infrastructure::FetchTimingInfo::FetchTimingInfo (private).
func fetch_timing_info_construct(this: FetchTimingInfo*):
    # FetchTimingInfo() = default: the timestamps are 0, render-blocking false and the final connection timing info
    # null (the zeroed cell's); the server-timing headers are « ».
    this.m_server_timing_headers = ak.Vector[ak.String]()

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchTimingInfo.cpp:19 Web::Fetch::Infrastructure::FetchTimingInfo::create.
pub func fetch_timing_info_create(vm: Vm*) -> FetchTimingInfo*:
    # vm.heap().allocate<FetchTimingInfo>()
    let heap = vm_heap(vm)
    let timing_info = (FetchTimingInfo*)web_heap_allocate_cell(heap, &fetch_timing_info_class)
    gc.heap_defer_gc(heap)
    fetch_timing_info_construct(timing_info)
    gc.heap_undefer_gc(heap)
    return timing_info

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchTimingInfo.cpp:24 Web::Fetch::Infrastructure::FetchTimingInfo::visit_edges (override).
pub func fetch_timing_info_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    gc.cell_visit_edges_impl(base, visitor)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchTimingInfo.cpp:30 Web::Fetch::Infrastructure::create_opaque_timing_info.
# https://fetch.spec.whatwg.org/#create-an-opaque-timing-info
pub func fetch_create_opaque_timing_info(vm: Vm*, timing_info: FetchTimingInfo*) -> FetchTimingInfo*:
    # To create an opaque timing info, given a fetch timing info timingInfo, return a new fetch timing info whose
    # start time and post-redirect start time are timingInfo’s start time.
    let new_timing_info = fetch_timing_info_create(vm)
    fetch_timing_info_set_start_time(new_timing_info, fetch_timing_info_start_time(timing_info))
    fetch_timing_info_set_post_redirect_start_time(new_timing_info, fetch_timing_info_start_time(timing_info))
    return new_timing_info

# mark: Final timings ===========================================================================

## `m_start_time + (static_cast<DOMHighResTimeStamp>(microseconds) / 1000.0)`, coarsened: one of update_final_timings'
## seven timestamps.
func fetch_timing_info_coarsened_final_time(this: FetchTimingInfo*, microseconds: i64, cross_origin_isolated_capability: HtmlCanUseCrossOriginIsolatedApIs) -> f64:
    let milliseconds = this.m_start_time + ((f64)microseconds / 1000.0)
    return high_resolution_time_coarsen_time(milliseconds, cross_origin_isolated_capability)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchTimingInfo.cpp:40 Web::Fetch::Infrastructure::FetchTimingInfo::update_final_timings.
pub func fetch_timing_info_update_final_timings(this: FetchTimingInfo*, final_timings: const RequestsRequestTimingInfo*, cross_origin_isolated_capability: HtmlCanUseCrossOriginIsolatedApIs):
    let coarsened_domain_lookup_start_time = fetch_timing_info_coarsened_final_time(this, final_timings.domain_lookup_start_microseconds, cross_origin_isolated_capability)
    let coarsened_domain_lookup_end_time = fetch_timing_info_coarsened_final_time(this, final_timings.domain_lookup_end_microseconds, cross_origin_isolated_capability)
    let coarsened_connection_start_time = fetch_timing_info_coarsened_final_time(this, final_timings.connect_start_microseconds, cross_origin_isolated_capability)
    let coarsened_connection_end_time = fetch_timing_info_coarsened_final_time(this, final_timings.connect_end_microseconds, cross_origin_isolated_capability)
    let coarsened_secure_connection_start_time = fetch_timing_info_coarsened_final_time(this, final_timings.secure_connect_start_microseconds, cross_origin_isolated_capability)

    this.m_final_connection_timing_info = FetchConnectionTimingInfo(
        domain_lookup_start_time = coarsened_domain_lookup_start_time,
        domain_lookup_end_time = coarsened_domain_lookup_end_time,
        connection_start_time = coarsened_connection_start_time,
        connection_end_time = coarsened_connection_end_time,
        secure_connection_start_time = coarsened_secure_connection_start_time,
        alpn_negotiated_protocol = requests_alpn_http_version_to_fly_string(final_timings.http_version_alpn_identifier),
    )

    let coarsened_request_start_time = fetch_timing_info_coarsened_final_time(this, final_timings.request_start_microseconds, cross_origin_isolated_capability)
    this.m_final_network_request_start_time = coarsened_request_start_time

    let coarsened_response_start_time = fetch_timing_info_coarsened_final_time(this, final_timings.response_start_microseconds, cross_origin_isolated_capability)
    this.m_final_network_response_start_time = coarsened_response_start_time

