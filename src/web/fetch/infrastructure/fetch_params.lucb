# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:16 Web::Fetch::Infrastructure::FetchParams::FetchParams (private).
func fetch_params_construct(this: FetchParams*, request: FetchRequest*, algorithms: FetchAlgorithms*, controller: FetchController*, timing_info: FetchTimingInfo*):
    # The default member initializers: a null task destination and preloaded response candidate (the zeroed cell's)
    # and no cross-origin isolated capability.
    this.m_cross_origin_isolated_capability = HtmlCanUseCrossOriginIsolatedApIs.no
    this.m_request = request
    this.m_algorithms = algorithms
    this.m_controller = controller
    this.m_timing_info = timing_info
    fetch_controller_set_fetch_params(this.m_controller, this)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:25 Web::Fetch::Infrastructure::FetchParams::FetchParams (private copy constructor).
func fetch_params_construct_fetch_params(this: FetchParams*, params: const FetchParams*):
    this.m_request = params.m_request
    this.m_algorithms = params.m_algorithms
    this.m_task_destination = params.m_task_destination
    this.m_cross_origin_isolated_capability = params.m_cross_origin_isolated_capability
    this.m_controller = params.m_controller
    this.m_timing_info = params.m_timing_info
    this.m_preloaded_response_candidate = params.m_preloaded_response_candidate

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:36 Web::Fetch::Infrastructure::FetchParams::create.
pub func fetch_params_create(vm: Vm*, request: FetchRequest*, timing_info: FetchTimingInfo*) -> FetchParams*:
    let algorithms = fetch_algorithms_create(vm, FetchAlgorithmsInput())
    let controller = fetch_controller_create(vm)

    # vm.heap().allocate<FetchParams>(request, algorithms, controller, timing_info)
    let heap = vm_heap(vm)
    let params = (FetchParams*)web_heap_allocate_cell(heap, &fetch_params_class)
    gc.heap_defer_gc(heap)
    fetch_params_construct(params, request, algorithms, controller, timing_info)
    gc.heap_undefer_gc(heap)
    return params

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:43 Web::Fetch::Infrastructure::FetchParams::copy.
pub func fetch_params_copy(params: FetchParams*) -> FetchParams*:
    # params.vm().heap().allocate<FetchParams>(params)
    let heap = vm_heap(js_cell_vm(params.js_cell()))
    let copy = (FetchParams*)web_heap_allocate_cell(heap, &fetch_params_class)
    gc.heap_defer_gc(heap)
    fetch_params_construct_fetch_params(copy, params)
    gc.heap_undefer_gc(heap)
    return copy

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:48 Web::Fetch::Infrastructure::FetchParams::visit_edges (override).
pub func fetch_params_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchParams*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_request)
    gc.cell_visitor_visit_t(visitor, this.m_algorithms)
    gc.cell_visitor_visit_t(visitor, this.m_controller)
    gc.cell_visitor_visit_t(visitor, this.m_timing_info)
    match this.m_task_destination:
        .js_object(object): js_visit_object(visitor, object)
        _: discard(0)
    match this.m_preloaded_response_candidate:
        .fetch_response(response): gc.cell_visitor_visit_t(visitor, response)
        _: discard(0)

