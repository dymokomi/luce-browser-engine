# mark: Aborted and canceled ====================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:62 Web::Fetch::Infrastructure::FetchParams::is_aborted.
# https://fetch.spec.whatwg.org/#fetch-params-aborted
pub func fetch_params_is_aborted(this: FetchParams*) -> bool:
    # A fetch params fetchParams is aborted if its controller’s state is "aborted".
    return fetch_controller_state(this.m_controller) == FetchControllerState.aborted

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchParams.cpp:69 Web::Fetch::Infrastructure::FetchParams::is_canceled.
# https://fetch.spec.whatwg.org/#fetch-params-canceled
pub func fetch_params_is_canceled(this: FetchParams*) -> bool:
    # A fetch params fetchParams is canceled if its controller’s state is "aborted" or "terminated".
    return fetch_controller_state(this.m_controller) == FetchControllerState.aborted or fetch_controller_state(this.m_controller) == FetchControllerState.terminated
