#==============================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:14 Web::Fetch::Infrastructure::FetchRecord::create.
pub func fetch_record_create(vm: Vm*, request: FetchRequest*) -> FetchRecord*:
    # vm.heap().allocate<FetchRecord>(request)
    let heap = vm_heap(vm)
    let record = (FetchRecord*)web_heap_allocate_cell(heap, &fetch_record_class)
    gc.heap_defer_gc(heap)
    fetch_record_construct(record, request)
    gc.heap_undefer_gc(heap)
    return record

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:19 Web::Fetch::Infrastructure::FetchRecord::create (with a fetch controller).
pub func fetch_record_create_fetch_controller(vm: Vm*, request: FetchRequest*, fetch_controller: FetchController*?) -> FetchRecord*:
    # vm.heap().allocate<FetchRecord>(request, fetch_controller)
    let heap = vm_heap(vm)
    let record = (FetchRecord*)web_heap_allocate_cell(heap, &fetch_record_class)
    gc.heap_defer_gc(heap)
    fetch_record_construct_fetch_controller(record, request, fetch_controller)
    gc.heap_undefer_gc(heap)
    return record

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:24 Web::Fetch::Infrastructure::FetchRecord::FetchRecord (private).
func fetch_record_construct(this: FetchRecord*, request: FetchRequest*):
    this.m_request = request
    this.m_fetch_controller = none

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.h:25 Web::Fetch::Infrastructure::FetchRecord::request.
pub func fetch_record_request(this: FetchRecord*) -> FetchRequest*:
    return this.m_request

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.h:26 Web::Fetch::Infrastructure::FetchRecord::set_request.
pub func fetch_record_set_request(this: FetchRecord*, request: FetchRequest*):
    this.m_request = request

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.h:28 Web::Fetch::Infrastructure::FetchRecord::fetch_controller.
pub func fetch_record_fetch_controller(this: FetchRecord*) -> FetchController*?:
    return this.m_fetch_controller

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:29 Web::Fetch::Infrastructure::FetchRecord::FetchRecord (private, with a fetch controller).
func fetch_record_construct_fetch_controller(this: FetchRecord*, request: FetchRequest*, fetch_controller: FetchController*?):
    this.m_request = request
    this.m_fetch_controller = fetch_controller

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.h:29 Web::Fetch::Infrastructure::FetchRecord::set_fetch_controller.
pub func fetch_record_set_fetch_controller(this: FetchRecord*, fetch_controller: FetchController*?):
    this.m_fetch_controller = fetch_controller

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:35 Web::Fetch::Infrastructure::FetchRecord::visit_edges (override).
pub func fetch_record_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchRecord*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_request)
    gc.cell_visitor_visit_t(visitor, this.m_fetch_controller)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchRecord.cpp:42 Web::Fetch::Infrastructure::FetchRecord::finalize (override).
pub func fetch_record_finalize_impl(base: gc.Cell*):
    let this = (FetchRecord*)base
    gc.cell_finalize_impl(base)
    ak.intrusive_list_node_remove(&this.m_list_node)
