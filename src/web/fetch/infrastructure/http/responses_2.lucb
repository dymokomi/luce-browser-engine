## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:224 Web::Fetch::Infrastructure::FilteredResponse::FilteredResponse.
## (The destructor, Responses.cpp:230, is empty.)
pub func fetch_filtered_response_construct(this: FetchFilteredResponse*, internal_response: FetchResponse*, header_list: HttpHeaderList*):
    fetch_response_construct(this.fetch_response(), header_list)
    this.m_internal_response = internal_response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:234 Web::Fetch::Infrastructure::FilteredResponse::visit_edges (override).
pub func fetch_filtered_response_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchFilteredResponse*)base
    fetch_response_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_internal_response)

## `vm.heap().allocate<T>(internal_response, header_list)` for a filtered response of class `info`: a zeroed cell of
## the VM's heap, garbage collection deferred while the caller runs the constructor and undefers.
func fetch_filtered_response_allocate(vm: Vm*, info: const ak.ClassInfo*) -> gc.Cell*:
    let heap = vm_heap(vm)
    let cell = web_heap_allocate_cell(heap, info)
    gc.heap_defer_gc(heap)
    return cell

# mark: BasicFilteredResponse ===================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:240 Web::Fetch::Infrastructure::BasicFilteredResponse::create.
pub func fetch_basic_filtered_response_create(vm: Vm*, internal_response: FetchResponse*) -> FetchBasicFilteredResponse*:
    # A basic filtered response is a filtered response whose type is "basic" and header list excludes
    # any headers in internal response’s header list whose name is a forbidden response-header name.
    let header_list = http_header_list_create()

    for header in &ak.vector_span_const(http_header_list_headers(fetch_response_header_list(internal_response))):
        if not http_is_forbidden_response_header_name(ak.byte_string_view(&header.name)):
            http_header_list_append(header_list, *header)

    let response = (FetchBasicFilteredResponse*)fetch_filtered_response_allocate(vm, &fetch_basic_filtered_response_class)
    fetch_basic_filtered_response_construct(response, internal_response, header_list)
    gc.heap_undefer_gc(vm_heap(vm))
    return response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:254 Web::Fetch::Infrastructure::BasicFilteredResponse::BasicFilteredResponse (private).
func fetch_basic_filtered_response_construct(this: FetchBasicFilteredResponse*, internal_response: FetchResponse*, header_list: HttpHeaderList*):
    fetch_filtered_response_construct(this.fetch_filtered_response(), internal_response, header_list)
    this.m_header_list = header_list

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.h:269 Web::Fetch::Infrastructure::BasicFilteredResponse::type (override).
pub func fetch_basic_filtered_response_type_impl(base: FetchResponse*) -> FetchResponseType:
    return FetchResponseType.basic

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.h:270 Web::Fetch::Infrastructure::BasicFilteredResponse::header_list (override).
pub func fetch_basic_filtered_response_header_list_impl(base: FetchResponse*) -> HttpHeaderList*:
    return ((FetchBasicFilteredResponse*)base).m_header_list

# mark: CORSFilteredResponse ====================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:260 Web::Fetch::Infrastructure::CORSFilteredResponse::create.
pub func fetch_cors_filtered_response_create(vm: Vm*, internal_response: FetchResponse*) -> FetchCorsFilteredResponse*:
    # A CORS filtered response is a filtered response whose type is "cors" and header list excludes
    # any headers in internal response’s header list whose name is not a CORS-safelisted response-header
    # name, given internal response’s CORS-exposed header-name list.
    var cors_exposed_header_name_list = ak.Vector[ak.StringView]()
    let exposed_names = fetch_response_cors_exposed_header_name_list(internal_response)
    ak.vector_ensure_capacity(&cors_exposed_header_name_list, ak.vector_size(exposed_names))

    for header_name in &ak.vector_span_const(exposed_names):
        ak.vector_unchecked_append_u(&cors_exposed_header_name_list, ak.byte_string_view(header_name))

    let header_list = http_header_list_create()
    for header in &ak.vector_span_const(http_header_list_headers(fetch_response_header_list(internal_response))):
        if fetch_is_cors_safelisted_response_header_name(ak.byte_string_view(&header.name), ak.vector_span_const(&cors_exposed_header_name_list)):
            http_header_list_append(header_list, *header)

    let response = (FetchCorsFilteredResponse*)fetch_filtered_response_allocate(vm, &fetch_cors_filtered_response_class)
    fetch_cors_filtered_response_construct(response, internal_response, header_list)
    gc.heap_undefer_gc(vm_heap(vm))
    return response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:280 Web::Fetch::Infrastructure::CORSFilteredResponse::CORSFilteredResponse (private).
func fetch_cors_filtered_response_construct(this: FetchCorsFilteredResponse*, internal_response: FetchResponse*, header_list: HttpHeaderList*):
    fetch_filtered_response_construct(this.fetch_filtered_response(), internal_response, header_list)
    this.m_header_list = header_list

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.h:286 Web::Fetch::Infrastructure::CORSFilteredResponse::type (override).
pub func fetch_cors_filtered_response_type_impl(base: FetchResponse*) -> FetchResponseType:
    return FetchResponseType.cors

