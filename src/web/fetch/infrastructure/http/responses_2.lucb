## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:286 Web::Fetch::Infrastructure::OpaqueFilteredResponse::create.
pub func fetch_opaque_filtered_response_create(vm: Vm*, internal_response: FetchResponse*) -> FetchOpaqueFilteredResponse*:
    # An opaque filtered response is a filtered response whose type is "opaque", URL list is the empty list,
    # status is 0, status message is the empty byte sequence, header list is empty, and body is null.
    let response = (FetchOpaqueFilteredResponse*)fetch_filtered_response_allocate(vm, &fetch_opaque_filtered_response_class)
    fetch_opaque_filtered_response_construct(response, internal_response, http_header_list_create())
    gc.heap_undefer_gc(vm_heap(vm))
    return response

