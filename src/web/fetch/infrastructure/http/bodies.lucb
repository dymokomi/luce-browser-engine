#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:22 Web::Fetch::Infrastructure::to_source_type_internal (internal linkage).
func fetch_to_source_type_internal(source_type: FetchBodySourceType) -> FetchBodySourceTypeInternal:
    match source_type:
        .empty: return .empty
        .byte_buffer(buffer): return .byte_buffer(buffer)
        .file_api_blob(blob): return .file_api_blob(blob else trap("GC::Ref { *blob }: a null blob"))

## `vm.heap().allocate<Body>(...)`: a zeroed Body cell of the VM's heap, garbage collection deferred
## while the caller runs the constructor and undefers.
func fetch_body_allocate(vm: Vm*) -> FetchBody*:
    let heap = vm_heap(vm)
    let body = (FetchBody*)web_heap_allocate_cell(heap, &fetch_body_class)
    gc.heap_defer_gc(heap)
    return body

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:30 Web::Fetch::Infrastructure::Body::create.
pub func fetch_body_create(vm: Vm*, stream: StreamsReadableStream*) -> FetchBody*:
    let body = fetch_body_allocate(vm)
    fetch_body_construct(body, stream)
    gc.heap_undefer_gc(vm_heap(vm))
    return body

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:35 Web::Fetch::Infrastructure::Body::create (with a SourceType).
pub func fetch_body_create_fetch_body_source_type(vm: Vm*, stream: StreamsReadableStream*, source: FetchBodySourceType, length: u64?) -> FetchBody*:
    return fetch_body_create_fetch_body_source_type_interna(vm, stream, fetch_to_source_type_internal(source), length)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:40 Web::Fetch::Infrastructure::Body::create (with a SourceTypeInternal).
pub func fetch_body_create_fetch_body_source_type_interna(vm: Vm*, stream: StreamsReadableStream*, source: FetchBodySourceTypeInternal, length: u64?) -> FetchBody*:
    let body = fetch_body_allocate(vm)
    fetch_body_construct_fetch_body_source_type_interna(body, stream, source, length)
    gc.heap_undefer_gc(vm_heap(vm))
    return body

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:45 Web::Fetch::Infrastructure::Body::Body (private).
func fetch_body_construct(this: FetchBody*, stream: StreamsReadableStream*):
    this.m_stream = stream

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:50 Web::Fetch::Infrastructure::Body::Body (private).
func fetch_body_construct_fetch_body_source_type_interna(this: FetchBody*, stream: StreamsReadableStream*, source: FetchBodySourceTypeInternal, length: u64?):
    this.m_stream = stream
    this.m_source = source
    this.m_length = length

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Bodies.cpp:57 Web::Fetch::Infrastructure::Body::visit_edges (override).
pub func fetch_body_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchBody*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_stream)  # Streams::ReadableStream: opaque until phase 4
    gc.cell_visitor_visit_t(visitor, this.m_sniff_bytes_callback)
    match this.m_source:
        .file_api_blob(blob): gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)blob)  # FileAPI::Blob: opaque until phase 3
        _: return

