#==============================================================================================
#
#   responses - what phase 1 needs of Fetch::Infrastructure::Response: creating one, its URL
#   list, status, header list, body and response time
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp lines 28-43 (create,
#       the constructor, visit_edges) and 109-116 (url), with the accessors of Responses.h that
#       phase 1 reads, taken by region r28 (see types_responses). Filtered responses, network
#       errors and the rest come with Fetch in phase 2.
#
#       Copyright (c) 2022-2023, Linus Groh <linusg@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Responses.cpp:28 Web::Fetch::Infrastructure::Response::create.
pub func fetch_infrastructure_response_create(vm: Vm*) -> FetchResponse*:
    let heap = vm_heap(vm)
    let response = (FetchResponse*)web_heap_allocate_cell(heap, &fetch_response_class)
    gc.heap_defer_gc(heap)
    fetch_response_construct(response, http_header_list_create())
    gc.heap_undefer_gc(heap)
    return response

## Ported from Responses.cpp:33 Web::Fetch::Infrastructure::Response::Response, with the default
## member initializers.
pub func fetch_response_construct(this: FetchResponse*, header_list: HttpHeaderList*):
    this.m_status = 200
    this.m_header_list = header_list
    this.m_monotonic_response_time = ak.monotonic_time_now()

## Ported from Responses.cpp:39 Web::Fetch::Infrastructure::Response::visit_edges (override).
pub func fetch_response_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchResponse*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_body)  # opaque in phase 1

## Ported from Responses.cpp:109 Web::Fetch::Infrastructure::Response::url.
pub func fetch_response_url(this: FetchResponse*) -> web_url.Url?:
    # A response has an associated URL. It is a pointer to the last URL in response’s URL list and null if response’s URL list is empty.
    # NOTE: We have to use the virtual getter here to not bypass filtered responses.
    let url_list = fetch_response_url_list(this)
    if ak.vector_is_empty(url_list):
        return none
    return *ak.vector_last(url_list)

## Ported from Responses.h:75 Web::Fetch::Infrastructure::Response::url_list.
pub func fetch_response_url_list(this: FetchResponse*) -> ak.Vector[web_url.Url]*:
    return &this.m_url_list

## Ported from Responses.h:76 Web::Fetch::Infrastructure::Response::set_url_list.
pub func fetch_response_set_url_list(this: FetchResponse*, url_list: ak.Vector[web_url.Url]):
    this.m_url_list = url_list

## Ported from Responses.h:78 Web::Fetch::Infrastructure::Response::status.
pub func fetch_response_status(this: FetchResponse*) -> u16:
    return this.m_status

## Ported from Responses.h:84 Web::Fetch::Infrastructure::Response::header_list.
pub func fetch_response_header_list(this: FetchResponse*) -> HttpHeaderList*:
    return this.m_header_list

## Ported from Responses.h:87 Web::Fetch::Infrastructure::Response::body.
pub func fetch_response_body(this: FetchResponse*) -> FetchBody*?:
    return this.m_body

## Ported from Responses.h:88 Web::Fetch::Infrastructure::Response::set_body.
pub func fetch_response_set_body(this: FetchResponse*, body: FetchBody*?):
    this.m_body = body

## Ported from Responses.h:126 Web::Fetch::Infrastructure::Response::monotonic_response_time.
pub func fetch_response_monotonic_response_time(this: FetchResponse*) -> ak.MonotonicTime:
    return this.m_monotonic_response_time
