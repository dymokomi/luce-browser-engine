# mark: Strings ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Requests.cpp:377 Web::Fetch::Infrastructure::request_destination_to_string.
pub func fetch_request_destination_to_string(destination: FetchRequestDestination) -> ak.StringView:
    match destination:
        .audio: return ak.sv("audio")
        .audio_worklet: return ak.sv("audioworklet")
        .document: return ak.sv("document")
        .embed: return ak.sv("embed")
        .font: return ak.sv("font")
        .frame: return ak.sv("frame")
        .i_frame: return ak.sv("iframe")
        .image: return ak.sv("image")
        .json: return ak.sv("json")
        .manifest: return ak.sv("manifest")
        .object: return ak.sv("object")
        .paint_worklet: return ak.sv("paintworklet")
        .report: return ak.sv("report")
        .script: return ak.sv("script")
        .service_worker: return ak.sv("serviceworker")
        .shared_worker: return ak.sv("sharedworker")
        .style: return ak.sv("style")
        .track: return ak.sv("track")
        .video: return ak.sv("video")
        .web_identity: return ak.sv("webidentity")
        .worker: return ak.sv("worker")
        .xslt: return ak.sv("xslt")
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Requests.cpp:429 Web::Fetch::Infrastructure::translate_potential_destination.
# https://fetch.spec.whatwg.org/#concept-potential-destination-translate
pub func fetch_translate_potential_destination(potential_destination: ak.StringView) -> FetchRequestDestination?:
    # 1. If potentialDestination is "fetch", then return the empty string.
    if ak.string_view_equals(&potential_destination, "fetch"):
        return none

    # 2. Assert: potentialDestination is a destination.
    # 3. Return potentialDestination.
    if ak.string_view_equals(&potential_destination, "audio"):
        return FetchRequestDestination.audio
    if ak.string_view_equals(&potential_destination, "audioworklet"):
        return FetchRequestDestination.audio_worklet
    if ak.string_view_equals(&potential_destination, "document"):
        return FetchRequestDestination.document
    if ak.string_view_equals(&potential_destination, "embed"):
        return FetchRequestDestination.embed
    if ak.string_view_equals(&potential_destination, "font"):
        return FetchRequestDestination.font
    if ak.string_view_equals(&potential_destination, "frame"):
        return FetchRequestDestination.frame
    if ak.string_view_equals(&potential_destination, "iframe"):
        return FetchRequestDestination.i_frame
    if ak.string_view_equals(&potential_destination, "image"):
        return FetchRequestDestination.image
    if ak.string_view_equals(&potential_destination, "json"):
        return FetchRequestDestination.json
    if ak.string_view_equals(&potential_destination, "manifest"):
        return FetchRequestDestination.manifest
    if ak.string_view_equals(&potential_destination, "object"):
        return FetchRequestDestination.object
    if ak.string_view_equals(&potential_destination, "paintworklet"):
        return FetchRequestDestination.paint_worklet
    if ak.string_view_equals(&potential_destination, "report"):
        return FetchRequestDestination.report
    if ak.string_view_equals(&potential_destination, "script"):
        return FetchRequestDestination.script
    if ak.string_view_equals(&potential_destination, "serviceworker"):
        return FetchRequestDestination.service_worker
    if ak.string_view_equals(&potential_destination, "sharedworker"):
        return FetchRequestDestination.shared_worker
    if ak.string_view_equals(&potential_destination, "style"):
        return FetchRequestDestination.style
    if ak.string_view_equals(&potential_destination, "track"):
        return FetchRequestDestination.track
    if ak.string_view_equals(&potential_destination, "video"):
        return FetchRequestDestination.video
    if ak.string_view_equals(&potential_destination, "webidentity"):
        return FetchRequestDestination.web_identity
    if ak.string_view_equals(&potential_destination, "worker"):
        return FetchRequestDestination.worker
    if ak.string_view_equals(&potential_destination, "xslt"):
        return FetchRequestDestination.xslt
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Requests.cpp:485 Web::Fetch::Infrastructure::destination_is_script_like.
# https://fetch.spec.whatwg.org/#request-destination-script-like
pub func fetch_destination_is_script_like(destination: FetchRequestDestination) -> bool:
    # A request’s destination is script-like if it is "audioworklet", "paintworklet", "script", "serviceworker",
    # "sharedworker", or "worker".
    match destination:
        .audio_worklet, .paint_worklet, .script, .service_worker, .shared_worker, .worker: return true
        _: return false

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Requests.cpp:498 Web::Fetch::Infrastructure::request_mode_to_string.
pub func fetch_request_mode_to_string(mode: FetchRequestMode) -> ak.StringView:
    match mode:
        .same_origin: return ak.sv("same-origin")
        .cors: return ak.sv("cors")
        .no_cors: return ak.sv("no-cors")
        .navigate: return ak.sv("navigate")
        .web_socket: return ak.sv("websocket")
        _: trap("VERIFY_NOT_REACHED")

