## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Requests.cpp:564 Web::Fetch::Infrastructure::request_priority_from_string.
pub func fetch_request_priority_from_string(string: ak.StringView) -> FetchRequestPriority?:
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("high")):
        return FetchRequestPriority.high
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("low")):
        return FetchRequestPriority.low
    if ak.string_view_equals_ignoring_ascii_case(&string, ak.sv("auto")):
        return FetchRequestPriority.auto
    return none
