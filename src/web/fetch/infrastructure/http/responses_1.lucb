# mark: Network errors, URLs ====================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:80 Web::Fetch::Infrastructure::Response::is_aborted_network_error.
# https://fetch.spec.whatwg.org/#concept-aborted-network-error
pub func fetch_response_is_aborted_network_error(this: FetchResponse*) -> bool:
    # A response whose type is "error" and aborted flag is set is known as an aborted network error.
    # NOTE: We have to use the virtual getter here to not bypass filtered responses.
    return fetch_response_type(this) == FetchResponseType.error_ and fetch_response_aborted(this)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:88 Web::Fetch::Infrastructure::Response::is_network_error.
# https://fetch.spec.whatwg.org/#concept-network-error
pub func fetch_response_is_network_error(this: FetchResponse*) -> bool:
    # A network error is a response whose type is "error", status is 0, status message is the empty byte sequence,
    # header list is « », body is null, and body info is a new response body info.
    # NOTE: We have to use the virtual getter here to not bypass filtered responses.
    if fetch_response_type(this) != FetchResponseType.error_:
        return false
    if fetch_response_status(this) != 0:
        return false
    let status_message = fetch_response_status_message(this)
    if not ak.byte_string_is_empty(&status_message):
        return false
    if not http_header_list_is_empty(fetch_response_header_list(this)):
        return false
    if fetch_response_body(this) != none:
        return false
    let new_body_info = FetchResponseBodyInfo(encoded_size = 0, decoded_size = 0, content_type = ak.string_new())
    if not fetch_response_body_info_eq(fetch_response_body_info(this), &new_body_info):
        return false
    return true

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:109 Web::Fetch::Infrastructure::Response::url.
# https://fetch.spec.whatwg.org/#concept-response-url
pub func fetch_response_url(this: FetchResponse*) -> web_url.Url?:
    # A response has an associated URL. It is a pointer to the last URL in response’s URL list and null if response’s URL list is empty.
    # NOTE: We have to use the virtual getter here to not bypass filtered responses.
    let url_list = fetch_response_url_list_const(this)
    if ak.vector_is_empty(url_list):
        return none
    return *ak.vector_last_const(url_list)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:119 Web::Fetch::Infrastructure::Response::location_url.
# https://fetch.spec.whatwg.org/#concept-response-location-url
pub func fetch_response_location_url(this: FetchResponse*, request_fragment: ak.String?) -> web_url.Url?!:
    # The location URL of a response response, given null or an ASCII string requestFragment, is the value returned by the following steps. They return null, failure, or a URL.

    # 1. If response’s status is not a redirect status, then return null.
    # NOTE: We have to use the virtual getter here to not bypass filtered responses.
    if not fetch_is_redirect_status(fetch_response_status(this)):
        return none

    # 2. Let location be the result of extracting header list values given `Location` and response’s header list.
    let location_values_or_failure = http_header_list_extract_header_list_values(this.m_header_list, ak.sv("Location"))
    var location_values: ak.Vector[ak.ByteString]
    match location_values_or_failure:
        .vector_byte_string(values): location_values = values
        _: return none

    if ak.vector_size(&location_values) != 1:
        return none

    # 3. If location is a header value, then set location to the result of parsing location with response’s URL.
    var location = domurl_parse(ak.byte_string_view(ak.vector_first(&location_values)), fetch_response_url(this)) else error(ak.ak_error, "Invalid 'Location' header URL")

    # 4. If location is a URL whose fragment is null, then set location’s fragment to requestFragment.
    if web_url.url_fragment(&location) == none:
        web_url.url_set_fragment(&location, request_fragment)

    # 5. Return location.
    return location

# mark: Cloning =================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:149 Web::Fetch::Infrastructure::Response::clone.
# https://fetch.spec.whatwg.org/#concept-response-clone
pub func fetch_response_clone(this: FetchResponse*, realm: Realm*) -> FetchResponse*:
    # To clone a response response, run these steps:
    let vm = realm_vm(realm)

    # 1. If response is a filtered response, then return a new identical filtered response whose internal response is a clone of response’s internal response.
    if let filtered = as_if_fetch_filtered_response(this):
        let internal_response = fetch_response_clone(filtered.m_internal_response, realm)
        if is_fetch_basic_filtered_response(this):
            return (FetchResponse*)fetch_basic_filtered_response_create(vm, internal_response)
        if is_fetch_cors_filtered_response(this):
            return (FetchResponse*)fetch_cors_filtered_response_create(vm, internal_response)
        if is_fetch_opaque_filtered_response(this):
            return (FetchResponse*)fetch_opaque_filtered_response_create(vm, internal_response)
        if is_fetch_opaque_redirect_filtered_response(this):
            return (FetchResponse*)fetch_opaque_redirect_filtered_response_create(vm, internal_response)
        trap("VERIFY_NOT_REACHED")

    # 2. Let newResponse be a copy of response, except for its body.
    let new_response = fetch_infrastructure_response_create(vm)
    fetch_response_set_type(new_response, this.m_type)
    fetch_response_set_aborted(new_response, this.m_aborted)
    fetch_response_set_url_list(new_response, ak.vector_clone(&this.m_url_list))
    fetch_response_set_status(new_response, this.m_status)
    fetch_response_set_status_message(new_response, this.m_status_message)
    for header in &ak.vector_span(&this.m_header_list.m_headers):
        http_header_list_append(fetch_response_header_list(new_response), *header)
    fetch_response_set_cache_state(new_response, this.m_cache_state)
    fetch_response_set_cors_exposed_header_name_list(new_response, ak.vector_clone(&this.m_cors_exposed_header_name_list))
    fetch_response_set_range_requested(new_response, this.m_range_requested)
    fetch_response_set_request_includes_credentials(new_response, this.m_request_includes_credentials)
    fetch_response_set_timing_allow_passed(new_response, this.m_timing_allow_passed)
    fetch_response_set_body_info(new_response, this.m_body_info)
    # FIXME: service worker timing info

    # 3. If response’s body is non-null, then set newResponse’s body to the result of cloning response’s body.
    if let body = this.m_body:
        fetch_response_set_body(new_response, fetch_body_clone(body, realm))

    # 4. Return newResponse.
    return new_response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:194 Web::Fetch::Infrastructure::Response::unsafe_response.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#unsafe-response
pub func fetch_response_unsafe_response(this: FetchResponse*) -> FetchResponse*:
    # A response's unsafe response is its internal response if it has one, and the response itself otherwise.
    if let filtered = as_if_fetch_filtered_response(this):
        return filtered.m_internal_response

    return this

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:204 Web::Fetch::Infrastructure::Response::is_cors_same_origin.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#cors-same-origin
pub func fetch_response_is_cors_same_origin(this: FetchResponse*) -> bool:
    # A response whose type is "basic", "cors", or "default" is CORS-same-origin. [FETCH]
    match fetch_response_type(this):
        .basic, .cors, .default: return true
        _: return false

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:218 Web::Fetch::Infrastructure::Response::is_cors_cross_origin.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#cors-cross-origin
pub func fetch_response_is_cors_cross_origin(this: FetchResponse*) -> bool:
    # A response whose type is "opaque" or "opaqueredirect" is CORS-cross-origin.
    let type_ = fetch_response_type(this)
    return type_ == FetchResponseType.opaque or type_ == FetchResponseType.opaque_redirect

