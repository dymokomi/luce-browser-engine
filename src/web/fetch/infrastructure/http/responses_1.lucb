## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.h:58 Web::Fetch::Infrastructure::Response::BodyInfo::operator==
## (defaulted: every member equal).
pub func fetch_response_body_info_eq(this: const FetchResponseBodyInfo*, other: const FetchResponseBodyInfo*) -> bool:
    return this.encoded_size == other.encoded_size and this.decoded_size == other.decoded_size and ak.string_equals(&this.content_type, &other.content_type)

