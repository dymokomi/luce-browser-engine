## `dbgln_if(WEB_FETCH_DEBUG, ...)` (AK/Debug.h; off by default).
let fetch_web_fetch_debug: bool = false

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:28 Web::Fetch::Infrastructure::Response::create.
pub func fetch_infrastructure_response_create(vm: Vm*) -> FetchResponse*:
    let heap = vm_heap(vm)
    let response = (FetchResponse*)web_heap_allocate_cell(heap, &fetch_response_class)
    gc.heap_defer_gc(heap)
    fetch_response_construct(response, http_header_list_create())
    gc.heap_undefer_gc(heap)
    return response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:33 Web::Fetch::Infrastructure::Response::Response
## (protected), after the default member initializers.
func fetch_response_construct(this: FetchResponse*, header_list: HttpHeaderList*):
    fetch_response_init_fields(this)
    # The default-constructed strings (the cell is zeroed: a ByteString's impl is never null, and a zeroed String
    # is not equal to an empty one), with BodyInfo's default member initializers.
    this.m_status_message = ak.byte_string_empty()
    this.m_method = ak.byte_string_empty()
    this.m_body_info = FetchResponseBodyInfo(encoded_size = 0, decoded_size = 0, content_type = ak.string_new())
    this.m_header_list = header_list
    this.m_monotonic_response_time = ak.monotonic_time_now()

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:39 Web::Fetch::Infrastructure::Response::visit_edges (override).
pub func fetch_response_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchResponse*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_body)

# mark: Network errors ==========================================================================

# https://fetch.spec.whatwg.org/#ref-for-concept-network-error%E2%91%A3
# A network error is a response whose status is always 0, status message is always
# the empty byte sequence, header list is always empty, and body is always null.

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:49 Web::Fetch::Infrastructure::Response::aborted_network_error.
pub func fetch_response_aborted_network_error(vm: Vm*) -> FetchResponse*:
    let response = fetch_response_network_error(vm, ak.string_from_str("Fetch has been aborted"))
    fetch_response_set_aborted(response, true)
    return response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:56 Web::Fetch::Infrastructure::Response::network_error.
pub func fetch_response_network_error(vm: Vm*, message: ak.String) -> FetchResponse*:
    if fetch_web_fetch_debug:
        ak.dbgln(f"Fetch: Creating network error response with message: {ak.string_view_text(ak.string_bytes_as_string_view(&message))}")
    let response = fetch_infrastructure_response_create(vm)
    fetch_response_set_status(response, 0)
    fetch_response_set_type(response, FetchResponseType.error_)
    assert(fetch_response_body(response) == none)
    response.m_network_error_message = message
    return response

## Ported from Libraries/LibWeb/Fetch/Infrastructure/HTTP/Responses.cpp:68 Web::Fetch::Infrastructure::Response::appropriate_network_error.
# https://fetch.spec.whatwg.org/#appropriate-network-error
pub func fetch_response_appropriate_network_error(vm: Vm*, fetch_params: FetchParams*) -> FetchResponse*:
    # 1. Assert: fetchParams is canceled.
    assert(fetch_params_is_canceled(fetch_params))

    # 2. Return an aborted network error if fetchParams is aborted; otherwise return a network error.
    if fetch_params_is_aborted(fetch_params):
        return fetch_response_aborted_network_error(vm)
    return fetch_response_network_error(vm, ak.string_from_str("Fetch has been terminated"))

