#==============================================================================================
#
#   fetch_controller - Fetch::Infrastructure::FetchController: a fetch's state, timing and
#   abort reason, the next manual redirect, stopping a fetch and its queued fetch tasks; and
#   FetchControllerHolder
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp (lines 19-197) with
#       the inline members of FetchController.h (lines 41-62, 111-112). The pending request is
#       a WeakPtr<Requests::Request> in C++; a Requests::Request is a cell of the RequestClient
#       seam (region p2d) here, so the controller holds a gc.Weak to it. StructuredSerialize of
#       the abort reason is a closure stub (phase 3).
#
#       Copyright (c) 2022, Linus Groh <linusg@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:21 Web::Fetch::Infrastructure::FetchController::FetchController (private).
func fetch_controller_construct(this: FetchController*):
    # FetchController() = default: the default member initializers.
    this.m_state = FetchControllerState.ongoing
    this.m_next_fetch_task_id = 0

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:23 Web::Fetch::Infrastructure::FetchController::create.
pub func fetch_controller_create(vm: Vm*) -> FetchController*:
    # vm.heap().allocate<FetchController>()
    let heap = vm_heap(vm)
    let controller = (FetchController*)web_heap_allocate_cell(heap, &fetch_controller_class)
    gc.heap_defer_gc(heap)
    fetch_controller_construct(controller)
    gc.heap_undefer_gc(heap)
    return controller

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:28 Web::Fetch::Infrastructure::FetchController::visit_edges (override).
pub func fetch_controller_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchController*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_full_timing_info)
    gc.cell_visitor_visit_t(visitor, this.m_report_timing_steps)
    gc.cell_visitor_visit_t(visitor, this.m_next_manual_redirect_steps)
    gc.cell_visitor_visit_t(visitor, this.m_fetch_params)

# mark: Setters and accessors ===================================================================

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:37 Web::Fetch::Infrastructure::FetchController::set_pending_request.
pub func fetch_controller_set_pending_request(this: FetchController*, request: RequestsRequest*?):
    # (A Requests::Request is a cell of the RequestClient seam: the WeakPtr is a gc.Weak to it.)
    this.m_pending_request = gc.make_weak[gc.Cell]((gc.Cell*?)(void*?)request)

