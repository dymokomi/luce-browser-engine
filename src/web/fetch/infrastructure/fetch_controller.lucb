## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:185 Web::Fetch::Infrastructure::FetchControllerHolder::FetchControllerHolder (private).
func fetch_controller_holder_construct(this: FetchControllerHolder*):
    # FetchControllerHolder() = default: m_controller is null.
    this.m_controller = none

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:187 Web::Fetch::Infrastructure::FetchControllerHolder::create.
pub func fetch_controller_holder_create(vm: Vm*) -> FetchControllerHolder*:
    # vm.heap().allocate<FetchControllerHolder>()
    let heap = vm_heap(vm)
    let holder = (FetchControllerHolder*)web_heap_allocate_cell(heap, &fetch_controller_holder_class)
    gc.heap_defer_gc(heap)
    fetch_controller_holder_construct(holder)
    gc.heap_undefer_gc(heap)
    return holder

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.cpp:192 Web::Fetch::Infrastructure::FetchControllerHolder::visit_edges (override).
pub func fetch_controller_holder_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (FetchControllerHolder*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_controller)

## Ported from Libraries/LibWeb/Fetch/Infrastructure/FetchController.h:111 Web::Fetch::Infrastructure::FetchControllerHolder::controller.
