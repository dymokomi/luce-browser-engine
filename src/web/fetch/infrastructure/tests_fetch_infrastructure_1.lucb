#==============================================================================================
#
#   tests_fetch_infrastructure_1 - Fetch/Infrastructure, ReferrerPolicy and SecureContexts:
#   the donor's TestFetchURL and the oracle's cases
#
#   DESCRIPTION:
#       Port of Tests/LibWeb/TestFetchURL.cpp (lines 13-114: data: URLs), and the runner of
#       tests_fetch_infrastructure_cases: each case's operation is run and its result printed
#       the way the local oracle prints the reference build's
#       (oracles/luce-browser-engine/fetch_http, cases_p2a.txt). The case struct and the
#       printing helpers are p2b's (tests_fetch_http_1).
#
#==============================================================================================

# mark: TestFetchURL.cpp ========================================================================

## A parsed test URL: `URL::Parser::basic_parse(text)`, with EXPECT(url.has_value()).
func fetch_test_data_url_parse(text: str) -> web_url.Url:
    return web_url.parser_basic_parse(ak.sv(text)) else trap("EXPECT(url.has_value())")

## The checks every TestFetchURL case makes of a data: URL: its scheme is "data" and it has no host.
func fetch_test_data_url_is_data(url: const web_url.Url*):
    let scheme = web_url.url_scheme(url)
    assert(ak.string_eq_string_view(&scheme, ak.sv("data")))
    assert(web_url.url_host(url) == none)

## `url->serialize() == expected`.
func fetch_test_data_url_serializes_as(url: const web_url.Url*, expected: str) -> bool:
    let serialized = web_url.url_serialize(url)
    return ak.string_eq_string_view(&serialized, ak.sv(expected))

## `TRY_OR_FAIL(process_data_url(url))`, with the checks of its MIME type's serialization and its body.
func fetch_test_data_url_processes_to(url: web_url.Url, mime_type: str, body: str):
    let data_url = fetch_process_data_url(url) else trap("TRY_OR_FAIL(process_data_url(url))")
    let serialized = mime_type_serialized(&data_url.mime_type)
    assert(ak.string_eq_string_view(&serialized, ak.sv(mime_type)))
    let bytes = ak.string_view_from_bytes(ak.byte_buffer_bytes_const(&data_url.body))
    assert(ak.string_view_equals(&bytes, body))

## Ported from TestFetchURL.cpp:13 data_url.
test "Fetch: data URL":
    let url = fetch_test_data_url_parse("data:text/html,test")
    fetch_test_data_url_is_data(&url)
    assert(fetch_test_data_url_serializes_as(&url, "data:text/html,test"))
    fetch_test_data_url_processes_to(url, "text/html", "test")

## Ported from TestFetchURL.cpp:26 data_url_default_mime_type.
test "Fetch: data URL default MIME type":
    let url = fetch_test_data_url_parse("data:,test")
    fetch_test_data_url_is_data(&url)
    assert(fetch_test_data_url_serializes_as(&url, "data:,test"))
    fetch_test_data_url_processes_to(url, "text/plain;charset=US-ASCII", "test")

