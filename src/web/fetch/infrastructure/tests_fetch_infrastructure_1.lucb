## Ported from TestFetchURL.cpp:91 data_url_base64_encoded_with_inline_whitespace.
test "Fetch: data URL base64 encoded with inline whitespace":
    let url = fetch_test_data_url_parse("data:text/javascript;base64,%20ZD%20Qg%0D%0APS%20An%20Zm91cic%0D%0A%207%20")
