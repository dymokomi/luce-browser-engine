    fetch_test_data_url_is_data(&url)
    assert(fetch_test_data_url_serializes_as(&url, "data:text/html,Hello%20friends%2C%0X%X0"))
    fetch_test_data_url_processes_to(url, "text/html", "Hello friends,%0X%X0")

