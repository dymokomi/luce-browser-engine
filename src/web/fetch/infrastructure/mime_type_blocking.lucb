## Ported from Libraries/LibWeb/Fetch/Infrastructure/MimeTypeBlocking.cpp:15 Web::Fetch::Infrastructure::should_response_to_request_be_blocked_due_to_its_mime_type.
# https://fetch.spec.whatwg.org/#ref-for-should-response-to-request-be-blocked-due-to-mime-type?
pub func fetch_should_response_to_request_be_blocked_due_to_its_mime_type(response: FetchResponse*, request: FetchRequest*) -> FetchRequestOrResponseBlocking:
    # 1. Let mimeType be the result of extracting a MIME type from response’s header list.
    let mime_type_or_failure = fetch_extract_mime_type(fetch_response_header_list(response))

    # 2. If mimeType is failure, then return allowed.
    let mime_type = mime_type_or_failure else return FetchRequestOrResponseBlocking.allowed

    # 3. Let destination be request’s destination.
    # 4. If destination is script-like and one of the following is true, then return blocked:
    if fetch_request_destination_is_script_like(request):
        let essence = mime_type_essence(&mime_type)
        # - mimeType’s essence starts with "audio/", "image/", or "video/".
        let prefixes: str[3] = ["audio/", "image/", "video/"]
        var starts_with_a_prefix = false
        for prefix in prefixes:
            if ak.string_starts_with_bytes(&essence, ak.sv(prefix)):
                starts_with_a_prefix = true
                break
        # - mimeType’s essence is "text/csv".
        if starts_with_a_prefix or ak.string_eq_string_view(&essence, ak.sv("text/csv")):
            return FetchRequestOrResponseBlocking.blocked

    # 5. Return allowed.
    return FetchRequestOrResponseBlocking.allowed
