#==============================================================================================
#
#   html_time_element - HTML::HTMLTimeElement: <time>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLTimeElement.cpp (lines 1-28) and the default_role inline of
#       HTMLTimeElement.h: construction (which moves the mixin tables to HTMLTimeElement's, as
#       C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLTimeElement.cpp:15 Web::HTML::HTMLTimeElement::HTMLTimeElement.
pub func html_time_element_construct(this: HtmlTimeElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLTimeElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_time_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_time_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_time_element_animatable_vtable
    element.global_event_handlers.vtable = &html_time_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_time_element_form_associated_element_vtable

## Ported from HTMLTimeElement.cpp:20 Web::HTML::HTMLTimeElement::initialize (override).
pub func html_time_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_time_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLTimeElement.h:22 Web::HTML::HTMLTimeElement::default_role (override).
# https://www.w3.org/TR/html-aria/#el-time
pub func html_time_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    return AriaRole.time
