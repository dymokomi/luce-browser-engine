## Ported from AudioTrackList.cpp:122 Web::HTML::AudioTrackList::visit_edges (override).
pub func html_audio_track_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlAudioTrackList*)base
    dom_event_target_visit_edges_impl(base, visitor)
    for audio_track in ak.vector_span(&this.m_audio_tracks):
        gc.cell_visitor_visit_t(visitor, audio_track)
