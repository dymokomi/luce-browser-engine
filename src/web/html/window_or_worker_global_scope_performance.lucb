#==============================================================================================
#
#   window_or_worker_global_scope_performance - a global's performance entries: the buffers,
#   queueing, and the resource timing buffer
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp lines 702-750
#       (relevant_performance_entry_tuple, queue_performance_entry, add_performance_entry),
#       866-955 (queue_the_performance_observer_task), 958-1053 (add_resource_timing_entry,
#       can_add_resource_timing_entry, resource_timing_buffer_current_size,
#       fire_resource_timing_buffer_full_event, copy_resource_timing_secondary_buffer) and
#       1156-1162 (performance). PerformanceObservers are made by script (phase 3): the list of
#       registered observers stays empty until then, so the observer task finds nothing to notify
#       (a registered observer traps).
#
#       Copyright (c) 2023, Luke Wilde <lukew@serenityos.org>
#       Copyright (c) 2025, Luke Wilde <luke@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## The global's realm (`this_impl().realm()`).
func html_window_or_worker_global_scope_mixin_realm(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> Realm*:
    return bind_platform_object_realm(html_window_or_worker_global_scope_mixin_this_impl(this).bind_platform_object())

## Ported from WindowOrWorkerGlobalScope.cpp:702 Web::HTML::WindowOrWorkerGlobalScopeMixin::relevant_performance_entry_tuple.
## https://www.w3.org/TR/performance-timeline/#dfn-relevant-performance-entry-tuple
pub func html_window_or_worker_global_scope_mixin_relevant_performance_entry_tuple(this: HtmlWindowOrWorkerGlobalScopeMixin*, entry_type: ak.FlyString) -> PerformanceTimelinePerformanceEntryTuple*:
    # 1. Let map be the performance entry buffer map associated with globalObject.
    # 2. Return the result of getting the value of an entry from map, given entryType as the key.
    # This shouldn't be called with entry types that aren't in `ENUMERATE_SUPPORTED_PERFORMANCE_ENTRY_TYPES`.
    return ak.ordered_hash_map_get_k(&this.m_performance_entry_buffer_map, entry_type) else trap("VERIFY: tuple.has_value()")

## Ported from WindowOrWorkerGlobalScope.cpp:714 Web::HTML::WindowOrWorkerGlobalScopeMixin::queue_performance_entry.
## https://www.w3.org/TR/performance-timeline/#dfn-queue-a-performanceentry
pub func html_window_or_worker_global_scope_mixin_queue_performance_entry(this: HtmlWindowOrWorkerGlobalScopeMixin*, new_entry: PerformanceTimelinePerformanceEntry*):
    # 1. Let interested observers be an initially empty set of PerformanceObserver objects.
    # 2. Let entryType be newEntry’s entryType value.
    # 3. Let relevantGlobal be newEntry's relevant global object.
    # NOTE: Already is `this`.
    _ = new_entry

    # 4. For each registered performance observer regObs in relevantGlobal's list of registered performance observer
    #    objects: (observers are made by script)
    if not ak.ordered_hash_table_is_empty(&this.m_registered_performance_observer_objects):
        trap("unported (P3): PerformanceObserver (WindowOrWorkerGlobalScopeMixin::queue_performance_entry)")

    # 5. For each observer in interested observers: (none)

    # AD-HOC: Steps 6-9 are not here because other engines do not add to the performance entry buffer when queuing
    #         the performance observer task. The users of the Performance Timeline specification also do not expect
    #         this function to add to the entry buffer, instead queuing the observer task, then adding to the entry
    #         buffer separately.

    # 10. Queue the PerformanceObserver task with relevantGlobal as input.
    html_window_or_worker_global_scope_mixin_queue_the_performance_observer_task(this)

## Ported from WindowOrWorkerGlobalScope.cpp:756 Web::HTML::WindowOrWorkerGlobalScopeMixin::add_performance_entry, with
## CheckIfPerformanceBufferIsFull::No (its default).
pub func html_window_or_worker_global_scope_mixin_add_performance_entry(this: HtmlWindowOrWorkerGlobalScopeMixin*, new_entry: PerformanceTimelinePerformanceEntry*):
    # 6. Let tuple be the relevant performance entry tuple of entryType and relevantGlobal.
    let tuple = html_window_or_worker_global_scope_mixin_relevant_performance_entry_tuple(this, performance_timeline_performance_entry_entry_type(new_entry))

    # AD-HOC: We have a custom flag to always append to the buffer by default, as other performance specs do this by default
    #         (either they don't have a limit, or they check the limit themselves).
    let is_buffer_full = false
    let should_add = PerformanceTimelineShouldAddEntry.yes

    # 9. If isBufferFull is false and shouldAdd is true, append newEntry to tuple's performance entry buffer.
    if not is_buffer_full and should_add == PerformanceTimelineShouldAddEntry.yes:
        ak.vector_append_t(&tuple.performance_entry_buffer, new_entry)

## The task queue_the_performance_observer_task queues.
func html_window_or_worker_global_scope_mixin_performance_observer_task(context: void*?):
    let this = (HtmlWindowOrWorkerGlobalScopeMixin*)(context else trap("no global"))
    let realm = html_window_or_worker_global_scope_mixin_realm(this)
    var execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&execution_context, realm, HtmlTemporaryExecutionContextCallbacksEnabled.yes)
    defer html_temporary_execution_context_destruct(&execution_context)

    # 1. Unset performance observer task queued flag of relevantGlobal.
    this.m_performance_observer_task_queued = false

    # 2. Let notifyList be a copy of relevantGlobal's list of registered performance observer objects.
    # 3. For each registered performance observer object registeredObserver in notifyList, run these steps: (observers are
    #    made by script)
    if not ak.ordered_hash_table_is_empty(&this.m_registered_performance_observer_objects):
        trap("unported (P3): PerformanceObserver (WindowOrWorkerGlobalScopeMixin::queue_the_performance_observer_task)")

## Ported from WindowOrWorkerGlobalScope.cpp:866 Web::HTML::WindowOrWorkerGlobalScopeMixin::queue_the_performance_observer_task.
## https://www.w3.org/TR/performance-timeline/#dfn-queue-the-performanceobserver-task
func html_window_or_worker_global_scope_mixin_queue_the_performance_observer_task(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    # 1. If relevantGlobal's performance observer task queued flag is set, terminate these steps.
    if this.m_performance_observer_task_queued:
        return

    # 2. Set relevantGlobal's performance observer task queued flag.
    this.m_performance_observer_task_queued = true

    # 3. Queue a task that consists of running the following substeps. The task source for the queued task is the performance
    #    timeline task source.
    let global = html_window_or_worker_global_scope_mixin_this_impl(this)
    let steps = gc.create_function0(gc.cell_heap(global.cell()), ak.Function0[unit](call = html_window_or_worker_global_scope_mixin_performance_observer_task, context = this))
    _ = html_queue_global_task(HtmlTaskSource.performance_timeline, (JsObject*)global, steps)

## The task add_resource_timing_entry queues.
func html_window_or_worker_global_scope_mixin_buffer_full_task(context: void*?):
    let this = (HtmlWindowOrWorkerGlobalScopeMixin*)(context else trap("no global"))
    html_window_or_worker_global_scope_mixin_fire_resource_timing_buffer_full_event(this)

## Ported from WindowOrWorkerGlobalScope.cpp:959 Web::HTML::WindowOrWorkerGlobalScopeMixin::add_resource_timing_entry.
## https://w3c.github.io/resource-timing/#dfn-add-a-performanceresourcetiming-entry
pub func html_window_or_worker_global_scope_mixin_add_resource_timing_entry(this: HtmlWindowOrWorkerGlobalScopeMixin*, entry: ResourceTimingPerformanceResourceTiming*):
    # 1. If can add resource timing entry returns true and resource timing buffer full event pending flag is false,
    #    run the following substeps:
    if html_window_or_worker_global_scope_mixin_can_add_resource_timing_entry(this) and not this.m_resource_timing_buffer_full_event_pending:
        # a. Add new entry to the performance entry buffer.
        # b. Increase resource timing buffer current size by 1.
        html_window_or_worker_global_scope_mixin_add_performance_entry(this, &entry.entry)

        # c. Return.
        return

    # 2. If resource timing buffer full event pending flag is false, run the following substeps:
    if not this.m_resource_timing_buffer_full_event_pending:
        # a. Set resource timing buffer full event pending flag to true.
        this.m_resource_timing_buffer_full_event_pending = true

        # b. Queue a task on the performance timeline task source to run fire a buffer full event.
        let heap = gc.cell_heap(html_window_or_worker_global_scope_mixin_this_impl(this).cell())
        _ = html_queue_a_task(HtmlTaskSource.performance_timeline, none, none,
                              gc.create_function0(heap, ak.Function0[unit](call = html_window_or_worker_global_scope_mixin_buffer_full_task, context = this)))

    # 3. Add new entry to the resource timing secondary buffer.
    # 4. Increase resource timing secondary buffer current size by 1.
    ak.vector_append_t(&this.m_resource_timing_secondary_buffer, entry)

## Ported from WindowOrWorkerGlobalScope.cpp:989 Web::HTML::WindowOrWorkerGlobalScopeMixin::can_add_resource_timing_entry.
## https://w3c.github.io/resource-timing/#dfn-can-add-resource-timing-entry
func html_window_or_worker_global_scope_mixin_can_add_resource_timing_entry(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> bool:
    # 1. If resource timing buffer current size is smaller than resource timing buffer size limit, return true.
    # 2. Return false.
    return html_window_or_worker_global_scope_mixin_resource_timing_buffer_current_size(this) < (usize)this.m_resource_timing_buffer_size_limit

## Ported from WindowOrWorkerGlobalScope.cpp:997 Web::HTML::WindowOrWorkerGlobalScopeMixin::resource_timing_buffer_current_size.
## https://w3c.github.io/resource-timing/#dfn-resource-timing-buffer-current-size
func html_window_or_worker_global_scope_mixin_resource_timing_buffer_current_size(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> usize:
    # A resource timing buffer current size which is initially 0.
    let resource_timing_tuple = html_window_or_worker_global_scope_mixin_relevant_performance_entry_tuple(this, performance_timeline_entry_types_resource)
    return ak.vector_size(&resource_timing_tuple.performance_entry_buffer)

## Ported from WindowOrWorkerGlobalScope.cpp:1005 Web::HTML::WindowOrWorkerGlobalScopeMixin::fire_resource_timing_buffer_full_event.
## https://w3c.github.io/resource-timing/#dfn-fire-a-buffer-full-event
func html_window_or_worker_global_scope_mixin_fire_resource_timing_buffer_full_event(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    # 1. While resource timing secondary buffer is not empty, run the following substeps:
    while not ak.vector_is_empty(&this.m_resource_timing_secondary_buffer):
        # 1. Let number of excess entries before be resource timing secondary buffer current size.
        let number_of_excess_entries_before = ak.vector_size(&this.m_resource_timing_secondary_buffer)

        # 2. If can add resource timing entry returns false, then fire an event named resourcetimingbufferfull at the Performance object.
        if not html_window_or_worker_global_scope_mixin_can_add_resource_timing_entry(this):
            let full_event = dom_event_create(html_window_or_worker_global_scope_mixin_realm(this), performance_timeline_event_names_resourcetimingbufferfull)
            _ = dom_event_target_dispatch_event(html_window_or_worker_global_scope_mixin_performance(this).dom_event_target(), full_event)

        # 3. Run copy secondary buffer.
        html_window_or_worker_global_scope_mixin_copy_resource_timing_secondary_buffer(this)

        # 4. Let number of excess entries after be resource timing secondary buffer current size.
        let number_of_excess_entries_after = ak.vector_size(&this.m_resource_timing_secondary_buffer)

        # 5. If number of excess entries before is lower than or equals number of excess entries after, then remove
        #    all entries from resource timing secondary buffer, set resource timing secondary buffer current size to
        #    0, and abort these steps.
        if number_of_excess_entries_before <= number_of_excess_entries_after:
            ak.vector_clear(&this.m_resource_timing_secondary_buffer)
            break

    # 2. Set resource timing buffer full event pending flag to false.
    this.m_resource_timing_buffer_full_event_pending = false

## Ported from WindowOrWorkerGlobalScope.cpp:1039 Web::HTML::WindowOrWorkerGlobalScopeMixin::copy_resource_timing_secondary_buffer.
## https://w3c.github.io/resource-timing/#dfn-copy-secondary-buffer
func html_window_or_worker_global_scope_mixin_copy_resource_timing_secondary_buffer(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    # 1. While resource timing secondary buffer is not empty and can add resource timing entry returns true,
    #    run the following substeps:
    while not ak.vector_is_empty(&this.m_resource_timing_secondary_buffer) and html_window_or_worker_global_scope_mixin_can_add_resource_timing_entry(this):
        # 1. Let entry be the oldest PerformanceResourceTiming in resource timing secondary buffer.
        # 2. Add entry to the end of performance entry buffer.
        # 3. Increment resource timing buffer current size by 1.
        # 4. Remove entry from resource timing secondary buffer.
        # 5. Decrement resource timing secondary buffer current size by 1.
        let entry = ak.vector_take_first(&this.m_resource_timing_secondary_buffer)
        let resource_tuple = html_window_or_worker_global_scope_mixin_relevant_performance_entry_tuple(this, performance_timeline_entry_types_resource)
        ak.vector_append_t(&resource_tuple.performance_entry_buffer, &entry.entry)

## Ported from WindowOrWorkerGlobalScope.cpp:1156 Web::HTML::WindowOrWorkerGlobalScopeMixin::performance.
pub func html_window_or_worker_global_scope_mixin_performance(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> HighResolutionTimePerformance*:
    let realm = html_window_or_worker_global_scope_mixin_realm(this)
    if this.m_performance == none:
        this.m_performance = realm_create_high_resolution_time_performance(realm, realm)
    return this.m_performance else trap("unreachable")
