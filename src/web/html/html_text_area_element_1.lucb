pub func html_text_area_element_selection_start_binding(this: HtmlTextAreaElement*) -> u32:
    return html_form_associated_text_control_element_selection_start_binding(html_text_area_element_text_control(this)) else trap("VERIFY: Optional::value() on an empty optional")

## Ported from HTMLTextAreaElement.cpp:312 Web::HTML::HTMLTextAreaElement::set_selection_start_binding.
pub func html_text_area_element_set_selection_start_binding(this: HtmlTextAreaElement*, value: u32) -> !:
    try html_form_associated_text_control_element_set_selection_start_binding(html_text_area_element_text_control(this), value)

