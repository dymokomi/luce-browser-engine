## Ported from HTMLTextAreaElement.cpp:332 Web::HTML::HTMLTextAreaElement::set_selection_direction_binding.
pub func html_text_area_element_set_selection_direction_binding(this: HtmlTextAreaElement*, direction: ak.String):
    # NOTE: The selectionDirection setter never returns an error for textarea elements.
    html_form_associated_text_control_element_set_selection_direction_binding(html_text_area_element_text_control(this), direction) else trap("MUST: set_selection_direction_binding")
