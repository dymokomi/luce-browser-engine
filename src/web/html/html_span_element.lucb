#==============================================================================================
#
#   html_span_element - HTML::HTMLSpanElement: <span>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLSpanElement.cpp (lines 1-28) and the inlines of HTMLSpanElement.h:
#       construction (which moves the mixin tables to HTMLSpanElement's, as C++'s vptrs move),
#       initialize and the default ARIA role.
#
#==============================================================================================

## Ported from HTMLSpanElement.cpp:15 Web::HTML::HTMLSpanElement::HTMLSpanElement.
pub func html_span_element_construct(this: HtmlSpanElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLSpanElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_span_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_span_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_span_element_animatable_vtable
    element.global_event_handlers.vtable = &html_span_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_span_element_form_associated_element_vtable

## Ported from HTMLSpanElement.cpp:22 Web::HTML::HTMLSpanElement::initialize (override).
pub func html_span_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_span_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLSpanElement.h:22 Web::HTML::HTMLSpanElement::default_role (override).
# https://www.w3.org/TR/html-aria/#el-span
pub func html_span_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    return AriaRole.generic

## Ported from HTMLSpanElement.h:24 Web::HTML::HTMLSpanElement::is_html_span_element (override).
pub func html_span_element_is_html_span_element_impl(base: DomNode*) -> bool:
    return true
