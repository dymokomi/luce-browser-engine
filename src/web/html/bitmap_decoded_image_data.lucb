#==============================================================================================
#
#   bitmap_decoded_image_data - HTML::BitmapDecodedImageData: an image's decoded frames
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/BitmapDecodedImageData.cpp (lines 17-70) with the inline
#       overrides of BitmapDecodedImageData.h (lines 30-32). Its frames come from the
#       ImageCodecPlugin (platform/image_codec_plugin_luce.lucb decodes through luce-png and
#       luce-jpeg).
