#==============================================================================================
#
#   html_title_element - HTML::HTMLTitleElement: <title>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLTitleElement.cpp (lines 1-53) and HTMLTitleElement.h: the
#       constructor (which moves the mixin tables to HTMLTitleElement's, as C++'s vptrs move),
#       initialize, the title change notification to the page client, and the text attribute.
#
#==============================================================================================

## Ported from HTMLTitleElement.cpp:17 Web::HTML::HTMLTitleElement::HTMLTitleElement.
pub func html_title_element_construct(this: HtmlTitleElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLTitleElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_title_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_title_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_title_element_animatable_vtable
    element.global_event_handlers.vtable = &html_title_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_title_element_form_associated_element_vtable

## Ported from HTMLTitleElement.cpp:24 Web::HTML::HTMLTitleElement::initialize (override).
pub func html_title_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_title_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLTitleElement.cpp:30 Web::HTML::HTMLTitleElement::children_changed (override).
pub func html_title_element_children_changed_impl(base: DomNode*, metadata: DomNodeChildrenChangedMetadata):
    dom_element_children_changed_impl(base, metadata)
    let navigable_or_none = dom_node_navigable(base)
    if let navigable = navigable_or_none:
        if html_navigable_is_traversable(navigable):
            let traversable = html_navigable_traversable_navigable(navigable) else trap("a traversable navigable")
            page_client_page_did_change_title(page_client(html_navigable_page(traversable.html_navigable())), dom_document_title(dom_node_document(base)))

## Ported from HTMLTitleElement.cpp:40 Web::HTML::HTMLTitleElement::text.
# https://html.spec.whatwg.org/multipage/semantics.html#dom-title-text
pub func html_title_element_text(this: HtmlTitleElement*) -> ak.Utf16String:
    # The text attribute's getter must return this title element's child text content.
    return dom_node_child_text_content(this.dom_node())

## Ported from HTMLTitleElement.cpp:47 Web::HTML::HTMLTitleElement::set_text.
# https://html.spec.whatwg.org/multipage/semantics.html#dom-title-text
pub func html_title_element_set_text(this: HtmlTitleElement*, value: ak.Utf16String):
    # The text attribute's setter must string replace all with the given value within this title element.
    dom_node_string_replace_all(this.dom_node(), value)

## Ported from HTMLTitleElement.h:26 Web::HTML::HTMLTitleElement::is_html_title_element (override).
pub func html_title_element_is_html_title_element_impl(base: DomNode*) -> bool:
    return true
