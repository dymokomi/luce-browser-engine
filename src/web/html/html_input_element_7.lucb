## Ported from HTMLInputElement.cpp:3482 Web::HTML::HTMLInputElement::value_attribute_mode_for_type_state (static).
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:dom-input-value-2
func html_input_element_value_attribute_mode_for_type_state(type_state: HtmlInputElementTypeAttributeState) -> HtmlInputElementValueAttributeMode:
    match type_state:
        .text, .search, .telephone, .url, .email, .password, .date, .month, .week, .time, .local_date_and_time, .number, .range, .color:
            return HtmlInputElementValueAttributeMode.value

        .hidden, .submit_button, .image_button, .reset_button, .button:
            return HtmlInputElementValueAttributeMode.default

        .checkbox, .radio_button:
            return HtmlInputElementValueAttributeMode.default_on

        .file_upload:
            return HtmlInputElementValueAttributeMode.filename
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from HTMLInputElement.cpp:3519 Web::HTML::HTMLInputElement::value_attribute_mode.
func html_input_element_value_attribute_mode(this: HtmlInputElement*) -> HtmlInputElementValueAttributeMode:
    return html_input_element_value_attribute_mode_for_type_state(html_input_element_type_state(this))

## Ported from HTMLInputElement.cpp:3524 Web::HTML::HTMLInputElement::is_focusable (override).
pub func html_input_element_is_focusable_impl(base: DomEventTarget*) -> bool:
    let this = (HtmlInputElement*)base
    return this.m_type != HtmlInputElementTypeAttributeState.hidden and html_form_associated_element_enabled(html_input_element_form_associated(this))

## Ported from HTMLInputElement.cpp:3530 Web::HTML::HTMLInputElement::has_reversed_range.
# https://html.spec.whatwg.org/multipage/input.html#has-a-reversed-range
pub func html_input_element_has_reversed_range(this: HtmlInputElement*) -> bool:
    let minimum = html_input_element_min(this) else return false
    let maximum = html_input_element_max(this) else return false
    # An element has a reversed range if it has a periodic domain and its maximum is less than its minimum.
    return html_input_element_has_periodic_domain(this) and maximum < minimum
