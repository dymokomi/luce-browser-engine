## Ported from HTMLInputElement.cpp:3470 Web::HTML::HTMLInputElement::step_applies.
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:attr-input-step-3
pub func html_input_element_step_applies(this: HtmlInputElement*) -> bool:
    return html_input_element_value_as_number_applies(this)

## Ported from HTMLInputElement.cpp:3476 Web::HTML::HTMLInputElement::step_up_or_down_applies.
