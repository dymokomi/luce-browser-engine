## Ported from HTMLInputElement.cpp:3357 Web::HTML::HTMLInputElement::checked_applies (static).
# https://html.spec.whatwg.org/multipage/input.html#do-not-apply
pub func html_input_element_checked_applies_html_input_element_type_attrib(type_state: HtmlInputElementTypeAttributeState) -> bool:
    match type_state:
        .checkbox, .radio_button:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:3368 Web::HTML::HTMLInputElement::checked_applies.
pub func html_input_element_checked_applies(this: HtmlInputElement*) -> bool:
    return html_input_element_checked_applies_html_input_element_type_attrib(html_input_element_type_state(this))

## Ported from HTMLInputElement.cpp:3373 Web::HTML::HTMLInputElement::has_selectable_text.
pub func html_input_element_has_selectable_text(this: HtmlInputElement*) -> bool:
    # Potential FIXME: Date, Month, Week, Time and LocalDateAndTime are rendered as a basic text input for now,
    # thus they have selectable text, this need to change when we will have a visual date/time selector.

    match html_input_element_type_state(this):
        .text, .search, .telephone, .url, .password, .date, .month, .week, .time, .local_date_and_time, .number, .email:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:3397 Web::HTML::HTMLInputElement::selection_or_range_applies_for_type_state (static).
pub func html_input_element_selection_or_range_applies_for_type_state(type_state: HtmlInputElementTypeAttributeState) -> bool:
    match type_state:
        .text, .search, .telephone, .url, .password:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:3412 Web::HTML::HTMLInputElement::change_event_applies.
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:event-change-2
pub func html_input_element_change_event_applies(this: HtmlInputElement*) -> bool:
    match html_input_element_type_state(this):
        .checkbox, .color, .date, .email, .file_upload, .local_date_and_time, .month, .number, .password, .radio_button, .range, .search, .telephone, .text, .time, .url, .week:
            return true
        _:
            return false

