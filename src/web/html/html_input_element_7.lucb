## Ported from HTMLInputElement.cpp:3373 Web::HTML::HTMLInputElement::has_selectable_text.
pub func html_input_element_has_selectable_text(this: HtmlInputElement*) -> bool:
    # Potential FIXME: Date, Month, Week, Time and LocalDateAndTime are rendered as a basic text input for now,
    # thus they have selectable text, this need to change when we will have a visual date/time selector.

    match html_input_element_type_state(this):
        .text, .search, .telephone, .url, .password, .date, .month, .week, .time, .local_date_and_time, .number, .email:
            return true
        _:
            return false

