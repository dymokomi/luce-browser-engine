#==============================================================================================
#
#   html_input_element_7 - HTML::HTMLInputElement: roles, applicability, validity, inlines
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLInputElement.cpp (lines 3118-3916) and the inline functions of
#       HTMLInputElement.h: the default ARIA role, buttons and submit buttons, single-line
#       controls, the activation behavior, which IDL attributes and methods apply to which
#       states, the value mode of the value IDL attribute, focusability, reversed ranges, the
#       suffering-from states of constraint validation (with the valid email address regular
#       expression, a static kept in the C heap), pickers, mutability, button layout and the
#       selection stringifier.
#
#==============================================================================================

# mark: Role and buttons ========================================================================

## Ported from HTMLInputElement.cpp:3118 Web::HTML::HTMLInputElement::default_role (override).
pub func html_input_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    let this = (HtmlInputElement*)dom_element_from_aria_mixin(base)
    let type_state = html_input_element_type_state(this)
    # http://wpt.live/html-aam/roles-dynamic-switch.tentative.window.html "Disconnected <input type=checkbox switch>"
    if not dom_node_is_connected(this.dom_node()):
        return none
    # https://www.w3.org/TR/html-aria/#el-input-button
    if type_state == HtmlInputElementTypeAttributeState.button:
        return AriaRole.button
    # https://www.w3.org/TR/html-aria/#el-input-checkbox
    if type_state == HtmlInputElementTypeAttributeState.checkbox:
        # https://github.com/w3c/html-aam/issues/496
        if html_input_element_has_attribute(this, html_attribute_names_switch):
            return AriaRole.switch
        return AriaRole.checkbox
    # https://www.w3.org/TR/html-aria/#el-input-email
    if type_state == HtmlInputElementTypeAttributeState.email and not html_input_element_has_attribute(this, html_attribute_names_list):
        return AriaRole.textbox
    # https://www.w3.org/TR/html-aria/#el-input-image
    if type_state == HtmlInputElementTypeAttributeState.image_button:
        return AriaRole.button
    # https://www.w3.org/TR/html-aria/#el-input-number
    if type_state == HtmlInputElementTypeAttributeState.number:
        return AriaRole.spinbutton
    # https://www.w3.org/TR/html-aria/#el-input-radio
    if type_state == HtmlInputElementTypeAttributeState.radio_button:
        return AriaRole.radio
    # https://www.w3.org/TR/html-aria/#el-input-range
    if type_state == HtmlInputElementTypeAttributeState.range:
        return AriaRole.slider
    # https://www.w3.org/TR/html-aria/#el-input-reset
    if type_state == HtmlInputElementTypeAttributeState.reset_button:
        return AriaRole.button
    # https://www.w3.org/TR/html-aria/#el-input-text-list
    if (type_state == HtmlInputElementTypeAttributeState.text or type_state == HtmlInputElementTypeAttributeState.search or type_state == HtmlInputElementTypeAttributeState.telephone or type_state == HtmlInputElementTypeAttributeState.url or type_state == HtmlInputElementTypeAttributeState.email) and html_input_element_has_attribute(this, html_attribute_names_list):
        return AriaRole.combobox
    # https://www.w3.org/TR/html-aria/#el-input-search
    if type_state == HtmlInputElementTypeAttributeState.search and not html_input_element_has_attribute(this, html_attribute_names_list):
        return AriaRole.searchbox
    # https://www.w3.org/TR/html-aria/#el-input-submit
    if type_state == HtmlInputElementTypeAttributeState.submit_button:
        return AriaRole.button
    # https://www.w3.org/TR/html-aria/#el-input-tel
    if type_state == HtmlInputElementTypeAttributeState.telephone:
        return AriaRole.textbox
    # https://www.w3.org/TR/html-aria/#el-input-text
    if type_state == HtmlInputElementTypeAttributeState.text and not html_input_element_has_attribute(this, html_attribute_names_list):
        return AriaRole.textbox
    # https://www.w3.org/TR/html-aria/#el-input-url
    if type_state == HtmlInputElementTypeAttributeState.url and not html_input_element_has_attribute(this, html_attribute_names_list):
        return AriaRole.textbox

    # https://www.w3.org/TR/html-aria/#el-input-color
    # https://www.w3.org/TR/html-aria/#el-input-date
    # https://www.w3.org/TR/html-aria/#el-input-datetime-local
    # https://www.w3.org/TR/html-aria/#el-input-file
    # https://www.w3.org/TR/html-aria/#el-input-hidden
    # https://www.w3.org/TR/html-aria/#el-input-month
    # https://www.w3.org/TR/html-aria/#el-input-password
    # https://www.w3.org/TR/html-aria/#el-input-time
    # https://www.w3.org/TR/html-aria/#el-input-week
    return none

## Ported from HTMLInputElement.cpp:3187 Web::HTML::HTMLInputElement::is_button (override).
pub func html_input_element_is_button_impl(base: HtmlFormAssociatedElement*) -> bool:
    let this = html_input_element_from_form_associated_element(base)
    let type_state = html_input_element_type_state(this)
    # https://html.spec.whatwg.org/multipage/input.html#submit-button-state-(type=submit):concept-button
    # https://html.spec.whatwg.org/multipage/input.html#image-button-state-(type=image):concept-button
    # https://html.spec.whatwg.org/multipage/input.html#reset-button-state-(type=reset):concept-button
    # https://html.spec.whatwg.org/multipage/input.html#button-state-(type=button):concept-button
    return type_state == HtmlInputElementTypeAttributeState.submit_button or type_state == HtmlInputElementTypeAttributeState.image_button or type_state == HtmlInputElementTypeAttributeState.reset_button or type_state == HtmlInputElementTypeAttributeState.button

## Ported from HTMLInputElement.cpp:3199 Web::HTML::HTMLInputElement::is_submit_button (override).
pub func html_input_element_is_submit_button_impl(base: HtmlFormAssociatedElement*) -> bool:
    let this = html_input_element_from_form_associated_element(base)
    let type_state = html_input_element_type_state(this)
    # https://html.spec.whatwg.org/multipage/input.html#submit-button-state-(type=submit):concept-submit-button
    # https://html.spec.whatwg.org/multipage/input.html#image-button-state-(type=image):concept-submit-button
    return type_state == HtmlInputElementTypeAttributeState.submit_button or type_state == HtmlInputElementTypeAttributeState.image_button

## Ported from HTMLInputElement.cpp:3210 Web::HTML::HTMLInputElement::is_single_line.
# https://html.spec.whatwg.org/multipage/input.html#text-(type=text)-state-and-search-state-(type=search)
# https://html.spec.whatwg.org/multipage/input.html#password-state-(type=password)
# "one line plain text edit control"
pub func html_input_element_is_single_line(this: HtmlInputElement*) -> bool:
    let type_state = html_input_element_type_state(this)
    # NOTE: For web compatibility reasons, we consider other types
    #       in addition to Text, Search, and Password as single line inputs.
    return type_state == HtmlInputElementTypeAttributeState.text or type_state == HtmlInputElementTypeAttributeState.search or type_state == HtmlInputElementTypeAttributeState.password or type_state == HtmlInputElementTypeAttributeState.email or type_state == HtmlInputElementTypeAttributeState.telephone or type_state == HtmlInputElementTypeAttributeState.number

# mark: Activation ==============================================================================

## Ported from HTMLInputElement.cpp:3222 Web::HTML::HTMLInputElement::has_activation_behavior (override).
pub func html_input_element_has_activation_behavior_impl(base: DomEventTarget*) -> bool:
    discard(base)
    return true

## Ported from HTMLInputElement.cpp:3228 Web::HTML::HTMLInputElement::activation_behavior (override).
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:activation-behaviour
pub func html_input_element_activation_behavior_impl(base: DomEventTarget*, event: DomEvent*):
    let this = (HtmlInputElement*)base
    # The activation behavior for input elements are these steps:

    # 1. If element is not mutable, and element's type attribute is neither in the Checkbox nor in the Radio state, then return.
    if not html_input_element_is_mutable_impl(html_input_element_form_associated(this)) and this.m_type != HtmlInputElementTypeAttributeState.checkbox and this.m_type != HtmlInputElementTypeAttributeState.radio_button:
        return

    # 2. Run element's input activation behavior, if any, and do nothing otherwise.
    html_input_element_run_input_activation_behavior(this, event) else trap("FIXME: should propagate errors")

    # 3. If element has a form owner and element's type attribute is not in the Button state, then return.
    if html_input_element_form(this) != none and html_input_element_type_state(this) != HtmlInputElementTypeAttributeState.button:
        return

    # 4. Run the popover target attribute activation behavior given element and event's target.
    if let target = dom_event_target(event):
        if is_dom_node(target):
            html_popover_target_attributes_popover_target_activation_behaviour(this.dom_node(), as_dom_node(target))

## Ported from HTMLInputElement.cpp:3248 Web::HTML::HTMLInputElement::has_input_activation_behavior.
pub func html_input_element_has_input_activation_behavior(this: HtmlInputElement*) -> bool:
    match html_input_element_type_state(this):
        .checkbox, .color, .file_upload, .image_button, .radio_button, .reset_button, .submit_button:
            return true
        _:
            return false

# mark: What applies ============================================================================

## Ported from HTMLInputElement.cpp:3265 Web::HTML::HTMLInputElement::select_applies.
# https://html.spec.whatwg.org/multipage/input.html#do-not-apply
pub func html_input_element_select_applies(this: HtmlInputElement*) -> bool:
    match html_input_element_type_state(this):
        .button, .checkbox, .hidden, .image_button, .radio_button, .range, .reset_button, .submit_button:
            return false
        _:
            return true

## Ported from HTMLInputElement.cpp:3283 Web::HTML::HTMLInputElement::selection_or_range_applies.
