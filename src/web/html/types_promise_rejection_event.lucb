#==============================================================================================
#
#   types_promise_rejection_event - declarations of Libraries/LibWeb/HTML/PromiseRejectionEvent.h
#
#   DESCRIPTION:
#       PromiseRejectionEvent is outside the skeleton's closure; declared here by hand by region
#       p2r in the generator's shape. Like ToggleEvent it has its base's class id (Event's, 47),
#       so is<Event> holds for it, and is recognized by its ClassInfo. The init's GC::Root is
#       the plain pointer: an init lives on the stack, which is scanned (DESIGN.md §3.4).
#
#==============================================================================================

# mark: HtmlPromiseRejectionEventInit ===========================================================

## Web::HTML::PromiseRejectionEventInit (Libraries/LibWeb/HTML/PromiseRejectionEvent.h:18).
pub struct HtmlPromiseRejectionEventInit:
    pub var event_init: DomEventInit  # primary base
    pub var promise: JsObject*?  # GC::Root<JS::Object>
    pub var reason: JsValue  # C++ default: { JS::js_undefined() }

# mark: HtmlPromiseRejectionEvent ===============================================================

## Web::HTML::PromiseRejectionEvent (Libraries/LibWeb/HTML/PromiseRejectionEvent.h:23).
pub struct HtmlPromiseRejectionEvent: IsHtmlPromiseRejectionEvent, IsDomEvent, IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var event: DomEvent  # primary base
    pub var m_promise: JsObject*
    pub var m_reason: JsValue

    func html_promise_rejection_event() -> HtmlPromiseRejectionEvent*: return (HtmlPromiseRejectionEvent*)&self

    func dom_event() -> DomEvent*: return (DomEvent*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## Upcast to Web::HTML::PromiseRejectionEvent (implemented by every struct in its hierarchy).
pub interface IsHtmlPromiseRejectionEvent:
    func html_promise_rejection_event() -> HtmlPromiseRejectionEvent*

## The vtable of Web::HTML::PromiseRejectionEvent (it introduces no virtuals).
pub let html_promise_rejection_event_vtable: DomEventVTable = DomEventVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &html_promise_rejection_event_class, visit_edges = html_promise_rejection_event_visit_edges_impl), initialize = html_promise_rejection_event_initialize_impl)))

## Class information of Web::HTML::PromiseRejectionEvent: Event's class id (types_event).
pub let html_promise_rejection_event_class: ak.ClassInfo = ak.ClassInfo(name = "PromiseRejectionEvent", first_id = 47, last_id = 47, size = memory.size_of(HtmlPromiseRejectionEvent), vtable = (const void*)&html_promise_rejection_event_vtable)

## is<Web::HTML::PromiseRejectionEvent>: the cell's ClassInfo.
pub func is_html_promise_rejection_event[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &html_promise_rejection_event_class

## as_if<Web::HTML::PromiseRejectionEvent>.
pub func as_if_html_promise_rejection_event[P: gc.IsCell](p: P*) -> HtmlPromiseRejectionEvent*?:
    if is_html_promise_rejection_event(p): return (HtmlPromiseRejectionEvent*)p
    return none

## as<Web::HTML::PromiseRejectionEvent> (verify_cast).
pub func as_html_promise_rejection_event[P: gc.IsCell](p: P*) -> HtmlPromiseRejectionEvent*:
    return as_if_html_promise_rejection_event(p) else trap("as<Web::HTML::PromiseRejectionEvent> failed")

## realm.create<Web::HTML::PromiseRejectionEvent>(realm, event_name, event_init): allocate under DeferGC,
## construct, then initialize(realm).
pub func realm_create_html_promise_rejection_event(realm: Realm*, realm_: Realm*, event_name: ak.FlyString, event_init: HtmlPromiseRejectionEventInit) -> HtmlPromiseRejectionEvent*:
    let this = (HtmlPromiseRejectionEvent*)web_allocate_cell(realm, &html_promise_rejection_event_class)
    html_promise_rejection_event_construct(this, realm_, event_name, event_init)
    web_initialize_cell(this.cell(), realm)
    return this
