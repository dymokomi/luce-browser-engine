#==============================================================================================
#
#   shared_resource_request - HTML::SharedResourceRequest: one image fetch shared by a document
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/SharedResourceRequest.cpp (lines 1-239) and the inline functions of
#       SharedResourceRequest.h: the document's map from URLs to requests, fetching the
#       resource and its callbacks, and decoding the fetched bytes into image data (SVG or a
#       bitmap through the image codec plugin). Fetching and decoding are phase 2: the fetch,
#       the body reader and the decoders are closure stubs.
#
#==============================================================================================

# mark: Creation ================================================================================

## Ported from SharedResourceRequest.cpp:30 Web::HTML::SharedResourceRequest::get_or_create.
pub func html_shared_resource_request_get_or_create(realm: Realm*, page: Page*, url: web_url.Url) -> HtmlSharedResourceRequest*:
    let document = html_environment_settings_object_responsible_document(bind_principal_host_defined_environment_settings_object(realm)) else trap("VERIFY: a responsible document")
    let shared_resource_requests = dom_document_shared_resource_requests(document)
    if let existing = ak.hash_map_get_k(shared_resource_requests, url):
        return *existing else trap("a shared resource request")
    let request = realm_create_html_shared_resource_request(realm, page, url, document)
    _ = ak.hash_map_set(shared_resource_requests, url, request)
    return request

## Ported from SharedResourceRequest.cpp:42 Web::HTML::SharedResourceRequest::SharedResourceRequest.
pub func html_shared_resource_request_construct(this: HtmlSharedResourceRequest*, page: Page*, url: web_url.Url, document: DomDocument*):
    this.m_page = page
    this.m_url = url
    this.m_document = document

## Ported from SharedResourceRequest.cpp:51 Web::HTML::SharedResourceRequest::finalize (override).
pub func html_shared_resource_request_finalize_impl(base: gc.Cell*):
    let this = (HtmlSharedResourceRequest*)base
    gc.cell_finalize_impl(base)
    let document = this.m_document else trap("a shared resource request's document")
    let shared_resource_requests = dom_document_shared_resource_requests(document)
    _ = ak.hash_map_remove_k(shared_resource_requests, this.m_url)

## Ported from SharedResourceRequest.cpp:58 Web::HTML::SharedResourceRequest::visit_edges (override).
pub func html_shared_resource_request_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlSharedResourceRequest*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_fetch_controller)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.m_document)
    gc.cell_visitor_visit_t_2(visitor, this.m_page)
    for callback in ak.vector_span(&this.m_callbacks):
        gc.cell_visitor_visit_t(visitor, callback.on_finish)
        gc.cell_visitor_visit_t(visitor, callback.on_fail)
    gc.cell_visitor_visit_t(visitor, this.m_image_data)

# mark: Accessors ===============================================================================

