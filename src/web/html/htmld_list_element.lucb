#==============================================================================================
#
#   htmld_list_element - HTML::HTMLDListElement: <dl>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLDListElement.cpp (lines 1-28): the constructor (which moves the mixin tables
#       to HTMLDListElement's, as C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLDListElement.cpp:15 Web::HTML::HTMLDListElement::HTMLDListElement.
pub func html_htmld_list_element_construct(this: HtmlHtmldListElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLDListElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_htmld_list_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_htmld_list_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_htmld_list_element_animatable_vtable
    element.global_event_handlers.vtable = &html_htmld_list_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_htmld_list_element_form_associated_element_vtable

## Ported from HTMLDListElement.cpp:22 Web::HTML::HTMLDListElement::initialize (override).
pub func html_htmld_list_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.htmld_list_element)
    html_element_initialize_impl(base, realm)
