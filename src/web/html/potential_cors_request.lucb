## Ported from Libraries/LibWeb/HTML/PotentialCORSRequest.cpp:13 Web::HTML::create_potential_CORS_request.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#create-a-potential-cors-request
pub func html_create_potential_cors_request(vm: Vm*, url: web_url.Url, destination: FetchRequestDestination?, cors_attribute_state: HtmlCorsSettingAttribute,
                                            same_origin_fallback_flag: HtmlSameOriginFallbackFlag = HtmlSameOriginFallbackFlag.no) -> FetchRequest*:
    # 1. Let mode be "no-cors" if corsAttributeState is No CORS, and "cors" otherwise.
    var mode = FetchRequestMode.no_cors if cors_attribute_state == HtmlCorsSettingAttribute.no_cors else FetchRequestMode.cors

    # 2. If same-origin fallback flag is set and mode is "no-cors", set mode to "same-origin".
    if same_origin_fallback_flag == HtmlSameOriginFallbackFlag.yes and mode == FetchRequestMode.no_cors:
        mode = FetchRequestMode.same_origin

    # 3. Let credentialsMode be "include".
    var credentials_mode = FetchRequestCredentialsMode.include

    # 4. If corsAttributeState is Anonymous, set credentialsMode to "same-origin".
    if cors_attribute_state == HtmlCorsSettingAttribute.anonymous:
        credentials_mode = FetchRequestCredentialsMode.same_origin

    # 5. Return a new request whose URL is url, destination is destination, mode is mode, credentials mode is credentialsMode,
    #    and whose use-URL-credentials flag is set.
    let request = fetch_request_create(vm)
    fetch_request_set_url(request, url)
    fetch_request_set_destination(request, destination)
    fetch_request_set_mode(request, mode)
    fetch_request_set_credentials_mode(request, credentials_mode)
    fetch_request_set_use_url_credentials(request, true)

    return request
