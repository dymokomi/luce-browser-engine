#==============================================================================================
#
#   html_frame_set_element - HTML::HTMLFrameSetElement: <frameset>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLFrameSetElement.cpp (lines 1-69) and the is_html_frameset_element
#       inline of HTMLFrameSetElement.h: construction (which moves the mixin tables to
#       HTMLFrameSetElement's, as C++'s vptrs move, and sets up the WindowEventHandlers base),
#       the display adjustment, initialize, the window event handler attributes and the event
#       handler targets that map to the window.
#
#==============================================================================================

## Ported from HTMLFrameSetElement.cpp:19 Web::HTML::HTMLFrameSetElement::HTMLFrameSetElement.
pub func html_frame_set_element_construct(this: HtmlFrameSetElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The WindowEventHandlers base (no state), then the vptrs of the mixin bases move to
    # HTMLFrameSetElement's tables.
    this.window_event_handlers.vtable = &html_frame_set_element_window_event_handlers_vtable
    this.window_event_handlers.class_id = this.cell().class_id
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_frame_set_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_frame_set_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_frame_set_element_animatable_vtable
    element.global_event_handlers.vtable = &html_frame_set_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_frame_set_element_form_associated_element_vtable

## Ported from HTMLFrameSetElement.cpp:26 Web::HTML::HTMLFrameSetElement::adjust_computed_style (override).
pub func html_frame_set_element_adjust_computed_style_impl(base: DomElement*, style: CssComputedProperties*):
    # https://drafts.csswg.org/css-display-3/#unbox
    let display = css_computed_properties_display(style)
    if css_display_is_contents(&display):
        css_computed_properties_set_property(style, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.none_)).css_style_value())

## Ported from HTMLFrameSetElement.cpp:33 Web::HTML::HTMLFrameSetElement::initialize (override).
pub func html_frame_set_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_frame_set_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLFrameSetElement.cpp:39 Web::HTML::HTMLFrameSetElement::attribute_changed (override).
pub func html_frame_set_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    html_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    # ENUMERATE_WINDOW_EVENT_HANDLERS(__ENUMERATE)
    html_window_event_handler_attribute_changed(base.dom_event_target(), name, value)

## Ported from HTMLFrameSetElement.cpp:52 Web::HTML::HTMLFrameSetElement::global_event_handlers_to_event_target (override).
pub func html_frame_set_element_global_event_handlers_to_event_target_impl(base: HtmlGlobalEventHandlers*, event_name: ak.FlyString) -> DomEventTarget*?:
    let this = (HtmlFrameSetElement*)((u8*)base - memory.offset_of(HtmlElement, global_event_handlers))
    # NOTE: This is a little weird, but IIUC document.body.onload actually refers to window.onload
    # NOTE: document.body can return either a HTMLBodyElement or HTMLFrameSetElement, so both these elements must support this mapping.
    if dom_is_window_reflecting_body_element_event_handler(event_name):
        let window = dom_document_window(dom_node_document(this.dom_node())) else return none
        return window.dom_event_target()

    return this.dom_event_target()

## Ported from HTMLFrameSetElement.cpp:62 Web::HTML::HTMLFrameSetElement::window_event_handlers_to_event_target (override).
pub func html_frame_set_element_window_event_handlers_to_event_target_impl(base: HtmlWindowEventHandlers*) -> DomEventTarget*?:
    let this = (HtmlFrameSetElement*)((u8*)base - memory.offset_of(HtmlFrameSetElement, window_event_handlers))
    # All WindowEventHandlers on HTMLFrameSetElement (e.g. document.body.onrejectionhandled) are mapped to window.on{event}.
    # NOTE: document.body can return either a HTMLBodyElement or HTMLFrameSetElement, so both these elements must support this mapping.
    let window = dom_document_window(dom_node_document(this.dom_node())) else return none
    return window.dom_event_target()

## Ported from HTMLFrameSetElement.h:27 Web::HTML::HTMLFrameSetElement::is_html_frameset_element (override).
pub func html_frame_set_element_is_html_frameset_element_impl(base: DomNode*) -> bool:
    return true
