## Ported from HTMLTextAreaElement.h:36 Web::HTML::HTMLTextAreaElement::type.
## (C++ returns a function-local static String; a module global is not scanned by the collector,
## so the port makes the same value each time.)
pub func html_text_area_element_type(this: HtmlTextAreaElement*) -> ak.String:
    discard(this)
    return ak.string_from_str("textarea")

