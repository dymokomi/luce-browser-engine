#==============================================================================================
#
#   global_event_handlers_2 - HTML::GlobalEventHandlers: the event handler IDL attributes (onloadedmetadata to onwheel)
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/GlobalEventHandlers.cpp (lines 1-32): the setter and getter that
#       ENUMERATE_GLOBAL_EVENT_HANDLERS expands for each event handler IDL attribute, in the
#       macro's order (setter first). Each forwards to the event target the including class names
#       through the virtual global_event_handlers_to_event_target (EventTarget's event handler
#       attribute API, region r19). Continued from global_event_handlers_1.
#
#==============================================================================================

# mark: Event handler IDL attributes ============================================================

## Ported from GlobalEventHandlers.cpp:15 Web::HTML::GlobalEventHandlers::set_onloadedmetadata.
pub func html_global_event_handlers_set_onloadedmetadata(this: HtmlGlobalEventHandlers*, value: IdlCallbackType*?):
    if let event_target = html_global_event_handlers_global_event_handlers_to_event_target(this, html_event_names_loadedmetadata):
        dom_event_target_set_event_handler_attribute(event_target, html_event_names_loadedmetadata, value)

## Ported from GlobalEventHandlers.cpp:20 Web::HTML::GlobalEventHandlers::onloadedmetadata.
pub func html_global_event_handlers_onloadedmetadata(this: HtmlGlobalEventHandlers*) -> IdlCallbackType*?:
    if let event_target = html_global_event_handlers_global_event_handlers_to_event_target(this, html_event_names_loadedmetadata):
        return dom_event_target_event_handler_attribute(event_target, html_event_names_loadedmetadata)
    return none

