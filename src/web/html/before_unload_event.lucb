#==============================================================================================
#
#   before_unload_event - HTML::BeforeUnloadEvent: the beforeunload event a document fires
#                         before it is unloaded
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/BeforeUnloadEvent.cpp (lines 1-35) and BeforeUnloadEvent.h
#       (lines 1-34): an Event with a return value, which a beforeunload event handler's result
#       sets. Navigating a navigable that has a document (an iframe's, from its initial
#       about:blank) fires one. The prototype (WEB_SET_PROTOTYPE_FOR_INTERFACE) waits for the
#       bindings (P3).
#
#       Copyright (c) 2024, Tim Ledbetter <tim.ledbetter@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from BeforeUnloadEvent.cpp:15 Web::HTML::BeforeUnloadEvent::create.
pub func html_before_unload_event_create(realm: Realm*, event_name: ak.FlyString, event_init: DomEventInit = DomEventInit()) -> HtmlBeforeUnloadEvent*:
    let event = realm_create_html_before_unload_event(realm, realm, event_name, event_init)
    dom_event_set_is_trusted(event.dom_event(), true)
    return event

## Ported from BeforeUnloadEvent.cpp:22 Web::HTML::BeforeUnloadEvent::BeforeUnloadEvent.
pub func html_before_unload_event_construct(this: HtmlBeforeUnloadEvent*, realm: Realm*, event_name: ak.FlyString, event_init: DomEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init)

## Ported from BeforeUnloadEvent.cpp:29 Web::HTML::BeforeUnloadEvent::initialize (override).
pub func html_before_unload_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.before_unload_event)
    dom_event_initialize_impl(base, realm)

## Ported from BeforeUnloadEvent.h:25 Web::HTML::BeforeUnloadEvent::return_value.
pub func html_before_unload_event_return_value(this: HtmlBeforeUnloadEvent*) -> ak.String:
    return this.m_return_value

## Ported from BeforeUnloadEvent.h:26 Web::HTML::BeforeUnloadEvent::set_return_value.
pub func html_before_unload_event_set_return_value(this: HtmlBeforeUnloadEvent*, return_value: ak.String):
    this.m_return_value = return_value
