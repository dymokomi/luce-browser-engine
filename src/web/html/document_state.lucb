# mark: DocumentState ===========================================================================

## Ported from DocumentState.h:24 Web::HTML::DocumentState::create.
pub func html_document_state_create() -> HtmlDocumentState*:
    let this = new HtmlDocumentState(m_history_policy_container = HtmlSerializedPolicyContainerOrHtmlDocumentStateClient.html_document_state_client(HtmlDocumentStateClient.tag), m_request_referrer = FetchRequestReferrerType.fetch_request_referrer(FetchRequestReferrer.client), m_resource = EmptyOrStringOrHtmlPostResource.empty) else trap("out of memory")
    html_document_state_construct(this)
    return this

## Ported from DocumentState.cpp:13 Web::HTML::DocumentState::DocumentState (`= default`: the
## default member initializers).
pub func html_document_state_construct(this: HtmlDocumentState*):
    this.m_history_policy_container = HtmlSerializedPolicyContainerOrHtmlDocumentStateClient.html_document_state_client(HtmlDocumentStateClient.tag)
    this.m_request_referrer = FetchRequestReferrerType.fetch_request_referrer(FetchRequestReferrer.client)
    this.m_request_referrer_policy = referrer_policy_default_referrer_policy
    this.m_about_base_url = none
    this.m_resource = EmptyOrStringOrHtmlPostResource.empty
    this.m_reload_pending = false
    this.m_ever_populated = false

## Ported from DocumentState.h:36 Web::HTML::DocumentState::document_id.
