# mark: SessionHistoryEntry =====================================================================

## Ported from SessionHistoryEntry.cpp:15 Web::HTML::SessionHistoryEntry::create.
pub func html_session_history_entry_create() -> HtmlSessionHistoryEntry*:
    let this = new HtmlSessionHistoryEntry(m_step = I32OrHtmlSessionHistoryEntryPending.html_session_history_entry_pending(HtmlSessionHistoryEntryPending.tag), m_url = web_url.url_empty()) else trap("out of memory")
    html_session_history_entry_construct(this)
    return this

## Ported from SessionHistoryEntry.cpp:25 Web::HTML::SessionHistoryEntry::SessionHistoryEntry, with
## the default member initializers.
pub func html_session_history_entry_construct(this: HtmlSessionHistoryEntry*):
    this.m_step = I32OrHtmlSessionHistoryEntryPending.html_session_history_entry_pending(HtmlSessionHistoryEntryPending.tag)
    this.m_scroll_restoration_mode = HtmlScrollRestorationMode.auto
    this.m_classic_history_api_state = html_structured_serialize_for_storage(vm_the(), js_null()) else trap("MUST: structured_serialize_for_storage")
    this.m_navigation_api_state = html_structured_serialize_for_storage(vm_the(), js_undefined()) else trap("MUST: structured_serialize_for_storage")
    this.m_navigation_api_key = crypto_generate_random_uuid()
    this.m_navigation_api_id = crypto_generate_random_uuid()

## Ported from SessionHistoryEntry.h:40 Web::HTML::SessionHistoryEntry::step.
pub func html_session_history_entry_step(this: const HtmlSessionHistoryEntry*) -> I32OrHtmlSessionHistoryEntryPending:
    return this.m_step

