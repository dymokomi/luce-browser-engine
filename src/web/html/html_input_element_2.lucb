## Ported from HTMLInputElement.cpp:888 Web::HTML::HTMLInputElement::update_placeholder_visibility.
func html_input_element_update_placeholder_visibility(this: HtmlInputElement*):
    let placeholder_element = this.m_placeholder_element else return
    let inner_text_element = this.m_inner_text_element else trap("VERIFY: GC::Ptr<Element>::operator-> on null")
    if html_input_element_placeholder_value(this) != none:
        dom_element_set_inline_style(inner_text_element, html_inner_text_style_when_hidden())
        dom_element_set_inline_style(placeholder_element, html_placeholder_style_when_visible())
    else:
        dom_element_set_inline_style(inner_text_element, html_inner_text_style_when_visible())
        dom_element_set_inline_style(placeholder_element, html_placeholder_style_when_hidden())

# mark: Button and text shadow trees ============================================================

## Ported from HTMLInputElement.cpp:901 Web::HTML::HTMLInputElement::button_label.
func html_input_element_button_label(this: HtmlInputElement*) -> ak.Utf16String:
    var label: ak.Utf16String? = none
    if let value = html_input_element_get_attribute(this, html_attribute_names_value):
        label = ak.utf16_string_from_utf8_string(&value)

    if label == none:
        if html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.reset_button:
            # https://html.spec.whatwg.org/multipage/input.html#reset-button-state-(type=reset)
            # If the element has a value attribute, the button's label must be the value of that attribute;
            # otherwise, it must be an implementation-defined string that means "Reset" or some such.
            label = ak.utf16_string_from_str("Reset")
        elif html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.submit_button:
            # https://html.spec.whatwg.org/multipage/input.html#submit-button-state-(type=submit)
            # If the element has a value attribute, the button's label must be the value of that attribute;
            # otherwise, it must be an implementation-defined string that means "Submit" or some such.
            label = ak.utf16_string_from_str("Submit")
        else:
            # https://html.spec.whatwg.org/multipage/input.html#button-state-(type=button)
            # If the element has a value attribute, the button's label must be the value of that attribute;
            # otherwise, it must be the empty string.
            label = html_input_element_value(this)

    return label else trap("unreachable")

## Ported from HTMLInputElement.cpp:927 Web::HTML::HTMLInputElement::update_button_input_shadow_tree.
func html_input_element_update_button_input_shadow_tree(this: HtmlInputElement*):
    if let text_node = this.m_text_node:
        dom_character_data_set_data(text_node.dom_character_data(), html_input_element_button_label(this))
        html_input_element_update_placeholder_visibility(this)

## Ported from HTMLInputElement.cpp:935 Web::HTML::HTMLInputElement::update_text_input_shadow_tree.
func html_input_element_update_text_input_shadow_tree(this: HtmlInputElement*):
    if let text_node = this.m_text_node:
        dom_character_data_set_data(text_node.dom_character_data(), this.m_value)
        html_input_element_update_placeholder_visibility(this)

    if this.m_type == HtmlInputElementTypeAttributeState.number:
        let up_button_element = this.m_up_button_element else trap("VERIFY: GC::Ptr<Element>::operator-> on null")
        let down_button_element = this.m_down_button_element else trap("VERIFY: GC::Ptr<Element>::operator-> on null")
        # The `textfield` appearance is used to hide the stepper buttons.
        let style = dom_element_computed_properties(this.dom_element())
        if style != none and css_computed_properties_appearance(style else trap("unreachable")) == css_data.Appearance.textfield:
            dom_element_set_inline_style(up_button_element, html_stepper_button_style_when_hidden())
            dom_element_set_inline_style(down_button_element, html_stepper_button_style_when_hidden())
        else:
            dom_element_set_inline_style(up_button_element, html_stepper_button_style_when_visible())
            dom_element_set_inline_style(down_button_element, html_stepper_button_style_when_visible())

# mark: readonly, maxlength and the placeholder =================================================

## Ported from HTMLInputElement.cpp:955 Web::HTML::HTMLInputElement::is_allowed_to_be_readonly.
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:attr-input-readonly-3
pub func html_input_element_is_allowed_to_be_readonly(this: HtmlInputElement*) -> bool:
    match this.m_type:
        .text, .search, .telephone, .url, .email, .password, .date, .month, .week, .time, .local_date_and_time, .number:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:977 Web::HTML::is_applicable_for_maxlength_attribute.
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:attr-input-maxlength-3
func html_is_applicable_for_maxlength_attribute(state: HtmlInputElementTypeAttributeState) -> bool:
    match state:
        .text, .search, .telephone, .url, .email, .password:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:993 Web::HTML::HTMLInputElement::handle_maxlength_attribute.
# https://html.spec.whatwg.org/multipage/input.html#attr-input-maxlength
func html_input_element_handle_maxlength_attribute(this: HtmlInputElement*):
    # The maxlength attribute, when it applies, is a form control maxlength attribute.
    if let text_node = this.m_text_node:
        if html_is_applicable_for_maxlength_attribute(html_input_element_type_state(this)):
            let max_length = html_input_element_max_length(this)
            if max_length >= 0:
                dom_text_set_max_length(text_node, (u64)max_length)
            else:
                dom_text_set_max_length(text_node, none)

## Ported from HTMLInputElement.cpp:1007 Web::HTML::is_allowed_to_have_placeholder.
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:attr-input-placeholder-3
func html_is_allowed_to_have_placeholder(state: HtmlInputElementTypeAttributeState) -> bool:
    match state:
        .text, .search, .url, .telephone, .email, .password, .number:
            return true
        _:
            return false

## Ported from HTMLInputElement.cpp:1024 Web::HTML::HTMLInputElement::placeholder.
# https://html.spec.whatwg.org/multipage/input.html#attr-input-placeholder
pub func html_input_element_placeholder(this: HtmlInputElement*) -> ak.String:
    let placeholder = html_input_element_get_attribute(this, html_attribute_names_placeholder) else return ak.string_new()

    # The attribute, if specified, must have a value that contains no U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR) characters.
    var builder = ak.string_builder_new()
    let view = ak.string_bytes_as_string_view(&placeholder)
    for c in ak.string_view_bytes(&view):
        if c != '\r' and c != '\n':
            ak.string_builder_append_u8(&builder, c)
    return ak.string_from_string_builder(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from HTMLInputElement.cpp:1041 Web::HTML::HTMLInputElement::placeholder_value.
# https://html.spec.whatwg.org/multipage/input.html#attr-input-placeholder
pub func html_input_element_placeholder_value(this: HtmlInputElement*) -> ak.String?:
    let text_node = this.m_text_node else return none
    let data = dom_character_data_data(text_node.dom_character_data())
    if not html_utf16_is_empty(&data):
        return none
    if not html_is_allowed_to_have_placeholder(html_input_element_type_state(this)):
        return none
    if not html_input_element_has_attribute(this, html_attribute_names_placeholder):
        return none
    return html_input_element_placeholder(this)
