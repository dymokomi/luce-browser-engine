#==============================================================================================
#
#   image_request - HTML::ImageRequest: an img element's current and pending requests
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/ImageRequest.cpp (lines 1-131) and the inline functions of
#       ImageRequest.h: the request's state, current URL (which finds or makes the document's
#       shared resource request for it), image data, pixel density and density-corrected
#       dimensions, and aborting an image request. Fetching goes through
#       SharedResourceRequest (phase 2).
#
#==============================================================================================

## Ported from ImageRequest.cpp:27 Web::HTML::ImageRequest::create.
pub func html_image_request_create(realm: Realm*, page: Page*) -> HtmlImageRequest*:
    return realm_create_html_image_request(realm, page)

## Ported from ImageRequest.cpp:32 Web::HTML::ImageRequest::ImageRequest.
pub func html_image_request_construct(this: HtmlImageRequest*, page: Page*):
    html_image_request_init_fields(this)
    # An image request's current URL is initially the empty string.
    this.m_current_url = ak.string_new()
    this.m_page = page

## Ported from ImageRequest.cpp:41 Web::HTML::ImageRequest::visit_edges (override).
pub func html_image_request_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlImageRequest*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_shared_resource_request)
    gc.cell_visitor_visit_t_2(visitor, this.m_page)
    gc.cell_visitor_visit_t(visitor, this.m_image_data)

## Ported from ImageRequest.cpp:50 Web::HTML::ImageRequest::is_available.
# https://html.spec.whatwg.org/multipage/images.html#img-available
pub func html_image_request_is_available(this: HtmlImageRequest*) -> bool:
    # When an image request's state is either partially available or completely available, the image request is said to be available.
    return this.m_state == HtmlImageRequestState.partially_available or this.m_state == HtmlImageRequestState.completely_available

## Ported from ImageRequest.cpp:56 Web::HTML::ImageRequest::is_fetching.
pub func html_image_request_is_fetching(this: HtmlImageRequest*) -> bool:
    let shared_resource_request = this.m_shared_resource_request else return false
    return html_shared_resource_request_is_fetching(shared_resource_request)

## Ported from ImageRequest.cpp:61 Web::HTML::ImageRequest::state.
pub func html_image_request_state(this: HtmlImageRequest*) -> HtmlImageRequestState:
    return this.m_state

## Ported from ImageRequest.cpp:66 Web::HTML::ImageRequest::set_state.
pub func html_image_request_set_state(this: HtmlImageRequest*, state: HtmlImageRequestState):
    this.m_state = state

## Ported from ImageRequest.cpp:71 Web::HTML::ImageRequest::set_current_url.
pub func html_image_request_set_current_url(this: HtmlImageRequest*, realm: Realm*, url: ak.String):
    this.m_current_url = url

    if let parsed_url = domurl_parse(ak.string_bytes_as_string_view(&this.m_current_url)):
        this.m_shared_resource_request = html_shared_resource_request_get_or_create(realm, this.m_page, parsed_url)

## Ported from ImageRequest.cpp:80 Web::HTML::abort_the_image_request.
# https://html.spec.whatwg.org/multipage/images.html#abort-the-image-request
pub func html_abort_the_image_request(arg0: Realm*, image_request: HtmlImageRequest*?):
    # 1. If image request is null, then return.
    let request = image_request else return

    # 2. Forget image request's image data, if any.
    html_image_request_set_image_data(request, none)

    # 3. Abort any instance of the fetching algorithm for image request,
    #    discarding any pending tasks generated by that algorithm.
    # AD-HOC: We simply don't do this, since our SharedResourceRequest may be used by someone else.

## Ported from ImageRequest.cpp:94 Web::HTML::ImageRequest::image_data.
pub func html_image_request_image_data(this: HtmlImageRequest*) -> HtmlDecodedImageData*?:
    return this.m_image_data

## Ported from ImageRequest.cpp:99 Web::HTML::ImageRequest::set_image_data.
pub func html_image_request_set_image_data(this: HtmlImageRequest*, data: HtmlDecodedImageData*?):
    this.m_image_data = data

