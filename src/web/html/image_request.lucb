## Ported from ImageRequest.cpp:119 Web::HTML::ImageRequest::fetch_image.
pub func html_image_request_fetch_image(this: HtmlImageRequest*, realm: Realm*, request: FetchRequest*):
    let shared_resource_request = this.m_shared_resource_request else trap("VERIFY: m_shared_resource_request")
    html_shared_resource_request_fetch_resource(shared_resource_request, realm, request)

## Ported from ImageRequest.cpp:125 Web::HTML::ImageRequest::add_callbacks.
pub func html_image_request_add_callbacks(this: HtmlImageRequest*, on_finish: ak.Function0[unit], on_fail: ak.Function0[unit]):
    let shared_resource_request = this.m_shared_resource_request else trap("VERIFY: m_shared_resource_request")
    html_shared_resource_request_add_callbacks(shared_resource_request, on_finish, on_fail)

