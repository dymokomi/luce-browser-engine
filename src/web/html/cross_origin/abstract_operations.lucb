# mark: Reporting.cpp ===========================================================================

## The origins of the active documents of a browsing context's active document's inclusive
## ancestor navigables (steps 4 and 6 of check_if_access_between_two_browsing_contexts_should_be_reported).
func html_inclusive_ancestor_origins(browsing_context: HtmlBrowsingContext*) -> ak.Vector[web_url.Origin]:
    var origins = ak.Vector[web_url.Origin]()
    let active_document = html_browsing_context_active_document(browsing_context) else trap("VERIFY: an active document")
    var inclusive_ancestors = dom_document_ancestor_navigables(active_document)
    ak.vector_ensure_capacity(&origins, ak.vector_size(&inclusive_ancestors))
    for maybe_ancestor in ak.vector_span(&inclusive_ancestors):
        let ancestor = maybe_ancestor else trap("VERIFY: ancestor != nullptr")
        let ancestor_document = html_navigable_active_document(ancestor) else trap("VERIFY: ancestor->active_document() != nullptr")
        ak.vector_append_t(&origins, dom_document_origin(ancestor_document))
    return origins

## Ported from Reporting.cpp:20 Web::HTML::check_if_access_between_two_browsing_contexts_should_be_reported.
# https://html.spec.whatwg.org/multipage/origin.html#coop-check-access-report
pub func html_check_if_access_between_two_browsing_contexts_should_be_reported(accessor: HtmlBrowsingContext*?, accessed: HtmlBrowsingContext*?, property_key: JsPropertyKey, environment: HtmlEnvironmentSettingsObject*):
    # FIXME: Spec bug: https://github.com/whatwg/html/issues/10192
    let the_accessor = accessor else return
    let the_accessed = accessed else return

    # 1. If propertyKey is not a cross-origin accessible window property name, then return.
    if not html_is_cross_origin_accessible_window_property_name(property_key):
        return

    # 2. Assert: accessor's active document and accessed's active document are both fully active.
    assert(dom_document_is_fully_active(html_browsing_context_active_document(the_accessor) else trap("VERIFY: an active document")))
    assert(dom_document_is_fully_active(html_browsing_context_active_document(the_accessed) else trap("VERIFY: an active document")))

    # 3. Let accessorTopDocument be accessor's top-level browsing context's active document.
    let accessor_top_level = html_browsing_context_top_level_browsing_context(the_accessor) else trap("VERIFY: a top-level browsing context")
    let accessor_top_document = html_browsing_context_active_document(accessor_top_level) else trap("VERIFY: an active document")

    # 4. Let accessorInclusiveAncestorOrigins be the list obtained by taking the origin of the active document of each of accessor's active document's inclusive ancestor navigables.
    var accessor_inclusive_ancestor_origins = html_inclusive_ancestor_origins(the_accessor)

    # 5. Let accessedTopDocument be accessed's top-level browsing context's active document.
    let accessed_top_level = html_browsing_context_top_level_browsing_context(the_accessed) else trap("VERIFY: accessed->top_level_browsing_context() != nullptr")
    let accessed_top_document = html_browsing_context_active_document(accessed_top_level) else trap("VERIFY: an active document")

    # 6. Let accessedInclusiveAncestorOrigins be the list obtained by taking the origin of the active document of each of accessed's active document's inclusive ancestor navigables.
    var accessed_inclusive_ancestor_origins = html_inclusive_ancestor_origins(the_accessed)

    # 7. If any of accessorInclusiveAncestorOrigins are not same origin with accessorTopDocument's origin, or if any of accessedInclusiveAncestorOrigins are not same origin with accessedTopDocument's origin, then return.
    for origin in ak.vector_span(&accessor_inclusive_ancestor_origins):
        if not web_url.origin_is_same_origin(&origin, dom_document_origin(accessor_top_document)):
            return
    for origin in ak.vector_span(&accessed_inclusive_ancestor_origins):
        if not web_url.origin_is_same_origin(&origin, dom_document_origin(accessed_top_document)):
            return

    # 8. If accessor's top-level browsing context's virtual browsing context group ID is accessed's top-level browsing context's virtual browsing context group ID, then return.
    if html_browsing_context_virtual_browsing_context_group_id(accessor_top_level) == html_browsing_context_virtual_browsing_context_group_id(accessed_top_level):
        return

    # 9. Let accessorAccessedRelationship be a new accessor-accessed relationship with value none.
    var accessor_accessed_relationship = HtmlAccessorAccessedRelationship.none_

    # 10. If accessed's top-level browsing context's opener browsing context is accessor or is an ancestor of accessor, then set accessorAccessedRelationship to accessor is opener.
    if html_browsing_context_is_ancestor_of(the_accessor, html_browsing_context_opener_browsing_context(accessed_top_level) else trap("dereferencing a null opener browsing context")):
        accessor_accessed_relationship = HtmlAccessorAccessedRelationship.accessor_is_opener

    # 11. If accessor's top-level browsing context's opener browsing context is accessed or is an ancestor of accessed, then set accessorAccessedRelationship to accessor is openee.
    if html_browsing_context_is_ancestor_of(the_accessed, html_browsing_context_opener_browsing_context(accessor_top_level) else trap("dereferencing a null opener browsing context")):
        accessor_accessed_relationship = HtmlAccessorAccessedRelationship.accessor_is_opener

    # 12. Queue violation reports for accesses, given accessorAccessedRelationship, accessorTopDocument's opener policy, accessedTopDocument's opener policy, accessor's active document's URL, accessed's active document's URL, accessor's top-level browsing context's initial URL, accessed's top-level browsing context's initial URL, accessor's active document's origin, accessed's active document's origin, accessor's top-level browsing context's opener origin at creation, accessed's top-level browsing context's opener origin at creation, accessorTopDocument's referrer, accessedTopDocument's referrer, propertyKey, and environment.
    _ = environment
    _ = accessor_accessed_relationship
