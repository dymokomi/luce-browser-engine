# mark: AbstractOperations.cpp ==================================================================

## One { [[Property]], [[NeedsGet]], [[NeedsSet]] } record of CrossOriginProperties.
func html_cross_origin_property(property: str, needs_get: bool?, needs_set: bool?) -> HtmlCrossOriginProperty:
    return HtmlCrossOriginProperty(property = ak.string_from_str(property), needs_get = needs_get, needs_set = needs_set)

## Ported from AbstractOperations.cpp:26 Web::HTML::cross_origin_properties.
# 7.2.3.1 CrossOriginProperties ( O ), https://html.spec.whatwg.org/multipage/browsers.html#crossoriginproperties-(-o-)
pub func html_cross_origin_properties(object: HtmlLocationOrHtmlWindow) -> ak.Vector[HtmlCrossOriginProperty]:
    # 1. Assert: O is a Location or Window object.

    var properties = ak.Vector[HtmlCrossOriginProperty]()
    match object:
        # 2. If O is a Location object, then return « { [[Property]]: "href", [[NeedsGet]]: false, [[NeedsSet]]: true }, { [[Property]]: "replace" } ».
        .html_html_location(_):
            ak.vector_append_t(&properties, html_cross_origin_property("href", false, true))
            ak.vector_append_t(&properties, html_cross_origin_property("replace", none, none))
        # 3. Return « { [[Property]]: "window", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "self", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "location", [[NeedsGet]]: true, [[NeedsSet]]: true }, { [[Property]]: "close" }, { [[Property]]: "closed", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "focus" }, { [[Property]]: "blur" }, { [[Property]]: "frames", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "length", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "top", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "opener", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "parent", [[NeedsGet]]: true, [[NeedsSet]]: false }, { [[Property]]: "postMessage" } ».
        .html_window(_):
            ak.vector_append_t(&properties, html_cross_origin_property("window", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("self", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("location", true, true))
            ak.vector_append_t(&properties, html_cross_origin_property("close", none, none))
            ak.vector_append_t(&properties, html_cross_origin_property("closed", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("focus", none, none))
            ak.vector_append_t(&properties, html_cross_origin_property("blur", none, none))
            ak.vector_append_t(&properties, html_cross_origin_property("frames", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("length", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("top", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("opener", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("parent", true, false))
            ak.vector_append_t(&properties, html_cross_origin_property("postMessage", none, none))
    return properties

## Ported from AbstractOperations.cpp:59 Web::HTML::is_cross_origin_accessible_window_property_name.
# https://html.spec.whatwg.org/multipage/browsers.html#cross-origin-accessible-window-property-name
pub func html_is_cross_origin_accessible_window_property_name(property_key: JsPropertyKey) -> bool:
    # A JavaScript property name P is a cross-origin accessible window property name if it is "window", "self", "location", "close", "closed", "focus", "blur", "frames", "length", "top", "opener", "parent", "postMessage", or an array index property name.
    # (JS::PropertyKey's string and number forms exist with luce-js.)
    trap("unported (P3): Web::HTML::is_cross_origin_accessible_window_property_name (a JS::PropertyKey)")

## Ported from AbstractOperations.cpp:69 Web::HTML::cross_origin_property_fallback.
# 7.2.3.2 CrossOriginPropertyFallback ( P ), https://html.spec.whatwg.org/multipage/browsers.html#crossoriginpropertyfallback-(-p-)
pub func html_cross_origin_property_fallback(vm: Vm*, property_key: JsPropertyKey) -> JsPropertyDescriptor!:
    # 1. If P is "then", @@toStringTag, @@hasInstance, or @@isConcatSpreadable, then return PropertyDescriptor { [[Value]]: undefined, [[Writable]]: false, [[Enumerable]]: false, [[Configurable]]: true }.
    # 2. Throw a "SecurityError" DOMException.
    # (Property keys, well-known symbols and property descriptors exist with luce-js.)
    trap("unported (P3): Web::HTML::cross_origin_property_fallback (JS property keys and descriptors)")

## Ported from AbstractOperations.cpp:85 Web::HTML::is_platform_object_same_origin.
# 7.2.3.3 IsPlatformObjectSameOrigin ( O ), https://html.spec.whatwg.org/multipage/nav-history-apis.html#isplatformobjectsameorigin-(-o-)
pub func html_is_platform_object_same_origin(object: JsObject*) -> bool:
    # 1. Return true if the current settings object's origin is same origin-domain with O's relevant settings object's origin, and false otherwise.
    let current_origin = html_environment_settings_object_origin(html_current_settings_object())
    return web_url.origin_is_same_origin_domain(&current_origin, html_environment_settings_object_origin(html_relevant_settings_object_js_object(object)))

## Ported from AbstractOperations.cpp:92 Web::HTML::cross_origin_get_own_property_helper.
# 7.2.3.4 CrossOriginGetOwnPropertyHelper ( O, P ), https://html.spec.whatwg.org/multipage/nav-history-apis.html#crossorigingetownpropertyhelper-(-o,-p-)
pub func html_cross_origin_get_own_property_helper(object: HtmlLocationOrHtmlWindow, property_key: JsPropertyKey) -> JsPropertyDescriptor?:
    # 1. Let crossOriginKey be a tuple consisting of the current settings object, O's relevant settings object, and P.
    # 2. For each e of CrossOriginProperties(O): ... OrdinaryGetOwnProperty(O, P), anonymous built-in functions
    #    created in the current Realm Record ...
    # 3. Return undefined.
    # (Every step works on JS property keys, descriptors and functions, which exist with luce-js.)
    trap("unported (P3): Web::HTML::cross_origin_get_own_property_helper (JS property keys, descriptors and functions)")

