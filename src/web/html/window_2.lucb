# mark: Frames, top and opener ==================================================================

## Ported from Window.cpp:1048 Web::HTML::Window::frames.
# https://html.spec.whatwg.org/multipage/window-object.html#dom-frames
pub func html_window_frames(this: HtmlWindow*) -> HtmlWindowProxy*:
    # The window, frames, and self getter steps are to return this's relevant realm.[[GlobalEnv]].[[GlobalThisValue]].
    return as_html_window_proxy((gc.Cell*)realm_global_this_value(html_relevant_realm((JsObject*)this)))

## Ported from Window.cpp:1055 Web::HTML::Window::length.
# https://html.spec.whatwg.org/multipage/window-object.html#dom-length
pub func html_window_length(this: HtmlWindow*) -> u32:
    # The length getter steps are to return this's associated Document's document-tree child navigables's size.
    let navigables = dom_document_document_tree_child_navigables(html_window_associated_document(this))
    return (u32)ak.vector_size(&navigables)

## Ported from Window.cpp:1062 Web::HTML::Window::top.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-top
pub func html_window_top(this: HtmlWindow*) -> HtmlWindowProxy*?:
    # 1. If this's navigable is null, then return null.
    let navigable = html_window_navigable(this) else return none

    # 2. Return this's navigable's top-level traversable's active WindowProxy.
    let top = html_navigable_top_level_traversable(navigable) else trap("no top-level traversable")
    return html_navigable_active_window_proxy(top.html_navigable())

## Ported from Window.cpp:1074 Web::HTML::Window::opener.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-opener
pub func html_window_opener(this: HtmlWindow*) -> HtmlWindowProxy*?:
    # 1. Let current be this's browsing context.
    let current = html_window_browsing_context_const(this)

    # 2. If current is null, then return null.
    let context = current else return none

    # 3. If current's opener browsing context is null, then return null.
    let opener_browsing_context = html_browsing_context_opener_browsing_context(context) else return none

    # 4. Return current's opener browsing context's WindowProxy object.
    return html_browsing_context_window_proxy(opener_browsing_context)

## Ported from Window.cpp:1092 Web::HTML::Window::set_opener.
pub func html_window_set_opener(this: HtmlWindow*, value: JsValue) -> !:
    # 1. If the given value is null and this's browsing context is non-null, then set this's browsing context's opener browsing context to null.
    let browsing_context = html_window_browsing_context(this)
    if js_value_is_null(value):
        if let context = browsing_context:
            html_browsing_context_set_opener_browsing_context(context, none)

    # 2. If the given value is non-null, then perform ? DefinePropertyOrThrow(this, "opener", { [[Value]]: the given value, [[Writable]]: true, [[Enumerable]]: true, [[Configurable]]: true }).
    if not js_value_is_null(value):
        trap("unported (P3): Web::HTML::Window::set_opener (DefinePropertyOrThrow on the global object)")

    return
