# mark: User activation =========================================================================

## Ported from Window.cpp:554 Web::HTML::Window::has_sticky_activation.
# https://html.spec.whatwg.org/multipage/interaction.html#sticky-activation
pub func html_window_has_sticky_activation(this: HtmlWindow*) -> bool:
    # When the current high resolution time given W
    let current_time = high_resolution_time_current_high_resolution_time((JsObject*)this)

    # is greater than or equal to the last activation timestamp in W
    if current_time >= this.m_last_activation_timestamp:
        # W is said to have sticky activation.
        return true

    return false

## Window::has_transient_activation's transient_activation_duration_ms.
let html_window_transient_activation_duration_ms: f64 = 5000.0

## Ported from Window.cpp:569 Web::HTML::Window::has_transient_activation.
# https://html.spec.whatwg.org/multipage/interaction.html#transient-activation
pub func html_window_has_transient_activation(this: HtmlWindow*) -> bool:
    # The transient activation duration is expected be at most a few seconds, so that the user can possibly
    # perceive the link between an interaction with the page and the page calling the activation-gated API.

    # When the current high resolution time given W
    let current_time = high_resolution_time_current_high_resolution_time((JsObject*)this)

    # is greater than or equal to the last activation timestamp in W
    if current_time >= this.m_last_activation_timestamp:
        # and less than the last activation timestamp in W plus the transient activation duration
        if current_time < this.m_last_activation_timestamp + html_window_transient_activation_duration_ms:
            # then W is said to have transient activation.
            return true

    return false

## Ported from Window.cpp:591 Web::HTML::Window::has_history_action_activation.
# https://html.spec.whatwg.org/multipage/interaction.html#history-action-activation
pub func html_window_has_history_action_activation(this: HtmlWindow*) -> bool:
    # When the last history-action activation timestamp of W is not equal to the last activation timestamp of W, then W is said to have history-action activation.
    return this.m_last_history_action_activation_timestamp != this.m_last_activation_timestamp

## Steps 2-4 shared by the two consume steps: the active window of each inclusive descendant
## navigable of the window's navigable's top-level traversable's active document.
func html_window_windows_of_top_level_traversable(navigable: HtmlNavigable*) -> ak.Vector[HtmlWindow*?]:
    # 2. Let top be W's navigable's top-level traversable.
    let top = html_navigable_top_level_traversable(navigable) else trap("no top-level traversable")

    # 3. Let navigables be the inclusive descendant navigables of top's active document.
    let navigables = dom_document_inclusive_descendant_navigables(html_navigable_active_document(top.html_navigable()) else trap("no active document"))

    # 4. Let windows be the list of Window objects constructed by taking the active window of each item in navigables.
    var windows = ak.Vector[HtmlWindow*?]()
    for n in ak.vector_span_const(&navigables):
        ak.vector_append_t(&windows, html_navigable_active_window(n else trap("no navigable")))
    return windows

## Ported from Window.cpp:598 Web::HTML::Window::consume_history_action_user_activation.
# https://html.spec.whatwg.org/multipage/interaction.html#consume-history-action-user-activation
pub func html_window_consume_history_action_user_activation(this: HtmlWindow*):
    let navigable = html_window_navigable(this)

    # 1. If W's navigable is null, then return.
    let current = navigable else return

    # 2.-4. (top, navigables and windows)
    let windows = html_window_windows_of_top_level_traversable(current)

    # 5. For each window in windows, set window's last history-action activation timestamp to window's last activation timestamp.
    for window in ak.vector_span_const(&windows):
        let w = window else trap("no active window")
        html_window_set_last_history_action_activation_timestamp(w, html_window_last_activation_timestamp(w))

## Ported from Window.cpp:623 Web::HTML::Window::consume_user_activation.
# https://html.spec.whatwg.org/multipage/interaction.html#consume-user-activation
pub func html_window_consume_user_activation(this: HtmlWindow*):
    let navigable = html_window_navigable(this)

    # 1. If W's navigable is null, then return.
    let current = navigable else return

    # 2.-4. (top, navigables and windows)
    let windows = html_window_windows_of_top_level_traversable(current)

    # 5. For each window in windows, if window's last activation timestamp is not positive infinity, then set window's last activation timestamp to negative infinity.
    for window in ak.vector_span_const(&windows):
        let w = window else trap("no active window")
        if html_window_last_activation_timestamp(w) != math.infinity:
            html_window_set_last_activation_timestamp(w, -math.infinity)

# mark: Idle periods ============================================================================

## The idle-task task queued by start_an_idle_period and invoke_idle_callbacks (`[this] { invoke_idle_callbacks(); }`).
func html_window_invoke_idle_callbacks_task(context: void*?):
    html_window_invoke_idle_callbacks((HtmlWindow*)(context else trap("no window")))

## Ported from Window.cpp:650 Web::HTML::Window::start_an_idle_period.
# https://w3c.github.io/requestidlecallback/#start-an-idle-period-algorithm
pub func html_window_start_an_idle_period(this: HtmlWindow*):
    # 1. Optionally, if the user agent determines the idle period should be delayed, return from this algorithm.

    # 2. Let pending_list be window's list of idle request callbacks.
    let pending_list = &this.m_idle_request_callbacks
    # 3. Let run_list be window's list of runnable idle callbacks.
    let run_list = &this.m_runnable_idle_callbacks
    ak.vector_extend(run_list, pending_list)
    # 4. Clear pending_list.
    ak.vector_clear(pending_list)

    # FIXME: This might not agree with the spec, but currently we use 100% CPU if we keep queueing tasks
    if ak.vector_is_empty(run_list):
        return

    # 5. Queue a task on the queue associated with the idle-task task source,
    #    which performs the steps defined in the invoke idle callbacks algorithm with window and getDeadline as parameters.
    discard(html_queue_global_task(HtmlTaskSource.idle_task, (JsObject*)this, gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_window_invoke_idle_callbacks_task, context = this))))

## Ported from Window.cpp:674 Web::HTML::Window::invoke_idle_callbacks.
# https://w3c.github.io/requestidlecallback/#invoke-idle-callbacks-algorithm
func html_window_invoke_idle_callbacks(this: HtmlWindow*):
    let event_loop = html_main_thread_event_loop()
    # 1. If the user-agent believes it should end the idle period early due to newly scheduled high-priority work, return from the algorithm.
    # 2. Let now be the current time.
    let now = high_resolution_time_unsafe_shared_current_time()
    # 3. If now is less than the result of calling getDeadline and the window's list of runnable idle callbacks is not empty:
    if now < html_event_loop_compute_deadline(event_loop) and not ak.vector_is_empty(&this.m_runnable_idle_callbacks):
        let realm = bind_platform_object_realm(this.bind_platform_object())
        # 1. Pop the top callback from window's list of runnable idle callbacks.
        let callback = ak.vector_take_first(&this.m_runnable_idle_callbacks)
        # 2. Let deadlineArg be a new IdleDeadline whose [get deadline time algorithm] is getDeadline.
        let deadline_arg = request_idle_callback_idle_deadline_create(realm)
        # 3. Call callback with deadlineArg as its argument. If an uncaught runtime script error occurs, then report the exception.
        let result = html_idle_callback_invoke(callback, deadline_arg)
        if js_completion_is_error(&result):
            html_report_exception_js_completion(result, realm)
        # 4. If window's list of runnable idle callbacks is not empty, queue a task which performs the steps
        #    in the invoke idle callbacks algorithm with getDeadline and window as a parameters and return from this algorithm
        discard(html_queue_global_task(HtmlTaskSource.idle_task, (JsObject*)this, gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_window_invoke_idle_callbacks_task, context = this))))

# mark: The associated Document =================================================================

## Ported from Window.cpp:698 Web::HTML::Window::set_associated_document.
pub func html_window_set_associated_document(this: HtmlWindow*, document: DomDocument*):
    this.m_associated_document = document

## Ported from Window.cpp:703 Web::HTML::Window::set_current_event.
pub func html_window_set_current_event(this: HtmlWindow*, event: DomEvent*?):
    this.m_current_event = event

## Ported from Window.cpp:708 Web::HTML::Window::browsing_context.
pub func html_window_browsing_context_const(this: HtmlWindow*) -> HtmlBrowsingContext*?:
    return dom_document_browsing_context(this.m_associated_document else trap("no associated document"))

## Ported from Window.cpp:713 Web::HTML::Window::browsing_context.
pub func html_window_browsing_context(this: HtmlWindow*) -> HtmlBrowsingContext*?:
    return dom_document_browsing_context(this.m_associated_document else trap("no associated document"))

## Ported from Window.cpp:719 Web::HTML::Window::navigable.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#window-navigable
pub func html_window_navigable(this: HtmlWindow*) -> HtmlNavigable*?:
    # A Window's navigable is the navigable whose active document is the Window's associated Document's, or null if there is no such navigable.
    return dom_document_navigable(this.m_associated_document else trap("no associated document"))

# mark: PDF viewer objects ======================================================================

## Ported from Window.cpp:726 Web::HTML::Window::pdf_viewer_plugin_objects.
# https://html.spec.whatwg.org/multipage/system-state.html#pdf-viewer-plugin-objects
pub func html_window_pdf_viewer_plugin_objects(this: HtmlWindow*) -> ak.Vector[HtmlPlugin*]:
    # Each Window object has a PDF viewer plugin objects list. If the user agent's PDF viewer supported is false, then it is the empty list.
    # Otherwise, it is a list containing five Plugin objects, whose names are, respectively:
    # 0.   "PDF Viewer"
    # 1.   "Chrome PDF Viewer"
    # 2.   "Chromium PDF Viewer"
    # 3.   "Microsoft Edge PDF Viewer"
    # 4.   "WebKit built-in PDF"
    # The values of the above list form the PDF viewer plugin names list. https://html.spec.whatwg.org/multipage/system-state.html#pdf-viewer-plugin-names
    if not page_pdf_viewer_supported(html_window_page(this)):
        return ak.Vector[HtmlPlugin*]()

    if ak.vector_is_empty(&this.m_pdf_viewer_plugin_objects):
        let realm = bind_platform_object_realm(this.bind_platform_object())
        # FIXME: Propagate errors.
        ak.vector_append_t(&this.m_pdf_viewer_plugin_objects, realm_create_html_plugin(realm, realm, ak.string_from_str("PDF Viewer")))
        ak.vector_append_t(&this.m_pdf_viewer_plugin_objects, realm_create_html_plugin(realm, realm, ak.string_from_str("Chrome PDF Viewer")))
        ak.vector_append_t(&this.m_pdf_viewer_plugin_objects, realm_create_html_plugin(realm, realm, ak.string_from_str("Chromium PDF Viewer")))
        ak.vector_append_t(&this.m_pdf_viewer_plugin_objects, realm_create_html_plugin(realm, realm, ak.string_from_str("Microsoft Edge PDF Viewer")))
        ak.vector_append_t(&this.m_pdf_viewer_plugin_objects, realm_create_html_plugin(realm, realm, ak.string_from_str("WebKit built-in PDF")))

    return this.m_pdf_viewer_plugin_objects

## Ported from Window.cpp:752 Web::HTML::Window::pdf_viewer_mime_type_objects.
# https://html.spec.whatwg.org/multipage/system-state.html#pdf-viewer-mime-type-objects
pub func html_window_pdf_viewer_mime_type_objects(this: HtmlWindow*) -> ak.Vector[HtmlMimeType*]:
    # Each Window object has a PDF viewer mime type objects list. If the user agent's PDF viewer supported is false, then it is the empty list.
    # Otherwise, it is a list containing two MimeType objects, whose types are, respectively:
    # 0.   "application/pdf"
    # 1.   "text/pdf"
    # The values of the above list form the PDF viewer mime types list. https://html.spec.whatwg.org/multipage/system-state.html#pdf-viewer-mime-types
    if not page_pdf_viewer_supported(html_window_page(this)):
        return ak.Vector[HtmlMimeType*]()

    if ak.vector_is_empty(&this.m_pdf_viewer_mime_type_objects):
        let realm = bind_platform_object_realm(this.bind_platform_object())
        ak.vector_append_t(&this.m_pdf_viewer_mime_type_objects, realm_create_html_mime_type(realm, realm, ak.string_from_str("application/pdf")))
        ak.vector_append_t(&this.m_pdf_viewer_mime_type_objects, realm_create_html_mime_type(realm, realm, ak.string_from_str("text/pdf")))

    return this.m_pdf_viewer_mime_type_objects

