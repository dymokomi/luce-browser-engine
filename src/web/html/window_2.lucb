    html_s_test_mode = exposed

## Ported from Window.cpp:784 Web::HTML::Window::set_internals_object_exposed.
pub func html_window_set_internals_object_exposed(exposed: bool):
    html_s_internals_object_exposed = exposed

## Ported from Window.cpp:789 Web::HTML::Window::is_internals_object_exposed.
pub func html_window_is_internals_object_exposed() -> bool:
    return html_s_internals_object_exposed

## Ported from Window.cpp:794 Web::HTML::Window::initialize_web_interfaces.
pub func html_window_initialize_web_interfaces(this: HtmlWindow*) -> !:
    let realm = bind_platform_object_realm(this.bind_platform_object())
    # add_window_exposed_interfaces(*this): the interface objects are JS properties of the global
    # object, made by the bindings (phase 3).

    web_set_prototype_for_interface(this.js_cell(), realm, BindInterfaceName.window)

    # Bindings::WindowGlobalMixin::initialize(realm, *this) and
    # Bindings::WindowGlobalMixin::define_unforgeable_attributes(realm, *this): the global's JS
    # properties and unforgeable attributes come with the bindings (phase 3).
    html_window_or_worker_global_scope_mixin_initialize(&this.window_or_worker_global_scope_mixin, realm)

    # if (s_internals_object_exposed) define_direct_property("internals", realm.create<Internals::Internals>(realm), ...):
    # the internals object is a JS property of the global (phase 3, with the test runner's scripts).
    return

## Ported from Window.cpp:812 Web::HTML::Window::internal_set_prototype_of (override).
# https://webidl.spec.whatwg.org/#platform-object-setprototypeof
pub func html_window_internal_set_prototype_of_impl(this: HtmlWindow*, prototype: JsObject*?) -> bool!:
    # 1. Return ? SetImmutablePrototype(O, V).
    trap("unported (P3): Web::HTML::Window::internal_set_prototype_of (JS::Object::set_immutable_prototype)")

# mark: The window, document and name ===========================================================

## Ported from Window.cpp:819 Web::HTML::Window::window.
# https://html.spec.whatwg.org/multipage/window-object.html#dom-window
pub func html_window_window(this: HtmlWindow*) -> HtmlWindowProxy*:
    # The window, frames, and self getter steps are to return this's relevant realm.[[GlobalEnv]].[[GlobalThisValue]].
    return as_html_window_proxy((gc.Cell*)realm_global_this_value(html_relevant_realm((JsObject*)this)))

## Ported from Window.cpp:826 Web::HTML::Window::self.
# https://html.spec.whatwg.org/multipage/window-object.html#dom-self
pub func html_window_self(this: HtmlWindow*) -> HtmlWindowProxy*:
    # The window, frames, and self getter steps are to return this's relevant realm.[[GlobalEnv]].[[GlobalThisValue]].
    return as_html_window_proxy((gc.Cell*)realm_global_this_value(html_relevant_realm((JsObject*)this)))

## Ported from Window.cpp:833 Web::HTML::Window::document.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-document-2
pub func html_window_document(this: HtmlWindow*) -> DomDocument*:
    # The document getter steps are to return this's associated Document.
    return html_window_associated_document(this)

## Ported from Window.cpp:840 Web::HTML::Window::name.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-name
pub func html_window_name(this: HtmlWindow*) -> ak.String:
    # 1. If this's navigable is null, then return the empty string.
    let navigable = html_window_navigable(this) else return ak.String()

    # 2. Return this's navigable's target name.
    return html_navigable_target_name(navigable)

## Ported from Window.cpp:851 Web::HTML::Window::set_name.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#apis-for-creating-and-navigating-browsing-contexts-by-name:dom-name
pub func html_window_set_name(this: HtmlWindow*, name: ak.String):
    # 1. If this's navigable is null, then return.
    let navigable = html_window_navigable(this) else return

    # 2. Set this's navigable's active session history entry's document state's navigable target name to the given value.
    let entry = html_navigable_active_session_history_entry(navigable) else trap("no active session history entry")
    html_document_state_set_navigable_target_name(html_session_history_entry_document_state(entry) else trap("no document state"), name)

## Ported from Window.cpp:862 Web::HTML::Window::status.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-window-status
pub func html_window_status(this: HtmlWindow*) -> ak.String:
    # the status attribute on the Window object must, on getting, return the last string it was set to
    return this.m_status

# mark: Closing =================================================================================

## Window::close's queued task (`[traversable] { as<TraversableNavigable>(*traversable).definitely_close_top_level_traversable(); }`).
func html_window_definitely_close_task(context: void*?):
    let traversable = (HtmlNavigable*)(context else trap("no traversable"))
    html_traversable_navigable_definitely_close_top_level_traversable(as_html_traversable_navigable(traversable))

## Ported from Window.cpp:869 Web::HTML::Window::close.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-window-close
pub func html_window_close(this: HtmlWindow*):
    # 1. Let thisTraversable be this's navigable.
    let navigable = html_window_navigable(this)

    # 2. If thisTraversable is not a top-level traversable, then return.
    let traversable = navigable else return
    if not html_navigable_is_top_level_traversable(traversable):
        return

    # 3. If thisTraversable's is closing is true, then return.
    if html_navigable_is_closing(traversable):
        return

    # 4. Let browsingContext be thisTraversable's active browsing context.
    let browsing_context = html_navigable_active_browsing_context(traversable) else trap("no active browsing context")

    # 5. Let sourceSnapshotParams be the result of snapshotting source snapshot params given thisTraversable's active document.
    let source_snapshot_params = dom_document_snapshot_source_snapshot_params(html_navigable_active_document(traversable) else trap("no active document"))

    let incumbent_global_object = as_html_window((gc.Cell*)html_incumbent_global_object())

    # 6. If all the following are true:
    if (html_navigable_is_script_closable(traversable) and html_browsing_context_is_familiar_with(html_window_browsing_context(incumbent_global_object) else trap("no browsing context"), browsing_context) and html_navigable_allowed_by_sandboxing_to_navigate(html_window_navigable(incumbent_global_object) else trap("no navigable"), traversable, source_snapshot_params)):
        # thisTraversable is script-closable;
        # the incumbent global object's browsing context is familiar with browsingContext; and
        # the incumbent global object's navigable is allowed by sandboxing to navigate thisTraversable, given sourceSnapshotParams,
        # then:
        # 1. Set thisTraversable's is closing to true.
        html_navigable_set_closing(traversable, true)

        # 2. Queue a task on the DOM manipulation task source to definitely close thisTraversable.
        discard(html_queue_global_task(HtmlTaskSource.dom_manipulation, (JsObject*)incumbent_global_object, gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_window_definitely_close_task, context = traversable))))

## Ported from Window.cpp:913 Web::HTML::Window::closed.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-window-closed
pub func html_window_closed(this: HtmlWindow*) -> bool:
    # The closed getter steps are to return true if this's browsing context is null or its is closing is true;
    # otherwise false.
    if html_window_browsing_context_const(this) == none:
        return true

    # FIXME: The spec seems a bit out of date. The `is closing` flag is on the navigable, not the browsing context.
    let navigable = html_window_navigable(this) else return true
    if html_navigable_is_closing(navigable):
        return true

    return false

## Ported from Window.cpp:928 Web::HTML::Window::set_status.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-window-status
pub func html_window_set_status(this: HtmlWindow*, status: ak.String):
    # on setting, must set itself to the new value.
    this.m_status = status

# mark: Location, history, stop and focus =======================================================

## Ported from Window.cpp:935 Web::HTML::Window::location.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-location
pub func html_window_location(this: HtmlWindow*) -> HtmlHtmlLocation*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # The Window object's location getter steps are to return this's Location object.
    if this.m_location == none:
        this.m_location = realm_create_html_html_location(realm, realm)
    return this.m_location else trap("unreachable")

## Ported from Window.cpp:946 Web::HTML::Window::history.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-history
pub func html_window_history(this: HtmlWindow*) -> HtmlHistory*:
    # The history getter steps are to return this's associated Document's history object.
    return dom_document_history(html_window_associated_document(this))

## Ported from Window.cpp:953 Web::HTML::Window::stop.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-window-stop
pub func html_window_stop(this: HtmlWindow*):
    # 1. If this's navigable is null, then return.
    let navigable = html_window_navigable(this) else return

    # 2. Stop loading this's navigable.
    html_navigable_stop_loading(navigable)

## Ported from Window.cpp:965 Web::HTML::Window::focus.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-window-focus
pub func html_window_focus(this: HtmlWindow*):
    # 1. Let current be this's navigable.
    let navigable = html_window_navigable(this)

    # 2. If current is null, then return.
    let current = navigable else return

    # 3. If the allow focus steps given current's active document return false, then return.
    if not dom_document_allow_focus(html_window_document(this)):
        return

    # 4. Run the focusing steps with current.
    # FIXME: We should pass in the browsing context itself instead of the active document, however the focusing steps don't currently accept browsing contexts.
    #        Passing in a browsing context always makes it resolve to its active document for focus, so this is fine for now.
    if let document = html_navigable_active_document(current):
        html_run_focusing_steps(document.dom_node())
    else:
        html_run_focusing_steps(none)

    # FIXME: 5. If current is a top-level traversable, user agents are encouraged to trigger some sort of notification to
    #           indicate to the user that the page is attempting to gain focus.

## Ported from Window.cpp:988 Web::HTML::Window::blur.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-window-blur
pub func html_window_blur(this: HtmlWindow*):
    # The Window blur() method steps are to do nothing.
    return

# mark: Bar props ===============================================================================

## `if (!m_bar) m_bar = BarProp::create(realm()); return *m_bar;`.
func html_window_bar_prop(this: HtmlWindow*, bar: (HtmlBarProp*?)*) -> HtmlBarProp*:
    if *bar == none:
        *bar = html_bar_prop_create(bind_platform_object_realm(this.bind_platform_object()))

    return *bar else trap("unreachable")

