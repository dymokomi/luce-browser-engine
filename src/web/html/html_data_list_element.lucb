#==============================================================================================

## Ported from HTMLDataListElement.cpp:16 Web::HTML::HTMLDataListElement::HTMLDataListElement.
pub func html_data_list_element_construct(this: HtmlDataListElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLDataListElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_data_list_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_data_list_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_data_list_element_animatable_vtable
    element.global_event_handlers.vtable = &html_data_list_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_data_list_element_form_associated_element_vtable

## Ported from HTMLDataListElement.cpp:23 Web::HTML::HTMLDataListElement::initialize (override).
pub func html_data_list_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_data_list_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLDataListElement.cpp:29 Web::HTML::HTMLDataListElement::visit_edges (override).
pub func html_data_list_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlDataListElement*)base
    html_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t[DomHtmlCollection](visitor, this.m_options)

## The filter of the options collection: `is<HTML::HTMLOptionElement>(element)`.
func html_data_list_element_options_filter(context: void*?, element: DomElement*) -> bool:
    _ = context
    return is_html_option_element(element)

## Ported from HTMLDataListElement.cpp:36 Web::HTML::HTMLDataListElement::options.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-datalist-options
pub func html_data_list_element_options(this: HtmlDataListElement*) -> DomHtmlCollection*:
    # The options IDL attribute must return an HTMLCollection rooted at the datalist node, whose filter matches option elements.
    if this.m_options == none:
        this.m_options = dom_html_collection_create(this.dom_parent_node(), DomHtmlCollectionScope.descendants, ak.Function1[DomElement*, bool](call = html_data_list_element_options_filter, context = none), ak.Function2[DomElement*, DomElement*, bool]())
    return this.m_options else trap("unreachable")

## Ported from HTMLDataListElement.h:23 Web::HTML::HTMLDataListElement::default_role (override).
pub func html_data_list_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    _ = base
    return AriaRole.listbox
