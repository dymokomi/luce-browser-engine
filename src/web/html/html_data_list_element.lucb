#==============================================================================================
#
#   html_data_list_element - HTML::HTMLDataListElement: <datalist>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLDataListElement.cpp (lines 1-47) and the inline functions of
#       HTMLDataListElement.h: construction (which moves the mixin tables to
#       HTMLDataListElement's, as C++'s vptrs move), initialize, visit_edges, the options
#       collection and the default role.
