    ("2020-W01", 2020, 1),
    ("2020-W53", 2020, 53),
    ("2021-W53", 0, 0),
    ("2020-W00", 0, 0),
    ("2020-W1", 0, 0),
    ("2020-01", 0, 0),
    ("2020-W01x", 0, 0),
    ("0000-W01", 0, 0),
    ("2004-W53", 2004, 53),
]

