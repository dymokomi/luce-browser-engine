test "week_number_of_the_last_day over the centuries":
    for case in html_test_last_week_cases:
        assert(html_week_number_of_the_last_day(case.0) == case.1)

## Runs a valid-string check over a table.
func html_test_check_valid(cases: const HtmlTestValidCase[], check: func(ak.Utf16View) -> bool):
    for case in cases:
        let text = ak.utf16_string_from_str(case.input)
        assert(check(ak.utf16_string_base_utf16_view(&text.utf16_string_base)) == case.valid, case.input)

test "valid week, month, date, time and local date and time strings":
    html_test_check_valid(html_test_valid_week_cases, html_is_valid_week_string)
    html_test_check_valid(html_test_valid_month_cases, html_is_valid_month_string)
    html_test_check_valid(html_test_valid_date_cases, html_is_valid_date_string)
    html_test_check_valid(html_test_valid_time_cases, html_is_valid_time_string)
    html_test_check_valid(html_test_valid_local_date_and_time_cases, html_is_valid_local_date_and_time_string)

test "normalize_local_date_and_time_string drops zero seconds and trailing zero digits":
    for case in html_test_normalize_cases:
        let normalized = html_normalize_local_date_and_time_string(ak.utf16_string_from_str(case.0))
        assert(ak.utf16_string_base_eq_string_view(&normalized.utf16_string_base, ak.sv(case.1)), case.0)

test "parse_a_month_string and number_of_months_since_unix_epoch":
    for case in html_test_month_string_cases:
        let parsed = html_parse_a_month_string(ak.sv(case.0))
        if case.1 == 0:
            assert(parsed == none, case.0)
        else:
            let year_and_month = parsed else trap(case.0)
            assert(year_and_month.year == case.1 and year_and_month.month == case.2, case.0)
            assert(html_number_of_months_since_unix_epoch(year_and_month) == case.3, case.0)

test "parse_a_week_string":
    for case in html_test_week_string_cases:
        let parsed = html_parse_a_week_string(ak.sv(case.0))
        if case.1 == 0:
            assert(parsed == none, case.0)
        else:
            let week = parsed else trap(case.0)
            assert(week.week_year == case.1 and week.week == case.2, case.0)

test "parse_a_date_string":
    for case in html_test_date_string_cases:
        let parsed = html_parse_a_date_string(ak.sv(case.0))
        if case.1 == 0:
            assert(parsed == none, case.0)
        else:
            let date = parsed else trap(case.0)
            assert(date.year == case.1 and date.month == case.2 and date.day == case.3, case.0)

test "parse_a_local_date_and_time_string, with the donor's minute check (minutes up to 99 parse)":
    for case in html_test_local_date_and_time_cases:
        let parsed = html_parse_a_local_date_and_time_string(ak.sv(case.0))
        if case.1 == 0:
            assert(parsed == none, case.0)
        else:
            let value = parsed else trap(case.0)
            assert(value.date.year == case.1 and value.date.month == case.2 and value.date.day == case.3, case.0)
            assert(value.time.hour == case.4 and value.time.minute == case.5, case.0)
            assert(value.time.second.bits() == case.6, case.0)

test "parse_time_string: a TypeError when the time does not parse":
    let vm = web_test_create_vm()
    defer web_test_destroy_vm(vm)
    let realm = web_test_create_realm(vm)
    let inputs: str[3] = ["", "12:00x", "1:00"]
    for input in inputs:
        var failed = false
        _ = html_parse_time_string(realm, ak.sv(input)) catch:
            failed = true
            recover (JsDate*)realm
        assert(failed, input)
        let exception = idl_take_pending_exception()
        match exception:
            .idl_simple_exception(simple):
                assert(simple.type_ == IdlSimpleExceptionType.type_error)
            _: trap("expected a TypeError")

test "make_time: the milliseconds of a time component":
    assert(js_make_time(12.0, 30.0, 15.0, 250.0) == 45015250.0)
    assert(js_make_time(1.9, -0.5, 0.0, 0.0) == 3600000.0)
    assert(math.is_nan(js_make_time(math.infinity, 0.0, 0.0, 0.0)))
