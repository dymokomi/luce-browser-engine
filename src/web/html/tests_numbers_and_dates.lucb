#==============================================================================================
#
#   tests_numbers_and_dates - tests of HTML::Numbers and HTML::Dates (region r22)
#
#   DESCRIPTION:
#       Ports Ladybird's Tests/LibWeb/TestNumbers.cpp (parse_integer, parse_non_negative_integer,
#       is_valid_floating_point_number) and Tests/LibWeb/TestMicrosyntax.cpp
#       (week_number_of_the_last_day), then pins every other function of Numbers.cpp and
#       Dates.cpp to values printed by a local oracle that compiles the donor's Numbers.cpp and
#       Dates.cpp against the reference build's AK and LibJS: integer edge cases (signs, ranges,
#       whitespace, a non-ASCII digit), floating-point values as bits (fractions, exponents,
#       overflow, denormals, negative zero), the valid week / month / date / time / local date
#       and time strings, normalized local date and time strings, and the month, week, date and
#       local date and time parsers. Inputs on which the donor fails a VERIFY (a leading space in
#       a date string) are left out: the port traps there too.
#
#==============================================================================================

# mark: TestNumbers.cpp =========================================================================

## Whether `parse_integer(input)` is `expected`.
func html_test_parse_integer_is(input: str, expected: i32?) -> bool:
    return html_parse_integer(ak.sv(input)) == expected

## Whether `parse_non_negative_integer(input)` is `expected`.
func html_test_parse_non_negative_integer_is(input: str, expected: u32?) -> bool:
    return html_parse_non_negative_integer(ak.sv(input)) == expected

test "TestNumbers: parse_integer":
    assert(html_test_parse_integer_is("", none))
    assert(html_test_parse_integer_is("123", 123))
    assert(html_test_parse_integer_is(" 456", 456))
    assert(html_test_parse_integer_is("789 ", 789))
    assert(html_test_parse_integer_is("   22   ", 22))
    assert(html_test_parse_integer_is(" \n\t31\t\t\n\n", 31))
    assert(html_test_parse_integer_is("765foo", 765))
    assert(html_test_parse_integer_is("3;", 3))
    assert(html_test_parse_integer_is("foo765", none))
    assert(html_test_parse_integer_is("1", 1))
    assert(html_test_parse_integer_is("+2", 2))
    assert(html_test_parse_integer_is("-3", -3))

test "TestNumbers: parse_non_negative_integer and is_valid_floating_point_number":
    assert(html_test_parse_non_negative_integer_is("", none))
    assert(html_test_parse_non_negative_integer_is("123", 123))
    assert(html_test_parse_non_negative_integer_is(" 456", 456))
    assert(html_test_parse_non_negative_integer_is("789 ", 789))
    assert(html_test_parse_non_negative_integer_is("   22   ", 22))
    assert(html_test_parse_non_negative_integer_is(" \n\t31\t\t\n\n", 31))
    assert(html_test_parse_non_negative_integer_is("765foo", 765))
    assert(html_test_parse_non_negative_integer_is("3;", 3))
    assert(html_test_parse_non_negative_integer_is("foo765", none))
    assert(html_test_parse_non_negative_integer_is("1", 1))
    assert(html_test_parse_non_negative_integer_is("+2", 2))
    assert(html_test_parse_non_negative_integer_is("-3", none))

    assert(html_is_valid_floating_point_number_string_view(ak.sv("11")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("11.12")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("-11111")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("-11111.123")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("1e2")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("1E2")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("1e+2")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("1d+2")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("foobar")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv(".1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("1.")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("-0")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("Infinity")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("-Infinity")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("NaN")))
    assert(html_is_valid_floating_point_number_string_view(ak.sv("9007199254740993")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("1e")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("+1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("+")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("-")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("\t1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("\n1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("\u{c}1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("\r1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv(" 1")))
    assert(not html_is_valid_floating_point_number_string_view(ak.sv("1trailing junk")))

# mark: TestMicrosyntax.cpp =====================================================================

test "TestMicrosyntax: week_number_of_the_last_day":
    assert(html_week_number_of_the_last_day(1998) == 53)
    assert(html_week_number_of_the_last_day(1999) == 52)
    assert(html_week_number_of_the_last_day(2000) == 52)
    assert(html_week_number_of_the_last_day(2001) == 52)
    assert(html_week_number_of_the_last_day(2002) == 52)
    assert(html_week_number_of_the_last_day(2003) == 52)
    assert(html_week_number_of_the_last_day(2004) == 53)
    assert(html_week_number_of_the_last_day(2005) == 52)
    assert(html_week_number_of_the_last_day(2006) == 52)
    assert(html_week_number_of_the_last_day(2007) == 52)
    assert(html_week_number_of_the_last_day(2008) == 52)
    assert(html_week_number_of_the_last_day(2009) == 53)

# mark: Oracle values: Numbers ==================================================================

## The rules for parsing integers and non-negative integers: input, parse_integer, parse_non_negative_integer.
struct HtmlTestIntegerCase:
    let input: str
    let integer: i64?
    let non_negative: i64?

let html_test_integer_cases: HtmlTestIntegerCase[30] = [
    HtmlTestIntegerCase(input = "", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "123", integer = 123, non_negative = 123),
    HtmlTestIntegerCase(input = " 456", integer = 456, non_negative = 456),
    HtmlTestIntegerCase(input = "789 ", integer = 789, non_negative = 789),
    HtmlTestIntegerCase(input = "   22   ", integer = 22, non_negative = 22),
    HtmlTestIntegerCase(input = " \n\t31\t\t\n\n", integer = 31, non_negative = 31),
    HtmlTestIntegerCase(input = "765foo", integer = 765, non_negative = 765),
    HtmlTestIntegerCase(input = "3;", integer = 3, non_negative = 3),
    HtmlTestIntegerCase(input = "foo765", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "1", integer = 1, non_negative = 1),
    HtmlTestIntegerCase(input = "+2", integer = 2, non_negative = 2),
    HtmlTestIntegerCase(input = "-3", integer = -3, non_negative = none),
    HtmlTestIntegerCase(input = "-0", integer = 0, non_negative = 0),
    HtmlTestIntegerCase(input = "-01", integer = -1, non_negative = 4294967295),
    HtmlTestIntegerCase(input = "2147483647", integer = 2147483647, non_negative = 2147483647),
    HtmlTestIntegerCase(input = "2147483648", integer = none, non_negative = 2147483648),
    HtmlTestIntegerCase(input = "-2147483648", integer = -2147483648, non_negative = none),
    HtmlTestIntegerCase(input = "-2147483649", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "4294967295", integer = none, non_negative = 4294967295),
    HtmlTestIntegerCase(input = "4294967296", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "99999999999999999999", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "\u{c}12", integer = 12, non_negative = 12),
    HtmlTestIntegerCase(input = "\n7", integer = 7, non_negative = 7),
    HtmlTestIntegerCase(input = "\u{b}8", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "+", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "-", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = "00012", integer = 12, non_negative = 12),
    HtmlTestIntegerCase(input = "+-1", integer = none, non_negative = none),
    HtmlTestIntegerCase(input = " -0x10", integer = 0, non_negative = 0),
    HtmlTestIntegerCase(input = "\u{ff11}\u{ff12}", integer = none, non_negative = none),
]

