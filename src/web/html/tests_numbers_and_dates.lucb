## parse_a_month_string: input, year, month and the months since the epoch (year 0 = failure).
let html_test_month_string_cases: (str, u32, u32, i32)[12] = [
    ("2020-01", 2020, 1, 600),
    ("2020-12", 2020, 12, 611),
    ("2020-13", 0, 0, 0),
    ("0000-01", 0, 0, 0),
    ("999-01", 0, 0, 0),
    ("12345-06", 12345, 6, 124505),
    ("2020-1", 0, 0, 0),
    ("2020-01x", 0, 0, 0),
    ("99999999999-01", 0, 0, 0),
    ("2020-00", 0, 0, 0),
    ("4294967295-01", 4294967295, 1, -23652),
    ("4294967296-01", 0, 0, 0),
]

## parse_a_week_string: input, week-year and week (0 = failure).
