## A validity check: input and whether it is valid.
struct HtmlTestValidCase:
    let input: str
    let valid: bool

let html_test_valid_float_cases: HtmlTestValidCase[31] = [
    HtmlTestValidCase(input = "11", valid = true),
    HtmlTestValidCase(input = "11.12", valid = true),
    HtmlTestValidCase(input = "-11111", valid = true),
    HtmlTestValidCase(input = "-11111.123", valid = true),
    HtmlTestValidCase(input = "1e2", valid = true),
    HtmlTestValidCase(input = "1E2", valid = true),
    HtmlTestValidCase(input = "1e+2", valid = true),
    HtmlTestValidCase(input = "1d+2", valid = false),
    HtmlTestValidCase(input = "foobar", valid = false),
    HtmlTestValidCase(input = ".1", valid = true),
    HtmlTestValidCase(input = "1.", valid = false),
    HtmlTestValidCase(input = "-0", valid = true),
    HtmlTestValidCase(input = "Infinity", valid = false),
    HtmlTestValidCase(input = "-Infinity", valid = false),
    HtmlTestValidCase(input = "NaN", valid = false),
    HtmlTestValidCase(input = "9007199254740993", valid = true),
    HtmlTestValidCase(input = "1e", valid = false),
    HtmlTestValidCase(input = "+1", valid = false),
    HtmlTestValidCase(input = "+", valid = false),
    HtmlTestValidCase(input = "-", valid = false),
    HtmlTestValidCase(input = "\t1", valid = false),
    HtmlTestValidCase(input = "\n1", valid = false),
    HtmlTestValidCase(input = "\u{c}1", valid = false),
    HtmlTestValidCase(input = "\n1", valid = false),
    HtmlTestValidCase(input = " 1", valid = false),
    HtmlTestValidCase(input = "1trailing junk", valid = false),
    HtmlTestValidCase(input = "-.5", valid = true),
    HtmlTestValidCase(input = "1e-5", valid = true),
    HtmlTestValidCase(input = "1E+05", valid = true),
    HtmlTestValidCase(input = "0.0e0", valid = true),
    HtmlTestValidCase(input = "", valid = false),
]

test "parse_integer and parse_non_negative_integer: signs, ranges, whitespace and non-ASCII digits":
    for case in html_test_integer_cases:
        let integer = html_parse_integer(ak.sv(case.input))
        if let expected = case.integer:
            assert(integer == (i32)expected, case.input)
        else:
            assert(integer == none, case.input)
        let non_negative = html_parse_non_negative_integer(ak.sv(case.input))
        if let expected = case.non_negative:
            assert(non_negative == (u32)expected, case.input)
        else:
            assert(non_negative == none, case.input)

test "parse_floating_point_number: fractions, exponents, overflow, denormals and negative zero":
    for case in html_test_float_cases:
        let value = html_parse_floating_point_number_string_view(ak.sv(case.input))
        if let expected = case.bits:
            let parsed = value else trap(case.input)
            assert(parsed.bits() == expected, case.input)
            # The UTF-16 overload reads the same ASCII text.
            let from_utf16 = html_parse_floating_point_number_utf16_string(ak.utf16_string_from_str(case.input)) else trap(case.input)
            assert(from_utf16.bits() == expected, case.input)
        else:
            assert(value == none, case.input)

test "parse_floating_point_number and is_valid_floating_point_number of UTF-16 storage fail":
    let text = ak.utf16_string_from_str("1.5\u{e9}")
    assert(html_parse_floating_point_number_utf16_string(text) == none)
    assert(not html_is_valid_floating_point_number_utf16_string(text))

test "is_valid_floating_point_number":
    for case in html_test_valid_float_cases:
        assert(html_is_valid_floating_point_number_string_view(ak.sv(case.input)) == case.valid, case.input)
        assert(html_is_valid_floating_point_number_utf16_string(ak.utf16_string_from_str(case.input)) == case.valid, case.input)

test "convert_non_negative_integer_to_string: IndexSizeError below zero":
    let vm = web_test_create_vm()
    defer web_test_destroy_vm(vm)
    let realm = web_test_create_realm(vm)
    let zero = html_convert_non_negative_integer_to_string(realm, 0) else trap("0 is non-negative")
    assert(ak.string_eq_string_view(&zero, ak.sv("0")))
    let large = html_convert_non_negative_integer_to_string(realm, 2147483647) else trap("i32 max is non-negative")
    assert(ak.string_eq_string_view(&large, ak.sv("2147483647")))
    var failed = false
    _ = html_convert_non_negative_integer_to_string(realm, -1) catch:
        failed = true
        recover ak.string_new()
    assert(failed)
    let exception = idl_take_pending_exception()
    match exception:
        .idl_dom_exception(dom_exception):
            let name = idl_dom_exception_name(dom_exception)
            assert(ak.fly_string_eq_string_view(&name, ak.sv("IndexSizeError")))
        _: trap("expected a DOMException")

