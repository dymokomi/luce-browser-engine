# mark: Construction ============================================================================

## The button element of its FormAssociatedElement base (C++'s `this` adjustment).
func html_button_element_from_form_associated_element(base: HtmlFormAssociatedElement*) -> HtmlButtonElement*:
    return (HtmlButtonElement*)((u8*)base - memory.offset_of(HtmlElement, form_associated_element))

## Ported from HTMLButtonElement.cpp:21 Web::HTML::HTMLButtonElement::HTMLButtonElement.
pub func html_button_element_construct(this: HtmlButtonElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLButtonElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_button_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_button_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_button_element_animatable_vtable
    element.global_event_handlers.vtable = &html_button_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_button_element_form_associated_element_vtable

## Ported from HTMLButtonElement.cpp:28 Web::HTML::HTMLButtonElement::initialize (override).
pub func html_button_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_button_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLButtonElement.cpp:34 Web::HTML::HTMLButtonElement::adjust_computed_style (override).
pub func html_button_element_adjust_computed_style_impl(base: DomElement*, style: CssComputedProperties*):
    _ = base
    # https://html.spec.whatwg.org/multipage/rendering.html#button-layout
    # If the computed value of 'display' is 'inline-grid', 'grid', 'inline-flex', 'flex', 'none', or 'contents', then behave as the computed value.
    let display = css_computed_properties_display(style)
    if css_display_is_flex_inside(&display) or css_display_is_grid_inside(&display) or css_display_is_none(&display) or css_display_is_contents(&display):
        # No-op
        _ = display
    elif css_display_is_inline_outside(&display):
        # Otherwise, if the computed value of 'display' is a value such that the outer display type is 'inline', then behave as 'inline-block'.
        # AD-HOC: See https://github.com/whatwg/html/issues/11857
        css_computed_properties_set_property(style, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.inline_block)).css_style_value())
    else:
        # Otherwise, behave as 'flow-root'.
        css_computed_properties_set_property(style, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.flow_root)).css_style_value())

# mark: The type attribute ======================================================================

## The keywords of ENUMERATE_HTML_BUTTON_TYPE_ATTRIBUTES, in the order of TypeAttributeState.
let html_button_element_type_keywords: str[4] = ["submit", "reset", "button", "auto"]

## Ported from HTMLButtonElement.cpp:51 Web::HTML::HTMLButtonElement::type_state.
pub func html_button_element_type_state(this: HtmlButtonElement*) -> HtmlButtonElementTypeAttributeState:
    let value = dom_element_get_attribute_value(this.dom_element(), html_attribute_names_type)

    for (index, keyword) in html_button_element_type_keywords.indexed():
        if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv(keyword)):
            return (HtmlButtonElementTypeAttributeState)(i32)index

    # The attribute's missing value default and invalid value default are both the Auto state.
    # https://html.spec.whatwg.org/multipage/form-elements.html#attr-button-type-auto-state
    return HtmlButtonElementTypeAttributeState.auto

## Ported from HTMLButtonElement.cpp:67 Web::HTML::HTMLButtonElement::type_for_bindings.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-button-type
pub func html_button_element_type_for_bindings(this: HtmlButtonElement*) -> ak.String:
    # The type getter steps are:
    # 1. If this is a submit button, then return "submit".
    if html_button_element_is_submit_button_impl(&this.html_element_base.form_associated_element):
        return ak.string_from_str("submit")

    # 2. Let state be this's type attribute.
    let state = html_button_element_type_state(this)

    # 3. Assert: state is not in the Submit Button state.
    assert(state != HtmlButtonElementTypeAttributeState.submit)

    # 4. If state is in the Auto state, then return "button".
    if state == HtmlButtonElementTypeAttributeState.auto:
        return ak.string_from_str("button")

    # 5. Return the keyword value corresponding to state.
    let index = (usize)(i32)state
    if index < html_button_element_type_keywords.length:
        return ak.string_from_str(html_button_element_type_keywords[index])
    trap("VERIFY_NOT_REACHED")

## Ported from HTMLButtonElement.cpp:96 Web::HTML::HTMLButtonElement::set_type_for_bindings.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-button-type
pub func html_button_element_set_type_for_bindings(this: HtmlButtonElement*, type_: ak.String):
    # The type setter steps are to set the type content attribute to the given value.
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_type, type_)

