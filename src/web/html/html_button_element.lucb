## Ported from HTMLButtonElement.cpp:107 Web::HTML::HTMLButtonElement::visit_edges (override).
pub func html_button_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlButtonElement*)base
    html_element_visit_edges_impl(base, visitor)
    html_popover_target_attributes_visit_edges(&this.popover_target_attributes, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_command_for_element)

