## The copy assignment of a FACESubmissionValue (C++ copies the variant, and so its list of entries):
## a list of entries is cloned so the element's list does not share the caller's storage.
func html_face_submission_value_clone(value: HtmlFormAssociatedElementFaceSubmissionValue) -> HtmlFormAssociatedElementFaceSubmissionValue:
    match value:
        .vector_xhr_form_data_entry(entries):
            return HtmlFormAssociatedElementFaceSubmissionValue.vector_xhr_form_data_entry(ak.vector_clone(&entries))
        _:
            return value

## The File of a FACESubmissionValue holding one (the visitor's `[&](GC::Ref<FileAPI::File>)` arm).
func html_face_submission_value_file(value: HtmlFormAssociatedElementFaceSubmissionValue) -> FileApiFile*?:
    return match value:
        .file_api_file(file) => file
        _ => none

## Ported from FormAssociatedElement.cpp:620 Web::HTML::FormAssociatedElement::visit_edges.
pub func html_form_associated_element_visit_edges(this: HtmlFormAssociatedElement*, visitor: gc.CellVisitor*):
    if let file = html_face_submission_value_file(this.m_face_submission_value):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)file)  # FileAPI::File is opaque in phase 1

    if let file = html_face_submission_value_file(this.m_face_state):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)file)  # FileAPI::File is opaque in phase 1

