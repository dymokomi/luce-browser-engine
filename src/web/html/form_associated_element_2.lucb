## Ported from FormAssociatedElement.cpp:588 Web::HTML::FormAssociatedElement::suffering_from_a_custom_error.
# https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#suffering-from-a-custom-error
pub func html_form_associated_element_suffering_from_a_custom_error(this: HtmlFormAssociatedElement*) -> bool:
    # When a control's custom validity error message (as set by the element's setCustomValidity() method or ElementInternals's setValidity() method) is not the empty
    # string.
    return not ak.string_is_empty(&this.m_custom_validity_error_message)

