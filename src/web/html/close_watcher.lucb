## The CloseWatcher constructor: only script calls it.
# https://html.spec.whatwg.org/multipage/interaction.html#dom-closewatcher
pub func html_close_watcher_construct_impl(realm: Realm*, options: const HtmlCloseWatcherOptions*) -> HtmlCloseWatcher*!:
    trap("unported (P3): Web::HTML::CloseWatcher::construct_impl (new CloseWatcher() from script)")

## Ported from Libraries/LibWeb/HTML/CloseWatcher.cpp:87 Web::HTML::CloseWatcher::CloseWatcher.
pub func html_close_watcher_construct(this: HtmlCloseWatcher*, realm: Realm*, get_enabled_state: gc.Function0[bool]*):
    dom_event_target_construct(this.dom_event_target(), realm)
    html_close_watcher_init_fields(this)
    this.m_get_enabled_state = get_enabled_state

