## Ported from Libraries/LibWeb/HTML/CloseWatcher.cpp:214 Web::HTML::CloseWatcher::visit_edges (override).
pub func html_close_watcher_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlCloseWatcher*)base
    dom_event_target_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_get_enabled_state)
