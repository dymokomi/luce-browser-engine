#==============================================================================================
#
#   close_watcher - HTML::CloseWatcher: what the dialog and popover steps establish
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/CloseWatcher.cpp (lines 1-220) as far as phase 1 needs:
#       establishing a close watcher (a non-modal <dialog> and a popover do), requesting to
#       close it (its cancel and close actions are event listeners the caller adds), closing
#       and destroying it. The functions only the bindings reach (the CloseWatcher constructor,
#       requestClose() and the oncancel/onclose attributes) wait for scripting (P3).
#
#       Copyright (c) 2024, the Ladybird developers.
#       Copyright (c) 2024, Felipe Muñoz Mazur <felipe.munoz.mazur@protonmail.com>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## The Window a close watcher belongs to: `as<HTML::Window>(realm().global_object())`.
func html_close_watcher_window(this: HtmlCloseWatcher*) -> HtmlWindow*:
    let realm = bind_platform_object_realm(this.bind_platform_object())
    return as_html_window((gc.Cell*)realm_global_object(realm))

## Ported from Libraries/LibWeb/HTML/CloseWatcher.cpp:26 Web::HTML::CloseWatcher::establish.
# https://html.spec.whatwg.org/multipage/interaction.html#establish-a-close-watcher
pub func html_close_watcher_establish(window: HtmlWindow*, get_enabled_state: gc.Function0[bool]*) -> HtmlCloseWatcher*:
    # 1. Assert: window's associated Document is fully active.
    assert(dom_document_is_fully_active(html_window_associated_document(window)))

    # 2. Let closeWatcher be a new close watcher, with
    #    window: window
    #    cancel action: cancelAction
    #    close action: closeAction
    #    is running cancel action: false
    #    get enabled state: getEnabledState
    let realm = bind_platform_object_realm(window.bind_platform_object())
    let close_watcher = realm_create_html_close_watcher(realm, realm, get_enabled_state)
    # FIXME: cancelAction and closeAction are both set by the caller currently.

    # 3. Let manager be window's associated close watcher manager
    let manager = html_window_close_watcher_manager(window)

    # 4 - 6. Moved to CloseWatcherManager::add
    html_close_watcher_manager_add(manager, close_watcher)

    # 7. Return close_watcher.
    return close_watcher

