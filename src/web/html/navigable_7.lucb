# mark: Top-level coordinates ===================================================================

## Ported from Navigable.cpp:2801 Web::HTML::Navigable::to_top_level_rect.
pub func html_navigable_to_top_level_rect(this: HtmlNavigable*, a_rect: gfx.CssPixelRect) -> gfx.CssPixelRect:
    var rect = a_rect
    gfx.css_pixel_rect_set_location(&rect, html_navigable_to_top_level_position(this, gfx.css_pixel_rect_location(&a_rect)))
    return rect

## Ported from Navigable.cpp:2808 Web::HTML::Navigable::to_top_level_position.
pub func html_navigable_to_top_level_position(this: HtmlNavigable*, a_position: gfx.CssPixelPoint) -> gfx.CssPixelPoint:
    var position = a_position
    var ancestor: HtmlNavigable*? = this
    while let current = ancestor:
        if is_html_traversable_navigable(current):
            break
        let container = html_navigable_container(current) else return gfx.CssPixelPoint()
        let paintable = dom_node_paintable(container.dom_node()) else return gfx.CssPixelPoint()

        var transformed = false
        if let paintable_box = as_if_paint_paintable_box(paintable):
            if paint_paintable_box_accumulated_visual_context_index(paintable_box) != 0:
                var point = paint_paintable_box_absolute_position(paintable_box)
                gfx.css_pixel_point_translate_by_css_pixel_point(&point, position)
                var point_rect: gfx.CssPixelRect = ---
                gfx.css_pixel_rect_construct_css_pixel_point(&point_rect, point, gfx.CssPixelSize())
                let viewport_rect = paint_paintable_box_transform_rect_to_viewport(paintable_box, point_rect)
                position = gfx.css_pixel_rect_location(&viewport_rect)
                transformed = true
        if not transformed:
            gfx.css_pixel_point_translate_by_css_pixel_point(&position, paint_paintable_box_type_agnostic_position(paintable))
        ancestor = html_navigable_parent(current)
    return position

# mark: The viewport ============================================================================

## Ported from Navigable.cpp:2832 Web::HTML::Navigable::set_viewport_size.
pub func html_navigable_set_viewport_size(this: HtmlNavigable*, size: gfx.CssPixelSize, invalidate_display_list: InvalidateDisplayList = InvalidateDisplayList.no):
    if gfx.css_pixel_size_eq(&this.m_viewport_size, size) and invalidate_display_list == InvalidateDisplayList.no:
        return

    this.m_viewport_size = size

    if not this.m_is_svg_page:
        paint_backing_store_manager_restart_resize_timer(this.m_backing_store_manager)
        paint_backing_store_manager_resize_backing_stores_if_needed(this.m_backing_store_manager, PaintBackingStoreManagerWindowResizingInProgress.yes)
        this.m_pending_set_browser_zoom_request = false

    if let document = html_navigable_active_document(this):
        # NOTE: Resizing the viewport changes the reference value for viewport-relative CSS lengths.
        dom_node_invalidate_style(document.dom_node(), DomStyleInvalidationReason.navigable_set_viewport_size)
        dom_document_set_needs_media_query_evaluation(document)
        dom_node_set_needs_layout_update(document.dom_node(), DomSetNeedsLayoutReason.navigable_set_viewport_size)

    if let document = html_navigable_active_document(this):
        dom_document_set_needs_repaint_t(document, invalidate_display_list)

        dom_document_inform_all_viewport_clients_about_the_current_viewport_rect(document)

        # Schedule the HTML event loop to ensure that a `resize` event gets fired.
        html_event_loop_schedule(html_main_thread_event_loop())

## Ported from Navigable.cpp:2862 Web::HTML::Navigable::clamp_viewport_scroll_offset.
pub func html_navigable_clamp_viewport_scroll_offset(this: HtmlNavigable*):
    let document = html_navigable_active_document(this) else return
    if not dom_document_layout_is_up_to_date(document):
        return
    let paintable_box = dom_node_paintable_box(document.dom_node()) else return
    let scrollable_overflow_rect = paint_paintable_box_scrollable_overflow_rect(paintable_box) else return
    let max_x = gfx.css_pixel_rect_width(&scrollable_overflow_rect).sub(gfx.css_pixel_size_width(&this.m_viewport_size))
    let max_y = gfx.css_pixel_rect_height(&scrollable_overflow_rect).sub(gfx.css_pixel_size_height(&this.m_viewport_size))
    let clamped = gfx.CssPixelPoint(m_x = html_css_pixels_max(gfx.CssPixels.from_int(0), html_css_pixels_min(gfx.css_pixel_point_x(&this.m_viewport_scroll_offset), max_x)), m_y = html_css_pixels_max(gfx.CssPixels.from_int(0), html_css_pixels_min(gfx.css_pixel_point_y(&this.m_viewport_scroll_offset), max_y)))
    if not gfx.css_pixel_point_eq(&clamped, this.m_viewport_scroll_offset):
        html_navigable_perform_scroll_of_viewport_scrolling_box(this, clamped)

## AK::min of two CSSPixels.
func html_css_pixels_min(a: gfx.CssPixels, b: gfx.CssPixels) -> gfx.CssPixels:
    return a if a.lt(b) else b

## AK::max of two CSSPixels.
func html_css_pixels_max(a: gfx.CssPixels, b: gfx.CssPixels) -> gfx.CssPixels:
    return b if a.lt(b) else a

## Ported from Navigable.cpp:2882 Web::HTML::Navigable::perform_scroll_of_viewport_scrolling_box.
pub func html_navigable_perform_scroll_of_viewport_scrolling_box(this: HtmlNavigable*, new_position: gfx.CssPixelPoint):
    # NB: This method is ad-hoc, but is currently called where "perform a scroll of a scrolling box" would be,
    #     where the box is the viewport.
    #     https://drafts.csswg.org/cssom-view/#perform-a-scroll
    if not gfx.css_pixel_point_eq(&this.m_viewport_scroll_offset, new_position):
        this.m_viewport_scroll_offset = new_position
        html_navigable_scroll_offset_did_change(this)

        if let document = html_navigable_active_document(this):
            dom_document_set_needs_repaint_t(document, InvalidateDisplayList.no)
            dom_document_set_needs_to_refresh_scroll_state(document, true)
            dom_document_inform_all_viewport_clients_about_the_current_viewport_rect(document)

    # Schedule the HTML event loop to ensure that a `resize` event gets fired.
    html_event_loop_schedule(html_main_thread_event_loop())

## Ported from Navigable.cpp:2903 Web::HTML::Navigable::has_a_rendering_opportunity.
# https://html.spec.whatwg.org/multipage/webappapis.html#rendering-opportunity
pub func html_navigable_has_a_rendering_opportunity(this: HtmlNavigable*) -> bool:
    # A navigable has a rendering opportunity if the user agent is currently able to present
    # the contents of the navigable to the user,
    # accounting for hardware refresh rate constraints and user agent throttling for performance reasons,
    # but considering content presentable even if it's outside the viewport.

    # A navigable's rendering opportunities are determined based on hardware constraints
    # such as display refresh rates and other factors such as page performance
    # or whether its active document's visibility state is "visible".
    # Rendering opportunities typically occur at regular intervals.

    # FIXME: Return `false` here if we're an inactive browser tab.
    return true

