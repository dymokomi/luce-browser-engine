## Ported from Navigable.cpp:2920 Web::HTML::Navigable::inform_the_navigation_api_about_child_navigable_destruction.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#inform-the-navigation-api-about-child-navigable-destruction
pub func html_navigable_inform_the_navigation_api_about_child_navigable_destruction(this: HtmlNavigable*):
    # 1. Inform the navigation API about aborting navigation in navigable.
    html_navigable_inform_the_navigation_api_about_aborting_navigation(this)

    # FIXME: 2. Let navigation be navigable's active window's navigation API.

    # FIXME: 3. Let traversalAPIMethodTrackers be a clone of navigation's upcoming traverse API method trackers.

    # FIXME: 4. For each apiMethodTracker of traversalAPIMethodTrackers: reject the finished promise for apiMethodTracker with a new "AbortError" DOMException created in navigation's relevant realm.

## Ported from Navigable.cpp:2933 Web::HTML::Navigable::inform_the_navigation_api_about_aborting_navigation.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#inform-the-navigation-api-about-aborting-navigation
func html_navigable_inform_the_navigation_api_about_aborting_navigation(this: HtmlNavigable*):
    # 1. If this algorithm is running on navigable's active window's relevant agent's event loop, then continue on to the following steps.
    #    Otherwise, queue a global task on the navigation and traversal task source given navigable's active window to run the following steps.
    # NB: WebContent uses a single main-thread event loop, so the active window's relevant agent is always running on
    #     the current event loop and we run the steps inline. Queuing here would defer the abort past the creation of
    #     a new ongoing navigate event by a subsequent fire_a_push_replace_reload_navigate_event, causing the deferred
    #     abort to cancel that newer event.

    # AD-HOC: Not in the spec but subsequent steps will fail if the navigable doesn't have an active window.
    let window = html_navigable_active_window(this) else return

    var execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&execution_context, bind_platform_object_realm(window.bind_platform_object()), HtmlTemporaryExecutionContextCallbacksEnabled.no)
    defer html_temporary_execution_context_destruct(&execution_context)

    # 2. Let navigation be navigable's active window's navigation API.
    let navigation = html_window_navigation(window)

    # 3. If navigation's ongoing navigate event is null, then return.
    if html_navigation_ongoing_navigate_event(navigation) == none:
        return

    # 4. Abort the ongoing navigation given navigation.
    html_navigation_abort_the_ongoing_navigation(navigation)

## Ported from Navigable.cpp:2959 Web::HTML::Navigable::is_focused.
pub func html_navigable_is_focused(this: HtmlNavigable*) -> bool:
    return page_focused_navigable(this.m_page) == this

# mark: The selection ===========================================================================

## `static_cast<DOM::Text const&>(node).data()` of a Text node.
func html_text_data(node: DomNode*) -> ak.Utf16String:
    return dom_character_data_data(as_dom_character_data(node))

## Ported from Navigable.cpp:2964 Web::HTML::visible_text_in_range.
func html_visible_text_in_range(range: DomRange*) -> ak.String:
    # NOTE: This is an adaption of Range stringification, but we skip over DOM nodes that don't have a corresponding layout node.
    var builder = ak.string_builder_new()
    let abstract_range = range.dom_abstract_range()
    let start_container = dom_abstract_range_start_container(abstract_range)
    let end_container = dom_abstract_range_end_container(abstract_range)
    let start_offset = dom_abstract_range_start_offset(abstract_range)
    let end_offset = dom_abstract_range_end_offset(abstract_range)

    if start_container == end_container and is_dom_text(start_container):
        if dom_node_layout_node(start_container) == none:
            return ak.string_new()
        let data = html_text_data(start_container)
        let view = ak.utf16_string_base_substring_view_usize(&data.utf16_string_base, (usize)start_offset, (usize)(end_offset - start_offset))
        return ak.utf16_view_to_utf8_but_should_be_ported_to_utf16(&view)

    if is_dom_text(start_container) and dom_node_layout_node(start_container) != none:
        let data = html_text_data(start_container)
        ak.string_builder_append_utf16_view(&builder, ak.utf16_string_base_substring_view(&data.utf16_string_base, (usize)start_offset))

    var captures = HtmlVisibleTextInRangeCaptures(builder = &builder)
    dom_range_for_each_contained_const(range, ak.Function1[DomNode*, ak.IterationDecision](call = html_visible_text_in_range_contained, context = &captures))

    if is_dom_text(end_container) and dom_node_layout_node(end_container) != none:
        let data = html_text_data(end_container)
        ak.string_builder_append_utf16_view(&builder, ak.utf16_string_base_substring_view_usize(&data.utf16_string_base, 0, (usize)end_offset))

    return ak.string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## The captures of visible_text_in_range's for_each_contained callback.
struct HtmlVisibleTextInRangeCaptures:
    var builder: ak.StringBuilder*

## visible_text_in_range's for_each_contained callback.
func html_visible_text_in_range_contained(context: void*?, node: DomNode*) -> ak.IterationDecision:
    let captures = (HtmlVisibleTextInRangeCaptures*)(context else trap("no captures"))
    if is_dom_text(node) and dom_node_layout_node(node) != none:
        let data = html_text_data(node)
        ak.string_builder_append_utf16_view(captures.builder, ak.utf16_string_base_utf16_view(&data.utf16_string_base))
    return ak.IterationDecision.continue_

## Ported from Navigable.cpp:2990 Web::HTML::Navigable::selected_text.
pub func html_navigable_selected_text(this: HtmlNavigable*) -> ak.String:
    let document = html_navigable_active_document(this) else return ak.string_new()

    dom_document_update_layout(document, DomUpdateLayoutReason.navigable_selected_text)

    if let active_element = dom_document_active_element(document):
        if let input_element = as_if_html_input_element(active_element):
            if html_input_element_type_state(input_element) == HtmlInputElementTypeAttributeState.password:
                # Apparently nobody wants bullet characters. We leave the clipboard alone here like other browsers.
                return ak.string_new()
    let selection = dom_document_get_selection(document) else trap("dereferencing a null selection")
    if let form_text = selection_selection_try_form_control_selected_text_for_stringifier(selection):
        return ak.utf16_string_base_to_utf8(&form_text.utf16_string_base)

    let range = selection_selection_range(selection) else return ak.string_new()
    return html_visible_text_in_range(range)

## Ported from Navigable.cpp:3013 Web::HTML::Navigable::select_all.
pub func html_navigable_select_all(this: HtmlNavigable*):
    let document = html_navigable_active_document(this) else return

    let selection = dom_document_get_selection(document) else return

    if let target = dom_document_active_input_events_target(document):
        input_events_target_select_all(target)
    elif let body = dom_document_body(document):
        selection_selection_select_all_children(selection, body.dom_node()) catch:
            recover ()

## Ported from Navigable.cpp:3030 Web::HTML::Navigable::paste.
pub func html_navigable_paste(this: HtmlNavigable*, text: ak.Utf16String):
    if html_navigable_active_document(this) == none:
        return

    _ = event_handler_handle_paste(&this.m_event_handler, text)

## Ported from Navigable.cpp:3040 Web::HTML::Navigable::snapshot_containing_block.
# https://drafts.csswg.org/css-view-transitions-1/#snapshot-containing-block
pub func html_navigable_snapshot_containing_block(this: HtmlNavigable*) -> gfx.CssPixelRect:
    # The snapshot containing block is a rectangle that covers all areas of the window that could potentially display
    # page content (and is therefore consistent regardless of root scrollbars or interactive widgets).

    # Within a child navigable, the snapshot containing block is the union of the navigable’s viewport with any scrollbar gutters.
    # FIXME: Actually get the correct rectangle here.
    return html_navigable_viewport_rect(this)

## Ported from Navigable.cpp:3050 Web::HTML::Navigable::snapshot_containing_block_size.
# https://drafts.csswg.org/css-view-transitions-1/#snapshot-containing-block-size
pub func html_navigable_snapshot_containing_block_size(this: HtmlNavigable*) -> gfx.CssPixelSize:
    let rect = html_navigable_snapshot_containing_block(this)
    return gfx.css_pixel_rect_size(&rect)

# mark: Observers, stopping and pending navigations =============================================

## Ported from Navigable.cpp:3055 Web::HTML::Navigable::register_navigation_observer.
pub func html_navigable_register_navigation_observer(this: HtmlNavigable*, navigation_observer: HtmlNavigationObserver*):
    ak.intrusive_list_append(&this.m_navigation_observers, navigation_observer, memory.offset_of(HtmlNavigationObserver, m_list_node))

## Ported from Navigable.cpp:3060 Web::HTML::Navigable::unregister_navigation_observer.
pub func html_navigable_unregister_navigation_observer(this: HtmlNavigable*, navigation_observer: HtmlNavigationObserver*):
    ak.intrusive_list_remove(&this.m_navigation_observers, navigation_observer, memory.offset_of(HtmlNavigationObserver, m_list_node))

## Ported from Navigable.cpp:3066 Web::HTML::Navigable::stop_loading.
# https://html.spec.whatwg.org/multipage/document-lifecycle.html#nav-stop
pub func html_navigable_stop_loading(this: HtmlNavigable*):
    # 1. Let document be navigable's active document.
    let document = html_navigable_active_document(this) else trap("no active document")

    # 2. If document's unload counter is 0, and navigable's ongoing navigation is a navigation ID, then set the ongoing navigation for navigable to null.
    if dom_document_unload_counter(document) == 0:
        match html_navigable_ongoing_navigation(this):
            .string(_):
                html_navigable_set_ongoing_navigation(this, EmptyOrHtmlNavigableTraversalOrString.empty)
            _:
                _ = 0

    # 3. Abort a document and its descendants given document.
    dom_document_abort_a_document_and_its_descendants(document)

## Ported from Navigable.cpp:3079 Web::HTML::Navigable::set_has_session_history_entry_and_ready_for_navigation.
pub func html_navigable_set_has_session_history_entry_and_ready_for_navigation(this: HtmlNavigable*):
    this.m_has_session_history_entry_and_ready_for_navigation = true
    while not ak.vector_is_empty(&this.m_pending_navigations):
        let navigation_params = ak.vector_take_first(&this.m_pending_navigations)
        html_navigable_begin_navigation(this, navigation_params)

