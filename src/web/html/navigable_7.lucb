## Ported from Navigable.cpp:3093 Web::HTML::Navigable::external_content_source.
pub func html_navigable_external_content_source(this: HtmlNavigable*) -> display_list.ExternalContentSource*:
    return this.m_external_content_source else trap("VERIFY: m_external_content_source")

## Ported from Navigable.cpp:3099 Web::HTML::Navigable::record_display_list_and_scroll_state.
pub func html_navigable_record_display_list_and_scroll_state(this: HtmlNavigable*, paint_config: HtmlPaintConfig):
    this.m_needs_repaint = false
    let document = html_navigable_active_document(this) else return

    let recorded_display_list = dom_document_record_display_list(document, paint_config) else return

    let document_paintable = dom_document_paintable(document) else trap("dereferencing a null paintable")
    paint_viewport_paintable_refresh_scroll_state(document_paintable)

    html_rendering_thread_update_display_list(&this.m_rendering_thread, recorded_display_list, paint_viewport_paintable_scroll_state_snapshot(document_paintable))

## Ported from Navigable.cpp:3116 Web::HTML::Navigable::paint_next_frame.
pub func html_navigable_paint_next_frame(this: HtmlNavigable*):
    let viewport_rect = page_css_to_device_rect(this.m_page, html_navigable_viewport_rect(this))
    var paint_config = HtmlPaintConfig(paint_overlay = true, should_show_line_box_borders = this.m_should_show_line_box_borders)
    if html_navigable_is_top_level_traversable(this):
        paint_config.canvas_fill_rect = gfx.DevicePixelRect(m_location = gfx.IntPoint(), m_size = viewport_rect.m_size)
    else:
        # Nested navigables publish transparent bitmaps to their preconfigured ExternalContentSource instead of filling
        # the canvas for the UI process.
        assert(this.m_external_content_source != none)

    html_navigable_record_display_list_and_scroll_state(this, paint_config)

    let frame_id = html_rendering_thread_present_frame(&this.m_rendering_thread, viewport_rect)
    if not html_navigable_is_top_level_traversable(this):
        html_rendering_thread_wait_for_frame(&this.m_rendering_thread, frame_id)

## Ported from Navigable.cpp:3135 Web::HTML::Navigable::render_screenshot.
pub func html_navigable_render_screenshot(this: HtmlNavigable*, painting_surface: gfx.PaintingSurface*, paint_config: HtmlPaintConfig, callback: ak.Function0[unit]):
    html_navigable_record_display_list_and_scroll_state(this, paint_config)
    html_rendering_thread_request_screenshot(&this.m_rendering_thread, painting_surface, callback)

# mark: Scrolling the viewport ==================================================================

## Ported from Navigable.cpp:3141 Web::HTML::Navigable::scroll_viewport_by_delta.
pub func html_navigable_scroll_viewport_by_delta(this: HtmlNavigable*, delta: gfx.CssPixelPoint) -> JsPromiseCapability*:
    let vv = dom_document_visual_viewport(html_navigable_active_document(this) else trap("no active document"))
    let page_position = gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64(css_visual_viewport_page_left(vv)), m_y = gfx.CssPixels.from_f64(css_visual_viewport_page_top(vv)))
    return html_navigable_perform_a_scroll_of_the_viewport(this, gfx.css_pixel_point_add(&page_position, delta))

## Ported from Navigable.cpp:3149 Web::HTML::Navigable::perform_a_scroll_of_the_viewport.
# https://drafts.csswg.org/cssom-view/#viewport-perform-a-scroll
pub func html_navigable_perform_a_scroll_of_the_viewport(this: HtmlNavigable*, position: gfx.CssPixelPoint) -> JsPromiseCapability*:
    # 1. Let doc be the viewport’s associated Document.
    let doc = html_navigable_active_document(this) else trap("no active document")

    # 2. Let vv be the VisualViewport whose associated document is doc.
    let vv = dom_document_visual_viewport(doc)

    var viewport_rect: gfx.CssPixelRect = ---
    gfx.css_pixel_rect_construct_css_pixel_point(&viewport_rect, this.m_viewport_scroll_offset, this.m_viewport_size)

    # 3. Let maxX be the difference between viewport’s scrolling box’s width and the value of vv’s width attribute.
    let max_x = gfx.css_pixel_rect_width(&viewport_rect).to_double() - css_visual_viewport_width(vv)

    # 4. Let maxY be the difference between viewport’s scrolling box’s height and the value of vv’s height attribute.
    let max_y = gfx.css_pixel_rect_height(&viewport_rect).to_double() - css_visual_viewport_height(vv)

    # 5. Let dx be the horizontal component of position - the value vv’s pageLeft attribute
    let dx = gfx.css_pixel_point_x(&position).to_double() - css_visual_viewport_page_left(vv)

    # 6. Let dy be the vertical component of position - the value of vv’s pageTop attribute
    let dy = gfx.css_pixel_point_y(&position).to_double() - css_visual_viewport_page_top(vv)

    # 7. Let visual x be the value of vv’s offsetLeft attribute.
    let visual_x = css_visual_viewport_offset_left(vv)

    # 8. Let visual y be the value of vv’s offsetTop attribute.
    let visual_y = css_visual_viewport_offset_top(vv)

    # 9. Let visual dx be min(maxX, max(0, visual x + dx)) - visual x.
    let visual_dx = ak.min_f64(max_x, ak.max_f64(0.0, visual_x + dx)) - visual_x

    # 10. Let visual dy be min(maxY, max(0, visual y + dy)) - visual y.
    let visual_dy = ak.min_f64(max_y, ak.max_f64(0.0, visual_y + dy)) - visual_y

    # 11. Let layout dx be dx - visual dx
    let layout_dx = dx - visual_dx

    # 12. Let layout dy be dy - visual dy
    let layout_dy = dy - visual_dy

    # 13. Let element be doc’s root element if there is one, null otherwise.

    # 14. Perform a scroll of the viewport’s scrolling box to its current scroll position + (layout dx, layout dy)
    #     with element as the associated element, and behavior as the scroll behavior. Let scrollPromise1 be the
    #     Promise returned from this step.
    let realm = bind_platform_object_realm(doc.bind_platform_object())
    var temporary_execution_context: HtmlTemporaryExecutionContext = ---
    html_temporary_execution_context_construct_realm(&temporary_execution_context, realm, HtmlTemporaryExecutionContextCallbacksEnabled.no)
    defer html_temporary_execution_context_destruct(&temporary_execution_context)

    # NB: Must update layout before accessing paintables.
    dom_document_update_layout(doc, DomUpdateLayoutReason.navigable_viewport_scroll)

    # AD-HOC: Skip scrolling unscrollable boxes.
    let paintable_box = dom_node_paintable_box(doc.dom_node()) else trap("dereferencing a null paintable box")
    if not paint_paintable_box_could_be_scrolled_by_wheel_event(paintable_box):
        return idl_create_resolved_promise(realm, js_undefined())

    let overflow_rect = paint_paintable_box_scrollable_overflow_rect(paintable_box) else trap("dereferencing an empty scrollable overflow rect")
    let scrolling_area_width = f64(gfx.css_pixel_rect_width(&overflow_rect).to_float())
    let scrolling_area_height = f64(gfx.css_pixel_rect_height(&overflow_rect).to_float())
    var new_viewport_scroll_offset_x = gfx.css_pixel_point_x(&this.m_viewport_scroll_offset).to_double() + layout_dx
    var new_viewport_scroll_offset_y = gfx.css_pixel_point_y(&this.m_viewport_scroll_offset).to_double() + layout_dy
    # NOTE: Clamp to the scrolling area.
    new_viewport_scroll_offset_x = ak.max_f64(0.0, ak.min_f64(new_viewport_scroll_offset_x, scrolling_area_width - gfx.css_pixel_size_width(&this.m_viewport_size).to_double()))
    new_viewport_scroll_offset_y = ak.max_f64(0.0, ak.min_f64(new_viewport_scroll_offset_y, scrolling_area_height - gfx.css_pixel_size_height(&this.m_viewport_size).to_double()))
    let new_viewport_scroll_offset = gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64(new_viewport_scroll_offset_x), m_y = gfx.CssPixels.from_f64(new_viewport_scroll_offset_y))

    # AD-HOC: If the scroll position would not change, return early to avoid unnecessary display invalidation
    #         and event loop scheduling (e.g. during momentum scrolling against a boundary).
    if gfx.css_pixel_point_eq(&new_viewport_scroll_offset, this.m_viewport_scroll_offset) and visual_dx == 0.0 and visual_dy == 0.0:
        return idl_create_resolved_promise(realm, js_undefined())

    # FIXME: Get a Promise from this.
    html_navigable_perform_scroll_of_viewport_scrolling_box(this, new_viewport_scroll_offset)

    # 15. Perform a scroll of vv’s scrolling box to its current scroll position + (visual dx, visual dy) with element
    #     as the associated element, and behavior as the scroll behavior. Let scrollPromise2 be the Promise returned
    #     from this step.
    # FIXME: Get a Promise from this.
    css_visual_viewport_scroll_by(vv, gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64(visual_dx), m_y = gfx.CssPixels.from_f64(visual_dy)))
    if visual_dx != 0.0 or visual_dy != 0.0:
        dom_document_set_needs_accumulated_visual_contexts_update(doc, true)
        dom_document_set_needs_repaint_t(doc, InvalidateDisplayList.yes)
    else:
        dom_document_set_needs_repaint_t(doc, InvalidateDisplayList.no)

    # 16. Let scrollPromise be a new Promise.
    let scroll_promise = idl_create_promise(realm)

    # 17. Return scrollPromise, and run the remaining steps in parallel.
    # 18. Resolve scrollPromise when both scrollPromise1 and scrollPromise2 have settled.
    # FIXME: Actually wait for scroll to occur. For now, all our scrolls are instant.
    idl_resolve_promise(realm, scroll_promise, js_undefined())
    return scroll_promise

## Ported from Navigable.cpp:3239 Web::HTML::Navigable::reset_zoom.
pub func html_navigable_reset_zoom(this: HtmlNavigable*):
    let document = html_navigable_active_document(this) else return
    css_visual_viewport_reset(dom_document_visual_viewport(document))

## Ported from Navigable.cpp:3247 Web::HTML::Navigable::has_inclusive_ancestor_with_visibility_hidden.
pub func html_navigable_has_inclusive_ancestor_with_visibility_hidden(this: HtmlNavigable*) -> bool:
    if let container = html_navigable_container(this):
        if let container_computed_properties = dom_element_computed_properties(container.dom_element()):
            if css_computed_properties_visibility(container_computed_properties) == css_data.Visibility.hidden:
                return true
        if let ancestor_navigable = dom_document_navigable(dom_node_document(container.dom_node())):
            if html_navigable_container(ancestor_navigable) != none:
                return html_navigable_has_inclusive_ancestor_with_visibility_hidden(ancestor_navigable)
    return false

