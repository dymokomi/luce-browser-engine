#==============================================================================================
#
#   html_progress_element - HTML::HTMLProgressElement: <progress>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLProgressElement.cpp (lines 1-130) and the inline functions of
#       HTMLProgressElement.h: construction (which moves the mixin tables to
#       HTMLProgressElement's, as C++'s vptrs move), the value, maximum and position, the
#       insertion steps, the unboxed display and the user-agent shadow tree (a slider track
#       and fill).
#
#       Copyright (c) 2020-2022, the SerenityOS developers.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from HTMLProgressElement.cpp:26 Web::HTML::HTMLProgressElement::HTMLProgressElement.
pub func html_progress_element_construct(this: HtmlProgressElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLProgressElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_progress_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_progress_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_progress_element_animatable_vtable
    element.global_event_handlers.vtable = &html_progress_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_progress_element_form_associated_element_vtable

## Ported from HTMLProgressElement.cpp:33 Web::HTML::HTMLProgressElement::initialize (override).
pub func html_progress_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_progress_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLProgressElement.cpp:39 Web::HTML::HTMLProgressElement::visit_edges (override).
pub func html_progress_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlProgressElement*)base
    html_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_progress_value_element)

# mark: Values ==================================================================================

## Ported from HTMLProgressElement.cpp:46 Web::HTML::HTMLProgressElement::value.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-progress-value
pub func html_progress_element_value(this: HtmlProgressElement*) -> f64:
    if let value_string = dom_element_get_attribute(this.dom_element(), html_attribute_names_value):
        if let value = html_parse_floating_point_number_string_view(ak.string_bytes_as_string_view(&value_string)):
            return ak.clamp_f64(value, 0.0, html_progress_element_max(this))
    return 0.0

## Ported from HTMLProgressElement.cpp:55 Web::HTML::HTMLProgressElement::set_value.
pub func html_progress_element_set_value(this: HtmlProgressElement*, value: f64):
    var new_value = value
    if new_value < 0.0:
        new_value = 0.0

    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_value, ak.string_number_f64(new_value))
    html_progress_element_update_progress_value_element(this)

## Ported from HTMLProgressElement.cpp:65 Web::HTML::HTMLProgressElement::max.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-progress-max
pub func html_progress_element_max(this: HtmlProgressElement*) -> f64:
    if let max_string = dom_element_get_attribute(this.dom_element(), html_attribute_names_max):
        if let max = html_parse_floating_point_number_string_view(ak.string_bytes_as_string_view(&max_string)):
            if max > 0.0:
                return max
    return 1.0

## Ported from HTMLProgressElement.cpp:75 Web::HTML::HTMLProgressElement::set_max.
pub func html_progress_element_set_max(this: HtmlProgressElement*, value: f64):
    if value <= 0.0:
        return

    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_max, ak.string_number_f64(value))
    html_progress_element_update_progress_value_element(this)

## Ported from HTMLProgressElement.cpp:84 Web::HTML::HTMLProgressElement::position.
pub func html_progress_element_position(this: HtmlProgressElement*) -> f64:
    if not html_progress_element_is_determinate(this):
        return -1.0

    return html_progress_element_value(this) / html_progress_element_max(this)

# mark: Rendering ===============================================================================

## Ported from HTMLProgressElement.cpp:92 Web::HTML::HTMLProgressElement::inserted (override).
pub func html_progress_element_inserted_impl(base: DomNode*):
    html_element_inserted_impl(base)
    html_progress_element_create_shadow_tree_if_needed((HtmlProgressElement*)base)

## Ported from HTMLProgressElement.cpp:98 Web::HTML::HTMLProgressElement::adjust_computed_style (override).
pub func html_progress_element_adjust_computed_style_impl(base: DomElement*, style: CssComputedProperties*):
    discard(base)
    # https://drafts.csswg.org/css-display-3/#unbox
    let display = css_computed_properties_display(style)
    if css_display_is_contents(&display):
        css_computed_properties_set_property(style, css_data.PropertyId.display, css_display_style_value_create(css_display_from_short(CssDisplayShort.none_)).css_style_value())

## Ported from HTMLProgressElement.cpp:105 Web::HTML::HTMLProgressElement::create_shadow_tree_if_needed.
func html_progress_element_create_shadow_tree_if_needed(this: HtmlProgressElement*):
    if dom_element_shadow_root(this.dom_element()) != none:
        return

    let document = dom_node_document(this.dom_node())
    let shadow_root = realm_create_dom_shadow_root(html_element_realm(this.html_element()), document, this.dom_element(), BindShadowRootMode.closed)
    dom_shadow_root_set_user_agent_internal(shadow_root, true)
    dom_element_set_shadow_root(this.dom_element(), shadow_root)

    let progress_bar_element = dom_create_element(document, html_tag_names_div, namespace_html) else trap("MUST: DOM::create_element")
    dom_element_set_use_pseudo_element(progress_bar_element, css_data.PseudoElement.slider_track)
    html_append_child(shadow_root.dom_node(), progress_bar_element.dom_node())

    let progress_value_element = dom_create_element(document, html_tag_names_div, namespace_html) else trap("MUST: DOM::create_element")
    this.m_progress_value_element = progress_value_element
    dom_element_set_use_pseudo_element(progress_value_element, css_data.PseudoElement.slider_fill)
    html_append_child(progress_bar_element.dom_node(), progress_value_element.dom_node())
    html_progress_element_update_progress_value_element(this)

## Ported from HTMLProgressElement.cpp:124 Web::HTML::HTMLProgressElement::update_progress_value_element.
func html_progress_element_update_progress_value_element(this: HtmlProgressElement*):
    if let progress_value_element = this.m_progress_value_element:
        let width = html_string_formatted("{}%", [ak.arg_f64(html_progress_element_position(this) * 100.0)])
        css_style_properties_set_property_property_id(dom_element_style_for_bindings(progress_value_element), css_data.PropertyId.width, ak.string_bytes_as_string_view(&width), ak.sv("")) else trap("MUST: set_property")

# mark: Inline functions of HTMLProgressElement.h ===============================================

## Ported from HTMLProgressElement.h:36 Web::HTML::HTMLProgressElement::is_labelable (override).
# https://html.spec.whatwg.org/multipage/forms.html#category-label
pub func html_progress_element_is_labelable_impl(base: HtmlElement*) -> bool:
    discard(base)
    return true

## Ported from HTMLProgressElement.h:39 Web::HTML::HTMLProgressElement::default_role (override).
# https://www.w3.org/TR/html-aria/#el-progress
pub func html_progress_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    discard(base)
    return AriaRole.progressbar

## Ported from HTMLProgressElement.h:45 Web::HTML::HTMLProgressElement::is_html_progress_element (override).
pub func html_progress_element_is_html_progress_element_impl(base: DomNode*) -> bool:
    discard(base)
    return true

## Ported from HTMLProgressElement.h:54 Web::HTML::HTMLProgressElement::is_determinate.
func html_progress_element_is_determinate(this: HtmlProgressElement*) -> bool:
    return dom_element_has_attribute(this.dom_element(), html_attribute_names_value)
