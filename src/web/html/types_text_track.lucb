## Web::HTML::TextTrack::ReadinessState (Libraries/LibWeb/HTML/TextTrack.h:25).
pub enum HtmlTextTrackReadinessState as u8:
    not_loaded = 0
    loading = 1
    loaded = 2
    failed_to_load = 3

## Web::Bindings::TextTrackMode (TextTrack.idl: "disabled", "hidden", "showing").
pub enum BindTextTrackMode as u8:
    disabled = 0
    hidden = 1
    showing = 2

