## is<Web::HTML::ErrorEvent>: the cell's ClassInfo.
pub func is_html_error_event[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &html_error_event_class

## realm.create<Web::HTML::ErrorEvent>(realm, event_name, event_init).
pub func realm_create_html_error_event(realm: Realm*, realm_: Realm*, event_name: ak.FlyString, event_init: HtmlErrorEventInit) -> HtmlErrorEvent*:
