    pub var m_destination: HtmlNavigationDestination*
    pub var m_can_intercept: bool
    pub var m_user_initiated: bool
    pub var m_hash_change: bool
    pub var m_signal: DomAbortSignal*
    pub var m_form_data: XhrFormData*?
    pub var m_download_request: ak.String?
    pub var m_info: JsValue
    pub var m_has_ua_visual_transition: bool
    pub var m_source_element: DomElement*?

    func dom_event() -> DomEvent*: return (DomEvent*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

