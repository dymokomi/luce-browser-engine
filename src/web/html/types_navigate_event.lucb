## Class information of Web::HTML::NavigateEvent: Event's class id (types_event).
pub let html_navigate_event_class: ak.ClassInfo = ak.ClassInfo(name = "NavigateEvent", first_id = 47, last_id = 47, size = memory.size_of(HtmlNavigateEvent), vtable = (const void*)&html_navigate_event_vtable)

## realm.create<Web::HTML::NavigateEvent>(realm, event_name, event_init).
pub func realm_create_html_navigate_event(realm: Realm*, realm_: Realm*, event_name: ak.FlyString, event_init: HtmlNavigateEventInit) -> HtmlNavigateEvent*:
