#==============================================================================================
#
#   types_navigate_event - declarations of NavigateEvent.h, NavigationDestination.h and
#   ErrorEvent.h
#
#   DESCRIPTION:
#       Outside the skeleton's phase-1 closure (NavigateEvent was opaque); declared here by hand
#       in the generator's shape (region shell, for the navigations links and the history
#       make). NavigateEvent and ErrorEvent have Event's class id (47), NavigationDestination
#       PlatformObject's first id (6), as the other hand-declared classes (ToggleEvent,
#       DOMRect); each is recognized by its ClassInfo. Bindings::NavigationFocusReset and
#       NavigationScrollBehavior are the IDL enums of NavigateEvent.idl, which the bindings
#       generator makes in phase 3.
#
#==============================================================================================

# mark: IDL enums ===============================================================================

## Web::Bindings::NavigationFocusReset (NavigateEvent.idl).
pub enum BindNavigationFocusReset as u8:
    after_transition = 0
    manual = 1

## Web::Bindings::NavigationScrollBehavior (NavigateEvent.idl).
pub enum BindNavigationScrollBehavior as u8:
    after_transition = 0
    manual = 1

# mark: HtmlNavigationDestination ===============================================================

## Web::HTML::NavigationDestination (Libraries/LibWeb/HTML/NavigationDestination.h:17).
pub struct HtmlNavigationDestination: IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var platform_object: BindPlatformObject  # primary base
    pub var m_url: web_url.Url
    pub var m_entry: HtmlNavigationHistoryEntry*?
    ## SerializationRecord.
    pub var m_state: ak.Vector[u8]
    pub var m_is_same_document: bool

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## The vtable of Web::HTML::NavigationDestination.
pub let html_navigation_destination_vtable: BindPlatformObjectVTable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &html_navigation_destination_class, visit_edges = html_navigation_destination_visit_edges_impl), initialize = html_navigation_destination_initialize_impl))

## Class information of Web::HTML::NavigationDestination: PlatformObject's first class id.
pub let html_navigation_destination_class: ak.ClassInfo = ak.ClassInfo(name = "NavigationDestination", first_id = 6, last_id = 6, size = memory.size_of(HtmlNavigationDestination), vtable = (const void*)&html_navigation_destination_vtable)

## realm.create<Web::HTML::NavigationDestination>(realm).
pub func realm_create_html_navigation_destination(realm: Realm*, realm_: Realm*) -> HtmlNavigationDestination*:
    let this = (HtmlNavigationDestination*)web_allocate_cell(realm, &html_navigation_destination_class)
    html_navigation_destination_construct(this, realm_)
    web_initialize_cell(this.cell(), realm)
    return this

