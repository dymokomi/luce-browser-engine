## Web::HTML::NavigateEvent::InterceptionState (Libraries/LibWeb/HTML/NavigateEvent.h:49).
pub enum HtmlNavigateEventInterceptionState as u8:
    none_ = 0
    intercepted = 1
    committed = 2
    scrolled = 3
    finished = 4

## Web::HTML::NavigateEvent (Libraries/LibWeb/HTML/NavigateEvent.h:43).
pub struct HtmlNavigateEvent: IsDomEvent, IsBindPlatformObject, IsJsCell, gc.IsCell:
