#==============================================================================================

## Ported from Libraries/LibWeb/HTML/ToggleEvent.cpp:15 Web::HTML::ToggleEvent::create.
pub func html_toggle_event_create(realm: Realm*, event_name: ak.FlyString, event_init: HtmlToggleEventInit = HtmlToggleEventInit()) -> HtmlToggleEvent*:
    let event = realm_create_html_toggle_event(realm, realm, event_name, event_init)
    dom_event_set_is_trusted(event.dom_event(), true)
    return event

## Ported from Libraries/LibWeb/HTML/ToggleEvent.cpp:22 Web::HTML::ToggleEvent::construct_impl.
pub func html_toggle_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: HtmlToggleEventInit) -> HtmlToggleEvent*!:
    return html_toggle_event_create(realm, event_name, event_init)

## Ported from Libraries/LibWeb/HTML/ToggleEvent.cpp:27 Web::HTML::ToggleEvent::ToggleEvent.
pub func html_toggle_event_construct(this: HtmlToggleEvent*, realm: Realm*, event_name: ak.FlyString, event_init: HtmlToggleEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_old_state = event_init.old_state
    this.m_new_state = event_init.new_state
    this.m_source = event_init.source

## Ported from Libraries/LibWeb/HTML/ToggleEvent.cpp:35 Web::HTML::ToggleEvent::initialize (override).
pub func html_toggle_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.toggle_event)
    dom_event_initialize_impl(base, realm)

## Ported from Libraries/LibWeb/HTML/ToggleEvent.cpp:41 Web::HTML::ToggleEvent::visit_edges (override).
pub func html_toggle_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlToggleEvent*)base
    dom_event_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_source)

## Ported from Libraries/LibWeb/HTML/ToggleEvent.h:31 Web::HTML::ToggleEvent::old_state.
## https://html.spec.whatwg.org/multipage/interaction.html#dom-toggleevent-oldstate
pub func html_toggle_event_old_state(this: HtmlToggleEvent*) -> ak.String:
    return this.m_old_state

## Ported from Libraries/LibWeb/HTML/ToggleEvent.h:34 Web::HTML::ToggleEvent::new_state.
## https://html.spec.whatwg.org/multipage/interaction.html#dom-toggleevent-newstate
pub func html_toggle_event_new_state(this: HtmlToggleEvent*) -> ak.String:
    return this.m_new_state

## Ported from Libraries/LibWeb/HTML/ToggleEvent.h:37 Web::HTML::ToggleEvent::source.
## https://html.spec.whatwg.org/multipage/interaction.html#dom-toggleevent-source
pub func html_toggle_event_source(this: HtmlToggleEvent*) -> DomElement*?:
    # The source getter steps are to return the result of retargeting source against this's currentTarget.
    var source: DomEventTarget*? = none
    if let element = this.m_source:
        source = element.dom_event_target()
    let retargeted = dom_retarget(source, dom_event_current_target(this.dom_event())) else return none
    return as_dom_element(retargeted)
