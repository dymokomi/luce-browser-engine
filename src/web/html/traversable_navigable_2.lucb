        discard(html_queue_global_task(HtmlTaskSource.navigation_and_traversal, (JsObject*)(html_navigable_active_window(navigable) else trap("unreachable: checked above")), gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_apply_history_step_state_change_navigable, context = task))))

    html_apply_history_step_state_try_advance(this)
