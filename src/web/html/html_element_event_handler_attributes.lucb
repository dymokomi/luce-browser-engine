#==============================================================================================
#
#   html_element_event_handler_attributes - HTML::HTMLElement: the event handler content
#                                           attributes of attribute_changed
#
#   DESCRIPTION:
#       Port of the ENUMERATE_GLOBAL_EVENT_HANDLERS expansion inside HTMLElement::attribute_changed
#       (LibWeb/HTML/HTMLElement.cpp lines 746-752): one test per event handler content
#       attribute, in the macro's order, each forwarding to EventTarget's
#       element_event_handler_attribute_changed (region r19).
#
#==============================================================================================

## HTMLElement::attribute_changed's `#define __ENUMERATE(attribute_name, event_name) if (name ==
## HTML::AttributeNames::attribute_name) { element_event_handler_attribute_changed(event_name, value); }`.
func html_element_global_event_handler_attribute_changed(this: HtmlElement*, name: ak.FlyString, value: ak.String?):
    let target = this.dom_event_target()
    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_onabort):
        dom_event_target_element_event_handler_attribute_changed(target, html_event_names_abort, value)
    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_onanimationcancel):
        dom_event_target_element_event_handler_attribute_changed(target, html_event_names_animationcancel, value)
