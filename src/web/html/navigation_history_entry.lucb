## Ported from NavigationHistoryEntry.cpp:23 Web::HTML::NavigationHistoryEntry::create.
pub func html_navigation_history_entry_create(realm: Realm*, she: HtmlSessionHistoryEntry*) -> HtmlNavigationHistoryEntry*:
    return realm_create_html_navigation_history_entry(realm, realm, she)

## Ported from NavigationHistoryEntry.cpp:28 Web::HTML::NavigationHistoryEntry::NavigationHistoryEntry.
pub func html_navigation_history_entry_construct(this: HtmlNavigationHistoryEntry*, realm: Realm*, she: HtmlSessionHistoryEntry*):
    dom_event_target_construct(this.dom_event_target(), realm)
    this.m_session_history_entry = she

## Ported from NavigationHistoryEntry.cpp:36 Web::HTML::NavigationHistoryEntry::initialize (override).
pub func html_navigation_history_entry_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.navigation_history_entry)
    dom_event_target_initialize_impl(base, realm)

## Ported from NavigationHistoryEntry.h:28 Web::HTML::NavigationHistoryEntry::session_history_entry.
pub func html_navigation_history_entry_session_history_entry(this: HtmlNavigationHistoryEntry*) -> HtmlSessionHistoryEntry*:
    return this.m_session_history_entry
