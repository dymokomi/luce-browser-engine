#==============================================================================================
#
#   window_1 - HTML::Window: the set of all windows, creation and what a window keeps alive,
#   window.open()'s steps, media features, page transition events and web storage
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/Window.cpp lines 86-553 (all_windows, for_each_active,
#       run_animation_frame_callbacks, IdleCallback, create, the constructor, visit_edges,
#       finalize, window_open_steps, get_noopener_for_window_open, window_open_steps_internal,
#       dispatch_event, page, query_media_feature, fire_a_page_transition_event, local_storage,
#       session_storage), with the inline functions of Window.h.
#
#       all_windows is a GC::WeakHashSet in C++. Its WeakImpls live in a VM's heap and the set is
#       a static, so here (DESIGN.md §3.3 rule 7) it is a C-heap set of raw pointers that
#       Window::finalize leaves, as the donor's finalize does: it never points at a dead window.
#
#       Copyright (c) 2020-2023, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2021-2022, Sam Atkins <atkinssj@serenityos.org>
#       Copyright (c) 2021-2023, Linus Groh <linusg@serenityos.org>
#       Copyright (c) 2023, Luke Wilde <lukew@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: All windows =============================================================================

## The static set of all_windows: raw pointers in the C heap, which keep nothing alive; a
## window's finalize removes it.
var html_all_windows_storage: ak.HashTable[HtmlWindow*, ak.PtrTraits[HtmlWindow]]

## Ported from Window.cpp:87 Web::HTML::all_windows.
func html_all_windows() -> ak.HashTable[HtmlWindow*, ak.PtrTraits[HtmlWindow]]*:
    return &html_all_windows_storage

## Ported from Window.cpp:93 Web::HTML::Window::for_each_active.
pub func html_window_for_each_active(callback: ak.Function1[HtmlWindow*, ak.IterationDecision]):
    var windows = ak.Vector[HtmlWindow*]()
    for window_pointer in ak.hash_table_begin(html_all_windows()):
        ak.vector_append_t(&windows, *window_pointer)
    for window in ak.vector_span(&windows):
        let document = window.m_associated_document else continue

        if not dom_document_is_fully_active(document):
            continue

        if ak.function1_call(&callback, window) == ak.IterationDecision.break_:
            break

## Ported from Window.cpp:109 Web::HTML::run_animation_frame_callbacks.
# https://html.spec.whatwg.org/multipage/imagebitmap-and-animations.html#run-the-animation-frame-callbacks
pub func html_run_animation_frame_callbacks(document: DomDocument*, now: f64):
    # FIXME: Bring this closer to the spec.
    html_animation_frame_callback_driver_run(html_window_animation_frame_callback_driver(dom_document_window(document) else trap("no window")), now)

# mark: IdleCallback ============================================================================

## Ported from Window.cpp:117 Web::HTML::IdleCallback::IdleCallback.
pub func html_idle_callback_construct(this: HtmlIdleCallback*, handler: ak.Function1[RequestIdleCallbackIdleDeadline*, JsCompletion], handle: u32):
    this.m_handler = handler
    this.m_handle = handle

## Ported from Window.cpp:124 Web::HTML::IdleCallback::invoke.
pub func html_idle_callback_invoke(this: HtmlIdleCallback*, deadline: RequestIdleCallbackIdleDeadline*) -> JsCompletion:
