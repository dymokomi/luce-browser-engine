# mark: Parent and frame element ================================================================

## Ported from Window.cpp:1109 Web::HTML::Window::parent.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-parent
pub func html_window_parent(this: HtmlWindow*) -> HtmlWindowProxy*?:
    # 1. Let navigable be this's navigable.
    var navigable = html_window_navigable(this)

    # 2. If navigable is null, then return null.
    if navigable == none:
        return none

    # 3. If navigable's parent is not null, then set navigable to navigable's parent.
    if let parent = html_navigable_parent(navigable else trap("unreachable")):
        navigable = parent

    # 4. Return navigable's active WindowProxy.
    return html_navigable_active_window_proxy(navigable else trap("unreachable"))

## Ported from Window.cpp:1127 Web::HTML::Window::frame_element.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-frameelement
pub func html_window_frame_element(this: HtmlWindow*) -> DomElement*?:
    # 1. Let current be this's node navigable.
    let current = html_window_navigable(this)

    # 2. If current is null, then return null.
    let navigable = current else return none

    # 3. Let container be current's container.
    let container = html_navigable_container(navigable)

    # 4. If container is null, then return null.
    let element = container else return none

    # 5. If container's node document's origin is not same origin-domain with the current settings object's origin, then return null.
    let container_origin = dom_document_origin(dom_node_document(element.dom_node()))
    if not web_url.origin_is_same_origin_domain(&container_origin, html_environment_settings_object_origin(html_current_settings_object())):
        return none

    # 6. Return container.
    return element.dom_element()

## Ported from Window.cpp:1152 Web::HTML::Window::open.
# https://html.spec.whatwg.org/multipage/nav-history-apis.html#dom-open
pub func html_window_open(this: HtmlWindow*, url: ak.String?, target: ak.String?, features: ak.String?) -> HtmlWindowProxy*?!:
    # The open(url, target, features) method steps are to run the window open steps with url, target, and features.
    let url_string = url else trap("Optional::operator*() on an empty optional")
    let target_string = target else trap("Optional::operator*() on an empty optional")
    let features_string = features else trap("Optional::operator*() on an empty optional")
    return try html_window_window_open_steps(this, ak.string_bytes_as_string_view(&url_string), ak.string_bytes_as_string_view(&target_string), ak.string_bytes_as_string_view(&features_string))

# mark: Objects created on demand ===============================================================

## Ported from Window.cpp:1159 Web::HTML::Window::navigator.
# https://html.spec.whatwg.org/multipage/system-state.html#dom-navigator
pub func html_window_navigator(this: HtmlWindow*) -> HtmlNavigator*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # The navigator and clientInformation getter steps are to return this's associated Navigator.
    if this.m_navigator == none:
        this.m_navigator = realm_create_html_navigator(realm, realm)
    return this.m_navigator else trap("unreachable")

## Ported from Window.cpp:1170 Web::HTML::Window::close_watcher_manager.
# https://html.spec.whatwg.org/multipage/interaction.html#close-watcher-manager
pub func html_window_close_watcher_manager(this: HtmlWindow*) -> HtmlCloseWatcherManager*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    if this.m_close_watcher_manager == none:
        this.m_close_watcher_manager = realm_create_html_close_watcher_manager(realm, realm)
    return this.m_close_watcher_manager else trap("unreachable")

## Ported from Window.cpp:1180 Web::HTML::Window::cookie_store.
# https://cookiestore.spec.whatwg.org/#Window
pub func html_window_cookie_store(this: HtmlWindow*) -> CookieStoreCookieStore*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # The cookieStore getter steps are to return this’s associated CookieStore.
    if this.m_cookie_store == none:
        this.m_cookie_store = realm_create_cookie_store_cookie_store(realm, realm, page_client(html_window_page(this)))
    return this.m_cookie_store else trap("unreachable")

## Ported from Window.cpp:1191 Web::HTML::Window::speech_synthesis.
# https://wicg.github.io/speech-api/#tts-section
pub func html_window_speech_synthesis(this: HtmlWindow*) -> SpeechSynthesis*:
    if this.m_speech_synthesis == none:
        this.m_speech_synthesis = speech_synthesis_create(bind_platform_object_realm(this.bind_platform_object()))
    return this.m_speech_synthesis else trap("unreachable")

# mark: Simple dialogs ==========================================================================

## Ported from Window.cpp:1199 Web::HTML::Window::alert.
# https://html.spec.whatwg.org/multipage/timers-and-user-prompts.html#dom-alert
pub func html_window_alert(this: HtmlWindow*, message: ak.String):
    # https://html.spec.whatwg.org/multipage/timers-and-user-prompts.html#simple-dialogs
    # Note: This method is defined using two overloads, instead of using an optional argument,
    #       for historical reasons. The practical impact of this is that alert(undefined) is
    #       treated as alert("undefined"), but alert() is treated as alert("").
    # FIXME: Make this fully spec compliant.
    page_did_request_alert(html_window_page(this), message)

## Ported from Window.cpp:1210 Web::HTML::Window::confirm.
# https://html.spec.whatwg.org/multipage/timers-and-user-prompts.html#dom-confirm
pub func html_window_confirm(this: HtmlWindow*, message: ak.String?) -> bool:
    # FIXME: Make this fully spec compliant.
    # NOTE: `message` has an IDL-provided default value and is never empty.
    return page_did_request_confirm(html_window_page(this), message else trap("Optional::operator*() on an empty optional"))

## Ported from Window.cpp:1218 Web::HTML::Window::prompt.
# https://html.spec.whatwg.org/multipage/timers-and-user-prompts.html#dom-prompt
pub func html_window_prompt(this: HtmlWindow*, message: ak.String?, default_: ak.String?) -> ak.String?:
    # FIXME: Make this fully spec compliant.
    return page_did_request_prompt(html_window_page(this), message else trap("Optional::operator*() on an empty optional"), default_ else trap("Optional::operator*() on an empty optional"))

# mark: postMessage =============================================================================

## Ported from Window.cpp:1225 Web::HTML::Window::window_post_message_steps.
# https://html.spec.whatwg.org/multipage/web-messaging.html#window-post-message-steps
func html_window_window_post_message_steps(this: HtmlWindow*, message: JsValue, options: HtmlWindowPostMessageOptions) -> !:
    # Steps 1-8 serialize the message with StructuredSerializeWithTransfer, queue a task that
    # deserializes it into the target realm and fire a MessageEvent at the window: a message is a
    # JS value, which only a script can post (phase 3).
    trap("unported (P3): Web::HTML::Window::window_post_message_steps (structured serialization and MessageEvent)")

## Ported from Window.cpp:1325 Web::HTML::Window::post_message.
# https://html.spec.whatwg.org/multipage/web-messaging.html#dom-window-postmessage-options
pub func html_window_post_message_html_window_post_message_optio(this: HtmlWindow*, message: JsValue, options: HtmlWindowPostMessageOptions) -> !:
    # The Window interface's postMessage(message, options) method steps are to run the window post message steps given
    # this, message, and options.
    return try html_window_window_post_message_steps(this, message, options)

## Ported from Window.cpp:1333 Web::HTML::Window::post_message.
# https://html.spec.whatwg.org/multipage/web-messaging.html#dom-window-postmessage
pub func html_window_post_message_string(this: HtmlWindow*, message: JsValue, target_origin: ak.String, transfer: ak.Vector[JsObject*?]) -> !:
    # The Window interface's postMessage(message, targetOrigin, transfer) method steps are to run the window post message
    # steps given this, message, and «[ "targetOrigin" → targetOrigin, "transfer" → transfer ]».
    var options = HtmlWindowPostMessageOptions()
    options.structured_serialize_options.transfer = transfer
    options.target_origin = target_origin
    return try html_window_window_post_message_steps(this, message, options)

# mark: The current event, computed style and media queries =====================================

## Ported from Window.cpp:1341 Web::HTML::Window::event.
# https://dom.spec.whatwg.org/#dom-window-event
pub func html_window_event(this: HtmlWindow*) -> DomEventOrEmpty:
    # The event getter steps are to return this’s current event.
    if let current_event = html_window_current_event_const(this):
        return DomEventOrEmpty.dom_event(current_event)
    return DomEventOrEmpty.empty

## Ported from Window.cpp:1350 Web::HTML::Window::get_computed_style.
# https://drafts.csswg.org/cssom/#dom-window-getcomputedstyle
pub func html_window_get_computed_style(this: HtmlWindow*, element: DomElement*, pseudo_element: ak.String?) -> CssStyleProperties*:
    # 1. Let doc be elt’s node document.

    # 2. Let obj be elt.
    var object: DomAbstractElement? = DomAbstractElement(m_element = element, m_pseudo_element = none, m_inheritance_override = none)

    # 3. If pseudoElt is provided, is not the empty string, and starts with a colon, then:
    if let pseudo = pseudo_element:
        if ak.string_starts_with(&pseudo, (u32)':'):
            # 1. Parse pseudoElt as a <pseudo-element-selector>, and let type be the result.
            var params: CssParsingParams = ---
            css_parsing_params_construct_dom_document(&params, html_window_associated_document(this))
            let type_ = parse_pseudo_element_selector(params, ak.string_bytes_as_string_view(&pseudo))

            # 2. If type is failure, or is a ::slotted() or ::part() pseudo-element, let obj be null.
            var is_failure = true
            if let parsed = type_:
                let kind = css_selector_pseudo_element_selector_type(&parsed)
                is_failure = kind == css_data.PseudoElement.slotted or kind == css_data.PseudoElement.part
            if is_failure:
                object = none
            # 3. Otherwise let obj be the given pseudo-element of elt.
            else:
                let parsed = type_ else trap("unreachable")
                let kind = css_selector_pseudo_element_selector_type(&parsed)
                # TODO: Keep the function arguments of the pseudo-element if there are any.
                object = DomAbstractElement(m_element = element, m_pseudo_element = kind, m_inheritance_override = none)

                # https://drafts.csswg.org/css-view-transitions-1/#update-pseudo-element-styles
                # This algorithm must be executed to update styles in user-agent origin if its effects can be observed by a web API.
                # NB: View transition pseudo-elements only ever originate from the document element and only ::view-transition-group() and its descendants can be affected by update_pseudo_element_styles().
                if dom_element_is_document_element(element) and (kind == css_data.PseudoElement.view_transition_group or kind == css_data.PseudoElement.view_transition_image_pair or kind == css_data.PseudoElement.view_transition_old or kind == css_data.PseudoElement.view_transition_new):
                    if let transition = dom_document_active_view_transition(dom_node_document(element.dom_node())):
                        view_transition_view_transition_update_pseudo_element_styles(transition) catch:
                            # (void): the C++ drops the result.
                            recover ()

    # FIXME: Implement steps 4 and 5 when we can.
    # 4. Let decls be an empty list of CSS declarations.
    # 5. If obj is not null, and elt is connected, part of the flat tree, and its shadow-including root
    #    has a browsing context which either doesn’t have a browsing context container, or whose browsing
    #    context container is being rendered, set decls to a list of all longhand properties that are
    #    supported CSS properties, in lexicographical order, with the value being the resolved value
    #    computed for obj using the style rules associated with doc. Additionally, append to decls all
    #    the custom properties whose computed value for obj is not the guaranteed-invalid value.

    # 6. Return a live CSSStyleProperties object with the following properties:
    #    computed flag
    #        Set.
    #    readonly flag
    #        Set.
    #    declarations
    #        decls.
    #    parent CSS rule
    #        Null.
    #    owner node
    #        obj.
    return css_style_properties_create_resolved_style(dom_element_realm(element), object)

## Ported from Window.cpp:1406 Web::HTML::Window::match_media.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-matchmedia
pub func html_window_match_media(this: HtmlWindow*, query: ak.String) -> CssMediaQueryList*!:
    # 1. Let parsed media query list be the result of parsing query.
    var params: CssParsingParams = ---
    css_parsing_params_construct_dom_document(&params, html_window_associated_document(this))
    let parsed_media_query_list = parse_media_query_list(params, ak.string_bytes_as_string_view(&query))

    # 2. Return a new MediaQueryList object, with this's associated Document as the document, with parsed media query list as its associated media query list.
    let media_query_list = realm_create_css_media_query_list(bind_platform_object_realm(this.bind_platform_object()), html_window_associated_document(this), parsed_media_query_list)
    dom_document_add_media_query_list(html_window_associated_document(this), media_query_list)
    return media_query_list

## Ported from Window.cpp:1418 Web::HTML::Window::screen.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-screen
pub func html_window_screen(this: HtmlWindow*) -> CssScreen*:
    # The screen attribute must return the Screen object associated with the Window object.
    if this.m_screen == none:
        this.m_screen = realm_create_css_screen(bind_platform_object_realm(this.bind_platform_object()), this)
    return this.m_screen else trap("unreachable")

## Ported from Window.cpp:1426 Web::HTML::Window::visual_viewport.
pub func html_window_visual_viewport(this: HtmlWindow*) -> CssVisualViewport*?:
    # If the associated document is fully active, the visualViewport attribute must return
    # the VisualViewport object associated with the Window object’s associated document.
    if dom_document_is_fully_active(html_window_associated_document(this)):
        return dom_document_visual_viewport(html_window_associated_document(this))

    # Otherwise, it must return null.
    return none

# mark: Inner size and moving ===================================================================

## Ported from Window.cpp:1438 Web::HTML::Window::inner_width.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-innerwidth
pub func html_window_inner_width(this: HtmlWindow*) -> i32:
    # The innerWidth attribute must return the viewport width including the size of a rendered scroll bar (if any),
    # or zero if there is no viewport.
    if let navigable = dom_document_navigable(html_window_associated_document_const(this)):
        let viewport_rect = html_navigable_viewport_rect(navigable)
        return gfx.css_pixel_rect_width(&viewport_rect).to_int()
    return 0

## Ported from Window.cpp:1448 Web::HTML::Window::inner_height.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-innerheight
pub func html_window_inner_height(this: HtmlWindow*) -> i32:
    # The innerHeight attribute must return the viewport height including the size of a rendered scroll bar (if any),
    # or zero if there is no viewport.
    if let navigable = dom_document_navigable(html_window_associated_document_const(this)):
        let viewport_rect = html_navigable_viewport_rect(navigable)
        return gfx.css_pixel_rect_height(&viewport_rect).to_int()
    return 0

## Ported from Window.cpp:1458 Web::HTML::Window::move_to.
# https://drafts.csswg.org/cssom-view/#dom-window-moveto
pub func html_window_move_to(this: HtmlWindow*, arg0: i64, arg1: i64):
    # 1. Optionally, return.
    return

    # NOTE: For now, the other steps are unimplemented because we always return in step 1.
    # FIXME: Implement these for popup windows?
    # 2. Let target be this's relevant global object's browsing context.
    # 3. If target is not an auxiliary browsing context that was created by a script (as opposed to by an action of the user), then return.
    # 4. Optionally, clamp x and y in a user-agent-defined manner so that the window does not move outside the available space.
    # 5. Move target’s window such that the window’s top left corner is at coordinates (x, y) relative to the top left corner of the output device, measured in CSS pixels of target. The positive axes are rightward and downward.

