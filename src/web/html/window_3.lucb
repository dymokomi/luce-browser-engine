# mark: Scrolling ===============================================================================

## Ported from Window.cpp:1516 Web::HTML::Window::scroll_x.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-scrollx
pub func html_window_scroll_x(this: HtmlWindow*) -> f64:
    # The scrollX attribute must return the x-coordinate, relative to the initial containing block origin,
    # of the left of the viewport, or zero if there is no viewport.
    if let navigable = dom_document_navigable(html_window_associated_document_const(this)):
        let viewport_rect = html_navigable_viewport_rect(navigable)
        return gfx.css_pixel_rect_x(&viewport_rect).to_double()
    return 0.0

## Ported from Window.cpp:1526 Web::HTML::Window::scroll_y.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-scrolly
pub func html_window_scroll_y(this: HtmlWindow*) -> f64:
    # The scrollY attribute must return the y-coordinate, relative to the initial containing block origin,
    # of the top of the viewport, or zero if there is no viewport.
    if let navigable = dom_document_navigable(html_window_associated_document_const(this)):
        let viewport_rect = html_navigable_viewport_rect(navigable)
        return gfx.css_pixel_rect_y(&viewport_rect).to_double()
    return 0.0

## Ported from Window.cpp:1536 Web::HTML::Window::scroll.
# https://drafts.csswg.org/cssom-view/#dom-window-scroll
pub func html_window_scroll_html_scroll_to_options(this: HtmlWindow*, options: HtmlScrollToOptions) -> JsPromiseCapability*:
    let realm = bind_platform_object_realm(this.bind_platform_object())

    # 4. If there is no viewport, return a resolved Promise and abort the remaining steps.
    # AD-HOC: Done here as step 1 requires the viewport.
    let navigable = dom_document_navigable(html_window_associated_document(this)) else return idl_create_resolved_promise(realm, js_undefined())

    # 1. If invoked with one argument, follow these substeps:
    # NB: This Window::scroll() overload always has one argument.

    #    1. Let options be the argument.
    let css_viewport_rect = html_navigable_viewport_rect(navigable)
    let viewport_rect = gfx.css_pixel_rect_to_type_f32(&css_viewport_rect)

    #    2. Let x be the value of the left dictionary member of options, if present, or the viewport’s current scroll
    #    position on the x axis otherwise.
    var x = (f32)(options.left else (f64)viewport_rect.m_location.m_x)

    #    3. Let y be the value of the top dictionary member of options, if present, or the viewport’s current scroll
    #       position on the y axis otherwise.
    var y = (f32)(options.top else (f64)viewport_rect.m_location.m_y)

    # 2. If invoked with two arguments, follow these substeps:
    # NB: Implemented by other Window::scroll() overload.

    # 3. Normalize non-finite values for x and y.
    x = (f32)html_normalize_non_finite_values_f64((f64)x)
    y = (f32)html_normalize_non_finite_values_f64((f64)y)

    # AD-HOC: Step 4 is done at the start.

    # 5. Let viewport width be the width of the viewport excluding the width of the scroll bar, if any.
    let viewport_width = viewport_rect.m_size.m_width

    # 6. Let viewport height be the height of the viewport excluding the height of the scroll bar, if any.
    let viewport_height = viewport_rect.m_size.m_height

    let document = html_navigable_active_document(navigable) else trap("VERIFY: document")

    # OPTIMIZATION: If we're scrolling to (0, 0), we don't need to do any of the overflow calculations.
    #               This also means we don't need to update layout in that case.
    if x != 0.0f32 or y != 0.0f32:
        # NB: Make sure layout is up-to-date before looking at scrollable overflow metrics.
        dom_document_update_layout(document, DomUpdateLayoutReason.window_scroll)

        let paintable_box = dom_node_paintable_box(document.dom_node()) else trap("VERIFY: document->paintable_box()")
        let css_scrolling_area = paint_paintable_box_scrollable_overflow_rect(paintable_box) else trap("Optional::operator->() on an empty optional")
        let scrolling_area = gfx.css_pixel_rect_to_type_f32(&css_scrolling_area)

        # 7. FIXME: For now we always assume overflow direction is rightward
        # -> If the viewport has rightward overflow direction
        #    Let x be max(0, min(x, viewport scrolling area width - viewport width)).
        x = ak.max_f32(0.0f32, ak.min_f32(x, scrolling_area.m_size.m_width - viewport_width))
        # -> If the viewport has leftward overflow direction
        #    Let x be min(0, max(x, viewport width - viewport scrolling area width)).

        # 8. FIXME: For now we always assume overflow direction is downward
        # -> If the viewport has downward overflow direction
        #    Let y be max(0, min(y, viewport scrolling area height - viewport height)).
        y = ak.max_f32(0.0f32, ak.min_f32(y, scrolling_area.m_size.m_height - viewport_height))
        # -> If the viewport has upward overflow direction
        #    Let y be min(0, max(y, viewport height - viewport scrolling area height)).

    # FIXME: 9. Let position be the scroll position the viewport would have by aligning the x-coordinate x of the viewport
    #           scrolling area with the left of the viewport and aligning the y-coordinate y of the viewport scrolling area
    #           with the top of the viewport.

    # 10. If position is the same as the viewport’s current scroll position, and the viewport does not have an ongoing
    #     smooth scroll, return a resolved Promise and abort the remaining steps.
    if x == viewport_rect.m_location.m_x and y == viewport_rect.m_location.m_y:
        var temporary_execution_context: HtmlTemporaryExecutionContext = ---
        html_temporary_execution_context_construct_realm(&temporary_execution_context, realm)
        defer html_temporary_execution_context_destruct(&temporary_execution_context)
        return idl_create_resolved_promise(realm, js_undefined())

    # 11. Let document be the viewport’s associated Document.
    # NB: document is already defined above.

    # 12. Perform a scroll of the viewport to position, document’s root element as the associated element, if there is
    #     one, or null otherwise, and the scroll behavior being the value of the behavior dictionary member of options.
    #     Let scrollPromise be the Promise returned from this step.
    let scroll_promise = html_navigable_perform_a_scroll_of_the_viewport(navigable, gfx.CssPixelPoint(m_x = gfx.CssPixels.from_f64((f64)x), m_y = gfx.CssPixels.from_f64((f64)y)))

    # 13. Return scrollPromise.
    return scroll_promise

## Ported from Window.cpp:1625 Web::HTML::Window::scroll.
# https://drafts.csswg.org/cssom-view/#dom-window-scroll
pub func html_window_scroll_f64(this: HtmlWindow*, x: f64, y: f64) -> JsPromiseCapability*:
    # NB: This just implements step 2, and then forwards to the other Window::scroll() overload.

    # 2. If invoked with two arguments, follow these substeps:

    #    1. Let options be null converted to a ScrollToOptions dictionary. [WEBIDL]
    var options = HtmlScrollToOptions()

    #    2. Let x and y be the arguments, respectively.
    options.left = x
    options.top = y

    return html_window_scroll_html_scroll_to_options(this, options)

## Ported from Window.cpp:1642 Web::HTML::Window::scroll_by.
# https://drafts.csswg.org/cssom-view/#dom-window-scrollby
pub func html_window_scroll_by_html_scroll_to_options(this: HtmlWindow*, a_options: HtmlScrollToOptions) -> JsPromiseCapability*:
    var options = a_options

    # 1. If invoked with two arguments, follow these substeps:
    # NB: Implemented by the other overload, which then calls this.

    # 2. Normalize non-finite values for the left and top dictionary members of options.
    let left = html_normalize_non_finite_values_optional(options.left)
    let top = html_normalize_non_finite_values_optional(options.top)

    # 3. Add the value of scrollX to the left dictionary member.
    options.left = left + html_window_scroll_x(this)

    # 4. Add the value of scrollY to the top dictionary member.
    options.top = top + html_window_scroll_y(this)

    # 5. Return the Promise returned from scroll() after the method is invoked with options as the only argument.
    return html_window_scroll_html_scroll_to_options(this, options)

## Ported from Window.cpp:1662 Web::HTML::Window::scroll_by.
# https://drafts.csswg.org/cssom-view/#dom-window-scrollby
pub func html_window_scroll_by_f64(this: HtmlWindow*, x: f64, y: f64) -> JsPromiseCapability*:
    # 1. If invoked with two arguments, follow these substeps:

    #    1. Let options be null converted to a ScrollToOptions dictionary. [WEBIDL]
    var options = HtmlScrollToOptions()

    #    2. Let x and y be the arguments, respectively.

    #    3. Let the left dictionary member of options have the value x.
    options.left = x

    #    4. Let the top dictionary member of options have the value y.
    options.top = y

    # NB: Complete the algorithm using the other overload.
    return html_window_scroll_by_html_scroll_to_options(this, options)

# mark: Screen position and the device pixel ratio ==============================================

## Ported from Window.cpp:1682 Web::HTML::Window::screen_x.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-screenx
pub func html_window_screen_x(this: HtmlWindow*) -> i32:
    # The screenX and screenLeft attributes must return the x-coordinate, relative to the origin of the Web-exposed
    # screen area, of the left of the client window as number of CSS pixels, or zero if there is no such thing.
    return page_window_position(html_window_page_const(this)).m_x

## Ported from Window.cpp:1690 Web::HTML::Window::screen_y.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-screeny
pub func html_window_screen_y(this: HtmlWindow*) -> i32:
    # The screenY and screenTop attributes must return the y-coordinate, relative to the origin of the screen of the
    # Web-exposed screen area, of the top of the client window as number of CSS pixels, or zero if there is no such thing.
    return page_window_position(html_window_page_const(this)).m_y

## Ported from Window.cpp:1698 Web::HTML::Window::outer_width.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-outerwidth
pub func html_window_outer_width(this: HtmlWindow*) -> i32:
    # The outerWidth attribute must return the width of the client window. If there is no client window this
    # attribute must return zero.
    return page_window_size(html_window_page_const(this)).m_width

## Ported from Window.cpp:1706 Web::HTML::Window::outer_height.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-outerheight
pub func html_window_outer_height(this: HtmlWindow*) -> i32:
    # The outerHeight attribute must return the height of the client window. If there is no client window this
    # attribute must return zero.
    return page_window_size(html_window_page_const(this)).m_height

## Ported from Window.cpp:1714 Web::HTML::Window::device_pixel_ratio.
# https://w3c.github.io/csswg-drafts/cssom-view/#dom-window-devicepixelratio
pub func html_window_device_pixel_ratio(this: HtmlWindow*) -> f64:
    # 1. If there is no output device, return 1 and abort these steps.
    # 2. Let CSS pixel size be the size of a CSS pixel at the current page zoom and using a scale factor of 1.0.
    # 3. Let device pixel size be the vertical size of a device pixel of the output device.
    # 4. Return the result of dividing CSS pixel size by device pixel size.
    return page_client_device_pixels_per_css_pixel(page_client(html_window_page_const(this)))
