## The vtable of Web::HTML::ToggleEvent.
pub let html_toggle_event_vtable: HtmlToggleEventVTable = HtmlToggleEventVTable(event_vtable = DomEventVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &html_toggle_event_class, visit_edges = html_toggle_event_visit_edges_impl), initialize = html_toggle_event_initialize_impl))))

## Class information of Web::HTML::ToggleEvent: Event's class id (types_event).
pub let html_toggle_event_class: ak.ClassInfo = ak.ClassInfo(name = "ToggleEvent", first_id = 47, last_id = 47, size = memory.size_of(HtmlToggleEvent), vtable = (const void*)&html_toggle_event_vtable)

## is<Web::HTML::ToggleEvent>: the cell's ClassInfo.
pub func is_html_toggle_event[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &html_toggle_event_class

## as_if<Web::HTML::ToggleEvent>.
pub func as_if_html_toggle_event[P: gc.IsCell](p: P*) -> HtmlToggleEvent*?:
    if is_html_toggle_event(p): return (HtmlToggleEvent*)p
    return none

## as<Web::HTML::ToggleEvent> (verify_cast).
pub func as_html_toggle_event[P: gc.IsCell](p: P*) -> HtmlToggleEvent*:
    return as_if_html_toggle_event(p) else trap("as<Web::HTML::ToggleEvent> failed")

## realm.create<Web::HTML::ToggleEvent>(realm, event_name, move(event_init)): allocate under
## DeferGC, construct, then initialize(realm).
pub func realm_create_html_toggle_event(realm: Realm*, realm_: Realm*, event_name: ak.FlyString, event_init: HtmlToggleEventInit) -> HtmlToggleEvent*:
    let this = (HtmlToggleEvent*)web_allocate_cell(realm, &html_toggle_event_class)
    html_toggle_event_construct(this, realm_, event_name, event_init)
    web_initialize_cell(this.cell(), realm)
    return this
