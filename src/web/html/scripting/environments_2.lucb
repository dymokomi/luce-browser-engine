# mark: Scripting enabled and modules ===========================================================

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:287 Web::HTML::is_scripting_enabled.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-environment-script
pub func html_is_scripting_enabled(settings: HtmlEnvironmentSettingsObject*) -> bool:
    # Scripting is enabled for an environment settings object settings when all of the following conditions are true:
    # The user agent supports scripting.
    # NOTE: This is always true in LibWeb :^)

    # FIXME: Do the right thing for workers.
    let window = as_if_html_window((gc.Cell*)html_environment_settings_object_global_object(settings)) else return true

    # The user has not disabled scripting for realm at this time. (User agents may provide users with the option to disable scripting globally, or in a finer-grained manner, e.g., on a per-origin basis, down to the level of individual realms.)
    let document = html_window_associated_document(window)

    # NB: WebUI pages are internal pages requiring javascript, so we do not consider user configuration for these.
    if not page_is_scripting_enabled(dom_document_page(document)) and not web_url.is_webui_url(dom_document_url(document)):
        return false

    # Either settings's global object is not a Window object, or settings's global object's associated Document's active sandboxing flag set does not have its sandboxed scripts browsing context flag set.
    if (i32)(dom_document_active_sandboxing_flag_set(document) & HtmlSandboxingFlagSet.sandboxed_scripts) != 0:
        return false

    return true

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:312 Web::HTML::is_scripting_disabled.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-environment-noscript
pub func html_is_scripting_disabled(settings: HtmlEnvironmentSettingsObject*) -> bool:
    # Scripting is disabled for an environment settings object when scripting is not enabled for it, i.e., when any of the above conditions are false.
    return not html_is_scripting_enabled(settings)

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:319 Web::HTML::module_type_allowed.
## https://html.spec.whatwg.org/multipage/webappapis.html#module-type-allowed
pub func html_module_type_allowed(arg0: HtmlEnvironmentSettingsObject*, module_type: ak.StringView) -> bool:
    # 1. If moduleType is not "javascript-or-wasm", "css", or "json", then return false.
    if not ak.string_view_equals(&module_type, "javascript-or-wasm") and not ak.string_view_equals(&module_type, "css") and not ak.string_view_equals(&module_type, "json"):
        return false

    # FIXME: 2. If moduleType is "css" and the CSSStyleSheet interface is not exposed in settings's realm, then return false.

    # 3. Return true.
    return true

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:332 Web::HTML::add_module_to_resolved_module_set.
## https://html.spec.whatwg.org/multipage/webappapis.html#add-module-to-resolved-module-set
pub func html_add_module_to_resolved_module_set(settings_object: HtmlEnvironmentSettingsObject*, serialized_base_url: ak.String, normalized_specifier: ak.String, as_url: web_url.Url?):
    # 1. Let global be settingsObject's global object.
    let global = html_environment_settings_object_global_object(settings_object)

    # 2. If global does not implement Window, then return.
    let window = as_if_html_window((gc.Cell*)global) else return

    # 3. Let record be a new specifier resolution record, with serialized base URL set to serializedBaseURL,
    #    specifier set to normalizedSpecifier, and specifier as a URL set to asURL.
    #
    # NOTE: We set 'specifier as a URL set to asURL' as a bool to simplify logic when merging import maps.
    var specifier_is_null_or_url_like_that_is_special = true
    if let url = as_url:
        specifier_is_null_or_url_like_that_is_special = web_url.url_is_special(&url)
    let resolution = HtmlSpecifierResolution(serialized_base_url = serialized_base_url, specifier = normalized_specifier, specifier_is_null_or_url_like_that_is_special = specifier_is_null_or_url_like_that_is_special)

    # 4. Append record to global's resolved module set.
    html_window_append_resolved_module(window, resolution)

# mark: Incumbent, principal and current ========================================================

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:356 Web::HTML::incumbent_realm.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-incumbent-realm
pub func html_incumbent_realm() -> Realm*:
    # Then, the incumbent realm is the realm of the incumbent settings object.
    return html_environment_settings_object_realm(html_incumbent_settings_object())

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:363 Web::HTML::incumbent_settings_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#incumbent-settings-object
pub func html_incumbent_settings_object() -> HtmlEnvironmentSettingsObject*:
    let event_loop = html_main_thread_event_loop()
    let vm = js_cell_vm(event_loop.js_cell())

    # 1. Let context be the topmost script-having execution context.
    let context = html_top_most_script_having_execution_context(vm)

    # 2. If context is null, or if context's skip-when-determining-incumbent counter is greater than zero, then:
    var skip = true
    if let topmost = context:
        skip = topmost.skip_when_determining_incumbent_counter > 0
    if skip:
        # 1. Assert: the backup incumbent settings object stack is not empty.
        # 1. Assert: the backup incumbent realm stack is not empty.
        # NOTE: If this assertion fails, it's because the incumbent realm was used with no involvement of JavaScript.
        assert(not html_event_loop_is_backup_incumbent_realm_stack_empty(event_loop))

        # 2. Return the topmost entry of the backup incumbent realm stack.
        return html_event_loop_top_of_backup_incumbent_realm_stack(event_loop)

    # 3. Return context's Realm component's settings object.
    let topmost = context else trap("VERIFY: a topmost script-having execution context")
    let realm = topmost.realm else trap("the topmost script-having execution context has no realm")
    return html_principal_realm_settings_object(realm)

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:387 Web::HTML::incumbent_global_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-incumbent-global
pub func html_incumbent_global_object() -> JsObject*:
    # Similarly, the incumbent global object is the global object of the incumbent settings object.
    return html_environment_settings_object_global_object(html_incumbent_settings_object())

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:394 Web::HTML::principal_realm_settings_object.
## https://whatpr.org/html/9893/webappapis.html#concept-realm-settings-object
pub func html_principal_realm_settings_object(realm: Realm*) -> HtmlEnvironmentSettingsObject*:
    # A principal realm has a [[HostDefined]] field, which contains the principal realm's settings object.
    return bind_principal_host_defined_environment_settings_object(realm)

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:401 Web::HTML::current_settings_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#current-settings-object
pub func html_current_settings_object() -> HtmlEnvironmentSettingsObject*:
    # Then, the current settings object is the environment settings object of the current realm.
    return html_principal_realm_settings_object(vm_current_realm(bind_main_thread_vm()) else trap("no current realm"))

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:408 Web::HTML::current_global_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#current-global-object
pub func html_current_global_object() -> JsObject*:
    # Similarly, the current global object is the global object of the current realm.
    return realm_global_object(vm_current_realm(bind_main_thread_vm()) else trap("no current realm"))

