## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:415 Web::HTML::relevant_realm.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-relevant-realm
pub func html_relevant_realm(object: JsObject*) -> Realm*:
    # The relevant Realm for a platform object is the value of its [[Realm]] field.
    return js_object_shape_realm(object)

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:422 Web::HTML::relevant_settings_object (JS::Object const&).
## https://html.spec.whatwg.org/multipage/webappapis.html#relevant-settings-object
pub func html_relevant_settings_object_js_object(object: JsObject*) -> HtmlEnvironmentSettingsObject*:
    # Then, the relevant settings object for a platform object o is the environment settings object of the relevant realm for o.
    return bind_principal_host_defined_environment_settings_object(html_relevant_realm(object))

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:428 Web::HTML::relevant_settings_object (DOM::Node const&).
pub func html_relevant_settings_object_dom_node(node: DomNode*) -> HtmlEnvironmentSettingsObject*:
    # Then, the relevant settings object for a platform object o is the environment settings object of the relevant Realm for o.
    return dom_document_relevant_settings_object(dom_node_document(node))

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:435 Web::HTML::relevant_global_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-relevant-global
pub func html_relevant_global_object(object: JsObject*) -> JsObject*:
    # Similarly, the relevant global object for a platform object o is the global object of the relevant Realm for o.
    return realm_global_object(html_relevant_realm(object))

# mark: Entry ===================================================================================

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:442 Web::HTML::entry_realm.
## https://html.spec.whatwg.org/multipage/webappapis.html#concept-entry-realm
pub func html_entry_realm() -> Realm*:
    let event_loop = html_main_thread_event_loop()
    let vm = js_cell_vm(event_loop.js_cell())

    # With this in hand, we define the entry execution context to be the most recently pushed item in the JavaScript execution context stack that is a realm execution context.
    # The entry realm is the entry execution context's Realm component.
    # (vm.last_execution_context_matching: the stack from the top down.)
    let stack = vm_execution_context_stack(vm)
    var index = stack.length
    while index > 0:
        index -= 1
        let context = stack[index]
        let realm = context.realm else continue
        if html_environment_settings_object_realm_execution_context(html_principal_realm_settings_object(realm)) == context:
            return realm

    trap("VERIFY: an entry execution context")

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:460 Web::HTML::entry_settings_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#entry-settings-object
pub func html_entry_settings_object() -> HtmlEnvironmentSettingsObject*:
    # Then, the entry settings object is the environment settings object of the entry realm.
    return bind_principal_host_defined_environment_settings_object(html_entry_realm())

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:467 Web::HTML::entry_global_object.
## https://html.spec.whatwg.org/multipage/webappapis.html#entry-global-object
pub func html_entry_global_object() -> JsObject*:
    # Similarly, the entry global object is the global object of the entry realm.
    return realm_global_object(html_entry_realm())

# mark: Secure contexts =========================================================================

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:474 Web::HTML::is_secure_context.
## https://html.spec.whatwg.org/multipage/webappapis.html#secure-context
pub func html_is_secure_context(environment: HtmlEnvironment*) -> bool:
    # 1. If environment is an environment settings object, then:
    if let environment_settings_object = as_if_html_environment_settings_object(environment):
        # 1. Let global be environment's global object.
        let global = html_environment_settings_object_global_object(environment_settings_object)

        # 2. If global is a WorkerGlobalScope, then:
        #    1. If global's owner set[0]'s relevant settings object is a secure context, then return true.
        #    NOTE: We only need to check the 0th item since they will necessarily all be consistent.
        #    2. Return false.
        # (No WorkerGlobalScope exists before workers, phase 4: every global is a Window or a test global.)
        _ = global

        # FIXME: 3. If global is a WorkletGlobalScope, then return true.
        # NOTE: Worklets can only be created in secure contexts.

    # 2. If the result of Is url potentially trustworthy? given environment's top-level creation URL is "Potentially Trustworthy", then return true.
    if secure_contexts_is_url_potentially_trustworthy(environment.top_level_creation_url else trap("VERIFY: the environment has a top-level creation URL")) == SecureContextsTrustworthiness.potentially_trustworthy:
        return true

    # 3. Return false.
    return false

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:505 Web::HTML::is_non_secure_context.
## https://html.spec.whatwg.org/multipage/webappapis.html#non-secure-context
pub func html_is_non_secure_context(environment: HtmlEnvironment*) -> bool:
    # An environment is a non-secure context if it is not a secure context.
    return not html_is_secure_context(environment)

# mark: Serialization, storage and service workers ==============================================

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:511 Web::HTML::EnvironmentSettingsObject::serialize.
pub func html_environment_settings_object_serialize(this: HtmlEnvironmentSettingsObject*) -> HtmlSerializedEnvironmentSettingsObject:
    # The lambda serialized_global.
    let relevant_settings_object_is_secure_context = html_is_secure_context(this.html_environment())
    let window = as_if_html_window((gc.Cell*)html_environment_settings_object_global_object(this)) else trap("unported (P4): VERIFY(is<WorkerGlobalScope>(global_object())): SerializedWorkerGlobalScope")
    let serialized_global = HtmlSerializedGlobal.html_serialized_window(HtmlSerializedWindow(associated_document = HtmlSerializedDocument(url = dom_document_url(html_window_associated_document(window)), relevant_settings_object_is_secure_context = relevant_settings_object_is_secure_context)))

    let environment = this.html_environment()
    return HtmlSerializedEnvironmentSettingsObject(id = environment.id, creation_url = environment.creation_url, top_level_creation_url = environment.top_level_creation_url, top_level_origin = environment.top_level_origin, api_base_url = html_environment_settings_object_api_base_url(this), origin = html_environment_settings_object_origin(this), has_cross_site_ancestor = html_environment_settings_object_has_cross_site_ancestor(this), policy_container = html_policy_container_serialize(html_environment_settings_object_policy_container(this)), cross_origin_isolated_capability = html_environment_settings_object_cross_origin_isolated_capability(this), time_origin = html_environment_settings_object_time_origin(this), global = serialized_global)

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:544 Web::HTML::EnvironmentSettingsObject::storage_manager.
pub func html_environment_settings_object_storage_manager(this: HtmlEnvironmentSettingsObject*) -> StorageApiStorageManager*:
    if let storage_manager = this.m_storage_manager:
        return storage_manager
    # m_storage_manager = realm().create<StorageAPI::StorageManager>(realm());
    trap("unported (P4): StorageAPI::StorageManager::create")

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:552 Web::HTML::EnvironmentSettingsObject::get_service_worker_registration_object.
## https://w3c.github.io/ServiceWorker/#get-the-service-worker-registration-object
pub func html_environment_settings_object_get_service_worker_registration_object(this: HtmlEnvironmentSettingsObject*, registration: ServiceWorkerRegistration) -> ServiceWorkerServiceWorkerRegistration*:
    # 1. Let objectMap be environment’s service worker registration object map.
    # FIXME: File spec issue asking if this should be keyed on the registration's scope url only or on the url and the storage key
    # 2. If objectMap[registration] does not exist, then:
    #    1. Let registrationObject be a new ServiceWorkerRegistration in environment’s Realm.
    #    2-5. Set registrationObject’s service worker registration to registration and its installing, waiting
    #         and active attributes to null.
    #    6-8. Set the installing, waiting and active attributes to the service worker objects of registration's
    #         installing, waiting and active workers, if any.
    #    9. Set objectMap[registration] to registrationObject.
    # 3. Return objectMap[registration].
    trap("unported (P4): ServiceWorker::ServiceWorkerRegistration::create")

## Ported from Libraries/LibWeb/HTML/Scripting/Environments.cpp:589 Web::HTML::EnvironmentSettingsObject::get_service_worker_object.
## https://w3c.github.io/ServiceWorker/#get-the-service-worker-object
pub func html_environment_settings_object_get_service_worker_object(this: HtmlEnvironmentSettingsObject*, service_worker: ServiceWorkerServiceWorkerRecord*?) -> ServiceWorkerServiceWorker*:
    # 1. Let objectMap be environment’s service worker object map.
    # 2. If objectMap[serviceWorker] does not exist, then:
    #    1. Let serviceWorkerObj be a new ServiceWorker in environment’s Realm, and associate it with serviceWorker.
    #    2. Set serviceWorkerObj’s state to serviceWorker’s state.
    #    3. Set objectMap[serviceWorker] to serviceWorkerObj.
    # 3. Return objectMap[serviceWorker].
    trap("unported (P4): ServiceWorker::ServiceWorker::create")

