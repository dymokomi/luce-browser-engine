#==============================================================================================
#
#   types_message_port - declarations of Libraries/LibWeb/HTML/MessagePort.h
#
#   DESCRIPTION:
#       MessagePort is outside the skeleton's phase-2 closure (it was an opaque struct with two
#       stubs, for Document::destroy); declared here by hand in the generator's shape by region
#       p2r, which ports the registry of all ports that destroy() walks. Like the other
#       hand-declared classes it has its base's class id (EventTarget's, 49), so
#       is<EventTarget> holds for it, and is recognized by its ClassInfo. The transport
#       (IPC::Transport) and the queues of serialized messages are phase 4's messaging: no port
#       is entangled before then.
#
#==============================================================================================

# mark: HtmlMessagePort =========================================================================

## Web::HTML::MessagePort (Libraries/LibWeb/HTML/MessagePort.h:28).
pub struct HtmlMessagePort: IsHtmlMessagePort, IsDomEventTarget, IsBindPlatformObject, IsJsCell, gc.IsCell:
    pub var event_target: DomEventTarget  # primary base
    ## The HTML spec implies(!) that this is MessagePort.[[RemotePort]]
    pub var m_remote_port: HtmlMessagePort*?
    # https://html.spec.whatwg.org/multipage/web-messaging.html#has-been-shipped
    pub var m_has_been_shipped: bool  # C++ default: { false }
    ## OwnPtr<IPC::Transport>: phase 4 (messaging); always none before.
    pub var m_transport: void*?
    pub var m_worker_event_target: DomEventTarget*?
    # (Vector<SerializedTransferRecord> m_pending_incoming_messages, m_pending_outgoing_messages: phase 4.)
    pub var m_should_shutdown_on_enable: bool  # C++ default: { false }
    pub var m_enabled: bool  # C++ default: { false }

    func html_message_port() -> HtmlMessagePort*: return (HtmlMessagePort*)&self

    func dom_event_target() -> DomEventTarget*: return (DomEventTarget*)&self

    func bind_platform_object() -> BindPlatformObject*: return (BindPlatformObject*)&self

    func js_cell() -> JsCell*: return (JsCell*)&self

    func cell() -> gc.Cell*: return (gc.Cell*)&self

## Upcast to Web::HTML::MessagePort (implemented by every struct in its hierarchy).
pub interface IsHtmlMessagePort:
    func html_message_port() -> HtmlMessagePort*

## The vtable of Web::HTML::MessagePort (it introduces no virtuals; OVERRIDES_FINALIZE).
pub let html_message_port_vtable: DomEventTargetVTable = DomEventTargetVTable(platform_object_vtable = BindPlatformObjectVTable(cell_vtable = JsCellVTable(cell_vtable = gc.CellVTable(class_info = &html_message_port_class,
                                                                                                                                                                                       visit_edges = html_message_port_visit_edges_impl,
                                                                                                                                                                                       finalize = html_message_port_finalize_impl),
                                                                                                                                                         initialize = html_message_port_initialize_impl)))

## Class information of Web::HTML::MessagePort: EventTarget's class id (types_event_target).
pub let html_message_port_class: ak.ClassInfo = ak.ClassInfo(name = "MessagePort", first_id = 49, last_id = 49, size = memory.size_of(HtmlMessagePort), vtable = (const void*)&html_message_port_vtable)

## is<Web::HTML::MessagePort>: the cell's ClassInfo.
pub func is_html_message_port[P: gc.IsCell](p: P*) -> bool:
    return p.cell().vtable.class_info == &html_message_port_class

## as_if<Web::HTML::MessagePort>.
pub func as_if_html_message_port[P: gc.IsCell](p: P*) -> HtmlMessagePort*?:
    if is_html_message_port(p): return (HtmlMessagePort*)p
    return none

## as<Web::HTML::MessagePort> (verify_cast).
pub func as_html_message_port[P: gc.IsCell](p: P*) -> HtmlMessagePort*:
    return as_if_html_message_port(p) else trap("as<Web::HTML::MessagePort> failed")

## realm.create<Web::HTML::MessagePort>(realm): allocate under DeferGC, construct, then initialize(realm).
pub func realm_create_html_message_port(realm: Realm*, realm_: Realm*) -> HtmlMessagePort*:
    let this = (HtmlMessagePort*)web_allocate_cell(realm, &html_message_port_class)
    html_message_port_construct(this, realm_)
    web_initialize_cell(this.cell(), realm)
    return this
