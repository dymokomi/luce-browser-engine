## Ported from BrowsingContext.cpp:432 Web::HTML::BrowsingContext::is_ancestor_of.
# https://html.spec.whatwg.org/multipage/document-sequences.html#ancestor-browsing-context
pub func html_browsing_context_is_ancestor_of(this: HtmlBrowsingContext*, potential_descendant: HtmlBrowsingContext*) -> bool:
    # A browsing context potentialDescendant is said to be an ancestor of a browsing context potentialAncestor if the following algorithm returns true:

    # 1. Let potentialDescendantDocument be potentialDescendant's active document.
    let potential_descendant_document = html_browsing_context_active_document_const(potential_descendant) else trap("no active document")

    # 2. If potentialDescendantDocument is not fully active, then return false.
    if not dom_document_is_fully_active(potential_descendant_document):
        return false

    # 3. Let ancestorBCs be the list obtained by taking the browsing context of the active document of each member of potentialDescendantDocument's ancestor navigables.
    var ancestors = dom_document_ancestor_navigables(potential_descendant_document)
    for ancestor in ak.vector_span(&ancestors):
        let ancestor_browsing_context = html_navigable_active_browsing_context(ancestor else trap("no ancestor"))

        # 4. If ancestorBCs contains potentialAncestor, then return true.
        if ancestor_browsing_context == this:
            return true

    # 5. Return false.
    return false

## Ported from BrowsingContext.cpp:457 Web::HTML::BrowsingContext::is_familiar_with.
# https://html.spec.whatwg.org/multipage/document-sequences.html#familiar-with
pub func html_browsing_context_is_familiar_with(this: HtmlBrowsingContext*, other: HtmlBrowsingContext*) -> bool:
    # A browsing context A is familiar with a second browsing context B if the following algorithm returns true:
    let a = this
    let b = other
    let a_document = html_browsing_context_active_document_const(a) else trap("no active document")
    let b_document = html_browsing_context_active_document_const(b) else trap("no active document")

    # 1. If A's active document's origin is same origin with B's active document's origin, then return true.
    let a_origin = dom_document_origin(a_document)
    if web_url.origin_is_same_origin(&a_origin, dom_document_origin(b_document)):
        return true

    # 2. If A's top-level browsing context is B, then return true.
    if html_browsing_context_top_level_browsing_context(a) == b:
        return true

    # 3. If B is an auxiliary browsing context and A is familiar with B's opener browsing context, then return true.
    if let b_opener = html_browsing_context_opener_browsing_context(b):
        if html_browsing_context_is_familiar_with(a, b_opener):
            return true

    # 4. If there exists an ancestor browsing context of B whose active document has the same origin as the active document of A, then return true.
    # NOTE: This includes the case where A is an ancestor browsing context of B.

    # If B's active document is not fully active then it cannot have ancestor browsing context
    if not dom_document_is_fully_active(b_document):
        return false

    var ancestors = dom_document_ancestor_navigables(b_document)
    for ancestor in ak.vector_span(&ancestors):
        let ancestor_document = html_navigable_active_document(ancestor else trap("no ancestor")) else trap("no active document")
        let ancestor_origin = dom_document_origin(ancestor_document)
        if web_url.origin_is_same_origin(&ancestor_origin, dom_document_origin(a_document)):
            return true

    # 5. Return false.
    return false

## Ported from BrowsingContext.cpp:492 Web::HTML::determine_the_creation_sandboxing_flags.
# https://html.spec.whatwg.org/multipage/browsers.html#determining-the-creation-sandboxing-flags
pub func html_determine_the_creation_sandboxing_flags(browsing_context: HtmlBrowsingContext*, embedder: DomElement*?) -> HtmlSandboxingFlagSet:
    # To determine the creation sandboxing flags for a browsing context browsing context, given null or an element
    # embedder, return the union of the flags that are present in the following sandboxing flag sets:
    var sandboxing_flags = (HtmlSandboxingFlagSet)0

    # - If embedder is null, then: the flags set on browsing context's popup sandboxing flag set.
    if let embedder_element = embedder:
        # - If embedder is an element, then: the flags set on embedder's iframe sandboxing flag set.
        if let iframe_element = as_if_html_htmli_frame_element(embedder_element):
            sandboxing_flags |= html_htmli_frame_element_iframe_sandboxing_flag_set(iframe_element)

        # - If embedder is an element, then: the flags set on embedder's node document's active sandboxing flag set.
        sandboxing_flags |= dom_document_active_sandboxing_flag_set(dom_node_document(embedder_element.dom_node()))
    else:
        sandboxing_flags |= html_browsing_context_popup_sandboxing_flag_set(browsing_context)

    return sandboxing_flags

## Ported from BrowsingContext.cpp:515 Web::HTML::BrowsingContext::has_navigable_been_destroyed.
pub func html_browsing_context_has_navigable_been_destroyed(this: HtmlBrowsingContext*) -> bool:
    let active_document = html_browsing_context_active_document_const(this) else trap("no active document")
    let navigable = dom_document_navigable(active_document) else return true
    return html_navigable_has_been_destroyed(navigable)

