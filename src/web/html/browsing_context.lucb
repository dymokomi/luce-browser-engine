# mark: URL helpers =============================================================================

## Ported from BrowsingContext.cpp:34 Web::HTML::url_matches_about_blank.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#matches-about:blank
pub func html_url_matches_about_blank(url: web_url.Url) -> bool:
    # A URL matches about:blank if its scheme is "about", its path contains a single string "blank", its username and password are the empty string, and its host is null.
    let scheme = web_url.url_scheme(&url)
    let paths = web_url.url_paths(&url)
    let username = web_url.url_username(&url)
    let password = web_url.url_password(&url)
    return ak.string_eq_string_view(&scheme, ak.sv("about")) and ak.vector_size(&paths) == 1 and ak.string_eq_string_view(ak.vector_at_const(&paths, 0), ak.sv("blank")) and ak.string_is_empty(&username) and ak.string_is_empty(&password) and web_url.url_host(&url) == none

## Ported from BrowsingContext.cpp:45 Web::HTML::url_matches_about_srcdoc.
# https://html.spec.whatwg.org/multipage/urls-and-fetching.html#matches-about:srcdoc
pub func html_url_matches_about_srcdoc(url: web_url.Url) -> bool:
    # A URL matches about:srcdoc if its scheme is "about", its path contains a single string "srcdoc", its query is null, its username and password are the empty string, and its host is null.
    let scheme = web_url.url_scheme(&url)
    let paths = web_url.url_paths(&url)
    let username = web_url.url_username(&url)
    let password = web_url.url_password(&url)
    return ak.string_eq_string_view(&scheme, ak.sv("about")) and ak.vector_size(&paths) == 1 and ak.string_eq_string_view(ak.vector_at_const(&paths, 0), ak.sv("srcdoc")) and web_url.url_query(&url) == none and ak.string_is_empty(&username) and ak.string_is_empty(&password) and web_url.url_host(&url) == none

## Ported from BrowsingContext.cpp:57 Web::HTML::determine_the_origin.
# https://html.spec.whatwg.org/multipage/document-sequences.html#determining-the-origin
pub func html_determine_the_origin(url: const web_url.Url*?, sandbox_flags: HtmlSandboxingFlagSet, source_origin: web_url.Origin?) -> web_url.Origin:
    # 1. If sandboxFlags has its sandboxed origin browsing context flag set, then return a new opaque origin.
    if html_has_flag(sandbox_flags, HtmlSandboxingFlagSet.sandboxed_origin):
        return web_url.origin_create_opaque()

    # 2. If url is null, then return a new opaque origin.
    let the_url = url else return web_url.origin_create_opaque()

    # 3. If url is about:srcdoc, then:
    if web_url.url_eq(the_url, web_url.about_srcdoc()):
        # 1. Assert: sourceOrigin is non-null.
        # 2. Return sourceOrigin.
        return source_origin else trap("VERIFY: source_origin.has_value()")

    # 4. If url matches about:blank and sourceOrigin is non-null, then return sourceOrigin.
    if html_url_matches_about_blank(*the_url):
        if let origin = source_origin:
            return origin

    # 5. Return url's origin.
    return web_url.url_origin(the_url)

# mark: Creating browsing contexts ==============================================================

## Ported from BrowsingContext.cpp:87 Web::HTML::BrowsingContext::create_a_new_auxiliary_browsing_context_and_document.
# https://html.spec.whatwg.org/multipage/document-sequences.html#creating-a-new-auxiliary-browsing-context
pub func html_browsing_context_create_a_new_auxiliary_browsing_context_and_document(page: Page*, opener: HtmlBrowsingContext*) -> HtmlBrowsingContextBrowsingContextAndDocument:
    # 1. Let openerTopLevelBrowsingContext be opener's top-level traversable's active browsing context.
    let opener_top_level_browsing_context = html_navigable_active_browsing_context(html_browsing_context_top_level_traversable(opener).html_navigable()) else trap("no active browsing context")

    # 2. Let group be openerTopLevelBrowsingContext's group.
    # 3. Assert: group is non-null, as navigating invokes this directly.
    let group = html_browsing_context_group(opener_top_level_browsing_context) else trap("VERIFY: group")

    # 4. Set browsingContext and document be the result of creating a new browsing context and document with opener's active document, null, and group.
    let created = html_browsing_context_create_a_new_browsing_context_and_document(page, html_browsing_context_active_document(opener), none, group)
    let browsing_context = created.browsing_context
    let document = created.document

    # 5. Set browsingContext's is auxiliary to true.
    browsing_context.m_is_auxiliary = true

    # 6. Append browsingContext to group.
    html_browsing_context_group_append(group, browsing_context)

    # 7. Set browsingContext's opener browsing context to opener.
    html_browsing_context_set_opener_browsing_context(browsing_context, opener)

    # 8. Set browsingContext's virtual browsing context group ID to openerTopLevelBrowsingContext's virtual browsing context group ID.
    browsing_context.m_virtual_browsing_context_group_id = opener_top_level_browsing_context.m_virtual_browsing_context_group_id

    # 9. Set browsingContext's opener origin at creation to opener's active document's origin.
    browsing_context.m_opener_origin_at_creation = dom_document_origin(html_browsing_context_active_document(opener) else trap("no active document"))

    # 10. Return browsingContext and document.
    return HtmlBrowsingContextBrowsingContextAndDocument(browsing_context = browsing_context, document = document)

## Ported from BrowsingContext.cpp:120 Web::HTML::populate_with_html_head_body.
func html_populate_with_html_head_body(document: DomDocument*):
    let html_node = dom_create_element(document, html_tag_names_html, namespace_html) else trap("MUST: create_element")
    let head_element = dom_create_element(document, html_tag_names_head, namespace_html) else trap("MUST: create_element")
    _ = dom_node_append_child(html_node.dom_node(), head_element.dom_node()) else trap("MUST: append_child")
    let body_element = dom_create_element(document, html_tag_names_body, namespace_html) else trap("MUST: create_element")
    _ = dom_node_append_child(html_node.dom_node(), body_element.dom_node()) else trap("MUST: append_child")
    _ = dom_node_append_child(document.dom_node(), html_node.dom_node()) else trap("MUST: append_child")

## The captures of create_a_new_browsing_context_and_document's two realm customizations: the
## browsing context and `window` by reference.
struct HtmlBrowsingContextCreateRealmCustomizations:
    var browsing_context: HtmlBrowsingContext*
    var window: HtmlWindow*?

## create_a_new_browsing_context_and_document's first realm customization: the WindowProxy and,
## for the global object, a new Window.
func html_browsing_context_create_global_object(context: void*?, realm: Realm*) -> JsObject*?:
    let captures = (HtmlBrowsingContextCreateRealmCustomizations*)(context else trap("no captures"))
    let window_proxy = realm_create_html_window_proxy(realm, realm)
    html_browsing_context_set_window_proxy(captures.browsing_context, window_proxy)

    # - For the global object, create a new Window object.
    let window = html_window_create(realm)
    captures.window = window
    return (JsObject*)window

## create_a_new_browsing_context_and_document's second realm customization: the browsing
## context's WindowProxy.
func html_browsing_context_create_global_this_value(context: void*?, realm: Realm*) -> JsObject*?:
    let captures = (HtmlBrowsingContextCreateRealmCustomizations*)(context else trap("no captures"))
    # - For the global this binding, use browsingContext's WindowProxy object.
    return (JsObject*?)html_browsing_context_window_proxy(captures.browsing_context)

## `vm.heap().allocate<BrowsingContext>(page)`: a BrowsingContext cell constructed under DeferGC.
func heap_allocate_html_browsing_context(heap: gc.Heap*, page: Page*) -> HtmlBrowsingContext*:
    let browsing_context = (HtmlBrowsingContext*)web_heap_allocate_cell(heap, &html_browsing_context_class)
    gc.heap_defer_gc(heap)
    html_browsing_context_construct(browsing_context, page)
    gc.heap_undefer_gc(heap)
    return browsing_context

## Ported from BrowsingContext.cpp:131 Web::HTML::BrowsingContext::create_a_new_browsing_context_and_document.
# https://html.spec.whatwg.org/multipage/document-sequences.html#creating-a-new-browsing-context
pub func html_browsing_context_create_a_new_browsing_context_and_document(page: Page*, creator: DomDocument*?, embedder: DomElement*?, group: HtmlBrowsingContextGroup*) -> HtmlBrowsingContextBrowsingContextAndDocument:
    let vm = js_cell_vm(group.js_cell())

    # 1. Let browsingContext be a new browsing context.
    let browsing_context = heap_allocate_html_browsing_context(vm_heap(vm), page)

    # 2. Let unsafeContextCreationTime be the unsafe shared current time.
    let unsafe_context_creation_time = high_resolution_time_unsafe_shared_current_time()

    # 3. Let creatorOrigin be null.
    var creator_origin: web_url.Origin? = none

    # 4. Let creatorBaseURL be null.
    var creator_base_url: web_url.Url? = none

    # 5. If creator is non-null, then:
    if let creator_document = creator:
        # 1. Set creatorOrigin to creator's origin.
        creator_origin = dom_document_origin(creator_document)

        # 2. Set creatorBaseURL to creator's document base URL.
        creator_base_url = dom_document_base_url(creator_document)

        # 3. Set browsingContext's virtual browsing context group ID to creator's browsing context's top-level browsing context's virtual browsing context group ID.
        let creator_browsing_context = dom_document_browsing_context(creator_document) else trap("VERIFY: creator->browsing_context()")
        let creator_top_level = html_browsing_context_top_level_browsing_context(creator_browsing_context) else trap("no top-level browsing context")
        browsing_context.m_virtual_browsing_context_group_id = creator_top_level.m_virtual_browsing_context_group_id

    # 6. Let sandboxFlags be the result of determining the creation sandboxing flags given browsingContext and embedder.
    let sandbox_flags = html_determine_the_creation_sandboxing_flags(browsing_context, embedder)

    # 7. Let origin be the result of determining the origin given about:blank, sandboxFlags, and creatorOrigin.
    let about_blank = web_url.about_blank()
    let origin = html_determine_the_origin(&about_blank, sandbox_flags, creator_origin)

    # FIXME: 8. Let permissionsPolicy be the result of creating a permissions policy given embedder and origin. [PERMISSIONSPOLICY]

    # FIXME: 9. Let agent be the result of obtaining a similar-origin window agent given origin, group, and false.

    var captures = HtmlBrowsingContextCreateRealmCustomizations(browsing_context = browsing_context, window = none)

    # 10. Let realm execution context be the result of creating a new JavaScript realm given agent and the following customizations:
    let realm_execution_context = bind_create_a_new_javascript_realm(
        bind_main_thread_vm(),
        ak.Function1[Realm*, JsObject*?](call = html_browsing_context_create_global_object, context = &captures),
        ak.Function1[Realm*, JsObject*?](call = html_browsing_context_create_global_this_value, context = &captures),
    )

    let window = captures.window else trap("the realm has no Window")
    let realm = bind_platform_object_realm(window.bind_platform_object())

    # 11. Let topLevelCreationURL be about:blank if embedder is null; otherwise embedder's relevant settings object's top-level creation URL.
    var top_level_creation_url = web_url.about_blank()
    # 12. Let topLevelOrigin be origin if embedder is null; otherwise embedder's relevant settings object's top-level origin.
    var top_level_origin = origin
    if let embedder_element = embedder:
        let embedder_settings = html_relevant_settings_object_dom_node(embedder_element.dom_node())
        top_level_creation_url = embedder_settings.environment.top_level_creation_url else trap("VERIFY: a top-level creation URL")
        top_level_origin = html_environment_settings_object_origin(embedder_settings)

    # 13. Set up a window environment settings object with about:blank, realm execution context, null, topLevelCreationURL, and topLevelOrigin.
    html_window_environment_settings_object_setup(page, web_url.about_blank(), realm_execution_context, none, top_level_creation_url, top_level_origin)

    # 14. Let loadTimingInfo be a new document load timing info with its navigation start time set to the result of calling
    #     coarsen time with unsafeContextCreationTime and the new environment settings object's cross-origin isolated capability.
    var load_timing_info = DomDocumentLoadTimingInfo()
    let settings_object = as_html_window_environment_settings_object((gc.Cell*)bind_principal_host_defined_environment_settings_object(realm))
    load_timing_info.navigation_start_time = high_resolution_time_coarsen_time(unsafe_context_creation_time, html_environment_settings_object_cross_origin_isolated_capability(settings_object.html_environment_settings_object()))

    # 15. Let document be a new Document, with:
    let document = html_document_create(realm, web_url.about_blank()).dom_document()

    # Non-standard
    html_window_set_associated_document(window, document)

    # type: "html"
    dom_document_set_document_type(document, DocumentDomDocumentType.html)

    # content type: "text/html"
    dom_document_set_content_type(document, ak.string_from_str("text/html"))

    # mode: "quirks"
    dom_document_set_quirks_mode(document, DomQuirksMode.yes)

    # origin: origin
    dom_document_set_origin(document, origin)

    # browsing context: browsingContext
    dom_document_set_browsing_context(document, browsing_context)

    # FIXME: permissions policy: permissionsPolicy

    # active sandboxing flag set: sandboxFlags
    dom_document_set_active_sandboxing_flag_set(document, sandbox_flags)

    # load timing info: loadTimingInfo
    dom_document_set_load_timing_info(document, load_timing_info)

    # is initial about:blank: true
    dom_document_set_is_initial_about_blank(document, true)
    # Spec issue: https://github.com/whatwg/html/issues/10261
    dom_document_set_ready_to_run_scripts(document)

    # about base URL: creatorBaseURL
    dom_document_set_about_base_url(document, creator_base_url)

    # allow declarative shadow roots: true
    dom_document_set_allow_declarative_shadow_roots(document, true)

    # custom element registry: A new CustomElementRegistry object.
    dom_document_set_custom_element_registry(document, realm_create_html_custom_element_registry(realm, realm))

    # 16. If creator is non-null, then:
    if let creator_document = creator:
        # 1. Set document's referrer to the serialization of creator's URL.
        let creator_url = dom_document_url(creator_document)
        dom_document_set_referrer(document, web_url.url_serialize(&creator_url))

        # 2. Set document's policy container to a clone of creator's policy container.
        dom_document_set_policy_container(document, html_policy_container_clone(dom_document_policy_container(creator_document), gc.cell_heap(document.cell())))

        # 3. If creator's origin is same origin with creator's relevant settings object's top-level origin,
        let creator_origin_value = dom_document_origin(creator_document)
        if web_url.origin_is_same_origin(&creator_origin_value, dom_document_relevant_settings_object(creator_document).environment.top_level_origin else trap("VERIFY: a top-level origin")):
            # then set document's opener policy to creator's browsing context's top-level browsing context's active document's opener policy.
            let creator_browsing_context = dom_document_browsing_context(creator_document) else trap("VERIFY: creator->browsing_context()")
            let creator_top_level = html_browsing_context_top_level_browsing_context(creator_browsing_context) else trap("no top-level browsing context")
            let creator_top_document = html_browsing_context_active_document(creator_top_level) else trap("VERIFY: an active document")
            dom_document_set_opener_policy(document, dom_document_opener_policy(creator_top_document))

    # 17. Assert: document's URL and document's relevant settings object's creation URL are about:blank.
    let document_url = dom_document_url(document)
    assert(web_url.url_eq(&document_url, web_url.about_blank()))
    let creation_url = dom_document_relevant_settings_object(document).environment.creation_url
    assert(web_url.url_eq(&creation_url, web_url.about_blank()))

    # 18. Mark document as ready for post-load tasks.
    dom_document_set_ready_for_post_load_tasks(document, true)

    # 19. Populate with html/head/body given document.
    html_populate_with_html_head_body(document)

    # 20. Make active document.
    dom_document_make_active(document)

    # 21. Completely finish loading document.
    dom_document_completely_finish_loading(document)

    # 22. Return browsingContext and document.
    return HtmlBrowsingContextBrowsingContextAndDocument(browsing_context = browsing_context, document = document)

