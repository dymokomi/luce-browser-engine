## Ported from BrowsingContext.cpp:292 Web::HTML::BrowsingContext::BrowsingContext.
pub func html_browsing_context_construct(this: HtmlBrowsingContext*, page: Page*):
    html_browsing_context_init_fields(this)
    this.m_page = page

## Ported from BrowsingContext.cpp:299 Web::HTML::BrowsingContext::visit_edges (override).
pub func html_browsing_context_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlBrowsingContext*)base
    gc.cell_visit_edges_impl(base, visitor)

    gc.cell_visitor_visit_t_2(visitor, this.m_page)
    gc.cell_visitor_visit_t(visitor, this.m_window_proxy)
    gc.cell_visitor_visit_t(visitor, this.m_group)
    gc.cell_visitor_visit_t(visitor, this.m_opener_browsing_context)

## Ported from BrowsingContext.cpp:310 Web::HTML::BrowsingContext::top_level_traversable.
# https://html.spec.whatwg.org/multipage/document-sequences.html#bc-traversable
pub func html_browsing_context_top_level_traversable(this: HtmlBrowsingContext*) -> HtmlTraversableNavigable*:
    # A browsing context's top-level traversable is its active document's node navigable's top-level traversable.
    let active_document = html_browsing_context_active_document(this) else trap("no active document")
    let navigable = dom_document_navigable(active_document) else trap("no navigable")
    let traversable = html_navigable_top_level_traversable(navigable) else trap("VERIFY: traversable")
    assert(html_navigable_is_top_level_traversable(traversable.html_navigable()))
    return traversable

## Ported from BrowsingContext.cpp:320 Web::HTML::BrowsingContext::is_top_level.
# https://html.spec.whatwg.org/multipage/browsers.html#top-level-browsing-context
pub func html_browsing_context_is_top_level(this: HtmlBrowsingContext*) -> bool:
    # A top-level browsing context is a browsing context whose active document's node navigable is a traversable navigable.
    let active_document = html_browsing_context_active_document(this) else return false
    let navigable = dom_document_navigable(active_document) else return false
    return html_navigable_is_traversable(navigable)

## Ported from BrowsingContext.cpp:326 Web::HTML::BrowsingContext::top_level_browsing_context.
pub func html_browsing_context_top_level_browsing_context(this: HtmlBrowsingContext*) -> HtmlBrowsingContext*?:
    let start = this
    let start_document = html_browsing_context_active_document(start) else trap("no active document")

    # 1. If start's active document is not fully active, then return null.
    if not dom_document_is_fully_active(start_document):
        return none

    # 2. Let navigable be start's active document's node navigable.
    var navigable = dom_document_navigable(start_document) else trap("no navigable")

    # 3. While navigable's parent is not null, set navigable to navigable's parent.
    while let parent = html_navigable_parent(navigable):
        navigable = parent

    # 4. Return navigable's active browsing context.
    return html_navigable_active_browsing_context(navigable)

