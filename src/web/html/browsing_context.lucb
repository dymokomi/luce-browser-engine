## Ported from BrowsingContextGroup.cpp:23 Web::HTML::BrowsingContextGroup::BrowsingContextGroup.
## (The user agent's browsing context group set holds raw pointers, as C++'s static HashTable of
## GC::Refs: the set does not keep its groups alive, and finalize removes them.)
pub func html_browsing_context_group_construct(this: HtmlBrowsingContextGroup*, page: Page*):
    this.m_page = page
    with memory.heap:
        _ = ak.hash_table_set(html_user_agent_browsing_context_group_set(), this)

## Ported from BrowsingContextGroup.cpp:29 Web::HTML::BrowsingContextGroup::finalize (override).
pub func html_browsing_context_group_finalize_impl(base: gc.Cell*):
    let this = (HtmlBrowsingContextGroup*)base
    gc.cell_finalize_impl(base)
    with memory.heap:
        _ = ak.hash_table_remove_t(html_user_agent_browsing_context_group_set(), this)

## Ported from BrowsingContextGroup.cpp:35 Web::HTML::BrowsingContextGroup::visit_edges (override).
pub func html_browsing_context_group_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlBrowsingContextGroup*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_page)
    gc.cell_visitor_visit_opaque_2(visitor, &this.m_browsing_context_set)

## `Bindings::main_thread_vm().heap().allocate<BrowsingContextGroup>(page)`: a BrowsingContextGroup
## cell constructed under DeferGC.
func heap_allocate_html_browsing_context_group(heap: gc.Heap*, page: Page*) -> HtmlBrowsingContextGroup*:
    let group = (HtmlBrowsingContextGroup*)web_heap_allocate_cell(heap, &html_browsing_context_group_class)
    gc.heap_defer_gc(heap)
    html_browsing_context_group_construct(group, page)
    gc.heap_undefer_gc(heap)
    return group

## Ported from BrowsingContextGroup.cpp:43 Web::HTML::BrowsingContextGroup::create_a_new_browsing_context_group_and_document.
# https://html.spec.whatwg.org/multipage/document-sequences.html#creating-a-new-browsing-context-group-and-document
pub func html_browsing_context_group_create_a_new_browsing_context_group_and_document(page: Page*) -> HtmlBrowsingContextGroupBrowsingContextGroupAndDocument:
    # 1. Let group be a new browsing context group.
    # 2. Append group to the user agent's browsing context group set.
    let group = heap_allocate_html_browsing_context_group(vm_heap(bind_main_thread_vm()), page)

    # 3. Let browsingContext and document be the result of creating a new browsing context and document with null, null, and group.
    let created = html_browsing_context_create_a_new_browsing_context_and_document(page, none, none, group)

    # 4. Append browsingContext to group.
    html_browsing_context_group_append(group, created.browsing_context)

    # 5. Return group and document.
    return HtmlBrowsingContextGroupBrowsingContextGroupAndDocument(browsing_context = group, document = created.document)

## Ported from BrowsingContextGroup.cpp:60 Web::HTML::BrowsingContextGroup::append.
# https://html.spec.whatwg.org/multipage/browsers.html#bcg-append
pub func html_browsing_context_group_append(this: HtmlBrowsingContextGroup*, browsing_context: HtmlBrowsingContext*):
    # 1. Append browsingContext to group's browsing context set.
    _ = ak.ordered_hash_table_set(&this.m_browsing_context_set, browsing_context)

    # 2. Set browsingContext's group to group.
    html_browsing_context_set_group(browsing_context, this)

