## Ported from TextTrack.h:53 Web::HTML::TextTrack::readiness_state.
pub func html_text_track_readiness_state(this: HtmlTextTrack*) -> HtmlTextTrackReadinessState:
    return this.m_readiness_state

## Ported from TextTrack.cpp:108 Web::HTML::TextTrack::set_readiness_state.
pub func html_text_track_set_readiness_state(this: HtmlTextTrack*, readiness_state: HtmlTextTrackReadinessState):
    this.m_readiness_state = readiness_state

    var observers = ak.vector_clone(&this.m_observers)
    for observer in ak.vector_span(&observers):
        if let callback = html_text_track_observer_track_readiness_observer(observer):
            ak.function1_call(&callback.function, this.m_readiness_state)

## Ported from TextTrack.cpp:118 Web::HTML::TextTrack::register_observer.
func html_text_track_register_observer(this: HtmlTextTrack*, observer: HtmlTextTrackObserver*):
    for registered in ak.vector_span(&this.m_observers):
        assert(registered != observer, "VERIFY: result == AK::HashSetResult::InsertedNewEntry")
    ak.vector_append_t(&this.m_observers, observer)

## Ported from TextTrack.cpp:124 Web::HTML::TextTrack::unregister_observer.
func html_text_track_unregister_observer(this: HtmlTextTrack*, observer: HtmlTextTrackObserver*):
    let observers = ak.vector_span(&this.m_observers)
    for index in 0..<observers.length:
        if observers[index] == observer:
            ak.vector_remove(&this.m_observers, index)
            return
    trap("VERIFY: was_removed")

## Ported from TextTrack.cpp:130 Web::HTML::text_track_kind_from_string.
pub func html_text_track_kind_from_string(value: ak.String) -> BindTextTrackKind:
    # https://html.spec.whatwg.org/multipage/media.html#attr-track-kind

    if ak.string_is_empty(&value) or ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("subtitles")):
        return BindTextTrackKind.subtitles
    if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("captions")):
        return BindTextTrackKind.captions
    if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("descriptions")):
        return BindTextTrackKind.descriptions
    if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("chapters")):
        return BindTextTrackKind.chapters
    if ak.string_equals_ignoring_ascii_case_string_view(&value, ak.sv("metadata")):
        return BindTextTrackKind.metadata

    return BindTextTrackKind.metadata

# mark: TextTrackObserver =======================================================================

## Ported from TextTrackObserver.cpp:15 Web::HTML::TextTrackObserver::TextTrackObserver.
pub func html_text_track_observer_construct(this: HtmlTextTrackObserver*, realm: Realm*, text_track: HtmlTextTrack*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_text_track = text_track
    html_text_track_register_observer(this.m_text_track, this)

## TextTrackObserver::initialize: a non-IDL platform object keeps PlatformObject's.
pub func html_text_track_observer_initialize_impl(base: JsCell*, realm: Realm*):
    # Base::initialize(realm): PlatformObject inherits JS::Object's.
    js_cell_initialize_impl(base, realm)

## Ported from TextTrackObserver.cpp:22 Web::HTML::TextTrackObserver::visit_edges (override).
pub func html_text_track_observer_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlTextTrackObserver*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_text_track)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_track_readiness_observer)

## Ported from TextTrackObserver.cpp:29 Web::HTML::TextTrackObserver::finalize (override).
pub func html_text_track_observer_finalize_impl(base: gc.Cell*):
    let this = (HtmlTextTrackObserver*)base
    gc.cell_finalize_impl(base)
    html_text_track_unregister_observer(this.m_text_track, this)

## Ported from TextTrackObserver.h:24 Web::HTML::TextTrackObserver::track_readiness_observer.
pub func html_text_track_observer_track_readiness_observer(this: HtmlTextTrackObserver*) -> gc.Function1[HtmlTextTrackReadinessState, unit]*?:
    return this.m_track_readiness_observer

## Ported from TextTrackObserver.cpp:35 Web::HTML::TextTrackObserver::set_track_readiness_observer
## (none: the empty Function `{}`).
pub func html_text_track_observer_set_track_readiness_observer(this: HtmlTextTrackObserver*, callback: ak.Function1[HtmlTextTrackReadinessState, unit]?):
    if let function = callback:
        this.m_track_readiness_observer = gc.create_function1(vm_heap(js_cell_vm(this.js_cell())), function)
    else:
        this.m_track_readiness_observer = none
