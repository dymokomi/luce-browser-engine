#==============================================================================================
#
#   text_track - HTML::TextTrack and its observers
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/TextTrack.cpp (lines 1-153) with the inline
#       readiness_state of TextTrack.h, and TextTrackObserver.cpp (lines 1-43): a <track>
#       element's text track (its kind, label, language, id, mode and readiness state) and the
#       observers HTMLTrackElement uses to hear of readiness changes.
#
#       The observers are a HashTable<GC::Ref<TextTrackObserver>> in C++, iterated in hash
#       (pointer) order; here they are a list in insertion order. A track has at most its
#       element's observer, so the order does not show.
#
#       Copyright (c) 2024, Jamie Mansfield <jmansfield@cadixdev.org>
#       Copyright (c) 2025, Tim Flynn <trflynn89@ladybird.org>
#       Copyright (c) 2026 the luce-browser authors.
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: TextTrack ===============================================================================

## Ported from TextTrack.cpp:17 Web::HTML::TextTrack::create.
pub func html_text_track_create(realm: Realm*) -> HtmlTextTrack*:
    return realm_create_html_text_track(realm, realm)

## Ported from TextTrack.cpp:22 Web::HTML::TextTrack::TextTrack.
pub func html_text_track_construct(this: HtmlTextTrack*, realm: Realm*):
    html_text_track_init_fields(this)
    dom_event_target_construct(this.dom_event_target(), realm)

## Ported from TextTrack.cpp:29 Web::HTML::TextTrack::initialize (override).
pub func html_text_track_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.text_track)
    dom_event_target_initialize_impl(base, realm)

## Ported from TextTrack.cpp:35 Web::HTML::TextTrack::visit_edges (override).
pub func html_text_track_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlTextTrack*)base
    dom_event_target_visit_edges_impl(base, visitor)
    for observer in ak.vector_span(&this.m_observers):
        gc.cell_visitor_visit_t(visitor, observer)

