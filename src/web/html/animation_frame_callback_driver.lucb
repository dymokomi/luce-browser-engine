#==============================================================================================
#
#   animation_frame_callback_driver - HTML::AnimationFrameCallbackDriver: a window's map of
#   animation frame callbacks
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/AnimationFrameCallbackDriver.cpp (lines 1-49) and
#       AnimationFrameCallbackDriver.h (lines 1-42). Callbacks are kept in insertion order
#       under increasing identifiers; run() moves the map aside first, so callbacks added while
#       it runs wait for the next frame.
#
