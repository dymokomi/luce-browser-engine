## Ported from HTMLMediaElement.h:47 Web::HTML::HTMLMediaElement::is_focusable (override).
pub func html_media_element_is_focusable_impl(base: DomEventTarget*) -> bool:
    return true

## Ported from HTMLMediaElement.h:56 Web::HTML::HTMLMediaElement::error.
pub func html_media_element_error(this: HtmlMediaElement*) -> HtmlMediaError*?:
