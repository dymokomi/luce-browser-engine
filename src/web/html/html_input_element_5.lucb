# mark: Reflected IDL attributes ================================================================

## Ported from HTMLInputElement.cpp:2312 Web::HTML::HTMLInputElement::max_length.
#  https://html.spec.whatwg.org/multipage/input.html#dom-input-maxlength
pub func html_input_element_max_length(this: HtmlInputElement*) -> i32:
    # The maxLength IDL attribute must reflect the maxlength content attribute, limited to only non-negative numbers.
    if let maxlength_string = html_input_element_get_attribute(this, html_attribute_names_maxlength):
        if let maxlength = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&maxlength_string)):
            if maxlength <= 2147483647:
                return i32(maxlength)
    return -1

## Ported from HTMLInputElement.cpp:2322 Web::HTML::HTMLInputElement::set_max_length.
pub func html_input_element_set_max_length(this: HtmlInputElement*, value: i32) -> !:
    # The maxLength IDL attribute must reflect the maxlength content attribute, limited to only non-negative numbers.
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_maxlength, try html_convert_non_negative_integer_to_string(html_input_element_realm(this), value))

## Ported from HTMLInputElement.cpp:2330 Web::HTML::HTMLInputElement::min_length.
# https://html.spec.whatwg.org/multipage/input.html#dom-input-minlength
pub func html_input_element_min_length(this: HtmlInputElement*) -> i32:
    # The minLength IDL attribute must reflect the minlength content attribute, limited to only non-negative numbers.
    if let minlength_string = html_input_element_get_attribute(this, html_attribute_names_minlength):
        if let minlength = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&minlength_string)):
            if minlength <= 2147483647:
                return i32(minlength)
    return -1

## Ported from HTMLInputElement.cpp:2340 Web::HTML::HTMLInputElement::set_min_length.
pub func html_input_element_set_min_length(this: HtmlInputElement*, value: i32) -> !:
    # The minLength IDL attribute must reflect the minlength content attribute, limited to only non-negative numbers.
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_minlength, try html_convert_non_negative_integer_to_string(html_input_element_realm(this), value))

## Ported from HTMLInputElement.cpp:2348 Web::HTML::HTMLInputElement::size.
# https://html.spec.whatwg.org/multipage/input.html#the-size-attribute
pub func html_input_element_size(this: HtmlInputElement*) -> u32:
    # The size attribute, if specified, must have a value that is a valid non-negative integer greater than zero.
    # The size IDL attribute is limited to only positive numbers and has a default value of 20.
    if let size_string = html_input_element_get_attribute(this, html_attribute_names_size):
        if let size = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&size_string)):
            if size != 0 and size <= 2147483647:
                return size
    return 20

## Ported from HTMLInputElement.cpp:2359 Web::HTML::HTMLInputElement::set_size.
pub func html_input_element_set_size(this: HtmlInputElement*, value: u32) -> !:
    if value == 0:
        try idl_throw(.idl_dom_exception(idl_index_size_error_create(html_input_element_realm(this), ak.utf16_string_from_str("Size must be greater than zero"))))
    var size = value
    if size > 2147483647:
        size = 20
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_size, ak.string_number_u64(size))

## Ported from HTMLInputElement.cpp:2370 Web::HTML::HTMLInputElement::height.
# https://html.spec.whatwg.org/multipage/input.html#dom-input-height
pub func html_input_element_height(this: HtmlInputElement*) -> u32:
    dom_document_update_layout_if_needed_for_node(html_input_element_document(this), this.dom_node(), DomUpdateLayoutReason.html_input_element_height)

    # When the input element's type attribute is not in the Image Button state, then no image is available.
    if html_input_element_type_state(this) != HtmlInputElementTypeAttributeState.image_button:
        return 0

    # Return the rendered height of the image, in CSS pixels, if the image is being rendered.
    if let paintable_box = dom_node_paintable_box(this.dom_node()):
        return (u32)paint_paintable_box_content_height(paintable_box).to_int()

    # On setting [the width or height IDL attribute], they must act as if they reflected the respective content attributes of the same name.
    if let height_string = html_input_element_get_attribute(this, html_attribute_names_height):
        if let height = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&height_string)):
            if height <= 2147483647:
                return height

    # ...or else the natural height and height of the image, in CSS pixels, if an image is available but not being rendered
    if let bitmap = layout_image_provider_current_image_bitmap(&this.image_provider):
        return (u32)gfx.immutable_bitmap_height(bitmap)

    # ...or else 0, if the image is not available or does not have intrinsic dimensions.
    return 0

## Ported from HTMLInputElement.cpp:2396 Web::HTML::HTMLInputElement::set_height.
pub func html_input_element_set_height(this: HtmlInputElement*, value: u32):
    var height = value
    if height > 2147483647:
        height = 0

    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_height, ak.string_number_u64(height))

## Ported from HTMLInputElement.cpp:2405 Web::HTML::HTMLInputElement::width.
# https://html.spec.whatwg.org/multipage/input.html#dom-input-width
pub func html_input_element_width(this: HtmlInputElement*) -> u32:
    dom_document_update_layout_if_needed_for_node(html_input_element_document(this), this.dom_node(), DomUpdateLayoutReason.html_input_element_width)

    # When the input element's type attribute is not in the Image Button state, then no image is available.
    if html_input_element_type_state(this) != HtmlInputElementTypeAttributeState.image_button:
        return 0

    # Return the rendered width of the image, in CSS pixels, if the image is being rendered.
    if let paintable_box = dom_node_paintable_box(this.dom_node()):
        return (u32)paint_paintable_box_content_width(paintable_box).to_int()

    # On setting [the width or height IDL attribute], they must act as if they reflected the respective content attributes of the same name.
    if let width_string = html_input_element_get_attribute(this, html_attribute_names_width):
        if let width = html_parse_non_negative_integer(ak.string_bytes_as_string_view(&width_string)):
            if width <= 2147483647:
                return width

    # ...or else the natural width and height of the image, in CSS pixels, if an image is available but not being rendered
    if let bitmap = layout_image_provider_current_image_bitmap(&this.image_provider):
        return (u32)gfx.immutable_bitmap_width(bitmap)

    # ...or else 0, if the image is not available or does not have intrinsic dimensions.
    return 0

## Ported from HTMLInputElement.cpp:2431 Web::HTML::HTMLInputElement::set_width.
pub func html_input_element_set_width(this: HtmlInputElement*, value: u32):
    var width = value
    if width > 2147483647:
        width = 0

    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_width, ak.string_number_u64(width))
