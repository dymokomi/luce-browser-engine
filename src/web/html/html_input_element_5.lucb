#==============================================================================================
#
#   html_input_element_5 - HTML::HTMLInputElement: hints, cloning, radio groups, dimensions
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLInputElement.cpp (lines 2058-2437): the presentational hints
#       of image buttons, the cloning steps, radio button groups, the legacy-pre-activation
#       and legacy-canceled-activation behaviors, the Layout::ImageProvider overrides, the
#       default tab index, and the maxLength, minLength, size, height and width IDL attributes.
#
#==============================================================================================

# mark: Presentational hints ====================================================================

## Ported from HTMLInputElement.cpp:2058 Web::HTML::HTMLInputElement::is_presentational_hint (override).
pub func html_input_element_is_presentational_hint_impl(base: DomElement*, name: ak.FlyString) -> bool:
    let this = (HtmlInputElement*)base
    if dom_element_is_presentational_hint_impl(base, name):
        return true

    if html_input_element_type_state(this) != HtmlInputElementTypeAttributeState.image_button:
        return false

    return html_name_is_one_of(name, [html_attribute_names_align, html_attribute_names_border, html_attribute_names_height, html_attribute_names_hspace, html_attribute_names_vspace, html_attribute_names_width])

## Ported from HTMLInputElement.cpp:2075 Web::HTML::HTMLInputElement::apply_presentational_hints (override).
pub func html_input_element_apply_presentational_hints_impl(base: DomElement*, properties: ak.Vector[CssStyleProperty]*):
    let this = (HtmlInputElement*)base
    dom_element_apply_presentational_hints_impl(base, properties)

    if html_input_element_type_state(this) != HtmlInputElementTypeAttributeState.image_button:
        return

    for attribute in dom_element_attribute_span(base):
        let name = dom_attr_name(attribute)
        let value_string = dom_attr_value(attribute)
        let value = ak.string_bytes_as_string_view(&value_string)
        if ak.fly_string_eq_fly_string(&name, &html_attribute_names_align):
            if ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("center")):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.text_align, value = css_keyword_style_value_create(css_data.Keyword.center).css_style_value()))
            elif ak.string_view_equals_ignoring_ascii_case(&value, ak.sv("middle")):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.text_align, value = css_keyword_style_value_create(css_data.Keyword.middle).css_style_value()))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_border):
            if let parsed_value = html_parse_non_negative_integer(value):
                let width_style_value = css_length_style_value_create(css_length_make_px_f64(f64(parsed_value))).css_style_value()
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_top_width, value = width_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_right_width, value = width_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_bottom_width, value = width_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_left_width, value = width_style_value))

                let border_style_value = css_keyword_style_value_create(css_data.Keyword.solid).css_style_value()
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_top_style, value = border_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_right_style, value = border_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_bottom_style, value = border_style_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.border_left_style, value = border_style_value))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_height):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.height, value = parsed_value))
        # https://html.spec.whatwg.org/multipage/rendering.html#attributes-for-embedded-content-and-images:maps-to-the-dimension-property
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_hspace):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_left, value = parsed_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_right, value = parsed_value))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_vspace):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_top, value = parsed_value))
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.margin_bottom, value = parsed_value))
        elif ak.fly_string_eq_fly_string(&name, &html_attribute_names_width):
            if let parsed_value = html_parse_dimension_value(value):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.width, value = parsed_value))

# mark: Cloning and radio button groups =========================================================

## Ported from HTMLInputElement.cpp:2127 Web::HTML::HTMLInputElement::cloned (override).
# https://html.spec.whatwg.org/multipage/input.html#the-input-element%3Aconcept-node-clone-ext
pub func html_input_element_cloned_impl(base: DomNode*, copy: DomNode*, subtree: bool) -> !:
    let this = (HtmlInputElement*)base
    try html_element_cloned_impl(base, copy, subtree)

    # The cloning steps for input elements given node, copy, and subtree are to propagate the value, dirty value flag, checkedness, and dirty checkedness flag from node to copy.
    let input_clone = as_html_input_element(copy)
    input_clone.m_value = this.m_value
    input_clone.m_dirty_value = this.m_dirty_value
    input_clone.m_checked = this.m_checked
    input_clone.m_dirty_checkedness = this.m_dirty_checkedness

    # AD-HOC: The spec doesn't mention propagating this state, but there is a WPT test that expects cloned nodes to preserve it.
    input_clone.m_indeterminate = this.m_indeterminate

## `non_empty_equals` of is_in_same_radio_button_group: `!value_a.is_empty() && value_a == value_b`.
func html_non_empty_equals(value_a: ak.FlyString, value_b: ak.FlyString) -> bool:
    return not ak.fly_string_is_empty(&value_a) and ak.fly_string_eq_fly_string(&value_a, &value_b)

## Ported from HTMLInputElement.cpp:2145 Web::HTML::is_in_same_radio_button_group.
# https://html.spec.whatwg.org/multipage/input.html#radio-button-group
func html_is_in_same_radio_button_group(a: HtmlInputElement*, b: HtmlInputElement*) -> bool:
    # The radio button group that contains an input element a also contains all the
    # other input elements b that fulfill all of the following conditions:
    # - Both a and b are in the same tree.
    if tree_node_root(a.dom_node()) != tree_node_root(b.dom_node()):
        return false
    # - The input element b's type attribute is in the Radio Button state.
    if html_input_element_type_state(a) != html_input_element_type_state(b) or html_input_element_type_state(b) != HtmlInputElementTypeAttributeState.radio_button:
        return false
    # - Either a and b have the same form owner, or they both have no form owner.
    if html_input_element_form(a) != html_input_element_form(b):
        return false
    # - They both have a name attribute, their name attributes are not empty, and the
    # value of a's name attribute equals the value of b's name attribute.
    let a_name = dom_element_name(a.dom_element()) else return false
    let b_name = dom_element_name(b.dom_element()) else return false
    return html_non_empty_equals(a_name, b_name)

## Ported from HTMLInputElement.cpp:2168 Web::HTML::HTMLInputElement::set_checked_within_group.
# https://html.spec.whatwg.org/multipage/input.html#radio-button-state-(type=radio)
func html_input_element_set_checked_within_group(this: HtmlInputElement*):
    if html_input_element_checked(this):
        return

    html_input_element_set_checked(this, true)

    # No point iterating the tree if we have an empty name.
    let name = dom_element_name(this.dom_element()) else return
    if ak.fly_string_is_empty(&name):
        return

    html_input_element_uncheck_others_in_radio_button_group(this)

# mark: Legacy activation behavior ==============================================================

## Ported from HTMLInputElement.cpp:2187 Web::HTML::HTMLInputElement::legacy_pre_activation_behavior (override).
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:legacy-pre-activation-behavior
pub func html_input_element_legacy_pre_activation_behavior_impl(base: DomEventTarget*):
    let this = (HtmlInputElement*)base
    this.m_before_legacy_pre_activation_behavior_checked = html_input_element_checked(this)
    this.m_before_legacy_pre_activation_behavior_indeterminate = html_input_element_indeterminate(this)

    # 1. If this element's type attribute is in the Checkbox state, then set
    # this element's checkedness to its opposite value (i.e. true if it is
    # false, false if it is true) and set this element's indeterminate IDL
    # attribute to false.
    if html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.checkbox:
        html_input_element_set_checked(this, not html_input_element_checked(this))
        html_input_element_set_indeterminate(this, false)

    # 2. If this element's type attribute is in the Radio Button state, then
    # get a reference to the element in this element's radio button group that
    # has its checkedness set to true, if any, and then set this element's
    # checkedness to true.
    if html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.radio_button:
        for node in dom_node_inclusive_subtree(tree_node_root(this.dom_node())):
            let element = as_if_html_input_element(node) else continue
            if html_input_element_checked(element) and html_is_in_same_radio_button_group(this, element):
                this.m_legacy_pre_activation_behavior_checked_element_in_group = element
                break

        html_input_element_set_checked_within_group(this)

## Ported from HTMLInputElement.cpp:2219 Web::HTML::HTMLInputElement::legacy_cancelled_activation_behavior (override).
# https://html.spec.whatwg.org/multipage/input.html#the-input-element:legacy-canceled-activation-behavior
pub func html_input_element_legacy_cancelled_activation_behavior_impl(base: DomEventTarget*):
    let this = (HtmlInputElement*)base
    # 1. If the element's type attribute is in the Checkbox state, then set the
    # element's checkedness and the element's indeterminate IDL attribute back
    # to the values they had before the legacy-pre-activation behavior was run.
    if html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.checkbox:
        html_input_element_set_checked(this, this.m_before_legacy_pre_activation_behavior_checked)
        html_input_element_set_indeterminate(this, this.m_before_legacy_pre_activation_behavior_indeterminate)

    # 2. If this element's type attribute is in the Radio Button state, then
    # if the element to which a reference was obtained in the
    # legacy-pre-activation behavior, if any, is still in what is now this
    # element' s radio button group, if it still has one, and if so, set
    # that element 's checkedness to true; or else, if there was no such
    # element, or that element is no longer in this element' s radio button
    # group, or if this element no longer has a radio button group, set
    # this element's checkedness to false.
    if html_input_element_type_state(this) == HtmlInputElementTypeAttributeState.radio_button:
        var did_reselect_previous_element = false
        if let element_in_group = this.m_legacy_pre_activation_behavior_checked_element_in_group:
            if html_is_in_same_radio_button_group(this, element_in_group):
                html_input_element_set_checked_within_group(element_in_group)
                did_reselect_previous_element = true

            this.m_legacy_pre_activation_behavior_checked_element_in_group = none

        if not did_reselect_previous_element:
            html_input_element_set_checked(this, false)

## Ported from HTMLInputElement.cpp:2254 Web::HTML::HTMLInputElement::legacy_cancelled_activation_behavior_was_not_called (override).
pub func html_input_element_legacy_cancelled_activation_behavior_was_not_called_impl(base: DomEventTarget*):
    let this = (HtmlInputElement*)base
    this.m_legacy_pre_activation_behavior_checked_element_in_group = none

