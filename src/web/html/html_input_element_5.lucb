## Ported from HTMLInputElement.cpp:2259 Web::HTML::HTMLInputElement::image_data.
func html_input_element_image_data(this: HtmlInputElement*) -> HtmlDecodedImageData*?:
    if let resource_request = this.m_resource_request:
        return html_shared_resource_request_image_data(resource_request)
    return none

## Ported from HTMLInputElement.cpp:2266 Web::HTML::HTMLInputElement::is_image_available (override).
pub func html_input_element_is_image_available_impl(base: LayoutImageProvider*) -> bool:
    return html_input_element_image_data(html_input_element_from_image_provider(base)) != none

