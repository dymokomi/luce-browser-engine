## Ported from NavigationCurrentEntryChangeEvent.cpp:18 Web::HTML::NavigationCurrentEntryChangeEvent::construct_impl.
pub func html_navigation_current_entry_change_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: const HtmlNavigationCurrentEntryChangeEventInit*) -> HtmlNavigationCurrentEntryChangeEvent*:
    return realm_create_html_navigation_current_entry_change_event(realm, realm, event_name, event_init)

## Ported from NavigationCurrentEntryChangeEvent.cpp:23 Web::HTML::NavigationCurrentEntryChangeEvent::NavigationCurrentEntryChangeEvent.
pub func html_navigation_current_entry_change_event_construct(this: HtmlNavigationCurrentEntryChangeEvent*, realm: Realm*, event_name: ak.FlyString, event_init: const HtmlNavigationCurrentEntryChangeEventInit*):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_navigation_type = event_init.navigation_type
    this.m_from = event_init.from_ else trap("VERIFY: event_init.from")

## Ported from NavigationCurrentEntryChangeEvent.cpp:32 Web::HTML::NavigationCurrentEntryChangeEvent::initialize (override).
pub func html_navigation_current_entry_change_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.navigation_current_entry_change_event)
    dom_event_initialize_impl(base, realm)

## Ported from NavigationCurrentEntryChangeEvent.cpp:38 Web::HTML::NavigationCurrentEntryChangeEvent::visit_edges (override).
pub func html_navigation_current_entry_change_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlNavigationCurrentEntryChangeEvent*)base
    dom_event_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_from)

## Ported from NavigationCurrentEntryChangeEvent.h:28 Web::HTML::NavigationCurrentEntryChangeEvent::navigation_type.
pub func html_navigation_current_entry_change_event_navigation_type(this: HtmlNavigationCurrentEntryChangeEvent*) -> BindNavigationType?:
    return this.m_navigation_type

## Ported from NavigationCurrentEntryChangeEvent.h:29 Web::HTML::NavigationCurrentEntryChangeEvent::from.
pub func html_navigation_current_entry_change_event_from(this: HtmlNavigationCurrentEntryChangeEvent*) -> HtmlNavigationHistoryEntry*:
    return this.m_from
