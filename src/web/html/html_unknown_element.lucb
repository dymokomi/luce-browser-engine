#==============================================================================================
#
#   html_unknown_element - HTML::HTMLUnknownElement: the element interface of unknown HTML names
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLUnknownElement.cpp (lines 1-28): the constructor (which moves
#       the mixin tables to HTMLUnknownElement's, as C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLUnknownElement.cpp:15 Web::HTML::HTMLUnknownElement::HTMLUnknownElement.
pub func html_unknown_element_construct(this: HtmlUnknownElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLUnknownElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_unknown_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_unknown_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_unknown_element_animatable_vtable
    element.global_event_handlers.vtable = &html_unknown_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_unknown_element_form_associated_element_vtable

## Ported from HTMLUnknownElement.cpp:22 Web::HTML::HTMLUnknownElement::initialize (override).
pub func html_unknown_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_unknown_element)
    html_element_initialize_impl(base, realm)
