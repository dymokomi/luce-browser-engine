# mark: Session history entries for the navigation API ==========================================

## Ported from TraversableNavigable.cpp:1393 Web::HTML::TraversableNavigable::get_session_history_entries_for_the_navigation_api.
func html_traversable_navigable_get_session_history_entries_for_the_navigation_api(this: HtmlTraversableNavigable*, navigable: HtmlNavigable*, target_step: i32) -> ak.Vector[HtmlSessionHistoryEntry*]:
    # 1. Let rawEntries be the result of getting session history entries for navigable.
    let raw_entries = ak.vector_clone(html_navigable_get_session_history_entries(navigable))

    if ak.vector_is_empty(&raw_entries):
        return ak.Vector[HtmlSessionHistoryEntry*]()

    # 2. Let entriesForNavigationAPI be a new empty list.
    var entries_for_navigation_api = ak.Vector[HtmlSessionHistoryEntry*]()

    # 3. Let startingIndex be the index of the session history entry in rawEntries who has the greatest step less than or equal to targetStep.
    # FIXME: Use min/max_element algorithm or some such here
    var starting_index: i32 = 0
    let max_step: i32 = 0
    for i in 0..<ak.vector_size(&raw_entries):
        let entry = *ak.vector_at_const(&raw_entries, i)
        match html_session_history_entry_step(entry):
            .i32_(step):
                if step <= target_step and step > max_step:
                    starting_index = (i32)i
            _:
                discard(0)

    # 4. Append rawEntries[startingIndex] to entriesForNavigationAPI.
    ak.vector_append_t(&entries_for_navigation_api, *ak.vector_at_const(&raw_entries, usize(starting_index)))

    # 5. Let startingOrigin be rawEntries[startingIndex]'s document state's origin.
    let starting_origin = html_document_state_origin(html_session_history_entry_document_state(*ak.vector_at_const(&raw_entries, usize(starting_index))) else trap("no document state"))

    # 6. Let i be startingIndex − 1.
    var i = starting_index - 1

    # 7. While i > 0:
    while i > 0:
        let entry = *ak.vector_at_const(&raw_entries, usize(i))
        # 1. If rawEntries[i]'s document state's origin is not same origin with startingOrigin, then break.
        let entry_origin = html_document_state_origin(html_session_history_entry_document_state(entry) else trap("no document state"))
        if html_origins_both_present_and_not_same_origin(entry_origin, starting_origin):
            break

        # 2. Prepend rawEntries[i] to entriesForNavigationAPI.
        ak.vector_prepend_u(&entries_for_navigation_api, entry)

        # 3. Set i to i − 1.
        i -= 1

    # 8. Set i to startingIndex + 1.
    i = starting_index + 1

    # 9. While i < rawEntries's size:
    while i < (i32)ak.vector_size(&raw_entries):
        let entry = *ak.vector_at_const(&raw_entries, usize(i))
        # 1. If rawEntries[i]'s document state's origin is not same origin with startingOrigin, then break.
        let entry_origin = html_document_state_origin(html_session_history_entry_document_state(entry) else trap("no document state"))
        if html_origins_both_present_and_not_same_origin(entry_origin, starting_origin):
            break

        # 2. Append rawEntries[i] to entriesForNavigationAPI.
        ak.vector_append_t(&entries_for_navigation_api, entry)

        # 3. Set i to i + 1.
        i += 1

    # 10. Return entriesForNavigationAPI.
    return entries_for_navigation_api

## `starting_origin.has_value() && entry_origin.has_value() && !entry_origin->is_same_origin(*starting_origin)`.
func html_origins_both_present_and_not_same_origin(entry_origin: web_url.Origin?, starting_origin: web_url.Origin?) -> bool:
    let entry = entry_origin else return false
    let starting = starting_origin else return false
    return not web_url.origin_is_same_origin(&entry, starting)

# mark: The forward session history =============================================================

## Ported from TraversableNavigable.cpp:1465 Web::HTML::TraversableNavigable::clear_the_forward_session_history.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#clear-the-forward-session-history
pub func html_traversable_navigable_clear_the_forward_session_history(this: HtmlTraversableNavigable*):
    # FIXME: 1. Assert: this is running within navigable's session history traversal queue.

    # 2. Let step be the navigable's current session history step.
    let step = html_traversable_navigable_current_session_history_step(this)

    # 3. Let entryLists be the ordered set « navigable's session history entries ».
    var entry_lists = ak.Vector[ak.Vector[HtmlSessionHistoryEntry*]*]()
    ak.vector_append_t(&entry_lists, html_traversable_navigable_session_history_entries(this))

    # 4. For each entryList of entryLists:
    while not ak.vector_is_empty(&entry_lists):
        let entry_list = ak.vector_take_first(&entry_lists)

        # 1. Remove every session history entry from entryList that has a step greater than step.
        var kept = ak.Vector[HtmlSessionHistoryEntry*]()
        for entry in ak.vector_span(entry_list):
            if html_traversable_entry_step(entry) <= step:
                ak.vector_append_t(&kept, entry)
        ak.vector_clear(entry_list)
        ak.vector_extend(entry_list, &kept)

        # 2. For each entry of entryList:
        for entry in ak.vector_span(entry_list):
            # 1. For each nestedHistory of entry's document state's nested histories, append nestedHistory's entries list to entryLists.
            for nested_history in &ak.vector_span(html_document_state_nested_histories(html_session_history_entry_document_state(entry) else trap("no document state"))):
                ak.vector_append_t(&entry_lists, &nested_history.entries)

## Ported from TraversableNavigable.cpp:1495 Web::HTML::TraversableNavigable::can_go_forward.
func html_traversable_navigable_can_go_forward(this: HtmlTraversableNavigable*) -> bool:
    let step = html_traversable_navigable_current_session_history_step(this)

    var entry_lists = ak.Vector[ak.Vector[HtmlSessionHistoryEntry*]]()
    ak.vector_append_t(&entry_lists, html_traversable_navigable_session_history_entries_const(this))

    while not ak.vector_is_empty(&entry_lists):
        var entry_list = ak.vector_take_first(&entry_lists)

        for entry in ak.vector_span(&entry_list):
            if html_traversable_entry_step(entry) > step:
                return true

            for nested_history in ak.vector_span(html_document_state_nested_histories(html_session_history_entry_document_state(entry) else trap("no document state"))):
                ak.vector_append_t(&entry_lists, nested_history.entries)

    return false

# mark: Traversing the history by a delta =======================================================

## The captures of traverse_the_history_by_delta's traversal steps.
struct HtmlTraversableNavigableTraverseByDelta:
    var this: HtmlTraversableNavigable*
    var delta: i32
    var source_snapshot_params: HtmlSourceSnapshotParams*?
    var initiator_to_check: HtmlNavigable*?
    var user_involvement: HtmlUserNavigationInvolvement

## traverse_the_history_by_delta's step 4: the session history traversal steps.
func html_traversable_navigable_traverse_by_delta_steps(context: void*?, signal: CorePromise[ak.Empty, ak.AkError]*):
    let captures = (HtmlTraversableNavigableTraverseByDelta*)(context else trap("no captures"))
    let this = captures.this

    # 1. Let allSteps be the result of getting all used history steps for traversable.
    var all_steps = html_traversable_navigable_get_all_used_history_steps(this)

    # 2. Let currentStepIndex be the index of traversable's current session history step within allSteps.
    let current_step_index = ak.vector_find_first_index(&all_steps, html_traversable_navigable_current_session_history_step(this)) else trap("Optional::operator*() on an empty optional")

    # 3. Let targetStepIndex be currentStepIndex plus delta
    # (C++ adds the int delta to the size_t index, wrapping as size_t.)
    let target_step_index = current_step_index +% (usize)(isize)captures.delta

    # 4. If allSteps[targetStepIndex] does not exist, then abort these steps.
    if target_step_index >= ak.vector_size(&all_steps):
        core_promise_resolve(signal, ak.Empty())
        return

    # 5. Apply the traverse history step allSteps[targetStepIndex] to traversable, given sourceSnapshotParams,
    #    initiatorToCheck, and userInvolvement.
    let resolve = new HtmlNavigableResolveSignal(signal = signal) else trap("out of memory")
    html_traversable_navigable_apply_the_traverse_history_step(this, *ak.vector_at(&all_steps, target_step_index), captures.source_snapshot_params, captures.initiator_to_check, captures.user_involvement, gc.create_function1(gc.cell_heap(this.cell()), ak.Function1[HtmlHistoryStepResult, unit](call = html_navigable_resolve_signal, context = resolve)))

## Ported from TraversableNavigable.cpp:1518 Web::HTML::TraversableNavigable::traverse_the_history_by_delta.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#traverse-the-history-by-a-delta
pub func html_traversable_navigable_traverse_the_history_by_delta(this: HtmlTraversableNavigable*, delta: i32, source_document: DomDocument*? = none):
    # 1. Let sourceSnapshotParams and initiatorToCheck be null.
    var source_snapshot_params: HtmlSourceSnapshotParams*? = none
    var initiator_to_check: HtmlNavigable*? = none

    # 2. Let userInvolvement be "browser UI".
    var user_involvement = HtmlUserNavigationInvolvement.browser_ui

    # 1. If sourceDocument is given, then:
    if let document = source_document:
        # 1. Set sourceSnapshotParams to the result of snapshotting source snapshot params given sourceDocument.
        source_snapshot_params = dom_document_snapshot_source_snapshot_params(document)

        # 2. Set initiatorToCheck to sourceDocument's node navigable.
