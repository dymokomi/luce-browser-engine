# mark: CheckUnloadingCanceledState =============================================================

## The CheckUnloadingCanceledState timeout's handler (the constructor's lambda).
func html_check_unloading_canceled_state_timed_out(context: void*?):
    let this = (HtmlCheckUnloadingCanceledState*)(context else trap("no state"))
    if not this.m_completed:
        ak.dbgln("FIXME: check_if_unloading_is_canceled timed out")
        html_check_unloading_canceled_state_finish(this, HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.continue_)

## Ported from TraversableNavigable.cpp:1168 Web::HTML::CheckUnloadingCanceledState::CheckUnloadingCanceledState, with
## the default member initializers.
pub func html_check_unloading_canceled_state_construct(this: HtmlCheckUnloadingCanceledState*, traversable: HtmlTraversableNavigable*?, user_involvement: HtmlUserNavigationInvolvement?, callback: gc.Function1[HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult, unit]*):
    this.m_final_status = HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.continue_
    this.m_unload_prompt_shown = false
    this.m_completed = false
    this.m_needs_beforeunload = false
    this.m_remaining_phase2_tasks = 0
    this.m_traversable = traversable
    this.m_user_involvement = user_involvement
    this.m_callback = callback
    let heap = gc.cell_heap(this.cell())
    this.m_timeout = platform_timer_create_single_shot(heap, html_check_unloading_canceled_state_timeout_ms, gc.create_function0(heap, ak.Function0[unit](call = html_check_unloading_canceled_state_timed_out, context = this)))
    platform_timer_start(this.m_timeout)

## `heap().allocate<CheckUnloadingCanceledState>(...)`: a state cell constructed under DeferGC.
func heap_allocate_html_check_unloading_canceled_state(heap: gc.Heap*, traversable: HtmlTraversableNavigable*?, user_involvement: HtmlUserNavigationInvolvement?, callback: gc.Function1[HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult, unit]*) -> HtmlCheckUnloadingCanceledState*:
    let state = (HtmlCheckUnloadingCanceledState*)web_heap_allocate_cell(heap, &html_check_unloading_canceled_state_class)
    gc.heap_defer_gc(heap)
    html_check_unloading_canceled_state_construct(state, traversable, user_involvement, callback)
    gc.heap_undefer_gc(heap)
    return state

## Ported from TraversableNavigable.cpp:1185 Web::HTML::CheckUnloadingCanceledState::visit_edges (override).
pub func html_check_unloading_canceled_state_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlCheckUnloadingCanceledState*)base
    gc.cell_visit_edges_impl(base, visitor)
    for doc in ak.vector_span(&this.m_phase2_documents):
        gc.cell_visitor_visit_t_2(visitor, doc)
    gc.cell_visitor_visit_t(visitor, this.m_traversable)
    gc.cell_visitor_visit_t_2(visitor, this.m_callback)
    gc.cell_visitor_visit_t_2(visitor, this.m_timeout)

## Ported from TraversableNavigable.cpp:1196 Web::HTML::CheckUnloadingCanceledState::start.
# https://html.spec.whatwg.org/multipage/browsing-the-web.html#checking-if-unloading-is-canceled
pub func html_check_unloading_canceled_state_start(this: HtmlCheckUnloadingCanceledState*, navigables_that_need_before_unload: ak.Vector[HtmlNavigable*?], target_step: i32?):
    var navigables = navigables_that_need_before_unload

    # 1. Let documentsToFireBeforeunload be the active document of each item in navigablesThatNeedBeforeUnload.
    for navigable in ak.vector_span(&navigables):
        ak.vector_append_t(&this.m_phase2_documents, html_navigable_active_document(navigable else trap("no navigable")) else trap("no active document"))

    # 2. Let unloadPromptShown be false.

    # 3. Let finalStatus be "continue".

    # 4. If traversable was given, then:
    if let traversable = this.m_traversable:
        # 1. Assert: targetStep and userInvolvementForNavigateEvent were given.
        # NOTE: This assertion is enforced by the caller.

        # 2. Let targetEntry be the result of getting the target history entry given traversable and targetStep.
        let target_entry = html_navigable_get_the_target_history_entry(traversable.html_navigable(), target_step else trap("Optional::value() on an empty optional")) else trap("no target entry")
        this.m_target_entry = target_entry

        # 3. If targetEntry is not traversable's current session history entry, and targetEntry's document state's origin is not the same as
        #    traversable's current session history entry's document state's origin, then:
        let current_entry = html_navigable_current_session_history_entry(traversable.html_navigable()) else trap("no current session history entry")
        if target_entry != current_entry and not html_optional_origin_equals(html_document_state_origin(html_session_history_entry_document_state(target_entry) else trap("no document state")), html_document_state_origin(html_session_history_entry_document_state(current_entry) else trap("no document state"))):
            # 1. Let eventsFired be false.

            # 2. Let needsBeforeunload be true if navigablesThatNeedBeforeUnload contains traversable; otherwise false.
            this.m_needs_beforeunload = false
            for navigable in ak.vector_span(&navigables):
                if navigable == traversable.html_navigable():
                    this.m_needs_beforeunload = true
                    break

            # 3. If needsBeforeunload is true, then remove traversable's active document from documentsToFireBeforeunload.
            if this.m_needs_beforeunload:
                let active_document = html_navigable_active_document(traversable.html_navigable())
                for i in 0..<ak.vector_size(&this.m_phase2_documents):
                    if (DomDocument*?)*ak.vector_at(&this.m_phase2_documents, i) == active_document:
                        ak.vector_remove(&this.m_phase2_documents, i)
                        break

            html_check_unloading_canceled_state_start_phase1(this)
            return

    html_check_unloading_canceled_state_start_phase2(this)

## start_phase1's queued task (step 4).
func html_check_unloading_canceled_state_phase1_task(context: void*?):
    let this = (HtmlCheckUnloadingCanceledState*)(context else trap("no state"))
    let traversable = this.m_traversable else trap("no traversable")

    # 1. if needsBeforeunload is true, then:
    if this.m_needs_beforeunload:
        # 1. Let (unloadPromptShownForThisDocument, unloadPromptCanceledByThisDocument) be the result of running the steps to fire beforeunload given traversable's active document and false.
        let result = dom_document_steps_to_fire_beforeunload(html_navigable_active_document(traversable.html_navigable()) else trap("no active document"), false)

        # 2. If unloadPromptShownForThisDocument is true, then set unloadPromptShown to true.
        if result.unload_prompt_shown:
            this.m_unload_prompt_shown = true

        # 3. If unloadPromptCanceledByThisDocument is true, then set finalStatus to "canceled-by-beforeunload".
        if result.unload_prompt_canceled:
            this.m_final_status = HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.canceled_by_before_unload

    # 2. If finalStatus is "canceled-by-beforeunload", then abort these steps.
    if this.m_final_status == HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.canceled_by_before_unload:
        html_check_unloading_canceled_state_finish(this, this.m_final_status)
        return

    # 3. Let navigation be traversable's active window's navigation API.
    let navigation = html_window_navigation(html_navigable_active_window(traversable.html_navigable()) else trap("VERIFY: m_traversable->active_window()"))

    # 4. Let navigateEventResult be the result of firing a traverse navigate event at navigation given targetEntry and userInvolvementForNavigateEvent.
    let target_entry = this.m_target_entry else trap("VERIFY: m_target_entry")
    let navigate_event_result = html_navigation_fire_a_traverse_navigate_event(navigation, target_entry, this.m_user_involvement else trap("Optional::operator*() on an empty optional"))

    # 5. If navigateEventResult is false, then set finalStatus to "canceled-by-navigate".
    if not navigate_event_result:
        this.m_final_status = HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.canceled_by_navigate

    # 6. Set eventsFired to true.

    html_check_unloading_canceled_state_phase1_completed(this)

## Ported from TraversableNavigable.cpp:1241 Web::HTML::CheckUnloadingCanceledState::start_phase1.
func html_check_unloading_canceled_state_start_phase1(this: HtmlCheckUnloadingCanceledState*):
    # 4. Queue a global task on the navigation and traversal task source given traversable's active window to perform the following steps:
    let traversable = this.m_traversable else trap("no traversable")
    let window = html_navigable_active_window(traversable.html_navigable()) else trap("VERIFY: m_traversable->active_window()")
    discard(html_queue_global_task(HtmlTaskSource.navigation_and_traversal, (JsObject*)window, gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_check_unloading_canceled_state_phase1_task, context = this))))

## Ported from TraversableNavigable.cpp:1284 Web::HTML::CheckUnloadingCanceledState::phase1_completed.
func html_check_unloading_canceled_state_phase1_completed(this: HtmlCheckUnloadingCanceledState*):
    # 5. Wait for eventsFired to be true.

    # 6. If finalStatus is not "continue", then return finalStatus.
    if this.m_final_status != HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.continue_:
        html_check_unloading_canceled_state_finish(this, this.m_final_status)
        return
    html_check_unloading_canceled_state_start_phase2(this)

## The captures of start_phase2's task for one document.
struct HtmlCheckUnloadingCanceledStatePhase2Task:
    var this: HtmlCheckUnloadingCanceledState*
    var document: DomDocument*

## start_phase2's task for one document (step 7).
func html_check_unloading_canceled_state_phase2_task(context: void*?):
    let captures = (HtmlCheckUnloadingCanceledStatePhase2Task*)(context else trap("no captures"))
    let this = captures.this
    let document = captures.document
    if dom_document_has_been_destroyed(document) or not dom_document_is_fully_active(document):
        html_check_unloading_canceled_state_did_complete_phase2_task(this)
        return

    # 1. Let (unloadPromptShownForThisDocument, unloadPromptCanceledByThisDocument) be the result of running the steps to fire beforeunload given document and unloadPromptShown.
    let result = dom_document_steps_to_fire_beforeunload(document, this.m_unload_prompt_shown)

    # 2. If unloadPromptShownForThisDocument is true, then set unloadPromptShown to true.
    if result.unload_prompt_shown:
        this.m_unload_prompt_shown = true

    # 3. If unloadPromptCanceledByThisDocument is true, then set finalStatus to "canceled-by-beforeunload".
    if result.unload_prompt_canceled:
        this.m_final_status = HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult.canceled_by_before_unload

    # 4. Increment completedTasks.
    html_check_unloading_canceled_state_did_complete_phase2_task(this)

## Ported from TraversableNavigable.cpp:1296 Web::HTML::CheckUnloadingCanceledState::start_phase2.
func html_check_unloading_canceled_state_start_phase2(this: HtmlCheckUnloadingCanceledState*):
    if ak.vector_is_empty(&this.m_phase2_documents):
        html_check_unloading_canceled_state_finish(this, this.m_final_status)
        return

    # 5. Let totalTasks be the size of documentsToFireBeforeunload.

    # 6. Let completedTasks be 0.
    this.m_remaining_phase2_tasks = ak.vector_size(&this.m_phase2_documents)

    # 7. For each document of documentsToFireBeforeunload, queue a global task on the navigation and traversal task source given document's relevant global object to run the steps:
    for document in ak.vector_span(&this.m_phase2_documents):
        # AD-HOC: Queue with a null document instead of using queue_global_task. Tasks associated with a document
        #         are only runnable when fully active. In the async state machine, documents can become non
        #         fully-active between queue and execution time, causing the task to be permanently stuck.
        #         A null-document task is always runnable; we check validity inside.
        let task = new HtmlCheckUnloadingCanceledStatePhase2Task(this = this, document = document) else trap("out of memory")
        discard(html_queue_a_task(HtmlTaskSource.navigation_and_traversal, none, none, gc.create_function0(gc.cell_heap(this.cell()), ak.Function0[unit](call = html_check_unloading_canceled_state_phase2_task, context = task))))

## Ported from TraversableNavigable.cpp:1337 Web::HTML::CheckUnloadingCanceledState::did_complete_phase2_task.
func html_check_unloading_canceled_state_did_complete_phase2_task(this: HtmlCheckUnloadingCanceledState*):
    assert(this.m_remaining_phase2_tasks > 0)
    this.m_remaining_phase2_tasks -= 1
    if this.m_remaining_phase2_tasks > 0:
        return

    # 8. Wait for completedTasks to be totalTasks.

    # 9. Return finalStatus.
    html_check_unloading_canceled_state_finish(this, this.m_final_status)

## Ported from TraversableNavigable.cpp:1349 Web::HTML::CheckUnloadingCanceledState::finish.
func html_check_unloading_canceled_state_finish(this: HtmlCheckUnloadingCanceledState*, final_result: HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult):
    if this.m_completed:
        return
    this.m_completed = true
    platform_timer_stop(this.m_timeout)
    ak.function1_call(&this.m_callback.function, final_result)

