    html_check_unloading_canceled_state_start(state, navigables_that_need_before_unload, target_step)

## Ported from TraversableNavigable.cpp:1388 Web::HTML::TraversableNavigable::check_if_unloading_is_canceled.
pub func html_traversable_navigable_check_if_unloading_is_canceled_function1(this: HtmlTraversableNavigable*, navigables_that_need_before_unload: ak.Vector[HtmlNavigable*?], callback: gc.Function1[HtmlTraversableNavigableCheckIfUnloadingIsCanceledResult, unit]*):
