#==============================================================================================
#
#   navigation_observer - HTML::NavigationObserver: callbacks a navigable runs when a
#   navigation completes or its ongoing navigation changes
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/NavigationObserver.cpp (lines 15-50). The accessors of
#       NavigationObserver.h (navigation_complete, ongoing_navigation_changed) are in
#       stub_closure, where region r28 ported them.
#
#       Copyright (c) 2024, Tim Flynn <trflynn89@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from Libraries/LibWeb/HTML/NavigationObserver.cpp:15 Web::HTML::NavigationObserver::NavigationObserver.
func html_navigation_observer_construct(this: HtmlNavigationObserver*, realm: Realm*, navigable: HtmlNavigable*):
    bind_platform_object_construct_realm(this.bind_platform_object(), realm)
    this.m_navigable = navigable
    html_navigable_register_navigation_observer(this.m_navigable, this)

## Ported from Libraries/LibWeb/HTML/NavigationObserver.cpp:22 Web::HTML::NavigationObserver::visit_edges (override).
pub func html_navigation_observer_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlNavigationObserver*)base
    bind_platform_object_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_navigable)
    gc.cell_visitor_visit_t(visitor, this.m_navigation_complete)
    gc.cell_visitor_visit_t(visitor, this.m_ongoing_navigation_changed)

## Ported from Libraries/LibWeb/HTML/NavigationObserver.cpp:30 Web::HTML::NavigationObserver::finalize (override).
pub func html_navigation_observer_finalize_impl(base: gc.Cell*):
    let this = (HtmlNavigationObserver*)base
    gc.cell_finalize_impl(base)
    html_navigable_unregister_navigation_observer(this.m_navigable, this)

## Ported from Libraries/LibWeb/HTML/NavigationObserver.cpp:36 Web::HTML::NavigationObserver::set_navigation_complete.
pub func html_navigation_observer_set_navigation_complete(this: HtmlNavigationObserver*, callback: ak.Function0[unit]?):
    if let function = callback:
        if ak.function0_is_set(&function):
            this.m_navigation_complete = gc.create_function0(gc.cell_heap(this.cell()), function)
            return
    this.m_navigation_complete = none

## Ported from Libraries/LibWeb/HTML/NavigationObserver.cpp:44 Web::HTML::NavigationObserver::set_ongoing_navigation_changed.
pub func html_navigation_observer_set_ongoing_navigation_changed(this: HtmlNavigationObserver*, callback: ak.Function0[unit]?):
    if let function = callback:
        if ak.function0_is_set(&function):
            this.m_ongoing_navigation_changed = gc.create_function0(gc.cell_heap(this.cell()), function)
            return
    this.m_ongoing_navigation_changed = none
