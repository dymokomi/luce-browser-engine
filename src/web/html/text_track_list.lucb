## Ported from TextTrackList.cpp:17 Web::HTML::TextTrackList::TextTrackList.
pub func html_text_track_list_construct(this: HtmlTextTrackList*, realm: Realm*):
    dom_event_target_construct(this.dom_event_target(), realm, JsObjectMayInterfereWithIndexedPropertyAccess.yes)

## Ported from TextTrackList.cpp:24 Web::HTML::TextTrackList::initialize (override).
pub func html_text_track_list_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.text_track_list)
    dom_event_target_initialize_impl(base, realm)

## Ported from TextTrackList.cpp:30 Web::HTML::TextTrackList::visit_edges (override).
pub func html_text_track_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlTextTrackList*)base
    dom_event_target_visit_edges_impl(base, visitor)
    for text_track in ak.vector_span(&this.m_text_tracks):
        gc.cell_visitor_visit_t(visitor, text_track)

## Ported from TextTrackList.cpp:37 Web::HTML::TextTrackList::internal_get_own_property (override).
# https://html.spec.whatwg.org/multipage/media.html#dom-texttracklist-item
pub func html_text_track_list_internal_get_own_property_impl(base: BindPlatformObject*, property_name: JsPropertyKey) -> (JsPropertyDescriptor?)!:
    # To determine the value of an indexed property of a TextTrackList object for a given index index, the user
    # agent must return the indexth text track in the list represented by the TextTrackList object. (JS property
    # keys and descriptors.)
    trap("unported (P3): Web::HTML::TextTrackList::internal_get_own_property")

## Ported from TextTrackList.cpp:53 Web::HTML::TextTrackList::add_track.
pub func html_text_track_list_add_track(this: HtmlTextTrackList*, text_track: HtmlTextTrack*):
    ak.vector_append_t(&this.m_text_tracks, text_track)

## Ported from TextTrackList.cpp:59 Web::HTML::TextTrackList::length.
# https://html.spec.whatwg.org/multipage/media.html#dom-texttracklist-length
pub func html_text_track_list_length(this: HtmlTextTrackList*) -> usize:
    return ak.vector_size(&this.m_text_tracks)

## Ported from TextTrackList.cpp:65 Web::HTML::TextTrackList::get_track_by_id.
# https://html.spec.whatwg.org/multipage/media.html#dom-texttracklist-gettrackbyid
pub func html_text_track_list_get_track_by_id(this: HtmlTextTrackList*, id: ak.StringView) -> HtmlTextTrack*?:
    # The getTrackById(id) method must return the first TextTrack in the TextTrackList object whose id
    # IDL attribute would return a value equal to the value of the id argument.
    for text_track in ak.vector_span(&this.m_text_tracks):
        let track_id = html_text_track_id(text_track)
        if ak.string_eq_string_view(&track_id, id):
            return text_track

    # When no tracks match the given argument, the method must return null.
    return none

## Ported from TextTrackList.cpp:81 Web::HTML::TextTrackList::set_onchange.
# https://html.spec.whatwg.org/multipage/media.html#handler-texttracklist-onchange
pub func html_text_track_list_set_onchange(this: HtmlTextTrackList*, event_handler: IdlCallbackType*?):
    dom_event_target_set_event_handler_attribute(this.dom_event_target(), html_event_names_change, event_handler)

## Ported from TextTrackList.cpp:87 Web::HTML::TextTrackList::onchange.
pub func html_text_track_list_onchange(this: HtmlTextTrackList*) -> IdlCallbackType*?:
    return dom_event_target_event_handler_attribute(this.dom_event_target(), html_event_names_change)

