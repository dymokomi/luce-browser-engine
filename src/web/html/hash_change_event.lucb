## Ported from HashChangeEvent.cpp:17 Web::HTML::HashChangeEvent::create.
pub func html_hash_change_event_create(realm: Realm*, event_name: ak.FlyString, event_init: HtmlHashChangeEventInit) -> HtmlHashChangeEvent*:
    return realm_create_html_hash_change_event(realm, realm, event_name, event_init)

## Ported from HashChangeEvent.cpp:22 Web::HTML::HashChangeEvent::construct_impl.
pub func html_hash_change_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: HtmlHashChangeEventInit) -> HtmlHashChangeEvent*:
    return realm_create_html_hash_change_event(realm, realm, event_name, event_init)

## Ported from HashChangeEvent.cpp:27 Web::HTML::HashChangeEvent::HashChangeEvent.
pub func html_hash_change_event_construct(this: HtmlHashChangeEvent*, realm: Realm*, event_name: ak.FlyString, event_init: HtmlHashChangeEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_old_url = event_init.old_url
    this.m_new_url = event_init.new_url

## Ported from HashChangeEvent.cpp:34 Web::HTML::HashChangeEvent::initialize (override).
pub func html_hash_change_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.hash_change_event)
    dom_event_initialize_impl(base, realm)

## Ported from HashChangeEvent.cpp:40 Web::HTML::HashChangeEvent::visit_edges (override).
pub func html_hash_change_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    dom_event_visit_edges_impl(base, visitor)

## Ported from HashChangeEvent.h:26 Web::HTML::HashChangeEvent::old_url.
pub func html_hash_change_event_old_url(this: HtmlHashChangeEvent*) -> ak.String:
    return this.m_old_url

## Ported from HashChangeEvent.h:27 Web::HTML::HashChangeEvent::new_url.
pub func html_hash_change_event_new_url(this: HtmlHashChangeEvent*) -> ak.String:
    return this.m_new_url
