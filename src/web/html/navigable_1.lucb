# mark: NavigationParamsFetchStateHolder ========================================================

## Ported from Navigable.cpp:72 Web::HTML::NavigationParamsFetchStateHolder::NavigationParamsFetchStateHolder,
## with the default member initializers.
pub func html_navigation_params_fetch_state_holder_construct(this: HtmlNavigationParamsFetchStateHolder*, coop_enforcement_result: HtmlOpenerPolicyEnforcementResult, current_url: web_url.Url, request: FetchRequest*, initiator_origin: web_url.Origin?, history_policy_container: HtmlSerializedPolicyContainerOrHtmlDocumentStateClient, about_base_url: web_url.Url?, source_snapshot_params: HtmlSourceSnapshotParams*, request_referrer: FetchRequestReferrerType, request_referrer_policy: ReferrerPolicyReferrerPolicy, origin: web_url.Origin?, resource: EmptyOrStringOrHtmlPostResource, ever_populated: bool, navigable_target_name: ak.String):
    this.response_coop = HtmlOpenerPolicy()
    this.coop_enforcement_result = coop_enforcement_result
    this.current_url = current_url
    this.request = request
    this.initiator_origin = initiator_origin
    this.history_policy_container = history_policy_container
    this.about_base_url = about_base_url
    this.source_snapshot_params = source_snapshot_params
    this.request_referrer = request_referrer
    this.request_referrer_policy = request_referrer_policy
    this.origin = origin
    this.resource = resource
    this.ever_populated = ever_populated
    this.navigable_target_name = navigable_target_name

## Ported from Navigable.cpp:143 Web::HTML::NavigationParamsFetchStateHolder::visit_edges (override).
pub func html_navigation_params_fetch_state_holder_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlNavigationParamsFetchStateHolder*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.response)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.fetch_controller)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.response_policy_container)
    gc.cell_visitor_visit_t(visitor, this.commit_early_hints)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.request)  # opaque in phase 1
    gc.cell_visitor_visit_t(visitor, this.navigable)
    gc.cell_visitor_visit_t_2(visitor, this.source_snapshot_params)
    gc.cell_visitor_visit_t(visitor, this.continuation_steps)

## `realm.heap().allocate<NavigationParamsFetchStateHolder>(...)`: a fetch state holder cell
## constructed under DeferGC.
func heap_allocate_html_navigation_params_fetch_state_holder(heap: gc.Heap*, coop_enforcement_result: HtmlOpenerPolicyEnforcementResult, current_url: web_url.Url, request: FetchRequest*, initiator_origin: web_url.Origin?, history_policy_container: HtmlSerializedPolicyContainerOrHtmlDocumentStateClient, about_base_url: web_url.Url?, source_snapshot_params: HtmlSourceSnapshotParams*, request_referrer: FetchRequestReferrerType, request_referrer_policy: ReferrerPolicyReferrerPolicy, origin: web_url.Origin?, resource: EmptyOrStringOrHtmlPostResource, ever_populated: bool, navigable_target_name: ak.String) -> HtmlNavigationParamsFetchStateHolder*:
    let holder = (HtmlNavigationParamsFetchStateHolder*)web_heap_allocate_cell(heap, &html_navigation_params_fetch_state_holder_class)
    gc.heap_defer_gc(heap)
    html_navigation_params_fetch_state_holder_construct(holder, coop_enforcement_result, current_url, request, initiator_origin, history_policy_container, about_base_url, source_snapshot_params, request_referrer, request_referrer_policy, origin, resource, ever_populated, navigable_target_name)
    gc.heap_undefer_gc(heap)
    return holder

# mark: InternalNavigationResult ================================================================

## `realm.heap().allocate<InternalNavigationResult>()`: a result cell with its default member
## initializers (a null navigation params).
func heap_allocate_html_internal_navigation_result(heap: gc.Heap*) -> HtmlInternalNavigationResult*:
    let result = (HtmlInternalNavigationResult*)web_heap_allocate_cell(heap, &html_internal_navigation_result_class)
    result.navigation_params = HtmlNavigableNavigationParamsVariant.optional_string(none)
    return result

## The visit of a NavigationParamsVariant's navigation params (the visitor lambdas of
## InternalNavigationResult and PopulateSessionHistoryEntryDocumentOutput).
func html_visit_navigation_params_variant(visitor: gc.CellVisitor*, navigation_params: HtmlNavigableNavigationParamsVariant):
    match navigation_params:
        .optional_string(_):
            return
        .html_navigation_params(params):
            gc.cell_visitor_visit_t_2(visitor, params)
        .html_non_fetch_scheme_navigation_params(params):
            gc.cell_visitor_visit_t_2(visitor, params)

## Ported from Navigable.cpp:175 Web::HTML::InternalNavigationResult::visit_edges (override).
pub func html_internal_navigation_result_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlInternalNavigationResult*)base
    gc.cell_visit_edges_impl(base, visitor)
    html_visit_navigation_params_variant(visitor, this.navigation_params)

