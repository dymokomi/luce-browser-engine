## default member initializers.
func heap_allocate_html_populate_session_history_entry_document_output(heap: gc.Heap*) -> HtmlPopulateSessionHistoryEntryDocumentOutput*:
    let output = (HtmlPopulateSessionHistoryEntryDocumentOutput*)web_heap_allocate_cell(heap, &html_populate_session_history_entry_document_output_class)
