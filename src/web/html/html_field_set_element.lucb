#==============================================================================================
#
#   html_field_set_element - HTML::HTMLFieldSetElement: <fieldset>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLFieldSetElement.cpp (lines 1-100) and the inline functions of
#       HTMLFieldSetElement.h: construction (which moves the mixin tables to HTMLFieldSetElement's,
#       as C++'s vptrs move), the disabled fieldset, the disabled attribute's change steps for
#       form-associated custom elements, the elements collection, the FormAssociatedElement
#       overrides and the FieldSetBox layout node.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from HTMLFieldSetElement.cpp:23 Web::HTML::HTMLFieldSetElement::HTMLFieldSetElement.
pub func html_field_set_element_construct(this: HtmlFieldSetElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLFieldSetElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_field_set_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_field_set_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_field_set_element_animatable_vtable
    element.global_event_handlers.vtable = &html_field_set_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_field_set_element_form_associated_element_vtable

## Ported from HTMLFieldSetElement.cpp:30 Web::HTML::HTMLFieldSetElement::initialize (override).
pub func html_field_set_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_field_set_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLFieldSetElement.cpp:36 Web::HTML::HTMLFieldSetElement::visit_edges (override).
pub func html_field_set_element_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlFieldSetElement*)base
    html_element_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t[DomHtmlCollection](visitor, this.m_elements)

# mark: The disabled fieldset ===================================================================

## Ported from HTMLFieldSetElement.cpp:43 Web::HTML::HTMLFieldSetElement::is_disabled.
# https://html.spec.whatwg.org/multipage/form-elements.html#concept-fieldset-disabled
pub func html_field_set_element_is_disabled(this: HtmlFieldSetElement*) -> bool:
    # A fieldset element is a disabled fieldset if it matches any of the following conditions:
    # - Its disabled attribute is specified
    if dom_element_has_attribute(this.dom_element(), html_attribute_names_disabled):
        return true

    # - It is a descendant of another fieldset element whose disabled attribute is specified, and is not a descendant of that fieldset element's first legend element child, if any.
    var fieldset_ancestor = tree_node_first_ancestor_of_type(this.dom_node(), &html_field_set_element_class)
    while let fieldset = fieldset_ancestor:
        if dom_element_has_attribute((DomElement*)fieldset, html_attribute_names_disabled):
            if let first_legend_element_child = tree_node_first_child_of_type(fieldset, &html_legend_element_class):
                if not tree_node_is_descendant_of(this.dom_node(), first_legend_element_child):
                    return true
            else:
                return true
        fieldset_ancestor = tree_node_first_ancestor_of_type(fieldset, &html_field_set_element_class)

    return false

## Ported from HTMLFieldSetElement.cpp:62 Web::HTML::HTMLFieldSetElement::attribute_changed (override).
pub func html_field_set_element_attribute_changed_impl(base: DomElement*, name: ak.FlyString, old_value: ak.String?, value: ak.String?, namespace_: ak.FlyString?):
    let this = (HtmlFieldSetElement*)base
    html_element_attribute_changed_impl(base, name, old_value, value, namespace_)

    if ak.fly_string_eq_fly_string(&name, &html_attribute_names_disabled):
        for node in dom_node_subtree(this.dom_node()):
            let element = as_if_html_element(node) else continue
            if html_element_is_form_associated_custom_element(element):
                html_form_associated_element_update_face_disabled_state(&element.form_associated_element)

## The filter of the elements collection: listed elements.
func html_field_set_element_elements_filter(context: void*?, element: DomElement*) -> bool:
    if let form_associated_element = as_if_form_associated_element(element):
        if html_form_associated_element_is_listed(form_associated_element):
            return true
    return false

## Ported from HTMLFieldSetElement.cpp:76 Web::HTML::HTMLFieldSetElement::elements.
# https://html.spec.whatwg.org/multipage/form-elements.html#dom-fieldset-elements
pub func html_field_set_element_elements(this: HtmlFieldSetElement*) -> DomHtmlCollection*?:
    # The elements IDL attribute must return an HTMLCollection rooted at the fieldset element, whose filter matches listed elements.
    if this.m_elements == none:
        this.m_elements = dom_html_collection_create(this.dom_parent_node(), DomHtmlCollectionScope.descendants, ak.Function1[DomElement*, bool](call = html_field_set_element_elements_filter, context = none), ak.Function2[DomElement*, DomElement*, bool]())
    return this.m_elements

# mark: Layout ==================================================================================

## Ported from HTMLFieldSetElement.cpp:90 Web::HTML::HTMLFieldSetElement::layout_node.
pub func html_field_set_element_layout_node(this: HtmlFieldSetElement*) -> LayoutFieldSetBox*?:
    return (LayoutFieldSetBox*?)dom_node_layout_node(this.dom_node())

## Ported from HTMLFieldSetElement.h:47 Web::HTML::HTMLFieldSetElement::layout_node.
pub func html_field_set_element_layout_node_const(this: HtmlFieldSetElement*) -> LayoutFieldSetBox*?:
    return (LayoutFieldSetBox*?)dom_node_layout_node(this.dom_node())

## Ported from HTMLFieldSetElement.cpp:95 Web::HTML::HTMLFieldSetElement::create_layout_node (override).
pub func html_field_set_element_create_layout_node_impl(base: DomElement*, style: CssComputedProperties*) -> LayoutNode*?:
    let document = dom_node_document(base.dom_node())
    # heap().allocate<Layout::FieldSetBox>(...): a layout node's initialize is JS::Cell's, which does nothing.
    return realm_create_layout_field_set_box(dom_element_realm(base), document, base, style).layout_node()

# mark: Inline functions of HTMLFieldSetElement.h ===============================================

## Ported from HTMLFieldSetElement.h:23 Web::HTML::HTMLFieldSetElement::type.
## (C++ caches the string in a function-local static; a module global is not scanned by the
## collector, so the port makes the same value each time.)
pub func html_field_set_element_type(this: HtmlFieldSetElement*) -> ak.String:
    return ak.string_from_str("fieldset")

## Ported from HTMLFieldSetElement.h:34 Web::HTML::HTMLFieldSetElement::is_form_associated_element (override).
pub func html_field_set_element_is_form_associated_element_impl(base: HtmlFormAssociatedElement*) -> bool:
