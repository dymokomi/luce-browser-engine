#==============================================================================================
#
#   window_or_worker_global_scope - what a Window needs of HTML::WindowOrWorkerGlobalScopeMixin
#   in phase 1: its lifetime (initialize, visit_edges, finalize), clearing its timers and
#   extracting an origin
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/WindowOrWorkerGlobalScope.cpp lines 71-104 (initialize,
#       visit_edges, finalize), 538-544 (clear_map_of_active_timers), 1064-1102 (what destroying
#       a document runs: forcibly_close_all_event_sources, close_all_idb_connections,
#       make_disappear_all_web_sockets; region p2r) and 1319-1329
#       (window_or_worker_global_scope_extract_an_origin), taken by region r28 for Window: the
#       rest of WindowOrWorkerGlobalScope.cpp (timers, fetch, performance, structured cloning) is
#       outside the phase-1 files. The members it visits are opaque until their phases.
#
#       Copyright (c) 2022, Andrew Kaster <akaster@serenityos.org>
#       Copyright (c) 2023, Luke Wilde <lukew@serenityos.org>
#       Copyright (c) 2023, Shannon Booth <shannon@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## Ported from WindowOrWorkerGlobalScope.cpp:71 Web::HTML::WindowOrWorkerGlobalScopeMixin::initialize.
pub func html_window_or_worker_global_scope_mixin_initialize(this: HtmlWindowOrWorkerGlobalScopeMixin*, realm: Realm*):
    # ENUMERATE_SUPPORTED_PERFORMANCE_ENTRY_TYPES: one PerformanceEntryTuple per supported entry
    # type in m_performance_entry_buffer_map. The entry classes (marks, measures, navigation and
    # resource timing) come with the performance timeline (phase 2), so the map stays empty.
    return

## Ported from WindowOrWorkerGlobalScope.cpp:85 Web::HTML::WindowOrWorkerGlobalScopeMixin::visit_edges.
pub func html_window_or_worker_global_scope_mixin_visit_edges(this: HtmlWindowOrWorkerGlobalScopeMixin*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_performance)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_supported_entry_types_array)
    for entry in ak.hash_map_begin(&this.m_timers):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)entry.value)  # opaque in phase 1
    for observer in ak.ordered_hash_table_begin(&this.m_registered_performance_observer_objects):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)*observer)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_indexed_db)  # opaque in phase 1
    for entry in ak.ordered_hash_map_begin(&this.m_performance_entry_buffer_map):
        performance_timeline_performance_entry_tuple_visit_edges(&entry.value, visitor)
    for event_source in ak.hash_table_begin(&this.m_registered_event_sources):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)*event_source)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_crypto)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_cache_storage)  # opaque in phase 1
    for timing in ak.vector_span(&this.m_resource_timing_secondary_buffer):
        gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)timing)  # opaque in phase 1
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_trusted_type_policy_factory)  # opaque in phase 1

## Ported from WindowOrWorkerGlobalScope.cpp:101 Web::HTML::WindowOrWorkerGlobalScopeMixin::finalize.
pub func html_window_or_worker_global_scope_mixin_finalize(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    html_window_or_worker_global_scope_mixin_clear_map_of_active_timers(this)

## Ported from WindowOrWorkerGlobalScope.cpp:538 Web::HTML::WindowOrWorkerGlobalScopeMixin::clear_map_of_active_timers.
pub func html_window_or_worker_global_scope_mixin_clear_map_of_active_timers(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    for entry in ak.hash_map_begin(&this.m_timers):
        html_timer_stop(entry.value)
    ak.hash_map_clear(&this.m_timers)
    ak.hash_map_clear(&this.m_timer_nesting_levels)

## Ported from WindowOrWorkerGlobalScope.cpp:1064 Web::HTML::WindowOrWorkerGlobalScopeMixin::forcibly_close_all_event_sources.
pub func html_window_or_worker_global_scope_mixin_forcibly_close_all_event_sources(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    for event_source in ak.hash_table_begin(&this.m_registered_event_sources):
        html_event_source_forcibly_close(*event_source)

## Ported from WindowOrWorkerGlobalScope.cpp:1070 Web::HTML::WindowOrWorkerGlobalScopeMixin::close_all_idb_connections.
pub func html_window_or_worker_global_scope_mixin_close_all_idb_connections(this: HtmlWindowOrWorkerGlobalScopeMixin*):
    # IndexedDB::Database::for_each_database([&](IndexedDB::Database& database) { ... }): no database exists before
    # IndexedDB (phase 4), so no connection of this global is closed.
    return

## Ported from WindowOrWorkerGlobalScope.cpp:1092 Web::HTML::WindowOrWorkerGlobalScopeMixin::make_disappear_all_web_sockets.
pub func html_window_or_worker_global_scope_mixin_make_disappear_all_web_sockets(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> HtmlWindowOrWorkerGlobalScopeMixinAffectedAnyWebSockets:
    var affected_any_web_sockets = HtmlWindowOrWorkerGlobalScopeMixinAffectedAnyWebSockets.no

    for web_socket in ak.intrusive_list_begin(&this.m_registered_web_sockets):
        web_sockets_web_socket_make_disappear(web_socket)
        affected_any_web_sockets = HtmlWindowOrWorkerGlobalScopeMixinAffectedAnyWebSockets.yes

    return affected_any_web_sockets

## Ported from WindowOrWorkerGlobalScope.cpp:1319 Web::HTML::WindowOrWorkerGlobalScopeMixin::window_or_worker_global_scope_extract_an_origin.
pub func html_window_or_worker_global_scope_mixin_window_or_worker_global_scope_extract_an_origin(this: HtmlWindowOrWorkerGlobalScopeMixin*) -> web_url.Origin?:
    let relevant_origin = html_environment_settings_object_origin(html_relevant_settings_object_js_object((JsObject*)html_window_or_worker_global_scope_mixin_this_impl_const(this)))

    # 1. If this's relevant settings object's origin is not same origin-domain with the entry settings object's origin, then return null.
    if not web_url.origin_is_same_origin_domain(&relevant_origin, html_environment_settings_object_origin(html_entry_settings_object())):
        return none

    # 2. Return this's relevant settings object's origin.
    return relevant_origin
