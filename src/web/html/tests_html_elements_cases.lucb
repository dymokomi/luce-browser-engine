#==============================================================================================
#
#   tests_html_elements_cases - HTML parser, element and presentational hint cases pinned to
#                              the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same inputs (luce-browser-tools,
#       oracles/luce-browser-engine/html_elements: cases.txt, oracle.cpp,
#       gen_luce_cases.py, build.sh). tests_html_elements runs each case through the port
#       and compares the output.
#
#==============================================================================================

## One oracle case: the mode, its arguments, and the reference build's output.
struct TestHtmlElementsCase:
    let mode: str
    let arguments: str[2]
    let expected: str

## Every oracle case, in cases.txt order (7 more, marked "!" in cases.txt, wait for other regions).
let test_html_elements_cases: TestHtmlElementsCase[231] = [
    TestHtmlElementsCase(mode = "doc", arguments = ["<!DOCTYPE html><p>Hello<b>world</b>", ""], expected = "| <!DOCTYPE html>\n| <html>\n|   <head>\n|   <body>\n|     <p>\n|       \"Hello\"\n|       <b>\n|         \"world\"\n"),
