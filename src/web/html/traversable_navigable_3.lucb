#       Port of Libraries/LibWeb/HTML/TraversableNavigable.cpp lines 831-1165
#       (ApplyHistoryStepState::process_continuations, enter_waiting_for_non_changing_jobs and
#       complete, TraversableNavigable::apply_the_history_step and
#       apply_the_history_step_after_unload_check).
