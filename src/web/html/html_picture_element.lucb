#==============================================================================================
#
#   html_picture_element - HTML::HTMLPictureElement: <picture>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLPictureElement.cpp (lines 1-28): the constructor (which moves the mixin tables
#       to HTMLPictureElement's, as C++'s vptrs move) and initialize.
#
#==============================================================================================

## Ported from HTMLPictureElement.cpp:15 Web::HTML::HTMLPictureElement::HTMLPictureElement.
pub func html_picture_element_construct(this: HtmlPictureElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLPictureElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_picture_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_picture_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_picture_element_animatable_vtable
    element.global_event_handlers.vtable = &html_picture_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_picture_element_form_associated_element_vtable

## Ported from HTMLPictureElement.cpp:22 Web::HTML::HTMLPictureElement::initialize (override).
pub func html_picture_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_picture_element)
    html_element_initialize_impl(base, realm)
