#==============================================================================================
#
#   file_filter - HTML::FileFilter: the file types a file picker accepts
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/FileFilter.cpp (lines 1-19): adding a filter once. The IPC encoders
#       and decoders (lines 21-61) belong to the IPC layer, which phase 1 does not have. Added by
#       region r24 (HTMLInputElement::parse_accept_attribute builds the filter).
#
#       Copyright (c) 2024, Tim Flynn <trflynn89@serenityos.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

## `FilterType == FilterType` (Variant's operator== with the defaulted == of MimeType and Extension).
func html_file_filter_filter_type_equals(a: const HtmlFileFilterFilterType*, b: const HtmlFileFilterFilterType*) -> bool:
    match *a:
        .file_type(a_value):
            match *b:
                .file_type(b_value): return a_value == b_value
                _: return false
        .mime_type(a_value):
            match *b:
                .mime_type(b_value): return ak.string_equals(&a_value.value, &b_value.value)
                _: return false
        .extension(a_value):
            match *b:
                .extension(b_value): return ak.string_equals(&a_value.value, &b_value.value)
                _: return false

## Ported from FileFilter.cpp:13 Web::HTML::FileFilter::add_filter.
pub func html_file_filter_add_filter(this: HtmlFileFilter*, filter: HtmlFileFilterFilterType):
    for existing in &ak.vector_span(&this.filters):
        if html_file_filter_filter_type_equals(existing, &filter):
            return
    ak.vector_append_t(&this.filters, filter)
