#==============================================================================================
#
#   html_table_col_element - HTML::HTMLTableColElement: <col> and <colgroup>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLTableColElement.cpp (lines 1-74): the constructor (which moves
#       the mixin tables to HTMLTableColElement's, as C++'s vptrs move), initialize, the span
#       attribute and the width attribute's presentational hint.
#
#==============================================================================================

## Ported from HTMLTableColElement.cpp:18 Web::HTML::HTMLTableColElement::HTMLTableColElement.
pub func html_table_col_element_construct(this: HtmlTableColElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLTableColElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_table_col_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_table_col_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_table_col_element_animatable_vtable
    element.global_event_handlers.vtable = &html_table_col_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_table_col_element_form_associated_element_vtable

## Ported from HTMLTableColElement.cpp:25 Web::HTML::HTMLTableColElement::initialize (override).
pub func html_table_col_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_table_col_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLTableColElement.cpp:32 Web::HTML::HTMLTableColElement::span.
# https://html.spec.whatwg.org/multipage/tables.html#dom-colgroup-span
pub func html_table_col_element_span(this: HtmlTableColElement*) -> u32:
    # The span IDL attribute must reflect the content attribute of the same name. It is clamped to the range [1, 1000], and its default value is 1.
    if let span_string = dom_element_get_attribute(this.dom_element(), html_attribute_names_span):
        if let span_digits = html_parse_non_negative_integer_digits(ak.string_bytes_as_string_view(&span_string)):
            let span = ak.string_view_to_number_i64(&span_digits)
            # NOTE: If span has no value at this point, the value must be larger than NumericLimits<i64>::max(), so return the maximum value of 1000.
            let value = span else return 1000
            return (u32)ak.clamp(value, 1, 1000)
    return 1

## Ported from HTMLTableColElement.cpp:47 Web::HTML::HTMLTableColElement::set_span.
pub func html_table_col_element_set_span(this: HtmlTableColElement*, value: u32):
    var span = value
    if span > 2147483647:
        span = 1
    dom_element_set_attribute_value(this.dom_element(), html_attribute_names_span, ak.string_number_u64(span))

## Ported from HTMLTableColElement.cpp:54 Web::HTML::HTMLTableColElement::is_presentational_hint (override).
pub func html_table_col_element_is_presentational_hint_impl(base: DomElement*, name: ak.FlyString) -> bool:
    if dom_element_is_presentational_hint_impl(base, name):
        return true

    return ak.fly_string_eq_fly_string(&name, &html_attribute_names_width)

## Ported from HTMLTableColElement.cpp:62 Web::HTML::HTMLTableColElement::apply_presentational_hints (override).
pub func html_table_col_element_apply_presentational_hints_impl(base: DomElement*, properties: ak.Vector[CssStyleProperty]*):
    dom_element_apply_presentational_hints_impl(base, properties)
    for attribute in dom_element_attribute_span(base):
        let name = dom_attr_name(attribute)
        let value = dom_attr_value(attribute)
        # https://html.spec.whatwg.org/multipage/rendering.html#tables-2:maps-to-the-dimension-property-2
        if ak.fly_string_eq_fly_string(&name, &html_attribute_names_width):
            if let parsed_value = html_parse_dimension_value(ak.string_bytes_as_string_view(&value)):
                ak.vector_append_t(properties, CssStyleProperty(property_id = css_data.PropertyId.width, value = parsed_value))
