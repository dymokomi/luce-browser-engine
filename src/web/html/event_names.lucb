#==============================================================================================
#
#   event_names - HTML::EventNames: the names of the HTML events
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/EventNames.cpp (lines 1-16) with EventNames.h's ENUMERATE_HTML_EVENTS.
#       C++ initializes the FlyStrings statically; here html_event_names_initialize_strings
#       interns them at run time and web_initialize_strings runs it at startup (DESIGN.md §2.6).
#
#==============================================================================================

## Whether html_event_names_initialize_strings has run.
var html_event_names_strings_initialized: bool

## Ported from Libraries/LibWeb/HTML/EventNames.cpp:11 the definitions of Web::HTML::EventNames's
## FlyStrings (`FlyString name = #name##_fly_string;` for each ENUMERATE_HTML_EVENTS entry).
pub func html_event_names_initialize_strings():
    if html_event_names_strings_initialized:
        return
    html_event_names_abort = ak.fly_string_from_str("abort")
