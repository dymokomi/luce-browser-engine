#==============================================================================================
#
#   autocomplete_element - HTML::AutocompleteElement: the autocomplete attribute and the autofill
#                          processing model
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/AutocompleteElement.cpp (lines 1-368) and AutocompleteElement.h: the
#       autofill mantle, the attribute's tokens, the autocomplete IDL attribute, determining a
#       field's category and the autofill processing model that yields the hint set, scope,
#       field name, credential type and IDL-exposed value.
#
#       AutocompleteElement is a stateful mixin (input, select, textarea; regions r24 and r25);
#       its element is reached through the virtual autocomplete_element_to_html_element. The two
#       lambdas of parse_autocomplete_attribute (the steps labeled "default" and "done") are
#       functions over the state they capture.
#
#==============================================================================================

# mark: Helpers =================================================================================

## `"text"_string`.
func html_autocomplete_string(text: str) -> ak.String:
    return ak.string_from_str(text)

## `MUST(String::formatted("{} {}", first, second))`.
func html_autocomplete_join_with_space(first: ak.String, second: ak.String) -> ak.String:
    var builder = ak.string_builder_new()
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&first))
    ak.string_builder_append_u8(&builder, ' ')
    ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&second))
    return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

## `string.is_one_of(candidates...)` (String == StringView for each candidate).
func html_autocomplete_string_is_one_of(string: const ak.String*, candidates: const str[]) -> bool:
    for candidate in candidates:
        if ak.string_eq_string_view(string, ak.sv(candidate)):
            return true
    return false

## The empty AttributeDetails (`AttributeDetails attr_details {}`).
func html_autocomplete_element_attribute_details_new() -> HtmlAutocompleteElementAttributeDetails:
    return HtmlAutocompleteElementAttributeDetails(field_name = ak.string_new(), credential_type = none, value = ak.string_new())

# mark: The autofill mantle and the attribute ===================================================

## Ported from AutocompleteElement.cpp:19 Web::HTML::AutocompleteElement::get_autofill_mantle.
# https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#autofill-expectation-mantle
# https://html.spec.whatwg.org/multipage/form-control-infrastructure.html#autofill-anchor-mantle
pub func html_autocomplete_element_get_autofill_mantle(this: HtmlAutocompleteElement*) -> HtmlAutocompleteElementAutofillMantle:
    let element = html_autocomplete_element_autocomplete_element_to_html_element_const(this)

    # On an input element whose type attribute is in the Hidden state, the autocomplete attribute wears the autofill anchor mantle.
    if is_html_input_element(element):
        let input_element = as_html_input_element(element)
        if html_input_element_type_state(input_element) == HtmlInputElementTypeAttributeState.hidden:
            return HtmlAutocompleteElementAutofillMantle.anchor

    # In all other cases, it wears the autofill expectation mantle.
    return HtmlAutocompleteElementAutofillMantle.expectation

## Ported from AutocompleteElement.cpp:34 Web::HTML::AutocompleteElement::autocomplete_tokens.
pub func html_autocomplete_element_autocomplete_tokens(this: HtmlAutocompleteElement*) -> ak.Vector[ak.String]:
    let autocomplete_value = dom_element_attribute(html_autocomplete_element_autocomplete_element_to_html_element_const(this).dom_element(), html_attribute_names_autocomplete) else ak.string_new()

    var autocomplete_tokens: ak.Vector[ak.String]
    let view = ak.string_bytes_as_string_view(&autocomplete_value)
    let predicate = ak.CharPredicateFunction(function = web_infra.is_ascii_whitespace)
    var split_tokens = ak.string_view_split_view_if(&view, &predicate)
    for token in ak.vector_span(&split_tokens):
        ak.vector_append_t(&autocomplete_tokens, ak.string_from_utf8(token) else trap("MUST: String::from_utf8"))
    return autocomplete_tokens

## Ported from AutocompleteElement.cpp:44 Web::HTML::AutocompleteElement::autocomplete.
pub func html_autocomplete_element_autocomplete(this: HtmlAutocompleteElement*) -> ak.String:
    # The autocomplete IDL attribute, on getting, must return the element's IDL-exposed autofill value.
    let details = html_autocomplete_element_parse_autocomplete_attribute(this)
    return details.value

## Ported from AutocompleteElement.cpp:51 Web::HTML::AutocompleteElement::set_autocomplete.
pub func html_autocomplete_element_set_autocomplete(this: HtmlAutocompleteElement*, value: ak.String):
    # The autocomplete IDL attribute [...] on setting, must reflect the content attribute of the same name.
    dom_element_set_attribute_value(html_autocomplete_element_autocomplete_element_to_html_element(this).dom_element(), html_attribute_names_autocomplete, value)

