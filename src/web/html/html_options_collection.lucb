#   html_options_collection - HTML::HTMLOptionsCollection: the options of a <select>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLOptionsCollection.cpp (lines 1-193): an HTMLCollection rooted at
#       a select element with an indexed property setter, its length setter, add(), remove()
