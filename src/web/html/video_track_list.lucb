## Ported from VideoTrackList.cpp:137 Web::HTML::VideoTrackList::visit_edges (override).
pub func html_video_track_list_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlVideoTrackList*)base
    dom_event_target_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_media_element)
    for video_track in ak.vector_span(&this.m_video_tracks):
        gc.cell_visitor_visit_t(visitor, video_track)
