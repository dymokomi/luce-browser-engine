## Ported from ErrorEvent.cpp:26 Web::HTML::ErrorEvent::ErrorEvent.
pub func html_error_event_construct(this: HtmlErrorEvent*, realm: Realm*, event_name: ak.FlyString, event_init: HtmlErrorEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_message = event_init.message
    this.m_filename = event_init.filename
    this.m_lineno = event_init.lineno
    this.m_colno = event_init.colno
    this.m_error = event_init.error_

