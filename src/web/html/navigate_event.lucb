## `ErrorEventInit {}`: the dictionary with its defaults (error undefined).
pub func html_error_event_init_default() -> HtmlErrorEventInit:
    return HtmlErrorEventInit(event_init = DomEventInit(), message = ak.string_new(), filename = ak.string_new(), lineno = 0, colno = 0, error_ = js_undefined())

