# mark: NavigateEvent ===========================================================================

## Ported from NavigateEvent.cpp:22 Web::HTML::NavigateEvent::create.
pub func html_navigate_event_create(realm: Realm*, event_name: ak.FlyString, event_init: HtmlNavigateEventInit) -> HtmlNavigateEvent*:
    let event = realm_create_html_navigate_event(realm, realm, event_name, event_init)
    dom_event_set_is_trusted(event.dom_event(), true)
    return event

## Ported from NavigateEvent.cpp:34 Web::HTML::NavigateEvent::NavigateEvent.
pub func html_navigate_event_construct(this: HtmlNavigateEvent*, realm: Realm*, event_name: ak.FlyString, event_init: HtmlNavigateEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_interception_state = HtmlNavigateEventInterceptionState.none_
    this.m_navigation_type = event_init.navigation_type
    this.m_destination = event_init.destination else trap("VERIFY: *event_init.destination")
    this.m_can_intercept = event_init.can_intercept
    this.m_user_initiated = event_init.user_initiated
    this.m_hash_change = event_init.hash_change
    this.m_signal = event_init.signal else trap("VERIFY: *event_init.signal")
    this.m_form_data = event_init.form_data
    this.m_download_request = event_init.download_request
    this.m_info = event_init.info else js_undefined()
    this.m_has_ua_visual_transition = event_init.has_ua_visual_transition
    this.m_source_element = event_init.source_element

## Ported from NavigateEvent.cpp:51 Web::HTML::NavigateEvent::initialize (override).
pub func html_navigate_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.navigate_event)
    dom_event_initialize_impl(base, realm)

## Ported from NavigateEvent.cpp:57 Web::HTML::NavigateEvent::visit_edges (override).
pub func html_navigate_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlNavigateEvent*)base
    dom_event_visit_edges_impl(base, visitor)
    for handler in ak.vector_span(&this.m_navigation_handler_list):
        gc.cell_visitor_visit_t(visitor, handler)
    gc.cell_visitor_visit_t(visitor, this.m_abort_controller)
    gc.cell_visitor_visit_t(visitor, this.m_destination)
    gc.cell_visitor_visit_t(visitor, this.m_signal)
    # (XHR::FormData is opaque before phase 3: a cell by its header.)
    gc.cell_visitor_visit_cell(visitor, (gc.Cell*?)this.m_form_data)
    js_visit_value(visitor, this.m_info)
    gc.cell_visitor_visit_t(visitor, this.m_source_element)

## Ported from NavigateEvent.h:79 Web::HTML::NavigateEvent::abort_controller.
pub func html_navigate_event_abort_controller(this: HtmlNavigateEvent*) -> DomAbortController*:
    return this.m_abort_controller else trap("VERIFY: *m_abort_controller")

## Ported from NavigateEvent.cpp:202 Web::HTML::NavigateEvent::process_scroll_behavior.
## https://html.spec.whatwg.org/multipage/nav-history-apis.html#process-scroll-behavior
func html_navigate_event_process_scroll_behavior(this: HtmlNavigateEvent*):
    # To process scroll behavior given a NavigateEvent event:

    # 1. Assert: event's interception state is "committed".
    assert(this.m_interception_state == HtmlNavigateEventInterceptionState.committed)

    # 2. Set event's interception state to "scrolled".
    this.m_interception_state = HtmlNavigateEventInterceptionState.scrolled

    # FIXME: 3. If event's navigationType was initialized to "traverse" or "reload", then restore scroll position data
    #           given event's relevant global object's navigable's active session history entry.
    if this.m_navigation_type == BindNavigationType.traverse or this.m_navigation_type == BindNavigationType.reload:
        ak.dbgln("FIXME: restore scroll position data after traversal or reload navigation")
    else:
        # 4. Otherwise:
        # 1. Let document be event's relevant global object's associated Document.
        let document = html_window_associated_document((HtmlWindow*)html_relevant_global_object((JsObject*)this))

        # 2. If document's indicated part is null, then scroll to the beginning of the document given document. [CSSOMVIEW]
        var indicated_part_is_null = false
        match dom_document_determine_the_indicated_part(document):
            .dom_element(element):
                indicated_part_is_null = element == none
            _:
                indicated_part_is_null = false
        if indicated_part_is_null:
            dom_document_scroll_to_the_beginning_of_the_document(document)
        else:
            # 3. Otherwise, scroll to the fragment given document.
            # FIXME: This will re-determine the indicated part. Can we avoid this extra work?
            dom_document_scroll_to_the_fragment(document)

## Ported from NavigateEvent.cpp:234 Web::HTML::NavigateEvent::potentially_process_scroll_behavior.
## https://html.spec.whatwg.org/multipage/nav-history-apis.html#potentially-process-scroll-behavior
func html_navigate_event_potentially_process_scroll_behavior(this: HtmlNavigateEvent*):
    # 1. Assert: event's interception state is "committed" or "scrolled".
    assert(this.m_interception_state == HtmlNavigateEventInterceptionState.committed or this.m_interception_state == HtmlNavigateEventInterceptionState.scrolled)

    # 2. If event's interception state is "scrolled", then return.
    if this.m_interception_state == HtmlNavigateEventInterceptionState.scrolled:
        return

    # 3. If event's scroll behavior is "manual", then return.
    # NOTE: If it was left as null, then we treat that as "after-transition", and continue onward.
    if this.m_scroll_behavior == BindNavigationScrollBehavior.manual:
        return

    # 4. Process scroll behavior given event.
    html_navigate_event_process_scroll_behavior(this)

## Ported from NavigateEvent.cpp:252 Web::HTML::NavigateEvent::potentially_reset_the_focus.
## https://html.spec.whatwg.org/multipage/nav-history-apis.html#potentially-reset-the-focus
func html_navigate_event_potentially_reset_the_focus(this: HtmlNavigateEvent*):
    # 1. Assert: event's interception state is "committed" or "scrolled".
    assert(this.m_interception_state == HtmlNavigateEventInterceptionState.committed or this.m_interception_state == HtmlNavigateEventInterceptionState.scrolled)

    # 2. Let navigation be event's relevant global object's navigation API.
    let relevant_global_object = (HtmlWindow*)html_relevant_global_object((JsObject*)this)
    let navigation = html_window_navigation(relevant_global_object)

    # 3. Let focusChanged be navigation's focus changed during ongoing navigation.
    let focus_changed = html_navigation_focus_changed_during_ongoing_navigation(navigation)

    # 4. Set navigation's focus changed during ongoing navigation to false.
    html_navigation_set_focus_changed_during_ongoing_navigation(navigation, false)

    # 5. If focusChanged is true, then return.
    if focus_changed:
        return

    # 6. If event's focus reset behavior is "manual", then return.
    # NOTE: If it was left as null, then we treat that as "after-transition", and continue onward.
    if this.m_focus_reset_behavior == BindNavigationFocusReset.manual:
        return

    # 7. Let document be event's relevant global object's associated Document.
    let document = html_window_associated_document(relevant_global_object)

    # 8. FIXME: Let focusTarget be the autofocus delegate for document.
    var focus_target: DomNode*? = none

    # 9. If focusTarget is null, then set focusTarget to document's body element.
    if focus_target == none:
        if let body = dom_document_body(document):
            focus_target = body.dom_node()

    # 10. If focusTarget is null, then set focusTarget to document's document element.
    if focus_target == none:
        if let element = dom_document_document_element(document):
            focus_target = element.dom_node()

    # FIXME: 11. Run the focusing steps for focusTarget, with document's viewport as the fallback target.
    html_run_focusing_steps(focus_target, none)

    # FIXME: 12. Move the sequential focus navigation starting point to focusTarget.

## Ported from NavigateEvent.cpp:278 Web::HTML::NavigateEvent::finish.
## https://html.spec.whatwg.org/multipage/nav-history-apis.html#navigateevent-finish
pub func html_navigate_event_finish(this: HtmlNavigateEvent*, did_fulfill: bool):
    # 1. Assert: event's interception state is not "intercepted" or "finished".
    assert(this.m_interception_state != HtmlNavigateEventInterceptionState.intercepted and this.m_interception_state != HtmlNavigateEventInterceptionState.finished)

    # 2. If event's interception state is "none", then return.
    if this.m_interception_state == HtmlNavigateEventInterceptionState.none_:
        return

    # 3. Potentially reset the focus given event.
    html_navigate_event_potentially_reset_the_focus(this)

    # 4. If didFulfill is true, then potentially process scroll behavior given event.
    if did_fulfill:
        html_navigate_event_potentially_process_scroll_behavior(this)

    # 5. Set event's interception state to "finished".
    this.m_interception_state = HtmlNavigateEventInterceptionState.finished

