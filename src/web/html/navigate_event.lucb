## Ported from ErrorInformation.cpp:14 Web::HTML::extract_error_information, for a DOMException (see
## the header); any other value is phase 3.
pub func html_extract_error_information(vm: Vm*, exception: JsValue) -> HtmlErrorInformation:
    # 1. Let attributes be an empty map keyed by IDL attributes.
    # 2. Set attributes[error] to exception.
    var attributes = HtmlErrorInformation(message = ak.string_new(), filename = ak.string_new(), error_ = exception, lineno = 0, colno = 0)

    # 3. Set attributes[message], attributes[filename], attributes[lineno], and attributes[colno] to
    #    implementation-defined values derived from exception.
    if not js_value_is_object(exception):
        trap("unported (P3): HTML::extract_error_information of a primitive value (JS::Value formatting)")
    let object = js_value_as_object(exception)
    if as_if_idl_dom_exception((gc.Cell*)object) == none:
        trap("unported (P3): HTML::extract_error_information of a JS object (get_without_side_effects, the error data's traceback)")
    # A DOMException's message is an accessor of its prototype, not an own property, so the message is
    # `String::formatted("Uncaught exception: {}", exception)`, an object formatted as "[object ClassName]".
    var builder = ak.string_builder_new()
    ak.string_builder_append(&builder, "Uncaught exception: [object DOMException]")
    attributes.message = ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

    # NB: If we got an Error object, then try and extract the information from the location the object was made.
    # (A DOMException is its own ErrorData; its traceback holds the frames of the script that made it, none before
    # phase 3, so no frame names a location.)
    _ = vm

    # 4. Return attributes.
    return attributes
