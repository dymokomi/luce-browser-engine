## Ported from Libraries/LibWeb/HTML/SupportedImageTypes.cpp:11 Web::HTML::is_supported_image_type.
pub func html_is_supported_image_type(type_: ak.StringView) -> bool:
    if ak.string_view_is_empty(&type_):
        return true
    if not ak.string_view_starts_with_string_view(&type_, ak.sv("image/"), ak.CaseSensitivity.case_insensitive):
        return false
    return (ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/avif")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/bmp")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/gif")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/vnd.microsoft.icon")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/x-icon")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/jpeg")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/jpg")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/pjpeg")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/jxl")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/png")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/apng")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/x-png")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/tiff")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/tinyvg")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/webp")) or ak.string_view_equals_ignoring_ascii_case(&type_, ak.sv("image/svg+xml")))
