#==============================================================================================
#
#   html_mod_element - HTML::HTMLModElement: <ins> and <del>
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/HTMLModElement.cpp (lines 1-40): construction (which moves the mixin
#       tables to HTMLModElement's, as C++'s vptrs move), initialize and the default ARIA role.
#
#==============================================================================================

## Ported from HTMLModElement.cpp:16 Web::HTML::HTMLModElement::HTMLModElement.
pub func html_mod_element_construct(this: HtmlModElement*, document: DomDocument*, qualified_name: DomQualifiedName):
    html_element_construct(this.html_element(), document, qualified_name)
    # The vptrs of the mixin bases move to HTMLModElement's tables.
    let element = this.html_element()
    element.element.slottable_mixin.vtable = &html_mod_element_slottable_mixin_vtable
    element.element.aria_mixin.vtable = &html_mod_element_aria_mixin_vtable
    element.element.animatable.vtable = &html_mod_element_animatable_vtable
    element.global_event_handlers.vtable = &html_mod_element_global_event_handlers_vtable
    element.form_associated_element.vtable = &html_mod_element_form_associated_element_vtable

## Ported from HTMLModElement.cpp:23 Web::HTML::HTMLModElement::initialize (override).
pub func html_mod_element_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.html_mod_element)
    html_element_initialize_impl(base, realm)

## Ported from HTMLModElement.cpp:29 Web::HTML::HTMLModElement::default_role (override).
pub func html_mod_element_default_role_impl(base: AriaMixin*) -> AriaRole?:
    let this = (HtmlElement*)dom_element_from_aria_mixin(base)
    # https://www.w3.org/TR/html-aria/#el-del
    if html_element_local_name_is(this, html_tag_names_del):
        return AriaRole.deletion
    # https://www.w3.org/TR/html-aria/#el-ins
    if html_element_local_name_is(this, html_tag_names_ins):
        return AriaRole.insertion
    trap("VERIFY_NOT_REACHED")
