#==============================================================================================
#
#   speculative_html_parser - HTML::SpeculativeHTMLParser: the look-ahead parser that issues
#                             speculative fetches
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/Parser/SpeculativeHTMLParser.cpp (lines 1-223). While a parser-blocking script loads, the
#       speculative parser tokenizes the rest of the input and fetches the scripts, style sheets,
#       preloads and images it finds. Fetching is phase 2: the steps that create and run a
#       request (create_potential_CORS_request, Fetch::Fetching::fetch) and translating a preload
#       destination are not in the phase-1 closure, so they trap "unported (P2)" in place. With
#       scripting disabled no parser-blocking script exists, so phase 1 never starts this parser.
#
#==============================================================================================

## Ported from SpeculativeHTMLParser.cpp:28 Web::HTML::SpeculativeHTMLParser::create.
pub func html_speculative_html_parser_create(realm: Realm*, document: DomDocument*, pending_input: ak.String, base_url: web_url.Url) -> HtmlSpeculativeHtmlParser*:
    return realm_create_html_speculative_html_parser(realm, document, pending_input, base_url)

## Ported from SpeculativeHTMLParser.cpp:33 Web::HTML::SpeculativeHTMLParser::SpeculativeHTMLParser.
pub func html_speculative_html_parser_construct(this: HtmlSpeculativeHtmlParser*, document: DomDocument*, pending_input: ak.String, base_url: web_url.Url):
    this.m_document = document
    this.m_input = pending_input
    html_syntax.html_tokenizer_construct_string_view(&this.m_tokenizer, ak.string_bytes_as_string_view(&this.m_input), ak.byte_string_from_str("UTF-8"))
    this.m_base_url = base_url

## Ported from SpeculativeHTMLParser.cpp:43 Web::HTML::SpeculativeHTMLParser::visit_edges (override).
pub func html_speculative_html_parser_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlSpeculativeHtmlParser*)base
    gc.cell_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_document)
    html_syntax.html_tokenizer_visit_edges(&this.m_tokenizer, visitor)

## Ported from SpeculativeHTMLParser.cpp:50 Web::HTML::SpeculativeHTMLParser::stop.
pub func html_speculative_html_parser_stop(this: HtmlSpeculativeHtmlParser*):
    # https://html.spec.whatwg.org/multipage/parsing.html#stop-the-speculative-html-parser
    # 3. Throw away any pending content in speculativeParser's input stream, and discard any future content
    #    that would have been added to it.
    html_syntax.html_tokenizer_abort(&this.m_tokenizer)

## Ported from SpeculativeHTMLParser.cpp:58 Web::HTML::SpeculativeHTMLParser::run.
pub func html_speculative_html_parser_run(this: HtmlSpeculativeHtmlParser*):
    while true:
        let token = html_syntax.html_tokenizer_next_token(&this.m_tokenizer) else break

        if html_syntax.html_token_is_start_tag(&token):
            html_speculative_html_parser_process_start_tag(this, token)
        elif html_syntax.html_token_is_end_tag(&token):
            html_speculative_html_parser_process_end_tag(this, token)
        elif html_syntax.html_token_is_end_of_file(&token):
            break

## Ported from SpeculativeHTMLParser.cpp:77 Web::HTML::(anonymous)::attributes_from_token.
func html_attributes_from_token(token: html_syntax.HtmlToken) -> ak.Vector[html_syntax.HtmlTokenAttribute]:
    var attributes: ak.Vector[html_syntax.HtmlTokenAttribute]
    if let token_attributes = html_syntax.html_token_tag_attributes_const(&token):
        for attribute in ak.vector_span_const(token_attributes):
            ak.vector_append_t(&attributes, attribute)
    return attributes

