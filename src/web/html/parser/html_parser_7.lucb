## A row of adjust_foreign_attributes' table (`struct ForeignAttributeAdjustment`).
struct HtmlParserForeignAttributeAdjustment:
    var attribute_name: str
    var prefix: str?
    var local_name: str
    var namespace_: ak.FlyString

## Ported from HTMLParser.cpp:3415 Web::HTML::HTMLParser::adjust_foreign_attributes.
# https://html.spec.whatwg.org/multipage/parsing.html#adjust-foreign-attributes
pub func html_parser_adjust_foreign_attributes(token: html_syntax.HtmlToken*):
    let adjustments: HtmlParserForeignAttributeAdjustment[11] = [
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:actuate", prefix = "xlink", local_name = "actuate", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:arcrole", prefix = "xlink", local_name = "arcrole", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:href", prefix = "xlink", local_name = "href", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:role", prefix = "xlink", local_name = "role", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:show", prefix = "xlink", local_name = "show", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:title", prefix = "xlink", local_name = "title", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xlink:type", prefix = "xlink", local_name = "type", namespace_ = namespace_x_link),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xml:lang", prefix = "xml", local_name = "lang", namespace_ = namespace_xml),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xml:space", prefix = "xml", local_name = "space", namespace_ = namespace_xml),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xmlns", prefix = none, local_name = "xmlns", namespace_ = namespace_xmlns),
        HtmlParserForeignAttributeAdjustment(attribute_name = "xmlns:xlink", prefix = "xmlns", local_name = "xlink", namespace_ = namespace_xmlns),
    ]

    for adjustment in adjustments:
        var prefix: ak.FlyString? = none
        if let prefix_text = adjustment.prefix:
            prefix = ak.fly_string_from_str(prefix_text)
        html_syntax.html_token_adjust_foreign_attribute(token, ak.fly_string_from_str(adjustment.attribute_name), prefix, ak.fly_string_from_str(adjustment.local_name), adjustment.namespace_)
