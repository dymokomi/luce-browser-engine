#==============================================================================================
#
#   list_of_active_formatting_elements - HTML::ListOfActiveFormattingElements: the formatting
#                                        elements (and markers) the tree builder reopens
#
#   DESCRIPTION:
#       Port of LibWeb/HTML/Parser/ListOfActiveFormattingElements.cpp (lines 1-143) and the
#       inline members of ListOfActiveFormattingElements.h (lines 21-39). An entry is a marker
#       when it has no element; each element entry owns a copy of the start tag token it was
#       created for (the C++ OwnPtr<HTMLToken>), allocated with `new` (DESIGN.md §3.3).
#
#==============================================================================================

# mark: ListOfActiveFormattingElements.cpp ======================================================

## Ported from ListOfActiveFormattingElements.cpp:16 Web::HTML::ListOfActiveFormattingElements::visit_edges.
pub func html_list_of_active_formatting_elements_visit_edges(this: HtmlListOfActiveFormattingElements*, visitor: gc.CellVisitor*):
    for entry in &ak.vector_span(&this.m_entries):
        gc.cell_visitor_visit_t(visitor, entry.element)

## Ported from ListOfActiveFormattingElements.cpp:22 Web::HTML::ListOfActiveFormattingElements::ensure_noahs_ark_clause.
func html_list_of_active_formatting_elements_ensure_noahs_ark_clause(this: HtmlListOfActiveFormattingElements*, element: DomElement*):
    var possible_matches: ak.Vector[HtmlListOfActiveFormattingElementsEntry*]
    var i = ak.vector_size(&this.m_entries)
    while i > 0:
        i -= 1
        let entry = ak.vector_at(&this.m_entries, i)
        if html_list_of_active_formatting_elements_entry_is_marker(entry):
            break
        let entry_element = entry.element else trap("VERIFY: not a marker")
        let entry_token = entry.token else trap("VERIFY: an element entry has its token")
        if html_parser_local_name_is(entry_element, dom_element_local_name(element)) and dom_node_optional_fly_strings_equal(dom_element_namespace_uri(entry_element), dom_element_namespace_uri(element)) and html_syntax.html_token_attribute_count(entry_token) == dom_element_attribute_list_size(element):
            ak.vector_append_t(&possible_matches, entry)

    if ak.vector_size(&possible_matches) < html_noahs_ark_capacity:
        return

    # FIXME: the attributes should be compared as they where created by the parser
    if let attributes = element.m_attributes:
        for index in 0..<dom_named_node_map_length(attributes):
            let attribute = dom_named_node_map_item(attributes, (u32)index) else trap("NamedNodeMap::item in range")
            var captures = HtmlListOfActiveFormattingElementsEnsureNoahsArkClauseMismatch(name = dom_attr_name(attribute), value = dom_attr_value(attribute))
            discard(ak.vector_remove_all_matching(&possible_matches, ak.Function1[const (HtmlListOfActiveFormattingElementsEntry*)*, bool](call = html_list_of_active_formatting_elements_ensure_noahs_ark_clause_mismatch, context = &captures)))

    if ak.vector_size(&possible_matches) < html_noahs_ark_capacity:
        return

    let last = *ak.vector_last(&possible_matches)
    html_list_of_active_formatting_elements_remove(this, last.element else trap("VERIFY: not a marker"))

## ensure_noahs_ark_clause's `remove_all_matching` lambda captures: the element attribute compared.
struct HtmlListOfActiveFormattingElementsEnsureNoahsArkClauseMismatch:
    var name: ak.FlyString
    var value: ak.String

## `[&](auto& entry) { auto attr = entry.token->attribute(name); return !attr.has_value() || attr != value; }`.
func html_list_of_active_formatting_elements_ensure_noahs_ark_clause_mismatch(context: void*?, entry: const (HtmlListOfActiveFormattingElementsEntry*)*) -> bool:
    let captures = (HtmlListOfActiveFormattingElementsEnsureNoahsArkClauseMismatch*)(context else trap("no captures"))
    let token = (*entry).token else trap("VERIFY: an element entry has its token")
    let attr = html_syntax.html_token_attribute(token, captures.name) else return true
    return not ak.string_equals(&attr, &captures.value)

## Ported from ListOfActiveFormattingElements.cpp:53 Web::HTML::ListOfActiveFormattingElements::create_own_token.
pub func html_list_of_active_formatting_elements_create_own_token(token: html_syntax.HtmlToken*) -> html_syntax.HtmlToken*:
    let new_token = new html_syntax.HtmlToken else trap("out of memory")
    html_syntax.html_token_construct(new_token, html_syntax.html_token_type(token))
    html_syntax.html_token_set_tag_name(new_token, html_syntax.html_token_tag_name(token))
    if let attributes = html_syntax.html_token_tag_attributes(token):
        for attribute in ak.vector_span(attributes):
            html_syntax.html_token_add_attribute(new_token, attribute)
    return new_token

## Ported from ListOfActiveFormattingElements.cpp:65 Web::HTML::ListOfActiveFormattingElements::add.
# https://html.spec.whatwg.org/multipage/parsing.html#push-onto-the-list-of-active-formatting-elements
pub func html_list_of_active_formatting_elements_add(this: HtmlListOfActiveFormattingElements*, element: DomElement*, token: html_syntax.HtmlToken*):
    # 1. If there are already three elements in the list of active formatting elements after the last marker, if any, or anywhere in the list if there are no markers,
    #    that have the same tag name, namespace, and attributes as element, then remove the earliest such element from the list of active formatting elements.
    #    For these purposes, the attributes must be compared as they were when the elements were created by the parser; two elements have the same attributes if all their parsed attributes
    #    can be paired such that the two attributes in each pair have identical names, namespaces, and values (the order of the attributes does not matter).
    html_list_of_active_formatting_elements_ensure_noahs_ark_clause(this, element)
    # 2. Add element to the list of active formatting elements.
    ak.vector_append_t(&this.m_entries, HtmlListOfActiveFormattingElementsEntry(element = element, token = html_list_of_active_formatting_elements_create_own_token(token)))

## Ported from ListOfActiveFormattingElements.cpp:76 Web::HTML::ListOfActiveFormattingElements::add_marker.
pub func html_list_of_active_formatting_elements_add_marker(this: HtmlListOfActiveFormattingElements*):
    ak.vector_append_t(&this.m_entries, HtmlListOfActiveFormattingElementsEntry(element = none, token = none))

## Ported from ListOfActiveFormattingElements.cpp:81 Web::HTML::ListOfActiveFormattingElements::contains.
pub func html_list_of_active_formatting_elements_contains(this: const HtmlListOfActiveFormattingElements*, element: DomElement*) -> bool:
    for entry in &ak.vector_span_const(&this.m_entries):
        if entry.element == element:
            return true
    return false

## Ported from ListOfActiveFormattingElements.cpp:90 Web::HTML::ListOfActiveFormattingElements::last_element_with_tag_name_before_marker.
pub func html_list_of_active_formatting_elements_last_element_with_tag_name_before_marker(this: HtmlListOfActiveFormattingElements*, tag_name: ak.FlyString) -> DomElement*?:
    var i = (isize)ak.vector_size(&this.m_entries) - 1
    while i >= 0:
        let entry = ak.vector_at(&this.m_entries, (usize)i)
        let element = entry.element else return none
        if html_parser_local_name_is(element, tag_name):
            return element
        i -= 1
    return none

## Ported from ListOfActiveFormattingElements.cpp:102 Web::HTML::ListOfActiveFormattingElements::remove.
pub func html_list_of_active_formatting_elements_remove(this: HtmlListOfActiveFormattingElements*, element: DomElement*):
    for i in 0..<ak.vector_size(&this.m_entries):
        if ak.vector_at(&this.m_entries, i).element == element:
            ak.vector_remove(&this.m_entries, i)
            return

## Ported from ListOfActiveFormattingElements.cpp:109 Web::HTML::ListOfActiveFormattingElements::clear_up_to_the_last_marker.
pub func html_list_of_active_formatting_elements_clear_up_to_the_last_marker(this: HtmlListOfActiveFormattingElements*):
    while not ak.vector_is_empty(&this.m_entries):
        let entry = ak.vector_take_last(&this.m_entries)
        if html_list_of_active_formatting_elements_entry_is_marker(&entry):
            break

## Ported from ListOfActiveFormattingElements.cpp:118 Web::HTML::ListOfActiveFormattingElements::find_index.
pub func html_list_of_active_formatting_elements_find_index(this: const HtmlListOfActiveFormattingElements*, element: DomElement*) -> usize?:
    for i in 0..<ak.vector_size(&this.m_entries):
        if ak.vector_at_const(&this.m_entries, i).element == element:
            return i
    return none

## Ported from ListOfActiveFormattingElements.cpp:127 Web::HTML::ListOfActiveFormattingElements::replace.
pub func html_list_of_active_formatting_elements_replace(this: HtmlListOfActiveFormattingElements*, to_remove: DomElement*, to_add: DomElement*, token: html_syntax.HtmlToken*):
    for entry in &ak.vector_span(&this.m_entries):
        if entry.element == to_remove:
            entry.element = to_add
            entry.token = html_list_of_active_formatting_elements_create_own_token(token)
            break

## Ported from ListOfActiveFormattingElements.cpp:138 Web::HTML::ListOfActiveFormattingElements::insert_at.
pub func html_list_of_active_formatting_elements_insert_at(this: HtmlListOfActiveFormattingElements*, index: usize, element: DomElement*, token: html_syntax.HtmlToken*):
    ak.vector_insert(&this.m_entries, index, HtmlListOfActiveFormattingElementsEntry(element = element, token = html_list_of_active_formatting_elements_create_own_token(token)))

# mark: ListOfActiveFormattingElements.h ========================================================

## Ported from ListOfActiveFormattingElements.h:21 Web::HTML::ListOfActiveFormattingElements::Entry::is_marker.
pub func html_list_of_active_formatting_elements_entry_is_marker(this: const HtmlListOfActiveFormattingElementsEntry*) -> bool:
    return this.element == none

## Ported from ListOfActiveFormattingElements.h:27 Web::HTML::ListOfActiveFormattingElements::is_empty.
pub func html_list_of_active_formatting_elements_is_empty(this: const HtmlListOfActiveFormattingElements*) -> bool:
    return ak.vector_is_empty(&this.m_entries)

## Ported from ListOfActiveFormattingElements.h:38 Web::HTML::ListOfActiveFormattingElements::entries (const).
pub func html_list_of_active_formatting_elements_entries_const(this: const HtmlListOfActiveFormattingElements*) -> const ak.Vector[HtmlListOfActiveFormattingElementsEntry]*:
    return &this.m_entries

## Ported from ListOfActiveFormattingElements.h:39 Web::HTML::ListOfActiveFormattingElements::entries.
pub func html_list_of_active_formatting_elements_entries(this: HtmlListOfActiveFormattingElements*) -> ak.Vector[HtmlListOfActiveFormattingElementsEntry]*:
    return &this.m_entries
