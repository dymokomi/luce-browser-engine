#==============================================================================================

## Ported from TrackEvent.cpp:19 Web::HTML::TrackEvent::create.
pub func html_track_event_create(realm: Realm*, event_name: ak.FlyString, event_init: HtmlTrackEventInit = HtmlTrackEventInit()) -> HtmlTrackEvent*:
    return realm_create_html_track_event(realm, realm, event_name, event_init)

## Ported from TrackEvent.cpp:24 Web::HTML::TrackEvent::construct_impl.
pub func html_track_event_construct_impl(realm: Realm*, event_name: ak.FlyString, event_init: HtmlTrackEventInit) -> HtmlTrackEvent*!:
    return html_track_event_create(realm, event_name, event_init)

## Ported from TrackEvent.cpp:29 Web::HTML::TrackEvent::to_track_type_internal (static).
func html_track_event_to_track_type_internal(track_type: HtmlTrackEventInitTrack?) -> HtmlTrackEventTrackTypeInternal:
    let track = track_type else return HtmlTrackEventTrackTypeInternal.empty
    return match track:
        .video_track(video_track) => HtmlTrackEventTrackTypeInternal.video_track(video_track)
        .audio_track(audio_track) => HtmlTrackEventTrackTypeInternal.audio_track(audio_track)
        .text_track(text_track) => HtmlTrackEventTrackTypeInternal.text_track(text_track)

## Ported from TrackEvent.cpp:36 Web::HTML::TrackEvent::TrackEvent.
pub func html_track_event_construct(this: HtmlTrackEvent*, realm: Realm*, event_name: ak.FlyString, event_init: HtmlTrackEventInit):
    dom_event_construct_dom_event_init(this.dom_event(), realm, event_name, event_init.event_init)
    this.m_track = html_track_event_to_track_type_internal(event_init.track)

## Ported from TrackEvent.cpp:42 Web::HTML::TrackEvent::initialize (override).
pub func html_track_event_initialize_impl(base: JsCell*, realm: Realm*):
    web_set_prototype_for_interface(base, realm, BindInterfaceName.track_event)
    dom_event_initialize_impl(base, realm)

## Ported from TrackEvent.cpp:48 Web::HTML::TrackEvent::visit_edges (override).
pub func html_track_event_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (HtmlTrackEvent*)base
    dom_event_visit_edges_impl(base, visitor)
    match this.m_track:
        .empty: _ = 0
        .video_track(video_track): gc.cell_visitor_visit_t(visitor, video_track)
        .audio_track(audio_track): gc.cell_visitor_visit_t(visitor, audio_track)
        .text_track(text_track): gc.cell_visitor_visit_t(visitor, text_track)

## Ported from TrackEvent.cpp:56 Web::HTML::TrackEvent::track.
pub func html_track_event_track(this: HtmlTrackEvent*) -> HtmlTrackEventInitTrack?:
    return match this.m_track:
        .empty => none
        .video_track(video_track) => HtmlTrackEventInitTrack.video_track(video_track)
        .audio_track(audio_track) => HtmlTrackEventInitTrack.audio_track(audio_track)
        .text_track(text_track) => HtmlTrackEventInitTrack.text_track(text_track)
