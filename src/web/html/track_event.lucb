#==============================================================================================
#
#   track_event - HTML::TrackEvent, the addtrack and removetrack events of track lists
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/TrackEvent.cpp (lines 1-63). The C++ init carries the
#       track as a GC::Root (NullableTrackType) and the event keeps it as a GC::Ref
#       (TrackTypeInternal); both are the track's pointer here.
#
#       Copyright (c) 2023, Tim Flynn <trflynn89@serenityos.org>
#       Copyright (c) 2026, Sam Atkins <sam@ladybird.org>
