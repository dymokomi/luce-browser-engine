#==============================================================================================
#
#   video_track - HTML::VideoTrack, one of a media resource's video tracks
#
#   DESCRIPTION:
#       Port of Libraries/LibWeb/HTML/VideoTrack.cpp (lines 1-78) and the inline accessors of
#       VideoTrack.h.
#       Only a demuxer makes tracks (HTMLMediaElement::on_audio_track_added / on_video_track_added,
#       from the PlaybackManager); without one (external/lib_media) none is made, so this runs
#       when playback is ported.
