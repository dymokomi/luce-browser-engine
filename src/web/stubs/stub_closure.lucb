## Ported from Libraries/LibWeb/HTML/Navigation.cpp:192 Web::HTML::to_history_handling_behavior.
## (Added by region r28 for Navigable's navigations; ported whole.)
pub func html_to_history_handling_behavior(b: BindNavigationHistoryBehavior) -> HtmlHistoryHandlingBehavior:
    # A history handling behavior is a NavigationHistoryBehavior that is either "push" or "replace",
    # i.e., that has been resolved away from any initial "auto" value.
    assert(b != BindNavigationHistoryBehavior.auto)

    match b:
        .push:
            return HtmlHistoryHandlingBehavior.push
        .replace:
            return HtmlHistoryHandlingBehavior.replace
        _:
            trap("VERIFY_NOT_REACHED")

