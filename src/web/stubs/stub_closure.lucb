## Ported from Libraries/LibWeb/HTML/CustomElements/CustomElementName.cpp:15 Web::HTML::is_valid_custom_element_name.
## A pure function that element creation and attachShadow need, so it is ported whole here.
# https://html.spec.whatwg.org/multipage/custom-elements.html#valid-custom-element-name
pub func html_is_valid_custom_element_name(name: ak.String) -> bool:
    # A string name is a valid custom element name if all of the following are true:
    # - name is a valid element local name;
    if not dom_is_valid_element_local_name(ak.fly_string_from_string(name)):
        return false

    # - name's 0th code point is an ASCII lower alpha;
    let code_points = ak.string_code_points(&name)
    let first = ak.utf8_view_begin(&code_points)
    if ak.utf8_code_point_iterator_done(&first) or not ak.is_ascii_lower_alpha(ak.utf8_code_point_iterator_deref(&first)):
        return false

    # - name does not contain any ASCII upper alphas;
    # - name contains a U+002D (-); and
    var contains_ascii_upper_alpha = false
    var contains_hyphen = false
    var iterator = ak.utf8_view_begin(&code_points)
    while not ak.utf8_code_point_iterator_done(&iterator):
        let code_point = ak.utf8_code_point_iterator_deref(&iterator)
        _ = ak.utf8_code_point_iterator_inc(&iterator)
        if ak.is_ascii_upper_alpha(code_point):
            contains_ascii_upper_alpha = true
            break
        if code_point == (u32)'-':
            contains_hyphen = true
    if contains_ascii_upper_alpha or not contains_hyphen:
        return false

    # - name is not one of the following:
    #   - "annotation-xml"
    #   - "color-profile"
    #   - "font-face"
    #   - "font-face-src"
    #   - "font-face-uri"
    #   - "font-face-format"
    #   - "font-face-name"
    #   - "missing-glyph"
    let reserved: str[8] = ["annotation-xml", "color-profile", "font-face", "font-face-src", "font-face-uri", "font-face-format", "font-face-name", "missing-glyph"]
    for reserved_name in reserved:
        if ak.string_eq_string_view(&name, ak.sv(reserved_name)):
            return false

    return true

## Ported from Libraries/LibWeb/HTML/CustomElements/CustomElementRegistry.cpp:507 Web::HTML::look_up_a_custom_element_definition.
## Steps 1-2 only: a registry's definition set is not ported (custom elements need scripting, phase 3).
pub func html_look_up_a_custom_element_definition(registry: HtmlCustomElementRegistry*?, namespace_: ak.FlyString?, local_name: ak.FlyString, is_: ak.String?) -> HtmlCustomElementDefinition*?:
    # 1. If registry is null, then return null.
    if registry == none:
        return none

    # 2. If namespace is not the HTML namespace, then return null.
    if not dom_node_optional_fly_string_is(namespace_, namespace_html):
        return none

    # 3. If registry's custom element definition set contains an item with name and local name both equal to
    #    localName, then return that item.
    let defining_registry = registry else trap("unreachable")
    let converted_local_name = ak.fly_string_to_string_const(&local_name)
    if let maybe_definition = html_custom_element_registry_get_definition_with_name_and_local_name(defining_registry, converted_local_name, converted_local_name):
        return maybe_definition

    # 4. If registry's custom element definition set contains an item with name equal to is and local name equal to
    #    localName, then return that item.
    # 5. Return null.

    # NB: If `is` has no value, it can never match as custom element definitions always have a name and localName
    #     (i.e. not stored as Optional<String>)
    let is_value = is_ else return none

    return html_custom_element_registry_get_definition_with_name_and_local_name(defining_registry, is_value, converted_local_name)

