## The SDL event types EventHandler::handle_sdl_input_events handles (SDL_EventType).
## (Added by region r28.)
pub enum SdlEventType as u32:
    other = 0
    gamepad_added = 0x653
    gamepad_removed = 0x654
    gamepad_update_complete = 0x65a

## What EventHandler::handle_sdl_input_events reads of an SDL_Event: its type and gdevice.which.
## (Added by region r28.)
pub struct SdlEvent:
    pub var type_: SdlEventType
    pub var which: u32

## SDL_PollEvent (SDL3): the next pending SDL event. Gamepads (SDL) are phase 4: SDL is never
## initialized in phase 1, so there is never an event to poll, as SDL_PollEvent answers then.
## (Added by region r28 for EventHandler::handle_sdl_input_events.)
pub func sdl_poll_event() -> SdlEvent?:
    return none

