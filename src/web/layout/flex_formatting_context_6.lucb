# mark: Auto sizes and max sizes as none ========================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2070 Web::Layout::FlexFormattingContext::should_treat_main_size_as_auto.
func layout_flex_formatting_context_should_treat_main_size_as_auto(this: LayoutFlexFormattingContext*, box: LayoutBox*) -> bool:
    let space = layout_flex_formatting_context_available_space_for_items(this).space
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return layout_formatting_context_should_treat_width_as_auto(this.layout_formatting_context(), box, space)
    return layout_formatting_context_should_treat_height_as_auto(this.layout_formatting_context(), box, space)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2077 Web::Layout::FlexFormattingContext::should_treat_cross_size_as_auto.
func layout_flex_formatting_context_should_treat_cross_size_as_auto(this: LayoutFlexFormattingContext*, box: LayoutBox*) -> bool:
    let space = layout_flex_formatting_context_available_space_for_items(this).space
    if layout_flex_formatting_context_cross_axis_is_horizontal(this):
        return layout_formatting_context_should_treat_width_as_auto(this.layout_formatting_context(), box, space)
    return layout_formatting_context_should_treat_height_as_auto(this.layout_formatting_context(), box, space)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2084 Web::Layout::FlexFormattingContext::should_treat_main_max_size_as_none.
func layout_flex_formatting_context_should_treat_main_max_size_as_none(this: LayoutFlexFormattingContext*, box: LayoutBox*) -> bool:
    let space = layout_flex_formatting_context_available_space_for_items(this).space
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return layout_formatting_context_should_treat_max_width_as_none(this.layout_formatting_context(), box, space.width)
    return layout_formatting_context_should_treat_max_height_as_none(this.layout_formatting_context(), box, space.height)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2091 Web::Layout::FlexFormattingContext::should_treat_cross_max_size_as_none.
func layout_flex_formatting_context_should_treat_cross_max_size_as_none(this: LayoutFlexFormattingContext*, box: LayoutBox*) -> bool:
    let space = layout_flex_formatting_context_available_space_for_items(this).space
    if layout_flex_formatting_context_cross_axis_is_horizontal(this):
        return layout_formatting_context_should_treat_max_width_as_none(this.layout_formatting_context(), box, space.width)
    return layout_formatting_context_should_treat_max_height_as_none(this.layout_formatting_context(), box, space.height)

# mark: Cross-size contributions of an item =====================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2098 Web::Layout::FlexFormattingContext::calculate_cross_min_content_contribution.
func layout_flex_formatting_context_calculate_cross_min_content_contribution(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*, resolve_percentage_min_max_sizes: bool) -> gfx.CssPixels:
    let cross_size_auto = layout_flex_formatting_context_should_treat_cross_size_as_auto(this, item.box)
    var size: gfx.CssPixels
    if cross_size_auto:
        size = layout_flex_formatting_context_calculate_min_content_cross_size(this, item)
    elif layout_flex_formatting_context_cross_axis_is_horizontal(this):
        size = layout_flex_formatting_context_get_pixel_width(this, item, layout_flex_formatting_context_computed_cross_size(this, item.box))
    else:
        size = layout_flex_formatting_context_get_pixel_height(this, item, layout_flex_formatting_context_computed_cross_size(this, item.box))

    if cross_size_auto and layout_box_has_preferred_aspect_ratio(item.box):
        size = layout_flex_formatting_context_adjust_cross_size_through_aspect_ratio_for_main_size_min_max_constraints(this, item.box, size, layout_flex_formatting_context_computed_main_min_size(this, item.box), layout_flex_formatting_context_computed_main_max_size(this, item.box))

    let computed_min_size = layout_flex_formatting_context_computed_cross_min_size(this, item.box)
    let computed_max_size = layout_flex_formatting_context_computed_cross_max_size(this, item.box)

    let clamp_min = layout_flex_formatting_context_specified_cross_min_size(this, item) if (not css_size_is_auto(&computed_min_size) and (resolve_percentage_min_max_sizes or not css_size_contains_percentage(&computed_min_size))) else layout_zero_px()
    let clamp_max = layout_flex_formatting_context_specified_cross_max_size(this, item) if (not layout_flex_formatting_context_should_treat_cross_max_size_as_none(this, item.box) and (resolve_percentage_min_max_sizes or not css_size_contains_percentage(&computed_max_size))) else gfx.css_pixels_max()

    let clamped_inner_size = layout_css_clamp(size, clamp_min, clamp_max)

    return layout_flex_formatting_context_flex_item_add_cross_margin_box_sizes(item, clamped_inner_size)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2121 Web::Layout::FlexFormattingContext::calculate_cross_max_content_contribution.
func layout_flex_formatting_context_calculate_cross_max_content_contribution(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*, resolve_percentage_min_max_sizes: bool) -> gfx.CssPixels:
    let cross_size_auto = layout_flex_formatting_context_should_treat_cross_size_as_auto(this, item.box)
    var size: gfx.CssPixels
    if cross_size_auto:
        size = layout_flex_formatting_context_calculate_max_content_cross_size(this, item)
    elif layout_flex_formatting_context_cross_axis_is_horizontal(this):
        size = layout_flex_formatting_context_get_pixel_width(this, item, layout_flex_formatting_context_computed_cross_size(this, item.box))
    else:
        size = layout_flex_formatting_context_get_pixel_height(this, item, layout_flex_formatting_context_computed_cross_size(this, item.box))

    if cross_size_auto and layout_box_has_preferred_aspect_ratio(item.box):
        size = layout_flex_formatting_context_adjust_cross_size_through_aspect_ratio_for_main_size_min_max_constraints(this, item.box, size, layout_flex_formatting_context_computed_main_min_size(this, item.box), layout_flex_formatting_context_computed_main_max_size(this, item.box))

    let computed_min_size = layout_flex_formatting_context_computed_cross_min_size(this, item.box)
    let computed_max_size = layout_flex_formatting_context_computed_cross_max_size(this, item.box)

    let clamp_min = layout_flex_formatting_context_specified_cross_min_size(this, item) if (not css_size_is_auto(&computed_min_size) and (resolve_percentage_min_max_sizes or not css_size_contains_percentage(&computed_min_size))) else layout_zero_px()
    let clamp_max = layout_flex_formatting_context_specified_cross_max_size(this, item) if (not layout_flex_formatting_context_should_treat_cross_max_size_as_none(this, item.box) and (resolve_percentage_min_max_sizes or not css_size_contains_percentage(&computed_max_size))) else gfx.css_pixels_max()

    let clamped_inner_size = layout_css_clamp(size, clamp_min, clamp_max)

    return layout_flex_formatting_context_flex_item_add_cross_margin_box_sizes(item, clamped_inner_size)

# mark: Intrinsic sizes of an item ==============================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2144 Web::Layout::FlexFormattingContext::calculate_width_to_use_when_determining_intrinsic_height_of_item.
func layout_flex_formatting_context_calculate_width_to_use_when_determining_intrinsic_height_of_item(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    let box = item.box
    let base = this.layout_formatting_context()
    let computed_values = layout_box_computed(box)
    let computed_width = css_computed_values_width(computed_values)
    let computed_min_width = css_computed_values_min_width(computed_values)
    let computed_max_width = css_computed_values_max_width(computed_values)
    let space = layout_flex_formatting_context_available_space_for_items(this).space

    # We can resolve percentage min/max-width if the available width is definite.
    let can_resolve_percentages = layout_available_size_is_definite(&space.width)

    let clamp_min = layout_flex_formatting_context_get_pixel_width(this, item, computed_min_width) if (not css_size_is_auto(&computed_min_width) and (not css_size_contains_percentage(&computed_min_width) or can_resolve_percentages)) else layout_zero_px()
    let clamp_max = layout_flex_formatting_context_get_pixel_width(this, item, computed_max_width) if (not layout_formatting_context_should_treat_max_width_as_none(base, box, space.width) and (not css_size_contains_percentage(&computed_max_width) or can_resolve_percentages)) else gfx.css_pixels_max()

    var width: gfx.CssPixels
    if layout_formatting_context_should_treat_width_as_auto(base, box, space) or css_size_is_fit_content(&computed_width):
        width = layout_formatting_context_calculate_fit_content_width(base, box, space)
    elif css_size_is_min_content(&computed_width):
        width = layout_formatting_context_calculate_min_content_width(base, box)
    elif css_size_is_max_content(&computed_width):
        width = layout_formatting_context_calculate_max_content_width(base, box)

    return layout_css_clamp(width, clamp_min, clamp_max)

## `item.used_values.available_inner_space_or_constraints_from(m_available_space_for_items->space)` with an indefinite
## width replaced by the width to use when determining the item's intrinsic height (the common part of
## calculate_{min,max}_content_{main,cross}_size when the size is a height).
func layout_flex_formatting_context_available_space_for_intrinsic_height(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> LayoutAvailableSpace:
    var available_space = layout_state_used_values_available_inner_space_or_constraints_from(item.used_values, layout_flex_formatting_context_available_space_for_items(this).space)
    if layout_available_size_is_indefinite(&available_space.width):
        available_space.width = layout_available_size_make_definite(layout_flex_formatting_context_calculate_width_to_use_when_determining_intrinsic_height_of_item(this, item))
    return available_space

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2168 Web::Layout::FlexFormattingContext::calculate_min_content_main_size.
func layout_flex_formatting_context_calculate_min_content_main_size(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return layout_formatting_context_calculate_min_content_width(this.layout_formatting_context(), item.box)
    let available_space = layout_flex_formatting_context_available_space_for_intrinsic_height(this, item)
    return layout_formatting_context_calculate_min_content_height(this.layout_formatting_context(), item.box, layout_available_size_to_px_or_zero(&available_space.width))

