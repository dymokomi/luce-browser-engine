# mark: Cross-axis auto margins and align-content: stretch ======================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2272 Web::Layout::FlexFormattingContext::resolve_cross_axis_auto_margins.
# https://drafts.csswg.org/css-flexbox-1/#algo-cross-margins
func layout_flex_formatting_context_resolve_cross_axis_auto_margins(this: LayoutFlexFormattingContext*):
    let lines = ak.vector_span(&this.m_flex_lines)
    for line in &lines:
        for item in ak.vector_span(&line.items):
            #  If a flex item has auto cross-axis margins:
            if not item.margins.cross_before_is_auto and not item.margins.cross_after_is_auto:
                continue

            # If its outer cross size (treating those auto margins as zero) is less than the cross size of its flex line,
            # distribute the difference in those sizes equally to the auto margins.
            # NB: Auto cross-axis margins are stored as 0, so including them here treats them as zero while keeping
            #     non-auto cross-axis margins in the outer cross size.
            let cross_size = item.cross_size else trap("VERIFY: the item's cross size is determined")
            let outer_cross_size = cross_size.add(item.padding.cross_before).add(item.padding.cross_after).add(item.borders.cross_before).add(item.borders.cross_after).add(item.margins.cross_before).add(item.margins.cross_after)

            if outer_cross_size.lt(line.cross_size):
                let remainder = line.cross_size.sub(outer_cross_size)
                if item.margins.cross_before_is_auto and item.margins.cross_after_is_auto:
                    item.margins.cross_before = layout_div_int(remainder, 2)
                    item.margins.cross_after = layout_div_int(remainder, 2)
                elif item.margins.cross_before_is_auto:
                    item.margins.cross_before = remainder
                else:
                    item.margins.cross_after = remainder
            else:
                # FIXME: Otherwise, if the block-start or inline-start margin (whichever is in the cross axis) is auto, set it to zero.
                #        Set the opposite margin so that the outer cross size of the item equals the cross size of its flex line.
                discard(0)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2308 Web::Layout::FlexFormattingContext::handle_align_content_stretch.
# https://drafts.csswg.org/css-flexbox-1/#algo-line-stretch
func layout_flex_formatting_context_handle_align_content_stretch(this: LayoutFlexFormattingContext*):
    # If the flex container has a definite cross size,
    if not layout_flex_formatting_context_has_definite_cross_size_layout_state_used_values(this, this.m_flex_container_state):
        return

    # align-content is stretch,
    let align_content = css_computed_values_align_content(layout_box_computed(layout_flex_formatting_context_flex_container(this)))
    if align_content != css_data.AlignContent.stretch and align_content != css_data.AlignContent.normal:
        return

    # and the sum of the flex lines' cross sizes is less than the flex container’s inner cross size,
    let lines = ak.vector_span(&this.m_flex_lines)
    var sum_of_flex_line_cross_sizes = layout_zero_px()
    for summed_line in lines:
        sum_of_flex_line_cross_sizes = sum_of_flex_line_cross_sizes.add(summed_line.cross_size)

    # CSS-FLEXBOX-2: Account for gap between flex lines.
    sum_of_flex_line_cross_sizes = sum_of_flex_line_cross_sizes.add(layout_flex_formatting_context_mul_count(layout_flex_formatting_context_cross_gap(this), lines.length -% 1))

    if sum_of_flex_line_cross_sizes.ge(layout_flex_formatting_context_inner_cross_size_layout_state_used_values(this, this.m_flex_container_state)):
        return

    # increase the cross size of each flex line by equal amounts
    # such that the sum of their cross sizes exactly equals the flex container’s inner cross size.
    let remainder = layout_flex_formatting_context_inner_cross_size_layout_state_used_values(this, this.m_flex_container_state).sub(sum_of_flex_line_cross_sizes)
    let extra_per_line = layout_div_int(remainder, (i64)lines.length)

    for line in &lines:
        line.cross_size = line.cross_size.add(extra_per_line)

# mark: Absolutely positioned children ==========================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2339 Web::Layout::FlexFormattingContext::calculate_static_position_rect.
# https://drafts.csswg.org/css-flexbox-1/#abspos-items
pub func layout_flex_formatting_context_calculate_static_position_rect(this: LayoutFlexFormattingContext*, box: LayoutBox*) -> LayoutStaticPositionRect:
    # The cross-axis edges of the static-position rectangle of an absolutely-positioned child
    # of a flex container are the content edges of the flex container.

    var cross_axis_alignment = LayoutStaticPositionRectAlignment.start
    match layout_flex_formatting_context_alignment_for_item(this, box):
        .baseline, .flex_start, .stretch, .normal:
            # (Baseline:) FIXME: Implement this
            #  Fallthrough
            cross_axis_alignment = LayoutStaticPositionRectAlignment.end if layout_flex_formatting_context_cross_axis_is_reverse(this) else LayoutStaticPositionRectAlignment.start
        .flex_end:
            cross_axis_alignment = LayoutStaticPositionRectAlignment.start if layout_flex_formatting_context_cross_axis_is_reverse(this) else LayoutStaticPositionRectAlignment.end
        .start, .self_start:
            cross_axis_alignment = LayoutStaticPositionRectAlignment.start
        .end, .self_end:
            cross_axis_alignment = LayoutStaticPositionRectAlignment.end
        .center:
            cross_axis_alignment = LayoutStaticPositionRectAlignment.center
        _:
            discard(0)

    # The main-axis edges of the static-position rectangle are where the margin edges of the child
    # would be positioned if it were the sole flex item in the flex container,
    # assuming both the child and the flex container were fixed-size boxes of their used size.
    # (For this purpose, auto margins are treated as zero.

    var main_axis_alignment = LayoutStaticPositionRectAlignment.start
    match css_computed_values_justify_content(layout_box_computed(layout_flex_formatting_context_flex_container(this))):
        .start, .left:
            main_axis_alignment = LayoutStaticPositionRectAlignment.start
        .stretch, .normal, .flex_start, .space_between:
            main_axis_alignment = LayoutStaticPositionRectAlignment.end if layout_flex_formatting_context_is_direction_reverse(this) else LayoutStaticPositionRectAlignment.start
        .end:
            main_axis_alignment = LayoutStaticPositionRectAlignment.end
        .right:
            main_axis_alignment = LayoutStaticPositionRectAlignment.end
        .flex_end:
            main_axis_alignment = LayoutStaticPositionRectAlignment.end if not layout_flex_formatting_context_is_direction_reverse(this) else LayoutStaticPositionRectAlignment.start
        .center, .space_around, .space_evenly:
            main_axis_alignment = LayoutStaticPositionRectAlignment.center
        _:
            # The C++ switch has no default: other values keep Start.
            discard(0)

    let main_axis_is_horizontal = layout_flex_formatting_context_main_axis_is_horizontal(this)
    let flex_container_width = layout_flex_formatting_context_inner_main_size_layout_state_used_values(this, this.m_flex_container_state) if main_axis_is_horizontal else layout_flex_formatting_context_inner_cross_size_layout_state_used_values(this, this.m_flex_container_state)
    let flex_container_height = layout_flex_formatting_context_inner_cross_size_layout_state_used_values(this, this.m_flex_container_state) if main_axis_is_horizontal else layout_flex_formatting_context_inner_main_size_layout_state_used_values(this, this.m_flex_container_state)

    var static_position_rect = LayoutStaticPositionRect()
    static_position_rect.rect = gfx.CssPixelRect(gfx.CssPixelPoint(layout_zero_px(), layout_zero_px()), gfx.CssPixelSize(flex_container_width, flex_container_height))
    static_position_rect.horizontal_alignment = main_axis_alignment if main_axis_is_horizontal else cross_axis_alignment
    static_position_rect.vertical_alignment = cross_axis_alignment if main_axis_is_horizontal else main_axis_alignment
    return static_position_rect

# mark: Flex lines and gaps =====================================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2415 Web::Layout::FlexFormattingContext::FlexLine::sum_of_flex_factor_of_unfrozen_items.
func layout_flex_formatting_context_flex_line_sum_of_flex_factor_of_unfrozen_items(this: const LayoutFlexFormattingContextFlexLine*) -> f64:
    var sum = 0.0
    for item in ak.vector_span_const(&this.items):
        if not item.frozen:
            sum += item.flex_factor else trap("VERIFY: the item has a flex factor")
    return sum

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2425 Web::Layout::FlexFormattingContext::FlexLine::sum_of_scaled_flex_shrink_factor_of_unfrozen_items.
func layout_flex_formatting_context_flex_line_sum_of_scaled_flex_shrink_factor_of_unfrozen_items(this: const LayoutFlexFormattingContextFlexLine*) -> f64:
    var sum = 0.0
    for item in ak.vector_span_const(&this.items):
        if not item.frozen:
            sum += item.scaled_flex_shrink_factor
    return sum

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2435 Web::Layout::FlexFormattingContext::main_gap.
func layout_flex_formatting_context_main_gap(this: LayoutFlexFormattingContext*) -> gfx.CssPixels:
    let computed_values = layout_box_computed(layout_flex_formatting_context_flex_container(this))
    let gap = css_computed_values_column_gap(computed_values) if layout_flex_formatting_context_is_row_layout(this) else css_computed_values_row_gap(computed_values)
    return layout_formatting_context_gap_to_px(this.layout_formatting_context(), gap, layout_flex_formatting_context_inner_main_size_layout_state_used_values(this, this.m_flex_container_state))

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2442 Web::Layout::FlexFormattingContext::cross_gap.
func layout_flex_formatting_context_cross_gap(this: LayoutFlexFormattingContext*) -> gfx.CssPixels:
    let computed_values = layout_box_computed(layout_flex_formatting_context_flex_container(this))
    let gap = css_computed_values_row_gap(computed_values) if layout_flex_formatting_context_is_row_layout(this) else css_computed_values_column_gap(computed_values)
    return layout_formatting_context_gap_to_px(this.layout_formatting_context(), gap, layout_flex_formatting_context_inner_cross_size_layout_state_used_values(this, this.m_flex_container_state))
