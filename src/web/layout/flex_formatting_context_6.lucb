## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:2231 Web::Layout::FlexFormattingContext::flex_item_is_stretched.
# https://drafts.csswg.org/css-flexbox-1/#stretched
func layout_flex_formatting_context_flex_item_is_stretched(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> bool:
    let alignment = layout_flex_formatting_context_alignment_for_item(this, item.box)
    if alignment != css_data.AlignItems.stretch and alignment != css_data.AlignItems.normal:
        return false
    # If the cross size property of the flex item computes to auto, and neither of the cross-axis margins are auto, the flex item is stretched.
    let computed_cross_size = layout_flex_formatting_context_computed_cross_size(this, item.box)
    return css_size_is_auto(&computed_cross_size) and not item.margins.cross_before_is_auto and not item.margins.cross_after_is_auto

