    css_mutable_computed_values_set_quotes(computed_values, css_computed_properties_quotes(computed_style))
    css_mutable_computed_values_set_counter_increment(computed_values, css_computed_properties_counter_data(computed_style, css_data.PropertyId.counter_increment))
    css_mutable_computed_values_set_counter_reset(computed_values, css_computed_properties_counter_data(computed_style, css_data.PropertyId.counter_reset))
    css_mutable_computed_values_set_counter_set(computed_values, css_computed_properties_counter_data(computed_style, css_data.PropertyId.counter_set))

    css_mutable_computed_values_set_object_fit(computed_values, css_computed_properties_object_fit(computed_style))
    css_mutable_computed_values_set_object_position(computed_values, css_computed_properties_object_position(computed_style))
    css_mutable_computed_values_set_direction(computed_values, css_computed_properties_direction(computed_style))
    css_mutable_computed_values_set_unicode_bidi(computed_values, css_computed_properties_unicode_bidi(computed_style))
    css_mutable_computed_values_set_scrollbar_color(computed_values, css_computed_properties_scrollbar_color(computed_style, this))
    css_mutable_computed_values_set_scrollbar_width(computed_values, css_computed_properties_scrollbar_width(computed_style))
    css_mutable_computed_values_set_writing_mode(computed_values, css_computed_properties_writing_mode(computed_style))
    css_mutable_computed_values_set_user_select(computed_values, css_computed_properties_user_select(computed_style))
    css_mutable_computed_values_set_isolation(computed_values, css_computed_properties_isolation(computed_style))
    css_mutable_computed_values_set_mix_blend_mode(computed_values, css_computed_properties_mix_blend_mode(computed_style))
    css_mutable_computed_values_set_view_transition_name(computed_values, css_computed_properties_view_transition_name(computed_style))
    css_mutable_computed_values_set_contain(computed_values, css_computed_properties_contain(computed_style))
    css_mutable_computed_values_set_container_type(computed_values, css_computed_properties_container_type(computed_style))
    css_mutable_computed_values_set_shape_rendering(computed_values, css_computed_values_shape_rendering(&computed_values.computed_values))
    css_mutable_computed_values_set_will_change(computed_values, css_computed_properties_will_change(computed_style))

