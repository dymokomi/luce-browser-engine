    css_mutable_computed_values_set_color_interpolation(computed_values, css_computed_properties_color_interpolation(computed_style))
    css_mutable_computed_values_set_resize(computed_values, css_computed_properties_resize(computed_style))

    layout_node_with_style_propagate_style_to_anonymous_wrappers(this)

    if let box_node = as_if_layout_node_with_style_and_box_model_metrics(this):
        layout_node_with_style_and_box_model_metrics_propagate_style_along_continuation(box_node, computed_style)

    layout_node_with_style_rebuild_image_observers(this)
