# mark: ImageProvider.cpp =======================================================================

## Ported from Libraries/LibWeb/Layout/ImageProvider.cpp:13 Web::Layout::ImageProvider::did_update_alt_text.
pub func layout_image_provider_did_update_alt_text(layout_node: LayoutImageBox*):
    layout_image_box_dom_node_did_update_alt_text(layout_node)

## Ported from Libraries/LibWeb/Layout/ImageProvider.cpp:18 Web::Layout::ImageProvider::intrinsic_size.
pub func layout_image_provider_intrinsic_size(this: LayoutImageProvider*) -> gfx.CssPixelSize?:
    let width = layout_image_provider_intrinsic_width(this)
    let height = layout_image_provider_intrinsic_height(this)
    let known_width = width else return none
    let known_height = height else return none

    var size: gfx.CssPixelSize = ---
    gfx.css_pixel_size_construct(&size, known_width, known_height)
    return size

## `intrinsic_size().value_or({}).to_type<int>()`: the size the default bitmaps are asked for.
func layout_image_provider_intrinsic_int_size(this: LayoutImageProvider*) -> gfx.IntSize:
    let size = layout_image_provider_intrinsic_size(this) else gfx.CssPixelSize()
    return gfx.css_pixel_size_to_type_i32(&size)

## Ported from Libraries/LibWeb/Layout/ImageProvider.cpp:28 Web::Layout::ImageProvider::current_image_bitmap (virtual).
pub func layout_image_provider_current_image_bitmap_impl(this: LayoutImageProvider*) -> gfx.ImmutableBitmap*?:
    return layout_image_provider_current_image_bitmap_sized(this, layout_image_provider_intrinsic_int_size(this))

## Ported from Libraries/LibWeb/Layout/ImageProvider.cpp:33 Web::Layout::ImageProvider::default_image_bitmap (virtual).
pub func layout_image_provider_default_image_bitmap_impl(this: LayoutImageProvider*) -> gfx.ImmutableBitmap*?:
    return layout_image_provider_default_image_bitmap_sized(this, layout_image_provider_intrinsic_int_size(this))

## Ported from Libraries/LibWeb/Layout/ImageProvider.cpp:38 Web::Layout::ImageProvider::default_image_bitmap_sized (virtual).
pub func layout_image_provider_default_image_bitmap_sized_impl(this: LayoutImageProvider*, size: gfx.IntSize) -> gfx.ImmutableBitmap*?:
    # Defer to the current image by default.
    return layout_image_provider_current_image_bitmap_sized(this, size)

## Ported from Libraries/LibWeb/Layout/ImageProvider.h:39 Web::Layout::ImageProvider::image_provider_visit_edges (virtual).
pub func layout_image_provider_image_provider_visit_edges_impl(this: LayoutImageProvider*, visitor: gc.CellVisitor*):
    gc.cell_visitor_visit_t(visitor, layout_image_provider_to_html_element(this))
