#==============================================================================================
#
#   formatting_context_1 - Layout::FormattingContext: construction, the independent formatting
#                          contexts boxes create, inside layout and automatic heights
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/FormattingContext.cpp (lines 1-42 and 200-542) and the inline
#       members of FormattingContext.h: the constructor, the ReplacedFormattingContext and
#       DummyFormattingContext hacks, create_independent_formatting_context(_if_needed),
#       layout_inside, greatest_child_width, the physical width of a line box, shrink-to-fit
#       widths, the replaced size constraint table, automatic heights of absolutely positioned
#       boxes and of block formatting context roots, and the table wrapper's width and height.
#       (FormattingContext.cpp's lines 44-198, which formatting context a box creates, were
#       taken ahead by region r43: formatting_context_box_types.)
#
#       A formatting context is not a cell: C++ owns it through OwnPtr (`make<T>(...)`), here
#       it lives in managed memory. Its virtual destructor matters only for a
#       BlockFormattingContext, whose ~BlockFormattingContext lays out absolutely positioned
#       children its parent never asked for; layout_formatting_context_destruct runs it where
#       C++ destroys an owning pointer (callers `defer` it).
#
#       Copyright (c) 2020-2022, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction and destruction ============================================================

## Ported from Libraries/LibWeb/Layout/FormattingContext.h:19 Web::Layout::css_clamp.
# NOTE: We use a custom clamping function here instead of AK::clamp(), since the AK version
#       will VERIFY(max >= min) and CSS explicitly allows that (see css-values-4.)
pub func layout_css_clamp[T: luce.Comparable](value: T, min: T, max: T) -> T:
    return ak.max(min, ak.min(value, max))

## Gives a formatting context the dynamic type of `class_info` (the C++ vptr a constructor sets).
pub func layout_formatting_context_set_class(this: LayoutFormattingContext*, class_info: const ak.ClassInfo*):
    this.vtable = (const LayoutFormattingContextVTable*)class_info.vtable
    this.class_id = class_info.first_id

## `make<T>(...)`'s storage for a formatting context: zeroed, which is what default-constructing its
## members (empty Vectors and Optionals, null pointers) gives before its constructor runs.
pub func layout_make_formatting_context_storage[T]() -> T*:
    let storage = alloc T[1] else trap("out of memory")
    memory.set(u8[]((u8*)storage.data, sizeof(T)), 0)
    return &storage[0]

## Ported from Libraries/LibWeb/Layout/FormattingContext.cpp:32 Web::Layout::FormattingContext::FormattingContext.
pub func layout_formatting_context_construct(this: LayoutFormattingContext*, type_: LayoutFormattingContextType, layout_mode: LayoutMode, state: LayoutState*, context_box: LayoutBox*, parent: LayoutFormattingContext*? = none):
    layout_formatting_context_set_class(this, &layout_formatting_context_class)
    this.m_type = type_
    this.m_layout_mode = layout_mode
    this.m_parent = parent
    this.m_context_box = context_box
    this.m_state = state

## Ported from Libraries/LibWeb/Layout/FormattingContext.cpp:41 Web::Layout::FormattingContext::~FormattingContext: the
## virtual destructor an OwnPtr<FormattingContext> runs when it goes out of scope. Only BlockFormattingContext's does
## something; a null pointer is an empty OwnPtr.
pub func layout_formatting_context_destruct(this: LayoutFormattingContext*?):
    let context = this else return
    if let block_formatting_context = as_if_layout_block_formatting_context(context):
        layout_block_formatting_context_destruct(block_formatting_context)

