## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1562 Web::Layout::BlockFormattingContext::space_used_and_containing_margin_for_floats.
pub func layout_block_formatting_context_space_used_and_containing_margin_for_floats(this: LayoutBlockFormattingContext*, y: gfx.CssPixels) -> LayoutFormattingContextSpaceUsedAndContainingMarginForFloats:
    var space_and_containing_margin = LayoutFormattingContextSpaceUsedAndContainingMarginForFloats(
        left_used_space = layout_zero_px(),
        right_used_space = layout_zero_px(),
        left_total_containing_margin = layout_zero_px(),
        right_total_containing_margin = layout_zero_px(),
        matching_left_float_box = none,
        matching_right_float_box = none,
    )
    let root = layout_block_formatting_context_root(this).layout_node_with_style()

    var index = ak.vector_size(&this.m_left_floats.all_boxes)
    while index > 0:
        index -= 1
        let floating_box = *ak.vector_at(&this.m_left_floats.all_boxes, index)
        # NOTE: The floating box is *not* in the final horizontal position yet, but the size and vertical position is valid.
        let rect = floating_box.margin_box_rect_in_root_coordinate_space
        if gfx.css_pixel_rect_contains_vertically(&rect, y):
            var offset_from_containing_block_chain_margins_between_here_and_root = layout_zero_px()
            var containing_block_or_none = layout_state_used_values_containing_block_used_values(floating_box.used_values)
            while let containing_block = containing_block_or_none:
                if layout_state_used_values_node_const(containing_block) == root:
                    break
                offset_from_containing_block_chain_margins_between_here_and_root = offset_from_containing_block_chain_margins_between_here_and_root.add(layout_state_used_values_margin_box_left(containing_block))
                containing_block_or_none = layout_state_used_values_containing_block_used_values(containing_block)
            space_and_containing_margin.left_used_space = floating_box.offset_from_edge.add(layout_state_used_values_content_width(floating_box.used_values)).add(layout_state_used_values_margin_box_right(floating_box.used_values))
            space_and_containing_margin.left_total_containing_margin = offset_from_containing_block_chain_margins_between_here_and_root
            space_and_containing_margin.matching_left_float_box = floating_box.box
            break

    index = ak.vector_size(&this.m_right_floats.all_boxes)
    while index > 0:
        index -= 1
        let floating_box = *ak.vector_at(&this.m_right_floats.all_boxes, index)
        # NOTE: The floating box is *not* in the final horizontal position yet, but the size and vertical position is valid.
        let rect = floating_box.margin_box_rect_in_root_coordinate_space
        if gfx.css_pixel_rect_contains_vertically(&rect, y):
            var offset_from_containing_block_chain_margins_between_here_and_root = layout_zero_px()
            var containing_block_or_none = layout_state_used_values_containing_block_used_values(floating_box.used_values)
            while let containing_block = containing_block_or_none:
                if layout_state_used_values_node_const(containing_block) == root:
                    break
                offset_from_containing_block_chain_margins_between_here_and_root = offset_from_containing_block_chain_margins_between_here_and_root.add(layout_state_used_values_margin_box_right(containing_block))
                containing_block_or_none = layout_state_used_values_containing_block_used_values(containing_block)
            space_and_containing_margin.right_used_space = floating_box.offset_from_edge.add(layout_state_used_values_margin_box_left(floating_box.used_values))
            space_and_containing_margin.right_total_containing_margin = offset_from_containing_block_chain_margins_between_here_and_root
            space_and_containing_margin.matching_right_float_box = floating_box.box
            break

    return space_and_containing_margin

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1604 Web::Layout::BlockFormattingContext::intrusion_by_floats_into_box.
pub func layout_block_formatting_context_intrusion_by_floats_into_box_layout_box(this: LayoutBlockFormattingContext*, box: LayoutBox*, y_in_box: gfx.CssPixels) -> LayoutFormattingContextSpaceUsedByFloats:
    return layout_block_formatting_context_intrusion_by_floats_into_box_layout_state_used_values(this, layout_state_get(this.formatting_context.m_state, box.layout_node_with_style()), y_in_box)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1609 Web::Layout::BlockFormattingContext::intrusion_by_floats_into_box.
pub func layout_block_formatting_context_intrusion_by_floats_into_box_layout_state_used_values(this: LayoutBlockFormattingContext*, box_used_values: const LayoutStateUsedValues*, y_in_box: gfx.CssPixels) -> LayoutFormattingContextSpaceUsedByFloats:
    let base = this.layout_formatting_context()
    let root = layout_block_formatting_context_root(this)
    # NOTE: Floats are relative to the BFC root box, not necessarily the containing block of this IFC.
    let box_in_root_rect = layout_formatting_context_content_box_rect_in_ancestor_coordinate_space(base, box_used_values, root.layout_box())
    let y_in_root = gfx.css_pixel_rect_y(&box_in_root_rect).add(y_in_box)
    let space_and_containing_margin = layout_block_formatting_context_space_used_and_containing_margin_for_floats(this, y_in_root)

    var left_intrusion = layout_zero_px()
    if space_and_containing_margin.matching_left_float_box != none:
        let left_side_floats_limit_to_right = space_and_containing_margin.left_total_containing_margin.add(space_and_containing_margin.left_used_space)
        left_intrusion = ak.max(layout_zero_px(), left_side_floats_limit_to_right.sub(gfx.css_pixel_rect_x(&box_in_root_rect)))

    # If we did not match a right float, the right_total_containing_margin will be 0 (as its never set). Since no floats means
    # no intrusion we would instead want it to be exactly equal to offset_from_containing_block_chain_margins_between_here_and_root.
    # Since this is not the case we have to explicitly handle this case.
    var right_intrusion = layout_zero_px()
    if space_and_containing_margin.matching_right_float_box != none:
        let right_side_floats_limit_to_right = space_and_containing_margin.right_used_space.add(space_and_containing_margin.right_total_containing_margin)
        var offset_from_containing_block_chain_margins_between_here_and_root = layout_zero_px()
        var containing_block_or_none: const LayoutStateUsedValues*? = box_used_values
        while let containing_block = containing_block_or_none:
            if layout_state_used_values_node_const(containing_block) == root.layout_node_with_style():
                break
            offset_from_containing_block_chain_margins_between_here_and_root = offset_from_containing_block_chain_margins_between_here_and_root.add(layout_state_used_values_margin_box_right(containing_block))
            containing_block_or_none = layout_state_used_values_containing_block_used_values(containing_block)
        right_intrusion = ak.max(layout_zero_px(), right_side_floats_limit_to_right.sub(offset_from_containing_block_chain_margins_between_here_and_root))

    return LayoutFormattingContextSpaceUsedByFloats(left = left_intrusion, right = right_intrusion)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1638 Web::Layout::BlockFormattingContext::greatest_child_width (override).
pub func layout_block_formatting_context_greatest_child_width_impl(base: LayoutFormattingContext*, box: LayoutBox*) -> gfx.CssPixels:
    let this = (LayoutBlockFormattingContext*)base
    # Similar to FormattingContext::greatest_child_width()
    # but this one takes floats into account!
    var max_width = this.m_left_floats.max_width.add(this.m_right_floats.max_width)
    if layout_node_children_are_inline(box.layout_node()):
        let line_boxes = &layout_state_get(base.m_state, as_layout_block_container(box).layout_node_with_style()).line_boxes
        for line_box in ak.vector_span_const(line_boxes):
            var width_here = layout_formatting_context_line_box_physical_width(box, &line_box)
            let line_top = layout_line_box_bottom(&line_box).sub(layout_line_box_height(&line_box))
            let line_bottom = layout_line_box_bottom(&line_box)
            var extra_width_from_left_floats = layout_zero_px()
            for left_float in ak.vector_span(&this.m_left_floats.all_boxes):
                # NOTE: Floats directly affect the automatic size of their containing block, but only indirectly anything above in the tree.
                if layout_node_containing_block(left_float.box.layout_node()) != box:
                    continue
                if line_top.lt(left_float.bottom_margin_edge) and line_bottom.gt(left_float.top_margin_edge):
                    extra_width_from_left_floats = ak.max(extra_width_from_left_floats, left_float.offset_from_edge.add(layout_state_used_values_content_width(left_float.used_values)).add(layout_state_used_values_margin_box_right(left_float.used_values)))
            var extra_width_from_right_floats = layout_zero_px()
            for right_float in ak.vector_span(&this.m_right_floats.all_boxes):
                # NOTE: Floats directly affect the automatic size of their containing block, but only indirectly anything above in the tree.
                if layout_node_containing_block(right_float.box.layout_node()) != box:
                    continue
                if line_top.lt(right_float.bottom_margin_edge) and line_bottom.gt(right_float.top_margin_edge):
                    extra_width_from_right_floats = ak.max(extra_width_from_right_floats, right_float.offset_from_edge.add(layout_state_used_values_margin_box_left(right_float.used_values)))
            width_here = width_here.add(extra_width_from_left_floats).add(extra_width_from_right_floats)
            max_width = ak.max(max_width, width_here)
    else:
        for child_node in layout_node_children(box.layout_node()):
            let child = as_if_layout_box(child_node) else continue
            if not layout_node_is_absolutely_positioned(child_node):
                max_width = ak.max(max_width, layout_state_used_values_margin_box_width(layout_state_get(base.m_state, child.layout_node_with_style())))
    return max_width

# mark: Multi-column containers =================================================================

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1682 Web::Layout::BlockFormattingContext::determine_used_value_for_column_count.
# https://drafts.csswg.org/css-multicol/#pseudo-algorithm
# The pseudo-algorithm below determines the used values for column-count (N) and column-width (W). There is
# one other variable in the pseudo-algorithm: U is the used width of the multi-column container.
pub func layout_block_formatting_context_determine_used_value_for_column_count(this: LayoutBlockFormattingContext*, U: gfx.CssPixels) -> i32?:
    let computed_values = layout_box_computed(layout_block_formatting_context_root(this).layout_box())
    let column_width_value = css_computed_values_column_width(computed_values)
    let column_count_value = css_computed_values_column_count(computed_values)
    # (01)  if ((column-width = auto) and (column-count = auto)) then
    if css_size_is_auto(&column_width_value) and css_column_count_is_auto(&column_count_value):
        # (02)      exit; /* not a multicol container */
        return none

    # (03)  if column-width = auto then
    if css_size_is_auto(&column_width_value):
        # (04)      N := column-count
        return css_column_count_value(&column_count_value)

    let column_gap = layout_block_formatting_context_get_column_gap_used_value_for_multicol(this, U)
    let column_width = layout_block_formatting_context_get_column_width_used_value_for_multicol(this, U)
    let columns = U.add(column_gap).div(column_width.add(column_gap))

    # (05)  else if column-count = auto then
    if css_column_count_is_auto(&column_count_value):
        # (06)      N := max(1,
        # (07)        floor((U + column-gap)/(column-width + column-gap)))
        return ak.max(1i32, gfx.css_pixel_fraction_to_int(&columns))

    # (08)  else
    # (09)      N := min(column-count, max(1,
    # (10)        floor((U + column-gap)/(column-width + column-gap))))
    return ak.min(css_column_count_value(&column_count_value), ak.max(1i32, gfx.css_pixel_fraction_to_int(&columns)))

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1712 Web::Layout::BlockFormattingContext::determine_used_value_for_column_width.
pub func layout_block_formatting_context_determine_used_value_for_column_width(this: LayoutBlockFormattingContext*, U: gfx.CssPixels, N: i32) -> gfx.CssPixels:
    let column_gap = layout_block_formatting_context_get_column_gap_used_value_for_multicol(this, U)
    # (11)  W := max(0, (U + column-gap)/N - column-gap)
    let per_column = gfx.div_css_pixels_int(U.add(column_gap), (i64)N)
    return ak.max(layout_zero_px(), gfx.css_pixel_fraction_sub(&per_column, column_gap))

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1720 Web::Layout::BlockFormattingContext::get_column_width_used_value_for_multicol.
# https://drafts.csswg.org/css-multicol-2/#cw
pub func layout_block_formatting_context_get_column_width_used_value_for_multicol(this: LayoutBlockFormattingContext*, U: gfx.CssPixels) -> gfx.CssPixels:
    let root = layout_block_formatting_context_root(this)
    let column_width = css_computed_values_column_width(layout_box_computed(root.layout_box()))
    # Used values will be clamped to a minimum of '1px'.
    return ak.max(css_size_to_px(&column_width, root.layout_node(), U), gfx.CssPixels.from_int(1))

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.cpp:1727 Web::Layout::BlockFormattingContext::get_column_gap_used_value_for_multicol.
# https://www.w3.org/TR/css-align-3/#column-row-gap
pub func layout_block_formatting_context_get_column_gap_used_value_for_multicol(this: LayoutBlockFormattingContext*, U: gfx.CssPixels) -> gfx.CssPixels:
    let root = layout_block_formatting_context_root(this)
    # The 'normal' represents a used value of '1em' on multi-column containers
    match css_computed_values_column_gap(layout_box_computed(root.layout_box())):
        .css_normal_gap(_):
            let one_em = css_length_new(1.0, css_data.LengthUnit.em)
            return css_length_to_px_layout_node(&one_em, root.layout_node())
        .css_length_percentage(gap):
            return css_percentage_or_to_px(&gap.percentage_or, root.layout_node(), U)
