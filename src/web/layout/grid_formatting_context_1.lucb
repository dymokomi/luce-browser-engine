## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:126 Web::Layout::OccupationGrid::OccupationGrid.
pub func layout_occupation_grid_construct_usize(this: LayoutOccupationGrid*, columns_count: usize, rows_count: usize):
    layout_occupation_grid_construct(this)
    # `max(0, columns_count - 1)` is AK::max<int>: the size_t difference is converted to int.
    this.m_max_column_index = ak.max[i32](0, (i32)(columns_count -% 1))
    this.m_max_row_index = ak.max[i32](0, (i32)(rows_count -% 1))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:131 Web::Layout::OccupationGrid::OccupationGrid.
pub func layout_occupation_grid_construct(this: LayoutOccupationGrid*):
    this.m_occupation_grid = ak.HashTable[LayoutGridPosition, LayoutGridPositionTraits]()
    this.m_min_column_index = 0
    this.m_max_column_index = 0
    this.m_min_row_index = 0
    this.m_max_row_index = 0

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:135 Web::Layout::OccupationGrid::column_count.
pub func layout_occupation_grid_column_count(this: const LayoutOccupationGrid*) -> usize:
    return (usize)(i64)(ak.abs_i32(this.m_min_column_index) + this.m_max_column_index + 1)

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:140 Web::Layout::OccupationGrid::row_count.
pub func layout_occupation_grid_row_count(this: const LayoutOccupationGrid*) -> usize:
    return (usize)(i64)(ak.abs_i32(this.m_min_row_index) + this.m_max_row_index + 1)

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:145 Web::Layout::OccupationGrid::set_max_column_index.
pub func layout_occupation_grid_set_max_column_index(this: LayoutOccupationGrid*, max_column_index: usize):
