# mark: GridItem (GridFormattingContext.h) ======================================================

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:36 Web::Layout::GridItem::span.
pub func layout_grid_item_span(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> usize:
    if dimension == LayoutGridDimension.column:
        return this.column_span else trap("VERIFY: the grid item's column span has a value")
    return this.row_span else trap("VERIFY: the grid item's row span has a value")

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:41 Web::Layout::GridItem::raw_position.
pub func layout_grid_item_raw_position(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> i32:
    if dimension == LayoutGridDimension.column:
        return this.column else trap("VERIFY: the grid item's column has a value")
    return this.row else trap("VERIFY: the grid item's row has a value")

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:46 Web::Layout::GridItem::add_margin_box_sizes.
pub func layout_grid_item_add_margin_box_sizes(this: const LayoutGridItem*, content_size: gfx.CssPixels, dimension: LayoutGridDimension) -> gfx.CssPixels:
    if dimension == LayoutGridDimension.column:
        return layout_state_used_values_margin_box_left(this.used_values).add(content_size).add(layout_state_used_values_margin_box_right(this.used_values))
    return layout_state_used_values_margin_box_top(this.used_values).add(content_size).add(layout_state_used_values_margin_box_bottom(this.used_values))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:53 Web::Layout::GridItem::gap_adjusted_position.
pub func layout_grid_item_gap_adjusted_position(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> i32:
    if dimension == LayoutGridDimension.column:
        return layout_grid_item_gap_adjusted_column(this)
    return layout_grid_item_gap_adjusted_row(this)

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:61 Web::Layout::GridItem::computed_values.
pub func layout_grid_item_computed_values(this: const LayoutGridItem*) -> const CssComputedValues*:
    return layout_box_computed(this.box)

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:66 Web::Layout::GridItem::minimum_size.
pub func layout_grid_item_minimum_size(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> CssSize:
    if dimension == LayoutGridDimension.column:
        return css_computed_values_min_width(layout_grid_item_computed_values(this))
    return css_computed_values_min_height(layout_grid_item_computed_values(this))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:71 Web::Layout::GridItem::maximum_size.
