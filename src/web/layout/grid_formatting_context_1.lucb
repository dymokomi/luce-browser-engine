    if dimension == LayoutGridDimension.column:
        return css_computed_values_max_width(layout_grid_item_computed_values(this))
    return css_computed_values_max_height(layout_grid_item_computed_values(this))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:76 Web::Layout::GridItem::preferred_size.
pub func layout_grid_item_preferred_size(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> CssSize:
    if dimension == LayoutGridDimension.column:
        return css_computed_values_width(layout_grid_item_computed_values(this))
    return css_computed_values_height(layout_grid_item_computed_values(this))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:81 Web::Layout::GridItem::margin_start.
pub func layout_grid_item_margin_start(this: const LayoutGridItem*, dimension: LayoutGridDimension) -> CssLengthPercentageOrAuto:
