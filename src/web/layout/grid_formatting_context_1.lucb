## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:111 Web::Layout::GridItem::available_space.
pub func layout_grid_item_available_space(this: const LayoutGridItem*) -> LayoutAvailableSpace:
    let available_width = layout_available_size_make_definite(layout_state_used_values_content_width(this.used_values)) if layout_state_used_values_has_definite_width(this.used_values) else layout_available_size_make_indefinite()
    let available_height = layout_available_size_make_definite(layout_state_used_values_content_height(this.used_values)) if layout_state_used_values_has_definite_height(this.used_values) else layout_available_size_make_indefinite()
    return LayoutAvailableSpace(width = available_width, height = available_height)

