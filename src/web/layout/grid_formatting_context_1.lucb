## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:171 Web::Layout::GridFormattingContext::inhibits_floating (override).
pub func layout_grid_formatting_context_inhibits_floating_impl(base: LayoutFormattingContext*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:178 Web::Layout::GridFormattingContext::grid_container.
pub func layout_grid_formatting_context_grid_container(this: LayoutGridFormattingContext*) -> LayoutBox*:
    return layout_formatting_context_context_box(this.layout_formatting_context())

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:220 Web::Layout::GridFormattingContext::has_gaps.
func layout_grid_formatting_context_has_gaps(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension) -> bool:
    let computed_values = layout_box_computed(layout_grid_formatting_context_grid_container(this))
    let gap = css_computed_values_column_gap(computed_values) if dimension == LayoutGridDimension.column else css_computed_values_row_gap(computed_values)
    match gap:
        .css_normal_gap(_): return false
        _: return true

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:230 Web::Layout::GridFormattingContext::for_each_spanned_track_by_item:
## `for track in layout_grid_formatting_context_for_each_spanned_track_by_item(this, item, dimension)` visits each
## track the item spans, each followed by the gap after it unless it is the last spanned track (DESIGN.md §2.9).
func layout_grid_formatting_context_for_each_spanned_track_by_item(this: LayoutGridFormattingContext*, item: const LayoutGridItem*, dimension: LayoutGridDimension) -> LayoutGridFormattingContextSpannedTracks:
    let tracks = &this.m_grid_columns if dimension == LayoutGridDimension.column else &this.m_grid_rows
    let gaps = &this.m_column_gap_tracks if dimension == LayoutGridDimension.column else &this.m_row_gap_tracks
    let has_gaps = layout_grid_formatting_context_has_gaps(this, dimension)
    let item_span = layout_grid_item_span(item, dimension)
    let item_index = layout_grid_item_raw_position(item, dimension)
    return LayoutGridFormattingContextSpannedTracks(tracks = tracks, gaps = gaps, has_gaps = has_gaps, item_span = item_span, item_index = item_index)

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:254 Web::Layout::GridFormattingContext::for_each_spanned_track_by_item
## (the const overload, the same traversal).
func layout_grid_formatting_context_for_each_spanned_track_by_item_const(this: LayoutGridFormattingContext*, item: const LayoutGridItem*, dimension: LayoutGridDimension) -> LayoutGridFormattingContextSpannedTracks:
    return layout_grid_formatting_context_for_each_spanned_track_by_item(this, item, dimension)

## The tracks and gaps a grid item spans, as an iterable (for_each_spanned_track_by_item's loop).
pub struct LayoutGridFormattingContextSpannedTracks: luce.Iterable[LayoutGridFormattingContextGridTrack*, LayoutGridFormattingContextSpannedTrackIterator]:
    pub var tracks: ak.Vector[LayoutGridFormattingContextGridTrack]*
    pub var gaps: ak.Vector[LayoutGridFormattingContextGridTrack]*
    pub var has_gaps: bool
    pub var item_span: usize
    pub var item_index: i32

    func iterator() -> LayoutGridFormattingContextSpannedTrackIterator:
        return LayoutGridFormattingContextSpannedTrackIterator(spanned = self, span = 0, pending_gap_index = none)

## The iterator of LayoutGridFormattingContextSpannedTracks: `callback(track)` for each spanned track, then
## `callback(gap)` for the gap that follows it.
pub struct LayoutGridFormattingContextSpannedTrackIterator: luce.Iterator[LayoutGridFormattingContextGridTrack*]:
    pub var spanned: LayoutGridFormattingContextSpannedTracks
    pub var span: usize
    pub var pending_gap_index: usize?

    func next() -> LayoutGridFormattingContextGridTrack*?:
        if let gap_index = self.pending_gap_index:
            self.pending_gap_index = none
            return ak.vector_at(self.spanned.gaps, gap_index)
        if self.span >= self.spanned.item_span:
            return none
        # `item_index + span` is size_t arithmetic: a negative index wraps past the tracks and ends the walk.
        let track_index = (usize)(i64)self.spanned.item_index +% self.span
        if track_index >= ak.vector_size(self.spanned.tracks):
            return none

        let track = ak.vector_at(self.spanned.tracks, track_index)

        let is_last_spanned_track = self.span == self.spanned.item_span - 1
        if self.spanned.has_gaps and not is_last_spanned_track:
            self.pending_gap_index = track_index
        self.span += 1
        return track

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.h:289 Web::Layout::GridFormattingContext::has_flexible_tracks.
func layout_grid_formatting_context_has_flexible_tracks(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension) -> bool:
    return this.m_has_flexible_column_tracks if dimension == LayoutGridDimension.column else this.m_has_flexible_row_tracks

## `m_available_space.value()` (and `m_available_space->`): VERIFYs that run() has set it.
func layout_grid_formatting_context_available_space(this: LayoutGridFormattingContext*) -> LayoutAvailableSpace:
    return this.m_available_space else trap("VERIFY: m_available_space has a value")

## `dimension == GridDimension::Column ? m_available_space->width : m_available_space->height`.
func layout_grid_formatting_context_available_size(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension) -> LayoutAvailableSize:
    let available_space = layout_grid_formatting_context_available_space(this)
    return available_space.width if dimension == LayoutGridDimension.column else available_space.height

## `dimension == GridDimension::Column ? m_grid_columns : m_grid_rows`.
func layout_grid_formatting_context_tracks(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension) -> ak.Vector[LayoutGridFormattingContextGridTrack]*:
    return &this.m_grid_columns if dimension == LayoutGridDimension.column else &this.m_grid_rows

## `dimension == GridDimension::Column ? m_grid_columns_and_gaps : m_grid_rows_and_gaps`.
func layout_grid_formatting_context_tracks_and_gaps(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension) -> ak.Vector[LayoutGridFormattingContextGridTrack*]*:
    return &this.m_grid_columns_and_gaps if dimension == LayoutGridDimension.column else &this.m_grid_rows_and_gaps

## `value / count` read as CSSPixels for a size_t count: `CSSPixels / size_t` is a CSSPixelFraction over
## CSSPixels(Unsigned), which saturates, converted by its operator CSSPixels.
func layout_grid_formatting_context_div_count(value: gfx.CssPixels, count: usize) -> gfx.CssPixels:
    let fraction = value.div(gfx.css_pixels_from_unsigned((u64)count))
    return gfx.css_pixel_fraction_to_css_pixels(&fraction)

# mark: to_alignment ============================================================================

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:17 Web::Layout::to_alignment.
func layout_to_alignment_justify_content(value: css_data.JustifyContent) -> LayoutAlignment:
    match value:
        .left: return LayoutAlignment.start
        .right: return LayoutAlignment.end
        .flex_start, .start: return LayoutAlignment.start
        .flex_end, .end: return LayoutAlignment.end
        .center: return LayoutAlignment.center
        .space_between: return LayoutAlignment.space_between
        .space_around: return LayoutAlignment.space_around
        .space_evenly: return LayoutAlignment.space_evenly
        .stretch: return LayoutAlignment.stretch
        .normal: return LayoutAlignment.normal
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:47 Web::Layout::to_alignment.
func layout_to_alignment_justify_items(value: css_data.JustifyItems) -> LayoutAlignment:
    match value:
        .baseline: return LayoutAlignment.baseline
        .center: return LayoutAlignment.center
        .end: return LayoutAlignment.end
        .flex_end: return LayoutAlignment.end
        .flex_start: return LayoutAlignment.start
        .legacy: return LayoutAlignment.normal
        .normal: return LayoutAlignment.normal
        .safe: return LayoutAlignment.safe
        .self_end: return LayoutAlignment.self_end
        .self_start: return LayoutAlignment.self_start
        .start: return LayoutAlignment.start
        .stretch: return LayoutAlignment.stretch
        .unsafe: return LayoutAlignment.unsafe
        .left: return LayoutAlignment.start
        .right: return LayoutAlignment.end
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:85 Web::Layout::to_alignment.
