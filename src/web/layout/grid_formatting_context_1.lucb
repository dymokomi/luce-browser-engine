    match value:
        .start: return LayoutAlignment.start
        .end: return LayoutAlignment.end
        .center: return LayoutAlignment.center
        .space_between: return LayoutAlignment.space_between
        .space_around: return LayoutAlignment.space_around
        .space_evenly: return LayoutAlignment.space_evenly
        .stretch: return LayoutAlignment.stretch
        .normal: return LayoutAlignment.normal
        .flex_start: return LayoutAlignment.start
        .flex_end: return LayoutAlignment.end
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:113 Web::Layout::to_alignment.
func layout_to_alignment_align_items(value: css_data.AlignItems) -> LayoutAlignment:
    match value:
        .baseline: return LayoutAlignment.baseline
        .center: return LayoutAlignment.center
        .end: return LayoutAlignment.end
        .flex_end: return LayoutAlignment.end
        .flex_start: return LayoutAlignment.start
        .normal: return LayoutAlignment.normal
        .safe: return LayoutAlignment.safe
        .self_end: return LayoutAlignment.self_end
        .self_start: return LayoutAlignment.self_start
        .start: return LayoutAlignment.start
        .stretch: return LayoutAlignment.stretch
        .unsafe: return LayoutAlignment.unsafe
        _: trap("VERIFY_NOT_REACHED")

# mark: GridTrack ===============================================================================

## A GridTrack with its C++ default member initializers and the given sizing functions.
func layout_grid_formatting_context_grid_track_new(min_track_sizing_function: CssGridSize, max_track_sizing_function: CssGridSize) -> LayoutGridFormattingContextGridTrack:
    return LayoutGridFormattingContextGridTrack(min_track_sizing_function = min_track_sizing_function, max_track_sizing_function = max_track_sizing_function, growth_limit = layout_zero_px())

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:145 Web::Layout::GridFormattingContext::GridTrack::create_from_definition.
func layout_grid_formatting_context_grid_track_create_from_definition(definition: const CssExplicitGridTrack*, is_auto_fit: bool = false) -> LayoutGridFormattingContextGridTrack:
    # NOTE: repeat() is expected to be expanded beforehand.
    assert(not css_explicit_grid_track_is_repeat(definition))

    if css_explicit_grid_track_is_minmax(definition):
        let minmax = css_explicit_grid_track_minmax(definition)
        var track = layout_grid_formatting_context_grid_track_new(css_grid_min_max_min_grid_size(&minmax), css_grid_min_max_max_grid_size(&minmax))
        track.is_auto_fit = is_auto_fit
        return track

    # https://drafts.csswg.org/css-grid-2/#algo-terms
    # min track sizing function:
    # If the track was sized with a minmax() function, this is the first argument to that function.
    # If the track was sized with a <flex> value or fit-content() function, auto. Otherwise, the track’s sizing function.
    var min_track_sizing_function = css_explicit_grid_track_grid_size(definition)
    if css_grid_size_is_flexible_length(&min_track_sizing_function) or css_grid_size_is_fit_content(&min_track_sizing_function):
        min_track_sizing_function = css_grid_size_make_auto()
    let max_track_sizing_function = css_explicit_grid_track_grid_size(definition)

    var track = layout_grid_formatting_context_grid_track_new(min_track_sizing_function, max_track_sizing_function)
    track.is_auto_fit = is_auto_fit
    return track

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:175 Web::Layout::GridFormattingContext::GridTrack::create_auto.
func layout_grid_formatting_context_grid_track_create_auto() -> LayoutGridFormattingContextGridTrack:
    return layout_grid_formatting_context_grid_track_new(css_grid_size_make_auto(), css_grid_size_make_auto())

## `CSS::GridSize(CSS::LengthStyleValue::create(CSS::Length::make_px(size)))`.
func layout_grid_formatting_context_px_grid_size(size: gfx.CssPixels) -> CssGridSize:
    return css_grid_size_new(css_length_style_value_create(css_length_make_px_css_pixels(size)).css_style_value())

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:183 Web::Layout::GridFormattingContext::GridTrack::create_gap.
func layout_grid_formatting_context_grid_track_create_gap(size: gfx.CssPixels) -> LayoutGridFormattingContextGridTrack:
    var track = layout_grid_formatting_context_grid_track_new(layout_grid_formatting_context_px_grid_size(size), layout_grid_formatting_context_px_grid_size(size))
    track.base_size = size
    track.is_gap = true
    return track

# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:193 Web::Layout::GridFormattingContext::GridFormattingContext.
pub func layout_grid_formatting_context_construct(this: LayoutGridFormattingContext*, state: LayoutState*, layout_mode: LayoutMode, grid_container: LayoutBox*, parent: LayoutFormattingContext*?):
    layout_formatting_context_construct(this.layout_formatting_context(), LayoutFormattingContextType.grid, layout_mode, state, grid_container, parent)
    layout_formatting_context_set_class(this.layout_formatting_context(), &layout_grid_formatting_context_class)
    this.m_grid_container_used_values = layout_state_get_mutable(state, grid_container.layout_node_with_style())
    # The other members start as their default member initializers: zero, empty, none.
    layout_occupation_grid_construct(&this.m_occupation_grid)
    this.m_available_space = none

# GridFormattingContext::~GridFormattingContext() is the default destructor (GridFormattingContext.cpp:199):
# layout_formatting_context_destruct has nothing to run for this context.

# mark: Definite track sizes and repeat() counts ================================================

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:201 Web::Layout::GridFormattingContext::resolve_definite_track_size.
func layout_grid_formatting_context_resolve_definite_track_size(this: LayoutGridFormattingContext*, grid_size: const CssGridSize*, available_space: LayoutAvailableSpace) -> gfx.CssPixels:
    assert(css_grid_size_is_definite(grid_size))
    let css_size = css_grid_size_css_size(grid_size)
    return css_size_to_px(&css_size, layout_grid_formatting_context_grid_container(this).layout_node(), layout_available_size_to_px_or_zero(&available_space.width))

## Ported from Libraries/LibWeb/Layout/GridFormattingContext.cpp:207 Web::Layout::GridFormattingContext::count_of_repeated_auto_fill_or_fit_tracks.
func layout_grid_formatting_context_count_of_repeated_auto_fill_or_fit_tracks(this: LayoutGridFormattingContext*, dimension: LayoutGridDimension, repeated_track: const CssExplicitGridTrack*) -> i32:
    # https://www.w3.org/TR/css-grid-2/#auto-repeat
    # 7.2.3.2. Repeat-to-fill: auto-fill and auto-fit repetitions
    # On a subgridded axis, the auto-fill keyword is only valid once per <line-name-list>, and repeats
    # enough times for the name list to match the subgrid’s specified grid span (falling back to 0 if
    # the span is already fulfilled).

    # Otherwise on a standalone axis, when auto-fill is given as the repetition number
    # If the grid container has a definite size or max size in the relevant axis, then the number of
    # repetitions is the largest possible positive integer that does not cause the grid to overflow the
    # content box of its grid container

    let grid_computed_values = layout_box_computed(layout_grid_formatting_context_grid_container(this))
    let available_space = layout_grid_formatting_context_available_space(this)
    var size_of_repeated_tracks = layout_zero_px()
    # (treating each track as its max track sizing function if that is definite or its minimum track sizing
    # function otherwise, flooring the max track sizing function by the min track sizing function if both
    # are definite, and taking gap into account)
    let repeat = css_explicit_grid_track_repeat(repeated_track)
    let repeat_grid_track_size_list = css_grid_repeat_grid_track_size_list(&repeat)
    let repeat_track_list = css_grid_track_size_list_track_list(&repeat_grid_track_size_list)
    let repeat_tracks = ak.vector_span_const(&repeat_track_list)
    for explicit_grid_track in &repeat_tracks:
        let track_sizing_function = explicit_grid_track
        var track_size = layout_zero_px()
        if css_explicit_grid_track_is_minmax(track_sizing_function):
            let minmax = css_explicit_grid_track_minmax(track_sizing_function)
            let min_size = css_grid_min_max_min_grid_size(&minmax)
            let max_size = css_grid_min_max_max_grid_size(&minmax)
            if css_grid_size_is_definite(&max_size):
                track_size = layout_grid_formatting_context_resolve_definite_track_size(this, &max_size, available_space)
                if css_grid_size_is_definite(&min_size):
                    track_size = ak.min(track_size, layout_grid_formatting_context_resolve_definite_track_size(this, &min_size, available_space))
            elif css_grid_size_is_definite(&min_size):
                track_size = layout_grid_formatting_context_resolve_definite_track_size(this, &min_size, available_space)
            else:
                trap("VERIFY_NOT_REACHED")
        else:
            let grid_size = css_explicit_grid_track_grid_size(track_sizing_function)
            track_size = layout_grid_formatting_context_resolve_definite_track_size(this, &grid_size, available_space)
        size_of_repeated_tracks = size_of_repeated_tracks.add(track_size)

    if gfx.eq_css_pixels_int(size_of_repeated_tracks, 0):
        return 0

    let available_size = layout_grid_formatting_context_available_size(this, dimension)
    let gap = css_computed_values_column_gap(grid_computed_values) if dimension == LayoutGridDimension.column else css_computed_values_row_gap(grid_computed_values)
    let gap_px = layout_formatting_context_gap_to_px(this.layout_formatting_context(), gap, layout_available_size_to_px_or_zero(&available_size))
    # `repeat_track_list.size() * gap_px`: CSSPixels(size_t) * CSSPixels.
    let size_of_repeated_tracks_with_gap = size_of_repeated_tracks.add(gfx.css_pixels_from_unsigned((u64)ak.vector_size(&repeat_track_list)).mul(gap_px))
    # Otherwise, if the grid container has a definite min size in the relevant axis, the number of repetitions is the
    # smallest possible positive integer that fulfills that minimum requirement
    if layout_available_size_is_definite(&available_size):
        # NOTE: Gap size is added to free space to compensate for the fact that the last track does not have a gap
        let free_space = layout_available_size_to_px_or_zero(&available_size)
        let repetitions = free_space.add(gap_px).div(size_of_repeated_tracks_with_gap)
        let number_of_repetitions = gfx.css_pixel_fraction_to_int(&repetitions)
        # If any number of repetitions would overflow, then 1 repetition.
        return ak.max[i32](1, number_of_repetitions)
    # Otherwise, the specified track list repeats only once.
    return 1

    # For the purpose of finding the number of auto-repeated tracks in a standalone axis, the UA must
    # floor the track size to a UA-specified value to avoid division by zero. It is suggested that this
    # floor be 1px.
