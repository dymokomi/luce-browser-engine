#       Copyright (c) 2022, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: AvailableSize ===========================================================================

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:12 Web::Layout::AvailableSize::make_definite.
pub func layout_available_size_make_definite(value: gfx.CssPixels) -> LayoutAvailableSize:
    assert(not value.might_be_saturated())
    return LayoutAvailableSize(m_type = LayoutAvailableSizeType.definite, m_value = value)

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:18 Web::Layout::AvailableSize::make_indefinite.
pub func layout_available_size_make_indefinite() -> LayoutAvailableSize:
    return LayoutAvailableSize(m_type = LayoutAvailableSizeType.indefinite, m_value = gfx.css_pixels_max())

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:23 Web::Layout::AvailableSize::make_min_content.
pub func layout_available_size_make_min_content() -> LayoutAvailableSize:
    return LayoutAvailableSize(m_type = LayoutAvailableSizeType.min_content, m_value = gfx.CssPixels.from_int(0))

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:28 Web::Layout::AvailableSize::make_max_content.
pub func layout_available_size_make_max_content() -> LayoutAvailableSize:
    return LayoutAvailableSize(m_type = LayoutAvailableSizeType.max_content, m_value = gfx.css_pixels_max())

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:30 Web::Layout::AvailableSize::is_definite.
pub func layout_available_size_is_definite(this: const LayoutAvailableSize*) -> bool:
    return this.m_type == LayoutAvailableSizeType.definite

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:31 Web::Layout::AvailableSize::is_indefinite.
pub func layout_available_size_is_indefinite(this: const LayoutAvailableSize*) -> bool:
    return this.m_type == LayoutAvailableSizeType.indefinite

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:32 Web::Layout::AvailableSize::is_min_content.
pub func layout_available_size_is_min_content(this: const LayoutAvailableSize*) -> bool:
    return this.m_type == LayoutAvailableSizeType.min_content

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:33 Web::Layout::AvailableSize::is_max_content.
pub func layout_available_size_is_max_content(this: const LayoutAvailableSize*) -> bool:
    return this.m_type == LayoutAvailableSizeType.max_content

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:34 Web::Layout::AvailableSize::is_intrinsic_sizing_constraint.
pub func layout_available_size_is_intrinsic_sizing_constraint(this: const LayoutAvailableSize*) -> bool:
    return layout_available_size_is_min_content(this) or layout_available_size_is_max_content(this)

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:36 Web::Layout::AvailableSize::to_px_or_zero.
pub func layout_available_size_to_px_or_zero(this: const LayoutAvailableSize*) -> gfx.CssPixels:
    if not layout_available_size_is_definite(this):
        return gfx.CssPixels.from_int(0)
    return this.m_value

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:33 Web::Layout::AvailableSize::to_string.
pub func layout_available_size_to_string(this: const LayoutAvailableSize*) -> ak.String:
    match this.m_type:
        .definite:
            return css_string_formatted("definite({})", [dump_arg_css_pixels(this.m_value)])
        .indefinite:
            return ak.string_from_str("indefinite")
        .min_content:
            return ak.string_from_str("min-content")
        .max_content:
            return ak.string_from_str("max-content")
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:46 Web::Layout::AvailableSize::operator<.
pub func layout_available_size_lt(this: const LayoutAvailableSize*, other: LayoutAvailableSize) -> bool:
    return this.m_value.lt(other.m_value)

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:53 Web::Layout::AvailableSize::AvailableSize.
pub func layout_available_size_construct(this: LayoutAvailableSize*, type_: LayoutAvailableSizeType, value: gfx.CssPixels):
    this.m_type = type_
    this.m_value = value

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:55 Web::Layout::operator>.
pub func layout_gt(left: gfx.CssPixels, right: LayoutAvailableSize) -> bool:
    if layout_available_size_is_max_content(&right) or layout_available_size_is_indefinite(&right):
        return false
    if layout_available_size_is_min_content(&right):
        return true
    return left.gt(layout_available_size_to_px_or_zero(&right))

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:64 Web::Layout::operator<.
pub func layout_lt_css_pixels(left: gfx.CssPixels, right: LayoutAvailableSize) -> bool:
    if layout_available_size_is_max_content(&right) or layout_available_size_is_indefinite(&right):
        return true
    if layout_available_size_is_min_content(&right):
        return false
    return left.lt(layout_available_size_to_px_or_zero(&right))

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:73 Web::Layout::operator<.
pub func layout_lt_layout_available_size(left: LayoutAvailableSize, right: gfx.CssPixels) -> bool:
    if layout_available_size_is_min_content(&left):
        return true
    if layout_available_size_is_max_content(&left) or layout_available_size_is_indefinite(&left):
        return false
    return layout_available_size_to_px_or_zero(&left).lt(right)

# mark: AvailableSpace ==========================================================================

## Ported from Libraries/LibWeb/Layout/AvailableSpace.h:84 Web::Layout::AvailableSpace::AvailableSpace.
pub func layout_available_space_construct(this: LayoutAvailableSpace*, w: LayoutAvailableSize, h: LayoutAvailableSize):
    this.width = w
    this.height = h

## Ported from Libraries/LibWeb/Layout/AvailableSpace.cpp:48 Web::Layout::AvailableSpace::to_string.
pub func layout_available_space_to_string(this: const LayoutAvailableSpace*) -> ak.String:
    let width = layout_available_size_to_string(&this.width)
    let height = layout_available_size_to_string(&this.height)
    return css_string_formatted("{} x {}", [css_arg_string(&width), css_arg_string(&height)])
