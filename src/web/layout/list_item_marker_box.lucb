## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:17 Web::Layout::ListItemMarkerBox::ListItemMarkerBox.
pub func layout_list_item_marker_box_construct(this: LayoutListItemMarkerBox*, document: DomDocument*, style_type: CssListStyleType, style_position: css_data.ListStylePosition, list_item_element: DomElement*, style: CssComputedProperties*):
    layout_list_item_marker_box_init_fields(this)
    layout_box_construct_css_computed_properties(this.layout_box(), document, none, style)
    this.m_list_style_type = style_type
    this.m_list_style_position = style_position
    this.m_list_item_element = list_item_element

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:27 Web::Layout::ListItemMarkerBox::counter_style_is_rendered_with_custom_image.
pub func layout_list_item_marker_box_counter_style_is_rendered_with_custom_image(counter_style: CssCounterStyle*?) -> bool:
    # https://drafts.csswg.org/css-counter-styles-3/#simple-symbolic
    # When used in list-style-type, a UA may instead render these styles using a UA-generated image or a UA-chosen font
    # instead of rendering the specified character in the element’s own font. If using an image, it must look similar
    # to the character, and must be sized to attractively fill a 1em by 1em square.

    let style = counter_style else return false

    let counter_style_name = css_counter_style_name(style)

    return ak.fly_string_eq_string_view(&counter_style_name, ak.sv("square")) or ak.fly_string_eq_string_view(&counter_style_name, ak.sv("circle")) or ak.fly_string_eq_string_view(&counter_style_name, ak.sv("disc")) or ak.fly_string_eq_string_view(&counter_style_name, ak.sv("disclosure-closed")) or ak.fly_string_eq_string_view(&counter_style_name, ak.sv("disclosure-open"))

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:42 Web::Layout::ListItemMarkerBox::text.
pub func layout_list_item_marker_box_text(this: LayoutListItemMarkerBox*) -> ak.String?:
    # https://drafts.csswg.org/css-lists-3/#text-markers
    let index = dom_element_ordinal_value(this.m_list_item_element)

    match this.m_list_style_type:
        .empty:
            # none
            # The element has no marker string.
            return none
        .css_counter_style(counter_style):
            # <counter-style>
            # Specifies the element’s marker string as the value of the list-item counter represented using the
            # specified <counter-style>. Specifically, the marker string is the result of generating a counter
            # representation of the list-item counter value using the specified <counter-style>, prefixed by the prefix
            # of the <counter-style>, and followed by the suffix of the <counter-style>. If the specified
            # <counter-style> does not exist, decimal is assumed.
            if layout_list_item_marker_box_counter_style_is_rendered_with_custom_image(counter_style):
                return none

            # NB: Fallback to decimal if the counter style does not exist is handled within generate_a_counter_representation()
            var abstract_element = dom_element_abstract_element(this.m_list_item_element)
            let counter_representation = css_generate_a_counter_representation(counter_style, dom_abstract_element_style_scope(&abstract_element), index)

            var builder = ak.string_builder_new()
            if counter_style == none:
                ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&counter_representation))
                ak.string_builder_append(&builder, ". ")
                return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")

            let style = counter_style else trap("unreachable: a counter style")
            let prefix = css_counter_style_prefix(style)
            let suffix = css_counter_style_suffix(style)
            ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&prefix))
            ak.string_builder_append_string_view(&builder, ak.string_bytes_as_string_view(&counter_representation))
            ak.string_builder_append_string_view(&builder, ak.fly_string_bytes_as_string_view(&suffix))
            return ak.string_builder_to_string(&builder) else trap("MUST: String::formatted")
        .string(string):
            # <string>
            # The element’s marker string is the specified <string>.
            return string

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:78 Web::Layout::ListItemMarkerBox::create_paintable (override).
pub func layout_list_item_marker_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_marker_paintable_create((LayoutListItemMarkerBox*)base).paint_paintable()

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:83 Web::Layout::ListItemMarkerBox::relative_size.
pub func layout_list_item_marker_box_relative_size(this: LayoutListItemMarkerBox*) -> gfx.CssPixels:
    let has_list_style_type = match this.m_list_style_type:
        .empty => false
        _ => true
    assert(has_list_style_type)

    let font_size = web_fonts.font_pixel_size(layout_node_first_available_font(this.layout_node()))
    let marker_text = layout_list_item_marker_box_text(this)
    if marker_text != none:
        return gfx.css_pixels_nearest_value_for_f32(font_size)

    # https://drafts.csswg.org/css-counter-styles-3/#simple-symbolic
    # NB: The spec allows us to render some predefined symbol counter styles using a UA-generated image instead of
    #     text, it instructs us to size these in order to attractively fit within a 1em x 1em square. We mimic Firefox
    #     and generally use a size of 0.35em, except for disclosure open/closed styles which use a size of 0.5em.
    let marker_image_size_factor: f32 = 0.35f32
    let disclosure_marker_image_size_factor: f32 = 0.5f32

    let counter_style = match this.m_list_style_type:
        .css_counter_style(value) => value
        _ => trap("VERIFY: a counter style")

    let style = counter_style else trap("VERIFY: counter_style")

    let name = css_counter_style_name(style)
    if ak.fly_string_eq_string_view(&name, ak.sv("square")) or ak.fly_string_eq_string_view(&name, ak.sv("circle")) or ak.fly_string_eq_string_view(&name, ak.sv("disc")):
        return gfx.css_pixels_nearest_value_for_f32((f32)math.ceil((f64)(font_size * marker_image_size_factor)))

    if ak.fly_string_eq_string_view(&name, ak.sv("disclosure-closed")) or ak.fly_string_eq_string_view(&name, ak.sv("disclosure-open")):
        return gfx.css_pixels_nearest_value_for_f32((f32)math.ceil((f64)(font_size * disclosure_marker_image_size_factor)))

    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.cpp:112 Web::Layout::ListItemMarkerBox::visit_edges (override).
pub func layout_list_item_marker_box_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (LayoutListItemMarkerBox*)base
    layout_box_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t_2(visitor, this.m_list_item_element)

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.h:29 Web::Layout::ListItemMarkerBox::list_style_type.
pub func layout_list_item_marker_box_list_style_type(this: LayoutListItemMarkerBox*) -> CssListStyleType:
    return this.m_list_style_type

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.h:30 Web::Layout::ListItemMarkerBox::list_style_position.
pub func layout_list_item_marker_box_list_style_position(this: LayoutListItemMarkerBox*) -> css_data.ListStylePosition:
    return this.m_list_style_position

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.h:37 Web::Layout::ListItemMarkerBox::is_list_item_marker_box (override).
pub func layout_list_item_marker_box_is_list_item_marker_box_impl(base: LayoutNode*) -> bool:
    discard(base)
    return true

## Ported from Libraries/LibWeb/Layout/ListItemMarkerBox.h:38 Web::Layout::ListItemMarkerBox::can_have_children (override).
pub func layout_list_item_marker_box_can_have_children_impl(base: LayoutNode*) -> bool:
    discard(base)
    return false
