#   list_item_marker_box - Layout::ListItemMarkerBox: the ::marker box of a list item
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/ListItemMarkerBox.cpp (lines 1-118) and ListItemMarkerBox.h: the
#       constructor, the marker string (the list-item counter in the marker's counter style),
