# mark: BlockMarginState ========================================================================

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:157 Web::Layout::BlockFormattingContext::BlockMarginState::add_margin.
pub func layout_block_formatting_context_block_margin_state_add_margin(this: LayoutBlockFormattingContextBlockMarginState*, margin: gfx.CssPixels):
    if margin.lt(layout_zero_px()):
        this.m_current_negative_collapsible_margin = ak.min(margin, this.m_current_negative_collapsible_margin)
    else:
        this.m_current_positive_collapsible_margin = ak.max(margin, this.m_current_positive_collapsible_margin)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:166 Web::Layout::BlockFormattingContext::BlockMarginState::register_block_container_y_position_update_callback.
pub func layout_block_formatting_context_block_margin_state_register_block_container_y_position_update_callback(this: LayoutBlockFormattingContextBlockMarginState*, callback: ak.Function1[gfx.CssPixels, unit]):
    this.m_block_container_y_position_update_callback = callback

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:171 Web::Layout::BlockFormattingContext::BlockMarginState::unregister_block_container_y_position_update_callback.
pub func layout_block_formatting_context_block_margin_state_unregister_block_container_y_position_update_callback(this: LayoutBlockFormattingContextBlockMarginState*):
    this.m_block_container_y_position_update_callback = ak.Function1[gfx.CssPixels, unit](call = none, context = none)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:176 Web::Layout::BlockFormattingContext::BlockMarginState::current_collapsed_margin.
pub func layout_block_formatting_context_block_margin_state_current_collapsed_margin(this: const LayoutBlockFormattingContextBlockMarginState*) -> gfx.CssPixels:
    return this.m_current_positive_collapsible_margin.add(this.m_current_negative_collapsible_margin)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:181 Web::Layout::BlockFormattingContext::BlockMarginState::has_block_container_waiting_for_final_y_position.
pub func layout_block_formatting_context_block_margin_state_has_block_container_waiting_for_final_y_position(this: const LayoutBlockFormattingContextBlockMarginState*) -> bool:
    return this.m_block_container_y_position_update_callback.call != none

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:186 Web::Layout::BlockFormattingContext::BlockMarginState::update_block_waiting_for_final_y_position.
pub func layout_block_formatting_context_block_margin_state_update_block_waiting_for_final_y_position(this: const LayoutBlockFormattingContextBlockMarginState*):
    if let call = this.m_block_container_y_position_update_callback.call:
        let collapsed_margin = layout_block_formatting_context_block_margin_state_current_collapsed_margin(this)
        call(this.m_block_container_y_position_update_callback.context, collapsed_margin)

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:194 Web::Layout::BlockFormattingContext::BlockMarginState::reset.
pub func layout_block_formatting_context_block_margin_state_reset(this: LayoutBlockFormattingContextBlockMarginState*):
    this.m_block_container_y_position_update_callback = ak.Function1[gfx.CssPixels, unit](call = none, context = none)
    this.m_current_negative_collapsible_margin = layout_zero_px()
    this.m_current_positive_collapsible_margin = layout_zero_px()

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:201 Web::Layout::BlockFormattingContext::BlockMarginState::box_last_in_flow_child_margin_bottom_collapsed.
pub func layout_block_formatting_context_block_margin_state_box_last_in_flow_child_margin_bottom_collapsed(this: const LayoutBlockFormattingContextBlockMarginState*) -> bool:
    return this.m_box_last_in_flow_child_margin_bottom_collapsed

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:202 Web::Layout::BlockFormattingContext::BlockMarginState::set_box_last_in_flow_child_margin_bottom_collapsed.
pub func layout_block_formatting_context_block_margin_state_set_box_last_in_flow_child_margin_bottom_collapsed(this: LayoutBlockFormattingContextBlockMarginState*, v: bool):
    this.m_box_last_in_flow_child_margin_bottom_collapsed = v

# mark: FloatSideData and the header's members ==================================================

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:148 Web::Layout::BlockFormattingContext::FloatSideData::clear.
pub func layout_block_formatting_context_float_side_data_clear(this: LayoutBlockFormattingContextFloatSideData*):
    ak.vector_clear(&this.current_boxes)
    this.current_width = layout_zero_px()

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:29 Web::Layout::BlockFormattingContext::left_side_floats.
pub func layout_block_formatting_context_left_side_floats(this: LayoutBlockFormattingContext*) -> const LayoutBlockFormattingContextFloatSideData*:
    return &this.m_left_floats

## Ported from Libraries/LibWeb/Layout/BlockFormattingContext.h:30 Web::Layout::BlockFormattingContext::right_side_floats.
pub func layout_block_formatting_context_right_side_floats(this: LayoutBlockFormattingContext*) -> const LayoutBlockFormattingContextFloatSideData*:
