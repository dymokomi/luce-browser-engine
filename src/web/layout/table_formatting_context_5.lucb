## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1987 Web::Layout::TableFormattingContext::table_rows_or_columns<Column>.
func layout_table_formatting_context_table_rows_or_columns_column(this: LayoutTableFormattingContext*) -> ak.Vector[LayoutTableFormattingContextColumn]*:
    return &this.m_columns

## `table_rows_or_columns<RowOrColumn>().size()`.
func layout_table_formatting_context_table_rows_or_columns_size(this: LayoutTableFormattingContext*, dimension: LayoutTableDimension) -> usize:
    if dimension == LayoutTableDimension.row:
        return ak.vector_size(layout_table_formatting_context_table_rows_or_columns_row(this))
    return ak.vector_size(layout_table_formatting_context_table_rows_or_columns_column(this))

## `table_rows_or_columns<RowOrColumn>()[index]`: the members of the row or column the templates use.
func layout_table_formatting_context_table_row_or_column(this: LayoutTableFormattingContext*, dimension: LayoutTableDimension, index: usize) -> LayoutTableFormattingContextRowOrColumn:
    if dimension == LayoutTableDimension.row:
        let row = ak.vector_at(layout_table_formatting_context_table_rows_or_columns_row(this), index)
        return LayoutTableFormattingContextRowOrColumn(min_size = &row.min_size, max_size = &row.max_size, has_intrinsic_percentage = &row.has_intrinsic_percentage, intrinsic_percentage = &row.intrinsic_percentage)
    let column = ak.vector_at(layout_table_formatting_context_table_rows_or_columns_column(this), index)
    return LayoutTableFormattingContextRowOrColumn(min_size = &column.min_size, max_size = &column.max_size, has_intrinsic_percentage = &column.has_intrinsic_percentage, intrinsic_percentage = &column.intrinsic_percentage)
