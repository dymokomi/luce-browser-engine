#==============================================================================================
#
#   table_formatting_context_5 - Layout::TableFormattingContext: running the table layout, and
#                                the row-or-column accessors of the measures
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/TableFormattingContext.cpp (lines 1704-1992): the table layout up
#       to the table width (which the table wrapper's width also asks for), placing the
#       absolutely positioned descendants once the parent has dimensioned the table, `run` (the
#       captions, the columns' widths, the rows' heights and the positions), the automatic
#       content sizes, the specializations of the direction-agnostic accessors for rows and
#       columns, the border spacing, and the static position of a table's descendants.
#
#       The templates over RowOrColumn take a LayoutTableDimension (see
#       table_formatting_context_1): `X<Row>` is `X_row`, `X<Column>` is `X_column`, and `X`
#       chooses between them.
#
#       Copyright (c) 2020, Andreas Kling <andreas@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Running the layout ======================================================================

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1704 Web::Layout::TableFormattingContext::run_until_width_calculation.
pub func layout_table_formatting_context_run_until_width_calculation(this: LayoutTableFormattingContext*, available_space: LayoutAvailableSpace):
    this.m_available_space = available_space

    # Determine the number of rows/columns the table requires.
    let table_grid = layout_table_grid_calculate_row_column_grid_vector(layout_formatting_context_context_box(this.layout_formatting_context()), &this.m_cells, &this.m_rows)
    layout_table_formatting_context_finish_grid_initialization(this, &table_grid)

    layout_table_formatting_context_border_conflict_resolution(this)

    # Compute the minimum width of each column.
    layout_table_formatting_context_compute_cell_measures(this)
    layout_table_formatting_context_compute_outer_content_sizes(this)
    layout_table_formatting_context_compute_table_measures(this, LayoutTableDimension.column)

    # https://www.w3.org/TR/css-tables-3/#row-layout
    # Since during row layout the specified heights of cells in the row were ignored and cells that were spanning more than one rows
    # have not been sized correctly, their height will need to be eventually distributed to the set of rows they spanned. This is done
    # by running the same algorithm as the column measurement, with the span=1 value being initialized (for min-content) with the largest
    # of the resulting height of the previous row layout, the height specified on the corresponding table-row (if any), and the largest
    # height specified on cells that span this row only (the algorithm starts by considering cells of span 2 on top of that assignment).
    layout_table_formatting_context_compute_table_measures(this, LayoutTableDimension.row)

    # Compute the width of the table.
    layout_table_formatting_context_compute_table_width(this)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1730 Web::Layout::TableFormattingContext::parent_context_did_dimension_child_root_box (override).
pub func layout_table_formatting_context_parent_context_did_dimension_child_root_box_impl(base: LayoutFormattingContext*):
    let this = (LayoutTableFormattingContext*)base
    if base.m_layout_mode != LayoutMode.normal:
        return

    # context_box().for_each_in_subtree_of_type<Box const>(...)
    var descendants = layout_node_subtree(layout_formatting_context_context_box(base).layout_node()).iterator()
    while let node = descendants.next():
        let box = as_if_layout_box(node) else continue
        if layout_node_is_absolutely_positioned(box.layout_node()):
            # FIXME: calculate_static_position_rect() is not aware of how to correctly calculate static position for
            #        a box nested inside a table, but we need to set some value, so layout_absolutely_positioned_element()
            #        won't crash trying to access it.
            layout_state_used_values_set_static_position_rect(layout_state_get_mutable(base.m_state, box.layout_node_with_style()), layout_table_formatting_context_calculate_static_position_rect(this, box))

        if layout_formatting_context_formatting_context_type_created_by_box(box) != none:
            descendants.skip_children()

    layout_formatting_context_layout_absolutely_positioned_children(base)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1753 Web::Layout::TableFormattingContext::run (override).
pub func layout_table_formatting_context_run_impl(base: LayoutFormattingContext*, available_space: LayoutAvailableSpace):
    let this = (LayoutTableFormattingContext*)base
    let state = base.m_state
    let table_box = layout_table_formatting_context_table_box(this)
    # FORMATTING_CONTEXT_TRACE() traces only in LIBWEB_LAYOUT_DEBUG builds.
    this.m_available_space = available_space

    layout_table_formatting_context_run_until_width_calculation(this, available_space)

    if layout_available_size_is_intrinsic_sizing_constraint(&available_space.width) and not layout_available_size_is_intrinsic_sizing_constraint(&available_space.height):
        return

    let table_state = layout_state_get(state, table_box.layout_node_with_style())
    let caption_available_space = LayoutAvailableSpace(
        width = layout_available_size_make_definite(layout_clamp_to_max_dimension_value(layout_state_used_values_border_box_width(table_state))),
        height = available_space.height,
    )

    var total_captions_height = layout_table_formatting_context_run_caption_layout(this, css_data.CaptionSide.top, caption_available_space)

    # Distribute the width of the table among columns.
    layout_table_formatting_context_distribute_width_to_columns(this)

    layout_table_formatting_context_compute_table_height(this)

    layout_table_formatting_context_distribute_height_to_rows(this)

    layout_table_formatting_context_position_row_boxes(this)
    layout_table_formatting_context_position_cell_boxes(this)

    layout_state_used_values_set_content_height(layout_state_get_mutable(state, table_box.layout_node_with_style()), this.m_table_height)

    total_captions_height = total_captions_height.add(layout_table_formatting_context_run_caption_layout(this, css_data.CaptionSide.bottom, caption_available_space))

    # Table captions are positioned between the table margins and its borders (outside the grid box borders) as described in
    # https://www.w3.org/TR/css-tables-3/#bounding-box-assignment
    # A visual representation of this model can be found at https://www.w3.org/TR/css-tables-3/images/table_container.png
    let table_box_state = layout_state_get_mutable(state, table_box.layout_node_with_style())
    table_box_state.margin_bottom = table_box_state.margin_bottom.add(total_captions_height)

    this.m_automatic_content_height = this.m_table_height

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1793 Web::Layout::TableFormattingContext::automatic_content_width (override).
pub func layout_table_formatting_context_automatic_content_width_impl(base: LayoutFormattingContext*) -> gfx.CssPixels:
    let this = (LayoutTableFormattingContext*)base
    return layout_state_used_values_content_width(layout_state_get(base.m_state, layout_table_formatting_context_table_box(this).layout_node_with_style()))

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1798 Web::Layout::TableFormattingContext::automatic_content_height (override).
pub func layout_table_formatting_context_automatic_content_height_impl(base: LayoutFormattingContext*) -> gfx.CssPixels:
    let this = (LayoutTableFormattingContext*)base
    return this.m_automatic_content_height

