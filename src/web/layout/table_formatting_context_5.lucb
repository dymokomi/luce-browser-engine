## `cell_has_intrinsic_percentage<RowOrColumn>(cell)`.
func layout_table_formatting_context_cell_has_intrinsic_percentage(dimension: LayoutTableDimension, cell: const LayoutTableGridCell*) -> bool:
    if dimension == LayoutTableDimension.row:
