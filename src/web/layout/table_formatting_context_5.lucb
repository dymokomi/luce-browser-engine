## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1852 Web::Layout::TableFormattingContext::cell_percentage_contribution<Row>.
func layout_table_formatting_context_cell_percentage_contribution_row(cell: const LayoutTableGridCell*) -> f64:
    # Definition of percentage contribution: https://www.w3.org/TR/css-tables-3/#percentage-contribution
    let computed_values = layout_box_computed(cell.box)
    let max_height = css_computed_values_max_height(computed_values)
    let height = css_computed_values_height(computed_values)
    let max_height_percentage = layout_table_formatting_context_percentage_value(&max_height) if css_size_is_percentage(&max_height) else math.infinity
    let height_percentage = layout_table_formatting_context_percentage_value(&height) if css_size_is_percentage(&height) else 0.0
    return ak.min_f64(height_percentage, max_height_percentage)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1862 Web::Layout::TableFormattingContext::cell_percentage_contribution<Column>.
func layout_table_formatting_context_cell_percentage_contribution_column(cell: const LayoutTableGridCell*) -> f64:
    # Definition of percentage contribution: https://www.w3.org/TR/css-tables-3/#percentage-contribution
    let computed_values = layout_box_computed(cell.box)
    let max_width = css_computed_values_max_width(computed_values)
    let width = css_computed_values_width(computed_values)
    let max_width_percentage = layout_table_formatting_context_percentage_value(&max_width) if css_size_is_percentage(&max_width) else math.infinity
    let width_percentage = layout_table_formatting_context_percentage_value(&width) if css_size_is_percentage(&width) else 0.0
    return ak.min_f64(width_percentage, max_width_percentage)

## `cell_percentage_contribution<RowOrColumn>(cell)`.
func layout_table_formatting_context_cell_percentage_contribution(dimension: LayoutTableDimension, cell: const LayoutTableGridCell*) -> f64:
    if dimension == LayoutTableDimension.row:
        return layout_table_formatting_context_cell_percentage_contribution_row(cell)
    return layout_table_formatting_context_cell_percentage_contribution_column(cell)

