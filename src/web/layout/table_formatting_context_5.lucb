    return layout_table_formatting_context_cell_has_intrinsic_percentage_column(cell)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1884 Web::Layout::TableFormattingContext::initialize_intrinsic_percentages_from_rows_or_columns<Row>.
func layout_table_formatting_context_initialize_intrinsic_percentages_from_rows_or_columns_row(this: LayoutTableFormattingContext*):
    for row in &ak.vector_span(&this.m_rows):
        let computed_values = layout_box_computed(row.box)
        # Definition of percentage contribution: https://www.w3.org/TR/css-tables-3/#percentage-contribution
        let max_height = css_computed_values_max_height(computed_values)
        let height = css_computed_values_height(computed_values)
        let max_height_percentage = layout_table_formatting_context_percentage_value(&max_height) if css_size_is_percentage(&max_height) else math.infinity
        let height_percentage = layout_table_formatting_context_percentage_value(&height) if css_size_is_percentage(&height) else 0.0
        row.has_intrinsic_percentage = css_size_is_percentage(&max_height) or css_size_is_percentage(&height)
        row.intrinsic_percentage = ak.min_f64(height_percentage, max_height_percentage)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1897 Web::Layout::TableFormattingContext::initialize_intrinsic_percentages_from_rows_or_columns<Column>.
func layout_table_formatting_context_initialize_intrinsic_percentages_from_rows_or_columns_column(this: LayoutTableFormattingContext*):
    var column_index: usize = 0
    for column_group_box in layout_table_grid_child_boxes_matching(layout_table_formatting_context_table_box(this), layout_is_table_column_group):
        for column_box in layout_table_grid_child_boxes_matching(column_group_box, layout_is_table_column_layout_box):
            let computed_values = layout_box_computed(column_box)
            # Definition of percentage contribution: https://www.w3.org/TR/css-tables-3/#percentage-contribution
            let max_width = css_computed_values_max_width(computed_values)
            let width = css_computed_values_width(computed_values)
            let max_width_percentage = layout_table_formatting_context_percentage_value(&max_width) if css_size_is_percentage(&max_width) else math.infinity
            let width_percentage = layout_table_formatting_context_percentage_value(&width) if css_size_is_percentage(&width) else 0.0
            ak.vector_at(&this.m_columns, column_index).has_intrinsic_percentage = css_size_is_percentage(&max_width) or css_size_is_percentage(&width)
            ak.vector_at(&this.m_columns, column_index).intrinsic_percentage = ak.min_f64(width_percentage, max_width_percentage)
            let span = layout_table_formatting_context_column_span_attribute(column_box.layout_node())
            column_index += span

## `initialize_intrinsic_percentages_from_rows_or_columns<RowOrColumn>()`.
func layout_table_formatting_context_initialize_intrinsic_percentages_from_rows_or_columns(this: LayoutTableFormattingContext*, dimension: LayoutTableDimension):
    if dimension == LayoutTableDimension.row:
        layout_table_formatting_context_initialize_intrinsic_percentages_from_rows_or_columns_row(this)
    else:
        layout_table_formatting_context_initialize_intrinsic_percentages_from_rows_or_columns_column(this)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1916 Web::Layout::TableFormattingContext::initialize_intrinsic_percentages_from_cells.
func layout_table_formatting_context_initialize_intrinsic_percentages_from_cells(this: LayoutTableFormattingContext*, dimension: LayoutTableDimension):
    for cell in &ak.vector_span(&this.m_cells):
        let cell_span_value = layout_table_formatting_context_cell_span(dimension, cell)
        let cell_start_rc_index = layout_table_formatting_context_cell_index(dimension, cell)
        let cell_end_rc_index = cell_start_rc_index + cell_span_value
        if layout_table_formatting_context_cell_has_intrinsic_percentage(dimension, cell):
            for rc_index in cell_start_rc_index..<cell_end_rc_index:
                *layout_table_formatting_context_table_row_or_column(this, dimension, rc_index).has_intrinsic_percentage = true
            if cell_span_value != 1:
                continue
        else:
            continue
        let rc_index = layout_table_formatting_context_cell_index(dimension, cell)
        let row_or_column = layout_table_formatting_context_table_row_or_column(this, dimension, rc_index)
        *row_or_column.has_intrinsic_percentage = true
        *row_or_column.intrinsic_percentage = ak.max_f64(layout_table_formatting_context_cell_percentage_contribution(dimension, cell), *row_or_column.intrinsic_percentage)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1941 Web::Layout::TableFormattingContext::border_spacing<Row>.
func layout_table_formatting_context_border_spacing_row(this: LayoutTableFormattingContext*) -> gfx.CssPixels:
    return layout_table_formatting_context_border_spacing_vertical(this)

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1947 Web::Layout::TableFormattingContext::border_spacing<Column>.
func layout_table_formatting_context_border_spacing_column(this: LayoutTableFormattingContext*) -> gfx.CssPixels:
    return layout_table_formatting_context_border_spacing_horizontal(this)

## `border_spacing<RowOrColumn>()`.
func layout_table_formatting_context_border_spacing(this: LayoutTableFormattingContext*, dimension: LayoutTableDimension) -> gfx.CssPixels:
    if dimension == LayoutTableDimension.row:
        return layout_table_formatting_context_border_spacing_row(this)
    return layout_table_formatting_context_border_spacing_column(this)

# mark: Border spacing and static positions =====================================================

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1952 Web::Layout::TableFormattingContext::border_spacing_horizontal.
func layout_table_formatting_context_border_spacing_horizontal(this: LayoutTableFormattingContext*) -> gfx.CssPixels:
    let table_box = layout_table_formatting_context_table_box(this)
    let computed_values = layout_box_computed(table_box)
    # When a table is laid out in collapsed-borders mode, the border-spacing of the table-root is ignored (as if it was set to 0px):
    # https://www.w3.org/TR/css-tables-3/#collapsed-style-overrides
    if css_computed_values_border_collapse(computed_values) == css_data.BorderCollapse.collapse:
        return layout_zero_px()
    let border_spacing_horizontal = css_computed_values_border_spacing_horizontal(computed_values)
    return css_length_to_px_layout_node(&border_spacing_horizontal, table_box.layout_node())

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1962 Web::Layout::TableFormattingContext::border_spacing_vertical.
func layout_table_formatting_context_border_spacing_vertical(this: LayoutTableFormattingContext*) -> gfx.CssPixels:
    let table_box = layout_table_formatting_context_table_box(this)
    let computed_values = layout_box_computed(table_box)
    # When a table is laid out in collapsed-borders mode, the border-spacing of the table-root is ignored (as if it was set to 0px):
    # https://www.w3.org/TR/css-tables-3/#collapsed-style-overrides
    if css_computed_values_border_collapse(computed_values) == css_data.BorderCollapse.collapse:
        return layout_zero_px()
    let border_spacing_vertical = css_computed_values_border_spacing_vertical(computed_values)
    return css_length_to_px_layout_node(&border_spacing_vertical, table_box.layout_node())

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1972 Web::Layout::TableFormattingContext::calculate_static_position_rect.
pub func layout_table_formatting_context_calculate_static_position_rect(this: LayoutTableFormattingContext*, box: LayoutBox*) -> LayoutStaticPositionRect:
    _ = this
    _ = box
    # FIXME: Implement static position calculation for table descendants instead of always returning a rectangle with zero position and size.
    var static_position = LayoutStaticPositionRect()
    static_position.rect = gfx.CssPixelRect(gfx.CssPixelPoint(layout_zero_px(), layout_zero_px()), gfx.CssPixelSize(layout_zero_px(), layout_zero_px()))
    return static_position

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1981 Web::Layout::TableFormattingContext::table_rows_or_columns<Row>.
func layout_table_formatting_context_table_rows_or_columns_row(this: LayoutTableFormattingContext*) -> ak.Vector[LayoutTableGridRow]*:
