    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n<div class=\"grid-container\"><div class=\"grid-item a\">1</div><div class=\"grid-item b\">2</div><div class=\"grid-item c\">3</div><div class=\"grid-item d\">4</div></div>", css = "\n    * {\n        border: 1px solid black;\n    }\n\n    .grid-container {\n        display: grid;\n        grid-template-columns: [main-start] 1fr [content-start] 1fr [content-end] 1fr [main-end];\n        grid-template-rows: [main-start] 25px [content-start] 25px [content-end] 25px [main-end];\n    }\n\n    .grid-item {\n        background-color: palevioletred;\n    }\n\n    .a {\n        grid-column-start: main-start;\n        grid-row-start: main-start;\n        grid-row-end: main-end;\n    }\n\n    .b {\n        grid-column-start: content-end;\n        grid-row-start: main-start;\n        grid-row-end: content-end;\n    }\n\n    .c {\n        grid-column-start: content-start;\n        grid-row-start: main-start;\n    }\n\n    .d {\n        grid-column-start: content-start;\n        grid-column-end: main-end;\n        grid-row-start: content-end;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 95 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 77 0+1+8] children: not-inline\n        Box <div.grid-container> at [11,11] [0+1+0 778 0+1+0] [0+1+0 75 0+1+0] [GFC] children: not-inline\n          BlockContainer <div.grid-item.a> at [12,12] [0+1+0 257.328125 0+1+0] [0+1+0 73 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [12,12 6.34375x18] baseline: 13.796875\n                \"1\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.grid-item.b> at [530.65625,12] [0+1+0 257.328125 0+1+0] [0+1+0 48 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [530.65625,12 8.8125x18] baseline: 13.796875\n                \"2\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.grid-item.c> at [271.328125,12] [0+1+0 257.328125 0+1+0] [0+1+0 23 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [271.328125,12 9.09375x18] baseline: 13.796875\n                \"3\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.grid-item.d> at [271.328125,62] [0+1+0 516.65625 0+1+0] [0+1+0 23 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [271.328125,62 7.75x18] baseline: 13.796875\n                \"4\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x97]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x79]\n        PaintableBox (Box<DIV>.grid-container) [10,10 780x77]\n          PaintableWithLines (BlockContainer<DIV>.grid-item.a) [11,11 259.328125x75]\n            TextPaintable (TextNode<#text>)\n          PaintableWithLines (BlockContainer<DIV>.grid-item.b) [529.65625,11 259.328125x50]\n            TextPaintable (TextNode<#text>)\n          PaintableWithLines (BlockContainer<DIV>.grid-item.c) [270.328125,11 259.328125x25]\n            TextPaintable (TextNode<#text>)\n          PaintableWithLines (BlockContainer<DIV>.grid-item.d) [270.328125,61 518.65625x25]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x95] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n<div class=\"grid-container\"><div class=\"a\">1</div><div>2</div><div>3</div><div>4</div></div>", css = "\n    * {\n        border: 1px solid black;\n    }\n\n    .grid-container {\n        display: grid;\n        grid-template-columns: repeat(2, [name1] 50px [name2] 100px);\n    }\n\n    .a {\n        grid-column-start: name2\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 60 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 42 0+1+8] children: not-inline\n        Box <div.grid-container> at [11,11] [0+1+0 778 0+1+0] [0+1+0 40 0+1+0] [GFC] children: not-inline\n          BlockContainer <div.a> at [62,12] [0+1+0 98 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [62,12 6.34375x18] baseline: 13.796875\n                \"1\"\n            TextNode <#text> (not painted)\n          BlockContainer <div> at [162,12] [0+1+0 48 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [162,12 8.8125x18] baseline: 13.796875\n                \"2\"\n            TextNode <#text> (not painted)\n          BlockContainer <div> at [212,12] [0+1+0 98 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [212,12 9.09375x18] baseline: 13.796875\n                \"3\"\n            TextNode <#text> (not painted)\n          BlockContainer <div> at [12,32] [0+1+0 48 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [12,32 7.75x18] baseline: 13.796875\n                \"4\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0