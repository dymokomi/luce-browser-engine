    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><body><main><div id=\"item\">Smartphones\n", css = "                    \n    * {    \n        outline: 1px solid black;    \n    }        \n    html {       \n        background: white;    \n    }      \n    body {      \n        display: grid;    \n        grid-template-columns: 1fr [content-start] 500px [content-end] 1fr;    \n        background: wheat;      \n    }      \n    main {    \n        grid-column: content;      \n        background: pink;\n    }        \n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 34 0+0+0] [BFC] children: not-inline\n      Box <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 18 0+0+8] [GFC] children: not-inline\n        BlockContainer <main> at [150,8] [0+0+0 500 0+0+0] [0+0+0 18 0+0+0] [BFC] children: not-inline\n          BlockContainer <div#item> at [150,8] [0+0+0 500 0+0+0] [0+0+0 18 0+0+0] children: inline\n            frag 0 from TextNode start: 0, length: 11, rect: [150,8 105.953125x18] baseline: 13.796875\n                \"Smartphones\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x34]\n      PaintableBox (Box<BODY>) [8,8 784x18]\n        PaintableWithLines (BlockContainer<MAIN>) [150,8 500x18]\n          PaintableWithLines (BlockContainer<DIV>#item) [150,8 500x18]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x34] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n\n<!-- Should render a 2x2 grid with columns 50px and 50% -->\n<div class=\"grid-container\" style=\"\n    grid-template-columns: 50px 50%; \n    grid-template-rows: auto auto;\">\n  <div class=\"grid-item\" style=\"grid-column: 1 / 1; grid-row: 1 / 1\">1</div>\n  <div class=\"grid-item\" style=\"grid-column: 2 / 2; grid-row: 1 / 1\">2</div>\n  <div class=\"grid-item\" style=\"grid-column: 1 / 1; grid-row: 2 / 2\">3</div>\n  <div class=\"grid-item\" style=\"grid-column: 2 / 2; grid-row: 2 / 2\">4</div>\n</div>", css = "\n  .grid-container {\n    display: grid;\n    background-color: lightsalmon;\n  }\n\n  .grid-item {\n    background-color: lightblue;\n  }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 52 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 36 0+0+8] children: not-inline\n        Box <div.grid-container> at [8,8] [0+0+0 784 0+0+0] [0+0+0 36 0+0+0] [GFC] children: not-inline\n          BlockContainer <(anonymous)> (not painted) [BFC] children: inline\n            TextNode <#text> (not painted)\n          BlockContainer <div.grid-item> at [8,8] [0+0+0 50 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [8,8 6.34375x18] baseline: 13.796875\n                \"1\"\n            TextNode <#text> (not painted)\n          BlockContainer <(anonymous)> (not painted) [BFC] children: inline\n            TextNode <#text> (not painted)\n          BlockContainer <div.grid-item> at [58,8] [0+0+0 392 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [58,8 8.8125x18] baseline: 13.796875\n                \"2\"\n            TextNode <#text> (not painted)\n          BlockContainer <(anonymous)> (not painted) [BFC] childr