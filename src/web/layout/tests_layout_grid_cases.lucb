    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=g style=\"width:400px;grid-template-columns:auto auto auto\"><div style=\"grid-column:span 2\">a spanning item with a lot of text inside</div><div>x</div><div>y</div><div style=\"grid-column:2 / span 2\">z spans two</div></div>\n<div class=g style=\"width:400px;grid-template-columns:min-content auto max-content;gap:4px\"><div style=\"grid-column:1 / 4\">spans all three tracks wide wide wide</div><div>a</div><div>b</div><div>c</div></div>\n<div class=g style=\"width:400px;grid-template-columns:50px auto 1fr\"><div style=\"grid-column:1 / span 2\">span fixed and auto with text</div><div style=\"grid-column:2 / span 2\">span auto and flex</div></div>\n<div class=g style=\"width:400px;grid-template-rows:auto auto;grid-auto-flow:column\"><div style=\"grid-row:span 2;height:80px\">tall spanning</div><div>r1</div><div>r2</div></div>\n<div class=g style=\"width:400px;grid-template-columns:fit-content(60px) fit-content(60px)\"><div style=\"grid-column:span 2\">spanning fit-content tracks with long content</div></div>", css = ".g { display: grid; border: 1px solid; margin: 2px; } .g > div { border: 1px solid; }", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 332 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 316 0+0+8] children: not-inline\n        Box <div.g> at [11,9] [2+1+0 400 0+1+380] [2+1+0 58 0+1+2] [GFC] children: not-inline\n          BlockContainer <div> at [12,10] [0+1+0 324.21875 0+1+0] [0+1+0 36 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 34, rect: [12,10 278.421875x18] baseline: 13.796875\n                \"a spanning item with a lot of text\"\n            frag 1 from TextNode start: 35, length: 6, rect: [12,28 44.65625x18] baseline: 13.796875\n                \"inside\"\n       