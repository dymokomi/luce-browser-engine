    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<div class=\"container\"><div class=\"item\">\nLorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus eget turpis eget urna\nfeugiat pretium ut eu ante. Nunc sed pharetra diam, rutrum lacinia tellus.</div></div>", css = "\n.container {\n    display: grid;\n    grid-template-columns: 200px;\n    background-color: pink;\n    float: left;\n}\n\n.item {\n    width: 50%;\n    background-color: palevioletred;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 332 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 0 0+0+8] children: not-inline\n        Box <div.container> at [8,8] floating [0+0+0 200 0+0+0] [0+0+0 324 0+0+0] [GFC] children: not-inline\n          BlockContainer <div.item> at [8,8] [0+0+0 100 0+0+0] [0+0+0 324 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 1, length: 5, rect: [8,8 50.96875x18] baseline: 13.796875\n                \"Lorem\"\n            frag 1 from TextNode start: 7, length: 11, rect: [8,26 94.9375x18] baseline: 13.796875\n                \"ipsum dolor\"\n            frag 2 from TextNode start: 19, length: 9, rect: [8,44 70.9375x18] baseline: 13.796875\n                \"sit amet,\"\n            frag 3 from TextNode start: 29, length: 11, rect: [8,62 96.84375x18] baseline: 13.796875\n                \"consectetur\"\n            frag 4 from TextNode start: 41, length: 10, rect: [8,80 75.71875x18] baseline: 13.796875\n                \"adipiscing\"\n            frag 5 from TextNode start: 52, length: 5, rect: [8,98 28.71875x18] baseline: 13.796875\n                \"elit.\"\n            frag 6 from TextNode start: 58, length: 7, rect: [8,116 65.40625x18] baseline: 13.796875\n                \"Vivamus\"\n            frag 7 from TextNode start: 66, length: 11, rect: [8,134 88.