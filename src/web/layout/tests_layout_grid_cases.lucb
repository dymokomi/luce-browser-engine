    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><head></head><body><div class=\"grid\"><div class=\"a\">a</div><div class=\"b\">b</div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.grid {\n    display: grid;\n    grid-template-rows: 100px 100px 100px;\n    grid-template-columns: 100px 100px 100px;\n    grid-template-areas: \"a a a\" \"a a a\" \"b b b\";\n}\n\n.a {\n    grid-area: a / a / a / a;\n    background-color: red;\n}\n\n.b {\n    grid-area: b / b / b / b;\n    background-color: blueviolet;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 320 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 302 0+1+8] children: not-inline\n        Box <div.grid> at [11,11] [0+1+0 778 0+1+0] [0+1+0 300 0+1+0] [GFC] children: not-inline\n          BlockContainer <div.a> at [12,12] [0+1+0 298 0+1+0] [0+1+0 198 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [12,12 9.34375x18] baseline: 13.796875\n                \"a\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.b> at [12,212] [0+1+0 298 0+1+0] [0+1+0 98 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 1, rect: [12,212 9.46875x18] baseline: 13.796875\n                \"b\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x322]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x304]\n        PaintableBox (Box<DIV>.grid) [10,10 780x302]\n          PaintableWithLines (BlockContainer<DIV>.a) [11,11 300x200]\n            TextPaintable (TextNode<#text>)\n          PaintableWithLines (BlockContainer<DIV>.b) [11,211 300x100]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [c