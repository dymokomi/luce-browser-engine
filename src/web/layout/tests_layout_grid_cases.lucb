    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><html><head></head><body><div class=\"grid\"><div class=\"whee\">whee", css = "\n  * {\n    border: 1px solid black !important;\n  }\n  body {\n    float: left;\n  }\n  .grid {\n    display: grid;\n    grid-template-areas: \"foo whee\";\n    grid-template-columns: min-content minmax(0, auto) min-content;\n  }\n  .whee {\n    grid-area: whee;\n    background: pink;\n  }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 40 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] floating [8+1+0 41.953125 0+1+8] [8+1+0 22 0+1+8] [BFC] children: not-inline\n        Box <div.grid> at [11,11] [0+1+0 39.953125 0+1+0] [0+1+0 20 0+1+0] [GFC] children: not-inline\n          BlockContainer <div.whee> at [12,12] [0+1+0 37.953125 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 4, rect: [12,12 37.953125x18] baseline: 13.796875\n                \"whee\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x42]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 43.953125x24]\n        PaintableBox (Box<DIV>.grid) [10,10 41.953125x22]\n          PaintableWithLines (BlockContainer<DIV>.whee) [11,11 39.953125x20]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x40] [children: 0] (z-index: auto)\n"),
