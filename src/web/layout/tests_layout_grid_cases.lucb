    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"grid\"><div class=\"abspos-item\"></div></div>", css = "\n* {\n    border: 1px solid black;\n}\n\n.grid {\n    display: grid;\n    grid-template-columns: 100px 100px;\n    grid-template-areas: \"a b\";\n    position: relative;\n    width: 200px;\n    height: 100px;\n}\n\n.abspos-item {\n    position: absolute;\n    box-sizing: border-box;\n    padding: 10%;\n    background-color: magenta;\n    background-clip: content-box;\n    top: 0;\n    left: 0;\n    width: 50px;\n    height: 50px;\n    grid-area: b;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 120 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [10,10] [8+1+0 780 0+1+8] [8+1+0 102 0+1+8] children: not-inline\n        Box <div.grid> at [11,11] positioned [0+1+0 200 0+1+578] [0+1+0 100 0+1+0] [GFC] children: not-inline\n          BlockContainer <div.abspos-item> at [122,22] positioned [0+1+10 28 10+1+0] [0+1+10 28 10+1+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x122]\n      PaintableWithLines (BlockContainer<BODY>) [9,9 782x104]\n        PaintableBox (Box<DIV>.grid) [10,10 202x102]\n          PaintableWithLines (BlockContainer<DIV>.abspos-item) [111,11 50x50]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x120] [children: 0] (z-index: auto)\n"),
