    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<div class=\"container\"><div class=\"item\">some-text</div><div class=\"item\">goes-here</div><div class=\"item\">another-text</div><div class=\"item\">goes-there</div></div>", css = "\n.container {\n    float: left;\n    display: grid;\n    background-color: lightsalmon;\n    grid-template-columns: 1fr 1fr;\n}\n\n.item {\n    background-color: lightblue;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 44 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 0 0+0+8] children: not-inline\n        Box <div.container> at [8,8] floating [0+0+0 203.28125 0+0+0] [0+0+0 36 0+0+0] [GFC] children: not-inline\n          BlockContainer <div.item> at [8,8] [0+0+0 101.640625 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 9, rect: [8,8 79.25x18] baseline: 13.796875\n                \"some-text\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.item> at [109.640625,8] [0+0+0 101.640625 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 9, rect: [109.640625,8 78.03125x18] baseline: 13.796875\n                \"goes-here\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.item> at [8,26] [0+0+0 101.640625 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 12, rect: [8,26 101.640625x18] baseline: 13.796875\n                \"another-text\"\n            TextNode <#text> (not painted)\n          BlockContainer <div.item> at [109.640625,26] [0+0+0 101.640625 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n            frag 0 from TextNode start: 0, length: 10, rect: [109.640625,26 84.890625x18] baseline: 13.796875\n                \"goes-there\"\n       