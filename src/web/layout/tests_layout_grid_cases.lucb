    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div class=\"grid\"><div class=\"item\">", css = "\n.grid {\n  display: grid;\n  width: 100px;\n  height: 100px;\n  grid-auto-columns: 0px 100%;\n  grid-auto-rows: 0px 100%;\n  background: red;\n}\n.item {\n  grid-area: area;\n  background: green;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 116 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 100 0+0+8] children: not-inline\n        Box <div.grid> at [8,8] [0+0+0 100 0+0+684] [0+0+0 100 0+0+0] [GFC] children: not-inline\n          BlockContainer <div.item> at [8,8] [0+0+0 100 0+0+0] [0+0+0 100 0+0+0] [BFC] children: not-inline\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x116]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x100]\n        PaintableBox (Box<DIV>.grid) [8,8 100x100]\n          PaintableWithLines (BlockContainer<DIV>.item) [8,8 100x100]\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 800x116] [children: 0] (z-index: auto)\n"),
