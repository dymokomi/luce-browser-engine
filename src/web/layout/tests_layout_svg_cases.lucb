    TestLayoutGeometryCase(mode = "svg", html = "<!DOCTYPE html><svg width=\"200\" height=\"100\" viewBox=\"0 0 100 50\"><g transform=\"translate(10 5)\"><rect x=\"5\" y=\"5\" width=\"20\" height=\"10\" stroke=\"black\" stroke-width=\"2\"/><g transform=\"scale(2 0.5)\"><polygon points=\"16,16 24,16 20,24\"/></g></g><path d=\"M 0 0 L 50 25 H 80 V 40 Z\" shape-rendering=\"crispEdges\"/><line x1=\"0\" y1=\"50\" x2=\"100\" y2=\"0\" stroke=\"red\" shape-rendering=\"optimizeSpeed\"/></svg>", css = "", expected = "  #3 SVGSVGPaintable rect [8,8 200x100]\n  #4 SVGGraphicsPaintable rect [36,26 88x24]\n    transforms viewbox [2 0 0 2 0 0] svg [1 0 0 1 10 5] css [2 0 0 2 20 10]\n    mask none clip none\n    contributes true bounds [38,28 86x20] anti-alias true\n  #5 SVGPathPaintable rect [36,26 44x24]\n    transforms viewbox [2 0 0 2 0 0] svg [1 0 0 1 10 5] css [2 0 0 2 20 10]\n    mask none clip none\n    path M5 5L25 5L25 15L5 15L5 5Z\n    bbox [5,5 20x10]\n    contributes true bounds [38,28 40x20] anti-alias true\n  #6 SVGGraphicsPaintable rect [92,34 32x8]\n    transforms viewbox [2 0 0 2 0 0] svg [2 0 0 0.5 10 5] css [4 0 0 1 20 10]\n    mask none clip none\n    contributes true bounds [92,34 32x8] anti-alias true\n  #7 SVGPathPaintable rect [92,34 32x8]\n    transforms viewbox [2 0 0 2 0 0] svg [2 0 0 0.5 10 5] css [4 0 0 1 20 10]\n    mask none clip none\n    path M16 16L24 16L20 24L16 16Z\n    bbox [16,16 8x8]\n    contributes true bounds [92,34 32x8] anti-alias true\n  #8 SVGPathPaintable rect [8,8 160x80]\n    transforms viewbox [2 0 0 2 0 0] svg [1 0 0 1 0 0] css [2 0 0 2 0 0]\n    mask none clip none\n    path M0 0L50 25L80 25L80 40L0 0Z\n    bbox [0,0 80x40]\n    contributes true bounds [8,8 160x80] anti-alias false\n  #9 SVGPathPaintable rect [7,7 202x102]\n    transforms viewbox [2 0 0 2 0 0] svg [1 0 0 1 0 0] css [2 0 0 2 0 0]\n    mask none clip none\n    path M0 50L100 0\n    bbox [0,0 100x50]\n    contributes true bounds [8,8 200x100] anti-alias false\n"),
