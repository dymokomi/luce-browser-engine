    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><input type=checkbox><input type=checkbox checked style=\"width: 30px; height: 20px\"><input type=radio><input type=radio checked style=\"margin: 10px\"><label><input type=checkbox> label</label>", css = "", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 52 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 36 0+0+8] children: inline\n        frag 0 from CheckBox start: 0, length: 0, rect: [8,27 13x13] baseline: 13\n        frag 1 from CheckBox start: 0, length: 0, rect: [21,20 30x20] baseline: 20\n        frag 2 from RadioButton start: 0, length: 0, rect: [51,28 12x12] baseline: 12\n        frag 3 from RadioButton start: 0, length: 0, rect: [73,18 12x12] baseline: 32\n        CheckBox <input> at [8,27] inline-block [0+0+0 13 0+0+0] [0+0+0 13 0+0+0] children: not-inline\n        CheckBox <input> at [21,20] inline-block [0+0+0 30 0+0+0] [0+0+0 20 0+0+0] children: not-inline\n        RadioButton <input> at [51,28] inline-block [0+0+0 12 0+0+0] [0+0+0 12 0+0+0] children: not-inline\n        RadioButton <input> at [73,18] inline-block [10+0+0 12 0+0+10] [10+0+0 12 0+0+10] children: not-inline\n        InlineNode <label> at [95,27] [0+0+0 57 0+0+0] [0+0+0 18 0+0+0]\n          frag 0 from CheckBox start: 0, length: 0, rect: [95,27 13x13] baseline: 13\n          frag 1 from TextNode start: 0, length: 6, rect: [108,26 44x18] baseline: 13.796875\n              \" label\"\n          CheckBox <input> at [95,27] inline-block [0+0+0 13 0+0+0] [0+0+0 13 0+0+0] children: not-inline\n          TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x52]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x36]\n        CheckBoxPaintable (CheckBox<INPUT>) [8,2