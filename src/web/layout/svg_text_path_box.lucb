## Ported from Libraries/LibWeb/Layout/SVGTextPathBox.cpp:14 Web::Layout::SVGTextPathBox::SVGTextPathBox.
pub func layout_svg_text_path_box_construct(this: LayoutSvgTextPathBox*, document: DomDocument*, element: SvgTextPathElement*, style: CssComputedProperties*):
    layout_svg_graphics_box_construct(this.layout_svg_graphics_box(), document, element.svg_graphics_element(), style)

## Ported from Libraries/LibWeb/Layout/SVGTextPathBox.h:22 Web::Layout::SVGTextPathBox::dom_node.
pub func layout_svg_text_path_box_dom_node(this: LayoutSvgTextPathBox*) -> SvgTextPathElement*:
    return (SvgTextPathElement*)layout_svg_graphics_box_dom_node(this.layout_svg_graphics_box())

## Ported from Libraries/LibWeb/Layout/SVGTextPathBox.h:23 Web::Layout::SVGTextPathBox::dom_node.
pub func layout_svg_text_path_box_dom_node_const(this: LayoutSvgTextPathBox*) -> SvgTextPathElement*:
    return layout_svg_text_path_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/SVGTextPathBox.cpp:19 Web::Layout::SVGTextPathBox::create_paintable (override).
pub func layout_svg_text_path_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_svg_path_paintable_create(((LayoutSvgTextPathBox*)base).layout_svg_graphics_box()).paint_paintable()
