## Ported from Libraries/LibWeb/Layout/SVGGraphicsBox.cpp:15 Web::Layout::SVGGraphicsBox::SVGGraphicsBox.
pub func layout_svg_graphics_box_construct(this: LayoutSvgGraphicsBox*, document: DomDocument*, element: SvgGraphicsElement*, style: CssComputedProperties*):
    layout_svg_box_construct(this.layout_svg_box(), document, element.svg_element(), style)

## Ported from Libraries/LibWeb/Layout/SVGGraphicsBox.h:24 Web::Layout::SVGGraphicsBox::dom_node.
pub func layout_svg_graphics_box_dom_node(this: LayoutSvgGraphicsBox*) -> SvgGraphicsElement*:
    return as_svg_graphics_element(layout_svg_box_dom_node(this.layout_svg_box()))

## Ported from Libraries/LibWeb/Layout/SVGGraphicsBox.h:25 Web::Layout::SVGGraphicsBox::dom_node.
pub func layout_svg_graphics_box_dom_node_const(this: LayoutSvgGraphicsBox*) -> SvgGraphicsElement*:
    return layout_svg_graphics_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/SVGGraphicsBox.cpp:20 Web::Layout::SVGGraphicsBox::create_paintable (override).
pub func layout_svg_graphics_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_svg_graphics_paintable_create((LayoutSvgGraphicsBox*)base).paint_paintable()

## Ported from Libraries/LibWeb/Layout/SVGGraphicsBox.h:30 Web::Layout::SVGGraphicsBox::is_svg_graphics_box (override).
pub func layout_svg_graphics_box_is_svg_graphics_box_impl(base: LayoutNode*) -> bool:
    _ = base
    return true
