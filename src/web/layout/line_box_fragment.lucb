# mark: Geometry and text =======================================================================

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:37 Web::Layout::LineBoxFragment::offset.
pub func layout_line_box_fragment_offset(this: const LayoutLineBoxFragment*) -> gfx.CssPixelPoint:
    if this.m_writing_mode != css_data.WritingMode.horizontal_tb:
        return gfx.CssPixelPoint(m_x = this.m_block_offset, m_y = this.m_inline_offset)
    return gfx.CssPixelPoint(m_x = this.m_inline_offset, m_y = this.m_block_offset)

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:44 Web::Layout::LineBoxFragment::size.
pub func layout_line_box_fragment_size(this: const LayoutLineBoxFragment*) -> gfx.CssPixelSize:
    if this.m_writing_mode != css_data.WritingMode.horizontal_tb:
        return gfx.CssPixelSize(m_width = this.m_block_length, m_height = this.m_inline_length)
    return gfx.CssPixelSize(m_width = this.m_inline_length, m_height = this.m_block_length)

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:51 Web::Layout::LineBoxFragment::ends_in_whitespace.
pub func layout_line_box_fragment_ends_in_whitespace(this: const LayoutLineBoxFragment*) -> bool:
    if this.m_length_in_code_units == 0:
        return false
    let text = layout_line_box_fragment_text(this)
    return ak.is_ascii_space((u32)ak.utf16_view_code_unit_at(&text, this.m_length_in_code_units - 1))

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:58 Web::Layout::LineBoxFragment::is_justifiable_whitespace.
pub func layout_line_box_fragment_is_justifiable_whitespace(this: const LayoutLineBoxFragment*) -> bool:
    let text = layout_line_box_fragment_text(this)
    return ak.utf16_view_eq_string_view(&text, ak.sv(" "))

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:63 Web::Layout::LineBoxFragment::text.
pub func layout_line_box_fragment_text(this: const LayoutLineBoxFragment*) -> ak.Utf16View:
    if let text_node = as_if_layout_text_node(layout_line_box_fragment_layout_node(this)):
        let text_for_rendering = layout_text_node_text_for_rendering(text_node)
        let view = ak.utf16_string_base_utf16_view(&text_for_rendering.utf16_string_base)
        return ak.utf16_view_substring_view_usize(&view, this.m_start, this.m_length_in_code_units)
    return ak.utf16_view_new()

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:70 Web::Layout::LineBoxFragment::is_atomic_inline.
pub func layout_line_box_fragment_is_atomic_inline(this: const LayoutLineBoxFragment*) -> bool:
    return layout_node_is_atomic_inline(layout_line_box_fragment_layout_node(this))

# mark: Glyph runs ==============================================================================

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:75 Web::Layout::LineBoxFragment::resolve_glyph_run_direction.
pub func layout_line_box_fragment_resolve_glyph_run_direction(this: const LayoutLineBoxFragment*, text_type: web_fonts.GlyphRunTextType) -> css_data.Direction:
    match text_type:
        .common, .context_dependent, .end_padding:
            return this.m_direction
        .ltr:
            return css_data.Direction.ltr
        .rtl:
            return css_data.Direction.rtl
        _:
            trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:91 Web::Layout::LineBoxFragment::append_glyph_run.
pub func layout_line_box_fragment_append_glyph_run(this: LayoutLineBoxFragment*, glyph_run: web_fonts.GlyphRun*?, run_width: gfx.CssPixels):
    match this.m_direction:
        .ltr:
            layout_line_box_fragment_append_glyph_run_ltr(this, glyph_run, run_width)
        .rtl:
            layout_line_box_fragment_append_glyph_run_rtl(this, glyph_run, run_width)
        _:
            _ = 0

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:103 Web::Layout::LineBoxFragment::append_glyph_run_ltr.
pub func layout_line_box_fragment_append_glyph_run_ltr(this: LayoutLineBoxFragment*, glyph_run: web_fonts.GlyphRun*?, run_width: gfx.CssPixels):
    let run = glyph_run else trap("null glyph run")
    let own_run = this.m_glyph_run else trap("null glyph run")
    let run_direction = layout_line_box_fragment_resolve_glyph_run_direction(this, web_fonts.glyph_run_text_type(run))
    let inline_offset = this.m_inline_length.to_float()

    if this.m_current_insert_direction != run_direction:
        if run_direction == css_data.Direction.rtl:
            this.m_insert_position = inline_offset
        this.m_current_insert_direction = run_direction

    let glyphs = web_fonts.glyph_run_glyphs(own_run)
    let appended = web_fonts.glyph_run_glyphs(run)
    ak.vector_ensure_capacity(glyphs, ak.vector_size(glyphs) + ak.vector_size(appended))
    let existing_glyphs = ak.vector_span(glyphs)
    let appended_glyphs = ak.vector_span(appended)

    match run_direction:
        .ltr:
            for glyph in &appended_glyphs:
                gfx.float_point_translate_by_f32_f32(&glyph.position, inline_offset, 0.0)
                ak.vector_unchecked_append_u(glyphs, *glyph)
        .rtl:
            for glyph in &existing_glyphs:
                if glyph.position.m_x >= this.m_insert_position:
                    gfx.float_point_translate_by_f32_f32(&glyph.position, run_width.to_float(), 0.0)
            for glyph in &appended_glyphs:
                gfx.float_point_translate_by_f32_f32(&glyph.position, this.m_insert_position, 0.0)
                ak.vector_unchecked_append_u(glyphs, *glyph)
        _:
            _ = 0

    this.m_inline_length = this.m_inline_length.add(run_width)

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:139 Web::Layout::LineBoxFragment::append_glyph_run_rtl.
pub func layout_line_box_fragment_append_glyph_run_rtl(this: LayoutLineBoxFragment*, glyph_run: web_fonts.GlyphRun*?, run_width: gfx.CssPixels):
    let run = glyph_run else trap("null glyph run")
    let own_run = this.m_glyph_run else trap("null glyph run")
    let run_direction = layout_line_box_fragment_resolve_glyph_run_direction(this, web_fonts.glyph_run_text_type(run))
    let run_offset = run_width.to_float()

    if this.m_current_insert_direction != run_direction:
        if run_direction == css_data.Direction.ltr:
            this.m_insert_position = 0.0
        this.m_current_insert_direction = run_direction

    let glyphs = web_fonts.glyph_run_glyphs(own_run)
    let appended = web_fonts.glyph_run_glyphs(run)
    ak.vector_ensure_capacity(glyphs, ak.vector_size(glyphs) + ak.vector_size(appended))
    let existing_glyphs = ak.vector_span(glyphs)
    let appended_glyphs = ak.vector_span(appended)

    match run_direction:
        .ltr:
            for glyph in &existing_glyphs:
                if glyph.position.m_x >= this.m_insert_position:
                    gfx.float_point_translate_by_f32_f32(&glyph.position, run_offset, 0.0)
            for glyph in &appended_glyphs:
                gfx.float_point_translate_by_f32_f32(&glyph.position, this.m_insert_position, 0.0)
                ak.vector_unchecked_append_u(glyphs, *glyph)
        .rtl:
            if web_fonts.glyph_run_text_type(run) != web_fonts.GlyphRunTextType.end_padding:
                for glyph in &existing_glyphs:
                    gfx.float_point_translate_by_f32_f32(&glyph.position, run_offset, 0.0)
            for glyph in appended_glyphs:
                ak.vector_unchecked_append_u(glyphs, glyph)
        _:
            _ = 0

    this.m_inline_length = this.m_inline_length.add(run_width)
    this.m_insert_position += run_width.to_float()
