#==============================================================================================
#
#   line_box_fragment - Layout::LineBoxFragment: a piece of one layout node on a line box
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/LineBoxFragment.cpp (lines 1-180) and LineBoxFragment.h: a
#       fragment's offset and size in the inline and block axes (mapped to physical x/y by the
#       writing mode), its baseline, its text, and the glyph runs of the text chunks a line
#       box merges into it, placed in visual order for left-to-right and right-to-left
#       fragments.
#
#       Copyright (c) 2018-2023, Andreas Kling <andreas@ladybird.org>
#       Copyright (c) 2025, Jelle Raaijmakers <jelle@ladybird.org>
#       SPDX-License-Identifier: BSD-2-Clause
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/Layout/LineBoxFragment.cpp:15 Web::Layout::LineBoxFragment::LineBoxFragment.
pub func layout_line_box_fragment_construct(this: LayoutLineBoxFragment*, layout_node: LayoutNode*, start: usize, length_in_code_units: usize, inline_offset: gfx.CssPixels, block_offset: gfx.CssPixels, inline_length: gfx.CssPixels, block_length: gfx.CssPixels, border_box_top: gfx.CssPixels, direction: css_data.Direction, writing_mode: css_data.WritingMode, glyph_run: web_fonts.GlyphRun*?):
    this.m_layout_node = layout_node
    this.m_start = start
    this.m_length_in_code_units = length_in_code_units
    this.m_inline_offset = inline_offset
    this.m_block_offset = block_offset
    this.m_inline_length = inline_length
    this.m_block_length = block_length
    this.m_border_box_top = border_box_top
    this.m_baseline = layout_zero_px()
    this.m_direction = direction
    this.m_writing_mode = writing_mode
    this.m_glyph_run = glyph_run
    this.m_insert_position = 0.0
    this.m_current_insert_direction = css_data.Direction.ltr
    this.m_has_trailing_whitespace = false
    this.m_is_fully_truncated = false

    if let run = this.m_glyph_run:
        this.m_current_insert_direction = layout_line_box_fragment_resolve_glyph_run_direction(this, web_fonts.glyph_run_text_type(run))
        if this.m_direction == css_data.Direction.rtl:
            this.m_insert_position = this.m_inline_length.to_float()

## A LineBoxFragment by value (`LineBoxFragment { ... }`).
pub func layout_line_box_fragment_new(layout_node: LayoutNode*, start: usize, length_in_code_units: usize, inline_offset: gfx.CssPixels, block_offset: gfx.CssPixels, inline_length: gfx.CssPixels, block_length: gfx.CssPixels, border_box_top: gfx.CssPixels, direction: css_data.Direction, writing_mode: css_data.WritingMode, glyph_run: web_fonts.GlyphRun*?) -> LayoutLineBoxFragment:
    var fragment: LayoutLineBoxFragment = ---
    layout_line_box_fragment_construct(&fragment, layout_node, start, length_in_code_units, inline_offset, block_offset, inline_length, block_length, border_box_top, direction, writing_mode, glyph_run)
    return fragment

