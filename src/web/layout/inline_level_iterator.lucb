## Ported from Libraries/LibWeb/Layout/InlineLevelIterator.cpp:446 Web::Layout::InlineLevelIterator::add_extra_box_model_metrics_to_item.
func layout_inline_level_iterator_add_extra_box_model_metrics_to_item(this: LayoutInlineLevelIterator*, item: LayoutInlineLevelIteratorItem*, add_leading_metrics: bool, add_trailing_metrics: bool):
    if add_leading_metrics:
        if let extra_leading_metrics = this.m_extra_leading_metrics:
            item.margin_start = item.margin_start.add(extra_leading_metrics.margin)
            item.border_start = item.border_start.add(extra_leading_metrics.border)
            item.padding_start = item.padding_start.add(extra_leading_metrics.padding)
            this.m_extra_leading_metrics = none

    if add_trailing_metrics:
        if let extra_trailing_metrics = this.m_extra_trailing_metrics:
            item.margin_end = item.margin_end.add(extra_trailing_metrics.margin)
            item.border_end = item.border_end.add(extra_trailing_metrics.border)
            item.padding_end = item.padding_end.add(extra_trailing_metrics.padding)
            this.m_extra_trailing_metrics = none
