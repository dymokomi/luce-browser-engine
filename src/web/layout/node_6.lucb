## Ported from Libraries/LibWeb/Layout/Node.h:284 Web::Layout::NodeWithStyle::computed_values.
pub func layout_node_with_style_computed_values(this: LayoutNodeWithStyle*) -> const CssImmutableComputedValues*:
    return (const CssImmutableComputedValues*)this.m_computed_values

## Ported from Libraries/LibWeb/Layout/Node.h:285 Web::Layout::NodeWithStyle::mutable_computed_values.
pub func layout_node_with_style_mutable_computed_values(this: LayoutNodeWithStyle*) -> CssMutableComputedValues*:
    return (CssMutableComputedValues*)this.m_computed_values

## Ported from Libraries/LibWeb/Layout/Node.h:406 Web::Layout::NodeWithStyle::first_available_font.
pub func layout_node_with_style_first_available_font(this: LayoutNodeWithStyle*) -> const web_fonts.Font*:
    # https://drafts.csswg.org/css-fonts/#first-available-font
    # First font for which the character U+0020 (space) is not excluded by a unicode-range
    return web_fonts.font_cascade_list_font_for_code_point(css_computed_values_font_list(&layout_node_with_style_computed_values(this).computed_values), (u32)' ')

## Ported from Libraries/LibWeb/Layout/Node.h:290 Web::Layout::NodeWithStyle::background_layers.
pub func layout_node_with_style_background_layers(this: LayoutNodeWithStyle*) -> const ak.Vector[CssBackgroundLayerData]*:
    # computed_values().background_layers(): a reference to the computed value's vector.
    return &this.m_computed_values.m_noninherited.background_layers

