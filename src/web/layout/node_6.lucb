## Ported from Libraries/LibWeb/Layout/Node.h:363 Web::Layout::Node::has_style_or_parent_with_style.
pub func layout_node_has_style_or_parent_with_style(this: LayoutNode*) -> bool:
    if this.m_has_style:
        return true
    let parent = layout_node_parent(this) else return false
    return layout_node_has_style_or_parent_with_style(parent.layout_node())

