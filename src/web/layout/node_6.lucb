# mark: Node: fonts, computed values and parent (Node.h:363-404) ================================

## Ported from Libraries/LibWeb/Layout/Node.h:368 Web::Layout::Node::first_available_font.
pub func layout_node_first_available_font(this: LayoutNode*) -> const web_fonts.Font*:
    assert(layout_node_has_style_or_parent_with_style(this))
    if this.m_has_style:
        return layout_node_with_style_first_available_font((LayoutNodeWithStyle*)this)
    let parent = layout_node_parent(this) else trap("VERIFY: a parent with style")
    return layout_node_first_available_font(parent.layout_node())

## Ported from Libraries/LibWeb/Layout/Node.h:376 Web::Layout::Node::font.
pub func layout_node_font_display_list_recording_context(this: LayoutNode*, context: DisplayListRecordingContext*) -> const web_fonts.Font*:
    return layout_node_font_f32(this, (f32)display_list_recording_context_device_pixels_per_css_pixel(context))

## Ported from Libraries/LibWeb/Layout/Node.h:381 Web::Layout::Node::font.
pub func layout_node_font_f32(this: LayoutNode*, scale_factor: f32) -> const web_fonts.Font*:
    let font = layout_node_first_available_font(this)
    return web_fonts.font_with_size(font, web_fonts.font_point_size(font) * scale_factor)

## Ported from Libraries/LibWeb/Layout/Node.h:387 Web::Layout::Node::computed_values.
pub func layout_node_computed_values(this: LayoutNode*) -> const CssImmutableComputedValues*:
    assert(layout_node_has_style_or_parent_with_style(this))

    if this.m_has_style:
        return layout_node_with_style_computed_values((LayoutNodeWithStyle*)this)
    let parent = layout_node_parent(this) else trap("VERIFY: a parent with style")
    return layout_node_with_style_computed_values(parent)

## Ported from Libraries/LibWeb/Layout/Node.h:401 Web::Layout::Node::parent.
pub func layout_node_parent(this: LayoutNode*) -> LayoutNodeWithStyle*?:
    return (LayoutNodeWithStyle*?)tree_node_parent(this)

## Ported from Libraries/LibWeb/Layout/Node.h:396 Web::Layout::Node::parent.
pub func layout_node_parent_const(this: LayoutNode*) -> LayoutNodeWithStyle*?:
    return (LayoutNodeWithStyle*?)tree_node_parent(this)

