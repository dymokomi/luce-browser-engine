## Ported from Libraries/LibWeb/Layout/Node.h:198 Web::Layout::Node::is_out_of_flow.
# An element is called out of flow if it is floated, absolutely positioned, or is the root element.
# https://www.w3.org/TR/CSS22/visuren.html#positioning-scheme
pub func layout_node_is_out_of_flow(this: LayoutNode*) -> bool:
    return layout_node_is_floating(this) or layout_node_is_absolutely_positioned(this)

## Ported from Libraries/LibWeb/Layout/Node.h:202 Web::Layout::Node::is_in_flow.
# An element is called in-flow if it is not out-of-flow.
# https://www.w3.org/TR/CSS22/visuren.html#positioning-scheme
pub func layout_node_is_in_flow(this: LayoutNode*) -> bool:
    return not layout_node_is_out_of_flow(this)

## Ported from Libraries/LibWeb/Layout/Node.h:204 Web::Layout::Node::has_css_transform.
pub func layout_node_has_css_transform(this: LayoutNode*) -> bool:
    let computed_values = &layout_node_computed_values(this).computed_values
    let transformations = css_computed_values_transformations(computed_values)
    return not ak.vector_is_empty(&transformations) or css_computed_values_rotate(computed_values) != none or css_computed_values_translate(computed_values) != none or css_computed_values_scale(computed_values) != none

## Ported from Libraries/LibWeb/Layout/Node.h:223 Web::Layout::Node::has_been_wrapped_in_table_wrapper.
pub func layout_node_has_been_wrapped_in_table_wrapper(this: LayoutNode*) -> bool:
    return this.m_has_been_wrapped_in_table_wrapper

## Ported from Libraries/LibWeb/Layout/Node.h:224 Web::Layout::Node::set_has_been_wrapped_in_table_wrapper.
pub func layout_node_set_has_been_wrapped_in_table_wrapper(this: LayoutNode*, value: bool):
    this.m_has_been_wrapped_in_table_wrapper = value

