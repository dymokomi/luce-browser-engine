## Ported from Libraries/LibWeb/Layout/FormattingContext.cpp:44 Web::Layout::FormattingContext::creates_block_formatting_context.
pub func layout_formatting_context_creates_block_formatting_context(box: LayoutBox*) -> bool:
    let node = box.layout_node()

    # NOTE: Replaced elements never create a BFC.
    if layout_node_is_replaced_box(node):
        return false

    # AD-HOC: We create a BFC for SVG foreignObject.
    if layout_node_is_svg_foreign_object_box(node):
        return true

    let display = layout_node_display(node)

    # display: table
    if css_display_is_table_inside(&display):
        return false

    # display: flex
    if css_display_is_flex_inside(&display):
        return false

    # display: grid
    if css_display_is_grid_inside(&display):
        return false

    # NOTE: This function uses MDN as a reference, not because it's authoritative,
    #       but because they've gathered all the conditions in one convenient location.

    # The root element of the document (<html>).
    if layout_node_is_root_element(node):
        return true

    # Floats (elements where float isn't none).
    if layout_node_is_floating(node):
        return true

    # Absolutely positioned elements (elements where position is absolute or fixed).
    if layout_node_is_absolutely_positioned(node):
        return true

    # Inline-blocks (elements with display: inline-block).
    if css_display_is_inline_block(&display):
        return true

    # Table cells (elements with display: table-cell, which is the default for HTML table cells).
    if css_display_is_table_cell(&display):
        return true

    # Table captions (elements with display: table-caption, which is the default for HTML table captions).
    if css_display_is_table_caption(&display):
        return true

    # FIXME: Anonymous table cells implicitly created by the elements with display: table, table-row, table-row-group, table-header-group, table-footer-group
    #        (which is the default for HTML tables, table rows, table bodies, table headers, and table footers, respectively), or inline-table.

    # Block elements where overflow has a value other than visible and clip.
    let computed_values = &layout_node_computed_values(node).computed_values
    let overflow_x = css_computed_values_overflow_x(computed_values)
    if overflow_x != css_data.Overflow.visible and overflow_x != css_data.Overflow.clip:
        return true
    let overflow_y = css_computed_values_overflow_y(computed_values)
    if overflow_y != css_data.Overflow.visible and overflow_y != css_data.Overflow.clip:
        return true

    # display: flow-root.
    if css_display_is_flow_root_inside(&display):
        return true

    # https://drafts.csswg.org/css-contain-2/#containment-types
    # 1. The layout containment box establishes an independent formatting context.
    # 4. The paint containment box establishes an independent formatting context.
    if layout_node_has_layout_containment(node) or layout_node_has_paint_containment(node):
        return true

    # https://drafts.csswg.org/css-conditional-5/#valdef-container-type-size
    # Applies style containment and size containment to the principal box, and establishes an independent formatting
    # context.
    let container_type = css_computed_values_container_type(computed_values)
    if container_type.is_size_container or container_type.is_inline_size_container:
        return true

    if let parent = layout_node_parent(node):
        let parent_display = layout_node_display(parent.layout_node())

        # Flex items (direct children of the element with display: flex or inline-flex) if they are neither flex nor grid nor table containers themselves.
        if css_display_is_flex_inside(&parent_display):
            return true
        # Grid items (direct children of the element with display: grid or inline-grid) if they are neither flex nor grid nor table containers themselves.
        if css_display_is_grid_inside(&parent_display):
            return true

    # https://drafts.csswg.org/css-multicol-2/#the-multi-column-model
    # An element whose 'column-width', 'column-count', or 'column-height' property is not 'auto' establishes a multi-
    # column container (or multicol container for short), and therefore acts as a container for multi-column layout.
    # FIXME: Maybe add column-height, depending on the resolution for https://github.com/w3c/csswg-drafts/issues/12688
    let column_width = css_computed_values_column_width(computed_values)
    let column_count = css_computed_values_column_count(computed_values)
    if not css_size_is_auto(&column_width) or not css_column_count_is_auto(&column_count):
        return true

    # FIXME: column-span: all should always create a new formatting context, even when the column-span: all element isn't contained by a multicol container (Spec change, Chrome bug).

    # https://html.spec.whatwg.org/multipage/rendering.html#the-fieldset-and-legend-elements
    if layout_node_is_fieldset_box(node):
        # The fieldset element, when it generates a CSS box, is expected to act as follows:
        # The element is expected to establish a new block formatting context.
        return true

    return false

## Ported from Libraries/LibWeb/Layout/FormattingContext.cpp:152 Web::Layout::FormattingContext::formatting_context_type_created_by_box.
pub func layout_formatting_context_formatting_context_type_created_by_box(box: LayoutBox*) -> LayoutFormattingContextType?:
    let node = box.layout_node()
    if is_layout_svgsvg_box(box):
        return LayoutFormattingContextType.svg

    if layout_node_is_replaced_box_with_children(node):
        return LayoutFormattingContextType.replaced_with_children

    if layout_node_is_replaced_box(node):
        return LayoutFormattingContextType.internal_replaced

    if not layout_node_can_have_children(node):
        return none

    let display = layout_node_display(node)

    if css_display_is_flex_inside(&display):
        return LayoutFormattingContextType.flex

    if css_display_is_table_inside(&display):
        return LayoutFormattingContextType.table

    if css_display_is_grid_inside(&display):
        return LayoutFormattingContextType.grid

    if css_display_is_math_inside(&display):
        # FIXME: We should create a MathML-specific formatting context here, but for now use a BFC, so _something_ is displayed
        return LayoutFormattingContextType.block

    if layout_formatting_context_creates_block_formatting_context(box):
        return LayoutFormattingContextType.block

    if layout_node_children_are_inline(node):
        return none

    if css_display_is_table_column(&display) or css_display_is_table_row_group(&display) or css_display_is_table_header_group(&display) or css_display_is_table_footer_group(&display) or css_display_is_table_row(&display) or css_display_is_table_column_group(&display):
        return none

    # The box is a block container that doesn't create its own BFC.
    # It will be formatted by the containing BFC.
    if not css_display_is_flow_inside(&display):
        # HACK: Instead of crashing, create a dummy formatting context that does nothing.
        # FIXME: We need this for <math> elements
        return LayoutFormattingContextType.internal_dummy
    return none

## Ported from Libraries/LibWeb/Layout/FormattingContext.h:78 Web::Layout::FormattingContext::type_name.
pub func layout_formatting_context_type_name(type_: LayoutFormattingContextType) -> ak.StringView:
    match type_:
        .block:
            return ak.sv("BFC")
        .inline:
            return ak.sv("IFC")
        .flex:
            return ak.sv("FFC")
        .grid:
            return ak.sv("GFC")
        .table:
            return ak.sv("TFC")
        .svg:
            return ak.sv("SVG")
        .replaced_with_children:
            return ak.sv("Replaced, with children")
        .internal_replaced:
            return ak.sv("Replaced")
        .internal_dummy:
            return ak.sv("Dummy")
        _:
            trap("VERIFY_NOT_REACHED")
