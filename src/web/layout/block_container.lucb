## Ported from Libraries/LibWeb/Layout/BlockContainer.cpp:14 Web::Layout::BlockContainer::BlockContainer.
pub func layout_block_container_construct_css_computed_properties(this: LayoutBlockContainer*, document: DomDocument*, node: DomNode*?, style: CssComputedProperties*):
    layout_box_construct_css_computed_properties(this.layout_box(), document, node, style)

## Ported from Libraries/LibWeb/Layout/BlockContainer.cpp:19 Web::Layout::BlockContainer::BlockContainer.
pub func layout_block_container_construct_css_computed_values(this: LayoutBlockContainer*, document: DomDocument*, node: DomNode*?, computed_values: CssComputedValues*):
    layout_box_construct_css_computed_values(this.layout_box(), document, node, computed_values)

## Ported from Libraries/LibWeb/Layout/BlockContainer.cpp:26 Web::Layout::BlockContainer::paintable_with_lines.
pub func layout_block_container_paintable_with_lines(this: LayoutBlockContainer*) -> PaintPaintableWithLines*?:
    let paintable_box = layout_box_paintable_box(this.layout_box()) else return none
    return as_if_paint_paintable_with_lines(paintable_box)

## Ported from Libraries/LibWeb/Layout/BlockContainer.cpp:31 Web::Layout::BlockContainer::create_paintable (override).
pub func layout_block_container_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_paintable_with_lines_create_layout_block_container((LayoutBlockContainer*)base).paint_paintable()

## Ported from Libraries/LibWeb/Layout/BlockContainer.h:29 Web::Layout::BlockContainer::is_block_container (override).
pub func layout_block_container_is_block_container_impl(base: LayoutNode*) -> bool:
    discard(base)
    return true
