# mark: DOM node and document ===================================================================

## Ported from Libraries/LibWeb/Layout/Node.cpp:1292 Web::Layout::Node::is_anonymous.
pub func layout_node_is_anonymous(this: LayoutNode*) -> bool:
    return this.m_anonymous

## Ported from Libraries/LibWeb/Layout/Node.cpp:1297 Web::Layout::Node::dom_node.
pub func layout_node_dom_node_const(this: LayoutNode*) -> DomNode*?:
    if this.m_anonymous:
        return none
    return this.m_dom_node

## Ported from Libraries/LibWeb/Layout/Node.cpp:1304 Web::Layout::Node::dom_node.
pub func layout_node_dom_node(this: LayoutNode*) -> DomNode*?:
    if this.m_anonymous:
        return none
    return this.m_dom_node

