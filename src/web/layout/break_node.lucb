## Ported from Libraries/LibWeb/Layout/BreakNode.cpp:15 Web::Layout::BreakNode::BreakNode.
pub func layout_break_node_construct(this: LayoutBreakNode*, document: DomDocument*, element: HtmlHtmlbrElement*, style: CssComputedProperties*):
    layout_node_with_style_and_box_model_metrics_construct_css_computed_properties(this.layout_node_with_style_and_box_model_metrics(), document, element.dom_node(), style)

## Ported from Libraries/LibWeb/Layout/BreakNode.h:22 Web::Layout::BreakNode::dom_node.
pub func layout_break_node_dom_node(this: LayoutBreakNode*) -> HtmlHtmlbrElement*:
    let dom_node = layout_node_dom_node(this.layout_node()) else trap("VERIFY: a <br> layout node has a DOM node")
    return as_html_htmlbr_element(dom_node)

## Ported from Libraries/LibWeb/Layout/BreakNode.h:25 Web::Layout::BreakNode::is_break_node (override).
pub func layout_break_node_is_break_node_impl(base: LayoutNode*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/Layout/BreakNode.h:26 Web::Layout::BreakNode::can_have_children (override).
pub func layout_break_node_can_have_children_impl(base: LayoutNode*) -> bool:
    _ = base
    return false
