## Ported from Libraries/LibWeb/Layout/SVGClipBox.cpp:15 Web::Layout::SVGClipBox::SVGClipBox.
pub func layout_svg_clip_box_construct(this: LayoutSvgClipBox*, document: DomDocument*, element: SvgClipPathElement*, style: CssComputedProperties*):
    layout_svg_box_construct(this.layout_svg_box(), document, element.svg_element(), style)

## Ported from Libraries/LibWeb/Layout/SVGClipBox.h:23 Web::Layout::SVGClipBox::dom_node.
pub func layout_svg_clip_box_dom_node(this: LayoutSvgClipBox*) -> SvgClipPathElement*:
    return as_svg_clip_path_element(layout_svg_box_dom_node(this.layout_svg_box()))

## Ported from Libraries/LibWeb/Layout/SVGClipBox.h:24 Web::Layout::SVGClipBox::dom_node.
pub func layout_svg_clip_box_dom_node_const(this: LayoutSvgClipBox*) -> SvgClipPathElement*:
    return layout_svg_clip_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/SVGClipBox.cpp:20 Web::Layout::SVGClipBox::create_paintable (override).
pub func layout_svg_clip_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_svg_clip_paintable_create((LayoutSvgClipBox*)base).paint_paintable()

## Ported from Libraries/LibWeb/Layout/SVGClipBox.h:29 Web::Layout::SVGClipBox::is_svg_clip_box (override).
pub func layout_svg_clip_box_is_svg_clip_box_impl(base: LayoutNode*) -> bool:
    discard(base)
    return true
