## Ported from Libraries/LibWeb/Layout/TableWrapper.cpp:13 Web::Layout::TableWrapper::TableWrapper.
pub func layout_table_wrapper_construct_css_computed_properties(this: LayoutTableWrapper*, document: DomDocument*, node: DomNode*?, style: CssComputedProperties*):
    layout_block_container_construct_css_computed_properties(this.layout_block_container(), document, node, style)

## Ported from Libraries/LibWeb/Layout/TableWrapper.cpp:18 Web::Layout::TableWrapper::TableWrapper.
pub func layout_table_wrapper_construct_css_computed_values(this: LayoutTableWrapper*, document: DomDocument*, node: DomNode*?, computed_values: CssComputedValues*):
    layout_block_container_construct_css_computed_values(this.layout_block_container(), document, node, computed_values)

# TableWrapper::~TableWrapper() is the default destructor.

## Ported from Libraries/LibWeb/Layout/TableWrapper.h:23 Web::Layout::TableWrapper::is_table_wrapper (override).
pub func layout_table_wrapper_is_table_wrapper_impl(base: LayoutNode*) -> bool:
    _ = base
    return true
