# mark: Flex items ==============================================================================

## The `quick_sort` comparator `a > b` of FlexFormattingContext::generate_anonymous_flex_items.
func layout_flex_formatting_context_order_greater_than(context: void*?, a: const i32*, b: const i32*) -> bool:
    discard(context)
    return *a > *b

## The `quick_sort` comparator `a < b` of FlexFormattingContext::generate_anonymous_flex_items.
func layout_flex_formatting_context_order_less_than(context: void*?, a: const i32*, b: const i32*) -> bool:
    discard(context)
    return *a < *b

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:350 Web::Layout::FlexFormattingContext::generate_anonymous_flex_items.
# https://www.w3.org/TR/css-flexbox-1/#flex-items
func layout_flex_formatting_context_generate_anonymous_flex_items(this: LayoutFlexFormattingContext*):
    # More like, sift through the already generated items.
    # After this step no items are to be added or removed from flex_items!
    # It holds every item we need to consider and there should be nothing in the following
    # calculations that could change that.
    # This is particularly important since we take references to the items stored in flex_items
    # later, whose addresses won't be stable if we added or removed any items.
    var order_item_bucket: ak.HashMap[i32, ak.Vector[LayoutFlexFormattingContextFlexItem], ak.I32Traits]

    var child_or_none = tree_node_first_child_of_type(layout_flex_formatting_context_flex_container(this).layout_node(), &layout_box_class)
    while let child = child_or_none:
        child_or_none = tree_node_next_sibling_of_type(child, &layout_box_class)
        let child_box = (LayoutBox*)child
        if layout_formatting_context_can_skip_is_anonymous_text_run(this.layout_formatting_context(), child_box):
            continue

        # Skip any "out-of-flow" children
        if layout_node_is_out_of_flow_layout_formatting_context(child_box.layout_node(), this.layout_formatting_context()):
            continue

        layout_node_set_flex_item(child_box.layout_node(), true)
        var item = LayoutFlexFormattingContextFlexItem(box = child_box, used_values = layout_state_get_mutable(this.formatting_context.m_state, child_box.layout_node_with_style()))
        layout_flex_formatting_context_populate_specified_margins(this, &item, this.m_flex_direction)

        let order_bucket = ak.hash_map_ensure(&order_item_bucket, css_computed_values_order(layout_box_computed(child_box)))
        ak.vector_append_t(order_bucket, item)

    var keys = ak.hash_map_keys(&order_item_bucket)

    if layout_flex_formatting_context_is_direction_reverse(this):
        ak.quick_sort_t_collection_t_less_than(ak.vector_span(&keys), ak.Function2[const i32*, const i32*, bool](call = layout_flex_formatting_context_order_greater_than, context = none))
    else:
        ak.quick_sort_t_collection_t_less_than(ak.vector_span(&keys), ak.Function2[const i32*, const i32*, bool](call = layout_flex_formatting_context_order_less_than, context = none))

    for key in ak.vector_span(&keys):
        if let order_bucket = ak.hash_map_get_k(&order_item_bucket, key):
            for bucket_item in ak.vector_span(order_bucket):
                ak.vector_append_t(&this.m_flex_items, bucket_item)

# mark: Main and cross sizes ====================================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:397 Web::Layout::FlexFormattingContext::has_definite_main_size.
func layout_flex_formatting_context_has_definite_main_size_layout_state_used_values(this: LayoutFlexFormattingContext*, used_values: const LayoutStateUsedValues*) -> bool:
    return layout_state_used_values_has_definite_width(used_values) if layout_flex_formatting_context_main_axis_is_horizontal(this) else layout_state_used_values_has_definite_height(used_values)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:402 Web::Layout::FlexFormattingContext::inner_main_size.
func layout_flex_formatting_context_inner_main_size_layout_state_used_values(this: LayoutFlexFormattingContext*, used_values: const LayoutStateUsedValues*) -> gfx.CssPixels:
    return layout_state_used_values_content_width(used_values) if layout_flex_formatting_context_main_axis_is_horizontal(this) else layout_state_used_values_content_height(used_values)

