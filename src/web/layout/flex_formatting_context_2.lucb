## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:443 Web::Layout::FlexFormattingContext::calculate_inner_flex_container_cross_min_size.
func layout_flex_formatting_context_calculate_inner_flex_container_cross_min_size(this: LayoutFlexFormattingContext*) -> gfx.CssPixels:
    let flex_container = layout_flex_formatting_context_flex_container(this)
    let available_space = layout_flex_formatting_context_available_space(this)
    if layout_flex_formatting_context_cross_axis_is_horizontal(this):
        return layout_formatting_context_calculate_inner_width(this.layout_formatting_context(), flex_container, available_space.width, layout_flex_formatting_context_computed_cross_min_size(this, flex_container))
    return layout_formatting_context_calculate_inner_height(this.layout_formatting_context(), flex_container, available_space, layout_flex_formatting_context_computed_cross_min_size(this, flex_container))

