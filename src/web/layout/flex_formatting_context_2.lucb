## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:429 Web::Layout::FlexFormattingContext::specified_main_min_size.
func layout_flex_formatting_context_specified_main_min_size(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> gfx.CssPixels:
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return layout_flex_formatting_context_get_pixel_width(this, item, layout_flex_formatting_context_computed_main_min_size(this, item.box))
    return layout_flex_formatting_context_get_pixel_height(this, item, layout_flex_formatting_context_computed_main_min_size(this, item.box))

