func layout_flex_formatting_context_set_has_definite_main_size(this: LayoutFlexFormattingContext*, item: LayoutFlexFormattingContextFlexItem*):
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        layout_state_used_values_set_has_definite_width(item.used_values, true)
    else:
        layout_state_used_values_set_has_definite_height(item.used_values, true)

