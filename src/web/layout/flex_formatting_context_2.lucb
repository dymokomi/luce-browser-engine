    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        item.used_values.margin_right = margin
    else:
        item.used_values.margin_bottom = margin

# mark: Available space and the used flex basis =================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:562 Web::Layout::FlexFormattingContext::determine_available_space_for_items.
# https://drafts.csswg.org/css-flexbox-1/#algo-available
func layout_flex_formatting_context_determine_available_space_for_items(this: LayoutFlexFormattingContext*, available_space: LayoutAvailableSpace):
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        this.m_available_space_for_items = LayoutFlexFormattingContextAxisAgnosticAvailableSpace(
            main = available_space.width,
            cross = available_space.height,
            space = LayoutAvailableSpace(width = available_space.width, height = available_space.height),
        )
    else:
        this.m_available_space_for_items = LayoutFlexFormattingContextAxisAgnosticAvailableSpace(
            main = available_space.height,
            cross = available_space.width,
            space = LayoutAvailableSpace(width = available_space.width, height = available_space.height),
        )

## `flex_basis.get_pointer<CSS::Size>()`: the size a flex-basis holds, if it is not `content`.
func layout_flex_formatting_context_flex_basis_size(flex_basis: CssFlexBasis) -> CssSize?:
    match flex_basis:
        .css_size(size):
            return size
        .css_flex_basis_content:
            return none

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:580 Web::Layout::FlexFormattingContext::used_flex_basis_for_item.
# https://drafts.csswg.org/css-flexbox-1/#propdef-flex-basis
func layout_flex_formatting_context_used_flex_basis_for_item(this: LayoutFlexFormattingContext*, item: const LayoutFlexFormattingContextFlexItem*) -> CssFlexBasis:
    var flex_basis = css_computed_values_flex_basis(layout_box_computed(item.box))

    if let auto_size = layout_flex_formatting_context_flex_basis_size(flex_basis):
        if css_size_is_auto(&auto_size):
            # https://drafts.csswg.org/css-flexbox-1/#valdef-flex-basis-auto
            # When specified on a flex item, the auto keyword retrieves the value of the main size property as the used flex-basis.
            # If that value is itself auto, then the used value is content.
            let main_size = layout_flex_formatting_context_computed_main_size(this, item.box)

            if css_size_is_auto(&main_size):
                flex_basis = CssFlexBasis.css_flex_basis_content(CssFlexBasisContent())
            else:
                flex_basis = CssFlexBasis.css_size(main_size)

    # For example, percentage values of flex-basis are resolved against the flex item’s containing block
    # (i.e. its flex container); and if that containing block’s size is indefinite,
    # the used value for flex-basis is content.
    if let percentage_size = layout_flex_formatting_context_flex_basis_size(flex_basis):
        if css_size_is_percentage(&percentage_size) and not layout_flex_formatting_context_has_definite_main_size_layout_state_used_values(this, this.m_flex_container_state):
            flex_basis = CssFlexBasis.css_flex_basis_content(CssFlexBasisContent())

    return flex_basis

# mark: Aspect ratios ===========================================================================

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:609 Web::Layout::FlexFormattingContext::calculate_main_size_from_cross_size_and_aspect_ratio.
func layout_flex_formatting_context_calculate_main_size_from_cross_size_and_aspect_ratio(this: LayoutFlexFormattingContext*, cross_size: gfx.CssPixels, aspect_ratio: gfx.CssPixelFraction) -> gfx.CssPixels:
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return cross_size.mul_fraction(aspect_ratio)
    return cross_size.div_fraction(aspect_ratio)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:616 Web::Layout::FlexFormattingContext::calculate_cross_size_from_main_size_and_aspect_ratio.
func layout_flex_formatting_context_calculate_cross_size_from_main_size_and_aspect_ratio(this: LayoutFlexFormattingContext*, main_size: gfx.CssPixels, aspect_ratio: gfx.CssPixelFraction) -> gfx.CssPixels:
    if layout_flex_formatting_context_main_axis_is_horizontal(this):
        return main_size.div_fraction(aspect_ratio)
    return main_size.mul_fraction(aspect_ratio)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:625 Web::Layout::FlexFormattingContext::adjust_main_size_through_aspect_ratio_for_cross_size_min_max_constraints.
# This function takes a size in the main axis and adjusts it according to the aspect ratio of the box
# if the min/max constraints in the cross axis forces us to come up with a new main axis size.
func layout_flex_formatting_context_adjust_main_size_through_aspect_ratio_for_cross_size_min_max_constraints(this: LayoutFlexFormattingContext*, box: LayoutBox*, main_size: gfx.CssPixels, min_cross_size: CssSize, max_cross_size: CssSize) -> gfx.CssPixels:
    var adjusted_main_size = main_size
    let reference_value = layout_state_used_values_content_width(this.m_flex_container_state) if layout_flex_formatting_context_cross_axis_is_horizontal(this) else layout_state_used_values_content_height(this.m_flex_container_state)
    if not layout_flex_formatting_context_should_treat_cross_max_size_as_none(this, box):
        let max_cross_size_px = css_size_to_px(&max_cross_size, box.layout_node(), reference_value)
        let aspect_ratio = layout_box_preferred_aspect_ratio(box) else trap("VERIFY: the box has a preferred aspect ratio")
        adjusted_main_size = ak.min(adjusted_main_size, layout_flex_formatting_context_calculate_main_size_from_cross_size_and_aspect_ratio(this, max_cross_size_px, aspect_ratio))

    if not css_size_is_auto(&min_cross_size):
        let min_cross_size_px = css_size_to_px(&min_cross_size, box.layout_node(), reference_value)
        let aspect_ratio = layout_box_preferred_aspect_ratio(box) else trap("VERIFY: the box has a preferred aspect ratio")
        adjusted_main_size = ak.max(adjusted_main_size, layout_flex_formatting_context_calculate_main_size_from_cross_size_and_aspect_ratio(this, min_cross_size_px, aspect_ratio))

    return adjusted_main_size

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:640 Web::Layout::FlexFormattingContext::adjust_cross_size_through_aspect_ratio_for_main_size_min_max_constraints.
func layout_flex_formatting_context_adjust_cross_size_through_aspect_ratio_for_main_size_min_max_constraints(this: LayoutFlexFormattingContext*, box: LayoutBox*, cross_size: gfx.CssPixels, min_main_size: CssSize, max_main_size: CssSize) -> gfx.CssPixels:
    var adjusted_cross_size = cross_size
    let reference_value = layout_state_used_values_content_width(this.m_flex_container_state) if layout_flex_formatting_context_main_axis_is_horizontal(this) else layout_state_used_values_content_height(this.m_flex_container_state)
    if not layout_flex_formatting_context_should_treat_main_max_size_as_none(this, box):
        let max_main_size_px = css_size_to_px(&max_main_size, box.layout_node(), reference_value)
        let aspect_ratio = layout_box_preferred_aspect_ratio(box) else trap("VERIFY: the box has a preferred aspect ratio")
        adjusted_cross_size = ak.min(adjusted_cross_size, layout_flex_formatting_context_calculate_cross_size_from_main_size_and_aspect_ratio(this, max_main_size_px, aspect_ratio))

    if not css_size_is_auto(&min_main_size):
        let min_main_size_px = css_size_to_px(&min_main_size, box.layout_node(), reference_value)
        let aspect_ratio = layout_box_preferred_aspect_ratio(box) else trap("VERIFY: the box has a preferred aspect ratio")
        adjusted_cross_size = ak.max(adjusted_cross_size, layout_flex_formatting_context_calculate_cross_size_from_main_size_and_aspect_ratio(this, min_main_size_px, aspect_ratio))

    return adjusted_cross_size
