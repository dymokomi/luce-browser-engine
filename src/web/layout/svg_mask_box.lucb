## Ported from Libraries/LibWeb/Layout/SVGMaskBox.cpp:15 Web::Layout::SVGMaskBox::SVGMaskBox.
pub func layout_svg_mask_box_construct(this: LayoutSvgMaskBox*, document: DomDocument*, element: SvgMaskElement*, style: CssComputedProperties*):
    layout_svg_graphics_box_construct(this.layout_svg_graphics_box(), document, element.svg_graphics_element(), style)

## Ported from Libraries/LibWeb/Layout/SVGMaskBox.h:23 Web::Layout::SVGMaskBox::is_svg_mask_box (override).
pub func layout_svg_mask_box_is_svg_mask_box_impl(base: LayoutNode*) -> bool:
    _ = base
    return true

## Ported from Libraries/LibWeb/Layout/SVGMaskBox.h:25 Web::Layout::SVGMaskBox::dom_node.
pub func layout_svg_mask_box_dom_node(this: LayoutSvgMaskBox*) -> SvgMaskElement*:
    return as_svg_mask_element(layout_svg_graphics_box_dom_node(this.layout_svg_graphics_box()))

## Ported from Libraries/LibWeb/Layout/SVGMaskBox.h:26 Web::Layout::SVGMaskBox::dom_node.
pub func layout_svg_mask_box_dom_node_const(this: LayoutSvgMaskBox*) -> SvgMaskElement*:
    return layout_svg_mask_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/SVGMaskBox.cpp:20 Web::Layout::SVGMaskBox::create_paintable (override).
pub func layout_svg_mask_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_svg_mask_paintable_create((LayoutSvgMaskBox*)base).paint_paintable()
