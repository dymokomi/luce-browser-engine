## Ported from Libraries/LibWeb/Layout/ListItemBox.cpp:15 Web::Layout::ListItemBox::ListItemBox.
pub func layout_list_item_box_construct(this: LayoutListItemBox*, document: DomDocument*, element: DomElement*?, style: CssComputedProperties*):
    layout_block_container_construct_css_computed_properties(this.layout_block_container(), document, (DomNode*?)element, style)

## Ported from Libraries/LibWeb/Layout/ListItemBox.cpp:22 Web::Layout::ListItemBox::visit_edges (override).
pub func layout_list_item_box_visit_edges_impl(base: gc.Cell*, visitor: gc.CellVisitor*):
    let this = (LayoutListItemBox*)base
    layout_box_visit_edges_impl(base, visitor)
    gc.cell_visitor_visit_t(visitor, this.m_marker)

## Ported from Libraries/LibWeb/Layout/ListItemBox.cpp:28 Web::Layout::ListItemBox::set_marker.
pub func layout_list_item_box_set_marker(this: LayoutListItemBox*, marker: LayoutListItemMarkerBox*?):
    this.m_marker = marker

## Ported from Libraries/LibWeb/Layout/ListItemBox.h:22 Web::Layout::ListItemBox::dom_node.
pub func layout_list_item_box_dom_node(this: LayoutListItemBox*) -> DomElement*:
    let dom_node = layout_node_dom_node(this.layout_node()) else trap("VERIFY: a list item box has a DOM node")
    return (DomElement*)dom_node

## Ported from Libraries/LibWeb/Layout/ListItemBox.h:23 Web::Layout::ListItemBox::dom_node.
pub func layout_list_item_box_dom_node_const(this: LayoutListItemBox*) -> DomElement*:
    return layout_list_item_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/ListItemBox.h:25 Web::Layout::ListItemBox::marker.
pub func layout_list_item_box_marker(this: LayoutListItemBox*) -> LayoutListItemMarkerBox*?:
    return this.m_marker

## Ported from Libraries/LibWeb/Layout/ListItemBox.h:29 Web::Layout::ListItemBox::is_list_item_box (override).
pub func layout_list_item_box_is_list_item_box_impl(base: LayoutNode*) -> bool:
    _ = base
    return true
