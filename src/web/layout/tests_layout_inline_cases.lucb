    TestLayoutGeometryCase(mode = "layout", html = "<!doctype html><body><div id=\"pink\"><div id=\"orange\">lol\n", css = "\n* {\n    outline: 1px solid black;\n}\nhtml {\n    width: 100px;\n}\nbody {\n    width: 100px;\n    height: 100px;\n    margin-top: 10px;\n}\ndiv#pink {\n    width: 100px;\n    height: 100px;\n    margin-top: 100px;\n    background: pink;\n}\ndiv#orange {\n    margin-top: 200px;\n    margin-right: 50px;\n    margin-bottom: 100px;\n    background: orange;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 100 0+0+700] [0+0+0 308 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,200] [8+0+0 100 0+0+-8] [10+0+0 100 0+0+8] children: not-inline\n        BlockContainer <div#pink> at [8,200] [0+0+0 100 0+0+0] [100+0+0 100 0+0+0] children: not-inline\n          BlockContainer <div#orange> at [8,200] [0+0+0 50 0+0+50] [200+0+0 18 0+0+100] children: inline\n            frag 0 from TextNode start: 0, length: 3, rect: [8,200 18.828125x18] baseline: 13.796875\n                \"lol\"\n            TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 100x308]\n      PaintableWithLines (BlockContainer<BODY>) [8,200 100x100]\n        PaintableWithLines (BlockContainer<DIV>#pink) [8,200 100x100]\n          PaintableWithLines (BlockContainer<DIV>#orange) [8,200 50x18]\n            TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [0,0 100x308] [children: 0] (z-index: auto)\n"),
