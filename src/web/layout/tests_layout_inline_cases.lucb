    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<div class=left></div>\n<div class=right></div>\nLorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse a placerat mauris, ut elementum mi. Morbi ut vehicula ipsum, eget placerat augue. Integer rutrum nisi eget dui dictum, eu accumsan enim tristique. Ut lobortis lorem eget est vulputate egestas. Integer laoreet lacinia ante sodales lobortis. Donec a tincidunt ante. Phasellus a arcu tortor. \n", css = "\n* {\n    font: 20px SerenitySans;\n    border: 1px solid black;\n}\nbody {\n    margin-left: 250px;\n}\n.left {\n    float: left;\n    background: pink;\n    width: 300px;\n    height: 200px;\n}\n.right {\n    float: right;\n    background: wheat;\n    width: 300px;\n    height: 200px;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 450 0+1+0] [BFC] children: not-inline\n      BlockContainer <body> at [252,10] [250+1+0 538 0+1+8] [8+1+0 432 0+1+8] children: inline\n        frag 0 from TextNode start: 1, length: 21, rect: [554,10 228.375x23] baseline: 17.5\n            \"Lorem ipsum dolor sit\"\n        frag 1 from TextNode start: 23, length: 17, rect: [554,33 183.8125x23] baseline: 17.5\n            \"amet, consectetur\"\n        frag 2 from TextNode start: 41, length: 16, rect: [554,56 140.59375x23] baseline: 17.5\n            \"adipiscing elit.\"\n        frag 3 from TextNode start: 58, length: 13, rect: [554,79 145.0625x23] baseline: 17.5\n            \"Suspendisse a\"\n        frag 4 from TextNode start: 72, length: 19, rect: [554,102 196.734375x23] baseline: 17.5\n            \"placerat mauris, ut\"\n        frag 5 from TextNode start: 92, length: 22, rect: [554,125 234.71875x23] baseline: 17.5\n            \"elementum mi. Morbi ut\"\n        frag 6 from TextNode start: 115, length: 20, rect: [554,148 201.5625x23] baseline: 17.5\n            \"vehicula i