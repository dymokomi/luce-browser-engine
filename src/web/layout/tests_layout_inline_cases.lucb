    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><div style=\"white-space:pre-wrap;width:120px\">pre-wrap   keeps   spaces and wraps\nat the box edge   with trailing spaces   </div><div style=\"white-space:pre-line;width:120px\">pre-line   collapses   spaces\nbut keeps newlines</div><div style=\"white-space:break-spaces;width:100px\">break   spaces   wrap   inside</div>", css = "", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 304 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 288 0+0+8] children: not-inline\n        BlockContainer <div> at [8,8] [0+0+0 120 0+0+664] [0+0+0 126 0+0+0] children: inline\n          frag 0 from TextNode start: 0, length: 10, rect: [8,8 88.265625x18] baseline: 13.796875\n              \"pre-wrap  \"\n          frag 1 from TextNode start: 11, length: 7, rect: [8,26 59.921875x18] baseline: 13.796875\n              \"keeps  \"\n          frag 2 from TextNode start: 19, length: 10, rect: [8,44 89.875x18] baseline: 13.796875\n              \"spaces and\"\n          frag 3 from TextNode start: 30, length: 5, rect: [8,62 48.15625x18] baseline: 13.796875\n              \"wraps\"\n          frag 4 from TextNode start: 36, length: 10, rect: [8,80 86.609375x18] baseline: 13.796875\n              \"at the box\"\n          frag 5 from TextNode start: 47, length: 11, rect: [8,98 88.796875x18] baseline: 13.796875\n              \"edge   with\"\n          frag 6 from TextNode start: 59, length: 18, rect: [8,116 142.625x18] baseline: 13.796875\n              \"trailing spaces   \"\n          TextNode <#text> (not painted)\n        BlockContainer <div> at [8,134] [0+0+0 120 0+0+664] [0+0+0 90 0+0+0] children: inline\n          frag 0 from TextNode start: 0, length: 8, rect: [8,134 60.578125x18] baseline: 13.796875\n              \"pre-line\"\n          frag 1 from TextN