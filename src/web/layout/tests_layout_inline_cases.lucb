    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><body><div class=\"exekiller\">exekiller</div><div class=\"athena\">athena</div></body>", css = "\n  * { border: 2px solid black; }\n  body { width: 600px; }\n  div {\n    width: 200px;\n    position: relative;\n  }\n  .athena {\n    background: green;\n    top: -10px;\n    left: 10px;\n  }\n  .exekiller {\n    background: red;\n  }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [2,2] [0+2+0 796 0+2+0] [0+2+0 64 0+2+0] [BFC] children: not-inline\n      BlockContainer <body> at [12,12] [8+2+0 600 0+2+184] [8+2+0 44 0+2+8] children: not-inline\n        BlockContainer <div.exekiller> at [14,14] positioned [0+2+0 200 0+2+396] [0+2+0 18 0+2+0] children: inline\n          frag 0 from TextNode start: 0, length: 9, rect: [14,14 65.4375x18] baseline: 13.796875\n              \"exekiller\"\n          TextNode <#text> (not painted)\n        BlockContainer <div.athena> at [24,26] positioned [0+2+0 200 0+2+396] [0+2+0 18 0+2+0] children: inline\n          frag 0 from TextNode start: 0, length: 6, rect: [24,26 53.171875x18] baseline: 13.796875\n              \"athena\"\n          TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x68]\n      PaintableWithLines (BlockContainer<BODY>) [10,10 604x48]\n        PaintableWithLines (BlockContainer<DIV>.exekiller) [12,12 204x22]\n          TextPaintable (TextNode<#text>)\n        PaintableWithLines (BlockContainer<DIV>.athena) [22,24 204x22]\n          TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [2,2 796x64] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><body><div class=\"exekiller\">exekiller</div><div class=\"athena\">athena</div></body>", css = "\n  * { border: 2px solid black; }\n  body { width: 600px; }\n  div {\n    width: 200px;\n    position: relative;\n    float: left;\n  }\n  .athena {\n    background: green;\n    top: 4px;\n    left: -200px;\n  }\n  .exekiller {\n    background: red;\n  }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [2,2] [0+2+0 796 0+2+0] [0+2+0 32 0+2+0] [BFC] children: not-inline\n      BlockContainer <body> at [12,12] [8+2+0 600 0+2+184] [8+2+0 0 0+2+8] children: not-inline\n        BlockContainer <div.exekiller> at [14,14] positioned floating [0+2+0 200 0+2+0] [0+2+0 18 0+2+0] [BFC] children: inline\n          frag 0 from TextNode start: 0, length: 9, rect: [14,14 65.4375x18] baseline: 13.796875\n              \"exekiller\"\n          TextNode <#text> (not painted)\n        BlockContainer <div.athena> at [18,18] positioned floating [0+2+0 200 0+2+0] [0+2+0 18 0+2+0] [BFC] children: inline\n          frag 0 from TextNode start: 0, length: 6, rect: [18,18 53.171875x18] baseline: 13.796875\n              \"athena\"\n          TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x36]\n      PaintableWithLines (BlockContainer<BODY>) [10,10 604x4]\n        PaintableWithLines (BlockContainer<DIV>.exekiller) [12,12 204x22]\n          TextPaintable (TextNode<#text>)\n        PaintableWithLines (BlockContainer<DIV>.athena) [16,16 204x22]\n          TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [2,2 796x32] [children: 0] (z-index: auto)\n"),
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<body>foo <b>bar</b> <b><i>baz</i></b>\n", css = "\nb {\n    position: relative;\n    top: 25px;\n}\ni {\n    position: relative;\n    top: 25px;\n    right: 25px;\n}\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 34 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 18 0+0+8] children: inline\n        frag 0 from TextNode start: 0, length: 4, rect: [8,8 35.15625x18] baseline: 13.796875\n            \"foo \"\n        frag 1 from TextNode start: 0, length: 1, rect: [70.796875,8 8x18] baseline: 13.796875\n            \" \"\n        TextNode <#text> (not painted)\n        InlineNode <b> at [43.15625,33] [0+0+0 27.640625 0+0+0] [0+0+0 18 0+0+0]\n          frag 0 from TextNode start: 0, length: 3, rect: [43.15625,33 27.640625x18] baseline: 13.796875\n              \"bar\"\n          TextNode <#text> (not painted)\n        TextNode <#text> (not painted)\n        InlineNode <b> at [53.796875,58] [0+0+0 27.203125 0+0+0] [0+0+0 18 0+0+0]\n          InlineNode <i> at [53.796875,58] [0+0+0 27.203125 0+0+0] [0+0+0 18 0+0+0]\n            frag 0 from TextNode start: 0, length: 3, rect: [53.796875,58 27.203125x18] baseline: 13.796875\n                \"baz\"\n            TextNode <#text> (not painted)\n        TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x34]\n      PaintableWithLines (BlockContainer<BODY>) [8,8 784x18]\n        TextPaintable (TextNode<#text>)\n        PaintableWithLines (InlineNode<B>) [43.15625,33 27.640625x18]\n          TextPaintable (TextNode<#text>)\n        TextPaintable (TextNode<#text>)\n        PaintableWithLines (InlineNode<B>) [53.796875,58 27.203125x18]\n          PaintableWithLines (InlineNode<I>) [53.796875,58 2