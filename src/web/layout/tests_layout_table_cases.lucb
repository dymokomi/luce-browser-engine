    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html><html><head></head><body><div class=\"upper\"><div class=\"cell\">Hello</div>", css = "\n    * {\n      border: 1px solid black;\n      font-family: 'SerenitySans';\n    }\n    body {\n      display: flex;\n    }\n    .cell {\n      display: table-cell;\n    }\n    .upper {\n      background: pink;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [1,1] [0+1+0 798 0+1+0] [0+1+0 40 0+1+0] [BFC] children: not-inline\n      Box <body> at [10,10] flex-container(row) [8+1+0 780 0+1+8] [8+1+0 22 0+1+8] [FFC] children: not-inline\n        BlockContainer <div.upper> at [11,11] flex-item [0+1+0 41.78125 0+1+0] [0+1+0 20 0+1+0] [BFC] children: not-inline\n          TableWrapper <(anonymous)> at [11,11] [0+0+0 41.78125 0+0+0] [0+0+0 20 0+0+0] [BFC] children: not-inline\n            Box <(anonymous)> at [11,11] table-box [0+0+0 41.78125 0+0+0] [0+0+0 20 0+0+0] [TFC] children: not-inline\n              Box <(anonymous)> at [11,11] table-row [0+0+0 41.78125 0+0+0] [0+0+0 20 0+0+0] children: not-inline\n                BlockContainer <div.cell> at [12,12] table-cell [0+1+0 39.78125 0+1+0] [0+1+0 18 0+1+0] [BFC] children: inline\n                  frag 0 from TextNode start: 0, length: 5, rect: [12,12 39.78125x18] baseline: 13.796875\n                      \"Hello\"\n                  TextNode <#text> (not painted)\n  \n  ViewportPaintable (Viewport<#document>) [0,0 800x600]\n    PaintableWithLines (BlockContainer<HTML>) [0,0 800x42]\n      PaintableBox (Box<BODY>) [9,9 782x24]\n        PaintableWithLines (BlockContainer<DIV>.upper) [10,10 43.78125x22]\n          PaintableWithLines (TableWrapper(anonymous)) [11,11 41.78125x20]\n            PaintableBox (Box(anonymous)) [11,11 41.78125x20]\n              PaintableBox (Box(anonymous)) [11,11 41.78125x20]\n                PaintableWithLines (BlockContainer<DIV>.cell) [11,11 41.78125x20]\n                  TextPaintable (TextNode<#text>)\n  \n  SC for Viewport<#document> [0,0 800x600] [children: 1] (z-index: auto)\n   SC for BlockContainer<HTML> [1,1 798x40] [children: 0] (z-index: auto)\n"),
