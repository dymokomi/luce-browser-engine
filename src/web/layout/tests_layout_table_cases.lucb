#==============================================================================================
#
#   tests_layout_table_cases - laid-out layout trees with tables (table layout) and the grids of
#                              their tables pinned to the reference build
#
#   DESCRIPTION:
#       Generated (a test vector table) from the output of a local oracle that runs the
#       reference Ladybird build's LibWeb on the same documents (luce-browser-tools,
#       oracles/luce-browser-engine/layout_geometry: cases_table.txt, own_table_cases.py,
#       oracle.cpp, gen_luce_cases.py, build.sh). tests_layout_table runs each case through the
#       port and compares the output.
#
#==============================================================================================

## Every oracle case, in cases_table.txt order (0 more, marked "!" in cases_table.txt, wait for other regions).
let test_layout_table_cases: TestLayoutGeometryCase[145] = [
    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n<table>\n  <!-- The first row is just here to move the second one down a bit. -->\n  <tr><td></td></tr>\n  <tr style=\"position: relative\">\n    <td><div style=\"position: absolute\">ABSPOS</div></td>\n  </tr>\n</table>\n", css = "", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [0,0] [0+0+0 800 0+0+0] [0+0+0 26 0+0+0] [BFC] children: not-inline\n      BlockContainer <body> at [8,8] [8+0+0 784 0+0+8] [8+0+0 10 0+0+8] children: not-inline\n        TableWrapper <(anonymous)> at [8,8] [0+0+0 6 0+0+778] [0+0+0 10 0+0+0] [BFC] children: not-inline\n          Box <table> at [8,8] table-box [0+0+0 6 0+0+0] [0+0+0 10 0+0+0] [TFC] children: not-inline\n            BlockContainer <(anonymous)> (not painted) children: inline\n              TextNode <#text> (not painted)\n              TextNode <#text> (not painted)\n            Box <tbody> at [10,10] table-row-group [0+0+0 2 0+0+0] [0+0+0 6 0+0+0] children: not-inline\n              Box <tr> at [10,10] table-row [0+0+0 2 0+0+0] [0+0+0 2 0+0+0] children: not-inline\n                BlockContainer <td> at [11,11] table-cell [0+0+1 0 1+0+0] [0+0+1 0 1+0+0] [BFC] children: not-inline\n              BlockContainer <(anonymous)> (not painted) children: inline\n                TextNode <#text> (not painted)\n              Box <tr> at [10,14] positioned table-row [0+0+0 2 0+0+0] [0+0+0 2 0+0+0] children: not-inline\n                BlockContainer <(anonymous)> (not painted) children: inline\n                  TextNode <#text> (not painted)\n                BlockContainer <td> at [11,15] table-cell [0+0+1 0 1+0+0] [0+0+1 0 1+0+0] [BFC] children: not-inline\n                  BlockContainer <div> at [11,15] positioned [0+0+0 70.5625 0+0+0] [0+0+0 18 0+0+0] [BFC] children: inline\n                    frag 0 from TextNode start: 0, length: 6, rect: [11,15 70.5625x18] baseline: 13.