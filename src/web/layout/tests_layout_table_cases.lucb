    TestLayoutGeometryCase(mode = "layout", html = "<!DOCTYPE html>\n\n<div class=container>\n    <div class=\"table left\"></div>\n    <div class=\"table right\"></div>\n    <div class=\"table top\"></div>\n    <div class=\"table bottom\"></div>\n</div>\n", css = "\n    * {\n        margin: 5px;\n        padding: 0;\n        border: 3px solid black;\n    }\n    .container {\n        display: flex;\n        position: relative;\n        width: 500px;\n        height: 500px;\n    }\n    .table {\n        display: table;\n        position: absolute;\n        background: green;\n        margin: auto;\n    }\n    .right {\n        top: 0;\n        bottom: 0;\n        right: 0;\n        width: 100px;\n        height: 150px;\n    }\n    .left {\n        top: 0;\n        bottom: 0;\n        width: 100px;\n        height: 150px;\n    }\n    .top {\n        left: 0;\n        right: 0;\n        width: 150px;\n        height: 100px;\n    }\n    .bottom {\n        bottom: 0;\n        left: 0;\n        right: 0;\n        width: 150px;\n        height: 100px;\n    }\n", expected = "  Viewport <#document> at [0,0] [0+0+0 800 0+0+0] [0+0+0 600 0+0+0] [BFC] children: not-inline\n    BlockContainer <html> at [8,8] [5+3+0 784 0+3+5] [5+3+0 532 0+3+5] [BFC] children: not-inline\n      BlockContainer <body> at [16,16] [5+3+0 768 0+3+5] [5+3+0 516 0+3+5] children: not-inline\n        Box <div.container> at [24,24] positioned flex-container(row) [5+3+0 500 0+3+257] [5+3+0 500 0+3+5] [FFC] children: not-inline\n          BlockContainer <(anonymous)> (not painted) [BFC] children: inline\n            TextNode <#text> (not painted)\n          TableWrapper <(anonymous)> at [24,196] positioned [0+0+0 106 0+0+0] [172+0+0 156 0+0+172] [BFC] children: not-inline\n            Box <div.table.left> at [27,199] table-box [0+3+0 100 0+3+0] [0+3+0 150 0+3+0] [TFC] children: not-inline\n          BlockContainer <(anonymous)> (not painted) [BFC] children: inline\n            TextNode <#text> (not painted)\