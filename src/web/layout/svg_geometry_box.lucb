## Ported from Libraries/LibWeb/Layout/SVGGeometryBox.cpp:17 Web::Layout::SVGGeometryBox::SVGGeometryBox.
pub func layout_svg_geometry_box_construct(this: LayoutSvgGeometryBox*, document: DomDocument*, element: SvgGeometryElement*, style: CssComputedProperties*):
    layout_svg_graphics_box_construct(this.layout_svg_graphics_box(), document, element.svg_graphics_element(), style)

## Ported from Libraries/LibWeb/Layout/SVGGeometryBox.h:23 Web::Layout::SVGGeometryBox::dom_node.
pub func layout_svg_geometry_box_dom_node(this: LayoutSvgGeometryBox*) -> SvgGeometryElement*:
    return (SvgGeometryElement*)layout_svg_graphics_box_dom_node(this.layout_svg_graphics_box())

## Ported from Libraries/LibWeb/Layout/SVGGeometryBox.h:24 Web::Layout::SVGGeometryBox::dom_node.
pub func layout_svg_geometry_box_dom_node_const(this: LayoutSvgGeometryBox*) -> SvgGeometryElement*:
    return layout_svg_geometry_box_dom_node(this)

## Ported from Libraries/LibWeb/Layout/SVGGeometryBox.cpp:22 Web::Layout::SVGGeometryBox::create_paintable (override).
pub func layout_svg_geometry_box_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_svg_path_paintable_create(((LayoutSvgGeometryBox*)base).layout_svg_graphics_box()).paint_paintable()

## Ported from Libraries/LibWeb/Layout/SVGGeometryBox.h:29 Web::Layout::SVGGeometryBox::is_svg_geometry_box (override).
pub func layout_svg_geometry_box_is_svg_geometry_box_impl(base: LayoutNode*) -> bool:
    _ = base
    return true
