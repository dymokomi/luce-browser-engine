#   svgsvg_box - Layout::SVGSVGBox: the replaced box of an <svg> root
#
#   DESCRIPTION:
#       Port of LibWeb/Layout/SVGSVGBox.cpp (lines 1-34) and SVGSVGBox.h: the constructor, the
