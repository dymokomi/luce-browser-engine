        if cell.column_index >= cell.column_span and edge == LayoutTableFormattingContextConflictingSide.left:
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = col_element, element_kind = PaintPaintableBoxConflictingElementKind.column_group, side = LayoutTableFormattingContextConflictingSide.right, row = none, column = cell.column_index - cell.column_span))
    # Right edge of the column group.
    if let col_element = layout_table_formatting_context_border_conflict_finder_get_col_element(this, cell.column_index):
        if edge == LayoutTableFormattingContextConflictingSide.right:
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = col_element, element_kind = PaintPaintableBoxConflictingElementKind.column_group, side = LayoutTableFormattingContextConflictingSide.right, row = none, column = cell.column_index))
    # Left edge of the column group to the right.
    if let col_element = layout_table_formatting_context_border_conflict_finder_get_col_element(this, cell.column_index -% cell.column_span):
        if edge == LayoutTableFormattingContextConflictingSide.right:
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = col_element, element_kind = PaintPaintableBoxConflictingElementKind.column_group, side = LayoutTableFormattingContextConflictingSide.left, row = none, column = cell.column_index + cell.column_span))

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1645 Web::Layout::TableFormattingContext::BorderConflictFinder::collect_table_box_conflicting_edges.
func layout_table_formatting_context_border_conflict_finder_collect_table_box_conflicting_edges(this: const LayoutTableFormattingContextBorderConflictFinder*, result: ak.Vector[LayoutTableFormattingContextConflictingEdge]*, cell: const LayoutTableGridCell*, edge: LayoutTableFormattingContextConflictingSide):
    let context = this.m_context
    let table_box = layout_table_formatting_context_table_box(context).layout_node()
    let row_box = ak.vector_at(&context.m_rows, cell.row_index).box.layout_node()
    let maybe_row_group = *ak.vector_at_const(&this.m_row_group_elements_by_index, cell.row_index)
    # Top edge from column group or table. Left and right edges of the column group are handled in collect_column_group_conflicting_edges.
    if cell.row_index == 0 and edge == LayoutTableFormattingContextConflictingSide.top:
        if let col_element = layout_table_formatting_context_border_conflict_finder_get_col_element(this, cell.column_index):
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = col_element, element_kind = PaintPaintableBoxConflictingElementKind.column_group, side = LayoutTableFormattingContextConflictingSide.top, row = none, column = cell.column_index))
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = table_box, element_kind = PaintPaintableBoxConflictingElementKind.table, side = LayoutTableFormattingContextConflictingSide.top, row = none, column = none))
    # Bottom edge from column group or table. Left and right edges of the column group are handled in collect_column_group_conflicting_edges.
    if cell.row_index + cell.row_span == ak.vector_size(&context.m_rows) and edge == LayoutTableFormattingContextConflictingSide.bottom:
        if let col_element = layout_table_formatting_context_border_conflict_finder_get_col_element(this, cell.column_index):
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = col_element, element_kind = PaintPaintableBoxConflictingElementKind.column_group, side = LayoutTableFormattingContextConflictingSide.bottom, row = none, column = cell.column_index))
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = table_box, element_kind = PaintPaintableBoxConflictingElementKind.table, side = LayoutTableFormattingContextConflictingSide.bottom, row = none, column = none))
    # Left edge from row group or table. Top and bottom edges of the row group are handled in collect_row_group_conflicting_edges.
    if cell.column_index == 0 and edge == LayoutTableFormattingContextConflictingSide.left:
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = row_box, element_kind = PaintPaintableBoxConflictingElementKind.row, side = LayoutTableFormattingContextConflictingSide.left, row = cell.row_index, column = none))
        if let row_group = maybe_row_group:
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = row_group.row_group, element_kind = PaintPaintableBoxConflictingElementKind.row_group, side = LayoutTableFormattingContextConflictingSide.left, row = cell.row_index, column = none))
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = table_box, element_kind = PaintPaintableBoxConflictingElementKind.table, side = LayoutTableFormattingContextConflictingSide.left, row = none, column = none))
    # Right edge from row group or table. Top and bottom edges of the row group are handled in collect_row_group_conflicting_edges.
    if cell.column_index + cell.column_span == ak.vector_size(&context.m_columns) and edge == LayoutTableFormattingContextConflictingSide.right:
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = row_box, element_kind = PaintPaintableBoxConflictingElementKind.row, side = LayoutTableFormattingContextConflictingSide.right, row = cell.row_index, column = none))
        if let row_group = maybe_row_group:
            ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = row_group.row_group, element_kind = PaintPaintableBoxConflictingElementKind.row_group, side = LayoutTableFormattingContextConflictingSide.right, row = cell.row_index, column = none))
        ak.vector_append_t(result, LayoutTableFormattingContextConflictingEdge(element = table_box, element_kind = PaintPaintableBoxConflictingElementKind.table, side = LayoutTableFormattingContextConflictingSide.right, row = none, column = none))

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1679 Web::Layout::TableFormattingContext::BorderConflictFinder::conflicting_edges.
func layout_table_formatting_context_border_conflict_finder_conflicting_edges(this: const LayoutTableFormattingContextBorderConflictFinder*, cell: const LayoutTableGridCell*, edge: LayoutTableFormattingContextConflictingSide) -> ak.Vector[LayoutTableFormattingContextConflictingEdge]:
    var result = ak.Vector[LayoutTableFormattingContextConflictingEdge]()
    layout_table_formatting_context_border_conflict_finder_collect_cell_conflicting_edges(this, &result, cell, edge)
    layout_table_formatting_context_border_conflict_finder_collect_row_conflicting_edges(this, &result, cell, edge)
    layout_table_formatting_context_border_conflict_finder_collect_row_group_conflicting_edges(this, &result, cell, edge)
    layout_table_formatting_context_border_conflict_finder_collect_column_group_conflicting_edges(this, &result, cell, edge)
    layout_table_formatting_context_border_conflict_finder_collect_table_box_conflicting_edges(this, &result, cell, edge)
    return result

# mark: The grid ================================================================================

## Ported from Libraries/LibWeb/Layout/TableFormattingContext.cpp:1691 Web::Layout::TableFormattingContext::finish_grid_initialization.
func layout_table_formatting_context_finish_grid_initialization(this: LayoutTableFormattingContext*, table_grid: const LayoutTableGrid*):
    ak.vector_resize(&this.m_columns, layout_table_grid_column_count(table_grid))
    ak.vector_resize(&this.m_cells_by_coordinate, ak.vector_size(&this.m_rows))
    for position_to_cell_row in &ak.vector_span(&this.m_cells_by_coordinate):
        ak.vector_resize(position_to_cell_row, layout_table_grid_column_count(table_grid))
    for cell in &ak.vector_span(&this.m_cells):
        *ak.vector_at(ak.vector_at(&this.m_cells_by_coordinate, cell.row_index), cell.column_index) = cell
        ak.vector_at(&this.m_columns, cell.column_index).has_originating_cells = true
