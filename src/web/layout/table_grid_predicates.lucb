## Ported from Libraries/LibWeb/Layout/TableGrid.h:58 Web::Layout::TableGrid::is_table_row_group.
pub func layout_table_grid_is_table_row_group(node: LayoutNode*) -> bool:
    let display = layout_node_display(node)
    return css_display_is_table_row_group(&display) or css_display_is_table_header_group(&display) or css_display_is_table_footer_group(&display)

## Ported from Libraries/LibWeb/Layout/TableGrid.h:64 Web::Layout::TableGrid::is_table_row.
pub func layout_table_grid_is_table_row(node: LayoutNode*) -> bool:
    let display = layout_node_display(node)
    return css_display_is_table_row(&display)

## Ported from Libraries/LibWeb/Layout/TableGrid.h:69 Web::Layout::TableGrid::is_table_column_group.
pub func layout_table_grid_is_table_column_group(node: LayoutNode*) -> bool:
    let display = layout_node_display(node)
    return css_display_is_table_column_group(&display)
