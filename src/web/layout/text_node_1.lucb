# mark: Construction ============================================================================

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:24 Web::Layout::TextNode::TextNode.
pub func layout_text_node_construct(this: LayoutTextNode*, document: DomDocument*, text: DomText*):
    layout_node_construct(this.layout_node(), document, text.dom_node())

## Ported from Libraries/LibWeb/Layout/TextNode.h:28 Web::Layout::TextNode::dom_node.
pub func layout_text_node_dom_node(this: LayoutTextNode*) -> DomText*:
    let dom_node = layout_node_dom_node(this.layout_node()) else trap("VERIFY: a text node has a DOM node")
    return (DomText*)dom_node

# mark: text-transform ==========================================================================

## `map_code_point_to_italic`: the lambda of apply_math_auto_text_transform.
# https://w3c.github.io/mathml-core/#italic-mappings
func layout_map_code_point_to_italic(code_point: u32) -> u32:
    return match code_point:
        0x0041 => 0x1D434
        0x0042 => 0x1D435
        0x0043 => 0x1D436
        0x0044 => 0x1D437
        0x0045 => 0x1D438
        0x0046 => 0x1D439
        0x0047 => 0x1D43A
        0x0048 => 0x1D43B
        0x0049 => 0x1D43C
        0x004a => 0x1D43D
        0x004b => 0x1D43E
        0x004c => 0x1D43F
        0x004d => 0x1D440
        0x004e => 0x1D441
        0x004f => 0x1D442
        0x0050 => 0x1D443
        0x0051 => 0x1D444
        0x0052 => 0x1D445
        0x0053 => 0x1D446
        0x0054 => 0x1D447
        0x0055 => 0x1D448
        0x0056 => 0x1D449
