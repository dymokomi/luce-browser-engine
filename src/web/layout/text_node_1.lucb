## Ported from Libraries/LibWeb/Layout/TextNode.cpp:32 Web::Layout::apply_math_auto_text_transform.
# https://w3c.github.io/mathml-core/#new-text-transform-values
func layout_apply_math_auto_text_transform(string: ak.Utf16String) -> ak.Utf16String:
    var builder = ak.string_builder_new_mode_usize(ak.StringBuilderMode.utf16, ak.utf16_string_base_length_in_code_units(&string.utf16_string_base))

    var it = ak.utf16_string_base_begin(&string.utf16_string_base)
    while not ak.utf16_code_point_iterator_done(&it):
        ak.string_builder_append_code_point(&builder, layout_map_code_point_to_italic(ak.utf16_code_point_iterator_deref(&it)))
        discard(ak.utf16_code_point_iterator_inc(&it))

    return ak.string_builder_to_utf16_string(&builder)

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:274 Web::Layout::apply_text_transform.
func layout_apply_text_transform(string: ak.Utf16String, text_transform: css_data.TextTransform, locale: ak.StringView?) -> ak.Utf16String:
    match text_transform:
        .uppercase:
            return web_unicode.utf16_string_to_uppercase(&string, locale)
        .lowercase:
            return web_unicode.utf16_string_to_lowercase(&string, locale)
        .none_:
            return string
        .math_auto:
            return layout_apply_math_auto_text_transform(string)
        .capitalize:
            return web_unicode.utf16_string_to_titlecase(&string, locale, ak.TrailingCodePointTransformation.preserve_existing)
        .full_size_kana:
            ak.dbgln("FIXME: Implement text-transform full-size-kana")
            return string
        .full_width:
            return web_unicode.utf16_string_to_fullwidth(&string)
        _:
            trap("VERIFY_NOT_REACHED")

# mark: Text for rendering ======================================================================

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:297 Web::Layout::TextNode::invalidate_text_for_rendering.
pub func layout_text_node_invalidate_text_for_rendering(this: LayoutTextNode*):
    this.m_text_for_rendering = ak.utf16_string_new()
    this.m_has_text_for_rendering = false
    this.m_grapheme_segmenter = none
    this.m_line_segmenter = none

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:304 Web::Layout::TextNode::text_for_rendering.
pub func layout_text_node_text_for_rendering(this: LayoutTextNode*) -> const ak.Utf16String*:
    if not this.m_has_text_for_rendering:
        layout_text_node_compute_text_for_rendering(this)
    return &this.m_text_for_rendering

## `any_of(text, is_ascii_space)`: whether any code point of `text` is ASCII whitespace.
func layout_utf16_string_has_ascii_space(text: const ak.Utf16String*) -> bool:
    var it = ak.utf16_string_base_begin(&text.utf16_string_base)
    while not ak.utf16_code_point_iterator_done(&it):
        if ak.is_ascii_space(ak.utf16_code_point_iterator_deref(&it)):
            return true
        discard(ak.utf16_code_point_iterator_inc(&it))
    return false

## `m_text_for_rendering = text`: the optional gets a value.
func layout_text_node_set_text_for_rendering(this: LayoutTextNode*, text: ak.Utf16String):
    this.m_text_for_rendering = text
    this.m_has_text_for_rendering = true

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:311 Web::Layout::TextNode::compute_text_for_rendering.
func layout_text_node_compute_text_for_rendering(this: LayoutTextNode*):
    let dom_node = layout_text_node_dom_node(this)
    if dom_text_is_password_input(dom_node):
        let data = dom_character_data_data(dom_node.dom_character_data())
        layout_text_node_set_text_for_rendering(this, ak.utf16_string_repeated(0x25CF, ak.utf16_string_base_length_in_code_points(&data.utf16_string_base)))
        return

    # Apply text-transform
    # FIXME: This can generate more code points than there were before; we need to find a better way to map the
    #        resulting paintable fragments' offsets into the original text node data.
    #        See: https://github.com/LadybirdBrowser/ladybird/issues/6177
    var maybe_lang: ak.String? = none
    if let parent_element = dom_node_parent_element(dom_node.dom_node()):
        maybe_lang = dom_element_lang(parent_element)
    var lang: ak.StringView? = none
    if let value = maybe_lang:
        lang = ak.string_bytes_as_string_view(&value)
    let computed_values = &layout_node_computed_values(this.layout_node()).computed_values
    var text = layout_apply_text_transform(dom_character_data_data(dom_node.dom_character_data()), css_computed_values_text_transform(computed_values), lang)

    # The logic below deals with converting whitespace characters. If we don't have them, return early.
    if ak.utf16_string_base_is_empty(&text.utf16_string_base) or not layout_utf16_string_has_ascii_space(&text):
        layout_text_node_set_text_for_rendering(this, text)
        return

    # https://drafts.csswg.org/css-text-4/#white-space-phase-1
    var convert_newlines = false
    var convert_tabs = false

    # If white-space-collapse is set to collapse or preserve-breaks, white space characters are considered collapsible
    # and are processed by performing the following steps:
    let white_space_collapse = css_computed_values_white_space_collapse(computed_values)
    if white_space_collapse == css_data.WhiteSpaceCollapse.collapse or white_space_collapse == css_data.WhiteSpaceCollapse.preserve_breaks:
        # 1. FIXME: Any sequence of collapsible spaces and tabs immediately preceding or following a segment break is removed.

        # 2. Collapsible segment breaks are transformed for rendering according to the segment break transformation
        #    rules.
        # https://drafts.csswg.org/css-text-4/#line-break-transform
        # FIXME: When white-space-collapse is not collapse, segment breaks are not collapsible. For values other than
        # collapse or preserve-spaces (which transforms them into spaces), segment breaks are instead transformed
        # into a preserved line feed (U+000A).

        # When white-space-collapse is collapse, segment breaks are collapsible, and are collapsed as follows:
        if white_space_collapse == css_data.WhiteSpaceCollapse.collapse:
            # 1. FIXME: First, any collapsible segment break immediately following another collapsible segment break is
            #    removed.

            # 2. FIXME: Then any remaining segment break is either transformed into a space (U+0020) or removed depending
            #    on the context before and after the break. The rules for this operation are UA-defined in this
            #    level.
            convert_newlines = true

        # 3. Every collapsible tab is converted to a collapsible space (U+0020).
        convert_tabs = true

        # 4. Any collapsible space immediately following another collapsible space—even one outside the boundary of the
        #    inline containing that space, provided both spaces are within the same inline formatting context—is
        #    collapsed to have zero advance width. (It is invisible, but retains its soft wrap opportunity, if any.)
        # AD-HOC: This is handled by TextNode::ChunkIterator by removing the space.

    # If white-space-collapse is set to preserve-spaces, each tab and segment break is converted to a space.
    if white_space_collapse == css_data.WhiteSpaceCollapse.preserve_spaces:
        convert_tabs = true
        convert_newlines = true

    # AD-HOC: Prevent allocating a StringBuilder for a single space/newline/tab.
    if ak.utf16_string_base_eq_string_view(&text.utf16_string_base, ak.sv(" ")) or (convert_tabs and ak.utf16_string_base_eq_string_view(&text.utf16_string_base, ak.sv("\t"))) or (convert_newlines and ak.utf16_string_base_eq_string_view(&text.utf16_string_base, ak.sv("\n"))):
        layout_text_node_set_text_for_rendering(this, ak.utf16_string_from_str(" "))
        return

    # AD-HOC: It's important to not change the amount of code units in the resulting transformed text, so ChunkIterator
    #         can pass views to this string with associated code unit offsets that still match the original text.
    if convert_newlines or convert_tabs:
        var text_builder = ak.string_builder_new_mode_usize(ak.StringBuilderMode.utf16, ak.utf16_string_base_length_in_code_units(&text.utf16_string_base))
        var it = ak.utf16_string_base_begin(&text.utf16_string_base)
        while not ak.utf16_code_point_iterator_done(&it):
            var code_point = ak.utf16_code_point_iterator_deref(&it)
            if (convert_newlines and code_point == (u32)'\n') or (convert_tabs and code_point == (u32)'\t'):
                code_point = (u32)' '
            ak.string_builder_append_code_point(&text_builder, code_point)
            discard(ak.utf16_code_point_iterator_inc(&it))
        text = ak.string_builder_to_utf16_string(&text_builder)

    layout_text_node_set_text_for_rendering(this, text)

# mark: Segmenters ==============================================================================

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:399 Web::Layout::TextNode::grapheme_segmenter.
pub func layout_text_node_grapheme_segmenter(this: LayoutTextNode*) -> web_unicode.Segmenter*:
    if this.m_grapheme_segmenter == none:
        let text = layout_text_node_text_for_rendering(this)
        # Fast path: For ASCII text, every character is its own grapheme.
        # We can use a trivial segmenter that avoids all ICU overhead.
        if ak.utf16_string_base_is_ascii(&text.utf16_string_base):
            this.m_grapheme_segmenter = web_unicode.segmenter_create_for_ascii_grapheme(ak.utf16_string_base_length_in_code_units(&text.utf16_string_base))
        else:
            let segmenter = web_unicode.segmenter_clone(dom_document_grapheme_segmenter(layout_node_document(this.layout_node())))
            web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, ak.utf16_string_base_utf16_view(&text.utf16_string_base))
            this.m_grapheme_segmenter = segmenter

    return this.m_grapheme_segmenter else trap("unreachable: the grapheme segmenter was just made")

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:416 Web::Layout::TextNode::line_segmenter.
pub func layout_text_node_line_segmenter(this: LayoutTextNode*) -> web_unicode.Segmenter*:
    if this.m_line_segmenter == none:
        let segmenter = web_unicode.segmenter_clone(dom_document_line_segmenter(layout_node_document(this.layout_node())))
        let text = layout_text_node_text_for_rendering(this)
        web_unicode.segmenter_set_segmented_text_utf16_view(segmenter, ak.utf16_string_base_utf16_view(&text.utf16_string_base))
        this.m_line_segmenter = segmenter

    return this.m_line_segmenter else trap("unreachable: the line segmenter was just made")

# mark: Paintables ==============================================================================

## Ported from Libraries/LibWeb/Layout/TextNode.cpp:802 Web::Layout::TextNode::create_paintable (override).
pub func layout_text_node_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_text_paintable_create((LayoutTextNode*)base).paint_paintable()

## Ported from Libraries/LibWeb/Layout/TextNode.h:89 Web::Layout::TextNode::is_text_node (override).
pub func layout_text_node_is_text_node_impl(base: LayoutNode*) -> bool:
    discard(base)
    return true
