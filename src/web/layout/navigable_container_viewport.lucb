## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.cpp:20 Web::Layout::NavigableContainerViewport::NavigableContainerViewport.
pub func layout_navigable_container_viewport_construct(this: LayoutNavigableContainerViewport*, document: DomDocument*, element: HtmlNavigableContainer*, style: CssComputedProperties*):
    layout_replaced_box_construct(this.layout_replaced_box(), document, element.dom_element(), style)

## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.h:22 Web::Layout::NavigableContainerViewport::dom_node.
pub func layout_navigable_container_viewport_dom_node_const(this: LayoutNavigableContainerViewport*) -> HtmlNavigableContainer*:
    return layout_navigable_container_viewport_dom_node(this)

## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.h:23 Web::Layout::NavigableContainerViewport::dom_node.
pub func layout_navigable_container_viewport_dom_node(this: LayoutNavigableContainerViewport*) -> HtmlNavigableContainer*:
    let element = layout_replaced_box_dom_node(this.layout_replaced_box()) else trap("VERIFY: a navigable container viewport has a DOM node")
    return as_html_navigable_container(element)

## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.cpp:27 Web::Layout::NavigableContainerViewport::natural_size (override).
pub func layout_navigable_container_viewport_natural_size_impl(base: LayoutBox*) -> CssSizeWithAspectRatio:
    let this = (LayoutNavigableContainerViewport*)base
    let dom_node = layout_navigable_container_viewport_dom_node(this)
    if not is_html_object_element(dom_node):
        return CssSizeWithAspectRatio()

    if let content_document = html_navigable_container_content_document_without_origin_check(dom_node):
        if let root = dom_document_document_element(content_document):
            if dom_node_is_svg_svg_element(root.dom_node()):
                let metrics = svg_svgsvg_element_negotiate_natural_metrics(as_svg_svgsvg_element(root))
                return CssSizeWithAspectRatio(width = metrics.width, height = metrics.height, aspect_ratio = metrics.aspect_ratio)
    return CssSizeWithAspectRatio()

## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.cpp:43 Web::Layout::NavigableContainerViewport::did_set_content_size (override).
pub func layout_navigable_container_viewport_did_set_content_size_impl(base: LayoutBox*):
    let this = (LayoutNavigableContainerViewport*)base
    layout_box_did_set_content_size_impl(base)

    if let content_navigable = html_navigable_container_content_navigable(layout_navigable_container_viewport_dom_node(this)):
        let paintable_box = layout_box_paintable_box(base) else trap("VERIFY: a paintable box")
        html_navigable_set_viewport_size(content_navigable, paint_paintable_box_content_size(paintable_box))

## Ported from Libraries/LibWeb/Layout/NavigableContainerViewport.cpp:51 Web::Layout::NavigableContainerViewport::create_paintable (override).
pub func layout_navigable_container_viewport_create_paintable_impl(base: LayoutNode*) -> PaintPaintable*?:
    return paint_navigable_container_viewport_paintable_create((LayoutNavigableContainerViewport*)base).paint_paintable()
