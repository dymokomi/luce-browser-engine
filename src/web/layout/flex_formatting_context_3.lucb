        #   Freeze all the items with max violations.
        else:
            for max_violation_item in items:
                if not max_violation_item.frozen and max_violation_item.is_max_violation:
                    max_violation_item.frozen = true
        # NOTE: This freezes at least one item, ensuring that the loop makes progress and eventually terminates.

        # f. Return to the start of this loop.

    # NOTE: Calculate the remaining free space once again here, since it's needed later when aligning items.
    line.remaining_free_space = layout_flex_formatting_context_calculate_remaining_free_space(this, line, available_main_size)

    # 6. Set each item’s used main size to its target main size.
    let flex_container = layout_flex_formatting_context_flex_container(this)
    for used_item in items:
        used_item.main_size = used_item.target_main_size
        layout_flex_formatting_context_set_main_size_layout_flex_formatting_context(this, used_item, used_item.target_main_size)

        # https://drafts.csswg.org/css-flexbox-1/#definite-sizes
        # 1. If the flex container has a definite main size, then the post-flexing main sizes of its flex items are treated as definite.
        # 2. If a flex item’s flex basis is definite, then its post-flexing main size is also definite.
        # AD-HOC: 3. If a flex item’s main size was resolved from its intrinsic aspect ratio, then its post-flexing main size is also definite.
        let item_is_orthogonal = layout_flex_formatting_context_inline_axis_is_horizontal(this, used_item.box) != layout_flex_formatting_context_inline_axis_is_horizontal(this, flex_container)
        let flex_container_has_vertical_inline_main_axis = layout_flex_formatting_context_is_row_layout(this) and not layout_flex_formatting_context_inline_axis_is_horizontal(this, flex_container)
        if layout_flex_formatting_context_has_definite_main_size_layout_state_used_values(this, this.m_flex_container_state) or used_item.used_flex_basis_is_definite or used_item.main_size_was_resolved_from_aspect_ratio or flex_container_has_vertical_inline_main_axis or (item_is_orthogonal and layout_flex_formatting_context_main_axis_is_parallel_to_inline_axis(this, used_item.box)):
            layout_flex_formatting_context_set_has_definite_main_size(this, used_item)

## Ported from Libraries/LibWeb/Layout/FlexFormattingContext.cpp:1187 Web::Layout::FlexFormattingContext::resolve_flexible_lengths.
# https://drafts.csswg.org/css-flexbox-1/#resolve-flexible-lengths
func layout_flex_formatting_context_resolve_flexible_lengths(this: LayoutFlexFormattingContext*):
    let lines = ak.vector_span(&this.m_flex_lines)
    for line in &lines:
        layout_flex_formatting_context_resolve_flexible_lengths_for_line(this, line)
