            elif used_flex_factor == LayoutFlexFormattingContextFlexFactor.flex_shrink_factor:
                # For every unfrozen item on the line, multiply its flex shrink factor by its inner flex base size, and note this as its scaled flex shrink factor.
                for scaled_item in items:
                    if scaled_item.frozen:
                        continue
                    scaled_item.scaled_flex_shrink_factor = (scaled_item.flex_factor else trap("VERIFY: the item has a flex factor")) * scaled_item.flex_base_size.to_double()
                let sum_of_scaled_flex_shrink_factors_of_all_unfrozen_items_on_line = layout_flex_formatting_context_flex_line_sum_of_scaled_flex_shrink_factor_of_unfrozen_items(line)
                for shrinking_item in items:
                    if shrinking_item.frozen:
                        continue
                    # Find the ratio of the item’s scaled flex shrink factor to the sum of the scaled flex shrink factors of all unfrozen items on the line.
                    var ratio = 1.0
                    if sum_of_scaled_flex_shrink_factors_of_all_unfrozen_items_on_line != 0.0:
                        ratio = shrinking_item.scaled_flex_shrink_factor / sum_of_scaled_flex_shrink_factors_of_all_unfrozen_items_on_line

                    # Set the item’s target main size to its flex base size minus a fraction of the absolute value of the remaining free space proportional to the ratio.
                    # (Note this may result in a negative inner main size; it will be corrected in the next step.)
                    let absolute_remaining_free_space = remaining_free_space_or_zero_if_infinite.abs()
                    shrinking_item.target_main_size = shrinking_item.flex_base_size.sub(gfx.css_pixels_scaled_f64(&absolute_remaining_free_space, ratio))

        # d. Fix min/max violations.
        var total_violation = layout_zero_px()

        # Clamp each non-frozen item’s target main size by its used min and max main sizes and floor its content-box size at zero.
        for clamped_item in items:
            if clamped_item.frozen:
                continue
            let used_min_main_size = layout_flex_formatting_context_specified_main_min_size(this, clamped_item) if layout_flex_formatting_context_has_main_min_size(this, clamped_item.box) else layout_flex_formatting_context_automatic_minimum_size(this, clamped_item)

            let used_max_main_size = layout_flex_formatting_context_specified_main_max_size(this, clamped_item) if layout_flex_formatting_context_has_main_max_size(this, clamped_item.box) else gfx.css_pixels_max()

            let original_target_main_size = clamped_item.target_main_size
            clamped_item.target_main_size = layout_css_clamp(clamped_item.target_main_size, used_min_main_size, used_max_main_size)
            clamped_item.target_main_size = ak.max(clamped_item.target_main_size, layout_zero_px())

            # If the item’s target main size was made smaller by this, it’s a max violation.
            if clamped_item.target_main_size.lt(original_target_main_size):
                clamped_item.is_max_violation = true

            # If the item’s target main size was made larger by this, it’s a min violation.
            if clamped_item.target_main_size.gt(original_target_main_size):
