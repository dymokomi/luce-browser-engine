        #    The total violation is the sum of the adjustments from the previous step ∑(clamped size - unclamped size).

        # If the total violation is:
        # Zero
        #   Freeze all items.
        if gfx.eq_css_pixels_int(total_violation, 0):
            for zero_violation_item in items:
                if not zero_violation_item.frozen:
                    zero_violation_item.frozen = true
