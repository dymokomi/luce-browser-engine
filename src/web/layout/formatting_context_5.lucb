pub func layout_formatting_context_can_skip_is_anonymous_text_run(this: LayoutFormattingContext*, box: LayoutBox*) -> bool:
    _ = this
    if layout_node_is_anonymous(box.layout_node()) and not layout_node_is_generated_for_pseudo_element(box.layout_node()) and tree_node_first_child_of_type(box.layout_node(), &layout_block_container_class) == none:
