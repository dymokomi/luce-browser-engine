#==============================================================================================

## Ported from RequireTrustedTypesForDirective.cpp:26 Web::TrustedTypes::RequireTrustedTypesForDirective::RequireTrustedTypesForDirective.
pub func trusted_types_require_trusted_types_for_directive_construct(this: TrustedTypesRequireTrustedTypesForDirective*, name: ak.String, value: ak.Vector[ak.String]):
    content_security_policy_directive_construct(this.content_security_policy_directive(), name, value)

## Ported from RequireTrustedTypesForDirective.cpp:32 Web::TrustedTypes::RequireTrustedTypesForDirective::pre_navigation_check (override).
# https://www.w3.org/TR/trusted-types/#require-trusted-types-for-pre-navigation-check
pub func trusted_types_require_trusted_types_for_directive_pre_navigation_check_impl(base: ContentSecurityPolicyDirective*, request: FetchRequest*, navigation_type: ContentSecurityPolicyNavigationType, policy: ContentSecurityPolicyPolicy*) -> ContentSecurityPolicyResult:
    # 1. If request’s url’s scheme is not "javascript", return "Allowed" and abort further steps.
    let url = fetch_request_url(request)
    let scheme = web_url.url_scheme(&url)
    if not ak.string_eq_string_view(&scheme, ak.sv("javascript")):
        return ContentSecurityPolicyResult.allowed

    # 2. Let urlString be the result of running the URL serializer on request’s url.
    # 3. Let encodedScriptSource be the result of removing the leading "javascript:" from urlString.
    # 4. Let convertedScriptSource be the result of executing Process value with a default policy algorithm, with the following arguments:
    #    expectedType: TrustedScript, global: request’s clients’s global object, input: encodedScriptSource, sink: "Location href".
    #    If that algorithm threw an error or convertedScriptSource is not a TrustedScript object, return "Blocked" and abort further steps.
    # 5. Set urlString to be the result of prepending "javascript:" to stringified convertedScriptSource.
    # 6. Let newURL be the result of running the URL parser on urlString. If the parser returns a failure, return "Blocked" and abort further steps.
    # 7. Set request’s url to newURL.
    # 8. Return "Allowed".
    trap("unported (P3): Web::TrustedTypes::RequireTrustedTypesForDirective::pre_navigation_check of a javascript: URL (the default policy)")
