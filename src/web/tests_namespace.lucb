#==============================================================================================
#
#   tests_namespace - the namespace FlyStrings
#
#==============================================================================================

test "Namespace: web_initialize_strings interns the namespace URLs":
    web_initialize_strings()
    web_initialize_strings()
    let html = ak.fly_string_bytes_as_string_view(&namespace_html)
    assert(ak.string_view_equals(&html, "http://www.w3.org/1999/xhtml"))
    let xmlns = ak.fly_string_bytes_as_string_view(&namespace_xmlns)
    assert(ak.string_view_equals(&xmlns, "http://www.w3.org/2000/xmlns/"))
    # Interned: an equal FlyString made later is the same string.
    let svg = ak.fly_string_from_str("http://www.w3.org/2000/svg")
    assert(ak.fly_string_eq_fly_string(&svg, &namespace_svg))
    assert(not ak.fly_string_eq_fly_string(&namespace_math_ml, &namespace_x_link))
    let xml_namespace = ak.fly_string_bytes_as_string_view(&namespace_xml)
    assert(ak.string_view_equals(&xml_namespace, "http://www.w3.org/XML/1998/namespace"))
