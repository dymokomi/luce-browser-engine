#==============================================================================================
#
#   types_performance_entry - declarations of PerformanceEntry.h, EntryTypes.h and
#   EventNames.h of Libraries/LibWeb/PerformanceTimeline
#
#   DESCRIPTION:
#       Outside the skeleton's phase-1 closure; declared here by hand in the generator's shape
#       (region shell: every resource a page fetches over HTTP(S) is marked in the resource
#       timing buffer). PerformanceEntry is abstract (entry_type and should_add_entry are pure);
#       like the other hand-declared platform objects (DOMRect) its classes have
#       PlatformObject's first id (6) and are recognized by their ClassInfo.
#
#==============================================================================================

