# The test blocks of tests/web_test, the Layout/Ref/Crash/Screenshot runner (its driver and
# worker logic), which is a module of its own beside the package's sources, so `luc test`
# does not collect them: `luce-base test tests/web_test` runs them, with web's own tests again.
from luce_std import process

let failed = ErrorCode.package(1)

pub func main(arguments: list[str]) -> int!:
    let base = process.variable("LUCE_BASE") else "luce-base"
    let done = process.run(base, ["test", "tests/web_test"])
    if done.exit_code != 0:
        error(failed, f"luce-base test tests/web_test: exit status {done.exit_code}\n{done.output}{done.error_output}")
    let lines = done.output.trim_end().lines()
    print(lines[lines.length - 1])
    return 0
