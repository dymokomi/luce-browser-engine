# web's and webview's test blocks again under the diagnostic profile, which fills `---`
# storage with 0xaa and checks frees, so a read of a field nobody wrote fails every time its
# path runs instead of depending on what the stack held.
from luce_std import process

let failed = ErrorCode.package(1)

pub func main(arguments: list[str]) -> int!:
    let base = process.variable("LUCE_BASE") else "luce-base"
    let done = process.run(base, ["test", "src/webview", "--profile", "diagnostic"])
    if done.exit_code != 0:
        error(failed, f"luce-base test src/webview --profile diagnostic: exit status {done.exit_code}\n{done.output}{done.error_output}")
    let lines = done.output.trim_end().lines()
    print(lines[lines.length - 1])
    return 0
